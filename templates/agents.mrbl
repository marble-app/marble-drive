<!doctype html>
<html lang="en" data-marble="1">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="marble:capabilities" content="storage; net=none">
<meta name="marble-agent" content="custom">
<title>__TITLE__</title>
__ICON__
<style>
  /* Same tokens as Drive / the drawer: UIST warm in the light, Dusk after dark.
     The Agents file is chrome, so it sits on the off-white paper the Drive uses. */
  :root {
    --ink: #111111;
    --muted: #5a5a5a;
    --faint: #8a8a8a;
    --line: #ddd9cf;
    --paper: #fafaf7;
    --paper-2: #f3f1ea;
    --paper-3: #eceae1;
    --card: #ffffff;
    --card-rgb: 255, 255, 255;
    --paper-rgb: 250, 250, 247;
    --accent: #9bb6cf;
    --accent-soft: #f1f5f8;
    --accent-ink: #738698;
    --accent-ink-rgb: 115, 134, 152;
    --danger: #b4533e;
    --caution: #a07a2c;
    --shadow: 0 1px 3px rgba(74,66,52,.12), 0 4px 8px rgba(74,66,52,.06);
    --shadow-lift: 0 4px 10px rgba(74,66,52,.10), 0 14px 28px rgba(74,66,52,.12);
    --radius: 12px;
    --settle: cubic-bezier(0.22, 0.61, 0.36, 1);
    --snap: cubic-bezier(0.22, 0.61, 0.36, 1);
    --t-fast: 110ms;
    --t: 200ms;
    --t-slow: 340ms;
    /* Panes are cards on a well, the way Apple's window panes are: the gap is
       the divider. One ease-out for everything that moves into or out of place
       — it decelerates hard, so the last third of a move is a quiet settle. */
    --well: #efece3;
    --pane-r: 16px;
    --pane-gap: 10px;
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --t-room: 520ms;
    --bar-h: 2.25rem;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --well: #101214;
      --ink: #e8e6e1; --muted: #a3a7ab; --faint: #71767a; --line: #2f3438;
      --paper: #16181a; --paper-2: #1e2124; --paper-3: #262a2e; --card: #1c1f22;
      --card-rgb: 28, 31, 34; --paper-rgb: 22, 24, 26;
      --accent: #7fa8c9; --accent-soft: #1d2932; --accent-ink: #9dc0dc; --accent-ink-rgb: 157, 192, 220;
      --danger: #e08a74; --caution: #d9b25e;
      --shadow: 0 1px 3px rgba(0,0,0,.5), 0 4px 8px rgba(0,0,0,.3);
      --shadow-lift: 0 6px 16px rgba(0,0,0,.45), 0 18px 36px rgba(0,0,0,.35);
    }
  }
  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    margin: 0; background: var(--paper); color: var(--ink);
    transition: background-color var(--t-room) var(--ease-out);
    font: 14px/1.5 "Google Sans", Roboto, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
    display: grid; grid-template-rows: auto minmax(0, 1fr); grid-template-columns: minmax(0, 1fr);
  }
  [data-marble-editable] { outline: none; border-radius: 4px; transition: background var(--t-fast) var(--snap); }
  [data-marble-editable]:hover, [data-marble-editable]:focus-within { background: var(--accent-soft); }
  [data-marble-editable]:focus { background: var(--card); box-shadow: 0 0 0 1px var(--accent), 0 0 0 4px var(--accent-soft); }
  button { font: inherit; }
  button, .conv {
    transition: background var(--t) var(--settle),
      box-shadow var(--t) var(--settle), border-color var(--t) var(--settle), opacity var(--t) var(--settle);
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: .001ms !important; animation-iteration-count: 1 !important;
      transition-duration: .001ms !important; scroll-behavior: auto !important;
    }
    /* Drive zeros every transition. This page's spec is a 150 ms opacity
       crossfade on the two views, so those two have to win. */
    .library, .board, .folders, .focus {
      animation-duration: 150ms !important;
      transition-duration: 150ms !important;
    }
  }

  .topbar {
    grid-row: 1; grid-column: 1 / -1;
    display: flex; align-items: center; gap: .75rem; flex: 0 0 auto; flex-wrap: wrap;
    padding: .55rem 1rem; border-bottom: 1px solid var(--line);
    background: rgba(var(--paper-rgb), .78); backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    position: relative; z-index: 5;
  }
  .topbar h1 { font-size: 1.15rem; font-weight: 500; margin: 0; letter-spacing: -.015em; }
  .toggles {
    display: flex; align-items: center; gap: .35rem; flex: none;
    min-width: 0; flex-wrap: nowrap;
  }
  .seg {
    display: inline-flex; align-items: stretch; flex: none;
    border: 1px solid var(--line); border-radius: 999px;
    padding: 1px; background: var(--paper-3);
  }
  .seg button {
    appearance: none; border: 0; background: none; color: var(--muted);
    padding: .12rem .55rem; cursor: pointer; font-size: .75rem; line-height: 1.25;
    border-radius: 999px; white-space: nowrap; font-weight: 500;
  }
  .seg button:hover, .seg button:focus-visible { color: var(--ink); outline: none; }
  .seg button:active { color: var(--ink); background: var(--paper-2); }
  .seg button[aria-pressed="true"],
  body[data-view="library"] .views [data-view="library"],
  body[data-view="board"] .views [data-view="board"],
  body[data-view="folders"] .views [data-view="folders"],
  body[data-view="focus"] .views [data-view="focus"] {
    color: var(--ink); background: var(--card); box-shadow: var(--shadow);
  }
  input.search {
    flex: 1 1 12rem; min-width: 8rem; max-width: 28rem;
    padding: .45rem .9rem; border: 1px solid transparent; border-radius: 999px;
    background: var(--paper-3); color: var(--ink); font: inherit; outline: none;
    transition: background var(--t) var(--settle), box-shadow var(--t) var(--settle);
  }
  input.search:hover, input.search:focus-visible { background: var(--card); }
  input.search:focus { background: var(--card); border-color: var(--line); box-shadow: var(--shadow); }
  .new {
    appearance: none; border: 1px solid var(--line); background: var(--ink);
    color: var(--paper); padding: .35rem .85rem; border-radius: 999px; cursor: pointer; font-size: .85rem;
  }
  .new:hover, .new:focus-visible { box-shadow: var(--shadow); outline: none; }
  .settings {
    appearance: none; border: 1px solid var(--line); background: none;
    color: var(--muted); padding: .35rem .85rem; border-radius: 999px; cursor: pointer; font-size: .85rem;
  }
  .settings:hover, .settings:focus-visible { color: var(--ink); background: var(--paper-3); outline: none; }
  .usage {
    display: flex; align-items: center; gap: .7rem; min-width: 0;
    margin-left: auto; user-select: none;
  }
  .meter { display: flex; align-items: center; gap: .4rem; min-width: 0; }
  .meter-label {
    font-size: 12.5px; font-weight: 500; color: var(--muted); letter-spacing: -.01em;
  }
  .meter-bar {
    display: block; width: 5.5rem; height: 8px; flex: none;
    border-radius: 999px; background: var(--paper-3);
    box-shadow: inset 0 0 0 1px var(--line); overflow: hidden;
  }
  .meter-bar i {
    display: block; height: 100%; width: 0;
    background: var(--accent-ink); border-radius: inherit;
    transition: width var(--t) var(--settle), background var(--t) var(--settle);
  }
  .meter[data-tone="blue"] .meter-bar i { background: var(--accent-ink); }
  .meter[data-tone="yellow"] .meter-bar i { background: #c4a02a; }
  .meter[data-tone="orange"] .meter-bar i { background: #c46a28; }
  .meter[data-tone="red"] .meter-bar i { background: var(--danger); }
  .meter[data-tone="unavailable"] .meter-label,
  .meter[data-tone="unavailable"] .meter-pct { color: var(--faint); }
  .meter[data-tone="unavailable"] .meter-bar { background: var(--paper-2); }
  .meter[data-tone="unavailable"] .meter-bar i { width: 0 !important; background: var(--faint); }
  .meter-pct {
    font-size: 12.5px; font-weight: 500; font-variant-numeric: tabular-nums;
    color: var(--ink); min-width: 2.35em;
  }
  @media (prefers-color-scheme: dark) {
    .meter[data-tone="yellow"] .meter-bar i { background: #e0c056; }
    .meter[data-tone="orange"] .meter-bar i { background: #e08a4a; }
  }

  .library, .board, .folders, .focus {
    grid-row: 2; grid-column: 1; min-height: 0; min-width: 0;
  }
  .library {
    display: grid; grid-template-columns: minmax(16rem, 22rem) minmax(0, 1fr);
  }
  .folders, .focus { display: none; }
  .folder-rail {
    display: none; min-height: 0; overflow-y: auto; border-right: 1px solid var(--line);
    padding: .4rem 0; background: var(--paper);
  }
  .folder-group[data-color="research"],
  .conv[data-color="research"],
  .focus-card[data-color="research"],
  .focus-basin[data-color="research"] {
    --accent-ink-rgb: 47, 111, 91; --folder: #2f6f5b;
  }
  .folder-group[data-color="fun"],
  .conv[data-color="fun"],
  .focus-card[data-color="fun"],
  .focus-basin[data-color="fun"] {
    --accent-ink-rgb: 196, 92, 62; --folder: #c45c3e;
  }
  .folder-group[data-color="days"],
  .conv[data-color="days"],
  .focus-card[data-color="days"],
  .focus-basin[data-color="days"] {
    --accent-ink-rgb: 77, 106, 88; --folder: #6f8f7d;
  }
  .folder-group[data-color="marble"],
  .conv[data-color="marble"],
  .focus-card[data-color="marble"],
  .focus-basin[data-color="marble"] {
    --accent-ink-rgb: 95, 115, 133; --folder: #7e91a3;
  }
  .folder-group[data-color="travel"],
  .conv[data-color="travel"],
  .focus-card[data-color="travel"],
  .focus-basin[data-color="travel"] {
    --accent-ink-rgb: 61, 107, 138; --folder: #3d6b8a;
  }
  .folder-group[data-color="clay"],
  .conv[data-color="clay"],
  .focus-card[data-color="clay"],
  .focus-basin[data-color="clay"] {
    --accent-ink-rgb: 107, 79, 58; --folder: #6b4f3a;
  }
  .folder-group[data-color="sage"],
  .conv[data-color="sage"],
  .focus-card[data-color="sage"],
  .focus-basin[data-color="sage"] {
    --accent-ink-rgb: 61, 92, 74; --folder: #3d5c4a;
  }
  .folder-group[data-color="mist"],
  .conv[data-color="mist"],
  .focus-card[data-color="mist"],
  .focus-basin[data-color="mist"] {
    --accent-ink-rgb: 61, 90, 112; --folder: #3d5a70;
  }
  .folder-group[data-color="ink"],
  .conv[data-color="ink"],
  .focus-card[data-color="ink"],
  .focus-basin[data-color="ink"] {
    --accent-ink-rgb: 69, 76, 82; --folder: #454c52;
  }
  .folder-group[data-color="gold"],
  .conv[data-color="gold"],
  .focus-card[data-color="gold"],
  .focus-basin[data-color="gold"] {
    --accent-ink-rgb: 109, 86, 48; --folder: #6d5630;
  }
  .folder-group { margin: 0 0 .35rem; position: relative; }
  .folder-header {
    appearance: none; border: 0; background: none; width: 100%;
    display: flex; align-items: center; gap: .45rem; padding: .35rem .75rem;
    font: inherit; font-size: .82rem; font-weight: 500; color: var(--ink); cursor: pointer;
    text-align: left; user-select: none;
  }
  .folder-header:hover, .folder-header:focus-visible { background: var(--paper-3); outline: none; }
  .folder-header:focus-visible { box-shadow: inset 0 0 0 2px var(--accent); }
  .folder-header:active, .folder-tab:active, .folder-new-chat:active { background: var(--paper-2); }
  .folder-group.marble-active .folder-header { background: color-mix(in srgb, var(--folder) 12%, var(--paper)); }
  .folder-tick, .focus-folder {
    appearance: none; border: 0; flex: none; width: .7rem; height: .7rem; border-radius: 3px;
    background: var(--folder, var(--line)); padding: 0; cursor: pointer;
  }
  .folder-tick:active, .focus-folder:active { filter: brightness(.92); }
  .folder-tick:focus-visible, .focus-folder:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .folder-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .folder-name[contenteditable="true"],
  .folder-name[contenteditable="plaintext-only"] {
    overflow: visible; text-overflow: clip; user-select: text; background: var(--card);
    box-shadow: 0 0 0 1px var(--accent); border-radius: 4px; padding: 0 .2rem;
  }
  .folder-palette {
    position: absolute; z-index: 8; display: flex; flex-wrap: wrap; gap: .28rem;
    width: 8.2rem; padding: .4rem; margin: .15rem 0 0 .75rem;
    border: 1px solid var(--line); border-radius: .5rem;
    background: rgba(var(--card-rgb), .92);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    box-shadow: var(--shadow-lift);
  }
  .folder-palette button {
    appearance: none; border: 1px solid transparent; width: 1.05rem; height: 1.05rem;
    border-radius: 4px; padding: 0; cursor: pointer;
  }
  .folder-palette button[aria-pressed="true"] { box-shadow: 0 0 0 2px var(--ink); }
  .folder-palette button[data-color="research"] { background: #2f6f5b; }
  .folder-palette button[data-color="fun"] { background: #c45c3e; }
  .folder-palette button[data-color="days"] { background: #6f8f7d; }
  .folder-palette button[data-color="marble"] { background: #7e91a3; }
  .folder-palette button[data-color="travel"] { background: #3d6b8a; }
  .folder-palette button[data-color="clay"] { background: #6b4f3a; }
  .folder-palette button[data-color="sage"] { background: #3d5c4a; }
  .folder-palette button[data-color="mist"] { background: #3d5a70; }
  .folder-palette button[data-color="ink"] { background: #454c52; }
  .folder-palette button[data-color="gold"] { background: #6d5630; }
  .folder-count { flex: none; font-size: .72rem; color: var(--faint); font-variant-numeric: tabular-nums; }
  .folder-tabs { display: flex; flex-direction: column; gap: 1px; padding: 0 0 .15rem; }
  .folder-tab {
    appearance: none; background: none; width: 100%;
    display: flex; flex-direction: column; gap: 1px;
    padding: .34rem .75rem .34rem 1.55rem; font: inherit; font-size: .8rem;
    color: var(--muted); cursor: pointer; text-align: left;
    overflow: hidden;
    /* The folder's colour on the leading edge, so a tab still reads as a
       member of its group once the header has scrolled away. */
    border: 0; border-left: 2px solid transparent;
  }
  .folder-group .folder-tab { border-left-color: color-mix(in srgb, var(--folder) 45%, transparent); }
  .folder-tab .tab-top { display: flex; align-items: baseline; gap: .38rem; min-width: 0; }
  .folder-tab .tab-title {
    flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .folder-tab .tab-age {
    flex: none; font-size: .68rem; color: var(--faint); font-variant-numeric: tabular-nums;
  }
  .folder-tab .tab-target {
    display: block; font-size: .68rem; color: var(--faint);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    padding-left: .8rem;
  }
  .folder-tab .tab-target:empty { display: none; }
  .folder-tab .tab-dot { align-self: center; }
  .folder-tab:hover, .folder-tab:focus-visible { color: var(--ink); background: var(--paper-3); outline: none; }
  .folder-tab.marble-open { color: var(--ink); background: color-mix(in srgb, var(--folder, var(--accent-ink)) 10%, var(--paper)); }
  .folder-ungrouped { margin-top: .25rem; padding-top: .35rem; border-top: 1px solid var(--line); }
  .folder-ungrouped-label {
    padding: .2rem .75rem; font-size: .68rem; font-weight: 500; letter-spacing: .04em;
    text-transform: uppercase; color: var(--faint);
  }
  .folder-new-chat {
    appearance: none; border: 0; background: none; width: 100%;
    padding: .45rem .75rem; margin-top: .15rem; font: inherit; font-size: .8rem;
    color: var(--muted); cursor: pointer; text-align: left;
  }
  .folder-new-chat:hover, .folder-new-chat:focus-visible { color: var(--ink); background: var(--paper-3); outline: none; }
  .folder-tab.marble-selected { color: var(--ink); background: color-mix(in srgb, var(--accent-ink) 8%, var(--paper)); }
  .folder-tab.marble-drop-target, .folder-header.marble-drop-target {
    outline: 2px solid color-mix(in srgb, var(--accent-ink) 40%, transparent);
    outline-offset: -2px;
  }
  .folder-save {
    margin: .5rem .75rem 0; padding: .55rem .65rem; border: 1px solid var(--line);
    border-radius: .45rem; background: var(--paper-2); display: flex; flex-direction: column; gap: .45rem;
  }
  .folder-save input {
    width: 100%; box-sizing: border-box; padding: .35rem .45rem; font: inherit; font-size: .8rem;
    border: 1px solid var(--line); border-radius: .3rem; background: var(--paper);
  }
  .folder-save-confirm, .folder-save-dismiss {
    appearance: none; border: 0; background: none; padding: .3rem 0; font: inherit; font-size: .78rem;
    cursor: pointer; text-align: left;
  }
  .folder-save-confirm { color: var(--accent-ink); font-weight: 500; }
  .folder-save-dismiss { color: var(--muted); }
  .focus-workspace { display: none; }
  .focus {
    position: relative; overflow: auto; background: var(--paper);
  }
  .focus-empty {
    position: absolute; inset: 0; display: grid; place-items: center;
    margin: 0; color: var(--faint); font-size: .88rem; pointer-events: none;
  }
  .focus-card {
    position: absolute; display: flex; flex-direction: column;
    min-width: 0; min-height: 0; overflow: hidden;
    border: 1px solid var(--line); border-radius: 12px;
    background: var(--card); box-shadow: var(--shadow);
    color: var(--ink); touch-action: none;
    will-change: transform;
  }
  .focus-card:active { background: color-mix(in srgb, var(--paper-2) 70%, var(--card)); }
  .focus-card:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--accent), var(--shadow-lift); }
  /* A card is dragged from anywhere on it, except a Full, which is mostly a
     live transcript — there the header is the handle. */
  .focus-card[data-lod="digest"], .focus-card[data-lod="chip"] { cursor: grab; }
  .focus-card[data-lod="full"] .focus-card-head { cursor: grab; }
  .focus-card[data-lod="full"] { z-index: 3; }
  .focus-card[data-lod="digest"] { z-index: 2; }
  .focus-card[data-lod="chip"] {
    z-index: 1;
    border-left: 3px solid var(--folder, var(--line));
  }
  .focus-card[data-selected="true"] {
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent-ink) 70%, transparent), var(--shadow-lift);
  }
  /* Lifted: the card leaves the page and tracks the pointer 1:1. No
     transition on left/top — a transition here would lag the finger and the
     card would stop matching the slot it is about to be filed into. */
  .focus-card.marble-dragging { z-index: 40; box-shadow: var(--shadow-lift); cursor: grabbing; }
  .focus-card[data-lift="lead"] { transform: scale(1.02); }
  .focus-card[data-lift="follow"] { opacity: .8; }
  /* What a release would join, rather than slot beside. */
  .focus-card[data-drop="merge"] {
    box-shadow: 0 0 0 2px var(--accent-ink), var(--shadow-lift);
  }
  .focus-card-head {
    display: flex; align-items: center; gap: .4rem; flex: none;
    padding: .4rem .55rem; min-height: 2.1rem;
    border-bottom: 1px solid var(--line); font-size: .8rem; font-weight: 500;
  }
  .focus-card[data-lod="chip"] .focus-card-head { border-bottom: 0; }
  .focus-card-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .focus-tags { margin: 0 0 .1rem; flex-wrap: nowrap; overflow: hidden; }
  .focus-tags:empty { display: none; }
  .focus-card[data-lod="chip"] .focus-tags { display: none; }
  /* A chip is a title, its dot and one tick of context: the age. */
  .focus-head-age { flex: none; font-size: .72rem; color: var(--faint); font-variant-numeric: tabular-nums; }
  .focus-card:not([data-lod="chip"]) .focus-head-age { display: none; }
  .focus-card-actions { display: none; flex: none; gap: .2rem; }
  .focus-card[data-lod="digest"]:hover .focus-card-actions,
  .focus-card[data-lod="full"]:hover .focus-card-actions,
  .focus-card:focus-within .focus-card-actions { display: flex; }
  .focus-card[data-lod="chip"] .focus-folder,
  .focus-card[data-lod="chip"] .focus-pin,
  .focus-card[data-lod="chip"] .focus-keep,
  .focus-card[data-lod="chip"] .focus-collapse,
  .focus-card[data-lod="digest"] .focus-collapse { display: none; }
  @media (hover: none) {
    .focus-card .focus-card-actions { display: flex; }
  }
  .focus-folder-menu {
    position: fixed; z-index: 13; display: flex; flex-direction: column;
    min-width: 9.5rem; padding: .3rem;
    border: 1px solid var(--line); border-radius: .5rem;
    background: rgba(var(--card-rgb), .92);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    box-shadow: var(--shadow-lift);
  }
  .focus-folder-menu button {
    appearance: none; border: 0; background: none; text-align: left;
    padding: .32rem .5rem; font: inherit; font-size: .78rem; cursor: pointer;
    border-radius: .3rem; color: var(--ink);
  }
  .focus-folder-menu button:hover, .focus-folder-menu button:focus-visible {
    background: var(--paper-3); outline: none;
  }
  .focus-folder-menu button[aria-pressed="true"] { font-weight: 500; }
  .focus-card-actions button {
    appearance: none; border: 1px solid var(--line); background: var(--paper);
    color: var(--ink); border-radius: 999px; padding: .12rem .45rem;
    font: inherit; font-size: .68rem; cursor: pointer; white-space: nowrap;
  }
  .focus-card-actions button:hover, .focus-card-actions button:focus-visible {
    background: var(--accent-soft); outline: none;
  }
  .focus-card-body {
    flex: 1; min-height: 0; padding: .4rem .6rem .5rem; overflow: hidden;
    display: flex; flex-direction: column; gap: .12rem;
  }
  .focus-card[data-lod="chip"] .focus-card-body,
  .focus-card[data-lod="full"] .focus-card-body { display: none; }
  .focus-card-body p { margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .focus-target { font-size: .72rem; color: var(--faint); letter-spacing: -.005em; }
  .focus-activity { font-size: .78rem; color: var(--ink); }
  .focus-foot {
    margin-top: auto !important; display: flex; align-items: baseline; gap: .4rem;
    font-size: .72rem; color: var(--faint);
  }
  .focus-status { font-weight: 500; color: var(--muted); text-transform: capitalize; }
  .focus-age { font-variant-numeric: tabular-nums; margin-left: auto; }
  /* The dot is STATE_CSS's; only the status word is coloured here. */
  .focus-card[data-status="running"] .focus-status { color: var(--accent-ink); }
  .focus-card[data-status="review"] .focus-status { color: var(--caution); }
  .focus-card[data-outcome="failed"] .focus-status,
  .focus-card[data-outcome="watchdog"] .focus-status { color: var(--danger); }
  .focus[data-arranging] .focus-card[data-lod="full"] .focus-live:empty { display: none; }
  .focus[data-arranging] .focus-card[data-lod="full"]:has(.focus-live:empty) .focus-card-body {
    display: flex;
  }
  .focus-live { display: none; flex: 1; min-height: 0; min-width: 0; }
  .focus-card[data-lod="full"] .focus-live { display: block; }
  .focus-card[data-lod="full"] .focus-live marble-conversation { display: block; height: 100%; }
  .focus-basin {
    position: absolute; z-index: 0; pointer-events: none; border-radius: 16px;
    background: color-mix(in srgb, var(--folder) 14%, var(--paper));
    border: 1px solid color-mix(in srgb, var(--folder) 28%, var(--line));
    transition: left var(--t) var(--settle), top var(--t) var(--settle),
      width var(--t) var(--settle), height var(--t) var(--settle);
  }
  /* Loose chats share the basins' geometry so they sit on the same baseline,
     and give up only the fill — the difference says "not filed" without
     making them look dropped on the floor. */
  .focus-basin[data-loose] {
    background: none; border-style: dashed;
    border-color: color-mix(in srgb, var(--line) 80%, transparent);
  }
  .focus-basin[data-loose] .focus-basin-name { color: var(--faint); }
  .focus-basin[data-drop="into"] {
    border-color: color-mix(in srgb, var(--folder, var(--accent-ink)) 60%, var(--line));
    background: color-mix(in srgb, var(--folder, var(--accent-ink)) 22%, var(--paper));
  }
  .focus-basin[data-loose][data-drop="into"] {
    border-style: solid;
    border-color: color-mix(in srgb, var(--accent-ink) 45%, var(--line));
    background: color-mix(in srgb, var(--accent-ink) 7%, var(--paper));
  }
  .focus-basin-name {
    pointer-events: auto; position: absolute; top: .5rem; left: 18px;
    font-size: .72rem; font-weight: 500; color: var(--folder, var(--muted));
    border: 0; background: none; padding: 0; font: inherit; font-size: .72rem; font-weight: 500;
  }
  /* Where the card would land, drawn at the rect the layout already reserved
     for it: a gap in a folder column, or the full-height column a pin becomes. */
  .focus-slot {
    position: absolute; z-index: 4; pointer-events: none; border-radius: 12px;
    border: 2px dashed color-mix(in srgb, var(--accent-ink) 55%, transparent);
    background: color-mix(in srgb, var(--accent-ink) 6%, transparent);
    transition: left var(--t) var(--settle), top var(--t) var(--settle),
      width var(--t) var(--settle), height var(--t) var(--settle);
  }
  /* Making a folder had no affordance at all — you had to guess that one card
     dropped on another meant something. A column you can see says it, and a
     real button means the keyboard can say it too. */
  .focus-newgroup {
    position: absolute; z-index: 1; appearance: none; padding: 0; font: inherit;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: .3rem; border-radius: 16px; background: none; color: var(--faint);
    border: 1px dashed color-mix(in srgb, var(--line) 85%, transparent);
    cursor: pointer;
  }
  .focus-newgroup:disabled { cursor: default; }
  .focus-newgroup:hover:not(:disabled), .focus-newgroup:focus-visible {
    color: var(--ink); border-color: var(--accent); outline: none;
    background: color-mix(in srgb, var(--accent-ink) 5%, transparent);
  }
  .focus-newgroup[data-drop="into"] {
    color: var(--accent-ink); border-style: solid; border-color: var(--accent-ink);
    background: color-mix(in srgb, var(--accent-ink) 10%, transparent);
  }
  .focus-newgroup-mark { font-size: 1.15rem; line-height: 1; }
  .focus-newgroup-label { font-size: .72rem; }
  /* With nothing pinned there is no stage column to aim at, so a drag
     reserves one. It exists only while a card is in the air. */
  .focus-pinslot {
    position: fixed; z-index: 11; display: grid; place-items: center;
    pointer-events: none; font-size: .68rem; letter-spacing: .04em;
    text-transform: uppercase; color: var(--faint); writing-mode: vertical-rl;
    border-right: 1px dashed color-mix(in srgb, var(--accent-ink) 35%, transparent);
    background: linear-gradient(to right, color-mix(in srgb, var(--accent-ink) 9%, transparent), transparent);
  }
  .focus-pinslot[data-drop="into"] {
    border-right: 2px solid var(--accent-ink); color: var(--accent-ink);
    background: linear-gradient(to right, color-mix(in srgb, var(--accent-ink) 22%, transparent), transparent);
  }
  /* Absolutely positioned cards do not reliably push a scroll container out on
     both axes, and a min-height on the canvas would grow the grid row instead
     of its contents. This block is the extent, and nothing else. */
  .focus-extent { position: absolute; left: 0; top: 0; pointer-events: none; }
  .focus-look {
    position: fixed; z-index: 12;
    width: min(28rem, calc(100vw - 2rem)); max-height: 70vh; overflow: auto;
    padding: 1rem 1.1rem; border: 1px solid var(--line); border-radius: 12px;
    background: rgba(var(--card-rgb), .86);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    box-shadow: var(--shadow-lift);
  }
  .focus-look h3 { margin: 0 0 .35rem; font-size: 1rem; font-weight: 500; }
  .focus-look .look-meta { color: var(--muted); font-size: .8rem; margin: 0 0 .75rem; }
  .focus-look .look-events { margin: 0; padding-left: 1.1rem; color: var(--ink); font-size: .85rem; }
  .focus[data-stack] { overflow: auto; display: flex; flex-direction: column; gap: .65rem; padding: .75rem; }
  .focus[data-stack] .focus-card {
    position: relative; left: auto !important; top: auto !important;
    width: auto !important; height: auto !important; flex: none;
    touch-action: auto; cursor: default;
  }
  .focus[data-stack] .focus-slot,
  .focus[data-stack] .focus-newgroup,
  .focus[data-stack] .focus-pinslot,
  .focus[data-stack] .focus-extent { display: none; }
  .focus[data-stack] .focus-card[data-lod="full"] { min-height: 18rem; }
  .focus[data-stack] .focus-card[data-lod="digest"] { min-height: 7rem; }
  .focus[data-stack] .focus-basin { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .focus-card, .focus-look {
      animation-duration: 150ms !important;
      transition-duration: 150ms !important;
    }
    .focus-basin, .focus-slot { transition: none; }
    .focus-card[data-lift="lead"] { transform: none; }
  }
  @media (prefers-reduced-transparency: reduce) {
    .topbar, .focus-look, .folder-palette, .focus-folder-menu {
      background: var(--card);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
  body[data-view="board"] .library,
  body[data-view="focus"] .board,
  body[data-view="focus"] .folders { display: none; }
  body[data-view="focus"] .library {
    display: block; background: transparent; pointer-events: none; overflow: visible;
  }
  body[data-view="focus"] .library #list { display: none; }
  body[data-view="focus"] .library .pane { pointer-events: auto; }
  body[data-view="focus"] .dock-bar,
  body[data-view="focus"] .dock-stage,
  body[data-view="focus"] .pane-hint,
  body[data-view="focus"] .pane > .back {
    display: none !important;
  }
  body[data-view="focus"] .pane {
    grid-template-rows: minmax(0, 1fr);
    background: var(--card);
  }
  body[data-view="library"] .board,
  body[data-view="library"] .folders,
  body[data-view="library"] .focus { display: none; }
  body[data-view="board"] .folders,
  body[data-view="board"] .focus { display: none; }
  body[data-view="folders"] .board,
  body[data-view="folders"] .focus { display: none; }
  body[data-view="folders"] .folders,
  body[data-view="folders"] .library {
    display: grid; grid-template-columns: minmax(16rem, 22rem) minmax(0, 1fr);
  }
  body[data-view="folders"] .folders { pointer-events: none; }
  body[data-view="folders"] .library #list { display: none; }
  body[data-view="folders"] .library .pane { grid-column: 2; }
  body[data-view="folders"] .folder-rail { display: block; grid-column: 1; pointer-events: auto; }
  body[data-view="focus"] .focus { display: block; }
  /* A part that is leaving stays on screen where it was, out of the flow, for as
     long as it takes to fade — then the layout it no longer belongs to
     forgets it. */
  .list.marble-vt-out { display: block !important; }
  .folders.marble-vt-out { display: grid !important; }
  .board.marble-vt-out { display: flex !important; }
  .focus.marble-vt-out { display: block !important; }
  .pane.marble-vt-out { display: grid !important; }
  .library.marble-vt-shell { display: grid !important; }
  .library.marble-vt-shell > :not(.marble-vt-out) { visibility: hidden; }
  /* Board + an open conversation is a split: kanban left, pane right.
     Do not reparent <marble-conversation> — a missing keyed child in .pane
     is cloned on reconcile. */
  body[data-view="board"][data-panel="open"] {
    grid-template-columns: minmax(0, 1fr) minmax(18rem, min(38vw, 28rem));
  }
  body[data-view="board"][data-panel="open"] .board {
    grid-column: 1; grid-row: 2; min-width: 0;
  }
  /* The same pane List draws — rounded, shadowed, with its bar — set beside
     the kanban with the board's own gutter. */
  body[data-view="board"][data-panel="open"] .library {
    display: grid;
    grid-column: 2; grid-row: 2;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    background: transparent;
    padding: var(--pane-gap) var(--pane-gap) var(--pane-gap) 0;
    min-width: 0;
    z-index: 2;
  }
  body[data-view="board"][data-panel="open"] .list { display: none; }
  body[data-view="board"][data-panel="open"] .pane {
    grid-column: 1; grid-row: 1; min-width: 0; max-width: none; overflow: hidden;
  }
  .board {
    display: flex; align-items: stretch; gap: 1rem; padding: 1rem;
    overflow: hidden; position: relative; min-height: 0;
  }
  /* Columns are the full height of the board and scroll in place. A board that
     scrolls as one leaves a short column trailing dead space beside a long one
     that has run off the bottom of the window. */
  .column {
    flex: 1 1 0; min-width: 14rem; min-height: 0; display: flex; flex-direction: column; gap: .5rem;
    background: var(--paper-2); border: 1px solid var(--line); border-radius: var(--radius); padding: .7rem;
    overflow-y: auto; overscroll-behavior: contain;
  }
  .column h2 {
    position: sticky; top: -.7rem; z-index: 1;
    display: flex; align-items: center; gap: .4rem;
    margin: -.7rem -.7rem 0; padding: .7rem .7rem .4rem;
    background: var(--paper-2);
    font-size: .75rem; font-weight: 500; letter-spacing: .06em;
    text-transform: uppercase; color: var(--faint);
  }
  .col-count {
    margin-left: auto; font-size: .72rem; letter-spacing: 0; color: var(--faint);
    font-variant-numeric: tabular-nums;
  }
  .col-count:empty { display: none; }
  /* No JS "is this column empty" flag to keep in sync — :has() derives it
     straight from the DOM, which is the one place the fact already lives. */
  .column:not(:has(> .conv:not([hidden])))::after {
    content: 'Nothing here'; font-size: .82rem; color: var(--faint); padding: .1rem .05rem;
  }
  .column .conv {
    border-radius: 10px; background: var(--card); border: 1px solid var(--line);
    padding: .65rem .75rem;
  }
  .conv.marble-flip,
  .conv.marble-flip:active {
    transition: none !important;
    transform-origin: 0 0;
    z-index: 6;
    pointer-events: none;
  }

  .list {
    min-height: 0; overflow-y: auto; border-right: 1px solid var(--line);
    padding: .4rem 0; background: var(--paper);
  }
  .conv {
    display: grid; grid-template-columns: 10px minmax(0, 1fr) auto auto; gap: .65rem; align-items: start;
    width: 100%; text-align: left; appearance: none; border: 0; background: none;
    color: inherit; padding: .55rem .9rem; cursor: pointer; border-radius: 0;
  }
  .conv:hover, .conv:focus-visible { background: var(--paper-3); outline: none; }
  .conv.marble-open { background: var(--accent-soft); }
  /* Folder colour on the leading edge, the same 2px rule the rail tab uses, so
     a row is recognisable as a member of its group in List and Board too. */
  .conv { border-left: 2px solid transparent; }
  .conv[data-color] { border-left-color: color-mix(in srgb, var(--folder) 45%, transparent); }
  /* An author-level `display: grid` above beats the UA [hidden] rule, so a
     filtered-out row stays fully visible unless this re-asserts it. */
  .conv[hidden] { display: none; }
  .conv .dot { margin-top: .42rem; }
  .dock-bar .dot { margin-right: .1rem; }
  /* Four facts, three lines: the agent's name shares the last line with the
     activity instead of claiming a row of its own. */
  .conv .body {
    min-width: 0; display: grid; align-items: baseline;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas: "title title" "target target" "tags meta";
    gap: .1rem .4rem;
  }
  .conv .title { grid-area: title; }
  .conv .target { grid-area: target; }
  .conv .tags { grid-area: tags; }
  .conv .meta { grid-area: meta; }
  .conv .title { font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .conv .target {
    font-size: .72rem; color: var(--faint);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .conv .target:empty { display: none; }
  .conv .tags:empty { display: none; }
  .conv .tags { display: flex; flex-wrap: wrap; gap: 4px; }
  /* The agent's name is the same on every row of a one-agent drive, so it is
     context rather than a headline. It keeps its place — which conversation
     ran on which CLI is worth knowing — but gives up the filled pill that made
     it the loudest thing in the list. */
  .conv .tag[data-kind="agent"] {
    background: none !important; color: var(--faint) !important;
    padding: 2px 0; font-weight: 400;
  }
  .conv .tag[data-kind="agent"] + .tag::before {
    content: '·'; color: var(--faint); margin-right: 4px;
  }
  .tags { display: flex; flex-wrap: wrap; gap: 4px; }
  .conv .meta { display: flex; gap: .35rem; min-width: 0; color: var(--muted); font-size: .78rem; }
  .conv .meta > * { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* Provider is almost always the same one agent, so it rides in the meta
     line as plain text rather than competing for attention as its own pill. */
  .conv .badge { flex: none; max-width: 6em; }
  .conv .badge:not(:empty)::after { content: '\00b7'; margin-left: .35rem; color: var(--faint); }
  .conv .activity { flex: 1 1 auto; }
  .conv .age { flex: none; font-size: .75rem; color: var(--faint); padding-top: .15rem; }
  .conv .manage { position: relative; flex: none; }
  .conv .manage .more {
    appearance: none; border: 0; background: none; color: var(--faint); cursor: pointer;
    width: 28px; height: 28px; margin: -.25rem -.35rem 0 0; border-radius: 8px;
    display: grid; place-items: center;
  }
  .conv .manage .more:hover, .conv .manage .more:focus-visible { color: var(--ink); background: var(--paper-3); outline: none; }
  .conv .manage .more[aria-expanded="true"] { color: var(--ink); background: var(--paper-3); }
  .conv .manage .menu {
    position: absolute; right: 0; top: calc(100% + 4px); z-index: 8; min-width: 11.5rem;
    background: var(--card); border: 1px solid var(--line); border-radius: 10px;
    box-shadow: var(--shadow-lift); padding: 4px;
  }
  .conv .manage .menu button {
    display: block; width: 100%; text-align: left; appearance: none; border: 0; background: none;
    color: var(--ink); font: inherit; font-size: .82rem; padding: .4rem .65rem; border-radius: 8px; cursor: pointer;
  }
  .conv .manage .menu button:hover, .conv .manage .menu button:focus-visible { background: var(--paper-2); outline: none; }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(var(--accent-ink-rgb), .12); }
    50% { box-shadow: 0 0 0 5px rgba(var(--accent-ink-rgb), .28); }
  }

  .pane {
    position: relative; min-width: 0; min-height: 0;
    display: grid; grid-template-rows: auto minmax(0, 1fr); grid-template-columns: minmax(0, 1fr);
    background: var(--card);
    --dock-gap: 5px;
  }
  .pane > .dock-bar { grid-column: 1; grid-row: 1; min-width: 0; }
  .pane > marble-conversation:not([data-marble-transient]) {
    grid-column: 1; grid-row: 2; min-width: 0; min-height: 0;
  }
  /* Two or more panes: the pane becomes a stage. Every chat is a card placed by
     percentages and a pixel gap, so a change to the layout is only new numbers
     and the browser eases each card to them. The primary chat is the keyed
     element and cannot move into its card, so it is placed over it. */
  .dock-stage { position: absolute; inset: 0; pointer-events: none; }
  .pane[data-dock] > .dock-bar,
  .pane[data-dock] > marble-conversation:not([data-marble-transient]) {
    position: absolute; z-index: 2; margin: 0; min-width: 0; min-height: 0;
  }
  .pane > .dock-bar,
  .pane > marble-conversation:not([data-marble-transient]),
  .dock-frame, .dock-gutter {
    transition: left var(--t-room) var(--ease-out), top var(--t-room) var(--ease-out),
      width var(--t-room) var(--ease-out), height var(--t-room) var(--ease-out),
      opacity 260ms var(--ease-out), transform 360ms var(--ease-out),
      background-color 200ms var(--ease-out);
  }
  .pane.marble-noanim, .pane.marble-noanim *, .pane.marble-docksizing, .pane.marble-docksizing * { transition: none !important; }
  .dock-frame {
    position: absolute; z-index: 1; display: flex; flex-direction: column;
    min-width: 0; min-height: 0; overflow: hidden; pointer-events: auto;
    border: 1px solid var(--line); border-radius: var(--pane-r);
    background: var(--paper); box-shadow: var(--shadow);
  }
  .dock-frame[data-key="P"] { z-index: 0; pointer-events: none; }
  /* The pane you are in is the lit one; its neighbours step back onto the
     paper so there is never a question of where typing goes. */
  .pane[data-dock] .dock-frame[data-focused] { background: var(--card); }
  .pane[data-dock] .dock-frame:not([data-focused]) { background: var(--paper); }
  .pane[data-dock] .dock-frame:not([data-focused]) .dock-bar { background: var(--paper-2); color: var(--muted); }
  .pane[data-dock] .dock-frame:not([data-focused]) marble-conversation { opacity: .86; }
  .pane[data-dock] > .dock-bar:not([data-focused]) { background: var(--paper-2); color: var(--muted); }
  .pane[data-dock] > marble-conversation:not([data-marble-transient])[data-focused="false"] { opacity: .86; }
  .dock-bar[data-focused] { box-shadow: inset 0 -1px 0 var(--accent); }
  .dock-frame .dock-bar { transition: background-color 200ms var(--ease-out), color 200ms var(--ease-out); }
  .dock-frame marble-conversation { transition: opacity 200ms var(--ease-out); }
  .dock-frame marble-conversation { flex: 1; min-height: 0; height: 100%; }
  .dock-frame.marble-entering { opacity: 0; transform: scale(.97); }
  .dock-frame.marble-leaving { opacity: 0; transform: scale(.97); pointer-events: none; z-index: 0; }
  /* The seam between two panes is the gap. It is invisible until you reach for it. */
  .dock-gutter { position: absolute; z-index: 3; pointer-events: auto; touch-action: none; }
  .dock-gutter[data-dir="row"] { cursor: col-resize; }
  .dock-gutter[data-dir="col"] { cursor: row-resize; }
  .dock-gutter[data-dir="row"]::before { content: ''; position: absolute; inset: 0 -4px; }
  .dock-gutter[data-dir="col"]::before { content: ''; position: absolute; inset: -4px 0; }
  .dock-gutter::after {
    content: ''; position: absolute; left: 50%; top: 50%; border-radius: 999px;
    background: var(--faint); opacity: 0;
    transition: opacity 200ms var(--ease-out), transform 260ms var(--ease-out);
  }
  .dock-gutter[data-dir="row"]::after { width: 4px; height: 36px; transform: translate(-50%, -50%) scaleY(.6); }
  .dock-gutter[data-dir="col"]::after { width: 36px; height: 4px; transform: translate(-50%, -50%) scaleX(.6); }
  .dock-gutter:hover::after, .pane.marble-docksizing .dock-gutter::after { opacity: .55; transform: translate(-50%, -50%); }
  .dock-bar {
    display: flex; align-items: center; gap: .45rem; flex: none;
    height: var(--bar-h); padding: 0 .45rem 0 .55rem; box-sizing: border-box;
    border-bottom: 1px solid var(--line); background: var(--paper-2);
    cursor: grab; user-select: none; min-width: 0;
  }
  .dock-bar:active { cursor: grabbing; }
  .dock-bar.marble-drop-swap { background: var(--accent-soft); box-shadow: inset 0 0 0 1px var(--accent); }
  .dock-grip { flex: none; color: var(--faint); }
  .dock-title {
    flex: 1; min-width: 0; font-size: 12.5px; font-weight: 500; letter-spacing: -.01em;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .dock-target {
    flex: none; max-width: 9rem; font-size: 11.5px; color: var(--accent-ink);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-decoration: none;
  }
  .dock-target:hover, .dock-target:focus-visible { color: var(--ink); outline: none; }
  .dock-target[hidden] { display: none; }
  .dock-close {
    appearance: none; border: 0; background: none; flex: none;
    color: var(--muted); width: 1.55rem; height: 1.55rem; border-radius: 8px; cursor: pointer;
    display: grid; place-items: center;
  }
  .dock-close:hover, .dock-close:focus-visible { color: var(--ink); background: var(--paper-3); outline: none; }
  .dock-split {
    appearance: none; border: 0; background: none; flex: none;
    color: var(--faint); width: 1.4rem; height: 1.4rem; border-radius: 8px; cursor: pointer;
    display: grid; place-items: center;
  }
  .dock-split:hover, .dock-split:focus-visible { color: var(--ink); background: var(--paper-3); outline: none; }
  /* Where a dragged card opens when the board has no pane yet. */
  .board-dockzone {
    position: absolute; top: 1rem; right: 1rem; bottom: 1rem; width: min(38vw, 28rem); z-index: 4;
    display: grid; place-items: center; pointer-events: none;
    border: 1.5px dashed color-mix(in srgb, var(--accent-ink) 45%, transparent); border-radius: var(--pane-r);
    background: color-mix(in srgb, var(--accent-ink) 6%, var(--paper));
    color: var(--accent-ink); font-size: .8rem;
    transition: background-color 160ms var(--ease-out), border-color 160ms var(--ease-out);
  }
  .board-dockzone[data-drop] {
    border-color: var(--accent-ink);
    background: color-mix(in srgb, var(--accent-ink) 12%, var(--paper));
  }
  body:not([data-open]) .pane > .dock-bar { display: none; }
  /* The chat in your hand. It lifts when it is picked up and settles small
     once it is over somewhere it will dock, so the pane — not the card — is
     what you are looking at when you let go. */
  .dock-card {
    position: fixed; z-index: 40; pointer-events: none; width: 16.5rem;
    padding: .65rem .8rem; background: var(--card); border: 1px solid var(--line);
    border-radius: 14px; box-shadow: var(--shadow-lift);
    transform-origin: var(--grab-x, 16px) var(--grab-y, 16px);
    animation: card-lift 240ms var(--ease-out) both;
    transition: transform 320ms var(--ease-out), opacity 240ms var(--ease-out);
  }
  .dock-card.marble-docking { transform: scale(.86); opacity: .82; }
  @keyframes card-lift { from { transform: scale(.94); opacity: 0; } }
  .dock-card .dock-title { display: block; font-size: 13px; font-weight: 500; }
  .dock-card .dock-target { display: block; max-width: none; color: var(--muted); margin-top: .15rem; }
  .marble-lifted { opacity: .4; }
  .marble-dragging-chat, .marble-dragging-chat * {
    user-select: none !important; -webkit-user-select: none !important; cursor: grabbing !important;
  }
  /* Where it will land. The ghost is a real leaf in the layout, so the room it
     asks for is made by the same numbers the real chat will take. */
  .pane .dock-frame.dock-ghost {
    align-items: center; justify-content: center; gap: .55rem; pointer-events: none;
    border: 1.5px dashed color-mix(in srgb, var(--accent-ink) 50%, transparent);
    background: color-mix(in srgb, var(--accent-ink) 7%, var(--paper)); box-shadow: none;
  }
  .dock-ghost > * { animation: ghost-in 420ms var(--ease-out) 120ms both; transition: opacity 160ms var(--ease-out); }
  .dock-ghost.marble-leaving { opacity: .0; }
  .dock-ghost.marble-leaving > * { opacity: 0; animation: none; }
  .dock-ghost-tab {
    display: inline-flex; align-items: center; gap: .45rem; max-width: 86%;
    padding: .35rem .7rem; border-radius: 999px; background: var(--card);
    border: 1px solid var(--line); box-shadow: var(--shadow); font-size: 12.5px; font-weight: 500;
  }
  .dock-ghost-tab span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dock-ghost p { margin: 0; font-size: .75rem; color: var(--accent-ink); }
  /* Handed over on drop: the real chat is under it, so it dissolves rather than
     the slot popping into a conversation. */
  .pane .dock-frame.dock-ghost.marble-dissolve {
    position: absolute; inset: 0; left: 0; top: 0; width: auto; height: auto; z-index: 5;
    border-radius: inherit; animation: ghost-out 340ms var(--ease-out) both; transition: none;
  }
  .dock-ghost.marble-dissolve > * { animation: none; }
  @keyframes ghost-in { from { opacity: 0; transform: translateY(6px) scale(.96); } }
  @keyframes ghost-out { to { opacity: 0; } }
  /* Nothing makes room when the drop replaces — the chat that is about to go
     steps back instead. */
  .pane.marble-replace-primary > marble-conversation:not([data-marble-transient]),
  .pane.marble-replace-primary > .dock-bar,
  .dock-frame.marble-replace {
    opacity: .42; transform: scale(.985);
  }
  .pane.marble-drop-fill::after {
    content: ''; position: absolute; inset: 0; z-index: 6; pointer-events: none;
    border-radius: inherit; background: rgba(var(--accent-ink-rgb), .06);
    box-shadow: inset 0 0 0 2px rgba(var(--accent-ink-rgb), .35);
    animation: ghost-in 240ms var(--ease-out) both;
  }
  .pane marble-conversation { min-height: 0; }
  /* The composer is always live — even with nothing picked, typing below
     starts a conversation — so the hint sits above it, not over it. */
  .pane-hint {
    position: absolute; inset: 0; bottom: 6.5rem; display: none; z-index: 1;
    flex-direction: column; align-items: center; justify-content: center; gap: .6rem;
    color: var(--faint); text-align: center; padding: 0 2rem; pointer-events: none;
  }
  .pane-hint p { margin: 0; font-size: .88rem; max-width: 22rem; }
  body:not([data-open]) .pane-hint { display: flex; }
  .pane .back {
    display: none; position: absolute; top: .6rem; left: .6rem; z-index: 2;
    appearance: none; border: 0; background: rgba(var(--paper-rgb), .85); backdrop-filter: blur(8px);
    color: var(--ink); width: 2rem; height: 2rem; border-radius: 999px; cursor: pointer;
    align-items: center; justify-content: center; box-shadow: var(--shadow);
  }
  .pane .back:hover, .pane .back:focus-visible { background: var(--card); outline: none; }

  /* Cards on a well. Only where the panes live (List and Folders) and only
     where there is room; a phone gets one pane at a time, edge to edge. */
  @media (min-width: 720px) {
    body[data-view="library"],
    body[data-view="folders"] { background: var(--well); }
    body[data-view="library"] .library,
    body[data-view="folders"] .library { padding: var(--pane-gap); column-gap: var(--pane-gap); }
    body[data-view="folders"] .folders { padding: var(--pane-gap); column-gap: var(--pane-gap); }
    body[data-view="library"] .pane,
    body[data-view="folders"] .pane,
    body[data-view="board"] .pane {
      background: transparent; isolation: isolate; --dock-gap: var(--pane-gap);
    }
    /* Alone, the primary chat is a bar and a conversation in two grid rows, so
       its card is a third thing behind both. With company it gets a card in the
       stage like every other pane. */
    body[data-view="library"] .pane:not([data-dock])::before,
    body[data-view="folders"] .pane:not([data-dock])::before,
    body[data-view="board"] .pane:not([data-dock])::before {
      content: ''; z-index: -1; grid-column: 1; grid-row: 1 / -1;
      border: 1px solid var(--line); border-radius: var(--pane-r);
      background: var(--paper); box-shadow: var(--shadow);
    }
    body[data-view="library"] .pane > .dock-bar,
    body[data-view="folders"] .pane > .dock-bar,
    body[data-view="library"] .dock-frame .dock-bar,
    body[data-view="folders"] .dock-frame .dock-bar,
    body[data-view="board"] .pane > .dock-bar,
    body[data-view="board"] .dock-frame .dock-bar {
      background: transparent; border-radius: var(--pane-r) var(--pane-r) 0 0;
      padding-left: .8rem;
    }
    body[data-view="library"] .pane > marble-conversation:not([data-marble-transient]),
    body[data-view="folders"] .pane > marble-conversation:not([data-marble-transient]),
    body[data-view="board"] .pane > marble-conversation:not([data-marble-transient]) {
      border-radius: 0 0 var(--pane-r) var(--pane-r); overflow: hidden;
    }

    body[data-view="folders"] .folder-rail,
    body[data-view="library"] .list {
      border: 1px solid var(--line); border-radius: var(--pane-r);
      background: var(--paper); box-shadow: var(--shadow); padding: .5rem;
    }
    body[data-view="folders"] .folder-header,
    body[data-view="folders"] .folder-new-chat,
    body[data-view="folders"] .folder-tab { border-radius: 10px; }
    body[data-view="folders"] .folder-tabs { gap: 2px; padding: 2px 0 .3rem; }
    body[data-view="folders"] .folder-group { margin-bottom: .2rem; }
    body[data-view="folders"] .folder-ungrouped { margin-top: .35rem; border-top-color: transparent; }
    body[data-view="folders"] .folder-group .folder-tab,
    body[data-view="library"] .list .conv[data-color] {
      border-left: 0;
      background-image: linear-gradient(color-mix(in srgb, var(--folder) 55%, transparent), color-mix(in srgb, var(--folder) 55%, transparent));
      background-repeat: no-repeat; background-size: 3px calc(100% - 16px); background-position: .55rem center;
    }
    body[data-view="library"] .list .conv { border-left: 0; border-radius: 10px; padding-left: 1.1rem; }
    body[data-view="folders"] .folder-tab.marble-drop-target,
    body[data-view="folders"] .folder-header.marble-drop-target {
      outline: none; background-color: color-mix(in srgb, var(--accent-ink) 9%, transparent);
      box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--accent-ink) 42%, transparent);
    }
    /* The seams sit in the gap now, not on a card edge. */
    body[data-view="library"] .rz-list,
    body[data-view="folders"] .rz-rail { margin-left: calc(var(--pane-gap) * 1.5); }
  }

  @media (max-width: 719px) {
    /* Title + segmented bars + New stay on the first wrap; search gets
       its own row. The three bars scroll sideways if they cannot fit. */
    .topbar { row-gap: .5rem; padding: .5rem .75rem; }
    .topbar h1 { order: 1; font-size: 1.05rem; }
    .toggles { order: 2; flex: 1 1 auto; min-width: 0; overflow-x: auto; -webkit-overflow-scrolling: touch; padding-bottom: 1px; }
    .usage { order: 3; margin-left: auto; }
    .settings { order: 3; }
    .new { order: 4; }
    input.search { order: 5; flex-basis: 100%; }

    /* One pane at a time, not three squeezed into one screen. The library
       shows the list; opening a row swaps it for the conversation (with a
       back button) and its details, scrolling together. */
    .library { display: block; overflow-y: auto; }
    .list { border-right: 0; max-height: none; height: 100%; }
    .pane { display: none; }
    body[data-open] .list { display: none; }
    body[data-open] .filters { display: none; }
    body[data-open] .pane { display: grid; height: 65vh; min-height: 22rem; }
    body[data-open]:not([data-panel="open"]) .pane .back { display: flex; }
    .pane-hint { bottom: 7.5rem; }

    .board { scroll-snap-type: x mandatory; }
    .column { flex: 0 0 min(20rem, 85vw); scroll-snap-align: start; }
    body[data-view="board"][data-panel="open"] {
      grid-template-columns: minmax(0, 1fr);
    }
    body[data-view="board"][data-panel="open"] .board {
      display: flex; grid-column: 1; height: 0; min-height: 0; padding: 0; overflow: visible;
      pointer-events: none;
    }
    body[data-view="board"][data-panel="open"] .column { display: none; }
    body[data-view="board"][data-panel="open"] .library {
      grid-column: 1; grid-template-columns: minmax(0, 1fr);
    }
    body[data-view="board"][data-panel="open"] .pane { height: auto; }
  }
  @media (hover: none) {
    .conv, .seg button, .new, .settings, .conv .manage .more { min-height: 2.75rem; }
  }
</style>
</head>
<body data-marble-id="__ID__" data-view="library">

<header class="topbar" data-marble-id="__ID__">
  <h1 data-marble-id="__ID__" data-marble-editable>__TITLE__</h1>
  <div class="toggles" data-marble-id="__ID__">
    <div class="seg views" role="group" aria-label="View" data-marble-id="__ID__">
      <button type="button" data-view="library" aria-pressed="true" data-marble-id="__ID__">List</button>
      <button type="button" data-view="board" aria-pressed="false" data-marble-id="__ID__">Board</button>
      <button type="button" data-view="folders" aria-pressed="false" data-marble-id="__ID__">Folders</button>
      <button type="button" data-view="focus" aria-pressed="false" data-marble-id="__ID__">Focus</button>
    </div>
    <div class="seg cli" role="group" aria-label="CLI" data-marble-transient></div>
    <div class="seg filters" role="group" aria-label="Filter" data-marble-id="__ID__">
      <button type="button" class="filter" data-filter="all" aria-pressed="true" data-marble-id="__ID__">All</button>
      <button type="button" class="filter" data-filter="running" aria-pressed="false" data-marble-id="__ID__">Running</button>
      <button type="button" class="filter" data-filter="review" aria-pressed="false" data-marble-id="__ID__">Review</button>
      <button type="button" class="filter" data-filter="archived" aria-pressed="false" data-marble-id="__ID__">Archived</button>
    </div>
  </div>
  <input class="search" type="search" placeholder="Search conversations" autocomplete="off" aria-label="Search conversations" data-marble-id="__ID__">
  <div class="usage" data-marble-transient role="group" aria-label="Usage remaining"></div>
  <button type="button" class="settings" data-marble-id="__ID__">Settings</button>
  <button type="button" class="new" data-marble-id="__ID__">New</button>
</header>

<div class="library" data-marble-id="__ID__">
  <div id="list" class="list" role="list" data-marble-id="__ID__" data-marble-transient></div>
  <section class="pane" data-marble-id="__ID__">
    <button type="button" class="back" data-marble-id="__ID__" aria-label="Back to conversations">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <div class="pane-hint" data-marble-transient>
      <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="1.4" opacity=".35"/><path d="M10 17c2.5 4 9.5 4 12 0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      <p>Pick a conversation, or ask below to start one.</p>
    </div>
    <marble-conversation data-marble-id="__ID__" data-chrome="pane"></marble-conversation>
  </section>
</div>

<div class="board" data-marble-id="__ID__">
  <section class="column" data-col="running" data-marble-id="__ID__" data-marble-transient>
    <h2 data-marble-id="__ID__">Running</h2>
  </section>
  <section class="column" data-col="review" data-marble-id="__ID__" data-marble-transient>
    <h2 data-marble-id="__ID__">Needs review</h2>
  </section>
  <section class="column" data-col="completed" data-marble-id="__ID__" data-marble-transient>
    <h2 data-marble-id="__ID__">Completed</h2>
  </section>
</div>

<div class="folders" data-marble-id="__ID__">
  <aside class="folder-rail" data-marble-id="__ID__" aria-label="Folders"></aside>
</div>

<div class="focus" data-marble-id="__ID__">
  <section class="focus-workspace" data-marble-id="__ID__">
    <h2 data-marble-id="__ID__">Focus</h2>
  </section>
</div>

<script>
  // The Agents library. Rows, the open id, the filter and the search are the
  // page's — never ops — so browsing does not rewrite this file. View and the
  // open conversation are the two facts that should survive a reload, and the
  // spec puts those in localStorage rather than in the document.
  (() => {
    const VIEW_KEY = 'marble-agents:view';
    const OPEN_KEY = 'marble-agents:open';
    const DOCK_KEY = 'marble-agents:dock';
    const CLI_KEY = 'marble-agents:cli';

    const recalled = (key) => {
      try { return localStorage.getItem(key); } catch { return null; }
    };
    const remember = (key, value) => {
      try {
        if (value == null) localStorage.removeItem(key);
        else localStorage.setItem(key, value);
      } catch { /* private browsing — the page still works; it just forgets */ }
    };

    const VIEW_ORDER = ['library', 'board', 'folders', 'focus'];

    const restoreView = () => {
      const savedView = recalled(VIEW_KEY);
      if (VIEW_ORDER.includes(savedView)) document.body.setAttribute('data-view', savedView);
      deriveView();
    };

    const $ = (sel) => document.querySelector(sel);
    const list = $('#list');
    const libraryEl = $('.library');
    const boardEl = $('.board');
    const foldersEl = $('.folders');
    const folderRail = $('.folder-rail');
    const focusEl = $('.focus');
    const convo = $('marble-conversation');
    const pane = $('.pane');
    const search = $('input.search');
    const viewButtons = [...document.querySelectorAll('.views [data-view]')];
    const filterButtons = [...document.querySelectorAll('button.filter')];
    const cliEl = $('.cli');
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const narrowView = matchMedia('(max-width: 719px)');
    const FLIP_MS = 420;
    const FLIP_EASE = 'ease-out';
    const STAGGER_MS = 18;
    // The one curve the whole page eases on. Web Animations defaults to
    // linear when `easing` is omitted, which is what the view switch used to
    // ship — name it here so no call site can forget it again.
    const VIEW_MS = 200;
    const VIEW_EASE = 'cubic-bezier(0.22, 0.61, 0.36, 1)';

    const summaries = new Map();
    const nodes = new Map();
    const labels = new Map();
    const targets = new Map();
    let agent = null;
    let filter = 'all';
    let cli = recalled(CLI_KEY) || 'all';
    let query = '';
    let openId = null;
    let panelOpen = false;
    let flipAnims = [];
    let fadeGen = 0;
    let dock = { tree: null, extras: [], focus: 'primary' };
    let suppressConvClick = false;

    const statusOf = (summary) => {
      // Waiting on the person is the one thing Running must not hide.
      if (summary?.asking) return 'review';
      if (summary?.running || summary?.status === 'running' || summary?.queued) return 'running';
      if (summary?.needsReview) return 'review';
      return 'completed';
    };
    const stateOf = (summary) => window.marbleAgentUI?.stateOf?.(summary) ?? 'idle';

    const age = (t) => {
      if (!t) return '';
      const s = Math.max(0, (Date.now() - t) / 1000);
      // Under a minute rounded to '0m', which read as a broken clock on every
      // freshly touched row.
      if (s < 45) return 'now';
      if (s < 3600) return Math.max(1, Math.round(s / 60)) + 'm';
      if (s < 86400) return Math.round(s / 3600) + 'h';
      return Math.round(s / 86400) + 'd';
    };

    /** True when every loaded conversation runs the same agent, so naming it on
     *  each row would repeat one word down the whole list. */
    const soloProvider = () => {
      const seen = new Set();
      for (const summary of summaries.values()) {
        if (summary.provider) seen.add(summary.provider);
        if (seen.size > 1) return false;
      }
      return true;
    };

    /** The last two path segments, extension dropped. A full drive path is too
     *  long for a card, and its head repeats the folder the card already sits
     *  in; the tail is the part that tells two rows apart. */
    const tailOfTarget = (path) => {
      if (!path) return '';
      const parts = String(path).split('/').filter(Boolean);
      const tail = parts.slice(-2);
      if (!tail.length) return '';
      tail[tail.length - 1] = tail[tail.length - 1].replace(/\.(mrbl|md|js|json|txt|html|css)$/i, '');
      return tail.join('/');
    };

    const deriveView = () => {
      const view = document.body.getAttribute('data-view') || 'library';
      for (const btn of viewButtons) btn.setAttribute('aria-pressed', String(btn.dataset.view === view));
    };

    const deriveFilters = () => {
      for (const btn of filterButtons) btn.setAttribute('aria-pressed', String(btn.dataset.filter === filter));
    };

    const deriveCli = () => {
      if (!cliEl) return;
      for (const btn of cliEl.querySelectorAll('[data-cli]')) {
        btn.setAttribute('aria-pressed', String(btn.dataset.cli === cli));
      }
    };

    const fillCli = () => {
      if (!cliEl) return;
      const order = ['claude-subscription', 'cursor', 'claude-api'];
      const ready = [...labels.values()]
        .filter((provider) => provider.installed && provider.signedIn)
        .sort((a, b) => {
          const rank = (id) => {
            const index = order.indexOf(id);
            return index < 0 ? order.length + 1 : index;
          };
          return rank(a.id) - rank(b.id) || String(a.id).localeCompare(String(b.id));
        });
      if (cli !== 'all' && !ready.some((provider) => provider.id === cli)) cli = 'all';
      cliEl.replaceChildren();
      const add = (id, label) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.dataset.cli = id;
        btn.setAttribute('aria-pressed', String(cli === id));
        btn.textContent = label;
        cliEl.append(btn);
      };
      add('all', 'All');
      for (const provider of ready) add(provider.id, provider.label);
    };

    const setCli = (next) => {
      cli = next || 'all';
      remember(CLI_KEY, cli === 'all' ? null : cli);
      deriveCli();
      applyFilters();
    };

    const matches = (summary) => {
      if (!summary) return false;
      const status = statusOf(summary);
      if (filter === 'archived') {
        if (!summary.archived) return false;
      } else {
        if (summary.archived) return false;
        if (filter === 'running' && status !== 'running') return false;
        if (filter === 'review' && status !== 'review') return false;
      }
      if (query) {
        const tags = (window.marbleAgentUI?.conversationTags?.(summary, labels) ?? []).map((tag) => tag.label);
        const hay = [summary.title, summary.activity, summary.target, summary.model, summary.effort, summary.provider, ...tags].filter(Boolean).join(' ').toLowerCase();
        if (!hay.includes(query)) return false;
      }
      if (cli !== 'all' && summary.provider !== cli) return false;
      return true;
    };

    const applyFilters = () => {
      for (const [id, el] of nodes) el.hidden = !matches(summaries.get(id));
      paintFolderRail();
      paintFocus();
      paintColumnCounts();
    };

    /** The folder catalog arrives after the first listing has already painted
     *  every row, so anything a row draws from it — its colour — has to be
     *  asked for again once the catalog lands. */
    const repaintRows = () => {
      for (const [id, el] of nodes) {
        const summary = summaries.get(id);
        if (summary) paintRow(el, summary);
      }
    };

    const paintOpen = () => {
      for (const el of nodes.values()) el.classList.toggle('marble-open', el.dataset.id === openId);
      for (const tab of folderRail?.querySelectorAll('.folder-tab') ?? []) {
        tab.classList.toggle('marble-open', tab.dataset.id === openId);
      }
    };

    const FULL_CAP = window.marbleAgentFolders?.FULL_CAP ?? 4;
    let folderCatalog = [];
    let activeFolderId = null;
    // Pending header open, held for one double-click interval so a rename can
    // cancel it before the rail repaints.
    let openTimer = 0;
    let selectedIds = [];
    let selectAnchor = null;
    let workingSetIds = [];
    let folderSaveEl = null;
    let lastFolderGesture = null;
    let suppressFolderClick = false;
    let focusSelectedIds = [];
    let focusPrimaryId = null;
    let focusHoveredId = null;
    let focusLookId = null;
    let focusSuppressClick = false;
    let focusDecayTimer = null;
    let focusLayoutQueued = false;

    const railConversations = (folderId) => [...summaries.values()]
      .filter((summary) => (folderId ? summary.folderId === folderId : !summary.folderId))
      .filter(matches)
      .sort((a, b) => (b.updatedAt ?? 0) - (a.updatedAt ?? 0));

    const restoreFolderDock = async (folder) => {
      const ids = [...(folder.openIds ?? [])].filter((id) => summaries.has(id)).slice(0, FULL_CAP);
      const members = railConversations(folder.id).map((summary) => summary.id);
      const resolved = ids.length ? ids : members.slice(0, FULL_CAP);
      dock.extras = [];
      dock.tree = null;
      dock.focus = 'primary';
      if (resolved.length > 1) dock.extras = resolved.slice(1).map((id) => ({ id }));
      applyDock();
      if (resolved[0]) await open(resolved[0]);
      else await open(null);
    };

    const railTabIds = () => [...(folderRail?.querySelectorAll('.folder-tab[data-id]') ?? [])].map((tab) => tab.dataset.id);

    const paintTabSelection = () => {
      for (const tab of folderRail?.querySelectorAll('.folder-tab') ?? []) {
        tab.classList.toggle('marble-selected', selectedIds.includes(tab.dataset.id));
      }
    };

    const hideFolderSave = () => {
      folderSaveEl?.remove();
      folderSaveEl = null;
    };

    const suggestFolderName = (ids) => {
      const paths = ids.map((id) => targets.get(id) || summaries.get(id)?.target || '').filter(Boolean);
      return window.marbleAgentFolders?.suggestName?.(paths) ?? 'Group';
    };

    const tileWorkingSet = async (ids) => {
      const capped = ids.slice(0, FULL_CAP);
      workingSetIds = capped;
      if (agent) {
        try { await agent.saveWorkingSet(capped); } catch { /* stale ids */ }
      }
      activeFolderId = null;
      dock.extras = capped.slice(1).map((id) => ({ id }));
      dock.tree = null;
      dock.focus = 'primary';
      rememberDock();
      applyDock();
      if (capped[0]) await open(capped[0]);
      paintFolderRail();
    };

    const showFolderSave = (ids) => {
      hideFolderSave();
      if (!folderRail || ids.length < 2) return;
      const suggested = suggestFolderName(ids);
      const pop = document.createElement('div');
      pop.className = 'folder-save';
      pop.setAttribute('data-marble-transient', '');
      const input = document.createElement('input');
      input.type = 'text';
      input.placeholder = suggested;
      input.setAttribute('data-marble-transient', '');
      const confirm = document.createElement('button');
      confirm.type = 'button';
      confirm.className = 'folder-save-confirm';
      confirm.setAttribute('data-marble-transient', '');
      confirm.textContent = 'Save as folder';
      const dismiss = document.createElement('button');
      dismiss.type = 'button';
      dismiss.className = 'folder-save-dismiss';
      dismiss.setAttribute('data-marble-transient', '');
      dismiss.textContent = 'Not now';
      confirm.addEventListener('click', async () => {
        const name = input.value.trim() || suggested;
        try {
          const folder = await agent.createFolder({ conversationIds: [...ids], name });
          lastFolderGesture = {
            inverse: async () => {
              try { await agent.deleteFolder(folder.id); } catch { /* already gone */ }
            },
          };
          selectedIds = [];
          selectAnchor = null;
          hideFolderSave();
        } catch { /* create failed */ }
      });
      dismiss.addEventListener('click', () => hideFolderSave());
      pop.append(input, confirm, dismiss);
      folderRail.append(pop);
      folderSaveEl = pop;
    };

    const handleTabSelect = async (id, event) => {
      const order = railTabIds();
      if (event.shiftKey && selectAnchor && order.includes(selectAnchor)) {
        const a = order.indexOf(selectAnchor);
        const b = order.indexOf(id);
        if (a >= 0 && b >= 0) {
          const [lo, hi] = a < b ? [a, b] : [b, a];
          selectedIds = order.slice(lo, hi + 1);
        } else {
          selectedIds = [id];
        }
      } else if (event.metaKey || event.ctrlKey) {
        selectedIds = selectedIds.includes(id)
          ? selectedIds.filter((row) => row !== id)
          : [...selectedIds, id];
        selectAnchor = id;
      } else {
        selectedIds = [id];
        selectAnchor = id;
      }
      paintTabSelection();
      if (selectedIds.length >= 2) {
        await tileWorkingSet(selectedIds);
        showFolderSave(selectedIds);
      } else {
        hideFolderSave();
      }
    };

    const clearFolderDrop = () => {
      for (const el of folderRail?.querySelectorAll('.marble-drop-target') ?? []) {
        el.classList.remove('marble-drop-target');
      }
    };

    /** Over a tab or a header the rail answers; over the pane the pane makes
     *  room, exactly as it does for a row dragged from the list. */
    const paintFolderDrop = (clientX, clientY, skipId) => {
      clearFolderDrop();
      const hit = clientX == null ? null : hitFolderDrop(clientX, clientY, skipId);
      if (hit?.kind === 'pane') return paintDrop(clientX, clientY, skipId, { rail: true });
      paintDrop(null);
      if (hit?.el) hit.el.classList.add('marble-drop-target');
      return null;
    };

    const hitFolderDrop = (clientX, clientY, skipId) => {
      const el = document.elementFromPoint(clientX, clientY);
      const tab = el?.closest?.('.folder-tab[data-id]');
      if (tab?.dataset.id && tab.dataset.id !== skipId) {
        const group = tab.closest('.folder-group');
        const inUngrouped = Boolean(tab.closest('.folder-ungrouped'));
        return {
          kind: 'tab',
          el: tab,
          targetId: tab.dataset.id,
          folderId: group && !inUngrouped ? group.dataset.folderId : null,
        };
      }
      const header = el?.closest?.('.folder-header');
      if (header) {
        const group = header.closest('.folder-group');
        if (group?.dataset.folderId) {
          return { kind: 'header', el: header, folderId: group.dataset.folderId };
        }
      }
      if (pane) {
        const r = pane.getBoundingClientRect();
        if (clientX >= r.left && clientX <= r.right && clientY >= r.top && clientY <= r.bottom) {
          return { kind: 'pane', el: pane };
        }
      }
      return null;
    };

    const applyFolderDrop = async (dragId, hit, drop = null) => {
      if (!agent || !hit) return;
      const dragSummary = summaries.get(dragId);
      const dragFolderId = dragSummary?.folderId ?? null;
      if (hit.kind === 'tab') {
        const targetId = hit.targetId;
        if (targetId === dragId) return;
        if (hit.folderId) {
          const prev = dragFolderId;
          try {
            await agent.update(dragId, { folderId: hit.folderId });
            lastFolderGesture = {
              inverse: async () => { try { await agent.update(dragId, { folderId: prev }); } catch { /* stale */ } },
            };
          } catch { /* move failed */ }
          return;
        }
        if (dragFolderId) {
          try {
            await agent.update(dragId, { folderId: null });
            lastFolderGesture = {
              inverse: async () => { try { await agent.update(dragId, { folderId: dragFolderId }); } catch { /* stale */ } },
            };
          } catch { /* ungroup failed */ }
          return;
        }
        try {
          const folder = await agent.createFolder({ conversationIds: [dragId, targetId] });
          lastFolderGesture = {
            inverse: async () => { try { await agent.deleteFolder(folder.id); } catch { /* already gone */ } },
          };
        } catch { /* create failed */ }
        return;
      }
      if (hit.kind === 'header' && hit.folderId) {
        const prev = dragFolderId;
        try {
          await agent.update(dragId, { folderId: hit.folderId });
          lastFolderGesture = {
            inverse: async () => { try { await agent.update(dragId, { folderId: prev }); } catch { /* stale */ } },
          };
        } catch { /* move failed */ }
        return;
      }
      if (hit.kind === 'pane') {
        // The pane already showed where this lands, so put it there first and
        // let the folder bookkeeping catch up behind it.
        dropOnto(dragId, drop);
        if (activeFolderId) {
          const prev = dragFolderId;
          try {
            await agent.update(dragId, { folderId: activeFolderId });
            lastFolderGesture = {
              inverse: async () => { try { await agent.update(dragId, { folderId: prev }); } catch { /* stale */ } },
            };
            const folder = folderCatalog.find((row) => row.id === activeFolderId);
            if (folder) {
              let openIds = [...(folder.openIds ?? [])];
              if (!openIds.includes(dragId)) {
                openIds.push(dragId);
                if (openIds.length > FULL_CAP) openIds = openIds.slice(-FULL_CAP);
                try { await agent.updateFolder(activeFolderId, { openIds }); } catch { /* stale folder */ }
              }
            }
          } catch { /* join failed */ }
          return;
        }
        if (workingSetIds.length) {
          workingSetIds = paneIds();
          try { await agent.saveWorkingSet(workingSetIds); } catch { /* save failed */ }
        }
      }
    };

    const bindFolderTabDrag = (tab, dragId) => {
      tab.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        const tabRect = tab.getBoundingClientRect();
        let grabX = event.clientX - tabRect.left;
        let grabY = event.clientY - tabRect.top;
        const origin = { x: event.clientX, y: event.clientY, started: false };
        let done = false;
        let card = null;
        tab.setPointerCapture?.(event.pointerId);
        const move = (e) => {
          if (done) return;
          if (!origin.started && Math.hypot(e.clientX - origin.x, e.clientY - origin.y) < 10) return;
          origin.started = true;
          if (!card) {
            card = makeCard(dragId, grabX, grabY);
            tab.classList.add('marble-lifted');
            document.body.classList.add('marble-dragging-chat');
          }
          placeCard(card, e.clientX, e.clientY, grabX, grabY);
          const res = paintFolderDrop(e.clientX, e.clientY, dragId);
          card.classList.toggle('marble-docking', Boolean(res?.plan && res.plan.mode !== 'fill'));
        };
        const up = async (e) => {
          if (done) return;
          done = true;
          document.removeEventListener('pointermove', move);
          document.removeEventListener('mousemove', move);
          document.removeEventListener('pointerup', up);
          document.removeEventListener('mouseup', up);
          document.removeEventListener('pointercancel', up);
          try { tab.releasePointerCapture?.(e.pointerId); } catch { /* already released */ }
          tab.classList.remove('marble-lifted');
          document.body.classList.remove('marble-dragging-chat');
          const hit = origin.started ? hitFolderDrop(e.clientX, e.clientY, dragId) : null;
          const drop = hit?.kind === 'pane' ? resolveDrop(e.clientX, e.clientY, dragId, { rail: true }) : null;
          card?.remove();
          clearFolderDrop();
          endDrop(drop?.plan?.mode === 'split');
          if (!origin.started) return;
          suppressFolderClick = true;
          setTimeout(() => { suppressFolderClick = false; }, 0);
          await applyFolderDrop(dragId, hit, drop);
        };
        document.addEventListener('pointermove', move);
        document.addEventListener('mousemove', move);
        document.addEventListener('pointerup', up);
        document.addEventListener('mouseup', up);
        document.addEventListener('pointercancel', up);
      });
    };

    const makeFolderTab = (summary, folderId) => {
      const tab = document.createElement('button');
      tab.type = 'button';
      tab.className = 'folder-tab';
      tab.dataset.id = summary.id;
      tab.setAttribute('data-marble-transient', '');
      // A tab used to be a bare title, which made the rail unscannable: no way
      // to tell a finished chat from a running one, or two chats on the same
      // project apart, without opening them.
      tab.dataset.status = statusOf(summary);
      tab.dataset.state = stateOf(summary);
      if (summary.lastOutcome) tab.dataset.outcome = summary.lastOutcome;
      const top = document.createElement('span');
      top.className = 'tab-top';
      const dot = document.createElement('span');
      dot.className = 'tab-dot dot';
      dot.setAttribute('aria-hidden', 'true');
      const title = document.createElement('span');
      title.className = 'tab-title';
      title.textContent = summary.title || 'Untitled';
      const when = document.createElement('span');
      when.className = 'tab-age';
      when.textContent = age(summary.updatedAt);
      top.append(dot, title, when);
      const where = document.createElement('span');
      where.className = 'tab-target';
      where.textContent = tailOfTarget(targets.get(summary.id) || summary.target || '');
      tab.append(top, where);
      tab.classList.toggle('marble-open', summary.id === openId);
      tab.classList.toggle('marble-selected', selectedIds.includes(summary.id));
      tab.addEventListener('click', async (event) => {
        if (suppressFolderClick) return;
        if (event.altKey) {
          event.preventDefault();
          await openBeside(summary.id);
          return;
        }
        if (event.shiftKey || event.metaKey || event.ctrlKey) {
          event.preventDefault();
          await handleTabSelect(summary.id, event);
          return;
        }
        selectAnchor = summary.id;
        selectedIds = [summary.id];
        paintTabSelection();
        hideFolderSave();
        if (folderId) {
          activeFolderId = folderId;
          await open(summary.id);
          const folder = folderCatalog.find((row) => row.id === folderId);
          if (folder && agent) {
            let openIds = [...(folder.openIds ?? [])];
            if (!openIds.includes(summary.id)) {
              openIds.push(summary.id);
              if (openIds.length > FULL_CAP) openIds = openIds.slice(-FULL_CAP);
              try { await agent.updateFolder(folderId, { openIds }); } catch { /* stale folder */ }
            }
          }
          paintFolderRail();
        } else {
          activeFolderId = null;
          dock.extras = [];
          dock.tree = null;
          dock.focus = 'primary';
          rememberDock();
          applyDock();
          await open(summary.id);
          paintFolderRail();
        }
      });
      bindFolderTabDrag(tab, summary.id);
      return tab;
    };

    const FOLDER_COLOR_KEYS = window.marbleAgentFolders?.COLOR_KEYS ?? [
      'research', 'fun', 'days', 'marble', 'travel', 'clay', 'sage', 'mist', 'ink', 'gold',
    ];

    const closeFolderPalettes = () => {
      for (const el of document.querySelectorAll('.folder-palette, .focus-folder-menu')) el.remove();
    };

    const watchPaletteDismiss = () => {
      const dismiss = (event) => {
        if (event.target.closest?.('.folder-palette, .folder-tick, .focus-folder-menu, .focus-folder')) return;
        closeFolderPalettes();
        document.removeEventListener('pointerdown', dismiss, true);
      };
      document.addEventListener('pointerdown', dismiss, true);
    };

    const editFolderName = (name, folder) => {
      if (!agent || !folder || name.isContentEditable) return;
      const prev = folder.name || 'Group';
      closeFolderPalettes();
      name.setAttribute('contenteditable', 'true');
      name.setAttribute('role', 'textbox');
      name.focus();
      const range = document.createRange();
      range.selectNodeContents(name);
      window.getSelection()?.removeAllRanges();
      window.getSelection()?.addRange(range);
      let closed = false;
      const finish = async (commit) => {
        if (closed) return;
        closed = true;
        name.removeEventListener('blur', onBlur);
        name.removeEventListener('keydown', onKey);
        const next = (name.textContent || '').trim().slice(0, 40);
        name.removeAttribute('contenteditable');
        name.removeAttribute('role');
        if (!commit || !next || next === prev) {
          name.textContent = prev;
          return;
        }
        name.textContent = next;
        const row = folderCatalog.find((item) => item.id === folder.id);
        if (row) row.name = next;
        folder.name = next;
        try { await agent.updateFolder(folder.id, { name: next }); } catch {
          name.textContent = prev;
          folder.name = prev;
          if (row) row.name = prev;
        }
      };
      const onBlur = () => { finish(true); };
      const onKey = (event) => {
        if (event.key === 'Enter') {
          event.preventDefault();
          event.stopPropagation();
          finish(true);
          name.blur();
        }
        if (event.key === 'Escape') {
          event.preventDefault();
          event.stopPropagation();
          finish(false);
          name.blur();
        }
      };
      name.addEventListener('keydown', onKey);
      name.addEventListener('blur', onBlur);
    };

    const openFolderPalette = (group, folder) => {
      closeFolderPalettes();
      if (!agent || !folder) return;
      const pal = document.createElement('div');
      pal.className = 'folder-palette';
      pal.setAttribute('role', 'listbox');
      pal.setAttribute('aria-label', 'Folder color');
      pal.setAttribute('data-marble-transient', '');
      for (const key of FOLDER_COLOR_KEYS) {
        const swatch = document.createElement('button');
        swatch.type = 'button';
        swatch.dataset.color = key;
        swatch.setAttribute('aria-label', key);
        swatch.setAttribute('aria-pressed', key === folder.color ? 'true' : 'false');
        swatch.setAttribute('data-marble-transient', '');
        swatch.addEventListener('click', async (event) => {
          event.stopPropagation();
          closeFolderPalettes();
          const row = folderCatalog.find((item) => item.id === folder.id);
          const prev = folder.color;
          folder.color = key;
          if (row) row.color = key;
          group.dataset.color = key;
          try { await agent.updateFolder(folder.id, { color: key }); } catch {
            folder.color = prev;
            if (row) row.color = prev;
            group.dataset.color = prev || 'research';
          }
        });
        pal.append(swatch);
      }
      group.append(pal);
      watchPaletteDismiss();
    };

    const paintFolderRail = () => {
      if (!folderRail) return;
      // A repaint replaces every node in the rail. Doing that while a folder
      // name is open for editing destroys the field mid-keystroke and loses
      // what was typed, so a live rename holds the rail still; the blur that
      // commits it repaints.
      if (folderRail.querySelector('.folder-name[contenteditable]')) return;
      const save = folderSaveEl;
      folderRail.replaceChildren();
      const sorted = [...folderCatalog].sort((a, b) => (a.order ?? 0) - (b.order ?? 0));
      for (const folder of sorted) {
        const group = document.createElement('section');
        group.className = 'folder-group';
        group.dataset.color = folder.color || 'research';
        group.dataset.folderId = folder.id;
        group.setAttribute('data-marble-transient', '');
        group.classList.toggle('marble-active', folder.id === activeFolderId);

        const header = document.createElement('div');
        header.className = 'folder-header';
        header.setAttribute('role', 'group');
        header.setAttribute('aria-label', folder.name || 'Group');
        header.tabIndex = 0;
        header.setAttribute('data-marble-transient', '');
        const tick = document.createElement('button');
        tick.type = 'button';
        tick.className = 'folder-tick';
        tick.setAttribute('aria-label', `Color ${folder.color || 'research'}`);
        tick.setAttribute('data-marble-transient', '');
        const name = document.createElement('span');
        name.className = 'folder-name';
        name.setAttribute('data-marble-transient', '');
        name.textContent = folder.name || 'Group';
        const count = document.createElement('span');
        count.className = 'folder-count';
        count.setAttribute('data-marble-transient', '');
        const tabs = railConversations(folder.id);
        count.textContent = tabs.length ? String(tabs.length) : '';
        header.append(tick, name, count);
        const activate = async () => {
          activeFolderId = folder.id;
          // Mark it before awaiting the dock, not after: opening a folder loads
          // up to four conversations, and the rail should answer the click on
          // the frame it happened rather than when the last pane arrives.
          for (const row of folderRail.querySelectorAll('.folder-group')) {
            row.classList.toggle('marble-active', row.dataset.folderId === folder.id);
          }
          await restoreFolderDock(folder);
        };
        // Click opens, double-click renames — so the first click of a rename
        // must not open, because opening repaints the rail and would pull the
        // editable node out from under the second click. Hold the open for one
        // double-click interval; the rename cancels it.
        header.addEventListener('click', (event) => {
          if (event.target.closest('.folder-tick, .folder-palette, .folder-name[contenteditable], .folder-name[contenteditable="plaintext-only"]')) return;
          if (event.detail > 1) return;
          clearTimeout(openTimer);
          openTimer = setTimeout(() => { activate(); }, 220);
        });
        header.addEventListener('dblclick', (event) => {
          if (event.target.closest('.folder-tick, .folder-palette')) return;
          clearTimeout(openTimer);
          event.preventDefault();
        });
        header.addEventListener('keydown', async (event) => {
          if (event.target.closest('.folder-name[contenteditable], .folder-name[contenteditable="plaintext-only"]')) return;
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            await activate();
            return;
          }
          // Renaming lost its click target, so it needs a key. F2 is what a
          // file rail is expected to answer to.
          if (event.key === 'F2') {
            event.preventDefault();
            editFolderName(name, folder);
          }
        });
        tick.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          openFolderPalette(group, folder);
        });
        // The name used to take the header's click and open an editor. It is
        // `flex: 1`, so that swallowed almost the whole target: opening a
        // folder — the reason this view exists — survived only in the few
        // pixels beside the count. Rename is the rarer act, so it moves to
        // double-click, which is what the Focus basin name already used.
        name.addEventListener('dblclick', (event) => {
          event.preventDefault();
          event.stopPropagation();
          editFolderName(name, folder);
        });

        const tabList = document.createElement('div');
        tabList.className = 'folder-tabs';
        tabList.setAttribute('data-marble-transient', '');
        for (const summary of tabs) tabList.append(makeFolderTab(summary, folder.id));

        group.append(header, tabList);
        folderRail.append(group);
      }

      const ungrouped = document.createElement('section');
      ungrouped.className = 'folder-ungrouped';
      ungrouped.setAttribute('data-marble-transient', '');
      const label = document.createElement('div');
      label.className = 'folder-ungrouped-label';
      label.setAttribute('data-marble-transient', '');
      label.textContent = 'ungrouped';
      const ungroupedTabs = document.createElement('div');
      ungroupedTabs.className = 'folder-tabs';
      ungroupedTabs.setAttribute('data-marble-transient', '');
      for (const summary of railConversations(null)) ungroupedTabs.append(makeFolderTab(summary, null));
      ungrouped.append(label, ungroupedTabs);
      folderRail.append(ungrouped);

      const newChat = document.createElement('button');
      newChat.type = 'button';
      newChat.className = 'folder-new-chat';
      newChat.setAttribute('data-marble-transient', '');
      newChat.textContent = '+ New chat';
      newChat.addEventListener('click', () => startNew());
      folderRail.append(newChat);
      if (save) folderRail.append(save);
      paintTabSelection();
    };

    const FOCUS_RESPONSE = 0.4;
    const FOCUS_DAMPING = 1;
    const focusSprings = new WeakMap();
    let lastFocusLods = '';
    // The LOD each card was last painted at, so the layout pass can ask a card
    // its size class without recomputing the cooling.
    let lastLods = {};

    const matchingFocusItems = () => [...summaries.values()]
      .filter(matches)
      .sort((a, b) => (b.updatedAt ?? 0) - (a.updatedAt ?? 0));

    // The stage is a column like any other, so what orders it is rank — a
    // pane dragged left stays left. Recency only breaks a tie between panes
    // nobody has ever arranged.
    const focusFullIds = () => focusColumnsOf(matchingFocusItems(), null).stage;

    // How wide the left edge reads as "pin this" when there is no stage.
    const FOCUS_RAIL = 48;

    const folderColorOf = (folderId) => folderCatalog.find((row) => row.id === folderId)?.color || '';

    const clearFocusPane = () => {
      if (!pane) return;
      for (const prop of ['position', 'left', 'top', 'width', 'height', 'z-index', 'border-radius', 'overflow', 'display', 'pointer-events', 'visibility']) {
        pane.style.removeProperty(prop);
      }
    };

    /** Focus with nothing pinned has nowhere to put the live pane. Clearing its
     *  inline position is not enough: the stylesheet still shows the library
     *  shell in this view, so the composer and its provider pills used to lie
     *  across the top of the canvas. Take it out of flow outright. */
    const hideFocusPane = () => {
      if (!pane) return;
      clearFocusPane();
      pane.style.display = 'none';
    };

    const leaveFocusView = () => {
      endFocusDrag();
      clearFocusPane();
      for (const live of focusEl?.querySelectorAll('.focus-live') ?? []) live.replaceChildren();
      document.querySelector('.focus-look')?.remove();
      closeFolderPalettes();
      focusLookId = null;
      stopFocusDecay();
      applyDock();
    };

    const stopFocusDecay = () => {
      if (focusDecayTimer) {
        clearInterval(focusDecayTimer);
        focusDecayTimer = null;
      }
    };

    const startFocusDecay = () => {
      stopFocusDecay();
      focusDecayTimer = setInterval(() => {
        if (document.hidden) return;
        if (focusDrag) return;
        if ((document.body.getAttribute('data-view') || 'library') !== 'focus') return;
        paintFocus({ quiet: true });
      }, 1000);
    };

    const focusCanvasBox = () => {
      const r = focusEl.getBoundingClientRect();
      return { w: Math.max(1, focusEl.clientWidth), h: Math.max(1, focusEl.clientHeight), left: r.left, top: r.top };
    };

    /** A client point in canvas coordinates — the space the packer works in,
     *  which scrolls under the viewport once the columns outrun it. */
    const focusPoint = (clientX, clientY) => {
      const box = focusEl.getBoundingClientRect();
      return {
        x: clientX - box.left + focusEl.scrollLeft,
        y: clientY - box.top + focusEl.scrollTop,
      };
    };

    // Digest is sized to the four lines it actually shows, a chip to its one.
    // Only the heights are the card's: a field card takes its width from the
    // column it sits in, so a chip is a short row and not a ragged edge.
    const focusLodSize = (lod) => (lod === 'digest' ? { w: 260, h: 148 } : { w: 168, h: 56 });

    /** The layout that is currently on screen. A drop reads its slots from
     *  here rather than re-measuring the DOM, so a card lands exactly where
     *  the insertion bar said it would even while the springs are still
     *  running. */
    let focusPack = null;
    let focusDrag = null;

    /** The last resort when the layout helper is not on the page: one column
     *  per group, no slots, no stage. Never reached in a healthy load. */
    const flowFieldColumns = (fulls, groups, canvas) => {
      const gap = 8;
      const rects = {};
      const regions = [];
      let x = 16;
      const h = Math.max(120, canvas.h - 32);
      for (const group of groups) {
        const region = {
          folderId: group.folderId,
          x,
          y: 16,
          w: 296,
          h,
          inner: { x: x + 18, y: 54, w: 260, h: h - 38 },
          cards: [],
        };
        let y = 54;
        for (const card of group.cards) {
          const size = focusLodSize(card.lod === 'chip' ? 'chip' : 'digest');
          const rect = { id: card.id, x: x + 18, y, w: 260, h: size.h };
          region.cards.push(rect);
          rects[card.id] = { x: rect.x, y: rect.y, w: rect.w, h: rect.h };
          y += size.h + gap;
        }
        regions.push(region);
        x += region.w + gap;
      }
      return {
        stage: { x: 16, y: 16, w: 0, h, cols: [] },
        regions,
        newGroup: null,
        rects,
        colW: 260,
        width: Math.max(canvas.w, x + 16),
        height: Math.max(canvas.h, h + 32),
      };
    };

    const rubberFocus = (value, min, max, dimension) => {
      const fn = window.marbleAgentFolders?.rubberband;
      if (value < min) return min + (fn ? fn(value - min, dimension) : (value - min) * 0.35);
      if (value > max) return max + (fn ? fn(value - max, dimension) : (value - max) * 0.35);
      return value;
    };

    const liveFocusBox = (card) => {
      const canvasR = focusEl.getBoundingClientRect();
      const box = card.getBoundingClientRect();
      return {
        x: box.left - canvasR.left + focusEl.scrollLeft,
        y: box.top - canvasR.top + focusEl.scrollTop,
        w: box.width,
        h: box.height,
      };
    };

    const stopCardSpring = (card) => {
      const run = focusSprings.get(card);
      if (run?.frame) cancelAnimationFrame(run.frame);
      focusSprings.delete(card);
      for (const anim of card.getAnimations()) anim.cancel();
    };

    const flattenCardMotion = (card) => {
      const live = liveFocusBox(card);
      stopCardSpring(card);
      card.style.transform = '';
      card.style.left = `${live.x}px`;
      card.style.top = `${live.y}px`;
      card.style.width = `${live.w}px`;
      card.style.height = `${live.h}px`;
      return live;
    };

    const springCardTo = (card, to, velocity = { x: 0, y: 0 }) => {
      if (reduceMotion.matches) {
        stopCardSpring(card);
        card.style.left = `${to.x}px`;
        card.style.top = `${to.y}px`;
        card.style.width = `${to.w}px`;
        card.style.height = `${to.h}px`;
        card.animate([{ opacity: 0.55 }, { opacity: 1 }], { duration: 150, easing: 'ease-out' });
        return;
      }
      const from = flattenCardMotion(card);
      card.style.left = `${to.x}px`;
      card.style.top = `${to.y}px`;
      card.style.width = `${to.w}px`;
      card.style.height = `${to.h}px`;
      let x = from.x;
      let y = from.y;
      let vx = velocity.x;
      let vy = velocity.y;
      const om = (2 * Math.PI) / FOCUS_RESPONSE;
      let last = performance.now();
      const run = { frame: 0 };
      const step = (now) => {
        const dt = Math.min(0.032, (now - last) / 1000);
        last = now;
        const ax = -om * om * (x - to.x) - 2 * FOCUS_DAMPING * om * vx;
        const ay = -om * om * (y - to.y) - 2 * FOCUS_DAMPING * om * vy;
        vx += ax * dt;
        vy += ay * dt;
        x += vx * dt;
        y += vy * dt;
        card.style.transform = `translate(${x - to.x}px, ${y - to.y}px)`;
        const settled = Math.hypot(x - to.x, y - to.y) < 0.5 && Math.hypot(vx, vy) < 12;
        if (settled) {
          card.style.transform = '';
          focusSprings.delete(card);
          layoutFocusPane(focusFullIds());
          return;
        }
        run.frame = requestAnimationFrame(step);
      };
      run.frame = requestAnimationFrame(step);
      focusSprings.set(card, run);
    };

    const paintFocusCard = (card, summary, lod) => {
      card.dataset.lod = lod;
      card.dataset.selected = focusSelectedIds.includes(summary.id) ? 'true' : 'false';
      const color = folderColorOf(summary.folderId);
      if (color) card.dataset.color = color;
      else delete card.dataset.color;
      const title = card.querySelector('.focus-card-title');
      if (title) title.textContent = summary.title || 'Untitled';
      const status = statusOf(summary);
      card.dataset.status = status;
      card.dataset.state = stateOf(summary);
      if (summary.lastOutcome) card.dataset.outcome = summary.lastOutcome;
      else delete card.dataset.outcome;
      // Four addressable lines rather than one run-on string: the path says
      // where, the activity says what, the footer says how it went and when.
      const target = card.querySelector('.focus-target');
      if (target) target.textContent = tailOfTarget(targets.get(summary.id) || summary.target || '');
      const activity = card.querySelector('.focus-activity');
      if (activity) activity.textContent = summary.activity || summary.lastOutcome || '';
      const statusEl = card.querySelector('.focus-status');
      if (statusEl) statusEl.textContent = status;
      for (const ageEl of card.querySelectorAll('.age')) ageEl.textContent = age(summary.updatedAt);
      // The same pills a list row wears. A chip hides them; it never restyles them.
      const tags = card.querySelector('.focus-tags');
      if (tags) {
        tags.replaceChildren();
        for (const tag of (window.marbleAgentUI?.conversationTags?.(summary, labels) ?? [])) {
          const span = document.createElement('span');
          span.className = 'tag';
          span.dataset.kind = tag.kind;
          span.dataset.hue = String(tag.hue);
          span.textContent = tag.label;
          if (tag.title) span.title = tag.title;
          tags.append(span);
        }
      }
    };

    const layoutFocusPane = (fullIds) => {
      if (!pane || !focusEl) return;
      // A `position: fixed` pane cannot chase a spring. It stands down for the
      // length of a gesture and the Full it covers shows its digest instead.
      if (focusDrag) {
        hideFocusPane();
        return;
      }
      const stacked = focusEl.hasAttribute('data-stack') || narrowView.matches;
      const primary = (focusPrimaryId && fullIds.includes(focusPrimaryId)) ? focusPrimaryId : fullIds[0];
      if (!primary || stacked) {
        hideFocusPane();
        for (const live of focusEl.querySelectorAll('.focus-live')) live.replaceChildren();
        return;
      }
      const card = focusEl.querySelector(`.focus-card[data-id="${primary}"]`);
      const slot = card?.querySelector('.focus-live');
      if (!slot) {
        hideFocusPane();
        return;
      }
      const r = slot.getBoundingClientRect();
      pane.style.visibility = '';
      pane.style.display = 'grid';
      pane.style.position = 'fixed';
      pane.style.left = `${r.left}px`;
      pane.style.top = `${r.top}px`;
      pane.style.width = `${Math.max(0, r.width)}px`;
      pane.style.height = `${Math.max(0, r.height)}px`;
      pane.style.zIndex = '6';
      pane.style.borderRadius = '0 0 12px 12px';
      pane.style.overflow = 'hidden';
      pane.style.pointerEvents = 'auto';
      if (convo.getAttribute('conversation') !== primary) convo.setAttribute('conversation', primary);
      pane.querySelector('.dock-stage')?.replaceChildren();
      for (const id of fullIds) {
        const host = focusEl.querySelector(`.focus-card[data-id="${id}"] .focus-live`);
        if (!host) continue;
        if (id === primary || reduceMotion.matches) {
          host.replaceChildren();
          continue;
        }
        let extra = host.querySelector('marble-conversation');
        if (!extra) {
          extra = document.createElement('marble-conversation');
          extra.setAttribute('data-marble-transient', '');
          extra.setAttribute('data-chrome', 'pane');
          host.append(extra);
        }
        extra.setAttribute('conversation', id);
      }
    };

    const animateFocusCard = (card, from, to, velocity) => {
      if (!from) {
        card.style.left = `${to.x}px`;
        card.style.top = `${to.y}px`;
        card.style.width = `${to.w}px`;
        card.style.height = `${to.h}px`;
        return;
      }
      springCardTo(card, to, velocity);
    };

    const pinFocus = async (id, { keepOpen = false } = {}) => {
      if (!agent || !id) return;
      const pinned = matchingFocusItems().filter((item) => item.pinned);
      if (!keepOpen) {
        for (const item of pinned) {
          if (item.id === id) continue;
          item.pinned = false;
          try { await agent.update(item.id, { pinned: false }); } catch { /* stale */ }
        }
      } else if (!pinned.some((item) => item.id === id) && pinned.length >= FULL_CAP) {
        const oldest = [...pinned].sort((a, b) => (a.lastInteractedAt ?? 0) - (b.lastInteractedAt ?? 0))[0];
        if (oldest) {
          oldest.pinned = false;
          try { await agent.update(oldest.id, { pinned: false }); } catch { /* stale */ }
        }
      }
      const target = summaries.get(id);
      if (target) target.pinned = true;
      try { await agent.update(id, { pinned: true }); } catch { /* stale */ }
      if (!focusSelectedIds.includes(id)) focusSelectedIds = [id];
      focusPrimaryId = id;
      paintFocus();
    };

    const unpinFocus = async (id) => {
      if (!agent || !id) return;
      const item = summaries.get(id);
      if (item) item.pinned = false;
      try { await agent.update(id, { pinned: false }); } catch { /* stale */ }
      paintFocus();
    };

    const selectFocusCard = (id, event) => {
      if (event?.metaKey || event?.ctrlKey) {
        focusSelectedIds = focusSelectedIds.includes(id)
          ? focusSelectedIds.filter((row) => row !== id)
          : [...focusSelectedIds, id];
      } else if (event?.shiftKey && focusPrimaryId && focusPrimaryId !== id) {
        if (!focusSelectedIds.includes(id)) focusSelectedIds = [...focusSelectedIds, id];
      } else {
        focusSelectedIds = [id];
      }
      focusPrimaryId = id;
      paintFocus({ quiet: true });
    };

    const closeFocusLook = () => {
      document.querySelector('.focus-look')?.remove();
      focusLookId = null;
    };

    const openFocusLook = async (id) => {
      if (!id || !agent) return;
      closeFocusLook();
      let detail = null;
      try { detail = await agent.conversation(id); } catch { /* preview still shows summary */ }
      const summary = detail?.meta ?? summaries.get(id) ?? {};
      const look = document.createElement('div');
      look.className = 'focus-look';
      look.setAttribute('data-marble-transient', '');
      look.setAttribute('role', 'dialog');
      look.setAttribute('aria-label', 'Quick Look');
      const title = document.createElement('h3');
      title.textContent = summary.title || 'Untitled';
      const meta = document.createElement('p');
      meta.className = 'look-meta';
      meta.textContent = [summary.target || targets.get(id) || '', statusOf(summary), summary.activity || ''].filter(Boolean).join(' · ');
      const list = document.createElement('ul');
      list.className = 'look-events';
      const events = (detail?.events ?? []).slice(-8);
      for (const row of events) {
        const li = document.createElement('li');
        li.textContent = row.type || row.text || '';
        list.append(li);
      }
      look.append(title, meta, list);
      document.body.append(look);
      const card = focusEl?.querySelector(`.focus-card[data-id="${id}"]`);
      const box = card?.getBoundingClientRect();
      const width = Math.min(28 * 16, window.innerWidth - 32);
      let left;
      if (box) {
        left = box.right + 12;
        if (left + width > window.innerWidth - 16) left = box.left - width - 12;
        left = Math.min(Math.max(16, left), window.innerWidth - width - 16);
      } else {
        left = Math.max(16, (window.innerWidth - width) / 2);
      }
      const top = box ? Math.min(Math.max(16, box.top), window.innerHeight - 120) : window.innerHeight * 0.12;
      look.style.left = `${left}px`;
      look.style.top = `${top}px`;
      focusLookId = id;
    };

    /** A basin is the region the packer allocated, not the bounding box of
     *  wherever its members happened to land. Hulls over a free layout
     *  overlapped each other and ran off the canvas; a region cannot, because
     *  the same pass placed the cards inside it. */
    /** A basin is the column the packer allocated, full height, so it is a
     *  target you cannot miss and it cannot overlap its neighbours — the same
     *  pass placed the cards inside it. The two dashed columns beside them are
     *  the drop targets that have no cards to stand for them: where a pin goes
     *  when nothing is pinned yet, and what makes a folder. */
    const paintFocusBasins = (pack) => {
      if (!focusEl) return;
      const stacked = focusEl.hasAttribute('data-stack') || narrowView.matches;
      const regions = (!stacked && pack?.regions) || [];
      const target = focusDrag?.target ?? null;
      const keep = new Set();
      for (const region of regions) {
        const folderId = region.folderId ?? 'ungrouped';
        keep.add(folderId);
        const folder = folderCatalog.find((row) => row.id === folderId);
        let basin = focusEl.querySelector(`.focus-basin[data-folder-id="${folderId}"]`);
        if (!basin) {
          basin = document.createElement('div');
          basin.className = 'focus-basin';
          basin.dataset.folderId = folderId;
          basin.setAttribute('data-marble-transient', '');
          const name = document.createElement('button');
          name.type = 'button';
          name.className = 'focus-basin-name folder-name';
          name.setAttribute('data-marble-transient', '');
          name.addEventListener('click', () => {
            const ids = matchingFocusItems().filter((item) => item.folderId === folderId).map((item) => item.id);
            focusSelectedIds = ids;
            focusPrimaryId = ids[0] ?? focusPrimaryId;
            paintFocus({ quiet: true });
          });
          name.addEventListener('dblclick', (event) => {
            event.preventDefault();
            event.stopPropagation();
            const row = folderCatalog.find((item) => item.id === folderId);
            if (row) editFolderName(name, row);
          });
          basin.append(name);
          focusEl.insertBefore(basin, focusEl.querySelector('.focus-card'));
        }
        if (folder?.color) basin.dataset.color = folder.color;
        else delete basin.dataset.color;
        if (region.folderId) delete basin.dataset.loose;
        else basin.dataset.loose = 'true';
        if (target?.column === 'folder' && (target.folderId ?? null) === (region.folderId ?? null)) {
          basin.dataset.drop = 'into';
        } else delete basin.dataset.drop;
        const name = basin.querySelector('.focus-basin-name');
        if (name) {
          name.textContent = region.folderId ? (folder?.name || 'Group') : 'Ungrouped';
          name.disabled = !region.folderId;
        }
        basin.style.left = `${region.x}px`;
        basin.style.top = `${region.y}px`;
        basin.style.width = `${Math.max(0, region.w)}px`;
        basin.style.height = `${Math.max(0, region.h)}px`;
      }
      for (const basin of [...focusEl.querySelectorAll('.focus-basin')]) {
        if (!keep.has(basin.dataset.folderId)) basin.remove();
      }
      paintFocusNewGroup(pack?.newGroup ?? null, target);
      paintFocusPinSlot(pack, target);
      paintFocusSlot(pack, target);
    };

    /** Making a folder is otherwise undiscoverable — you would have to guess
     *  that one card dropped on another means something. It is a real button
     *  as well as a drop target, so the keyboard can reach it too. */
    const paintFocusNewGroup = (slot, target) => {
      let el = focusEl.querySelector('.focus-newgroup');
      if (!slot) {
        el?.remove();
        return;
      }
      if (!el) {
        el = document.createElement('button');
        el.type = 'button';
        el.className = 'focus-newgroup';
        el.setAttribute('data-marble-transient', '');
        el.innerHTML = '<span class="focus-newgroup-mark" aria-hidden="true">+</span><span class="focus-newgroup-label">New group</span>';
        el.addEventListener('click', async (event) => {
          event.stopPropagation();
          const ids = focusSelectedIds.length ? [...focusSelectedIds] : [];
          if (!ids.length || !agent) return;
          try {
            await agent.createFolder({ conversationIds: ids });
            const listed = await agent.folders();
            folderCatalog = listed.folders ?? folderCatalog;
          } catch { /* create failed */ }
          paintFocus();
        });
        focusEl.append(el);
      }
      el.disabled = !focusSelectedIds.length && !focusDrag;
      el.title = focusDrag ? 'Drop here to make a folder' : 'Make a folder of the selected chats';
      if (target?.column === 'new') el.dataset.drop = 'into';
      else delete el.dataset.drop;
      el.style.left = `${slot.x}px`;
      el.style.top = `${slot.y}px`;
      el.style.width = `${Math.max(0, slot.w)}px`;
      el.style.height = `${Math.max(0, slot.h)}px`;
    };

    /** The rail that stands in for an empty stage, drawn over the canvas's
     *  left edge rather than reserved inside it. Only while a card is in the
     *  air, and only while there is no real stage column to aim at. */
    const paintFocusPinSlot = (pack, target) => {
      // What the rail stands in for is an empty stage, so it asks the model
      // and not the pack — once a drag aims at it the pack has a column, and
      // the rail would blink out at the moment of contact.
      const wanted = Boolean(focusDrag)
        && !focusColumnsOf(matchingFocusItems(), null).stage.length;
      let el = document.querySelector('.focus-pinslot');
      if (!wanted) {
        el?.remove();
        return;
      }
      if (!el) {
        el = document.createElement('div');
        el.className = 'focus-pinslot';
        el.setAttribute('data-marble-transient', '');
        el.innerHTML = '<span>Pin</span>';
        document.body.append(el);
      }
      if (target?.column === 'stage') el.dataset.drop = 'into';
      else delete el.dataset.drop;
      const box = focusEl.getBoundingClientRect();
      el.style.left = `${box.left}px`;
      el.style.top = `${box.top}px`;
      el.style.width = `${FOCUS_RAIL}px`;
      el.style.height = `${box.height}px`;
    };

    /** The slot the card would land in, drawn at the rect the layout already
     *  reserved for it. An outline rather than a line: for a field drop it is
     *  the gap that just opened, for a stage drop it is the full-height column
     *  the card is about to become. */
    const paintFocusSlot = (pack, target) => {
      const lead = focusDrag?.lead;
      const rect = target && !target.merge && target.column !== 'new' && lead
        ? pack?.rects?.[lead]
        : null;
      let el = focusEl.querySelector('.focus-slot');
      if (!rect) {
        el?.remove();
        return;
      }
      if (!el) {
        el = document.createElement('div');
        el.className = 'focus-slot';
        el.setAttribute('data-marble-transient', '');
        focusEl.append(el);
      }
      el.style.left = `${rect.x}px`;
      el.style.top = `${rect.y}px`;
      el.style.width = `${Math.max(0, rect.w)}px`;
      el.style.height = `${Math.max(0, rect.h)}px`;
    };

    /** Where a release would land, read off the layout that put the cards
     *  there. Indexes come back in the column's own terms — the cards that are
     *  not in the air — because that is what a drop is filed against. */
    const focusTargetAt = (point) => {
      const pack = focusPack;
      const helpers = window.marbleAgentFolders;
      if (!pack || !helpers?.slotAt) return null;
      const dragIds = focusDrag?.ids ?? [];
      const drop = (list, index) => index - list.slice(0, index).filter((row) => dragIds.includes(row.id)).length;

      // A stage holding nothing but the cards in the air is an empty stage: a
      // pinned card reads full width, so while it is being dragged off it
      // covers the very columns it could be dropped on, and a zone test that
      // counted it would answer "stage" everywhere.
      const stageStays = pack.stage.cols.filter((row) => !dragIds.includes(row.id));

      // With nothing pinned there is no stage column to aim at, so the left
      // edge of the canvas is one. It overlays rather than reserves: a column
      // that appears the moment you lift a card would shove the whole field
      // 300px sideways, and a gesture that moves the target is not a gesture.
      if (!stageStays.length && point.x - focusEl.scrollLeft < FOCUS_RAIL) {
        return { column: 'stage', index: 0, key: 'stage:0' };
      }
      const zones = [];
      if (pack.stage.w > 0 && stageStays.length) zones.push({ kind: 'stage', x: pack.stage.x, w: pack.stage.w });
      for (const region of pack.regions) zones.push({ kind: 'folder', region, x: region.x, w: region.w });
      if (pack.newGroup) zones.push({ kind: 'new', x: pack.newGroup.x, w: pack.newGroup.w });
      if (!zones.length) return null;
      const gap = window.marbleAgentFolders?.GAP ?? 8;
      let zone = zones.find((row) => point.x >= row.x - gap && point.x <= row.x + row.w + gap);
      if (!zone) zone = point.x < zones[0].x ? zones[0] : zones[zones.length - 1];

      if (zone.kind === 'new') return { column: 'new', key: 'new' };
      if (zone.kind === 'stage') {
        const slot = helpers.stageSlotAt(pack.stage, point, gap);
        const index = drop(pack.stage.cols, slot.index);
        return { column: 'stage', index, key: `stage:${index}` };
      }

      const region = zone.region;
      const slot = helpers.slotAt(region, point, gap);
      const over = slot.over && !dragIds.includes(slot.over) ? slot.over : null;
      const loose = region.folderId === null;
      const single = dragIds.length === 1 ? summaries.get(dragIds[0]) : null;
      // Two loose cards have no folder to insert into, so squarely on top of
      // one means "make a folder of these two". Inside a folder it would mean
      // nothing, so the band is not offered there.
      if (over && loose && single && !single.folderId) {
        return { column: 'folder', folderId: null, merge: over, key: `merge:${over}` };
      }
      const index = drop(region.cards, slot.index);
      return {
        column: 'folder',
        folderId: region.folderId ?? null,
        index,
        key: `folder:${region.folderId ?? 'loose'}:${index}`,
      };
    };

    /** The ranks a drop has to file. One PATCH when the neighbours leave a
     *  midpoint to take, a renumbered column when they do not — which is the
     *  first rearrangement of a column, and nothing after it. */
    const focusRankPatches = (rest, ids, index) => {
      const helpers = window.marbleAgentFolders;
      const at = Math.max(0, Math.min(index, rest.length));
      const keys = rest.map((id) => summaries.get(id)?.focusY);
      const single = ids.length === 1 ? helpers?.rankFor?.(keys, at) : null;
      if (single !== null && single !== undefined) {
        const item = summaries.get(ids[0]);
        if (item) item.focusY = single;
        return [{ id: ids[0], focusY: single }];
      }
      const next = [...rest.slice(0, at), ...ids, ...rest.slice(at)];
      const values = helpers?.ranks?.(next.length)
        ?? next.map((_, i) => (i + 1) / (next.length + 1));
      const out = [];
      next.forEach((id, i) => {
        const item = summaries.get(id);
        if (item?.focusY === values[i]) return;
        if (item) item.focusY = values[i];
        out.push({ id, focusY: values[i] });
      });
      return out;
    };

    /** One gesture, every case: a card picked up and dropped in a slot. The
     *  page has already moved — this is the half that files it. */
    const commitFocusDrop = async (ids, target) => {
      if (!agent || !ids.length || !target) return;
      const patch = async (id, body) => {
        try { await agent.update(id, body); } catch { /* stale */ }
      };

      if (target.column === 'new' || target.merge) {
        const members = target.merge ? [...ids, target.merge] : [...ids];
        try {
          await agent.createFolder({ conversationIds: members });
          const listed = await agent.folders();
          folderCatalog = listed.folders ?? folderCatalog;
        } catch { /* create failed */ }
        return;
      }

      const layout = focusColumnsOf(matchingFocusItems(), null);

      if (target.column === 'stage') {
        const staged = layout.stage.filter((id) => !ids.includes(id));
        // The stage holds four. A fifth pin retires the rightmost, which is
        // the one the person themselves ranked least important.
        const room = Math.max(0, FULL_CAP - ids.length);
        const rest = staged.slice(0, room);
        for (const id of staged.slice(room)) {
          const item = summaries.get(id);
          if (item) item.pinned = false;
          await patch(id, { pinned: false });
        }
        for (const id of ids) {
          const item = summaries.get(id);
          if (item?.pinned) continue;
          if (item) item.pinned = true;
          await patch(id, { pinned: true });
        }
        for (const row of focusRankPatches(rest, ids, target.index ?? rest.length)) {
          await patch(row.id, { focusY: row.focusY });
        }
        focusPrimaryId = ids[0];
        return;
      }

      const folderId = target.folderId ?? null;
      const column = layout.columns.find((row) => (row.folderId ?? null) === folderId)?.ids ?? [];
      const rest = column.filter((id) => !ids.includes(id));
      for (const id of ids) {
        const item = summaries.get(id);
        const body = {};
        if (item?.pinned) {
          body.pinned = false;
          item.pinned = false;
        }
        if ((item?.folderId ?? null) !== folderId) {
          body.folderId = folderId;
          if (item) item.folderId = folderId;
        }
        if (Object.keys(body).length) await patch(id, body);
      }
      for (const row of focusRankPatches(rest, ids, target.index ?? rest.length)) {
        await patch(row.id, { focusY: row.focusY });
      }
    };

    /** The keyboard's half of rearranging. Alt with an arrow moves the card
     *  itself, through the same drop rules the pointer uses, so no state the
     *  pointer can reach is out of reach here. */
    const moveFocusCard = async (id, dir) => {
      const layout = focusColumnsOf(matchingFocusItems(), null);
      const zones = [
        { column: 'stage', folderId: null, ids: layout.stage },
        ...layout.columns.map((row) => ({ column: 'folder', folderId: row.folderId, ids: row.ids })),
      ];
      const at = zones.findIndex((zone) => zone.ids.includes(id));
      if (at < 0) return;
      const here = zones[at];
      const index = here.ids.indexOf(id);
      if (dir === 'up' || dir === 'down') {
        if (dir === 'up' && index <= 0) return;
        if (dir === 'down' && index >= here.ids.length - 1) return;
        await commitFocusDrop([id], {
          column: here.column,
          folderId: here.folderId,
          index: dir === 'up' ? index - 1 : index + 1,
        });
      } else {
        const to = zones[at + (dir === 'left' ? -1 : 1)];
        if (!to) return;
        await commitFocusDrop([id], {
          column: to.column,
          folderId: to.folderId,
          index: Math.min(index, to.ids.length),
        });
      }
      focusSelectedIds = [id];
      focusPrimaryId = id;
      paintFocus();
    };

    const handleFocusKeys = (event) => {
      if ((document.body.getAttribute('data-view') || 'library') !== 'focus') return false;
      if (typingIn()) return false;
      const arrows = { ArrowRight: 'right', ArrowLeft: 'left', ArrowUp: 'up', ArrowDown: 'down' };
      // Alt with an arrow moves the card rather than the selection, through
      // the same drop rules the pointer uses. Arranging is not pointer-only.
      if (event.altKey && !event.metaKey && !event.ctrlKey && arrows[event.key]) {
        event.preventDefault();
        const id = focusPrimaryId || focusSelectedIds[0];
        if (id) moveFocusCard(id, arrows[event.key]);
        return true;
      }
      if (event.metaKey || event.ctrlKey || event.altKey) return false;
      if (arrows[event.key]) {
        event.preventDefault();
        const fromId = focusPrimaryId || focusSelectedIds[0];
        if (!fromId || !focusEl) return true;
        const cards = [...focusEl.querySelectorAll('.focus-card')].map((row) => {
          const r = row.getBoundingClientRect();
          return { id: row.dataset.id, cx: r.left + r.width / 2, cy: r.top + r.height / 2 };
        });
        const next = window.marbleAgentFolders?.nearestCard?.(cards, fromId, arrows[event.key]);
        if (next) {
          selectFocusCard(next.id, event);
          if (focusLookId) openFocusLook(next.id);
        }
        return true;
      }
      if (event.key === ' ' || event.code === 'Space') {
        event.preventDefault();
        const id = focusPrimaryId || focusSelectedIds[0];
        if (!id) return true;
        const row = focusEl?.querySelector(`.focus-card[data-id="${id}"]`);
        if (row?.dataset.lod === 'full' && !focusLookId) return true;
        if (focusLookId === id) closeFocusLook();
        else openFocusLook(id);
        return true;
      }
      if (event.key === 'Enter') {
        event.preventDefault();
        const id = focusPrimaryId || focusSelectedIds[0];
        if (!id) return true;
        closeFocusLook();
        pinFocus(id, { keepOpen: event.shiftKey });
        return true;
      }
      if (event.key === 'Escape') {
        event.preventDefault();
        if (focusLookId) {
          closeFocusLook();
          return true;
        }
        const id = focusPrimaryId || focusSelectedIds[0];
        if (id && summaries.get(id)?.pinned) {
          unpinFocus(id);
          return true;
        }
        focusSelectedIds = [];
        focusPrimaryId = null;
        paintFocus();
        return true;
      }
      return false;
    };

    const openFocusFolderMenu = (card) => {
      closeFolderPalettes();
      const id = card.dataset.id;
      if (!id || !agent) return;
      const current = summaries.get(id)?.folderId ?? null;
      const menu = document.createElement('div');
      menu.className = 'focus-folder-menu';
      menu.setAttribute('role', 'menu');
      menu.setAttribute('data-marble-transient', '');
      const addItem = (label, attrs, onClick) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute('role', 'menuitem');
        btn.setAttribute('data-marble-transient', '');
        btn.textContent = label;
        for (const [key, value] of Object.entries(attrs)) btn.setAttribute(key, value);
        btn.addEventListener('click', async (event) => {
          event.stopPropagation();
          closeFolderPalettes();
          await onClick();
        });
        menu.append(btn);
      };
      for (const folder of folderCatalog) {
        addItem(folder.name || 'Group', {
          'data-folder-id': folder.id,
          'aria-pressed': folder.id === current ? 'true' : 'false',
        }, async () => {
          if (current === folder.id) return;
          try { await agent.update(id, { folderId: folder.id }); } catch { /* stale */ }
        });
      }
      addItem('Ungrouped', { 'data-action': 'ungroup', 'aria-pressed': current ? 'false' : 'true' }, async () => {
        if (!current) return;
        try { await agent.update(id, { folderId: null }); } catch { /* stale */ }
      });
      addItem('Save as folder', { 'data-action': 'save' }, async () => {
        const ids = focusSelectedIds.includes(id) ? [...focusSelectedIds] : [id];
        try { await agent.createFolder({ conversationIds: ids }); } catch { /* create failed */ }
      });
      document.body.append(menu);
      const tick = card.querySelector('.focus-folder');
      const box = (tick || card).getBoundingClientRect();
      const width = menu.offsetWidth || 160;
      let left = box.left;
      if (left + width > window.innerWidth - 12) left = window.innerWidth - width - 12;
      menu.style.left = `${Math.max(12, left)}px`;
      menu.style.top = `${Math.min(box.bottom + 6, window.innerHeight - 80)}px`;
      watchPaletteDismiss();
    };

    // How deep into the canvas's margin a drag has to reach before the canvas
    // starts travelling under it.
    const FOCUS_EDGE = 56;

    const focusCardEl = (id) => focusEl?.querySelector(`.focus-card[data-id="${id}"]`);

    const endFocusDrag = () => {
      const drag = focusDrag;
      if (!drag) return null;
      if (drag.frame) cancelAnimationFrame(drag.frame);
      focusDrag = null;
      delete focusEl.dataset.arranging;
      for (const id of drag.ids) {
        const el = focusCardEl(id);
        if (!el) continue;
        el.classList.remove('marble-dragging');
        delete el.dataset.lift;
      }
      for (const el of focusEl.querySelectorAll('.focus-card[data-drop]')) delete el.dataset.drop;
      document.querySelector('.focus-pinslot')?.remove();
      return drag;
    };

    const bindFocusCard = (card) => {
      card.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        if (event.target.closest('button, a, input, textarea, marble-conversation')) return;
        // The phone layout is a scrolling list, not a canvas. Nothing to
        // rearrange, and a drag here would fight the scroll.
        if (focusEl?.hasAttribute('data-stack') || narrowView.matches) return;
        const id = card.dataset.id;
        const box = card.getBoundingClientRect();
        const grab = {
          fx: box.width ? (event.clientX - box.left) / box.width : 0.5,
          fy: box.height ? (event.clientY - box.top) / box.height : 0.5,
        };
        const origin = { x: event.clientX, y: event.clientY };
        const samples = [{ x: event.clientX, y: event.clientY, t: performance.now() }];
        let done = false;
        card.setPointerCapture?.(event.pointerId);

        const track = (e) => {
          const now = performance.now();
          const last = samples[samples.length - 1];
          // Pointer and mouse events arrive as a pair; one sample per move.
          if (last && now - last.t < 4 && e.clientX === last.x && e.clientY === last.y) return false;
          samples.push({ x: e.clientX, y: e.clientY, t: now });
          if (samples.length > 6) samples.shift();
          return true;
        };

        const velocity = () => {
          const last = samples[samples.length - 1];
          const first = samples.find((row) => last.t - row.t < 120) ?? samples[0];
          const dt = Math.max(16, last.t - first.t) / 1000;
          return { x: (last.x - first.x) / dt, y: (last.y - first.y) / dt };
        };

        /** The card tracks the pointer 1:1 from where it was grabbed, and the
         *  rest of a selection tucks in behind it. Positions are canvas
         *  coordinates, so an auto-scroll moves the card with the canvas. */
        const place = () => {
          if (!focusDrag) return;
          const size = focusLodSize('digest');
          const point = focusPoint(focusDrag.point.x, focusDrag.point.y);
          const w = Math.max(focusEl.clientWidth, focusEl.scrollWidth);
          const h = Math.max(focusEl.clientHeight, focusEl.scrollHeight);
          focusDrag.ids.forEach((row, i) => {
            const el = focusCardEl(row);
            if (!el) return;
            el.style.width = `${size.w}px`;
            el.style.height = `${size.h}px`;
            el.style.left = `${rubberFocus(point.x - grab.fx * size.w + i * 7, 8, w - size.w - 8, w)}px`;
            el.style.top = `${rubberFocus(point.y - grab.fy * size.h + i * 7, 8, h - size.h - 8, h)}px`;
            el.style.zIndex = String(40 - i);
          });
        };

        const aim = () => {
          if (!focusDrag) return;
          const next = focusTargetAt(focusPoint(focusDrag.point.x, focusDrag.point.y));
          if ((next?.key ?? '') === (focusDrag.target?.key ?? '')) return;
          focusDrag.target = next;
          focusDrag.pending = next && !next.merge && next.column !== 'new'
            ? { ids: focusDrag.ids, column: next.column, folderId: next.folderId, index: next.index }
            : null;
          for (const el of focusEl.querySelectorAll('.focus-card[data-drop]')) delete el.dataset.drop;
          if (next?.merge) {
            const el = focusCardEl(next.merge);
            if (el) el.dataset.drop = 'merge';
          }
          // The gap opens here: the field is re-packed with the card already
          // in its slot, and everything below it springs down to make room.
          paintFocus();
          place();
        };

        const travel = () => {
          if (!focusDrag || done) return;
          const box = focusEl.getBoundingClientRect();
          const { x, y } = focusDrag.point;
          let dx = 0;
          let dy = 0;
          if (x < box.left + FOCUS_EDGE) dx = -(1 - Math.max(0, x - box.left) / FOCUS_EDGE);
          else if (x > box.right - FOCUS_EDGE) dx = 1 - Math.max(0, box.right - x) / FOCUS_EDGE;
          if (y < box.top + FOCUS_EDGE) dy = -(1 - Math.max(0, y - box.top) / FOCUS_EDGE);
          else if (y > box.bottom - FOCUS_EDGE) dy = 1 - Math.max(0, box.bottom - y) / FOCUS_EDGE;
          if (dx || dy) {
            const before = { x: focusEl.scrollLeft, y: focusEl.scrollTop };
            focusEl.scrollLeft += dx * 24;
            focusEl.scrollTop += dy * 24;
            if (focusEl.scrollLeft !== before.x || focusEl.scrollTop !== before.y) {
              place();
              aim();
            }
          }
          focusDrag.frame = requestAnimationFrame(travel);
        };

        const begin = () => {
          focusSuppressClick = true;
          const ids = focusSelectedIds.includes(id) && focusSelectedIds.length > 1
            ? [id, ...focusSelectedIds.filter((row) => row !== id)]
            : [id];
          focusDrag = { ids, lead: id, target: null, pending: null, point: { ...origin }, frame: 0 };
          focusEl.dataset.arranging = '1';
          // A fixed pane cannot chase a spring, so it stands down for the
          // length of the gesture and the Full shows its digest instead.
          if (pane) pane.style.visibility = 'hidden';
          for (const row of ids) {
            const el = focusCardEl(row);
            if (!el) continue;
            stopCardSpring(el);
            flattenCardMotion(el);
            el.classList.add('marble-dragging');
            el.dataset.lift = row === id ? 'lead' : 'follow';
          }
          paintFocus();
          place();
          aim();
          focusDrag.frame = requestAnimationFrame(travel);
        };

        const move = (e) => {
          if (done) return;
          if (!track(e)) return;
          if (!focusDrag) {
            if (Math.hypot(e.clientX - origin.x, e.clientY - origin.y) < 10) return;
            begin();
          }
          focusDrag.point = { x: e.clientX, y: e.clientY };
          place();
          aim();
        };

        const finish = async (cancelled) => {
          if (done) return;
          done = true;
          detach();
          const drag = endFocusDrag();
          if (!drag) return;
          const target = cancelled ? null : drag.target;
          const speed = velocity();
          paintFocusSlot(focusPack, null);
          if (target) await commitFocusDrop(drag.ids, target);
          paintFocus({ velocity: speed, velocityId: drag.lead });
          setTimeout(() => { focusSuppressClick = false; }, 0);
        };

        const up = (e) => {
          if (!focusDrag) {
            done = true;
            detach();
            return;
          }
          if (e && track(e)) focusDrag.point = { x: e.clientX, y: e.clientY };
          finish(false);
        };

        const keys = (e) => {
          if (e.key !== 'Escape') return;
          e.preventDefault();
          e.stopPropagation();
          finish(true);
        };

        function detach() {
          document.removeEventListener('pointermove', move);
          document.removeEventListener('mousemove', move);
          document.removeEventListener('pointerup', up);
          document.removeEventListener('mouseup', up);
          document.removeEventListener('pointercancel', cancel);
          document.removeEventListener('keydown', keys, true);
          try { card.releasePointerCapture?.(event.pointerId); } catch { /* released */ }
        }

        const cancel = () => finish(true);

        document.addEventListener('pointermove', move);
        document.addEventListener('mousemove', move);
        document.addEventListener('pointerup', up);
        document.addEventListener('mouseup', up);
        document.addEventListener('pointercancel', cancel);
        document.addEventListener('keydown', keys, true);
      });
      card.addEventListener('click', (event) => {
        if (focusSuppressClick) return;
        if (event.target.closest('button, a, input, textarea, marble-conversation')) return;
        if (event.altKey) {
          openBeside(card.dataset.id);
          return;
        }
        selectFocusCard(card.dataset.id, event);
      });
      card.addEventListener('dblclick', (event) => {
        if (event.target.closest('button, a, input, textarea, marble-conversation')) return;
        event.preventDefault();
        pinFocus(card.dataset.id, { keepOpen: event.shiftKey });
      });
      card.addEventListener('pointerenter', () => {
        if (focusSuppressClick) return;
        if (focusHoveredId === card.dataset.id) return;
        focusHoveredId = card.dataset.id;
        paintFocus({ quiet: true });
      });
      card.addEventListener('pointerleave', () => {
        if (focusHoveredId !== card.dataset.id) return;
        focusHoveredId = null;
        if (!focusSuppressClick) paintFocus({ quiet: true });
      });
      card.querySelector('.focus-pin')?.addEventListener('click', (event) => {
        event.stopPropagation();
        pinFocus(card.dataset.id);
      });
      card.querySelector('.focus-keep')?.addEventListener('click', (event) => {
        event.stopPropagation();
        pinFocus(card.dataset.id, { keepOpen: true });
      });
      card.querySelector('.focus-collapse')?.addEventListener('click', (event) => {
        event.stopPropagation();
        unpinFocus(card.dataset.id);
      });
      card.querySelector('.focus-folder')?.addEventListener('click', (event) => {
        event.stopPropagation();
        openFocusFolderMenu(card);
      });
    };

    const makeFocusCard = (summary) => {
      const card = document.createElement('article');
      card.className = 'focus-card';
      card.dataset.id = summary.id;
      card.setAttribute('data-marble-transient', '');
      card.tabIndex = 0;
      card.innerHTML = '<header class="focus-card-head"><button type="button" class="focus-folder" aria-label="Move to folder"></button><span class="focus-dot dot" aria-hidden="true"></span><span class="focus-card-title title"></span><span class="age focus-head-age"></span><span class="focus-card-actions"><button type="button" class="focus-pin">Focus</button><button type="button" class="focus-keep">Keep open</button><button type="button" class="focus-collapse">Collapse</button></span></header><div class="focus-card-body"><p class="tags focus-tags"></p><p class="focus-target target"></p><p class="focus-activity activity"></p><p class="focus-foot"><span class="focus-status status-word"></span><span class="focus-age age"></span></p></div><div class="focus-live"></div>';
      bindFocusCard(card);
      return card;
    };

    /** The canvas as columns: the stage in rank order, then a column per
     *  folder in catalog order with the loose one last. `pending` is a drag's
     *  placement applied as if it had already been filed, which is what lets
     *  the field open a real gap under the card before you let go. */
    const focusColumnsOf = (items, pending) => {
      const dragging = new Set(pending?.ids ?? []);
      const rank = (item) => (Number.isFinite(item.focusY) ? item.focusY : Infinity);
      const stage = items
        .filter((item) => item.pinned && !dragging.has(item.id))
        .sort((a, b) => {
          const ar = rank(a);
          const br = rank(b);
          if (ar !== br) return ar - br;
          return (b.lastInteractedAt ?? 0) - (a.lastInteractedAt ?? 0);
        })
        .slice(0, FULL_CAP)
        .map((item) => item.id);
      const staged = new Set(stage);
      // Laid out oldest first, not newest first. The list sorts by recency,
      // but a canvas that reorders itself every time a chat ticks destroys the
      // spatial memory that makes Focus worth using — and the keyboard moves
      // through the order on screen.
      const field = items
        .filter((item) => !staged.has(item.id) && !dragging.has(item.id))
        .sort((a, b) => (a.createdAt ?? a.updatedAt ?? 0) - (b.createdAt ?? b.updatedAt ?? 0));
      const order = (list) => [...list].sort((a, b) => {
        const ar = rank(a);
        const br = rank(b);
        return ar === br ? 0 : ar - br;
      });
      const columns = [];
      for (const folder of folderCatalog) {
        const members = order(field.filter((item) => item.folderId === folder.id));
        if (members.length) columns.push({ folderId: folder.id, ids: members.map((item) => item.id) });
      }
      const loose = order(field.filter((item) => (
        !item.folderId || !folderCatalog.some((row) => row.id === item.folderId)
      )));
      columns.push({ folderId: null, ids: loose.map((item) => item.id) });

      if (pending && dragging.size) {
        const ids = [...dragging];
        if (pending.column === 'stage') {
          stage.splice(Math.max(0, Math.min(pending.index ?? stage.length, stage.length)), 0, ...ids);
        } else {
          const folderId = pending.folderId ?? null;
          let column = columns.find((row) => (row.folderId ?? null) === folderId);
          if (!column) {
            column = { folderId, ids: [] };
            columns.splice(Math.max(0, columns.length - 1), 0, column);
          }
          column.ids.splice(Math.max(0, Math.min(pending.index ?? column.ids.length, column.ids.length)), 0, ...ids);
        }
      }
      return { stage, columns };
    };

    /** The canvas's scroll extent. Absolute children cannot be relied on to
     *  push a scroll container out on both axes, and `min-height` on the
     *  canvas itself would grow the grid row instead of its contents. */
    const sizeFocusExtent = (pack) => {
      let el = focusEl.querySelector('.focus-extent');
      if (!pack) {
        el?.remove();
        return;
      }
      if (!el) {
        el = document.createElement('div');
        el.className = 'focus-extent';
        el.setAttribute('data-marble-transient', '');
        el.setAttribute('aria-hidden', 'true');
        focusEl.prepend(el);
      }
      el.style.width = `${Math.round(pack.width)}px`;
      el.style.height = `${Math.round(pack.height)}px`;
    };

    function paintFocus(opts = {}) {
      if (!focusEl) return;
      const view = document.body.getAttribute('data-view') || 'library';
      if (view !== 'focus') return;
      if (narrowView.matches) focusEl.setAttribute('data-stack', '');
      else focusEl.removeAttribute('data-stack');
      if (focusEl.clientWidth < 2 && !focusLayoutQueued) {
        focusLayoutQueued = true;
        requestAnimationFrame(() => {
          focusLayoutQueued = false;
          paintFocus(opts);
        });
        return;
      }
      const helpers = window.marbleAgentFolders;
      const items = matchingFocusItems();
      const layout = focusColumnsOf(items, focusDrag?.pending ?? null);
      const fullIds = layout.stage;
      const lods = helpers?.assignLods
        ? helpers.assignLods(items.map((item) => ({
          id: item.id,
          running: statusOf(item) === 'running',
          needsReview: Boolean(item.needsReview),
          lastInteractedAt: item.lastInteractedAt,
          updatedAt: item.updatedAt,
        })), {
          fullIds,
          selectedIds: focusSelectedIds,
          hoveredId: focusHoveredId,
          now: Date.now(),
        })
        : Object.fromEntries(items.map((item) => [item.id, fullIds.includes(item.id) ? 'full' : 'digest']));
      // A card in the air is a card, whatever it is about to become: the gap
      // the field opens is the size of the thing you are holding.
      for (const id of focusDrag?.ids ?? []) lods[id] = 'digest';

      const lodKey = items.map((item) => `${item.id}:${lods[item.id]}:${focusSelectedIds.includes(item.id) ? 1 : 0}`).join('|');
      const lodsChanged = lodKey !== lastFocusLods;
      lastFocusLods = lodKey;
      lastLods = lods;

      let empty = focusEl.querySelector('.focus-empty');
      if (!items.length) {
        if (!empty) {
          empty = document.createElement('p');
          empty.className = 'focus-empty';
          empty.setAttribute('data-marble-transient', '');
          empty.textContent = 'Open a chat, then double-click it to pin Full.';
          focusEl.append(empty);
        }
      } else {
        empty?.remove();
      }

      const seen = new Set();
      for (const item of items) {
        seen.add(item.id);
        let card = focusEl.querySelector(`.focus-card[data-id="${item.id}"]`);
        if (!card) {
          card = makeFocusCard(item);
          focusEl.append(card);
        }
        paintFocusCard(card, item, lods[item.id] || 'digest');
      }
      for (const card of [...focusEl.querySelectorAll('.focus-card')]) {
        if (!seen.has(card.dataset.id)) {
          stopCardSpring(card);
          card.remove();
        }
      }

      if (focusEl.hasAttribute('data-stack') || narrowView.matches) {
        focusPack = null;
        sizeFocusExtent(null);
        layoutFocusPane(fullIds);
        paintFocusBasins(null);
        return;
      }

      if (opts.quiet && !lodsChanged && !focusDrag) {
        for (const card of focusEl.querySelectorAll('.focus-card')) {
          card.dataset.selected = focusSelectedIds.includes(card.dataset.id) ? 'true' : 'false';
        }
        layoutFocusPane(fullIds);
        return;
      }

      const canvas = focusCanvasBox();
      const fulls = fullIds.map((id) => ({ id }));
      const groups = layout.columns
        .filter((column) => column.ids.length || (column.folderId === null && focusDrag))
        .map((column) => ({
          folderId: column.folderId,
          keep: true,
          cards: column.ids.map((id, index) => ({
            id,
            lod: lods[id] === 'chip' ? 'chip' : 'digest',
            // The column is already in rank order, so hand the packer the
            // order rather than the stored ranks — a card in the air has a
            // stale rank and would sort back where it came from.
            oy: index,
          })),
        }));

      const pack = helpers?.packFocus
        ? helpers.packFocus({
          fulls,
          groups,
          canvas,
          sizes: { digest: focusLodSize('digest'), chip: focusLodSize('chip') },
          gap: helpers.GAP ?? 8,
          newGroup: focusDrag ? 'always' : 'auto',
        })
        // A stale cached copy of agent-folders.js would otherwise leave every
        // card without a rect, and an unplaced card stacks at the origin.
        // Flow them into plain columns instead: no slots, but nothing is lost.
        : flowFieldColumns(fulls, groups, canvas);
      focusPack = pack;
      sizeFocusExtent(pack);

      for (const item of items) {
        const rect = pack.rects[item.id];
        if (!rect) continue;
        const card = focusEl.querySelector(`.focus-card[data-id="${item.id}"]`);
        if (!card || card.classList.contains('marble-dragging')) continue;
        const from = card.hasAttribute('data-placed') ? liveFocusBox(card) : null;
        const vel = opts.velocityId === item.id ? opts.velocity : { x: 0, y: 0 };
        animateFocusCard(card, from, rect, vel);
        card.setAttribute('data-placed', '');
        const lod = card.dataset.lod;
        card.style.zIndex = lod === 'full' ? '3' : lod === 'digest' ? '2' : '1';
      }
      layoutFocusPane(fullIds);
      paintFocusBasins(pack);
    }

    const paintRow = (el, summary) => {
      el.dataset.status = statusOf(summary);
      el.dataset.state = stateOf(summary);
      // A finer signal than the three-way status bucket, purely for the dot's
      // color — failed/watchdog reads as an alarm, not just "take a look".
      if (summary.lastOutcome) el.dataset.outcome = summary.lastOutcome;
      else delete el.dataset.outcome;
      el.querySelector('.title').textContent = summary.title || 'Untitled';
      const tags = el.querySelector('.tags');
      if (tags) {
        tags.replaceChildren();
        for (const tag of (window.marbleAgentUI?.conversationTags?.(summary, labels) ?? [])) {
          const span = document.createElement('span');
          span.className = 'tag';
          span.dataset.kind = tag.kind;
          span.dataset.hue = String(tag.hue);
          span.textContent = tag.label;
          if (tag.title) span.title = tag.title;
          tags.append(span);
        }
      }
      // A turn waiting on a permission prompt or a question is the one thing
      // a glance at the list must not miss.
      el.querySelector('.badge').textContent = summary.asking ? 'Needs you' : '';
      el.querySelector('.activity').textContent = summary.activity || '';
      el.querySelector('.age').textContent = age(summary.updatedAt);
      // The target is what tells two rows apart. It was in the data and on the
      // pane header, but never in the list.
      el.querySelector('.target').textContent = tailOfTarget(targets.get(summary.id) || summary.target || '');
      const color = folderColorOf(summary.folderId);
      if (color) el.dataset.color = color;
      else delete el.dataset.color;
    };

    const columnFor = (summary) => {
      const status = statusOf(summary);
      const col = status === 'running' ? 'running' : status === 'review' ? 'review' : 'completed';
      return document.querySelector(`.column[data-col="${col}"]`);
    };

    /** Counts live on the headings, so a glance at the board says how much is
     *  in each state without counting cards. */
    const paintColumnCounts = () => {
      for (const column of document.querySelectorAll('.column')) {
        const n = column.querySelectorAll(':scope > .conv:not([hidden])').length;
        const count = column.querySelector('h2 .col-count') ?? (() => {
          const span = document.createElement('span');
          span.className = 'col-count';
          span.setAttribute('data-marble-transient', '');
          column.querySelector('h2')?.append(span);
          return span;
        })();
        count.textContent = n ? String(n) : '';
      }
    };

    const placeIn = (el, parent) => {
      // Newest first everywhere; in Needs review, whatever is waiting on the
      // person comes before whatever merely finished.
      const review = parent.dataset?.col === 'review';
      const keyOf = (id) => {
        const s = summaries.get(id);
        return [review && s?.asking ? 0 : 1, -(review ? (s?.lastFinishedAt ?? s?.updatedAt ?? 0) : (s?.updatedAt ?? 0))];
      };
      const mine = keyOf(el.dataset.id);
      const siblings = [...parent.querySelectorAll(':scope > .conv')];
      const before = siblings.find((n) => {
        if (n === el) return false;
        const k = keyOf(n.dataset.id);
        return k[0] > mine[0] || (k[0] === mine[0] && k[1] > mine[1]);
      });
      if (before) parent.insertBefore(el, before);
      else parent.append(el);
    };

    // One element per id. Library: newest-first in #list. Board: the column
    // for its status. Archived stay in the Map and out of the columns.
    const place = (el) => {
      const summary = summaries.get(el.dataset.id);
      const view = document.body.getAttribute('data-view') || 'library';
      if (view === 'board') {
        if (summary?.archived) {
          el.remove();
          return;
        }
        placeIn(el, columnFor(summary));
        return;
      }
      placeIn(el, list);
    };

    const placeAll = () => {
      for (const el of nodes.values()) place(el);
      paintColumnCounts();
    };

    const boardOrder = () => [
      ...document.querySelectorAll('.column[data-col="running"] > .conv'),
      ...document.querySelectorAll('.column[data-col="review"] > .conv'),
      ...document.querySelectorAll('.column[data-col="completed"] > .conv'),
    ];

    const captureRects = () => {
      const rects = new Map();
      for (const el of nodes.values()) {
        if (!el.isConnected) continue;
        rects.set(el, el.getBoundingClientRect());
      }
      return rects;
    };

    const cancelFlip = () => {
      for (const anim of flipAnims) anim.cancel();
      flipAnims = [];
      for (const el of nodes.values()) el.classList.remove('marble-flip');
    };

    const shellFor = (view) => {
      if (view === 'board') return boardEl;
      if (view === 'folders') return foldersEl;
      if (view === 'focus') return focusEl;
      return libraryEl;
    };

    const nextView = (view) => {
      const index = VIEW_ORDER.indexOf(view);
      return VIEW_ORDER[(index + 1) % VIEW_ORDER.length];
    };

    const isListBoard = (view) => view === 'library' || view === 'board';

    // ---- View switches. What leaves is held where it was and fades as it goes;
    // what arrives eases in from the side the view lives on. Anything both views
    // share (the pane between List and Folders) is not touched at all, so it
    // stays put while the rail and the list trade places around it.
    const VT_OUT_MS = 240;
    const VT_IN_MS = 560;
    const VT_EASE = 'cubic-bezier(0.22, 1, 0.36, 1)';
    let frozen = [];
    const FROZEN_PROPS = ['position', 'left', 'top', 'width', 'height', 'margin', 'z-index', 'pointer-events'];

    const partsOf = (view) => {
      if (view === 'folders') return [foldersEl, pane];
      if (view === 'board') return [boardEl];
      if (view === 'focus') return [focusEl, pane];
      return [list, pane];
    };

    const thaw = () => {
      for (const el of frozen) {
        el.classList.remove('marble-vt-out');
        for (const prop of FROZEN_PROPS) el.style.removeProperty(prop);
      }
      frozen = [];
      libraryEl.classList.remove('marble-vt-shell');
    };

    const freeze = (el, rect) => {
      el.classList.add('marble-vt-out');
      el.style.setProperty('position', 'fixed');
      el.style.setProperty('left', `${rect.left}px`);
      el.style.setProperty('top', `${rect.top}px`);
      el.style.setProperty('width', `${rect.width}px`);
      el.style.setProperty('height', `${rect.height}px`);
      el.style.setProperty('margin', '0');
      el.style.setProperty('z-index', '4');
      el.style.setProperty('pointer-events', 'none');
      frozen.push(el);
    };

    const cancelViewFades = () => {
      for (const el of [libraryEl, boardEl, foldersEl, focusEl, list, pane]) {
        for (const anim of el.getAnimations()) anim.cancel();
      }
      thaw();
    };

    const openBoardPanel = () => {
      panelOpen = true;
      document.body.setAttribute('data-panel', 'open');
    };

    const closeBoardPanel = () => {
      panelOpen = false;
      document.body.removeAttribute('data-panel');
    };

    // ---- The pane tree. Panes split the way iTerm's do: any pane can be split on
    // any side, and the halves split again, without end. The layout is a tree.
    // A leaf is a slot — 'P' is the primary chat, e1, e2… are the others — and a
    // split lays its kids out along one axis in shares that sum to one. Keys
    // name slots, not conversations, so a chat can be swapped or replaced in
    // place without the layout noticing.
    const PRIMARY = 'P';
    const EPS = 1e-4;
    let nodeSeq = 0;
    let keySeq = 0;
    const newKey = () => `e${++keySeq}`;
    const leafNode = (key) => ({ leaf: key });
    const splitNode = (dir, kids, sizes) => ({ id: ++nodeSeq, dir, kids, sizes: sizes ?? kids.map(() => 1 / kids.length) });
    const cloneTree = (n) => (n.leaf ? { leaf: n.leaf } : { id: n.id, dir: n.dir, kids: n.kids.map(cloneTree), sizes: [...n.sizes] });
    const treeLeaves = (n, out = []) => {
      if (n.leaf) out.push(n.leaf);
      else n.kids.forEach((kid) => treeLeaves(kid, out));
      return out;
    };
    const findNode = (n, id) => {
      if (!n || n.leaf) return null;
      if (n.id === id) return n;
      for (const kid of n.kids) {
        const hit = findNode(kid, id);
        if (hit) return hit;
      }
      return null;
    };
    const findLeaf = (n, key, parent = null, index = -1) => {
      if (n.leaf) return n.leaf === key ? { node: n, parent, index } : null;
      for (let i = 0; i < n.kids.length; i++) {
        const hit = findLeaf(n.kids[i], key, n, i);
        if (hit) return hit;
      }
      return null;
    };
    const SIDE = { left: ['row', 0], right: ['row', 1], top: ['col', 0], bottom: ['col', 1] };

    /** Split `target`'s space in two and give one half to `key`. Beside a
     *  neighbour on the same axis it joins them as a sibling instead of nesting
     *  a split inside a split. */
    const insertBeside = (root, target, side, key) => {
      const [dir, after] = SIDE[side];
      const hit = findLeaf(root, target);
      if (!hit) return root;
      const fresh = leafNode(key);
      const { node, parent, index } = hit;
      if (parent && parent.dir === dir) {
        const half = parent.sizes[index] / 2;
        parent.sizes[index] = half;
        parent.kids.splice(index + after, 0, fresh);
        parent.sizes.splice(index + after, 0, half);
        return root;
      }
      const pair = splitNode(dir, after ? [node, fresh] : [fresh, node], [0.5, 0.5]);
      if (!parent) return pair;
      parent.kids[index] = pair;
      return root;
    };

    /** Split the whole workspace, not one pane: the new chat spans the edge. */
    const insertAtRoot = (root, side, key) => {
      const [dir, after] = SIDE[side];
      const fresh = leafNode(key);
      if (root.dir === dir) {
        const share = 1 / (root.kids.length + 1);
        root.sizes = root.sizes.map((size) => size * (1 - share));
        root.kids.splice(after ? root.kids.length : 0, 0, fresh);
        root.sizes.splice(after ? root.sizes.length : 0, 0, share);
        return root;
      }
      return splitNode(dir, after ? [root, fresh] : [fresh, root], after ? [0.7, 0.3] : [0.3, 0.7]);
    };

    const flatten = (n) => {
      for (let i = 0; i < n.kids.length; i++) {
        const kid = n.kids[i];
        if (kid.leaf || kid.dir !== n.dir) continue;
        const share = n.sizes[i];
        n.kids.splice(i, 1, ...kid.kids);
        n.sizes.splice(i, 1, ...kid.sizes.map((size) => size * share));
        i += kid.kids.length - 1;
      }
    };

    /** Take a leaf out. Its share flows to its neighbours in proportion, and a
     *  split left with one kid dissolves into it. */
    const removeLeaf = (n, key) => {
      if (n.leaf) return n.leaf === key ? null : n;
      const kids = [];
      const sizes = [];
      n.kids.forEach((kid, i) => {
        const kept = removeLeaf(kid, key);
        if (kept) {
          kids.push(kept);
          sizes.push(n.sizes[i]);
        }
      });
      if (!kids.length) return null;
      if (kids.length === 1) return kids[0];
      const total = sizes.reduce((a, b) => a + b, 0);
      n.kids = kids;
      n.sizes = sizes.map((size) => size / total);
      flatten(n);
      return n;
    };

    const renameLeaf = (n, from, to) => {
      if (n.leaf) {
        if (n.leaf === from) n.leaf = to;
        return;
      }
      n.kids.forEach((kid) => renameLeaf(kid, from, to));
    };

    /** A tidy arrangement for a set of panes nobody placed by hand: side by
     *  side for two, then a grid that stays close to square. */
    const defaultTree = (keys) => {
      const n = keys.length;
      if (n === 1) return leafNode(keys[0]);
      if (n === 2) return splitNode('row', keys.map(leafNode));
      if (n === 3) return splitNode('row', [leafNode(keys[0]), splitNode('col', [leafNode(keys[1]), leafNode(keys[2])])]);
      const cols = Math.ceil(Math.sqrt(n));
      const per = Math.ceil(n / cols);
      const columns = [];
      for (let i = 0; i < n; i += per) {
        const slice = keys.slice(i, i + per).map(leafNode);
        columns.push(slice.length === 1 ? slice[0] : splitNode('col', slice));
      }
      return columns.length === 1 ? columns[0] : splitNode('row', columns);
    };

    /** Where every leaf sits, as fractions of the pane, and where the seams
     *  between kids fall. */
    const layoutOf = (root) => {
      const leaves = new Map();
      const seams = [];
      const walk = (n, x, y, w, h) => {
        if (n.leaf) {
          leaves.set(n.leaf, { x, y, w, h });
          return;
        }
        let at = 0;
        n.kids.forEach((kid, i) => {
          const share = n.sizes[i];
          if (n.dir === 'row') walk(kid, x + w * at, y, w * share, h);
          else walk(kid, x, y + h * at, w, h * share);
          at += share;
          if (i < n.kids.length - 1) seams.push({ node: n, index: i, dir: n.dir, x, y, w, h, at });
        });
      };
      walk(root, 0, 0, 1, 1);
      return { leaves, seams };
    };

    const treeOf = () => dock.tree ?? leafNode(PRIMARY);
    const slotOfKey = (key) => (key === PRIMARY ? 'primary' : dock.extras.findIndex((extra) => extra.key === key));
    const idOfKey = (key) => (key === PRIMARY ? convo.getAttribute('conversation') : (dock.extras.find((extra) => extra.key === key)?.id ?? null));
    const paneIds = () => [convo.getAttribute('conversation'), ...dock.extras.map((extra) => extra.id)].filter(Boolean);

    /** Bring a remembered tree in line with the panes that exist now: leaves that
     *  went are taken out, panes nobody placed are split off the focused one. */
    const reconcileTree = (tree, keys) => {
      if (keys.length <= 1) return null;
      if (!tree) return defaultTree(keys);
      let next = cloneTree(tree);
      const have = new Set(treeLeaves(next));
      for (const key of have) {
        if (!keys.includes(key)) next = removeLeaf(next, key);
        if (!next) return defaultTree(keys);
      }
      const box = pane.getBoundingClientRect();
      for (const key of keys) {
        if (have.has(key)) continue;
        const focused = dock.focus === 'primary' ? PRIMARY : dock.extras[dock.focus]?.key;
        const target = treeLeaves(next).includes(focused) ? focused : treeLeaves(next).at(-1);
        const r = layoutOf(next).leaves.get(target);
        next = insertBeside(next, target, r && r.w * box.width < r.h * box.height ? 'bottom' : 'right', key);
      }
      return next;
    };

    const treeToSaved = (n) => (n.leaf ? idOfKey(n.leaf) : { dir: n.dir, sizes: n.sizes, kids: n.kids.map(treeToSaved) });
    const savedToTree = (saved, keyOfId) => {
      if (typeof saved === 'string') {
        const key = keyOfId.get(saved);
        return key ? leafNode(key) : null;
      }
      if (!saved || !Array.isArray(saved.kids) || saved.kids.length < 2 || (saved.dir !== 'row' && saved.dir !== 'col')) return null;
      const kids = saved.kids.map((kid) => savedToTree(kid, keyOfId));
      if (kids.some((kid) => !kid)) return null;
      const sizes = Array.isArray(saved.sizes) && saved.sizes.length === kids.length ? saved.sizes.map(Number) : null;
      return splitNode(saved.dir, kids, sizes && sizes.every((size) => size > 0) ? sizes : null);
    };

    const rememberDock = () => {
      // An empty pane is not remembered: a tree naming a leaf that will not
      // come back is no tree at all, so it is dropped with the pane.
      const hollow = dock.extras.some((extra) => !extra.id);
      const tree = dock.tree && !hollow ? treeToSaved(dock.tree) : null;
      remember(DOCK_KEY, JSON.stringify({
        v: 2,
        tree: tree && !JSON.stringify(tree).includes('null') ? tree : null,
        extras: dock.extras.filter((extra) => extra.id).map((extra) => extra.id),
        focus: dock.focus,
        file: convo.getAttribute('conversation'),
      }));
    };

    const BAR_MARKUP = `<span class="dot" aria-hidden="true"></span><svg class="dock-grip" viewBox="0 0 10 14" width="10" height="14" aria-hidden="true"><circle cx="3" cy="3" r="1.15" fill="currentColor"/><circle cx="7" cy="3" r="1.15" fill="currentColor"/><circle cx="3" cy="7" r="1.15" fill="currentColor"/><circle cx="7" cy="7" r="1.15" fill="currentColor"/><circle cx="3" cy="11" r="1.15" fill="currentColor"/><circle cx="7" cy="11" r="1.15" fill="currentColor"/></svg><span class="dock-title"></span><a class="dock-target" hidden></a><button type="button" class="dock-split" data-side="right" aria-label="Split right" title="Split right"><svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><rect x="2" y="3" width="12" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M8 3v10" stroke="currentColor" stroke-width="1.4"/></svg></button><button type="button" class="dock-split" data-side="bottom" aria-label="Split down" title="Split down"><svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><rect x="2" y="3" width="12" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M2 8h12" stroke="currentColor" stroke-width="1.4"/></svg></button><button type="button" class="dock-close" aria-label="Close pane"><svg viewBox="0 0 20 20" width="12" height="12" aria-hidden="true"><path d="M5 5l10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>`;

    // ---- The stage. With more than one pane the pane element becomes a stage:
    // every leaf is a card placed by percentages and a pixel gap, so a change to
    // the tree is just new numbers and the browser eases every card to them.
    const GEOM = ['left', 'top', 'width', 'height'];
    let stageEl = null;
    let primaryFrame = null;
    const leafEls = new Map();
    const gutterEls = new Map();
    const pct = (v) => Math.round(v * 10000) / 100;

    const dockGap = () => {
      const gap = parseFloat(getComputedStyle(pane).getPropertyValue('--dock-gap'));
      return Number.isFinite(gap) ? gap : 8;
    };

    const makeFrame = (key) => {
      const el = document.createElement('div');
      el.className = 'dock-frame';
      el.dataset.key = key;
      el.setAttribute('data-marble-transient', '');
      return el;
    };

    /** Lay the pane out as a stage without moving anything: the primary chat
     *  alone, exactly where the grid had it. */
    const enterTreeMode = () => {
      if (pane.getAttribute('data-dock') === 'tree' && stageEl?.isConnected) return;
      stageEl?.remove();
      leafEls.clear();
      gutterEls.clear();
      stageEl = document.createElement('div');
      stageEl.className = 'dock-stage';
      stageEl.setAttribute('data-marble-transient', '');
      primaryFrame = makeFrame(PRIMARY);
      stageEl.append(primaryFrame);
      pane.append(stageEl);
      pane.classList.add('marble-noanim');
      pane.setAttribute('data-dock', 'tree');
      layoutDock(leafNode(PRIMARY));
      void pane.offsetWidth;
      pane.classList.remove('marble-noanim');
    };

    const leaveTreeMode = () => {
      clearTimeout(collapseTimer);
      stageEl?.remove();
      stageEl = null;
      primaryFrame = null;
      leafEls.clear();
      gutterEls.clear();
      for (const extra of dock.extras) extra.el = null;
      pane.removeAttribute('data-dock');
      for (const el of pane.querySelectorAll(':scope > .dock-bar, :scope > marble-conversation:not([data-marble-transient])')) {
        for (const prop of GEOM) el.style.removeProperty(prop);
      }
    };

    const frameFor = (key) => (key === PRIMARY ? primaryFrame : (leafEls.get(key)?.el ?? (room && key === room.ghostKey ? room.ghost : null)));

    const layoutDock = (tree = treeOf(), extraRects = null) => {
      if (pane.getAttribute('data-dock') !== 'tree' || !stageEl) return;
      const gap = dockGap();
      const half = gap / 2;
      const { leaves, seams } = layoutOf(tree);
      if (extraRects) for (const [key, rect] of extraRects) leaves.set(key, rect);
      for (const [key, r] of leaves) {
        const iL = r.x > EPS ? half : 0;
        const iT = r.y > EPS ? half : 0;
        const iR = r.x + r.w < 1 - EPS ? half : 0;
        const iB = r.y + r.h < 1 - EPS ? half : 0;
        const el = frameFor(key);
        if (el) {
          el.style.left = `calc(${pct(r.x)}% + ${iL}px)`;
          el.style.top = `calc(${pct(r.y)}% + ${iT}px)`;
          el.style.width = `calc(${pct(r.w)}% - ${iL + iR}px)`;
          el.style.height = `calc(${pct(r.h)}% - ${iT + iB}px)`;
        }
        if (key !== PRIMARY) continue;
        // The primary chat is the keyed element in the pane, so it cannot be
        // moved into its card; it is placed to sit on top of it instead.
        const bar = pane.querySelector(':scope > .dock-bar');
        const view = pane.querySelector(':scope > marble-conversation:not([data-marble-transient])');
        if (bar) {
          bar.style.left = `calc(${pct(r.x)}% + ${iL + 1}px)`;
          bar.style.top = `calc(${pct(r.y)}% + ${iT + 1}px)`;
          bar.style.width = `calc(${pct(r.w)}% - ${iL + iR + 2}px)`;
          bar.style.height = 'var(--bar-h)';
        }
        if (view) {
          view.style.left = `calc(${pct(r.x)}% + ${iL + 1}px)`;
          view.style.top = `calc(${pct(r.y)}% + ${iT + 1}px + var(--bar-h))`;
          view.style.width = `calc(${pct(r.w)}% - ${iL + iR + 2}px)`;
          view.style.height = `calc(${pct(r.h)}% - ${iT + iB + 2}px - var(--bar-h))`;
        }
      }
      const live = new Set();
      for (const seam of seams) {
        const gkey = `${seam.node.id}:${seam.index}`;
        live.add(gkey);
        let g = gutterEls.get(gkey);
        if (!g) {
          g = makeGutter(seam.node.id, seam.index);
          gutterEls.set(gkey, g);
          stageEl.append(g);
        }
        g.dataset.dir = seam.dir;
        if (seam.dir === 'row') {
          g.style.left = `calc(${pct(seam.x + seam.w * seam.at)}% - ${half}px)`;
          g.style.top = `${pct(seam.y)}%`;
          g.style.width = `${gap}px`;
          g.style.height = `${pct(seam.h)}%`;
        } else {
          g.style.top = `calc(${pct(seam.y + seam.h * seam.at)}% - ${half}px)`;
          g.style.left = `${pct(seam.x)}%`;
          g.style.height = `${gap}px`;
          g.style.width = `${pct(seam.w)}%`;
        }
      }
      for (const [gkey, g] of gutterEls) {
        if (live.has(gkey)) continue;
        g.remove();
        gutterEls.delete(gkey);
      }
    };

    /** The seam between two kids follows the pointer, in shares of the split it
     *  belongs to, and never squeezes either side below a usable width. */
    const makeGutter = (nodeId, index) => {
      const g = document.createElement('div');
      g.className = 'dock-gutter';
      g.setAttribute('data-marble-transient', '');
      g.addEventListener('pointerdown', (event) => {
        if (event.button !== 0 || !dock.tree) return;
        const node = findNode(dock.tree, nodeId);
        const seam = layoutOf(dock.tree).seams.find((s) => s.node.id === nodeId && s.index === index);
        if (!node || !seam) return;
        event.preventDefault();
        g.setPointerCapture(event.pointerId);
        pane.classList.add('marble-docksizing');
        const box = pane.getBoundingClientRect();
        const vertical = node.dir === 'col';
        const start = vertical ? seam.y : seam.x;
        const len = vertical ? seam.h : seam.w;
        const total = vertical ? box.height : box.width;
        const before = node.sizes.slice(0, index).reduce((a, b) => a + b, 0);
        const pair = node.sizes[index] + node.sizes[index + 1];
        const min = Math.min(pair * 0.4, Math.max(0.03, 160 / Math.max(1, len * total)));
        const move = (e) => {
          const pos = vertical ? (e.clientY - box.top) / box.height : (e.clientX - box.left) / box.width;
          const a = Math.min(pair - min, Math.max(min, (pos - start) / len - before));
          node.sizes[index] = a;
          node.sizes[index + 1] = pair - a;
          layoutDock();
        };
        const up = (e) => {
          try { g.releasePointerCapture(e.pointerId); } catch { /* already released */ }
          g.removeEventListener('pointermove', move);
          g.removeEventListener('pointerup', up);
          g.removeEventListener('pointercancel', up);
          pane.classList.remove('marble-docksizing');
          rememberDock();
        };
        g.addEventListener('pointermove', move);
        g.addEventListener('pointerup', up);
        g.addEventListener('pointercancel', up);
      });
      return g;
    };

    // ---- Making room. While a chat is dragged over a pane, the tree gets a
    // ghost leaf where it would land and every card eases to its new share, so
    // the drop is something you watch happen before you do it. Dropping hands
    // the ghost's place to the real chat, unchanged.
    const ROOM_MS = 520;
    let room = null;
    let roomLive = false;
    let collapseTimer = 0;
    let intentKey = null;
    let intentTimer = 0;

    const collapsedRect = (r, side) => {
      if (side === 'right') return { x: r.x + r.w, y: r.y, w: 0, h: r.h };
      if (side === 'left') return { x: r.x, y: r.y, w: 0, h: r.h };
      if (side === 'bottom') return { x: r.x, y: r.y + r.h, w: r.w, h: 0 };
      return { x: r.x, y: r.y, w: r.w, h: 0 };
    };
    const seamRect = (tree, plan) => (plan.root ? null : layoutOf(tree).leaves.get(plan.target)) ?? { x: 0, y: 0, w: 1, h: 1 };
    const roomKey = (plan) => `${plan.root ? '*' : plan.target}:${plan.side}`;

    const makeGhost = (id) => {
      const ghost = makeFrame('ghost');
      ghost.classList.add('dock-ghost');
      ghost.setAttribute('aria-hidden', 'true');
      const tab = document.createElement('div');
      tab.className = 'dock-ghost-tab';
      tab.innerHTML = '<svg class="dock-grip" viewBox="0 0 10 14" width="9" height="13" aria-hidden="true"><circle cx="3" cy="3" r="1.15" fill="currentColor"/><circle cx="7" cy="3" r="1.15" fill="currentColor"/><circle cx="3" cy="7" r="1.15" fill="currentColor"/><circle cx="7" cy="7" r="1.15" fill="currentColor"/><circle cx="3" cy="11" r="1.15" fill="currentColor"/><circle cx="7" cy="11" r="1.15" fill="currentColor"/></svg><span></span>';
      tab.querySelector('span').textContent = summaries.get(id)?.title || 'Untitled';
      const hint = document.createElement('p');
      hint.textContent = 'Release to open here';
      ghost.append(tab, hint);
      return ghost;
    };

    const buildRoom = (plan, id, wasEntered = false) => {
      const base = treeOf();
      const ghostKey = newKey();
      const tree = plan.root
        ? insertAtRoot(cloneTree(base), plan.side, ghostKey)
        : insertBeside(cloneTree(base), plan.target, plan.side, ghostKey);
      const entered = wasEntered || pane.getAttribute('data-dock') !== 'tree';
      if (pane.getAttribute('data-dock') !== 'tree') enterTreeMode();
      const ghost = makeGhost(id);
      stageEl.append(ghost);
      room = { key: roomKey(plan), plan, ghost, ghostKey, tree, entered, closing: false, held: false, timer: 0 };
      // Born as a sliver on the seam it is opening, then every card eases to its
      // share of the new layout.
      ghost.style.transition = 'none';
      layoutDock(base, new Map([[ghostKey, collapsedRect(seamRect(base, plan), plan.side)]]));
      void ghost.offsetWidth;
      ghost.style.removeProperty('transition');
      layoutDock(tree);
    };

    const finishRoom = (r) => {
      if (room !== r) return;
      room = null;
      r.ghost.remove();
      if (r.entered && !dock.tree && !dock.extras.length) leaveTreeMode();
    };

    const foldRoom = () => {
      const r = room;
      if (!r || r.closing) return;
      r.closing = true;
      clearTimeout(r.timer);
      r.ghost.classList.add('marble-leaving');
      const base = treeOf();
      layoutDock(base, new Map([[r.ghostKey, collapsedRect(seamRect(base, r.plan), r.plan.side)]]));
      r.timer = setTimeout(() => finishRoom(r), ROOM_MS + 40);
    };

    /** Put the layout back, animated. `hold` is a drop: keep the slot open until
     *  the real chat has been given it, and fold it only if nothing does. */
    const closeRoom = ({ hold = false } = {}) => {
      const r = room;
      if (!r) return;
      if (hold) {
        r.held = true;
        clearTimeout(r.timer);
        r.timer = setTimeout(foldRoom, 2400);
        return;
      }
      foldRoom();
    };

    const openRoom = (plan, id) => {
      if (room && room.key === roomKey(plan)) {
        if (room.closing) {
          // Back over the same edge before it finished folding: reopen from
          // wherever it got to rather than waiting.
          room.closing = false;
          clearTimeout(room.timer);
          room.ghost.classList.remove('marble-leaving');
          layoutDock(room.tree);
        }
        return;
      }
      if (room) {
        // A different edge: the old slot fades where it stands while every card
        // eases toward the new layout from wherever it is — no waiting for the
        // last move to finish.
        const old = room;
        clearTimeout(old.timer);
        room = null;
        old.ghost.classList.add('marble-leaving');
        setTimeout(() => old.ghost.remove(), 300);
        buildRoom(plan, id, old.entered);
        return;
      }
      buildRoom(plan, id);
    };

    /** applyDock is about to lay the real panes out. Hand over the slot (if a
     *  drop is holding one) so the chat can take it from the ghost. */
    const takeRoom = () => {
      const r = room;
      if (!r) return null;
      clearTimeout(r.timer);
      room = null;
      return r;
    };

    /** Where a chat lands when the pointer has no edge to say: beside the pane,
     *  along whichever way it is longer. */
    const restingSide = (key) => {
      const r = layoutOf(treeOf()).leaves.get(key);
      const box = pane.getBoundingClientRect();
      return r && r.w * box.width < r.h * box.height ? 'bottom' : 'right';
    };

    /** The one answer paint and drop both read, so what was previewed is what
     *  happens. `plan` is null when nothing about the layout would change. */
    const currentView = () => document.body.getAttribute('data-view') || 'library';

    /** With no pane open on the board, the rightmost band of the kanban is
     *  where a dragged card opens. Drawn only for the length of a drag. */
    const dockZone = () => {
      let zone = boardEl.querySelector(':scope > .board-dockzone');
      if (!zone) {
        zone = document.createElement('div');
        zone.className = 'board-dockzone';
        zone.setAttribute('data-marble-transient', '');
        zone.setAttribute('aria-hidden', 'true');
        zone.innerHTML = '<span>Open here</span>';
        boardEl.append(zone);
      }
      return zone;
    };
    const removeDockZone = () => boardEl.querySelector(':scope > .board-dockzone')?.remove();
    const inDockZone = (clientX, clientY) => {
      const b = boardEl.getBoundingClientRect();
      return clientX >= b.right - b.width * 0.12 && clientX <= b.right && clientY >= b.top && clientY <= b.bottom;
    };

    const resolveDrop = (clientX, clientY, id, { rail = false } = {}) => {
      const none = { plan: null };
      if (clientX == null) return none;
      if (currentView() === 'board' && !document.body.hasAttribute('data-panel')) {
        return inDockZone(clientX, clientY) ? { plan: { mode: 'fill', zone: true } } : none;
      }
      const box = pane.getBoundingClientRect();
      if (clientX < box.left || clientX > box.right || clientY < box.top || clientY > box.bottom) return none;
      const hasPane = document.body.hasAttribute('data-open') && convo.getAttribute('conversation');
      if (!hasPane) return { plan: { mode: 'fill' } };
      if (narrowView.matches || reduceMotion.matches) {
        // No room to make, and no motion to make it with: a drop replaces.
        return { plan: { mode: 'replace', target: dock.focus === 'primary' ? PRIMARY : (dock.extras[dock.focus]?.key ?? PRIMARY) } };
      }
      const slot = slotOf(id);
      const sourceKey = slot == null ? null : (slot === 'primary' ? PRIMARY : dock.extras[slot]?.key);
      const tree = treeOf();
      const { leaves } = layoutOf(tree);
      const px = (r) => ({
        left: box.left + r.x * box.width, top: box.top + r.y * box.height,
        width: r.w * box.width, height: r.h * box.height,
      });
      let target = null;
      let rect = null;
      for (const [key, r] of leaves) {
        const p = px(r);
        if (clientX >= p.left && clientX <= p.left + p.width && clientY >= p.top && clientY <= p.top + p.height) {
          target = key;
          rect = p;
          break;
        }
      }
      if (!target) return none;
      // A docked chat dragged by its bar and dropped on another bar changes places.
      const down = clientY - rect.top;
      if (sourceKey && sourceKey !== target && down > 10 && down < 38) return { plan: { mode: 'swap', target } };
      // The outer band splits the whole workspace rather than one pane.
      if (leaves.size > 1) {
        const band = 12;
        const dist = { left: clientX - box.left, right: box.right - clientX, top: clientY - box.top, bottom: box.bottom - clientY };
        const nearest = Object.keys(dist).reduce((x, y) => (dist[x] <= dist[y] ? x : y));
        if (dist[nearest] < band) return { plan: { mode: 'split', root: true, side: nearest } };
      }
      if (target === sourceKey) return none;
      const d = {
        left: (clientX - rect.left) / rect.width,
        right: (rect.left + rect.width - clientX) / rect.width,
        top: (clientY - rect.top) / rect.height,
        bottom: (rect.top + rect.height - clientY) / rect.height,
      };
      let side = Object.keys(d).reduce((a, b) => (d[a] <= d[b] ? a : b));
      const open = room && !room.closing && !room.plan.root && room.plan.target === target ? room.plan.side : null;
      // Wider once an edge is open, so a pointer resting on its boundary does
      // not make the room flicker.
      const edge = open && d[open] < 0.34 ? 0.34 : 0.25;
      if (open && d[open] < 0.34) side = open;
      const isEdge = d[side] < edge;
      if (isEdge) return { plan: { mode: 'split', target, side } };
      if (rail) return { plan: { mode: 'split', target, side: restingSide(target) } };
      if (narrowView.matches || reduceMotion.matches || !sourceKey) return { plan: { mode: 'replace', target } };
      return { plan: { mode: 'swap', target } };
    };

    const paintDrop = (clientX, clientY, id, opts = {}) => {
      const res = resolveDrop(clientX, clientY, id, opts);
      roomLive = clientX != null;
      const plan = res.plan;
      const mode = plan?.mode ?? null;
      if (clientX != null && currentView() === 'board' && !document.body.hasAttribute('data-panel')) {
        const zone = dockZone();
        if (plan?.zone) zone.setAttribute('data-drop', '');
        else zone.removeAttribute('data-drop');
      } else {
        removeDockZone();
      }
      pane.classList.toggle('marble-drop-fill', mode === 'fill');
      const dimmed = mode === 'replace' ? plan.target : null;
      pane.classList.toggle('marble-replace-primary', dimmed === PRIMARY);
      for (const frame of pane.querySelectorAll('.dock-frame')) frame.classList.toggle('marble-replace', dimmed != null && frame.dataset.key === dimmed);
      for (const bar of pane.querySelectorAll('.dock-bar')) bar.classList.toggle('marble-drop-swap', mode === 'swap' && bar.dataset.key === plan.target);
      if (mode === 'split') {
        // A moment of intent before the layout moves, so crossing an edge on
        // the way somewhere else does not flash a slot open.
        const key = roomKey(plan);
        if (room && room.key === key) {
          intentKey = key;
          clearTimeout(intentTimer);
          openRoom(plan, id);
        } else if (intentKey !== key) {
          intentKey = key;
          clearTimeout(intentTimer);
          intentTimer = setTimeout(() => { if (roomLive && intentKey === key) openRoom(plan, id); }, room ? 70 : 130);
        }
      } else {
        intentKey = null;
        clearTimeout(intentTimer);
        closeRoom();
      }
      return res;
    };

    /** The drag is over. A drop that will dock keeps its slot open for the real
     *  chat; anything else folds the room back. */
    const endDrop = (docks) => {
      roomLive = false;
      removeDockZone();
      intentKey = null;
      clearTimeout(intentTimer);
      pane.classList.remove('marble-drop-fill', 'marble-replace-primary');
      for (const frame of pane.querySelectorAll('.dock-frame.marble-replace')) frame.classList.remove('marble-replace');
      for (const bar of pane.querySelectorAll('.dock-bar')) bar.classList.remove('marble-drop-swap');
      closeRoom({ hold: docks });
    };

    const focusedPaneId = () => (dock.focus === 'primary' ? convo.getAttribute('conversation') : dock.extras[dock.focus]?.id) ?? null;

    const slotOf = (id) => {
      if (!id) return null;
      if (convo.getAttribute('conversation') === id) return 'primary';
      const index = dock.extras.findIndex((item) => item.id === id);
      return index >= 0 ? index : null;
    };

    const writeSlot = (slot, id) => {
      if (slot === 'primary') {
        if (id) convo.setAttribute('conversation', id);
        else convo.removeAttribute('conversation');
        return;
      }
      if (typeof slot === 'number' && dock.extras[slot]) dock.extras[slot].id = id;
    };

    const focusSlot = (slot, id) => {
      dock.focus = slot;
      openId = id;
      if (id) {
        remember(OPEN_KEY, id);
        document.body.setAttribute('data-open', 'true');
      }
      rememberDock();
      paintOpen();
      paintChrome();
    };

    const paintBar = (bar, id) => {
      if (!bar) return;
      bar.dataset.id = id || '';
      const summary = summaries.get(id) ?? {};
      bar.dataset.state = stateOf(summary);
      bar.querySelector('.dock-title').textContent = summary.title || (id ? 'Untitled' : 'Empty pane');
      const link = bar.querySelector('.dock-target');
      const target = targets.get(id) || summary.target || '';
      if (target) {
        link.hidden = false;
        link.textContent = target;
        const href = window.marble?.href?.(target);
        if (href) link.href = href;
        else link.removeAttribute('href');
      } else {
        link.hidden = true;
        link.textContent = '';
        link.removeAttribute('href');
      }
    };

    const paintBars = () => {
      paintBar(pane.querySelector(':scope > .dock-bar'), convo.getAttribute('conversation'));
      for (const extra of dock.extras) paintBar(leafEls.get(extra.key)?.bar, extra.id);
      paintChrome();
    };

    /** Only the focused pane carries the status line, the workdir path and the
     *  agent pickers. They are identical on every pane in a folder, so the
     *  others would spend a third of their height repeating them. */
    /** The pane you are in is the lit one; its neighbours step back onto the
     *  paper, so there is never a question of where typing goes. */
    const paintChrome = () => {
      const focusedKey = dock.focus === 'primary' ? PRIMARY : dock.extras[dock.focus]?.key;
      const primaryOn = !dock.extras.length || focusedKey === PRIMARY;
      const mark = (el, on) => {
        if (!el) return;
        if (on) el.setAttribute('data-focused', '');
        else el.removeAttribute('data-focused');
      };
      mark(pane, primaryOn);
      mark(primaryFrame, primaryOn);
      mark(pane.querySelector(':scope > .dock-bar'), primaryOn);
      convo.setAttribute('data-focused', String(primaryOn));
      convo.setAttribute('data-chrome', primaryOn ? 'pane' : 'tile');
      // `extra.el` is the chat itself; its card and bar are the leaf's.
      dock.extras.forEach((extra, index) => {
        const on = dock.focus === index;
        const leaf = leafEls.get(extra.key);
        mark(leaf?.el, on);
        mark(leaf?.bar, on);
        extra.el?.setAttribute('data-focused', String(on));
        extra.el?.setAttribute('data-chrome', on ? 'pane' : 'tile');
      });
    };

    const lastTarget = (detail) => {
      const events = detail.events ?? [];
      for (let i = events.length - 1; i >= 0; i--) {
        const target = events[i].context?.target;
        if (events[i].type === 'user' && target) return target;
      }
      const turns = detail.turns ?? [];
      for (let i = turns.length - 1; i >= 0; i--) {
        const target = turns[i].context?.target;
        if (target) return target;
      }
      return null;
    };

    const fillChrome = async (id) => {
      ensurePrimaryBar();
      paintBars();
      if (!id || !agent) return;
      try {
        const detail = await agent.conversation(id);
        const target = lastTarget(detail) ?? detail.meta?.target;
        if (target) targets.set(id, target);
      } catch { /* header still has the title */ }
      if (openId !== id && convo.getAttribute('conversation') !== id && !dock.extras.some((item) => item.id === id)) return;
      paintBars();
    };

    const makeBar = (key) => {
      const bar = document.createElement('div');
      bar.className = 'dock-bar';
      bar.dataset.key = key;
      bar.setAttribute('data-marble-transient', '');
      bar.innerHTML = BAR_MARKUP;
      bar.querySelector('.dock-close').addEventListener('click', (event) => {
        event.stopPropagation();
        closeSlot(slotOfKey(bar.dataset.key));
      });
      for (const button of bar.querySelectorAll('.dock-split')) {
        button.addEventListener('click', (event) => {
          event.stopPropagation();
          splitEmpty(bar.dataset.key, button.dataset.side);
        });
      }
      bar.addEventListener('pointerdown', (event) => {
        if (event.target.closest('a, button')) return;
        const id = bar.dataset.id;
        if (!id) return;
        focusSlot(slotOfKey(bar.dataset.key), id);
      });
      bindPaneDrag(bar, () => bar.dataset.id);
      return bar;
    };

    const ensurePrimaryBar = () => {
      convo.setAttribute('data-chrome', 'pane');
      let bar = pane.querySelector(':scope > .dock-bar');
      if (!bar) {
        bar = makeBar(PRIMARY);
        convo.before(bar);
      }
      bar.dataset.key = PRIMARY;
      return bar;
    };

    const closeSlot = (slot) => {
      if (slot === 'primary') {
        if (dock.extras.length) {
          // The chat that takes over the primary element keeps its own place in
          // the layout; the primary's old place is what closes up.
          const next = dock.extras[0];
          if (dock.tree) {
            dock.tree = removeLeaf(dock.tree, PRIMARY);
            if (dock.tree) renameLeaf(dock.tree, next.key, PRIMARY);
          }
          convo.setAttribute('conversation', next.id);
          dock.extras = dock.extras.slice(1);
          focusSlot('primary', next.id);
          applyDock();
          fillChrome(next.id);
        } else {
          if ((document.body.getAttribute('data-view') || 'library') === 'board') closeBoardPanel();
          open(null);
        }
        return;
      }
      if (slot == null || slot < 0) return;
      const gone = dock.extras[slot];
      dock.extras = dock.extras.filter((_, index) => index !== slot);
      if (dock.tree && gone) dock.tree = removeLeaf(dock.tree, gone.key);
      if (dock.focus === slot) dock.focus = 'primary';
      else if (typeof dock.focus === 'number' && dock.focus > slot) dock.focus -= 1;
      rememberDock();
      applyDock();
      const stay = dock.focus === 'primary' ? convo.getAttribute('conversation') : dock.extras[dock.focus]?.id;
      if (stay) {
        openId = stay;
        remember(OPEN_KEY, stay);
        paintOpen();
      }
    };

    const makeLeaf = (extra) => {
      const el = makeFrame(extra.key);
      el.classList.add('dock-leaf');
      const bar = makeBar(extra.key);
      const view = document.createElement('marble-conversation');
      view.setAttribute('data-marble-transient', '');
      view.setAttribute('data-chrome', 'pane');
      if (extra.id) view.setAttribute('conversation', extra.id);
      el.addEventListener('pointerdown', () => {
        const slot = slotOfKey(extra.key);
        const current = dock.extras[slot];
        if (!current?.id) return;
        focusSlot(slot, current.id);
        fillChrome(current.id);
      });
      el.append(bar, view);
      const rec = { el, bar, view };
      leafEls.set(extra.key, rec);
      return rec;
    };

    /** Callers that replace the list with bare ids get their keys here, and keep
     *  the live pane that already shows the same conversation. */
    const normalizeExtras = () => {
      const claimed = new Set(dock.extras.map((extra) => extra.key).filter(Boolean));
      for (const extra of dock.extras) {
        if (extra.key) continue;
        const match = extra.id
          ? [...leafEls].find(([key, rec]) => !claimed.has(key) && rec.view.getAttribute('conversation') === extra.id)
          : null;
        extra.key = match ? match[0] : newKey();
        claimed.add(extra.key);
      }
    };

    /** Bring the cards in the stage in line with dock.extras. */
    const syncLeaves = (animated, handOver) => {
      const ghostKey = handOver && !handOver.closing && handOver.held ? handOver.ghostKey : null;
      for (const extra of dock.extras) {
        let rec = leafEls.get(extra.key);
        if (!rec) {
          rec = makeLeaf(extra);
          stageEl.append(rec.el);
          if (animated && extra.key !== ghostKey) {
            rec.el.classList.add('marble-entering');
            requestAnimationFrame(() => requestAnimationFrame(() => rec.el.classList.remove('marble-entering')));
          }
        } else if ((extra.id || '') !== (rec.view.getAttribute('conversation') || '')) {
          if (extra.id) rec.view.setAttribute('conversation', extra.id);
          else rec.view.removeAttribute('conversation');
        }
        extra.el = rec.view;
      }
      const keys = new Set(dock.extras.map((extra) => extra.key));
      for (const [key, rec] of leafEls) {
        if (keys.has(key)) continue;
        leafEls.delete(key);
        if (animated) {
          rec.el.classList.add('marble-leaving');
          setTimeout(() => rec.el.remove(), ROOM_MS + 60);
        } else {
          rec.el.remove();
        }
      }
      if (!handOver) return;
      const rec = ghostKey ? leafEls.get(ghostKey) : null;
      if (!rec) {
        handOver.ghost.remove();
        return;
      }
      // The ghost stays over the new chat and dissolves, so what arrives is the
      // slot filling in, not a swap.
      const ghost = handOver.ghost;
      ghost.removeAttribute('style');
      ghost.className = 'dock-frame dock-ghost marble-dissolve';
      rec.el.append(ghost);
      const drop = () => ghost.remove();
      ghost.addEventListener('animationend', drop, { once: true });
      setTimeout(drop, 700);
    };

    const applyDock = () => {
      ensurePrimaryBar();
      clearTimeout(collapseTimer);
      const handOver = takeRoom();
      const view = document.body.getAttribute('data-view') || 'library';
      const animated = view !== 'focus' && !reduceMotion.matches && !narrowView.matches;
      if (view === 'focus') {
        handOver?.ghost.remove();
        leaveTreeMode();
        paintBars();
        return;
      }
      normalizeExtras();
      dock.tree = reconcileTree(dock.tree, [PRIMARY, ...dock.extras.map((extra) => extra.key)]);
      if (!dock.tree) {
        // Down to one pane: fold the others away, then hand the layout back to
        // the grid, which puts the primary chat exactly where the stage had it.
        if (pane.getAttribute('data-dock') === 'tree') {
          syncLeaves(animated, handOver);
          layoutDock(leafNode(PRIMARY));
          if (animated) collapseTimer = setTimeout(() => { if (!dock.extras.length) leaveTreeMode(); }, ROOM_MS + 60);
          else leaveTreeMode();
        } else {
          handOver?.ghost.remove();
        }
        paintBars();
        return;
      }
      const fresh = pane.getAttribute('data-dock') !== 'tree';
      if (fresh) enterTreeMode();
      syncLeaves(animated, handOver);
      layoutDock(dock.tree);
      paintBars();
    };

    const swapIds = (a, b) => {
      const sa = slotOf(a);
      const sb = slotOf(b);
      if (sa == null || sb == null || sa === sb) return false;
      writeSlot(sa, b);
      writeSlot(sb, a);
      focusSlot(sb, a);
      rememberDock();
      applyDock();
      fillChrome(a);
      fillChrome(b);
      return true;
    };

    /** Put `id` beside a pane (or beside the whole workspace). A chat already in
     *  a pane is moved; anything else gets a pane of its own. */
    const dockAt = (id, plan) => {
      const slot = slotOf(id);
      let tree = cloneTree(treeOf());
      let key;
      if (slot != null) {
        key = slot === 'primary' ? PRIMARY : dock.extras[slot].key;
        if (plan.target === key) return;
        tree = removeLeaf(tree, key);
        if (!tree) return;
      } else {
        key = room && !room.closing && room.held ? room.ghostKey : newKey();
        dock.extras.push({ key, id });
      }
      dock.tree = plan.root ? insertAtRoot(tree, plan.side, key) : insertBeside(tree, plan.target, plan.side, key);
      dock.focus = slotOfKey(key);
      rememberDock();
      applyDock();
      openId = id;
      remember(OPEN_KEY, id);
      document.body.setAttribute('data-open', 'true');
      paintOpen();
      fillChrome(id);
    };

    /** Alt-click anywhere: the chat lands beside the focused pane, on the
     *  pane's longer side. With nothing open it just opens. */
    const openBeside = async (id) => {
      if (!id) return;
      const hasPane = document.body.hasAttribute('data-open') && convo.getAttribute('conversation');
      if (!hasPane || narrowView.matches || reduceMotion.matches || slotOf(id) != null) return open(id);
      const target = dock.focus === 'primary' ? PRIMARY : (dock.extras[dock.focus]?.key ?? PRIMARY);
      dockAt(id, { target, side: restingSide(target) });
    };

    /** A pane with nothing in it yet: the hint and a composer. Starting a chat
     *  there fills it, and so does clicking a row while it is the focused pane. */
    const splitEmpty = (key, side) => {
      const k = newKey();
      dock.extras.push({ key: k, id: null });
      dock.tree = insertBeside(cloneTree(treeOf()), key, side, k);
      dock.focus = slotOfKey(k);
      rememberDock();
      applyDock();
      paintOpen();
    };

    /** What a drop does, by what resolveDrop said it would. */
    const dropOnto = (id, res) => {
      const plan = res?.plan;
      if (!plan || plan.mode === 'fill') {
        if (plan?.zone) openBoardPanel();
        open(id);
        return;
      }
      if (plan.mode === 'split') {
        dockAt(id, plan);
        return;
      }
      if (plan.mode === 'swap') {
        const other = idOfKey(plan.target);
        if (!other || !swapIds(id, other)) open(id);
        return;
      }
      const slot = slotOfKey(plan.target);
      if (slot != null && slot !== -1) dock.focus = slot;
      open(id);
    };

    const placeCard = (card, clientX, clientY, grabX = 16, grabY = 16) => {
      card.style.left = `${clientX - grabX}px`;
      card.style.top = `${clientY - grabY}px`;
    };

    const makeCard = (id, grabX = 16, grabY = 16) => {
      const card = document.createElement('div');
      card.className = 'dock-card';
      card.setAttribute('data-marble-transient', '');
      card.style.setProperty('--grab-x', `${grabX}px`);
      card.style.setProperty('--grab-y', `${grabY}px`);
      const summary = summaries.get(id) ?? {};
      const title = document.createElement('span');
      title.className = 'dock-title';
      title.textContent = summary.title || 'Untitled';
      const target = document.createElement('span');
      target.className = 'dock-target';
      target.textContent = targets.get(id) || summary.target || '';
      card.append(title);
      if (target.textContent) card.append(target);
      document.body.append(card);
      return card;
    };

    const bindPaneDrag = (el, idOf) => {
      el.addEventListener('pointerdown', (event) => {
        if (event.button !== 0 || event.target.closest('a, input, textarea, button, .manage')) return;
        if (narrowView.matches || reduceMotion.matches) return;
        // With nothing open there is nowhere to dock — except on the board,
        // where the drag itself is what opens the pane.
        if (!document.body.hasAttribute('data-open') && currentView() !== 'board') return;
        const src = el.getBoundingClientRect();
        let grabX = event.clientX - src.left;
        let grabY = event.clientY - src.top;
        const origin = { x: event.clientX, y: event.clientY, id: idOf(), started: false };
        if (!origin.id) return;
        let done = false;
        let card = null;
        el.setPointerCapture?.(event.pointerId);
        const move = (e) => {
          if (done) return;
          if (!origin.started && Math.hypot(e.clientX - origin.x, e.clientY - origin.y) < 8) return;
          origin.started = true;
          if (!card) {
            card = makeCard(origin.id, grabX, grabY);
            el.classList.add('marble-lifted');
            document.body.classList.add('marble-dragging-chat');
          }
          placeCard(card, e.clientX, e.clientY, grabX, grabY);
          const res = paintDrop(e.clientX, e.clientY, origin.id);
          card.classList.toggle('marble-docking', Boolean(res.plan && res.plan.mode !== 'fill'));
        };
        const up = (e) => {
          if (done) return;
          done = true;
          document.removeEventListener('pointermove', move);
          document.removeEventListener('mousemove', move);
          document.removeEventListener('pointerup', up);
          document.removeEventListener('mouseup', up);
          document.removeEventListener('pointercancel', up);
          try { el.releasePointerCapture?.(e.pointerId); } catch { /* already released */ }
          el.classList.remove('marble-lifted');
          document.body.classList.remove('marble-dragging-chat');
          // Resolved before the room is put away, so a drop lands where the
          // preview showed it — including the wider edge an open side keeps.
          const res = origin.started ? resolveDrop(e.clientX, e.clientY, origin.id) : null;
          card?.remove();
          endDrop(res?.plan?.mode === 'split');
          if (!origin.started) return;
          suppressConvClick = true;
          setTimeout(() => { suppressConvClick = false; }, 0);
          dropOnto(origin.id, res);
        };
        document.addEventListener('pointermove', move);
        document.addEventListener('mousemove', move);
        document.addEventListener('pointerup', up);
        document.addEventListener('mouseup', up);
        document.addEventListener('pointercancel', up);
      });
    };

    const bindConvDrag = (el) => bindPaneDrag(el, () => el.dataset.id);

    const typingIn = () => {
      const host = document.activeElement;
      const inner = host?.shadowRoot?.activeElement ?? host;
      if (!inner || inner === document.body || inner === document.documentElement) return false;
      if (inner === search || inner.closest?.('input.search')) return true;
      if (inner.isContentEditable) return true;
      const tag = inner.tagName;
      return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT';
    };

    const closeRowMenus = () => {
      for (const menu of document.querySelectorAll('.conv .manage .menu')) menu.remove();
      for (const btn of document.querySelectorAll('.conv .manage .more')) btn.setAttribute('aria-expanded', 'false');
    };

    const successorOf = (id) => {
      const view = document.body.getAttribute('data-view') || 'library';
      const order = view === 'board'
        ? boardOrder()
        : [...list.querySelectorAll(':scope > .conv')];
      const alive = (el) => {
        const summary = summaries.get(el.dataset.id);
        return Boolean(summary) && !summary.archived && el.dataset.id !== id;
      };
      const idx = order.findIndex((el) => el.dataset.id === id);
      if (idx >= 0) {
        for (let i = idx + 1; i < order.length; i++) if (alive(order[i])) return order[i].dataset.id;
        for (let i = idx - 1; i >= 0; i--) if (alive(order[i])) return order[i].dataset.id;
      }
      return order.find(alive)?.dataset.id ?? null;
    };

    const archiveConversation = async (id) => {
      const summary = summaries.get(id);
      const filing = !summary?.archived;
      const wasOpen = openId === id;
      const nextId = filing && wasOpen ? successorOf(id) : openId;
      const meta = await agent.archive(id, filing);
      upsert(meta);
      if (wasOpen && meta.archived) await open(nextId);
    };

    const fillRowMenu = async (el) => {
      closeRowMenus();
      const id = el.dataset.id;
      const summary = summaries.get(id);
      const more = el.querySelector('.more');
      const menu = document.createElement('div');
      menu.className = 'menu';
      menu.setAttribute('role', 'menu');
      const add = (label, act, run) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.dataset.act = act;
        btn.setAttribute('role', 'menuitem');
        btn.textContent = label;
        btn.addEventListener('click', async (event) => {
          event.stopPropagation();
          closeRowMenus();
          try { await run(); } catch (err) { btn.textContent = err.message; }
        });
        menu.append(btn);
      };
      add(summary?.archived ? 'Unarchive' : 'Archive', summary?.archived ? 'unarchive' : 'archive', () => archiveConversation(id));
      if (summary?.needsReview) {
        add('Mark reviewed', 'reviewed', () => agent.markReviewed(id));
      }
      el.querySelector('.manage').append(menu);
      more?.setAttribute('aria-expanded', 'true');
      let detail = null;
      try { if (agent) detail = await agent.conversation(id); } catch { /* archive still works */ }
      if (!menu.isConnected) return;
      const turn = undoable(detail?.turns);
      if (turn) add('Undo last turn', 'undo', async () => { await agent.undo(turn.id); if (openId === id) fillChrome(id); });
      for (const provider of labels.values()) {
        if (!provider.installed || !provider.signedIn || provider.id === summary?.provider) continue;
        add('Continue in ' + (provider.label ?? provider.id), 'handoff-' + provider.id, async () => {
          await open(await agent.handoff(id, provider.id));
        });
      }
    };

    const upsert = (summary) => {
      if (!summary?.id) return;
      summaries.set(summary.id, summary);
      let el = nodes.get(summary.id);
      if (!el) {
        el = document.createElement('div');
        el.className = 'conv';
        el.dataset.id = summary.id;
        el.setAttribute('role', 'listitem');
        el.tabIndex = 0;
        el.innerHTML = '<span class="dot" aria-hidden="true"></span><span class="body"><span class="title"></span><span class="target"></span><span class="tags"></span><span class="meta"><span class="badge"></span><span class="activity"></span></span></span><span class="age"></span><div class="manage"><button type="button" class="more" aria-label="Manage conversation" aria-haspopup="menu" aria-expanded="false"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="3.5" cy="8" r="1.3" fill="currentColor"/><circle cx="8" cy="8" r="1.3" fill="currentColor"/><circle cx="12.5" cy="8" r="1.3" fill="currentColor"/></svg></button></div>';
        const openRow = (event) => {
          if (suppressConvClick) return;
          if ((document.body.getAttribute('data-view') || 'library') === 'board') openBoardPanel();
          if (event?.altKey) {
            openBeside(el.dataset.id);
            return;
          }
          open(el.dataset.id);
        };
        el.addEventListener('click', (event) => {
          if (event.target.closest('.manage')) return;
          openRow(event);
        });
        el.addEventListener('keydown', (event) => {
          if (event.target.closest('.manage')) return;
          if (event.key !== 'Enter' && event.key !== ' ') return;
          event.preventDefault();
          openRow(event);
        });
        el.querySelector('.more').addEventListener('click', (event) => {
          event.stopPropagation();
          if (el.querySelector('.manage .menu')) closeRowMenus();
          else fillRowMenu(el);
        });
        bindConvDrag(el);
        nodes.set(summary.id, el);
      }
      paintRow(el, summary);
      place(el);
      el.hidden = !matches(summary);
      el.classList.toggle('marble-open', summary.id === openId);
      if (summary.id === openId) fillChrome(summary.id);
      paintFolderRail();
      paintFocus();
    };

    const undoable = (turns) => {
      for (let i = (turns ?? []).length - 1; i >= 0; i--) {
        const turn = turns[i];
        if (turn.status === 'completed' && turn.applied && !turn.undoneAt) return turn;
      }
      return null;
    };

    const showEmpty = (text = 'Pick a conversation, or ask below to start one.') => {
      const hint = pane.querySelector('.pane-hint p');
      if (hint) hint.textContent = text;
    };

    async function open(id) {
      if (id) {
        const existing = slotOf(id);
        if (existing != null) {
          focusSlot(existing, id);
          if (!summaries.has(id) && agent) {
            try { upsert((await agent.conversation(id)).meta); } catch { /* opened from a stale id */ }
          }
          if (summaries.get(id)?.needsReview) agent.markReviewed(id).catch(() => {});
          await fillChrome(id);
          const focused = existing === 'primary' ? convo : dock.extras[existing]?.el;
          focused?.focusInput?.();
          return;
        }
      }
      openId = id;
      remember(OPEN_KEY, id);
      if (id) document.body.setAttribute('data-open', 'true');
      else document.body.removeAttribute('data-open');
      if (!id) {
        convo.removeAttribute('conversation');
        dock.extras = [];
        dock.tree = null;
        dock.focus = 'primary';
        rememberDock();
        applyDock();
      } else if (typeof dock.focus === 'number' && dock.extras[dock.focus]) {
        dock.extras[dock.focus].id = id;
        dock.extras[dock.focus].el?.setAttribute('conversation', id);
        rememberDock();
        applyDock();
      } else {
        convo.setAttribute('conversation', id);
        dock.focus = 'primary';
      }
      if (id && !summaries.has(id) && agent) {
        try { upsert((await agent.conversation(id)).meta); } catch { /* opened from a stale id */ }
      }
      if (id && summaries.get(id)?.needsReview) agent.markReviewed(id).catch(() => {});
      paintOpen();
      ensurePrimaryBar();
      if (!id) {
        showEmpty();
        return;
      }
      await fillChrome(id);
      const focused = typeof dock.focus === 'number' ? dock.extras[dock.focus]?.el : convo;
      focused?.focusInput?.();
    }

    const playFlip = (first, ordered) => {
      flipAnims = [];
      ordered.forEach((el, index) => {
        const from = first.get(el);
        if (!from) return;
        const to = el.getBoundingClientRect();
        const dx = from.left - to.left;
        const dy = from.top - to.top;
        const sx = to.width ? from.width / to.width : 1;
        const sy = to.height ? from.height / to.height : 1;
        if (Math.abs(dx) < 0.5 && Math.abs(dy) < 0.5 && Math.abs(sx - 1) < 0.02 && Math.abs(sy - 1) < 0.02) return;
        el.classList.add('marble-flip');
        const anim = el.animate(
          [
            { transform: `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})` },
            { transform: 'none' },
          ],
          {
            duration: FLIP_MS,
            easing: FLIP_EASE,
            delay: Math.min(index, 7) * STAGGER_MS,
            fill: 'both',
          },
        );
        flipAnims.push(anim);
        anim.finished.then(() => {
          el.classList.remove('marble-flip');
          flipAnims = flipAnims.filter((a) => a !== anim);
        }, () => {
          el.classList.remove('marble-flip');
        });
      });
    };

    const setView = (next) => {
      if (!VIEW_ORDER.includes(next)) return;
      remember(VIEW_KEY, next);
      const current = document.body.getAttribute('data-view') || 'library';
      if (current === next) {
        deriveView();
        return;
      }

      const applyLayout = () => {
        document.body.setAttribute('data-view', next);
        deriveView();
        // Focus draws its own panes; every other view draws the stage.
        applyDock();
        if (next === 'library') closeBoardPanel();
        if (current === 'focus' && next !== 'focus') leaveFocusView();
        placeAll();
        paintFocus();
        if (next === 'focus') startFocusDecay();
        else stopFocusDecay();
      };

      const crossfade = () => {
        cancelFlip();
        const gen = ++fadeGen;
        cancelViewFades();
        document.body.setAttribute('data-crossfade', '1');
        const still = reduceMotion.matches;
        const dir = Math.sign(VIEW_ORDER.indexOf(next) - VIEW_ORDER.indexOf(current)) || 1;
        // The pane moves (or is rebuilt in a card) whenever Focus is involved;
        // between List and Folders it stays exactly where it is.
        const paneMoves = current === 'focus' || next === 'focus';
        const nextParts = partsOf(next);
        const outgoing = partsOf(current).filter((el) => !nextParts.includes(el) && !(el === pane && paneMoves));
        const incoming = nextParts.filter((el) => (el === pane && paneMoves) || !partsOf(current).includes(el));
        // Where each leaving part stood, read before the layout changes under it.
        const stood = outgoing.map((el) => [el, el.getBoundingClientRect()]);
        applyLayout();
        // The List shell is hidden outright in Board; its leaving parts need it.
        if (stood.some(([el]) => el === list || el === pane) && next === 'board') libraryEl.classList.add('marble-vt-shell');
        const anims = [];
        const slide = (x) => (still ? {} : { transform: `translate3d(${x}px, 0, 0) scale(.992)` });
        for (const [el, rect] of stood) {
          freeze(el, rect);
          anims.push(el.animate([{ opacity: 1, transform: 'none' }, { opacity: 0, ...slide(-dir * 14) }], {
            duration: still ? 150 : VT_OUT_MS,
            easing: still ? 'linear' : VT_EASE,
            fill: 'both',
          }));
        }
        incoming.forEach((el, index) => {
          anims.push(el.animate([{ opacity: 0, ...slide(dir * 18) }, { opacity: 1, transform: 'none' }], {
            duration: still ? 150 : VT_IN_MS,
            // Offset, not simultaneous: the leaving part clears first, so the
            // page background never shows through the middle of a switch.
            delay: still ? 0 : 70 + index * 50,
            easing: still ? 'linear' : VT_EASE,
            fill: 'both',
          }));
        });
        Promise.all(anims.map((anim) => anim.finished.catch(() => {}))).then(() => {
          if (gen !== fadeGen) return;
          document.body.removeAttribute('data-crossfade');
          for (const anim of anims) anim.cancel();
          thaw();
        });
      };

      if (reduceMotion.matches || narrowView.matches || !isListBoard(current) || !isListBoard(next)) {
        crossfade();
        return;
      }

      // Visual rects include an in-flight transform, so this is current
      // progress. Cancel the old FLIP and retarget from that snapshot —
      // reverse-to-completion would rewind and fight the new layout.
      const first = captureRects();
      const staggerFromBoard = current === 'board' ? boardOrder() : null;
      cancelFlip();
      cancelViewFades();
      applyLayout();
      const ordered = next === 'board' ? boardOrder() : (staggerFromBoard ?? [...list.querySelectorAll('.conv')]);
      playFlip(first, ordered);
    };

    const loadArchived = async () => {
      if (!agent) return;
      try {
        for (const summary of await agent.conversations({ archived: true })) upsert(summary);
      } catch { /* listing failed; the live stream still fills what it can */ }
    };

    const load = async () => {
      if (!agent) return;
      try {
        for (const summary of await agent.conversations()) upsert(summary);
        if (filter === 'archived') await loadArchived();
      } catch { /* same as loadArchived */ }
      applyFilters();
    };

    const setFilter = async (next) => {
      filter = next;
      deriveFilters();
      if (next === 'archived') await loadArchived();
      applyFilters();
    };

    const startNew = async () => {
      if (!agent) {
        showEmpty('This host is not running agents. Restart with MARBLE_DRIVE_AGENTS=1.');
        return;
      }
      if (!labels.size) {
        try {
          for (const provider of await agent.providers()) labels.set(provider.id, provider);
        } catch (err) {
          showEmpty(err.message);
          return;
        }
      }
      const providers = [...labels.values()].filter((p) => p.installed && p.signedIn);
      const preferred = (cli !== 'all' ? providers.find((p) => p.id === cli) : null)
        ?? providers.find((p) => p.default) ?? providers[0];
      if (!preferred) {
        showEmpty('No agent is ready on this machine. npm run agents -- providers says why.');
        return;
      }
      try {
        await open(await agent.start({ provider: preferred.id }));
      } catch (err) {
        showEmpty(err.message);
      }
    };

    viewButtons.forEach((btn) => btn.addEventListener('click', () => setView(btn.dataset.view)));
    filterButtons.forEach((btn) => btn.addEventListener('click', () => setFilter(btn.dataset.filter)));
    narrowView.addEventListener('change', () => {
      if ((document.body.getAttribute('data-view') || 'library') === 'focus') paintFocus();
    });
    cliEl?.addEventListener('click', (event) => {
      const btn = event.target.closest?.('[data-cli]');
      if (btn) setCli(btn.dataset.cli);
    });
    search.addEventListener('input', () => {
      query = search.value.trim().toLowerCase();
      applyFilters();
    });
    document.addEventListener('click', (event) => {
      if (!event.target.closest?.('.manage')) closeRowMenus();
    });
    $('.settings').addEventListener('click', () => window.marble?.agent?.openSettings?.());
    $('.new').addEventListener('click', () => startNew());
    $('.pane .back').addEventListener('click', () => open(null));
    convo.addEventListener('pointerdown', () => {
      if (!dock.extras.length) return;
      dock.focus = 'primary';
      const id = convo.getAttribute('conversation');
      if (!id) return;
      openId = id;
      remember(OPEN_KEY, id);
      rememberDock();
      paintOpen();
      fillChrome(id);
    });
    addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key === 'z' && !event.shiftKey) {
        if (typingIn()) return;
        if (lastFolderGesture?.inverse) {
          event.preventDefault();
          const inverse = lastFolderGesture.inverse;
          lastFolderGesture = null;
          inverse().catch(() => {});
        }
        return;
      }
      if (handleFocusKeys(event)) return;
      if (event.key !== 'v' && event.key !== 'V') return;
      if (event.metaKey || event.ctrlKey || event.altKey) return;
      if (event.repeat) return;
      if (typingIn()) return;
      event.preventDefault();
      const view = document.body.getAttribute('data-view') || 'library';
      setView(nextView(view));
    });

    const restoreOpen = () => {
      // Re-set rather than open(): register runs once at boot with openId
      // still null, and open(null) would wipe marble-agents:open before load
      // restores it. focusInput on restore is a later polish.
      if (openId) document.body.setAttribute('data-open', 'true');
      else document.body.removeAttribute('data-open');
      paintOpen();
      const view = document.body.getAttribute('data-view') || 'library';
      if (view === 'board' && panelOpen) {
        document.body.setAttribute('data-panel', 'open');
      } else {
        document.body.removeAttribute('data-panel');
      }
      restoreDock();
    };

    const restoreDock = () => {
      let fileId = openId;
      dock.extras = [];
      dock.tree = null;
      if (!narrowView.matches && !reduceMotion.matches) {
        const raw = recalled(DOCK_KEY);
        if (raw) {
          try {
            const saved = JSON.parse(raw);
            if (saved.file) fileId = saved.file;
            dock.extras = (saved.extras ?? []).filter(Boolean).map((id) => ({ key: newKey(), id }));
            dock.focus = saved.focus === 'primary' || typeof saved.focus === 'number' ? saved.focus : 'primary';
            if (typeof dock.focus === 'number' && !dock.extras[dock.focus]) dock.focus = 'primary';
            if (saved.tree) {
              const keyOfId = new Map([[fileId, PRIMARY], ...dock.extras.map((extra) => [extra.id, extra.key])]);
              const tree = savedToTree(saved.tree, keyOfId);
              const want = [PRIMARY, ...dock.extras.map((extra) => extra.key)];
              const have = tree ? treeLeaves(tree) : [];
              // A layout that no longer matches its panes is discarded, not repaired.
              if (tree && have.length === want.length && want.every((key) => have.includes(key))) dock.tree = tree;
            }
          } catch {
            dock.extras = [];
            dock.tree = null;
          }
        }
      }
      if (fileId) convo.setAttribute('conversation', fileId);
      else convo.removeAttribute('conversation');
      applyDock();
    };

    const boot = (marble) => {
      // View, pressed chrome, and the open id are this tab's. Filing them
      // would put List|Board, the filter, and which conversation is open
      // into the file for everyone. conversation lives on an addressed
      // <marble-conversation>, so without this a patch strips it and a
      // source.outer of the pane writes it.
      marble.pageOnly?.('data-view', 'aria-pressed', 'conversation', 'data-open', 'data-crossfade', 'data-panel', 'data-dock', 'data-dock-primary', 'data-stack');
      restoreView();
      deriveFilters();
      marble.register?.(() => {
        // pageOnly stops filing data-view; it does not stop syncAttrs copying
        // the file's data-view="library" onto a live board session.
        restoreView();
        placeAll();
        deriveFilters();
        applyFilters();
        restoreOpen();
        // A patch strips the inline geometry the panes are placed by.
        layoutDock();
      });
      const start = async (api) => {
        agent = api;
        let folderPending = null;
        const trackFolderOp = (op) => {
          const pending = Promise.resolve(op()).finally(() => {
            if (folderPending === pending) folderPending = null;
          });
          folderPending = pending;
          return pending;
        };
        const listFolders = api.folders.bind(api);
        const origCreateFolder = api.createFolder.bind(api);
        api.folders = () => (folderPending ? folderPending.then(() => listFolders()) : listFolders());
        api.createFolder = (body) => trackFolderOp(() => origCreateFolder(body));
        try {
          for (const provider of await api.providers()) labels.set(provider.id, provider);
        } catch { /* badges fall back to the provider id */ }
        fillCli();
        // The dot and the pills are styled once, in the runtime, and every
        // view on this page wears that one style.
        if (!document.head.querySelector('style[data-state-css]')) {
          const stateStyle = document.createElement('style');
          stateStyle.setAttribute('data-marble-transient', '');
          stateStyle.setAttribute('data-state-css', '');
          stateStyle.textContent = (window.marbleAgentUI?.TAG_CSS ?? '') + (window.marbleAgentUI?.STATE_CSS ?? '');
          document.head.append(stateStyle);
        }
        api.on('*', (payload) => {
          if (payload?.folders) {
            folderCatalog = payload.folders;
            paintFolderRail();
            repaintRows();
            paintFocus();
            return;
          }
          if (!payload?.id) return;
          // A chat you are already watching does not fall back into Needs
          // review the moment it finishes.
          const prev = summaries.get(payload.id);
          const finished = prev?.running && !payload.running && payload.lastFinishedAt;
          if (finished && payload.needsReview && document.visibilityState === 'visible' && focusedPaneId() === payload.id) {
            api.markReviewed(payload.id).catch(() => {});
            upsert({ ...payload, needsReview: false });
            return;
          }
          upsert(payload);
        });
        await load();
        try {
          const listed = await api.folders();
          folderCatalog = listed.folders ?? [];
          paintFolderRail();
          repaintRows();
        } catch { /* folders unavailable; rail stays empty */ }
        restoreDock();
        const saved = recalled(OPEN_KEY);
        if (saved) await open(saved);
        addEventListener('marble:agent-settings-saved', async () => {
          try {
            for (const provider of await api.providers()) labels.set(provider.id, provider);
          } catch { /* badges fall back to the provider id */ }
          fillCli();
        });
      };
      if (marble.agent) start(marble.agent);
      else addEventListener('marble:agent', (event) => start(event.detail), { once: true });
    };

    if (window.marble) boot(window.marble);
    else {
      restoreView();
      deriveFilters();
      addEventListener('marble:ready', (event) => boot(event.detail), { once: true });
    }
  })();
</script>
<style data-marble-id="rzcss7a1">
  /* Resizable bars and columns.
     A width is a fact, so it is written once — a custom property on the element
     whose layout it describes — and the track, the handle's position and the
     handle's label all derive from that one property. The floors below are a
     guard against a hand-edit that would make the page ungrabbable; the range a
     drag actually offers is in the script. */
  .library {
    position: relative;
    --list-track: max(6rem, var(--list-w, 20rem));
    --rail-track: max(6rem, var(--rail-w, 20rem));
    grid-template-columns: var(--list-track) minmax(0, 1fr);
  }
  .folders {
    position: relative;
    --rail-track: max(6rem, var(--rail-w, 20rem));
  }
  body[data-view="folders"] .folders,
  body[data-view="folders"] .library {
    grid-template-columns: var(--rail-track) minmax(0, 1fr);
  }
  /* The open conversation keeps the proportion it always had until somebody
     drags it, and never takes more of the window than the board can spare —
     a fixed width here collapses the board to nothing on a phone. */
  body { --panel-track: min(var(--panel-w, min(38vw, 28rem)), 78vw); }
  body[data-view="board"][data-panel="open"] {
    grid-template-columns: minmax(0, 1fr) minmax(18rem, var(--panel-track));
  }

  /* The seam itself: a wide invisible grab strip, a hairline that says where
     the edge is, and a grip that says it is a handle before you touch it.
     pointer-events is spelled out because the Folders shell hands them past. */
  .rz {
    position: absolute; top: 0; bottom: 0; width: 12px; z-index: 6;
    transform: translateX(-50%);
    display: none; padding: 0; border: 0; background: none;
    cursor: col-resize; touch-action: none; pointer-events: auto;
  }
  .rz::before, .rz-col::after {
    content: ''; position: absolute; top: 0; bottom: 0; left: 50%; width: 2px;
    transform: translateX(-50%); border-radius: 999px;
    background: var(--accent); opacity: 0;
    transition: opacity var(--t) var(--settle);
  }
  .rz::after {
    content: ''; position: absolute; top: 50%; left: 50%; width: 4px; height: 26px;
    transform: translate(-50%, -50%); border-radius: 999px;
    background: var(--line); opacity: 0;
    transition: opacity var(--t) var(--settle), background var(--t) var(--settle);
  }
  .rz:hover::before, .rz:focus-visible::before, .rz[data-dragging]::before,
  .rz:hover::after, .rz:focus-visible::after, .rz[data-dragging]::after { opacity: 1; }
  .rz[data-dragging]::after { background: var(--accent); }
  .rz:focus-visible, .rz-col:focus-visible { outline: none; }
  body[data-view="library"] .rz-list,
  body[data-view="folders"] .rz-rail,
  body[data-view="board"][data-panel="open"] .rz-panel { display: block; }
  .rz-list { left: var(--list-track); }
  .rz-rail { left: var(--rail-track); }
  .rz-panel { left: 0; }

  /* Board columns share the row, so their widths are shares of it rather than
     pixel sizes — which is what keeps them sane when the window changes. */
  .board { --col-running: 1; --col-review: 1; --col-completed: 1; }
  .board > .column[data-col="running"] { flex-grow: var(--col-running); }
  .board > .column[data-col="review"] { flex-grow: var(--col-review); }
  .board > .column[data-col="completed"] { flex-grow: var(--col-completed); }
  .rz-col {
    flex: 0 0 0px; align-self: stretch; position: relative;
    margin-inline: -.5rem; padding: 0; border: 0; background: none;
    cursor: col-resize; touch-action: none; pointer-events: auto; z-index: 4;
  }
  .rz-col::before {
    content: ''; position: absolute; top: 0; bottom: 0; left: 50%; width: 16px;
    transform: translateX(-50%);
  }
  .rz-col::after { top: .4rem; bottom: .4rem; }
  .rz-col:hover::after, .rz-col:focus-visible::after, .rz-col[data-dragging]::after { opacity: 1; }

  /* While a seam is moving, the whole page is the drag — not the text under it. */
  .marble-resizing, .marble-resizing * { cursor: col-resize !important; user-select: none !important; }
  /* Nothing hovers on a touch screen, so the grips simply stay visible. */
  @media (hover: none) { .rz::after, .rz-col::after { opacity: .55; } }
  /* One column of everything: there is no seam left to drag. */
  @media (max-width: 719px) { .rz, .rz-col { display: none !important; } }
</style>
  <script data-marble-id="rzjs7a1x">
  // Drag the seam beside a bar, or between two board columns. The width is
  // written into the file on release — one op per gesture, never one per frame
  // — so the layout you leave is the layout the next tab opens with.
  (() => {
    const body = document.body;
    const library = document.querySelector('.library');
    const folders = document.querySelector('.folders');
    const board = document.querySelector('.board');
    if (!library || !folders || !board || library.querySelector('.rz-list')) return;

    const MIN_COL = 176;
    const NUDGE = 16;
    const BIG_NUDGE = 48;
    const clamp = (value, low, high) => Math.min(Math.max(low, value), Math.max(low, high));
    const round = (n) => String(Math.round(n * 1000) / 1000);

    // The inline custom properties are the record. Seeded from the file once,
    // so the attribute this composes never depends on the browser's own
    // serialization of what the page has been doing since.
    const carried = new WeakMap();
    const stateOf = (el) => {
      let state = carried.get(el);
      if (state) return state;
      const props = new Map();
      const foreign = [];
      for (const part of (el.getAttribute('style') || '').split(';')) {
        const at = part.indexOf(':');
        if (at < 0) continue;
        const name = part.slice(0, at).trim();
        if (!name) continue;
        const value = part.slice(at + 1).trim();
        if (name.startsWith('--')) props.set(name, value);
        else foreign.push(name + ': ' + value);
      }
      state = { props, foreign };
      carried.set(el, state);
      return state;
    };

    const paint = (el, name, value) => {
      const { props } = stateOf(el);
      if (value == null) {
        props.delete(name);
        el.style.removeProperty(name);
      } else {
        props.set(name, value);
        el.style.setProperty(name, value);
      }
    };

    const file = (el) => {
      const { props, foreign } = stateOf(el);
      const style = [...foreign, ...[...props].map(([name, value]) => name + ': ' + value)].join('; ');
      const id = window.marble?.id?.(el);
      if (!id) return;  // no host: the seams still drag, the page just forgets
      window.marble.op({ type: 'setAttr', id, name: 'style', value: style || null });
    };

    // Two presses close together are the reset. It is read here rather than
    // from a `dblclick` because the `preventDefault` below — which stops the
    // text selection a drag would otherwise smear across the page — also stops
    // the compat mouse events a dblclick is assembled from, so that event
    // never arrives on a seam.
    const DOUBLE_MS = 400;

    const drag = (handle, begin, reset) => {
      // -Infinity, not 0: `timeStamp` counts from the page load, so a first
      // press in the opening moments would otherwise read as a second one.
      let last = -Infinity;
      handle.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        event.preventDefault();
        handle.focus({ preventScroll: true });
        const quick = event.timeStamp - last < DOUBLE_MS;
        last = event.timeStamp;
        if (quick && reset) {
          last = -Infinity;  // a third press starts a fresh pair, not another reset
          reset();
          return;
        }
        const gesture = begin();
        let moved = false;
        handle.setPointerCapture?.(event.pointerId);
        handle.setAttribute('data-dragging', '');
        document.documentElement.classList.add('marble-resizing');
        const move = (e) => { moved = true; gesture.to(e.clientX); };
        const up = (e) => {
          handle.releasePointerCapture?.(e.pointerId);
          handle.removeEventListener('pointermove', move);
          handle.removeEventListener('pointerup', up);
          handle.removeEventListener('pointercancel', up);
          handle.removeAttribute('data-dragging');
          document.documentElement.classList.remove('marble-resizing');
          // A press that never moved is not a resize. Writing the width here
          // would snap the seam to wherever the pointer sat and file that as
          // an edit — including on the first press of a reset.
          if (moved) gesture.done();
        };
        handle.addEventListener('pointermove', move);
        handle.addEventListener('pointerup', up);
        handle.addEventListener('pointercancel', up);
      });
    };

    // A keyboard nudge is a gesture too, but a held arrow key is a hundred of
    // them and the file should hear one.
    const settle = (el) => {
      let timer = null;
      return () => {
        clearTimeout(timer);
        timer = setTimeout(() => file(el), 350);
      };
    };

    const separator = (className, label) => {
      const el = document.createElement('div');
      el.className = className;
      el.setAttribute('data-marble-transient', '');
      el.setAttribute('role', 'separator');
      el.setAttribute('aria-orientation', 'vertical');
      el.setAttribute('tabindex', '0');
      el.setAttribute('aria-label', label);
      el.title = 'Drag to resize · double-click to reset';
      return el;
    };

    // ------------------------------------------------------------- the bars

    const bar = (spec) => {
      const handle = separator('rz ' + spec.className, spec.label);
      const later = settle(body);
      const read = () => spec.read(handle);
      const say = () => {
        const now = Math.round(read());
        handle.setAttribute('aria-valuenow', String(now));
        handle.setAttribute('aria-valuemin', String(Math.round(spec.min())));
        handle.setAttribute('aria-valuemax', String(Math.round(spec.max())));
        handle.setAttribute('aria-valuetext', now + ' pixels wide');
      };
      const put = (px) => {
        paint(body, spec.prop, Math.round(clamp(px, spec.min(), spec.max())) + 'px');
        say();
      };
      const reset = () => {
        paint(body, spec.prop, null);
        file(body);
        say();
      };
      drag(handle, () => ({ to: (clientX) => put(spec.at(clientX)), done: () => file(body) }), reset);
      handle.addEventListener('focus', say);
      handle.addEventListener('keydown', (event) => {
        const step = (event.shiftKey ? BIG_NUDGE : NUDGE) * (spec.sign ?? 1);
        if (event.key === 'ArrowLeft') put(read() - step);
        else if (event.key === 'ArrowRight') put(read() + step);
        else if (event.key === 'Home') { paint(body, spec.prop, null); say(); }
        else return;
        event.preventDefault();
        later();
      });
      spec.host.append(handle);
      return say;
    };

    const bars = [
      bar({
        host: library, className: 'rz-list', label: 'Width of the conversation list',
        prop: '--list-w',
        min: () => 224, max: () => Math.min(innerWidth * 0.5, 704),
        read: (handle) => handle.offsetLeft,
        at: (clientX) => clientX - library.getBoundingClientRect().left,
      }),
      bar({
        host: folders, className: 'rz-rail', label: 'Width of the folder rail',
        prop: '--rail-w',
        min: () => 192, max: () => Math.min(innerWidth * 0.5, 640),
        read: (handle) => handle.offsetLeft,
        at: (clientX) => clientX - folders.getBoundingClientRect().left,
      }),
      bar({
        host: library, className: 'rz-panel', label: 'Width of the open conversation',
        prop: '--panel-w', sign: -1,
        min: () => 288, max: () => Math.min(innerWidth * 0.7, 832),
        read: () => library.getBoundingClientRect().width,
        at: (clientX) => library.getBoundingClientRect().right - clientX,
      }),
    ];

    // ------------------------------------------------------ the board seams

    const columnAt = (col) => board.querySelector('.column[data-col="' + col + '"]');
    const nameOf = (column) => (column.querySelector('h2')?.firstChild?.textContent || column.dataset.col).trim();
    const growOf = (col) => Number(stateOf(board).props.get('--col-' + col)) || 1;

    const seam = (leftCol, rightCol) => {
      const left = columnAt(leftCol);
      const right = columnAt(rightCol);
      if (!left || !right) return null;
      const handle = separator('rz-col', 'Share of the board between ' + nameOf(left) + ' and ' + nameOf(right));
      const later = settle(board);
      const say = () => {
        const total = growOf(leftCol) + growOf(rightCol);
        const pct = Math.round((growOf(leftCol) / total) * 100);
        handle.setAttribute('aria-valuenow', String(pct));
        handle.setAttribute('aria-valuemin', '0');
        handle.setAttribute('aria-valuemax', '100');
        handle.setAttribute('aria-valuetext', pct + '% to ' + nameOf(left));
      };
      // Columns are flex-basis 0, so a width is a share of the pair rather than
      // a pixel count — which is what keeps the board sane when the window moves.
      const share = (width, usable) => {
        if (usable <= MIN_COL * 2) return;
        const total = growOf(leftCol) + growOf(rightCol);
        const grow = total * (clamp(width, MIN_COL, usable - MIN_COL) / usable);
        paint(board, '--col-' + leftCol, round(grow));
        paint(board, '--col-' + rightCol, round(total - grow));
        say();
      };
      const reset = () => {
        paint(board, '--col-' + leftCol, null);
        paint(board, '--col-' + rightCol, null);
        say();
      };
      drag(handle, () => {
        const a = left.getBoundingClientRect();
        const b = right.getBoundingClientRect();
        const gap = Math.max(0, b.left - a.right);
        const usable = a.width + b.width;
        return {
          to: (clientX) => share(clientX - a.left - gap / 2, usable),
          done: () => file(board),
        };
      }, () => { reset(); file(board); });
      handle.addEventListener('focus', say);
      handle.addEventListener('keydown', (event) => {
        const a = left.getBoundingClientRect();
        const usable = a.width + right.getBoundingClientRect().width;
        const step = event.shiftKey ? BIG_NUDGE : NUDGE;
        if (event.key === 'ArrowLeft') share(a.width - step, usable);
        else if (event.key === 'ArrowRight') share(a.width + step, usable);
        else if (event.key === 'Home') reset();
        else return;
        event.preventDefault();
        later();
      });
      board.insertBefore(handle, right);
      return say;
    };

    const seams = [seam('running', 'review'), seam('review', 'completed')].filter(Boolean);
    const announce = () => { for (const say of [...bars, ...seams]) say(); };
    announce();
    addEventListener('resize', announce);
  })();
</script>
</body>
</html>
