<!doctype html>
<html lang="en" data-marble="1">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="marble:capabilities" content="storage; net=none">
<meta name="marble-agent" content="custom">
<title>__TITLE__</title>
__ICON__
<style>
  /* Same tokens as Drive / the drawer: UIST warm in the light, Dusk after dark.
     The Agents file is chrome, so it sits on the off-white paper the Drive uses. */
  :root {
    --ink: #111111;
    --muted: #5a5a5a;
    --faint: #8a8a8a;
    --line: #ddd9cf;
    --paper: #fafaf7;
    --paper-2: #f3f1ea;
    --paper-3: #eceae1;
    --card: #ffffff;
    --card-rgb: 255, 255, 255;
    --paper-rgb: 250, 250, 247;
    --accent: #9bb6cf;
    --accent-soft: #f1f5f8;
    --accent-ink: #738698;
    --accent-ink-rgb: 115, 134, 152;
    --danger: #b4533e;
    --caution: #a07a2c;
    --shadow: 0 1px 3px rgba(74,66,52,.12), 0 4px 8px rgba(74,66,52,.06);
    --shadow-lift: 0 4px 10px rgba(74,66,52,.10), 0 14px 28px rgba(74,66,52,.12);
    --radius: 12px;
    --settle: cubic-bezier(0.22, 0.61, 0.36, 1);
    --snap: cubic-bezier(0.22, 0.61, 0.36, 1);
    --t-fast: 110ms;
    --t: 200ms;
    --t-slow: 340ms;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --ink: #e8e6e1; --muted: #a3a7ab; --faint: #71767a; --line: #2f3438;
      --paper: #16181a; --paper-2: #1e2124; --paper-3: #262a2e; --card: #1c1f22;
      --card-rgb: 28, 31, 34; --paper-rgb: 22, 24, 26;
      --accent: #7fa8c9; --accent-soft: #1d2932; --accent-ink: #9dc0dc; --accent-ink-rgb: 157, 192, 220;
      --danger: #e08a74; --caution: #d9b25e;
      --shadow: 0 1px 3px rgba(0,0,0,.5), 0 4px 8px rgba(0,0,0,.3);
      --shadow-lift: 0 6px 16px rgba(0,0,0,.45), 0 18px 36px rgba(0,0,0,.35);
    }
  }
  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    margin: 0; background: var(--paper); color: var(--ink);
    font: 14px/1.5 "Google Sans", Roboto, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
    display: grid; grid-template-rows: auto minmax(0, 1fr); grid-template-columns: minmax(0, 1fr);
  }
  [data-marble-editable] { outline: none; border-radius: 4px; transition: background var(--t-fast) var(--snap); }
  [data-marble-editable]:hover, [data-marble-editable]:focus-within { background: var(--accent-soft); }
  [data-marble-editable]:focus { background: var(--card); box-shadow: 0 0 0 1px var(--accent), 0 0 0 4px var(--accent-soft); }
  button { font: inherit; }
  button, .conv {
    transition: background var(--t) var(--settle),
      box-shadow var(--t) var(--settle), border-color var(--t) var(--settle), opacity var(--t) var(--settle);
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: .001ms !important; animation-iteration-count: 1 !important;
      transition-duration: .001ms !important; scroll-behavior: auto !important;
    }
    /* Drive zeros every transition. This page's spec is a 150 ms opacity
       crossfade on the two views, so those two have to win. */
    .library, .board, .folders, .focus {
      animation-duration: 150ms !important;
      transition-duration: 150ms !important;
    }
  }

  .topbar {
    grid-row: 1; grid-column: 1 / -1;
    display: flex; align-items: center; gap: .75rem; flex: 0 0 auto; flex-wrap: wrap;
    padding: .55rem 1rem; border-bottom: 1px solid var(--line);
    background: rgba(var(--paper-rgb), .78); backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    position: relative; z-index: 5;
  }
  .topbar h1 { font-size: 1.15rem; font-weight: 500; margin: 0; letter-spacing: -.015em; }
  .toggles {
    display: flex; align-items: center; gap: .35rem; flex: none;
    min-width: 0; flex-wrap: nowrap;
  }
  .seg {
    display: inline-flex; align-items: stretch; flex: none;
    border: 1px solid var(--line); border-radius: 999px;
    padding: 1px; background: var(--paper-3);
  }
  .seg button {
    appearance: none; border: 0; background: none; color: var(--muted);
    padding: .12rem .55rem; cursor: pointer; font-size: .75rem; line-height: 1.25;
    border-radius: 999px; white-space: nowrap; font-weight: 500;
  }
  .seg button:hover, .seg button:focus-visible { color: var(--ink); outline: none; }
  .seg button:active { color: var(--ink); background: var(--paper-2); }
  .seg button[aria-pressed="true"],
  body[data-view="library"] .views [data-view="library"],
  body[data-view="board"] .views [data-view="board"],
  body[data-view="folders"] .views [data-view="folders"],
  body[data-view="focus"] .views [data-view="focus"] {
    color: var(--ink); background: var(--card); box-shadow: var(--shadow);
  }
  input.search {
    flex: 1 1 12rem; min-width: 8rem; max-width: 28rem;
    padding: .45rem .9rem; border: 1px solid transparent; border-radius: 999px;
    background: var(--paper-3); color: var(--ink); font: inherit; outline: none;
    transition: background var(--t) var(--settle), box-shadow var(--t) var(--settle);
  }
  input.search:hover, input.search:focus-visible { background: var(--card); }
  input.search:focus { background: var(--card); border-color: var(--line); box-shadow: var(--shadow); }
  .new {
    appearance: none; border: 1px solid var(--line); background: var(--ink);
    color: var(--paper); padding: .35rem .85rem; border-radius: 999px; cursor: pointer; font-size: .85rem;
  }
  .new:hover, .new:focus-visible { box-shadow: var(--shadow); outline: none; }
  .settings {
    appearance: none; border: 1px solid var(--line); background: none;
    color: var(--muted); padding: .35rem .85rem; border-radius: 999px; cursor: pointer; font-size: .85rem;
  }
  .settings:hover, .settings:focus-visible { color: var(--ink); background: var(--paper-3); outline: none; }
  .usage {
    display: flex; align-items: center; gap: .7rem; min-width: 0;
    margin-left: auto; user-select: none;
  }
  .meter { display: flex; align-items: center; gap: .4rem; min-width: 0; }
  .meter-label {
    font-size: 12.5px; font-weight: 500; color: var(--muted); letter-spacing: -.01em;
  }
  .meter-bar {
    display: block; width: 5.5rem; height: 8px; flex: none;
    border-radius: 999px; background: var(--paper-3);
    box-shadow: inset 0 0 0 1px var(--line); overflow: hidden;
  }
  .meter-bar i {
    display: block; height: 100%; width: 0;
    background: var(--accent-ink); border-radius: inherit;
    transition: width var(--t) var(--settle), background var(--t) var(--settle);
  }
  .meter[data-tone="blue"] .meter-bar i { background: var(--accent-ink); }
  .meter[data-tone="yellow"] .meter-bar i { background: #c4a02a; }
  .meter[data-tone="orange"] .meter-bar i { background: #c46a28; }
  .meter[data-tone="red"] .meter-bar i { background: var(--danger); }
  .meter[data-tone="unavailable"] .meter-label,
  .meter[data-tone="unavailable"] .meter-pct { color: var(--faint); }
  .meter[data-tone="unavailable"] .meter-bar { background: var(--paper-2); }
  .meter[data-tone="unavailable"] .meter-bar i { width: 0 !important; background: var(--faint); }
  .meter-pct {
    font-size: 12.5px; font-weight: 500; font-variant-numeric: tabular-nums;
    color: var(--ink); min-width: 2.35em;
  }
  @media (prefers-color-scheme: dark) {
    .meter[data-tone="yellow"] .meter-bar i { background: #e0c056; }
    .meter[data-tone="orange"] .meter-bar i { background: #e08a4a; }
  }

  .library, .board, .folders, .focus {
    grid-row: 2; grid-column: 1; min-height: 0; min-width: 0;
  }
  .library {
    display: grid; grid-template-columns: minmax(16rem, 22rem) minmax(0, 1fr);
  }
  .folders, .focus { display: none; }
  .folder-rail {
    display: none; min-height: 0; overflow-y: auto; border-right: 1px solid var(--line);
    padding: .4rem 0; background: var(--paper);
  }
  .folder-group[data-color="research"],
  .conv[data-color="research"],
  .focus-card[data-color="research"],
  .focus-basin[data-color="research"] {
    --accent-ink-rgb: 47, 111, 91; --folder: #2f6f5b;
  }
  .folder-group[data-color="fun"],
  .conv[data-color="fun"],
  .focus-card[data-color="fun"],
  .focus-basin[data-color="fun"] {
    --accent-ink-rgb: 196, 92, 62; --folder: #c45c3e;
  }
  .folder-group[data-color="days"],
  .conv[data-color="days"],
  .focus-card[data-color="days"],
  .focus-basin[data-color="days"] {
    --accent-ink-rgb: 77, 106, 88; --folder: #6f8f7d;
  }
  .folder-group[data-color="marble"],
  .conv[data-color="marble"],
  .focus-card[data-color="marble"],
  .focus-basin[data-color="marble"] {
    --accent-ink-rgb: 95, 115, 133; --folder: #7e91a3;
  }
  .folder-group[data-color="travel"],
  .conv[data-color="travel"],
  .focus-card[data-color="travel"],
  .focus-basin[data-color="travel"] {
    --accent-ink-rgb: 61, 107, 138; --folder: #3d6b8a;
  }
  .folder-group[data-color="clay"],
  .conv[data-color="clay"],
  .focus-card[data-color="clay"],
  .focus-basin[data-color="clay"] {
    --accent-ink-rgb: 107, 79, 58; --folder: #6b4f3a;
  }
  .folder-group[data-color="sage"],
  .conv[data-color="sage"],
  .focus-card[data-color="sage"],
  .focus-basin[data-color="sage"] {
    --accent-ink-rgb: 61, 92, 74; --folder: #3d5c4a;
  }
  .folder-group[data-color="mist"],
  .conv[data-color="mist"],
  .focus-card[data-color="mist"],
  .focus-basin[data-color="mist"] {
    --accent-ink-rgb: 61, 90, 112; --folder: #3d5a70;
  }
  .folder-group[data-color="ink"],
  .conv[data-color="ink"],
  .focus-card[data-color="ink"],
  .focus-basin[data-color="ink"] {
    --accent-ink-rgb: 69, 76, 82; --folder: #454c52;
  }
  .folder-group[data-color="gold"],
  .conv[data-color="gold"],
  .focus-card[data-color="gold"],
  .focus-basin[data-color="gold"] {
    --accent-ink-rgb: 109, 86, 48; --folder: #6d5630;
  }
  .folder-group { margin: 0 0 .35rem; position: relative; }
  .folder-header {
    appearance: none; border: 0; background: none; width: 100%;
    display: flex; align-items: center; gap: .45rem; padding: .35rem .75rem;
    font: inherit; font-size: .82rem; font-weight: 500; color: var(--ink); cursor: pointer;
    text-align: left; user-select: none;
  }
  .folder-header:hover, .folder-header:focus-visible { background: var(--paper-3); outline: none; }
  .folder-header:focus-visible { box-shadow: inset 0 0 0 2px var(--accent); }
  .folder-header:active, .folder-tab:active, .folder-new-chat:active { background: var(--paper-2); }
  .folder-group.marble-active .folder-header { background: color-mix(in srgb, var(--folder) 12%, var(--paper)); }
  .folder-tick, .focus-folder {
    appearance: none; border: 0; flex: none; width: .7rem; height: .7rem; border-radius: 3px;
    background: var(--folder, var(--line)); padding: 0; cursor: pointer;
  }
  .folder-tick:active, .focus-folder:active { filter: brightness(.92); }
  .folder-tick:focus-visible, .focus-folder:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .folder-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .folder-name[contenteditable="true"],
  .folder-name[contenteditable="plaintext-only"] {
    overflow: visible; text-overflow: clip; user-select: text; background: var(--card);
    box-shadow: 0 0 0 1px var(--accent); border-radius: 4px; padding: 0 .2rem;
  }
  .folder-palette {
    position: absolute; z-index: 8; display: flex; flex-wrap: wrap; gap: .28rem;
    width: 8.2rem; padding: .4rem; margin: .15rem 0 0 .75rem;
    border: 1px solid var(--line); border-radius: .5rem;
    background: rgba(var(--card-rgb), .92);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    box-shadow: var(--shadow-lift);
  }
  .folder-palette button {
    appearance: none; border: 1px solid transparent; width: 1.05rem; height: 1.05rem;
    border-radius: 4px; padding: 0; cursor: pointer;
  }
  .folder-palette button[aria-pressed="true"] { box-shadow: 0 0 0 2px var(--ink); }
  .folder-palette button[data-color="research"] { background: #2f6f5b; }
  .folder-palette button[data-color="fun"] { background: #c45c3e; }
  .folder-palette button[data-color="days"] { background: #6f8f7d; }
  .folder-palette button[data-color="marble"] { background: #7e91a3; }
  .folder-palette button[data-color="travel"] { background: #3d6b8a; }
  .folder-palette button[data-color="clay"] { background: #6b4f3a; }
  .folder-palette button[data-color="sage"] { background: #3d5c4a; }
  .folder-palette button[data-color="mist"] { background: #3d5a70; }
  .folder-palette button[data-color="ink"] { background: #454c52; }
  .folder-palette button[data-color="gold"] { background: #6d5630; }
  .folder-count { flex: none; font-size: .72rem; color: var(--faint); font-variant-numeric: tabular-nums; }
  .folder-tabs { display: flex; flex-direction: column; gap: 1px; padding: 0 0 .15rem; }
  .folder-tab {
    appearance: none; background: none; width: 100%;
    display: flex; flex-direction: column; gap: 1px;
    padding: .34rem .75rem .34rem 1.55rem; font: inherit; font-size: .8rem;
    color: var(--muted); cursor: pointer; text-align: left;
    overflow: hidden;
    /* The folder's colour on the leading edge, so a tab still reads as a
       member of its group once the header has scrolled away. */
    border: 0; border-left: 2px solid transparent;
  }
  .folder-group .folder-tab { border-left-color: color-mix(in srgb, var(--folder) 45%, transparent); }
  .folder-tab .tab-top { display: flex; align-items: baseline; gap: .38rem; min-width: 0; }
  .folder-tab .tab-title {
    flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .folder-tab .tab-age {
    flex: none; font-size: .68rem; color: var(--faint); font-variant-numeric: tabular-nums;
  }
  .folder-tab .tab-target {
    display: block; font-size: .68rem; color: var(--faint);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    padding-left: .8rem;
  }
  .folder-tab .tab-target:empty { display: none; }
  .folder-tab .tab-dot {
    flex: none; width: 6px; height: 6px; border-radius: 999px;
    background: var(--faint); align-self: center;
  }
  .folder-tab[data-status="running"] .tab-dot { background: var(--accent-ink); }
  .folder-tab[data-status="review"] .tab-dot { background: var(--caution); }
  .folder-tab[data-outcome="failed"] .tab-dot,
  .folder-tab[data-outcome="watchdog"] .tab-dot { background: var(--danger); }
  .folder-tab:hover, .folder-tab:focus-visible { color: var(--ink); background: var(--paper-3); outline: none; }
  .folder-tab.marble-open { color: var(--ink); background: color-mix(in srgb, var(--folder, var(--accent-ink)) 10%, var(--paper)); }
  .folder-ungrouped { margin-top: .25rem; padding-top: .35rem; border-top: 1px solid var(--line); }
  .folder-ungrouped-label {
    padding: .2rem .75rem; font-size: .68rem; font-weight: 500; letter-spacing: .04em;
    text-transform: uppercase; color: var(--faint);
  }
  .folder-new-chat {
    appearance: none; border: 0; background: none; width: 100%;
    padding: .45rem .75rem; margin-top: .15rem; font: inherit; font-size: .8rem;
    color: var(--muted); cursor: pointer; text-align: left;
  }
  .folder-new-chat:hover, .folder-new-chat:focus-visible { color: var(--ink); background: var(--paper-3); outline: none; }
  .folder-tab.marble-selected { color: var(--ink); background: color-mix(in srgb, var(--accent-ink) 8%, var(--paper)); }
  .folder-tab.marble-drop-target, .folder-header.marble-drop-target {
    outline: 2px solid color-mix(in srgb, var(--accent-ink) 40%, transparent);
    outline-offset: -2px;
  }
  .folder-save {
    margin: .5rem .75rem 0; padding: .55rem .65rem; border: 1px solid var(--line);
    border-radius: .45rem; background: var(--paper-2); display: flex; flex-direction: column; gap: .45rem;
  }
  .folder-save input {
    width: 100%; box-sizing: border-box; padding: .35rem .45rem; font: inherit; font-size: .8rem;
    border: 1px solid var(--line); border-radius: .3rem; background: var(--paper);
  }
  .folder-save-confirm, .folder-save-dismiss {
    appearance: none; border: 0; background: none; padding: .3rem 0; font: inherit; font-size: .78rem;
    cursor: pointer; text-align: left;
  }
  .folder-save-confirm { color: var(--accent-ink); font-weight: 500; }
  .folder-save-dismiss { color: var(--muted); }
  .focus-workspace { display: none; }
  .focus {
    position: relative; overflow: auto; background: var(--paper);
  }
  .focus-empty {
    position: absolute; inset: 0; display: grid; place-items: center;
    margin: 0; color: var(--faint); font-size: .88rem; pointer-events: none;
  }
  .focus-card {
    position: absolute; display: flex; flex-direction: column;
    min-width: 0; min-height: 0; overflow: hidden;
    border: 1px solid var(--line); border-radius: 12px;
    background: var(--card); box-shadow: var(--shadow);
    color: var(--ink); touch-action: none;
    will-change: transform;
  }
  .focus-card:active { background: color-mix(in srgb, var(--paper-2) 70%, var(--card)); }
  .focus-card[data-lod="full"] { z-index: 3; }
  .focus-card[data-lod="digest"] { z-index: 2; }
  .focus-card[data-lod="chip"] {
    z-index: 1;
    border-left: 3px solid var(--folder, var(--line));
  }
  .focus-card[data-selected="true"] {
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent-ink) 70%, transparent), var(--shadow-lift);
  }
  .focus-card.marble-dragging { z-index: 10; box-shadow: var(--shadow-lift); }
  .focus-card-head {
    display: flex; align-items: center; gap: .4rem; flex: none;
    padding: .4rem .55rem; min-height: 2.1rem;
    border-bottom: 1px solid var(--line); font-size: .8rem; font-weight: 500;
  }
  .focus-card[data-lod="chip"] .focus-card-head { border-bottom: 0; }
  .focus-card-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .focus-card-model { flex: none; font-size: .68rem; color: var(--faint); max-width: 5rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .focus-card[data-lod="digest"] .focus-card-model,
  .focus-card[data-lod="full"] .focus-card-model { display: none; }
  .focus-card-actions { display: none; flex: none; gap: .2rem; }
  .focus-card[data-lod="digest"]:hover .focus-card-actions,
  .focus-card[data-lod="full"]:hover .focus-card-actions,
  .focus-card:focus-within .focus-card-actions { display: flex; }
  .focus-card[data-lod="chip"] .focus-folder,
  .focus-card[data-lod="chip"] .focus-pin,
  .focus-card[data-lod="chip"] .focus-keep,
  .focus-card[data-lod="chip"] .focus-collapse,
  .focus-card[data-lod="digest"] .focus-collapse { display: none; }
  @media (hover: none) {
    .focus-card .focus-card-actions { display: flex; }
  }
  .focus-folder-menu {
    position: fixed; z-index: 13; display: flex; flex-direction: column;
    min-width: 9.5rem; padding: .3rem;
    border: 1px solid var(--line); border-radius: .5rem;
    background: rgba(var(--card-rgb), .92);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    box-shadow: var(--shadow-lift);
  }
  .focus-folder-menu button {
    appearance: none; border: 0; background: none; text-align: left;
    padding: .32rem .5rem; font: inherit; font-size: .78rem; cursor: pointer;
    border-radius: .3rem; color: var(--ink);
  }
  .focus-folder-menu button:hover, .focus-folder-menu button:focus-visible {
    background: var(--paper-3); outline: none;
  }
  .focus-folder-menu button[aria-pressed="true"] { font-weight: 500; }
  .focus-card-actions button {
    appearance: none; border: 1px solid var(--line); background: var(--paper);
    color: var(--ink); border-radius: 999px; padding: .12rem .45rem;
    font: inherit; font-size: .68rem; cursor: pointer; white-space: nowrap;
  }
  .focus-card-actions button:hover, .focus-card-actions button:focus-visible {
    background: var(--accent-soft); outline: none;
  }
  .focus-card-body {
    flex: 1; min-height: 0; padding: .4rem .6rem .5rem; overflow: hidden;
    display: flex; flex-direction: column; gap: .12rem;
  }
  .focus-card[data-lod="chip"] .focus-card-body,
  .focus-card[data-lod="full"] .focus-card-body { display: none; }
  .focus-card-body p { margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .focus-target { font-size: .72rem; color: var(--faint); letter-spacing: -.005em; }
  .focus-activity { font-size: .78rem; color: var(--ink); }
  .focus-foot {
    margin-top: auto !important; display: flex; align-items: baseline; gap: .4rem;
    font-size: .72rem; color: var(--faint);
  }
  .focus-status { font-weight: 500; color: var(--muted); text-transform: capitalize; }
  .focus-age { font-variant-numeric: tabular-nums; margin-left: auto; }
  /* One status vocabulary across the four views: a running chat is accented,
     a failed one is an alarm, review is a caution. */
  .focus-dot {
    flex: none; width: 7px; height: 7px; border-radius: 999px; background: var(--faint);
  }
  .focus-card[data-status="running"] .focus-dot { background: var(--accent-ink); }
  .focus-card[data-status="running"] .focus-status { color: var(--accent-ink); }
  .focus-card[data-status="review"] .focus-dot { background: var(--caution); }
  .focus-card[data-status="review"] .focus-status { color: var(--caution); }
  .focus-card[data-outcome="failed"] .focus-dot,
  .focus-card[data-outcome="watchdog"] .focus-dot { background: var(--danger); }
  .focus-card[data-outcome="failed"] .focus-status,
  .focus-card[data-outcome="watchdog"] .focus-status { color: var(--danger); }
  .focus-card[data-lod="chip"] .focus-dot { display: none; }
  .focus-live { display: none; flex: 1; min-height: 0; min-width: 0; }
  .focus-card[data-lod="full"] .focus-live { display: block; }
  .focus-card[data-lod="full"] .focus-live marble-conversation { display: block; height: 100%; }
  .focus-basin {
    position: absolute; z-index: 0; pointer-events: none; border-radius: 16px;
    background: color-mix(in srgb, var(--folder) 14%, var(--paper));
    border: 1px solid color-mix(in srgb, var(--folder) 28%, var(--line));
    transition: left var(--t) var(--settle), top var(--t) var(--settle),
      width var(--t) var(--settle), height var(--t) var(--settle);
  }
  /* Loose chats share the basins' geometry so they sit on the same baseline,
     and give up only the fill — the difference says "not filed" without
     making them look dropped on the floor. */
  .focus-basin[data-loose] {
    background: none; border-style: dashed;
    border-color: color-mix(in srgb, var(--line) 80%, transparent);
  }
  .focus-basin[data-loose] .focus-basin-name { color: var(--faint); }
  .focus-basin-name {
    pointer-events: auto; position: absolute; top: .4rem; left: .75rem;
    font-size: .72rem; font-weight: 500; color: var(--folder, var(--muted));
    border: 0; background: none; padding: 0; font: inherit; font-size: .72rem; font-weight: 500;
  }
  .focus-look {
    position: fixed; z-index: 12;
    width: min(28rem, calc(100vw - 2rem)); max-height: 70vh; overflow: auto;
    padding: 1rem 1.1rem; border: 1px solid var(--line); border-radius: 12px;
    background: rgba(var(--card-rgb), .86);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    box-shadow: var(--shadow-lift);
  }
  .focus-look h3 { margin: 0 0 .35rem; font-size: 1rem; font-weight: 500; }
  .focus-look .look-meta { color: var(--muted); font-size: .8rem; margin: 0 0 .75rem; }
  .focus-look .look-events { margin: 0; padding-left: 1.1rem; color: var(--ink); font-size: .85rem; }
  .focus[data-stack] { overflow: auto; display: flex; flex-direction: column; gap: .65rem; padding: .75rem; }
  .focus[data-stack] .focus-card {
    position: relative; left: auto !important; top: auto !important;
    width: auto !important; height: auto !important; flex: none;
  }
  .focus[data-stack] .focus-card[data-lod="full"] { min-height: 18rem; }
  .focus[data-stack] .focus-card[data-lod="digest"] { min-height: 7rem; }
  .focus[data-stack] .focus-basin { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .focus-card, .focus-look {
      animation-duration: 150ms !important;
      transition-duration: 150ms !important;
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .topbar, .focus-look, .folder-palette, .focus-folder-menu {
      background: var(--card);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
  body[data-view="board"] .library,
  body[data-view="focus"] .board,
  body[data-view="focus"] .folders { display: none; }
  body[data-view="focus"] .library {
    display: block; background: transparent; pointer-events: none; overflow: visible;
  }
  body[data-view="focus"] .library #list { display: none; }
  body[data-view="focus"] .library .pane { pointer-events: auto; }
  body[data-view="focus"] .dock-bar,
  body[data-view="focus"] .dock-gutter,
  body[data-view="focus"] .dock-extras,
  body[data-view="focus"] .pane-hint,
  body[data-view="focus"] .pane > .back {
    display: none !important;
  }
  body[data-view="focus"] .pane {
    grid-template-rows: minmax(0, 1fr);
    background: var(--card);
  }
  body[data-view="library"] .board,
  body[data-view="library"] .folders,
  body[data-view="library"] .focus { display: none; }
  body[data-view="board"] .folders,
  body[data-view="board"] .focus { display: none; }
  body[data-view="folders"] .board,
  body[data-view="folders"] .focus { display: none; }
  body[data-view="folders"] .folders,
  body[data-view="folders"] .library {
    display: grid; grid-template-columns: minmax(16rem, 22rem) minmax(0, 1fr);
  }
  body[data-view="folders"] .folders { pointer-events: none; }
  body[data-view="folders"] .library #list { display: none; }
  body[data-view="folders"] .library .pane { grid-column: 2; }
  body[data-view="folders"] .folder-rail { display: block; grid-column: 1; pointer-events: auto; }
  body[data-view="focus"] .focus { display: block; }
  body[data-crossfade] .library { display: grid; }
  body[data-crossfade] .board { display: flex; }
  body[data-crossfade] .folders { display: grid; }
  body[data-crossfade] .focus { display: grid; }
  /* Board + an open conversation is a split: kanban left, pane right.
     Do not reparent <marble-conversation> — a missing keyed child in .pane
     is cloned on reconcile. */
  body[data-view="board"][data-panel="open"] {
    grid-template-columns: minmax(0, 1fr) minmax(18rem, min(38vw, 28rem));
  }
  body[data-view="board"][data-panel="open"] .board {
    grid-column: 1; grid-row: 2; min-width: 0;
  }
  body[data-view="board"][data-panel="open"] .library {
    display: grid;
    grid-column: 2; grid-row: 2;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    background: var(--card);
    border-left: 1px solid var(--line);
    min-width: 0;
    z-index: 2;
  }
  body[data-view="board"][data-panel="open"] .list { display: none; }
  body[data-view="board"][data-panel="open"] .pane {
    grid-column: 1; grid-row: 1; min-width: 0; max-width: none;
    box-shadow: none; border-radius: 0; padding-top: 0; overflow: hidden;
  }
  .board {
    display: flex; align-items: stretch; gap: 1rem; padding: 1rem;
    overflow: hidden; position: relative; min-height: 0;
  }
  /* Columns are the full height of the board and scroll in place. A board that
     scrolls as one leaves a short column trailing dead space beside a long one
     that has run off the bottom of the window. */
  .column {
    flex: 1 1 0; min-width: 14rem; min-height: 0; display: flex; flex-direction: column; gap: .5rem;
    background: var(--paper-2); border: 1px solid var(--line); border-radius: var(--radius); padding: .7rem;
    overflow-y: auto; overscroll-behavior: contain;
  }
  .column h2 {
    position: sticky; top: -.7rem; z-index: 1;
    display: flex; align-items: center; gap: .4rem;
    margin: -.7rem -.7rem 0; padding: .7rem .7rem .4rem;
    background: var(--paper-2);
    font-size: .75rem; font-weight: 500; letter-spacing: .06em;
    text-transform: uppercase; color: var(--faint);
  }
  .col-count {
    margin-left: auto; font-size: .72rem; letter-spacing: 0; color: var(--faint);
    font-variant-numeric: tabular-nums;
  }
  .col-count:empty { display: none; }
  /* No JS "is this column empty" flag to keep in sync — :has() derives it
     straight from the DOM, which is the one place the fact already lives. */
  .column:not(:has(> .conv:not([hidden])))::after {
    content: 'Nothing here'; font-size: .82rem; color: var(--faint); padding: .1rem .05rem;
  }
  .column .conv {
    border-radius: 10px; background: var(--card); border: 1px solid var(--line);
    padding: .65rem .75rem;
  }
  .conv.marble-flip,
  .conv.marble-flip:active {
    transition: none !important;
    transform-origin: 0 0;
    z-index: 6;
    pointer-events: none;
  }
  .board-panel {
    position: absolute; top: 0; right: 0; width: auto; max-width: 100%;
    display: none; z-index: 9;
  }
  .board-panel[data-open="true"] { display: block; }
  .board-panel .panel-close {
    appearance: none; border: 0; background: rgba(var(--card-rgb), .9); backdrop-filter: blur(8px);
    color: var(--muted); width: 2rem; height: 2rem; margin: .6rem; border-radius: 999px;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    pointer-events: auto; box-shadow: var(--shadow);
  }
  .board-panel .panel-close:hover, .board-panel .panel-close:focus-visible {
    color: var(--ink); outline: none;
  }

  .list {
    min-height: 0; overflow-y: auto; border-right: 1px solid var(--line);
    padding: .4rem 0; background: var(--paper);
  }
  .conv {
    display: grid; grid-template-columns: 10px minmax(0, 1fr) auto auto; gap: .65rem; align-items: start;
    width: 100%; text-align: left; appearance: none; border: 0; background: none;
    color: inherit; padding: .55rem .9rem; cursor: pointer; border-radius: 0;
  }
  .conv:hover, .conv:focus-visible { background: var(--paper-3); outline: none; }
  .conv.marble-open { background: var(--accent-soft); }
  /* Folder colour on the leading edge, the same 2px rule the rail tab uses, so
     a row is recognisable as a member of its group in List and Board too. */
  .conv { border-left: 2px solid transparent; }
  .conv[data-color] { border-left-color: color-mix(in srgb, var(--folder) 45%, transparent); }
  /* An author-level `display: grid` above beats the UA [hidden] rule, so a
     filtered-out row stays fully visible unless this re-asserts it. */
  .conv[hidden] { display: none; }
  .conv .dot {
    width: 8px; height: 8px; margin-top: .42rem; border-radius: 999px; background: var(--faint);
    flex: none;
  }
  .conv[data-status="running"] .dot {
    background: var(--accent-ink); box-shadow: 0 0 0 3px rgba(var(--accent-ink-rgb), .18);
    animation: pulse 1.2s var(--snap) infinite;
  }
  .conv[data-status="review"] .dot { background: var(--caution); }
  /* A failed or watchdog-flagged turn is not merely "worth a look" like a
     normal change set — it needs the same alarm color the turn footer uses. */
  .conv[data-status="review"][data-outcome="failed"] .dot,
  .conv[data-status="review"][data-outcome="watchdog"] .dot {
    background: var(--danger); box-shadow: 0 0 0 3px rgba(var(--accent-ink-rgb), 0);
    animation: none;
  }
  /* Four facts, three lines: the agent's name shares the last line with the
     activity instead of claiming a row of its own. */
  .conv .body {
    min-width: 0; display: grid; align-items: baseline;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas: "title title" "target target" "tags meta";
    gap: .1rem .4rem;
  }
  .conv .title { grid-area: title; }
  .conv .target { grid-area: target; }
  .conv .tags { grid-area: tags; }
  .conv .meta { grid-area: meta; }
  .conv .title { font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .conv .target {
    font-size: .72rem; color: var(--faint);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .conv .target:empty { display: none; }
  .conv .tags:empty { display: none; }
  .conv .tags { display: flex; flex-wrap: wrap; gap: 4px; }
  /* The agent's name is the same on every row of a one-agent drive, so it is
     context rather than a headline. It keeps its place — which conversation
     ran on which CLI is worth knowing — but gives up the filled pill that made
     it the loudest thing in the list. */
  .conv .tag[data-kind="agent"] {
    background: none !important; color: var(--faint) !important;
    padding: 2px 0; font-weight: 400;
  }
  .conv .tag[data-kind="agent"] + .tag::before {
    content: '·'; color: var(--faint); margin-right: 4px;
  }
  .conv .tag {
    display: inline-flex; align-items: center; font-size: 11px; line-height: 1.3; font-weight: 500;
    padding: 2px 8px; border-radius: 999px; max-width: 100%;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .conv .tag[data-hue="0"] { background: #e4edf4; color: #3d5a70; }
  .conv .tag[data-hue="1"] { background: #f0e6dc; color: #6b4f3a; }
  .conv .tag[data-hue="2"] { background: #e4efe8; color: #3d5c4a; }
  .conv .tag[data-hue="3"] { background: #f3ead8; color: #6d5630; }
  .conv .tag[data-hue="4"] { background: #eee4ee; color: #5c4560; }
  .conv .tag[data-hue="5"] { background: #e6e8ea; color: #454c52; }
  @media (prefers-color-scheme: dark) {
    .conv .tag[data-hue="0"] { background: #243038; color: #9dc0dc; }
    .conv .tag[data-hue="1"] { background: #322820; color: #e0c4a8; }
    .conv .tag[data-hue="2"] { background: #1f2c26; color: #a8c9b6; }
    .conv .tag[data-hue="3"] { background: #322c1e; color: #d9c08a; }
    .conv .tag[data-hue="4"] { background: #2c2430; color: #c8b0c8; }
    .conv .tag[data-hue="5"] { background: #26282a; color: #b4b8bc; }
  }
  .conv .meta { display: flex; gap: .35rem; min-width: 0; color: var(--muted); font-size: .78rem; }
  .conv .meta > * { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* Provider is almost always the same one agent, so it rides in the meta
     line as plain text rather than competing for attention as its own pill. */
  .conv .badge { flex: none; max-width: 6em; }
  .conv .badge:not(:empty)::after { content: '\00b7'; margin-left: .35rem; color: var(--faint); }
  .conv .activity { flex: 1 1 auto; }
  .conv .age { flex: none; font-size: .75rem; color: var(--faint); padding-top: .15rem; }
  .conv .manage { position: relative; flex: none; }
  .conv .manage .more {
    appearance: none; border: 0; background: none; color: var(--faint); cursor: pointer;
    width: 28px; height: 28px; margin: -.25rem -.35rem 0 0; border-radius: 8px;
    display: grid; place-items: center;
  }
  .conv .manage .more:hover, .conv .manage .more:focus-visible { color: var(--ink); background: var(--paper-3); outline: none; }
  .conv .manage .more[aria-expanded="true"] { color: var(--ink); background: var(--paper-3); }
  .conv .manage .menu {
    position: absolute; right: 0; top: calc(100% + 4px); z-index: 8; min-width: 11.5rem;
    background: var(--card); border: 1px solid var(--line); border-radius: 10px;
    box-shadow: var(--shadow-lift); padding: 4px;
  }
  .conv .manage .menu button {
    display: block; width: 100%; text-align: left; appearance: none; border: 0; background: none;
    color: var(--ink); font: inherit; font-size: .82rem; padding: .4rem .65rem; border-radius: 8px; cursor: pointer;
  }
  .conv .manage .menu button:hover, .conv .manage .menu button:focus-visible { background: var(--paper-2); outline: none; }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(var(--accent-ink-rgb), .12); }
    50% { box-shadow: 0 0 0 5px rgba(var(--accent-ink-rgb), .28); }
  }

  .pane {
    position: relative; min-width: 0; min-height: 0;
    display: grid; grid-template-rows: auto minmax(0, 1fr); grid-template-columns: minmax(0, 1fr);
    background: var(--card);
  }
  .pane[data-dock="row"] {
    grid-template-columns: var(--dock-a, 1fr) 5px var(--dock-b, 1fr);
    grid-template-rows: auto minmax(0, 1fr);
  }
  .pane[data-dock="col"] {
    grid-template-rows: auto var(--dock-a, 1fr) 5px var(--dock-b, 1fr);
    grid-template-columns: minmax(0, 1fr);
  }
  .pane[data-dock="col"][data-dock-primary="end"] {
    grid-template-rows: var(--dock-a, 1fr) 5px auto var(--dock-b, 1fr);
  }
  .pane > .dock-bar { grid-column: 1; grid-row: 1; min-width: 0; }
  .pane > marble-conversation:not([data-marble-transient]) {
    grid-column: 1; grid-row: 2; min-width: 0; min-height: 0;
  }
  .pane[data-dock="row"] > .dock-bar { grid-column: 1; grid-row: 1; }
  .pane[data-dock="row"] > marble-conversation:not([data-marble-transient]) { grid-column: 1; grid-row: 2; }
  .pane[data-dock="row"][data-dock-primary="end"] > .dock-bar { grid-column: 3; }
  .pane[data-dock="row"][data-dock-primary="end"] > marble-conversation:not([data-marble-transient]) { grid-column: 3; }
  .pane[data-dock="col"] > .dock-bar { grid-row: 1; grid-column: 1; }
  .pane[data-dock="col"] > marble-conversation:not([data-marble-transient]) { grid-row: 2; grid-column: 1; }
  .pane[data-dock="col"][data-dock-primary="end"] > .dock-bar { grid-row: 3; }
  .pane[data-dock="col"][data-dock-primary="end"] > marble-conversation:not([data-marble-transient]) { grid-row: 4; }
  .dock-gutter { background: var(--line); cursor: col-resize; z-index: 2; }
  .pane[data-dock="row"] > .dock-gutter { grid-column: 2; grid-row: 1 / -1; }
  .pane[data-dock="col"] > .dock-gutter { grid-row: 3; grid-column: 1; cursor: row-resize; }
  .pane[data-dock="col"][data-dock-primary="end"] > .dock-gutter { grid-row: 2; }
  .dock-extras { min-width: 0; min-height: 0; display: flex; flex-direction: column; }
  .pane[data-dock="row"] > .dock-extras { grid-column: 3; grid-row: 1 / -1; }
  .pane[data-dock="row"][data-dock-primary="end"] > .dock-extras { grid-column: 1; }
  .pane[data-dock="col"] > .dock-extras { grid-row: 4; grid-column: 1; }
  .pane[data-dock="col"][data-dock-primary="end"] > .dock-extras { grid-row: 1; }
  .dock-leaf { flex: 1; min-height: 0; min-width: 0; display: flex; flex-direction: column; position: relative; }
  .dock-leaf + .dock-leaf { border-top: 1px solid var(--line); }
  .dock-leaf marble-conversation { flex: 1; min-height: 0; height: 100%; }
  .dock-bar {
    display: flex; align-items: center; gap: .45rem;
    min-height: 2.15rem; padding: .2rem .45rem .2rem .55rem;
    border-bottom: 1px solid var(--line); background: var(--paper-2);
    cursor: grab; user-select: none; min-width: 0;
  }
  .dock-bar:active { cursor: grabbing; }
  .dock-bar.marble-drop-swap { background: var(--accent-soft); box-shadow: inset 0 0 0 1px var(--accent); }
  .dock-grip { flex: none; color: var(--faint); }
  .dock-title {
    flex: 1; min-width: 0; font-size: 12.5px; font-weight: 500; letter-spacing: -.01em;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .dock-target {
    flex: none; max-width: 9rem; font-size: 11.5px; color: var(--accent-ink);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-decoration: none;
  }
  .dock-target:hover, .dock-target:focus-visible { color: var(--ink); outline: none; }
  .dock-target[hidden] { display: none; }
  .dock-close {
    appearance: none; border: 0; background: none; flex: none;
    color: var(--muted); width: 1.55rem; height: 1.55rem; border-radius: 8px; cursor: pointer;
    display: grid; place-items: center;
  }
  .dock-close:hover, .dock-close:focus-visible { color: var(--ink); background: var(--paper-3); outline: none; }
  body:not([data-open]) .pane > .dock-bar { display: none; }
  .dock-card {
    position: fixed; z-index: 40; pointer-events: none; width: 16.5rem;
    padding: .65rem .8rem; background: var(--card); border: 1px solid var(--line);
    border-radius: 12px; box-shadow: var(--shadow-lift);
  }
  .dock-card .dock-title { display: block; font-size: 13px; font-weight: 500; }
  .dock-card .dock-target { display: block; max-width: none; color: var(--muted); margin-top: .15rem; }
  .pane.marble-drop-right::after, .pane.marble-drop-left::after,
  .pane.marble-drop-top::after, .pane.marble-drop-bottom::after {
    content: ''; position: absolute; z-index: 6; pointer-events: none;
    background: rgba(var(--accent-ink-rgb), .16);
    transition: opacity 160ms ease-out;
  }
  .pane.marble-drop-right::after { top: 0; right: 0; bottom: 0; width: 22%; }
  .pane.marble-drop-left::after { top: 0; left: 0; bottom: 0; width: 22%; }
  .pane.marble-drop-top::after { top: 0; left: 0; right: 0; height: 22%; }
  .pane.marble-drop-bottom::after { bottom: 0; left: 0; right: 0; height: 22%; }
  .pane marble-conversation { min-height: 0; }
  /* The composer is always live — even with nothing picked, typing below
     starts a conversation — so the hint sits above it, not over it. */
  .pane-hint {
    position: absolute; inset: 0; bottom: 6.5rem; display: none; z-index: 1;
    flex-direction: column; align-items: center; justify-content: center; gap: .6rem;
    color: var(--faint); text-align: center; padding: 0 2rem; pointer-events: none;
  }
  .pane-hint p { margin: 0; font-size: .88rem; max-width: 22rem; }
  body:not([data-open]) .pane-hint { display: flex; }
  .pane .back {
    display: none; position: absolute; top: .6rem; left: .6rem; z-index: 2;
    appearance: none; border: 0; background: rgba(var(--paper-rgb), .85); backdrop-filter: blur(8px);
    color: var(--ink); width: 2rem; height: 2rem; border-radius: 999px; cursor: pointer;
    align-items: center; justify-content: center; box-shadow: var(--shadow);
  }
  .pane .back:hover, .pane .back:focus-visible { background: var(--card); outline: none; }

  @media (max-width: 719px) {
    /* Title + segmented bars + New stay on the first wrap; search gets
       its own row. The three bars scroll sideways if they cannot fit. */
    .topbar { row-gap: .5rem; padding: .5rem .75rem; }
    .topbar h1 { order: 1; font-size: 1.05rem; }
    .toggles { order: 2; flex: 1 1 auto; min-width: 0; overflow-x: auto; -webkit-overflow-scrolling: touch; padding-bottom: 1px; }
    .usage { order: 3; margin-left: auto; }
    .settings { order: 3; }
    .new { order: 4; }
    input.search { order: 5; flex-basis: 100%; }

    /* One pane at a time, not three squeezed into one screen. The library
       shows the list; opening a row swaps it for the conversation (with a
       back button) and its details, scrolling together. */
    .library { display: block; overflow-y: auto; }
    .list { border-right: 0; max-height: none; height: 100%; }
    .pane { display: none; }
    body[data-open] .list { display: none; }
    body[data-open] .filters { display: none; }
    body[data-open] .pane { display: grid; height: 65vh; min-height: 22rem; }
    body[data-open]:not([data-panel="open"]) .pane .back { display: flex; }
    .pane-hint { bottom: 7.5rem; }

    .board { scroll-snap-type: x mandatory; }
    .column { flex: 0 0 min(20rem, 85vw); scroll-snap-align: start; }
    .board-panel { width: auto; }
    body[data-view="board"][data-panel="open"] {
      grid-template-columns: minmax(0, 1fr);
    }
    body[data-view="board"][data-panel="open"] .board {
      display: flex; grid-column: 1; height: 0; min-height: 0; padding: 0; overflow: visible;
      pointer-events: none;
    }
    body[data-view="board"][data-panel="open"] .column { display: none; }
    body[data-view="board"][data-panel="open"] .board-panel { pointer-events: auto; }
    body[data-view="board"][data-panel="open"] .library {
      grid-column: 1; grid-template-columns: minmax(0, 1fr);
    }
    body[data-view="board"][data-panel="open"] .pane { height: auto; }
  }
  @media (hover: none) {
    .conv, .seg button, .new, .settings, .conv .manage .more, .panel-close { min-height: 2.75rem; }
  }
</style>
</head>
<body data-marble-id="__ID__" data-view="library">

<header class="topbar" data-marble-id="__ID__">
  <h1 data-marble-id="__ID__" data-marble-editable>__TITLE__</h1>
  <div class="toggles" data-marble-id="__ID__">
    <div class="seg views" role="group" aria-label="View" data-marble-id="__ID__">
      <button type="button" data-view="library" aria-pressed="true" data-marble-id="__ID__">List</button>
      <button type="button" data-view="board" aria-pressed="false" data-marble-id="__ID__">Board</button>
      <button type="button" data-view="folders" aria-pressed="false" data-marble-id="__ID__">Folders</button>
      <button type="button" data-view="focus" aria-pressed="false" data-marble-id="__ID__">Focus</button>
    </div>
    <div class="seg cli" role="group" aria-label="CLI" data-marble-transient></div>
    <div class="seg filters" role="group" aria-label="Filter" data-marble-id="__ID__">
      <button type="button" class="filter" data-filter="all" aria-pressed="true" data-marble-id="__ID__">All</button>
      <button type="button" class="filter" data-filter="running" aria-pressed="false" data-marble-id="__ID__">Running</button>
      <button type="button" class="filter" data-filter="review" aria-pressed="false" data-marble-id="__ID__">Review</button>
      <button type="button" class="filter" data-filter="archived" aria-pressed="false" data-marble-id="__ID__">Archived</button>
    </div>
  </div>
  <input class="search" type="search" placeholder="Search conversations" autocomplete="off" aria-label="Search conversations" data-marble-id="__ID__">
  <div class="usage" data-marble-transient role="group" aria-label="Usage remaining"></div>
  <button type="button" class="settings" data-marble-id="__ID__">Settings</button>
  <button type="button" class="new" data-marble-id="__ID__">New</button>
</header>

<div class="library" data-marble-id="__ID__">
  <div id="list" class="list" role="list" data-marble-id="__ID__" data-marble-transient></div>
  <section class="pane" data-marble-id="__ID__">
    <button type="button" class="back" data-marble-id="__ID__" aria-label="Back to conversations">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <div class="pane-hint" data-marble-transient>
      <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="1.4" opacity=".35"/><path d="M10 17c2.5 4 9.5 4 12 0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      <p>Pick a conversation, or ask below to start one.</p>
    </div>
    <marble-conversation data-marble-id="__ID__" data-chrome="pane"></marble-conversation>
  </section>
</div>

<div class="board" data-marble-id="__ID__">
  <section class="column" data-col="running" data-marble-id="__ID__" data-marble-transient>
    <h2 data-marble-id="__ID__">Running</h2>
  </section>
  <section class="column" data-col="review" data-marble-id="__ID__" data-marble-transient>
    <h2 data-marble-id="__ID__">Needs review</h2>
  </section>
  <section class="column" data-col="completed" data-marble-id="__ID__" data-marble-transient>
    <h2 data-marble-id="__ID__">Completed</h2>
  </section>
  <div class="board-panel" data-marble-id="__ID__">
    <button type="button" class="panel-close" data-marble-id="__ID__" aria-label="Close">
      <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true"><path d="M5 5l10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
  </div>
</div>

<div class="folders" data-marble-id="__ID__">
  <aside class="folder-rail" data-marble-id="__ID__" aria-label="Folders"></aside>
</div>

<div class="focus" data-marble-id="__ID__">
  <section class="focus-workspace" data-marble-id="__ID__">
    <h2 data-marble-id="__ID__">Focus</h2>
  </section>
</div>

<script>
  // The Agents library. Rows, the open id, the filter and the search are the
  // page's — never ops — so browsing does not rewrite this file. View and the
  // open conversation are the two facts that should survive a reload, and the
  // spec puts those in localStorage rather than in the document.
  (() => {
    const VIEW_KEY = 'marble-agents:view';
    const OPEN_KEY = 'marble-agents:open';
    const DOCK_KEY = 'marble-agents:dock';
    const CLI_KEY = 'marble-agents:cli';

    const recalled = (key) => {
      try { return localStorage.getItem(key); } catch { return null; }
    };
    const remember = (key, value) => {
      try {
        if (value == null) localStorage.removeItem(key);
        else localStorage.setItem(key, value);
      } catch { /* private browsing — the page still works; it just forgets */ }
    };

    const VIEW_ORDER = ['library', 'board', 'folders', 'focus'];

    const restoreView = () => {
      const savedView = recalled(VIEW_KEY);
      if (VIEW_ORDER.includes(savedView)) document.body.setAttribute('data-view', savedView);
      deriveView();
    };

    const $ = (sel) => document.querySelector(sel);
    const list = $('#list');
    const libraryEl = $('.library');
    const boardEl = $('.board');
    const foldersEl = $('.folders');
    const folderRail = $('.folder-rail');
    const focusEl = $('.focus');
    const convo = $('marble-conversation');
    const pane = $('.pane');
    const boardPanel = $('.board-panel');
    const search = $('input.search');
    const viewButtons = [...document.querySelectorAll('.views [data-view]')];
    const filterButtons = [...document.querySelectorAll('button.filter')];
    const cliEl = $('.cli');
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const narrowView = matchMedia('(max-width: 719px)');
    const FLIP_MS = 420;
    const FLIP_EASE = 'ease-out';
    const STAGGER_MS = 18;
    // The one curve the whole page eases on. Web Animations defaults to
    // linear when `easing` is omitted, which is what the view switch used to
    // ship — name it here so no call site can forget it again.
    const VIEW_MS = 200;
    const VIEW_EASE = 'cubic-bezier(0.22, 0.61, 0.36, 1)';

    const summaries = new Map();
    const nodes = new Map();
    const labels = new Map();
    const targets = new Map();
    let agent = null;
    let filter = 'all';
    let cli = recalled(CLI_KEY) || 'all';
    let query = '';
    let openId = null;
    let panelOpen = false;
    let flipAnims = [];
    let fadeGen = 0;
    let dock = { dir: 'row', primary: 'start', extras: [], sizes: [0.58, 0.42], focus: 'primary' };
    let suppressConvClick = false;

    const statusOf = (summary) => {
      if (summary?.running || summary?.status === 'running' || summary?.queued) return 'running';
      if (summary?.needsReview) return 'review';
      return 'completed';
    };

    const age = (t) => {
      if (!t) return '';
      const s = Math.max(0, (Date.now() - t) / 1000);
      // Under a minute rounded to '0m', which read as a broken clock on every
      // freshly touched row.
      if (s < 45) return 'now';
      if (s < 3600) return Math.max(1, Math.round(s / 60)) + 'm';
      if (s < 86400) return Math.round(s / 3600) + 'h';
      return Math.round(s / 86400) + 'd';
    };

    /** True when every loaded conversation runs the same agent, so naming it on
     *  each row would repeat one word down the whole list. */
    const soloProvider = () => {
      const seen = new Set();
      for (const summary of summaries.values()) {
        if (summary.provider) seen.add(summary.provider);
        if (seen.size > 1) return false;
      }
      return true;
    };

    /** The last two path segments, extension dropped. A full drive path is too
     *  long for a card, and its head repeats the folder the card already sits
     *  in; the tail is the part that tells two rows apart. */
    const tailOfTarget = (path) => {
      if (!path) return '';
      const parts = String(path).split('/').filter(Boolean);
      const tail = parts.slice(-2);
      if (!tail.length) return '';
      tail[tail.length - 1] = tail[tail.length - 1].replace(/\.(mrbl|md|js|json|txt|html|css)$/i, '');
      return tail.join('/');
    };

    const deriveView = () => {
      const view = document.body.getAttribute('data-view') || 'library';
      for (const btn of viewButtons) btn.setAttribute('aria-pressed', String(btn.dataset.view === view));
    };

    const deriveFilters = () => {
      for (const btn of filterButtons) btn.setAttribute('aria-pressed', String(btn.dataset.filter === filter));
    };

    const deriveCli = () => {
      if (!cliEl) return;
      for (const btn of cliEl.querySelectorAll('[data-cli]')) {
        btn.setAttribute('aria-pressed', String(btn.dataset.cli === cli));
      }
    };

    const fillCli = () => {
      if (!cliEl) return;
      const order = ['claude-subscription', 'cursor', 'claude-api'];
      const ready = [...labels.values()]
        .filter((provider) => provider.installed && provider.signedIn)
        .sort((a, b) => {
          const rank = (id) => {
            const index = order.indexOf(id);
            return index < 0 ? order.length + 1 : index;
          };
          return rank(a.id) - rank(b.id) || String(a.id).localeCompare(String(b.id));
        });
      if (cli !== 'all' && !ready.some((provider) => provider.id === cli)) cli = 'all';
      cliEl.replaceChildren();
      const add = (id, label) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.dataset.cli = id;
        btn.setAttribute('aria-pressed', String(cli === id));
        btn.textContent = label;
        cliEl.append(btn);
      };
      add('all', 'All');
      for (const provider of ready) add(provider.id, provider.label);
    };

    const setCli = (next) => {
      cli = next || 'all';
      remember(CLI_KEY, cli === 'all' ? null : cli);
      deriveCli();
      applyFilters();
    };

    const matches = (summary) => {
      if (!summary) return false;
      const status = statusOf(summary);
      if (filter === 'archived') {
        if (!summary.archived) return false;
      } else {
        if (summary.archived) return false;
        if (filter === 'running' && status !== 'running') return false;
        if (filter === 'review' && status !== 'review') return false;
      }
      if (query) {
        const tags = (window.marbleAgentUI?.conversationTags?.(summary, labels) ?? []).map((tag) => tag.label);
        const hay = [summary.title, summary.activity, summary.target, summary.model, summary.effort, summary.provider, ...tags].filter(Boolean).join(' ').toLowerCase();
        if (!hay.includes(query)) return false;
      }
      if (cli !== 'all' && summary.provider !== cli) return false;
      return true;
    };

    const applyFilters = () => {
      for (const [id, el] of nodes) el.hidden = !matches(summaries.get(id));
      paintFolderRail();
      paintFocus();
      paintColumnCounts();
    };

    /** The folder catalog arrives after the first listing has already painted
     *  every row, so anything a row draws from it — its colour — has to be
     *  asked for again once the catalog lands. */
    const repaintRows = () => {
      for (const [id, el] of nodes) {
        const summary = summaries.get(id);
        if (summary) paintRow(el, summary);
      }
    };

    const paintOpen = () => {
      for (const el of nodes.values()) el.classList.toggle('marble-open', el.dataset.id === openId);
      for (const tab of folderRail?.querySelectorAll('.folder-tab') ?? []) {
        tab.classList.toggle('marble-open', tab.dataset.id === openId);
      }
    };

    const FULL_CAP = window.marbleAgentFolders?.FULL_CAP ?? 4;
    let folderCatalog = [];
    let activeFolderId = null;
    // Pending header open, held for one double-click interval so a rename can
    // cancel it before the rail repaints.
    let openTimer = 0;
    let selectedIds = [];
    let selectAnchor = null;
    let workingSetIds = [];
    let folderSaveEl = null;
    let lastFolderGesture = null;
    let suppressFolderClick = false;
    let focusSelectedIds = [];
    let focusPrimaryId = null;
    let focusHoveredId = null;
    let focusLookId = null;
    let focusSuppressClick = false;
    let focusDecayTimer = null;
    let focusLayoutQueued = false;

    const railConversations = (folderId) => [...summaries.values()]
      .filter((summary) => (folderId ? summary.folderId === folderId : !summary.folderId))
      .filter(matches)
      .sort((a, b) => (b.updatedAt ?? 0) - (a.updatedAt ?? 0));

    const restoreFolderDock = async (folder) => {
      const ids = [...(folder.openIds ?? [])].filter((id) => summaries.has(id)).slice(0, FULL_CAP);
      const members = railConversations(folder.id).map((summary) => summary.id);
      const resolved = ids.length ? ids : members.slice(0, FULL_CAP);
      dock.extras = [];
      dock.focus = 'primary';
      if (resolved.length > 1) dock.extras = resolved.slice(1).map((id) => ({ id }));
      applyDock();
      if (resolved[0]) await open(resolved[0]);
      else await open(null);
    };

    const railTabIds = () => [...(folderRail?.querySelectorAll('.folder-tab[data-id]') ?? [])].map((tab) => tab.dataset.id);

    const paintTabSelection = () => {
      for (const tab of folderRail?.querySelectorAll('.folder-tab') ?? []) {
        tab.classList.toggle('marble-selected', selectedIds.includes(tab.dataset.id));
      }
    };

    const hideFolderSave = () => {
      folderSaveEl?.remove();
      folderSaveEl = null;
    };

    const suggestFolderName = (ids) => {
      const paths = ids.map((id) => targets.get(id) || summaries.get(id)?.target || '').filter(Boolean);
      return window.marbleAgentFolders?.suggestName?.(paths) ?? 'Group';
    };

    const tileWorkingSet = async (ids) => {
      const capped = ids.slice(0, FULL_CAP);
      workingSetIds = capped;
      if (agent) {
        try { await agent.saveWorkingSet(capped); } catch { /* stale ids */ }
      }
      activeFolderId = null;
      dock.extras = capped.slice(1).map((id) => ({ id }));
      dock.focus = 'primary';
      rememberDock();
      applyDock();
      if (capped[0]) await open(capped[0]);
      paintFolderRail();
    };

    const showFolderSave = (ids) => {
      hideFolderSave();
      if (!folderRail || ids.length < 2) return;
      const suggested = suggestFolderName(ids);
      const pop = document.createElement('div');
      pop.className = 'folder-save';
      pop.setAttribute('data-marble-transient', '');
      const input = document.createElement('input');
      input.type = 'text';
      input.placeholder = suggested;
      input.setAttribute('data-marble-transient', '');
      const confirm = document.createElement('button');
      confirm.type = 'button';
      confirm.className = 'folder-save-confirm';
      confirm.setAttribute('data-marble-transient', '');
      confirm.textContent = 'Save as folder';
      const dismiss = document.createElement('button');
      dismiss.type = 'button';
      dismiss.className = 'folder-save-dismiss';
      dismiss.setAttribute('data-marble-transient', '');
      dismiss.textContent = 'Not now';
      confirm.addEventListener('click', async () => {
        const name = input.value.trim() || suggested;
        try {
          const folder = await agent.createFolder({ conversationIds: [...ids], name });
          lastFolderGesture = {
            inverse: async () => {
              try { await agent.deleteFolder(folder.id); } catch { /* already gone */ }
            },
          };
          selectedIds = [];
          selectAnchor = null;
          hideFolderSave();
        } catch { /* create failed */ }
      });
      dismiss.addEventListener('click', () => hideFolderSave());
      pop.append(input, confirm, dismiss);
      folderRail.append(pop);
      folderSaveEl = pop;
    };

    const handleTabSelect = async (id, event) => {
      const order = railTabIds();
      if (event.shiftKey && selectAnchor && order.includes(selectAnchor)) {
        const a = order.indexOf(selectAnchor);
        const b = order.indexOf(id);
        if (a >= 0 && b >= 0) {
          const [lo, hi] = a < b ? [a, b] : [b, a];
          selectedIds = order.slice(lo, hi + 1);
        } else {
          selectedIds = [id];
        }
      } else if (event.metaKey || event.ctrlKey) {
        selectedIds = selectedIds.includes(id)
          ? selectedIds.filter((row) => row !== id)
          : [...selectedIds, id];
        selectAnchor = id;
      } else {
        selectedIds = [id];
        selectAnchor = id;
      }
      paintTabSelection();
      if (selectedIds.length >= 2) {
        await tileWorkingSet(selectedIds);
        showFolderSave(selectedIds);
      } else {
        hideFolderSave();
      }
    };

    const paintFolderDrop = (clientX, clientY, skipId) => {
      for (const el of folderRail?.querySelectorAll('.marble-drop-target') ?? []) {
        el.classList.remove('marble-drop-target');
      }
      if (clientX == null) return;
      const hit = hitFolderDrop(clientX, clientY, skipId);
      if (hit?.el) hit.el.classList.add('marble-drop-target');
    };

    const hitFolderDrop = (clientX, clientY, skipId) => {
      const el = document.elementFromPoint(clientX, clientY);
      const tab = el?.closest?.('.folder-tab[data-id]');
      if (tab?.dataset.id && tab.dataset.id !== skipId) {
        const group = tab.closest('.folder-group');
        const inUngrouped = Boolean(tab.closest('.folder-ungrouped'));
        return {
          kind: 'tab',
          el: tab,
          targetId: tab.dataset.id,
          folderId: group && !inUngrouped ? group.dataset.folderId : null,
        };
      }
      const header = el?.closest?.('.folder-header');
      if (header) {
        const group = header.closest('.folder-group');
        if (group?.dataset.folderId) {
          return { kind: 'header', el: header, folderId: group.dataset.folderId };
        }
      }
      if (pane) {
        const r = pane.getBoundingClientRect();
        if (clientX >= r.left && clientX <= r.right && clientY >= r.top && clientY <= r.bottom) {
          return { kind: 'pane', el: pane };
        }
      }
      return null;
    };

    const applyFolderDrop = async (dragId, hit) => {
      if (!agent || !hit) return;
      const dragSummary = summaries.get(dragId);
      const dragFolderId = dragSummary?.folderId ?? null;
      if (hit.kind === 'tab') {
        const targetId = hit.targetId;
        if (targetId === dragId) return;
        if (hit.folderId) {
          const prev = dragFolderId;
          try {
            await agent.update(dragId, { folderId: hit.folderId });
            lastFolderGesture = {
              inverse: async () => { try { await agent.update(dragId, { folderId: prev }); } catch { /* stale */ } },
            };
          } catch { /* move failed */ }
          return;
        }
        if (dragFolderId) {
          try {
            await agent.update(dragId, { folderId: null });
            lastFolderGesture = {
              inverse: async () => { try { await agent.update(dragId, { folderId: dragFolderId }); } catch { /* stale */ } },
            };
          } catch { /* ungroup failed */ }
          return;
        }
        try {
          const folder = await agent.createFolder({ conversationIds: [dragId, targetId] });
          lastFolderGesture = {
            inverse: async () => { try { await agent.deleteFolder(folder.id); } catch { /* already gone */ } },
          };
        } catch { /* create failed */ }
        return;
      }
      if (hit.kind === 'header' && hit.folderId) {
        const prev = dragFolderId;
        try {
          await agent.update(dragId, { folderId: hit.folderId });
          lastFolderGesture = {
            inverse: async () => { try { await agent.update(dragId, { folderId: prev }); } catch { /* stale */ } },
          };
        } catch { /* move failed */ }
        return;
      }
      if (hit.kind === 'pane') {
        if (activeFolderId) {
          const prev = dragFolderId;
          try {
            await agent.update(dragId, { folderId: activeFolderId });
            lastFolderGesture = {
              inverse: async () => { try { await agent.update(dragId, { folderId: prev }); } catch { /* stale */ } },
            };
            const folder = folderCatalog.find((row) => row.id === activeFolderId);
            if (folder) {
              let openIds = [...(folder.openIds ?? [])];
              if (!openIds.includes(dragId)) {
                openIds.push(dragId);
                if (openIds.length > FULL_CAP) openIds = openIds.slice(-FULL_CAP);
                try { await agent.updateFolder(activeFolderId, { openIds }); } catch { /* stale folder */ }
              }
            }
          } catch { /* join failed */ }
          return;
        }
        if (workingSetIds.length) {
          const ids = [...workingSetIds];
          if (!ids.includes(dragId)) ids.push(dragId);
          workingSetIds = ids.slice(0, FULL_CAP);
          try {
            await agent.saveWorkingSet(workingSetIds);
            await tileWorkingSet(workingSetIds);
          } catch { /* save failed */ }
        }
      }
    };

    const bindFolderTabDrag = (tab, dragId) => {
      tab.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        const tabRect = tab.getBoundingClientRect();
        let grabX = event.clientX - tabRect.left;
        let grabY = event.clientY - tabRect.top;
        const origin = { x: event.clientX, y: event.clientY, started: false };
        let done = false;
        let card = null;
        tab.setPointerCapture?.(event.pointerId);
        const move = (e) => {
          if (done) return;
          if (!origin.started && Math.hypot(e.clientX - origin.x, e.clientY - origin.y) < 10) return;
          origin.started = true;
          if (!card) card = makeCard(dragId);
          placeCard(card, e.clientX, e.clientY, grabX, grabY);
          paintFolderDrop(e.clientX, e.clientY, dragId);
        };
        const up = async (e) => {
          if (done) return;
          done = true;
          document.removeEventListener('pointermove', move);
          document.removeEventListener('mousemove', move);
          document.removeEventListener('pointerup', up);
          document.removeEventListener('mouseup', up);
          document.removeEventListener('pointercancel', up);
          try { tab.releasePointerCapture?.(e.pointerId); } catch { /* already released */ }
          card?.remove();
          paintFolderDrop(null);
          if (!origin.started) return;
          suppressFolderClick = true;
          setTimeout(() => { suppressFolderClick = false; }, 0);
          const hit = hitFolderDrop(e.clientX, e.clientY, dragId);
          await applyFolderDrop(dragId, hit);
        };
        document.addEventListener('pointermove', move);
        document.addEventListener('mousemove', move);
        document.addEventListener('pointerup', up);
        document.addEventListener('mouseup', up);
        document.addEventListener('pointercancel', up);
      });
    };

    const makeFolderTab = (summary, folderId) => {
      const tab = document.createElement('button');
      tab.type = 'button';
      tab.className = 'folder-tab';
      tab.dataset.id = summary.id;
      tab.setAttribute('data-marble-transient', '');
      // A tab used to be a bare title, which made the rail unscannable: no way
      // to tell a finished chat from a running one, or two chats on the same
      // project apart, without opening them.
      tab.dataset.status = statusOf(summary);
      if (summary.lastOutcome) tab.dataset.outcome = summary.lastOutcome;
      const top = document.createElement('span');
      top.className = 'tab-top';
      const dot = document.createElement('span');
      dot.className = 'tab-dot';
      dot.setAttribute('aria-hidden', 'true');
      const title = document.createElement('span');
      title.className = 'tab-title';
      title.textContent = summary.title || 'Untitled';
      const when = document.createElement('span');
      when.className = 'tab-age';
      when.textContent = age(summary.updatedAt);
      top.append(dot, title, when);
      const where = document.createElement('span');
      where.className = 'tab-target';
      where.textContent = tailOfTarget(targets.get(summary.id) || summary.target || '');
      tab.append(top, where);
      tab.classList.toggle('marble-open', summary.id === openId);
      tab.classList.toggle('marble-selected', selectedIds.includes(summary.id));
      tab.addEventListener('click', async (event) => {
        if (suppressFolderClick) return;
        if (event.shiftKey || event.metaKey || event.ctrlKey) {
          event.preventDefault();
          await handleTabSelect(summary.id, event);
          return;
        }
        selectAnchor = summary.id;
        selectedIds = [summary.id];
        paintTabSelection();
        hideFolderSave();
        if (folderId) {
          activeFolderId = folderId;
          await open(summary.id);
          const folder = folderCatalog.find((row) => row.id === folderId);
          if (folder && agent) {
            let openIds = [...(folder.openIds ?? [])];
            if (!openIds.includes(summary.id)) {
              openIds.push(summary.id);
              if (openIds.length > FULL_CAP) openIds = openIds.slice(-FULL_CAP);
              try { await agent.updateFolder(folderId, { openIds }); } catch { /* stale folder */ }
            }
          }
          paintFolderRail();
        } else {
          activeFolderId = null;
          dock.extras = [];
          dock.focus = 'primary';
          rememberDock();
          applyDock();
          await open(summary.id);
          paintFolderRail();
        }
      });
      bindFolderTabDrag(tab, summary.id);
      return tab;
    };

    const FOLDER_COLOR_KEYS = window.marbleAgentFolders?.COLOR_KEYS ?? [
      'research', 'fun', 'days', 'marble', 'travel', 'clay', 'sage', 'mist', 'ink', 'gold',
    ];

    const closeFolderPalettes = () => {
      for (const el of document.querySelectorAll('.folder-palette, .focus-folder-menu')) el.remove();
    };

    const watchPaletteDismiss = () => {
      const dismiss = (event) => {
        if (event.target.closest?.('.folder-palette, .folder-tick, .focus-folder-menu, .focus-folder')) return;
        closeFolderPalettes();
        document.removeEventListener('pointerdown', dismiss, true);
      };
      document.addEventListener('pointerdown', dismiss, true);
    };

    const editFolderName = (name, folder) => {
      if (!agent || !folder || name.isContentEditable) return;
      const prev = folder.name || 'Group';
      closeFolderPalettes();
      name.setAttribute('contenteditable', 'true');
      name.setAttribute('role', 'textbox');
      name.focus();
      const range = document.createRange();
      range.selectNodeContents(name);
      window.getSelection()?.removeAllRanges();
      window.getSelection()?.addRange(range);
      let closed = false;
      const finish = async (commit) => {
        if (closed) return;
        closed = true;
        name.removeEventListener('blur', onBlur);
        name.removeEventListener('keydown', onKey);
        const next = (name.textContent || '').trim().slice(0, 40);
        name.removeAttribute('contenteditable');
        name.removeAttribute('role');
        if (!commit || !next || next === prev) {
          name.textContent = prev;
          return;
        }
        name.textContent = next;
        const row = folderCatalog.find((item) => item.id === folder.id);
        if (row) row.name = next;
        folder.name = next;
        try { await agent.updateFolder(folder.id, { name: next }); } catch {
          name.textContent = prev;
          folder.name = prev;
          if (row) row.name = prev;
        }
      };
      const onBlur = () => { finish(true); };
      const onKey = (event) => {
        if (event.key === 'Enter') {
          event.preventDefault();
          event.stopPropagation();
          finish(true);
          name.blur();
        }
        if (event.key === 'Escape') {
          event.preventDefault();
          event.stopPropagation();
          finish(false);
          name.blur();
        }
      };
      name.addEventListener('keydown', onKey);
      name.addEventListener('blur', onBlur);
    };

    const openFolderPalette = (group, folder) => {
      closeFolderPalettes();
      if (!agent || !folder) return;
      const pal = document.createElement('div');
      pal.className = 'folder-palette';
      pal.setAttribute('role', 'listbox');
      pal.setAttribute('aria-label', 'Folder color');
      pal.setAttribute('data-marble-transient', '');
      for (const key of FOLDER_COLOR_KEYS) {
        const swatch = document.createElement('button');
        swatch.type = 'button';
        swatch.dataset.color = key;
        swatch.setAttribute('aria-label', key);
        swatch.setAttribute('aria-pressed', key === folder.color ? 'true' : 'false');
        swatch.setAttribute('data-marble-transient', '');
        swatch.addEventListener('click', async (event) => {
          event.stopPropagation();
          closeFolderPalettes();
          const row = folderCatalog.find((item) => item.id === folder.id);
          const prev = folder.color;
          folder.color = key;
          if (row) row.color = key;
          group.dataset.color = key;
          try { await agent.updateFolder(folder.id, { color: key }); } catch {
            folder.color = prev;
            if (row) row.color = prev;
            group.dataset.color = prev || 'research';
          }
        });
        pal.append(swatch);
      }
      group.append(pal);
      watchPaletteDismiss();
    };

    const paintFolderRail = () => {
      if (!folderRail) return;
      // A repaint replaces every node in the rail. Doing that while a folder
      // name is open for editing destroys the field mid-keystroke and loses
      // what was typed, so a live rename holds the rail still; the blur that
      // commits it repaints.
      if (folderRail.querySelector('.folder-name[contenteditable]')) return;
      const save = folderSaveEl;
      folderRail.replaceChildren();
      const sorted = [...folderCatalog].sort((a, b) => (a.order ?? 0) - (b.order ?? 0));
      for (const folder of sorted) {
        const group = document.createElement('section');
        group.className = 'folder-group';
        group.dataset.color = folder.color || 'research';
        group.dataset.folderId = folder.id;
        group.setAttribute('data-marble-transient', '');
        group.classList.toggle('marble-active', folder.id === activeFolderId);

        const header = document.createElement('div');
        header.className = 'folder-header';
        header.setAttribute('role', 'group');
        header.setAttribute('aria-label', folder.name || 'Group');
        header.tabIndex = 0;
        header.setAttribute('data-marble-transient', '');
        const tick = document.createElement('button');
        tick.type = 'button';
        tick.className = 'folder-tick';
        tick.setAttribute('aria-label', `Color ${folder.color || 'research'}`);
        tick.setAttribute('data-marble-transient', '');
        const name = document.createElement('span');
        name.className = 'folder-name';
        name.setAttribute('data-marble-transient', '');
        name.textContent = folder.name || 'Group';
        const count = document.createElement('span');
        count.className = 'folder-count';
        count.setAttribute('data-marble-transient', '');
        const tabs = railConversations(folder.id);
        count.textContent = tabs.length ? String(tabs.length) : '';
        header.append(tick, name, count);
        const activate = async () => {
          activeFolderId = folder.id;
          // Mark it before awaiting the dock, not after: opening a folder loads
          // up to four conversations, and the rail should answer the click on
          // the frame it happened rather than when the last pane arrives.
          for (const row of folderRail.querySelectorAll('.folder-group')) {
            row.classList.toggle('marble-active', row.dataset.folderId === folder.id);
          }
          await restoreFolderDock(folder);
        };
        // Click opens, double-click renames — so the first click of a rename
        // must not open, because opening repaints the rail and would pull the
        // editable node out from under the second click. Hold the open for one
        // double-click interval; the rename cancels it.
        header.addEventListener('click', (event) => {
          if (event.target.closest('.folder-tick, .folder-palette, .folder-name[contenteditable], .folder-name[contenteditable="plaintext-only"]')) return;
          if (event.detail > 1) return;
          clearTimeout(openTimer);
          openTimer = setTimeout(() => { activate(); }, 220);
        });
        header.addEventListener('dblclick', (event) => {
          if (event.target.closest('.folder-tick, .folder-palette')) return;
          clearTimeout(openTimer);
          event.preventDefault();
        });
        header.addEventListener('keydown', async (event) => {
          if (event.target.closest('.folder-name[contenteditable], .folder-name[contenteditable="plaintext-only"]')) return;
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            await activate();
            return;
          }
          // Renaming lost its click target, so it needs a key. F2 is what a
          // file rail is expected to answer to.
          if (event.key === 'F2') {
            event.preventDefault();
            editFolderName(name, folder);
          }
        });
        tick.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          openFolderPalette(group, folder);
        });
        // The name used to take the header's click and open an editor. It is
        // `flex: 1`, so that swallowed almost the whole target: opening a
        // folder — the reason this view exists — survived only in the few
        // pixels beside the count. Rename is the rarer act, so it moves to
        // double-click, which is what the Focus basin name already used.
        name.addEventListener('dblclick', (event) => {
          event.preventDefault();
          event.stopPropagation();
          editFolderName(name, folder);
        });

        const tabList = document.createElement('div');
        tabList.className = 'folder-tabs';
        tabList.setAttribute('data-marble-transient', '');
        for (const summary of tabs) tabList.append(makeFolderTab(summary, folder.id));

        group.append(header, tabList);
        folderRail.append(group);
      }

      const ungrouped = document.createElement('section');
      ungrouped.className = 'folder-ungrouped';
      ungrouped.setAttribute('data-marble-transient', '');
      const label = document.createElement('div');
      label.className = 'folder-ungrouped-label';
      label.setAttribute('data-marble-transient', '');
      label.textContent = 'ungrouped';
      const ungroupedTabs = document.createElement('div');
      ungroupedTabs.className = 'folder-tabs';
      ungroupedTabs.setAttribute('data-marble-transient', '');
      for (const summary of railConversations(null)) ungroupedTabs.append(makeFolderTab(summary, null));
      ungrouped.append(label, ungroupedTabs);
      folderRail.append(ungrouped);

      const newChat = document.createElement('button');
      newChat.type = 'button';
      newChat.className = 'folder-new-chat';
      newChat.setAttribute('data-marble-transient', '');
      newChat.textContent = '+ New chat';
      newChat.addEventListener('click', () => startNew());
      folderRail.append(newChat);
      if (save) folderRail.append(save);
      paintTabSelection();
    };

    const FOCUS_RESPONSE = 0.4;
    const FOCUS_DAMPING = 1;
    const focusSprings = new WeakMap();
    let lastFocusLods = '';
    // The LOD each card was last painted at, so the layout pass can ask a card
    // its size class without recomputing the cooling.
    let lastLods = {};

    const matchingFocusItems = () => [...summaries.values()]
      .filter(matches)
      .sort((a, b) => (b.updatedAt ?? 0) - (a.updatedAt ?? 0));

    const focusFullIds = () => matchingFocusItems()
      .filter((item) => item.pinned)
      .sort((a, b) => (b.lastInteractedAt ?? 0) - (a.lastInteractedAt ?? 0))
      .slice(0, FULL_CAP)
      .map((item) => item.id);

    const folderColorOf = (folderId) => folderCatalog.find((row) => row.id === folderId)?.color || '';

    const clearFocusPane = () => {
      if (!pane) return;
      for (const prop of ['position', 'left', 'top', 'width', 'height', 'z-index', 'border-radius', 'overflow', 'display', 'pointer-events', 'visibility']) {
        pane.style.removeProperty(prop);
      }
    };

    /** Focus with nothing pinned has nowhere to put the live pane. Clearing its
     *  inline position is not enough: the stylesheet still shows the library
     *  shell in this view, so the composer and its provider pills used to lie
     *  across the top of the canvas. Take it out of flow outright. */
    const hideFocusPane = () => {
      if (!pane) return;
      clearFocusPane();
      pane.style.display = 'none';
    };

    const leaveFocusView = () => {
      clearFocusPane();
      for (const live of focusEl?.querySelectorAll('.focus-live') ?? []) live.replaceChildren();
      document.querySelector('.focus-look')?.remove();
      closeFolderPalettes();
      focusLookId = null;
      stopFocusDecay();
      applyDock();
    };

    const stopFocusDecay = () => {
      if (focusDecayTimer) {
        clearInterval(focusDecayTimer);
        focusDecayTimer = null;
      }
    };

    const startFocusDecay = () => {
      stopFocusDecay();
      focusDecayTimer = setInterval(() => {
        if (document.hidden) return;
        if ((document.body.getAttribute('data-view') || 'library') !== 'focus') return;
        paintFocus({ quiet: true });
      }, 1000);
    };

    const focusCanvasBox = () => {
      const r = focusEl.getBoundingClientRect();
      return { w: Math.max(1, focusEl.clientWidth), h: Math.max(1, focusEl.clientHeight), left: r.left, top: r.top };
    };

    // Digest is sized to the four lines it actually shows. It used to be
    // 280x200 holding three lines of run-on text, so every card read as a
    // third-full box.
    const focusLodSize = (lod) => (lod === 'digest' ? { w: 260, h: 132 } : { w: 168, h: 56 });

    const STAGE_MARGIN = 16;

    /** Fulls are tiled across the top. Two columns once there are three, so a
     *  fourth pin squares the stage off rather than slivering it. */
    const stageGrid = (fullCount) => ({
      cols: fullCount >= 3 ? 2 : Math.max(1, fullCount),
      rows: fullCount >= 3 ? 2 : 1,
    });

    const stageHeight = (fullCount, canvas) => {
      if (!fullCount) return 0;
      return Math.min(canvas.h * 0.52, 460) + STAGE_MARGIN;
    };

    const stageRect = (index, fullCount, canvas) => {
      const gap = window.marbleAgentFolders?.GAP ?? 8;
      const { cols, rows } = stageGrid(fullCount);
      const band = Math.min(canvas.h * 0.52, 460);
      const w = (canvas.w - 2 * STAGE_MARGIN - (cols - 1) * gap) / cols;
      const h = (band - STAGE_MARGIN - (rows - 1) * gap) / rows;
      return {
        x: STAGE_MARGIN + (index % cols) * (w + gap),
        y: STAGE_MARGIN + Math.floor(index / cols) * (h + gap),
        w,
        h,
      };
    };

    /** What packRegions needs to know about a card: its size class, and the
     *  stored drag position it should be ordered by inside its region. */
    const fieldCard = (item) => ({
      id: item.id,
      lod: lastLods[item.id] === 'chip' ? 'chip' : 'digest',
      ox: Number.isFinite(item.focusX) ? item.focusX : undefined,
      oy: Number.isFinite(item.focusY) ? item.focusY : undefined,
    });

    const clampFocusRect = (rect, canvas) => ({
      ...rect,
      x: Math.min(Math.max(8, rect.x), Math.max(8, canvas.w - rect.w - 8)),
      y: Math.min(Math.max(8, rect.y), Math.max(8, canvas.h - rect.h - 8)),
    });

    const rubberFocus = (value, min, max, dimension) => {
      const fn = window.marbleAgentFolders?.rubberband;
      if (value < min) return min + (fn ? fn(value - min, dimension) : (value - min) * 0.35);
      if (value > max) return max + (fn ? fn(value - max, dimension) : (value - max) * 0.35);
      return value;
    };

    const liveFocusBox = (card) => {
      const canvasR = focusEl.getBoundingClientRect();
      const box = card.getBoundingClientRect();
      return {
        x: box.left - canvasR.left + focusEl.scrollLeft,
        y: box.top - canvasR.top + focusEl.scrollTop,
        w: box.width,
        h: box.height,
      };
    };

    const stopCardSpring = (card) => {
      const run = focusSprings.get(card);
      if (run?.frame) cancelAnimationFrame(run.frame);
      focusSprings.delete(card);
      for (const anim of card.getAnimations()) anim.cancel();
    };

    const flattenCardMotion = (card) => {
      const live = liveFocusBox(card);
      stopCardSpring(card);
      card.style.transform = '';
      card.style.left = `${live.x}px`;
      card.style.top = `${live.y}px`;
      card.style.width = `${live.w}px`;
      card.style.height = `${live.h}px`;
      return live;
    };

    const springCardTo = (card, to, velocity = { x: 0, y: 0 }) => {
      if (reduceMotion.matches) {
        stopCardSpring(card);
        card.style.left = `${to.x}px`;
        card.style.top = `${to.y}px`;
        card.style.width = `${to.w}px`;
        card.style.height = `${to.h}px`;
        card.animate([{ opacity: 0.55 }, { opacity: 1 }], { duration: 150, easing: 'ease-out' });
        return;
      }
      const from = flattenCardMotion(card);
      card.style.left = `${to.x}px`;
      card.style.top = `${to.y}px`;
      card.style.width = `${to.w}px`;
      card.style.height = `${to.h}px`;
      let x = from.x;
      let y = from.y;
      let vx = velocity.x;
      let vy = velocity.y;
      const om = (2 * Math.PI) / FOCUS_RESPONSE;
      let last = performance.now();
      const run = { frame: 0 };
      const step = (now) => {
        const dt = Math.min(0.032, (now - last) / 1000);
        last = now;
        const ax = -om * om * (x - to.x) - 2 * FOCUS_DAMPING * om * vx;
        const ay = -om * om * (y - to.y) - 2 * FOCUS_DAMPING * om * vy;
        vx += ax * dt;
        vy += ay * dt;
        x += vx * dt;
        y += vy * dt;
        card.style.transform = `translate(${x - to.x}px, ${y - to.y}px)`;
        const settled = Math.hypot(x - to.x, y - to.y) < 0.5 && Math.hypot(vx, vy) < 12;
        if (settled) {
          card.style.transform = '';
          focusSprings.delete(card);
          layoutFocusPane(focusFullIds());
          return;
        }
        run.frame = requestAnimationFrame(step);
      };
      run.frame = requestAnimationFrame(step);
      focusSprings.set(card, run);
    };

    const paintFocusCard = (card, summary, lod) => {
      card.dataset.lod = lod;
      card.dataset.selected = focusSelectedIds.includes(summary.id) ? 'true' : 'false';
      const color = folderColorOf(summary.folderId);
      if (color) card.dataset.color = color;
      else delete card.dataset.color;
      const title = card.querySelector('.focus-card-title');
      if (title) title.textContent = summary.title || 'Untitled';
      const status = statusOf(summary);
      card.dataset.status = status;
      if (summary.lastOutcome) card.dataset.outcome = summary.lastOutcome;
      else delete card.dataset.outcome;
      // Four addressable lines rather than one run-on string: the path says
      // where, the activity says what, the footer says how it went and when.
      const target = card.querySelector('.focus-target');
      if (target) target.textContent = tailOfTarget(targets.get(summary.id) || summary.target || '');
      const activity = card.querySelector('.focus-activity');
      if (activity) activity.textContent = summary.activity || summary.lastOutcome || '';
      const statusEl = card.querySelector('.focus-status');
      if (statusEl) statusEl.textContent = status;
      const ageEl = card.querySelector('.focus-age');
      if (ageEl) ageEl.textContent = age(summary.updatedAt);
      // A chip is a title and one tick of context. When every chat runs the
      // same agent, naming it turns that tick into noise — show the age, which
      // is the thing a cold card is actually being judged on.
      const model = card.querySelector('.focus-card-model');
      if (model) {
        model.textContent = soloProvider()
          ? age(summary.updatedAt)
          : (labels.get(summary.provider)?.label || summary.model || '');
      }
    };

    const layoutFocusPane = (fullIds) => {
      if (!pane || !focusEl) return;
      const stacked = focusEl.hasAttribute('data-stack') || narrowView.matches;
      const primary = (focusPrimaryId && fullIds.includes(focusPrimaryId)) ? focusPrimaryId : fullIds[0];
      if (!primary || stacked) {
        hideFocusPane();
        for (const live of focusEl.querySelectorAll('.focus-live')) live.replaceChildren();
        return;
      }
      const card = focusEl.querySelector(`.focus-card[data-id="${primary}"]`);
      const slot = card?.querySelector('.focus-live');
      if (!slot) {
        hideFocusPane();
        return;
      }
      const r = slot.getBoundingClientRect();
      pane.style.visibility = '';
      pane.style.display = 'grid';
      pane.style.position = 'fixed';
      pane.style.left = `${r.left}px`;
      pane.style.top = `${r.top}px`;
      pane.style.width = `${Math.max(0, r.width)}px`;
      pane.style.height = `${Math.max(0, r.height)}px`;
      pane.style.zIndex = '6';
      pane.style.borderRadius = '0 0 12px 12px';
      pane.style.overflow = 'hidden';
      pane.style.pointerEvents = 'auto';
      if (convo.getAttribute('conversation') !== primary) convo.setAttribute('conversation', primary);
      pane.querySelector('.dock-extras')?.replaceChildren();
      for (const id of fullIds) {
        const host = focusEl.querySelector(`.focus-card[data-id="${id}"] .focus-live`);
        if (!host) continue;
        if (id === primary || reduceMotion.matches) {
          host.replaceChildren();
          continue;
        }
        let extra = host.querySelector('marble-conversation');
        if (!extra) {
          extra = document.createElement('marble-conversation');
          extra.setAttribute('data-marble-transient', '');
          extra.setAttribute('data-chrome', 'pane');
          host.append(extra);
        }
        extra.setAttribute('conversation', id);
      }
    };

    const animateFocusCard = (card, from, to, velocity) => {
      if (!from) {
        card.style.left = `${to.x}px`;
        card.style.top = `${to.y}px`;
        card.style.width = `${to.w}px`;
        card.style.height = `${to.h}px`;
        return;
      }
      springCardTo(card, to, velocity);
    };

    const pinFocus = async (id, { keepOpen = false } = {}) => {
      if (!agent || !id) return;
      const pinned = matchingFocusItems().filter((item) => item.pinned);
      if (!keepOpen) {
        for (const item of pinned) {
          if (item.id === id) continue;
          item.pinned = false;
          try { await agent.update(item.id, { pinned: false }); } catch { /* stale */ }
        }
      } else if (!pinned.some((item) => item.id === id) && pinned.length >= FULL_CAP) {
        const oldest = [...pinned].sort((a, b) => (a.lastInteractedAt ?? 0) - (b.lastInteractedAt ?? 0))[0];
        if (oldest) {
          oldest.pinned = false;
          try { await agent.update(oldest.id, { pinned: false }); } catch { /* stale */ }
        }
      }
      const target = summaries.get(id);
      if (target) target.pinned = true;
      try { await agent.update(id, { pinned: true }); } catch { /* stale */ }
      if (!focusSelectedIds.includes(id)) focusSelectedIds = [id];
      focusPrimaryId = id;
      paintFocus();
    };

    const unpinFocus = async (id) => {
      if (!agent || !id) return;
      const item = summaries.get(id);
      if (item) item.pinned = false;
      try { await agent.update(id, { pinned: false }); } catch { /* stale */ }
      paintFocus();
    };

    const selectFocusCard = (id, event) => {
      if (event?.metaKey || event?.ctrlKey) {
        focusSelectedIds = focusSelectedIds.includes(id)
          ? focusSelectedIds.filter((row) => row !== id)
          : [...focusSelectedIds, id];
      } else if (event?.shiftKey && focusPrimaryId && focusPrimaryId !== id) {
        if (!focusSelectedIds.includes(id)) focusSelectedIds = [...focusSelectedIds, id];
      } else {
        focusSelectedIds = [id];
      }
      focusPrimaryId = id;
      paintFocus({ quiet: true });
    };

    const closeFocusLook = () => {
      document.querySelector('.focus-look')?.remove();
      focusLookId = null;
    };

    const openFocusLook = async (id) => {
      if (!id || !agent) return;
      closeFocusLook();
      let detail = null;
      try { detail = await agent.conversation(id); } catch { /* preview still shows summary */ }
      const summary = detail?.meta ?? summaries.get(id) ?? {};
      const look = document.createElement('div');
      look.className = 'focus-look';
      look.setAttribute('data-marble-transient', '');
      look.setAttribute('role', 'dialog');
      look.setAttribute('aria-label', 'Quick Look');
      const title = document.createElement('h3');
      title.textContent = summary.title || 'Untitled';
      const meta = document.createElement('p');
      meta.className = 'look-meta';
      meta.textContent = [summary.target || targets.get(id) || '', statusOf(summary), summary.activity || ''].filter(Boolean).join(' · ');
      const list = document.createElement('ul');
      list.className = 'look-events';
      const events = (detail?.events ?? []).slice(-8);
      for (const row of events) {
        const li = document.createElement('li');
        li.textContent = row.type || row.text || '';
        list.append(li);
      }
      look.append(title, meta, list);
      document.body.append(look);
      const card = focusEl?.querySelector(`.focus-card[data-id="${id}"]`);
      const box = card?.getBoundingClientRect();
      const width = Math.min(28 * 16, window.innerWidth - 32);
      let left;
      if (box) {
        left = box.right + 12;
        if (left + width > window.innerWidth - 16) left = box.left - width - 12;
        left = Math.min(Math.max(16, left), window.innerWidth - width - 16);
      } else {
        left = Math.max(16, (window.innerWidth - width) / 2);
      }
      const top = box ? Math.min(Math.max(16, box.top), window.innerHeight - 120) : window.innerHeight * 0.12;
      look.style.left = `${left}px`;
      look.style.top = `${top}px`;
      focusLookId = id;
    };

    /** A basin is the region the packer allocated, not the bounding box of
     *  wherever its members happened to land. Hulls over a free layout
     *  overlapped each other and ran off the canvas; a region cannot, because
     *  the same pass placed the cards inside it. */
    const paintFocusBasins = (regions = []) => {
      if (!focusEl) return;
      const stacked = focusEl.hasAttribute('data-stack') || narrowView.matches;
      const keep = new Set();
      if (!stacked) {
        for (const region of regions) {
          const folderId = region.folderId ?? 'ungrouped';
          keep.add(folderId);
          const folder = folderCatalog.find((row) => row.id === folderId);
          let basin = focusEl.querySelector(`.focus-basin[data-folder-id="${folderId}"]`);
          if (!basin) {
            basin = document.createElement('div');
            basin.className = 'focus-basin';
            basin.dataset.folderId = folderId;
            basin.setAttribute('data-marble-transient', '');
            const name = document.createElement('button');
            name.type = 'button';
            name.className = 'focus-basin-name folder-name';
            name.setAttribute('data-marble-transient', '');
            name.addEventListener('click', () => {
              const ids = matchingFocusItems().filter((item) => item.folderId === folderId).map((item) => item.id);
              focusSelectedIds = ids;
              focusPrimaryId = ids[0] ?? focusPrimaryId;
              paintFocus({ quiet: true });
            });
            name.addEventListener('dblclick', (event) => {
              event.preventDefault();
              event.stopPropagation();
              const row = folderCatalog.find((item) => item.id === folderId);
              if (row) editFolderName(name, row);
            });
            basin.append(name);
            focusEl.insertBefore(basin, focusEl.querySelector('.focus-card'));
          }
          if (folder?.color) basin.dataset.color = folder.color;
          else delete basin.dataset.color;
          if (region.folderId) delete basin.dataset.loose;
          else basin.dataset.loose = 'true';
          const name = basin.querySelector('.focus-basin-name');
          if (name) {
            name.textContent = region.folderId ? (folder?.name || 'Group') : 'Ungrouped';
            name.disabled = !region.folderId;
          }
          basin.style.left = `${region.x}px`;
          basin.style.top = `${region.y}px`;
          basin.style.width = `${Math.max(0, region.w)}px`;
          basin.style.height = `${Math.max(0, region.h)}px`;
        }
      }
      for (const basin of [...focusEl.querySelectorAll('.focus-basin')]) {
        if (!keep.has(basin.dataset.folderId)) basin.remove();
      }
    };

    const hitFocusDrop = (clientX, clientY, skipId) => {
      const stack = document.elementsFromPoint?.(clientX, clientY) ?? [document.elementFromPoint(clientX, clientY)];
      for (const el of stack) {
        const other = el?.closest?.('.focus-card[data-id]');
        if (other?.dataset.id && other.dataset.id !== skipId) {
          return { kind: 'card', id: other.dataset.id, folderId: summaries.get(other.dataset.id)?.folderId ?? null };
        }
      }
      for (const basin of focusEl?.querySelectorAll('.focus-basin') ?? []) {
        const r = basin.getBoundingClientRect();
        if (clientX >= r.left && clientX <= r.right && clientY >= r.top && clientY <= r.bottom) {
          return { kind: 'basin', folderId: basin.dataset.folderId };
        }
      }
      return { kind: 'canvas' };
    };

    const applyFocusDrop = async (dragId, hit, fx, fy) => {
      const drag = summaries.get(dragId);
      if (agent && drag) {
        drag.focusX = fx;
        drag.focusY = fy;
        try { await agent.update(dragId, { focusX: fx, focusY: fy }); } catch { /* stale */ }
      }
      if (!agent || !hit) return;
      if (hit.kind === 'card') {
        const targetFolder = hit.folderId;
        const dragFolder = drag?.folderId ?? null;
        if (!targetFolder && !dragFolder && hit.id !== dragId) {
          try {
            await agent.createFolder({ conversationIds: [dragId, hit.id] });
            const listed = await agent.folders();
            folderCatalog = listed.folders ?? folderCatalog;
          } catch { /* create failed */ }
          return;
        }
        if (targetFolder && targetFolder !== dragFolder) {
          try { await agent.update(dragId, { folderId: targetFolder }); } catch { /* join failed */ }
        }
        return;
      }
      if (hit.kind === 'basin' && hit.folderId && drag?.folderId !== hit.folderId) {
        try { await agent.update(dragId, { folderId: hit.folderId }); } catch { /* join failed */ }
        return;
      }
      if (hit.kind === 'canvas' && drag?.folderId) {
        try { await agent.update(dragId, { folderId: null }); } catch { /* ungroup failed */ }
      }
    };

    const handleFocusKeys = (event) => {
      if ((document.body.getAttribute('data-view') || 'library') !== 'focus') return false;
      if (typingIn()) return false;
      if (event.metaKey || event.ctrlKey || event.altKey) return false;
      const arrows = { ArrowRight: 'right', ArrowLeft: 'left', ArrowUp: 'up', ArrowDown: 'down' };
      if (arrows[event.key]) {
        event.preventDefault();
        const fromId = focusPrimaryId || focusSelectedIds[0];
        if (!fromId || !focusEl) return true;
        const cards = [...focusEl.querySelectorAll('.focus-card')].map((row) => {
          const r = row.getBoundingClientRect();
          return { id: row.dataset.id, cx: r.left + r.width / 2, cy: r.top + r.height / 2 };
        });
        const next = window.marbleAgentFolders?.nearestCard?.(cards, fromId, arrows[event.key]);
        if (next) {
          selectFocusCard(next.id, event);
          if (focusLookId) openFocusLook(next.id);
        }
        return true;
      }
      if (event.key === ' ' || event.code === 'Space') {
        event.preventDefault();
        const id = focusPrimaryId || focusSelectedIds[0];
        if (!id) return true;
        const row = focusEl?.querySelector(`.focus-card[data-id="${id}"]`);
        if (row?.dataset.lod === 'full' && !focusLookId) return true;
        if (focusLookId === id) closeFocusLook();
        else openFocusLook(id);
        return true;
      }
      if (event.key === 'Enter') {
        event.preventDefault();
        const id = focusPrimaryId || focusSelectedIds[0];
        if (!id) return true;
        closeFocusLook();
        pinFocus(id, { keepOpen: event.shiftKey });
        return true;
      }
      if (event.key === 'Escape') {
        event.preventDefault();
        if (focusLookId) {
          closeFocusLook();
          return true;
        }
        const id = focusPrimaryId || focusSelectedIds[0];
        if (id && summaries.get(id)?.pinned) {
          unpinFocus(id);
          return true;
        }
        focusSelectedIds = [];
        focusPrimaryId = null;
        paintFocus();
        return true;
      }
      return false;
    };

    const openFocusFolderMenu = (card) => {
      closeFolderPalettes();
      const id = card.dataset.id;
      if (!id || !agent) return;
      const current = summaries.get(id)?.folderId ?? null;
      const menu = document.createElement('div');
      menu.className = 'focus-folder-menu';
      menu.setAttribute('role', 'menu');
      menu.setAttribute('data-marble-transient', '');
      const addItem = (label, attrs, onClick) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute('role', 'menuitem');
        btn.setAttribute('data-marble-transient', '');
        btn.textContent = label;
        for (const [key, value] of Object.entries(attrs)) btn.setAttribute(key, value);
        btn.addEventListener('click', async (event) => {
          event.stopPropagation();
          closeFolderPalettes();
          await onClick();
        });
        menu.append(btn);
      };
      for (const folder of folderCatalog) {
        addItem(folder.name || 'Group', {
          'data-folder-id': folder.id,
          'aria-pressed': folder.id === current ? 'true' : 'false',
        }, async () => {
          if (current === folder.id) return;
          try { await agent.update(id, { folderId: folder.id }); } catch { /* stale */ }
        });
      }
      addItem('Ungrouped', { 'data-action': 'ungroup', 'aria-pressed': current ? 'false' : 'true' }, async () => {
        if (!current) return;
        try { await agent.update(id, { folderId: null }); } catch { /* stale */ }
      });
      addItem('Save as folder', { 'data-action': 'save' }, async () => {
        const ids = focusSelectedIds.includes(id) ? [...focusSelectedIds] : [id];
        try { await agent.createFolder({ conversationIds: ids }); } catch { /* create failed */ }
      });
      document.body.append(menu);
      const tick = card.querySelector('.focus-folder');
      const box = (tick || card).getBoundingClientRect();
      const width = menu.offsetWidth || 160;
      let left = box.left;
      if (left + width > window.innerWidth - 12) left = window.innerWidth - width - 12;
      menu.style.left = `${Math.max(12, left)}px`;
      menu.style.top = `${Math.min(box.bottom + 6, window.innerHeight - 80)}px`;
      watchPaletteDismiss();
    };

    const bindFocusCard = (card) => {
      card.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        if (event.target.closest('button, a, input, textarea, marble-conversation')) return;
        const id = card.dataset.id;
        const live = liveFocusBox(card);
        const origin = {
          x: event.clientX,
          y: event.clientY,
          left: live.x,
          top: live.y,
          id,
          started: false,
          lastX: event.clientX,
          lastY: event.clientY,
          lastT: performance.now(),
          vx: 0,
          vy: 0,
        };
        let done = false;
        card.setPointerCapture?.(event.pointerId);
        const move = (e) => {
          if (done) return;
          if (!origin.started && Math.hypot(e.clientX - origin.x, e.clientY - origin.y) < 10) return;
          if (!origin.started) {
            origin.started = true;
            flattenCardMotion(card);
          }
          focusSuppressClick = true;
          card.classList.add('marble-dragging');
          card.style.zIndex = '10';
          const canvas = focusCanvasBox();
          const nextX = origin.left + (e.clientX - origin.x);
          const nextY = origin.top + (e.clientY - origin.y);
          card.style.left = `${rubberFocus(nextX, 8, canvas.w - card.offsetWidth - 8, canvas.w)}px`;
          card.style.top = `${rubberFocus(nextY, 8, canvas.h - card.offsetHeight - 8, canvas.h)}px`;
          const now = performance.now();
          const dt = Math.max(8, now - origin.lastT) / 1000;
          origin.vx = (e.clientX - origin.lastX) / dt;
          origin.vy = (e.clientY - origin.lastY) / dt;
          origin.lastX = e.clientX;
          origin.lastY = e.clientY;
          origin.lastT = now;
        };
        const up = async (e) => {
          if (done) return;
          done = true;
          document.removeEventListener('pointermove', move);
          document.removeEventListener('mousemove', move);
          document.removeEventListener('pointerup', up);
          document.removeEventListener('mouseup', up);
          document.removeEventListener('pointercancel', up);
          try { card.releasePointerCapture?.(e.pointerId); } catch { /* released */ }
          card.classList.remove('marble-dragging');
          if (!origin.started) return;
          const canvas = focusCanvasBox();
          const x = card.offsetLeft;
          const y = card.offsetTop;
          const fx = canvas.w > card.offsetWidth ? x / (canvas.w - card.offsetWidth) : 0;
          const fy = canvas.h > card.offsetHeight ? y / (canvas.h - card.offsetHeight) : 0;
          const hit = hitFocusDrop(e.clientX, e.clientY, id);
          await applyFocusDrop(id, hit, fx, fy);
          paintFocus({ velocity: { x: origin.vx, y: origin.vy }, velocityId: id });
          setTimeout(() => { focusSuppressClick = false; }, 0);
        };
        document.addEventListener('pointermove', move);
        document.addEventListener('mousemove', move);
        document.addEventListener('pointerup', up);
        document.addEventListener('mouseup', up);
        document.addEventListener('pointercancel', up);
      });
      card.addEventListener('click', (event) => {
        if (focusSuppressClick) return;
        if (event.target.closest('button, a, input, textarea, marble-conversation')) return;
        selectFocusCard(card.dataset.id, event);
      });
      card.addEventListener('dblclick', (event) => {
        if (event.target.closest('button, a, input, textarea, marble-conversation')) return;
        event.preventDefault();
        pinFocus(card.dataset.id, { keepOpen: event.shiftKey });
      });
      card.addEventListener('pointerenter', () => {
        if (focusSuppressClick) return;
        if (focusHoveredId === card.dataset.id) return;
        focusHoveredId = card.dataset.id;
        paintFocus({ quiet: true });
      });
      card.addEventListener('pointerleave', () => {
        if (focusHoveredId !== card.dataset.id) return;
        focusHoveredId = null;
        if (!focusSuppressClick) paintFocus({ quiet: true });
      });
      card.querySelector('.focus-pin')?.addEventListener('click', (event) => {
        event.stopPropagation();
        pinFocus(card.dataset.id);
      });
      card.querySelector('.focus-keep')?.addEventListener('click', (event) => {
        event.stopPropagation();
        pinFocus(card.dataset.id, { keepOpen: true });
      });
      card.querySelector('.focus-collapse')?.addEventListener('click', (event) => {
        event.stopPropagation();
        unpinFocus(card.dataset.id);
      });
      card.querySelector('.focus-folder')?.addEventListener('click', (event) => {
        event.stopPropagation();
        openFocusFolderMenu(card);
      });
    };

    const makeFocusCard = (summary) => {
      const card = document.createElement('article');
      card.className = 'focus-card';
      card.dataset.id = summary.id;
      card.setAttribute('data-marble-transient', '');
      card.tabIndex = 0;
      card.innerHTML = '<header class="focus-card-head"><button type="button" class="focus-folder" aria-label="Move to folder"></button><span class="focus-dot" aria-hidden="true"></span><span class="focus-card-title"></span><span class="focus-card-model"></span><span class="focus-card-actions"><button type="button" class="focus-pin">Focus</button><button type="button" class="focus-keep">Keep open</button><button type="button" class="focus-collapse">Collapse</button></span></header><div class="focus-card-body"><p class="focus-target"></p><p class="focus-activity"></p><p class="focus-foot"><span class="focus-status"></span><span class="focus-age"></span></p></div><div class="focus-live"></div>';
      bindFocusCard(card);
      return card;
    };

    function paintFocus(opts = {}) {
      if (!focusEl) return;
      const view = document.body.getAttribute('data-view') || 'library';
      if (view !== 'focus') return;
      if (narrowView.matches) focusEl.setAttribute('data-stack', '');
      else focusEl.removeAttribute('data-stack');
      if (focusEl.clientWidth < 2 && !focusLayoutQueued) {
        focusLayoutQueued = true;
        requestAnimationFrame(() => {
          focusLayoutQueued = false;
          paintFocus(opts);
        });
        return;
      }
      const helpers = window.marbleAgentFolders;
      const items = matchingFocusItems();
      const fullIds = focusFullIds();
      const lods = helpers?.assignLods
        ? helpers.assignLods(items.map((item) => ({
          id: item.id,
          running: statusOf(item) === 'running',
          needsReview: Boolean(item.needsReview),
          lastInteractedAt: item.lastInteractedAt,
          updatedAt: item.updatedAt,
        })), {
          fullIds,
          selectedIds: focusSelectedIds,
          hoveredId: focusHoveredId,
          now: Date.now(),
        })
        : Object.fromEntries(items.map((item) => [item.id, fullIds.includes(item.id) ? 'full' : 'digest']));

      const lodKey = items.map((item) => `${item.id}:${lods[item.id]}:${focusSelectedIds.includes(item.id) ? 1 : 0}`).join('|');
      const lodsChanged = lodKey !== lastFocusLods;
      lastFocusLods = lodKey;
      lastLods = lods;

      let empty = focusEl.querySelector('.focus-empty');
      if (!items.length) {
        if (!empty) {
          empty = document.createElement('p');
          empty.className = 'focus-empty';
          empty.setAttribute('data-marble-transient', '');
          empty.textContent = 'Open a chat, then double-click it to pin Full.';
          focusEl.append(empty);
        }
      } else {
        empty?.remove();
      }

      const seen = new Set();
      for (const item of items) {
        seen.add(item.id);
        let card = focusEl.querySelector(`.focus-card[data-id="${item.id}"]`);
        if (!card) {
          card = makeFocusCard(item);
          focusEl.append(card);
        }
        paintFocusCard(card, item, lods[item.id] || 'digest');
      }
      for (const card of [...focusEl.querySelectorAll('.focus-card')]) {
        if (!seen.has(card.dataset.id)) {
          stopCardSpring(card);
          card.remove();
        }
      }

      if (focusEl.hasAttribute('data-stack') || narrowView.matches) {
        layoutFocusPane(fullIds);
        paintFocusBasins();
        return;
      }

      if (opts.quiet && !lodsChanged) {
        for (const card of focusEl.querySelectorAll('.focus-card')) {
          card.dataset.selected = focusSelectedIds.includes(card.dataset.id) ? 'true' : 'false';
        }
        layoutFocusPane(fullIds);
        return;
      }

      const canvas = focusCanvasBox();
      const rects = {};

      // The stage exists only when something is pinned. Passing `|| 1` here is
      // what used to reserve a Full-sized band above an empty canvas and leave
      // the top half of the view dead.
      const stageH = fullIds.length ? stageHeight(fullIds.length, canvas) : 0;
      fullIds.forEach((id, index) => {
        Object.assign(rects, { [id]: stageRect(index, fullIds.length, canvas) });
      });

      // Group the unpinned cards by folder, catalog order, ungrouped last, so
      // the packer can hand each folder a region of its own.
      const fullSet = new Set(fullIds);
      // Laid out oldest first, not newest first. The list sorts by recency, but
      // a canvas that reorders itself every time a chat ticks destroys the
      // spatial memory that makes Focus worth using — and arrow keys navigate
      // by position, so the order on screen is the order they move through.
      const field = items
        .filter((item) => !fullSet.has(item.id))
        .sort((a, b) => (a.createdAt ?? a.updatedAt ?? 0) - (b.createdAt ?? b.updatedAt ?? 0));
      const groups = [];
      for (const folder of folderCatalog) {
        const members = field.filter((item) => item.folderId === folder.id);
        if (members.length) groups.push({ folderId: folder.id, cards: members.map(fieldCard) });
      }
      const loose = field.filter((item) => !item.folderId || !folderCatalog.some((row) => row.id === item.folderId));
      if (loose.length) groups.push({ folderId: null, cards: loose.map(fieldCard) });

      let regions = [];
      if (helpers?.packRegions) {
        const packed = helpers.packRegions({
          groups,
          canvas,
          top: stageH,
          sizes: { digest: focusLodSize('digest'), chip: focusLodSize('chip') },
          gap: helpers.GAP ?? 8,
        });
        regions = packed.regions;
        Object.assign(rects, packed.rects);
        // The field is a partition, so it can be taller than the viewport.
        // Let the canvas scroll rather than cramming regions on top of one another.
        focusEl.style.minHeight = `${Math.max(canvas.h, packed.height)}px`;
      }

      for (const item of items) {
        const rect = rects[item.id];
        if (!rect) continue;
        const card = focusEl.querySelector(`.focus-card[data-id="${item.id}"]`);
        if (!card || card.classList.contains('marble-dragging')) continue;
        const from = card.hasAttribute('data-placed') ? liveFocusBox(card) : null;
        const vel = opts.velocityId === item.id ? opts.velocity : { x: 0, y: 0 };
        animateFocusCard(card, from, rect, vel);
        card.setAttribute('data-placed', '');
        const lod = card.dataset.lod;
        card.style.zIndex = lod === 'full' ? '3' : lod === 'digest' ? '2' : '1';
      }
      layoutFocusPane(fullIds);
      paintFocusBasins(regions);
    }

    const paintRow = (el, summary) => {
      el.dataset.status = statusOf(summary);
      // A finer signal than the three-way status bucket, purely for the dot's
      // color — failed/watchdog reads as an alarm, not just "take a look".
      if (summary.lastOutcome) el.dataset.outcome = summary.lastOutcome;
      else delete el.dataset.outcome;
      el.querySelector('.title').textContent = summary.title || 'Untitled';
      const tags = el.querySelector('.tags');
      if (tags) {
        tags.replaceChildren();
        for (const tag of (window.marbleAgentUI?.conversationTags?.(summary, labels) ?? [])) {
          const span = document.createElement('span');
          span.className = 'tag';
          span.dataset.kind = tag.kind;
          span.dataset.hue = String(tag.hue);
          span.textContent = tag.label;
          if (tag.title) span.title = tag.title;
          tags.append(span);
        }
      }
      el.querySelector('.badge').textContent = '';
      el.querySelector('.activity').textContent = summary.activity || '';
      el.querySelector('.age').textContent = age(summary.updatedAt);
      // The target is what tells two rows apart. It was in the data and on the
      // pane header, but never in the list.
      el.querySelector('.target').textContent = tailOfTarget(targets.get(summary.id) || summary.target || '');
      const color = folderColorOf(summary.folderId);
      if (color) el.dataset.color = color;
      else delete el.dataset.color;
    };

    const columnFor = (summary) => {
      const status = statusOf(summary);
      const col = status === 'running' ? 'running' : status === 'review' ? 'review' : 'completed';
      return document.querySelector(`.column[data-col="${col}"]`);
    };

    /** Counts live on the headings, so a glance at the board says how much is
     *  in each state without counting cards. */
    const paintColumnCounts = () => {
      for (const column of document.querySelectorAll('.column')) {
        const n = column.querySelectorAll(':scope > .conv:not([hidden])').length;
        const count = column.querySelector('h2 .col-count') ?? (() => {
          const span = document.createElement('span');
          span.className = 'col-count';
          span.setAttribute('data-marble-transient', '');
          column.querySelector('h2')?.append(span);
          return span;
        })();
        count.textContent = n ? String(n) : '';
      }
    };

    const placeIn = (el, parent) => {
      const updated = summaries.get(el.dataset.id)?.updatedAt ?? 0;
      const siblings = [...parent.querySelectorAll(':scope > .conv')];
      const before = siblings.find(
        (n) => n !== el && (summaries.get(n.dataset.id)?.updatedAt ?? 0) < updated,
      );
      if (before) parent.insertBefore(el, before);
      else parent.append(el);
    };

    // One element per id. Library: newest-first in #list. Board: the column
    // for its status. Archived stay in the Map and out of the columns.
    const place = (el) => {
      const summary = summaries.get(el.dataset.id);
      const view = document.body.getAttribute('data-view') || 'library';
      if (view === 'board') {
        if (summary?.archived) {
          el.remove();
          return;
        }
        placeIn(el, columnFor(summary));
        return;
      }
      placeIn(el, list);
    };

    const placeAll = () => {
      for (const el of nodes.values()) place(el);
      paintColumnCounts();
    };

    const boardOrder = () => [
      ...document.querySelectorAll('.column[data-col="running"] > .conv'),
      ...document.querySelectorAll('.column[data-col="review"] > .conv'),
      ...document.querySelectorAll('.column[data-col="completed"] > .conv'),
    ];

    const captureRects = () => {
      const rects = new Map();
      for (const el of nodes.values()) {
        if (!el.isConnected) continue;
        rects.set(el, el.getBoundingClientRect());
      }
      return rects;
    };

    const cancelFlip = () => {
      for (const anim of flipAnims) anim.cancel();
      flipAnims = [];
      for (const el of nodes.values()) el.classList.remove('marble-flip');
    };

    const shellFor = (view) => {
      if (view === 'board') return boardEl;
      if (view === 'folders') return foldersEl;
      if (view === 'focus') return focusEl;
      return libraryEl;
    };

    const nextView = (view) => {
      const index = VIEW_ORDER.indexOf(view);
      return VIEW_ORDER[(index + 1) % VIEW_ORDER.length];
    };

    const isListBoard = (view) => view === 'library' || view === 'board';

    const cancelViewFades = () => {
      for (const el of [libraryEl, boardEl, foldersEl, focusEl]) {
        for (const anim of el.getAnimations()) anim.cancel();
      }
    };

    const openBoardPanel = () => {
      panelOpen = true;
      boardPanel.setAttribute('data-open', 'true');
      document.body.setAttribute('data-panel', 'open');
    };

    const closeBoardPanel = () => {
      panelOpen = false;
      boardPanel.removeAttribute('data-open');
      document.body.removeAttribute('data-panel');
    };

    const rememberDock = () => {
      remember(DOCK_KEY, JSON.stringify({
        dir: dock.dir,
        primary: dock.primary,
        extras: dock.extras.map((extra) => extra.id),
        sizes: dock.sizes,
        focus: dock.focus,
        file: convo.getAttribute('conversation'),
      }));
    };

    const BAR_MARKUP = `<svg class="dock-grip" viewBox="0 0 10 14" width="10" height="14" aria-hidden="true"><circle cx="3" cy="3" r="1.15" fill="currentColor"/><circle cx="7" cy="3" r="1.15" fill="currentColor"/><circle cx="3" cy="7" r="1.15" fill="currentColor"/><circle cx="7" cy="7" r="1.15" fill="currentColor"/><circle cx="3" cy="11" r="1.15" fill="currentColor"/><circle cx="7" cy="11" r="1.15" fill="currentColor"/></svg><span class="dock-title"></span><a class="dock-target" hidden></a><button type="button" class="dock-close" aria-label="Close pane"><svg viewBox="0 0 20 20" width="12" height="12" aria-hidden="true"><path d="M5 5l10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>`;

    const dropSide = (clientX, clientY) => {
      const r = pane.getBoundingClientRect();
      if (clientX < r.left || clientX > r.right || clientY < r.top || clientY > r.bottom) return null;
      const x = (clientX - r.left) / r.width;
      const y = (clientY - r.top) / r.height;
      const edge = 0.22;
      if (x > 1 - edge) return 'right';
      if (x < edge) return 'left';
      if (y < edge) return 'top';
      if (y > 1 - edge) return 'bottom';
      return 'center';
    };

    const hitBar = (clientX, clientY, skipId) => {
      for (const bar of pane.querySelectorAll('.dock-bar')) {
        if (skipId && bar.dataset.id === skipId) continue;
        const r = bar.getBoundingClientRect();
        if (clientX >= r.left && clientX <= r.right && clientY >= r.top && clientY <= r.bottom) return bar;
      }
      return null;
    };

    const paintDrop = (clientX, clientY, skipId) => {
      pane.classList.remove('marble-drop-right', 'marble-drop-left', 'marble-drop-top', 'marble-drop-bottom');
      for (const bar of pane.querySelectorAll('.dock-bar')) bar.classList.remove('marble-drop-swap');
      if (clientX == null) return;
      const bar = hitBar(clientX, clientY, skipId);
      if (bar) {
        bar.classList.add('marble-drop-swap');
        return;
      }
      const side = dropSide(clientX, clientY);
      if (side && side !== 'center') pane.classList.add(`marble-drop-${side}`);
    };

    const slotOf = (id) => {
      if (!id) return null;
      if (convo.getAttribute('conversation') === id) return 'primary';
      const index = dock.extras.findIndex((item) => item.id === id);
      return index >= 0 ? index : null;
    };

    const writeSlot = (slot, id) => {
      if (slot === 'primary') {
        if (id) convo.setAttribute('conversation', id);
        else convo.removeAttribute('conversation');
        return;
      }
      if (typeof slot === 'number' && dock.extras[slot]) dock.extras[slot].id = id;
    };

    const focusSlot = (slot, id) => {
      dock.focus = slot;
      openId = id;
      if (id) {
        remember(OPEN_KEY, id);
        document.body.setAttribute('data-open', 'true');
      }
      rememberDock();
      paintOpen();
    };

    const paintBar = (bar, id) => {
      if (!bar) return;
      bar.dataset.id = id || '';
      const summary = summaries.get(id) ?? {};
      bar.querySelector('.dock-title').textContent = summary.title || 'Untitled';
      const link = bar.querySelector('.dock-target');
      const target = targets.get(id) || summary.target || '';
      if (target) {
        link.hidden = false;
        link.textContent = target;
        const href = window.marble?.href?.(target);
        if (href) link.href = href;
        else link.removeAttribute('href');
      } else {
        link.hidden = true;
        link.textContent = '';
        link.removeAttribute('href');
      }
    };

    const paintBars = () => {
      paintBar(pane.querySelector(':scope > .dock-bar'), convo.getAttribute('conversation'));
      dock.extras.forEach((extra, index) => {
        const bar = pane.querySelector(`.dock-leaf:nth-child(${index + 1}) .dock-bar`);
        paintBar(bar, extra.id);
      });
      paintChrome();
    };

    /** Only the focused pane carries the status line, the workdir path and the
     *  agent pickers. They are identical on every pane in a folder, so the
     *  others would spend a third of their height repeating them. */
    const paintChrome = () => {
      if (!dock.extras.length) {
        convo.setAttribute('data-chrome', 'pane');
        return;
      }
      convo.setAttribute('data-chrome', dock.focus === 'primary' ? 'pane' : 'tile');
      dock.extras.forEach((extra, index) => {
        extra.el?.setAttribute('data-chrome', dock.focus === index ? 'pane' : 'tile');
      });
    };

    const lastTarget = (detail) => {
      const events = detail.events ?? [];
      for (let i = events.length - 1; i >= 0; i--) {
        const target = events[i].context?.target;
        if (events[i].type === 'user' && target) return target;
      }
      const turns = detail.turns ?? [];
      for (let i = turns.length - 1; i >= 0; i--) {
        const target = turns[i].context?.target;
        if (target) return target;
      }
      return null;
    };

    const fillChrome = async (id) => {
      ensurePrimaryBar();
      paintBars();
      if (!id || !agent) return;
      try {
        const detail = await agent.conversation(id);
        const target = lastTarget(detail) ?? detail.meta?.target;
        if (target) targets.set(id, target);
      } catch { /* header still has the title */ }
      if (openId !== id && convo.getAttribute('conversation') !== id && !dock.extras.some((item) => item.id === id)) return;
      paintBars();
    };

    const makeBar = (slot) => {
      const bar = document.createElement('div');
      bar.className = 'dock-bar';
      bar.dataset.slot = String(slot);
      bar.setAttribute('data-marble-transient', '');
      bar.innerHTML = BAR_MARKUP;
      bar.querySelector('.dock-close').addEventListener('click', (event) => {
        event.stopPropagation();
        closeSlot(bar.dataset.slot === 'primary' ? 'primary' : Number(bar.dataset.slot));
      });
      bar.addEventListener('pointerdown', (event) => {
        if (event.target.closest('a, button')) return;
        const id = bar.dataset.id;
        if (!id) return;
        focusSlot(bar.dataset.slot === 'primary' ? 'primary' : Number(bar.dataset.slot), id);
      });
      bindPaneDrag(bar, () => bar.dataset.id);
      return bar;
    };

    const ensurePrimaryBar = () => {
      convo.setAttribute('data-chrome', 'pane');
      let bar = pane.querySelector(':scope > .dock-bar');
      if (!bar) {
        bar = makeBar('primary');
        convo.before(bar);
      }
      bar.dataset.slot = 'primary';
      return bar;
    };

    const closeSlot = (slot) => {
      if (slot === 'primary') {
        if (dock.extras.length) {
          const next = dock.extras[0];
          convo.setAttribute('conversation', next.id);
          dock.extras = dock.extras.slice(1);
          focusSlot('primary', next.id);
          applyDock();
          fillChrome(next.id);
        } else {
          open(null);
        }
        return;
      }
      dock.extras = dock.extras.filter((_, index) => index !== slot);
      if (dock.focus === slot) dock.focus = 'primary';
      else if (typeof dock.focus === 'number' && dock.focus > slot) dock.focus -= 1;
      rememberDock();
      applyDock();
      const stay = dock.focus === 'primary' ? convo.getAttribute('conversation') : dock.extras[dock.focus]?.id;
      if (stay) {
        openId = stay;
        remember(OPEN_KEY, stay);
        paintOpen();
      }
    };

    const applyDock = () => {
      ensurePrimaryBar();
      const extras = pane.querySelector('.dock-extras');
      const gutter = pane.querySelector('.dock-gutter');
      if ((document.body.getAttribute('data-view') || 'library') === 'focus') {
        extras?.replaceChildren();
        gutter?.remove();
        pane.removeAttribute('data-dock');
        pane.removeAttribute('data-dock-primary');
        paintBars();
        return;
      }
      if (!dock.extras.length) {
        pane.removeAttribute('data-dock');
        pane.removeAttribute('data-dock-primary');
        gutter?.remove();
        extras?.remove();
        pane.style.removeProperty('--dock-a');
        pane.style.removeProperty('--dock-b');
        paintBars();
        return;
      }
      pane.setAttribute('data-dock', dock.dir);
      pane.setAttribute('data-dock-primary', dock.primary);
      pane.style.setProperty('--dock-a', `${dock.sizes[0]}fr`);
      pane.style.setProperty('--dock-b', `${dock.sizes[1]}fr`);
      let split = gutter;
      if (!split) {
        split = document.createElement('div');
        split.className = 'dock-gutter';
        split.setAttribute('data-marble-transient', '');
        split.addEventListener('pointerdown', (event) => {
          if (event.button !== 0) return;
          event.preventDefault();
          split.setPointerCapture(event.pointerId);
          const vertical = dock.dir === 'col';
          const box = pane.getBoundingClientRect();
          const move = (e) => {
            const t = vertical ? (e.clientY - box.top) / box.height : (e.clientX - box.left) / box.width;
            const a = Math.min(0.8, Math.max(0.2, t));
            dock.sizes = [a, 1 - a];
            pane.style.setProperty('--dock-a', `${dock.sizes[0]}fr`);
            pane.style.setProperty('--dock-b', `${dock.sizes[1]}fr`);
          };
          const up = (e) => {
            split.releasePointerCapture(e.pointerId);
            split.removeEventListener('pointermove', move);
            split.removeEventListener('pointerup', up);
            rememberDock();
          };
          split.addEventListener('pointermove', move);
          split.addEventListener('pointerup', up);
        });
        pane.append(split);
      }
      let host = extras;
      if (!host) {
        host = document.createElement('div');
        host.className = 'dock-extras';
        host.setAttribute('data-marble-transient', '');
        pane.append(host);
      }
      host.replaceChildren();
      dock.extras.forEach((extra, index) => {
        const leaf = document.createElement('div');
        leaf.className = 'dock-leaf';
        const bar = makeBar(index);
        const view = document.createElement('marble-conversation');
        view.setAttribute('data-marble-transient', '');
        view.setAttribute('data-chrome', 'pane');
        if (extra.id) view.setAttribute('conversation', extra.id);
        extra.el = view;
        leaf.addEventListener('pointerdown', () => {
          if (!extra.id) return;
          focusSlot(index, extra.id);
          fillChrome(extra.id);
        });
        leaf.append(bar, view);
        host.append(leaf);
        paintBar(bar, extra.id);
      });
      paintBars();
    };

    const swapIds = (a, b) => {
      const sa = slotOf(a);
      const sb = slotOf(b);
      if (sa == null || sb == null || sa === sb) return false;
      writeSlot(sa, b);
      writeSlot(sb, a);
      focusSlot(sb, a);
      rememberDock();
      applyDock();
      fillChrome(a);
      fillChrome(b);
      return true;
    };

    const splitWith = (id, side) => {
      if (narrowView.matches || reduceMotion.matches) {
        open(id);
        return;
      }
      const dir = (side === 'left' || side === 'right') ? 'row' : 'col';
      const primary = (side === 'right' || side === 'bottom') ? 'start' : 'end';
      if (slotOf(id) != null) {
        dock.dir = dir;
        dock.primary = primary;
        focusSlot(slotOf(id), id);
        rememberDock();
        applyDock();
        fillChrome(id);
        return;
      }
      if (!dock.extras.length) {
        dock.dir = dir;
        dock.primary = primary;
        dock.extras = [{ id }];
        dock.sizes = [0.58, 0.42];
        dock.focus = 0;
      } else if (dock.extras.length < 3) {
        dock.extras.push({ id });
        dock.focus = dock.extras.length - 1;
      } else {
        dock.extras[dock.extras.length - 1].id = id;
        dock.focus = dock.extras.length - 1;
      }
      rememberDock();
      applyDock();
      openId = id;
      remember(OPEN_KEY, id);
      paintOpen();
      fillChrome(id);
    };

    const placeCard = (card, clientX, clientY, grabX = 16, grabY = 16) => {
      card.style.left = `${clientX - grabX}px`;
      card.style.top = `${clientY - grabY}px`;
    };

    const makeCard = (id) => {
      const card = document.createElement('div');
      card.className = 'dock-card';
      card.setAttribute('data-marble-transient', '');
      const summary = summaries.get(id) ?? {};
      const title = document.createElement('span');
      title.className = 'dock-title';
      title.textContent = summary.title || 'Untitled';
      const target = document.createElement('span');
      target.className = 'dock-target';
      target.textContent = targets.get(id) || summary.target || '';
      card.append(title);
      if (target.textContent) card.append(target);
      document.body.append(card);
      return card;
    };

    const bindPaneDrag = (el, idOf) => {
      el.addEventListener('pointerdown', (event) => {
        if (event.button !== 0 || event.target.closest('a, input, textarea, button, .manage')) return;
        if (narrowView.matches || reduceMotion.matches) return;
        if (!document.body.hasAttribute('data-open')) return;
        const src = el.getBoundingClientRect();
        let grabX = event.clientX - src.left;
        let grabY = event.clientY - src.top;
        const origin = { x: event.clientX, y: event.clientY, id: idOf(), started: false };
        if (!origin.id) return;
        let done = false;
        let card = null;
        el.setPointerCapture?.(event.pointerId);
        const move = (e) => {
          if (done) return;
          if (!origin.started && Math.hypot(e.clientX - origin.x, e.clientY - origin.y) < 8) return;
          origin.started = true;
          if (!card) card = makeCard(origin.id);
          placeCard(card, e.clientX, e.clientY, grabX, grabY);
          paintDrop(e.clientX, e.clientY, origin.id);
        };
        const up = (e) => {
          if (done) return;
          done = true;
          document.removeEventListener('pointermove', move);
          document.removeEventListener('mousemove', move);
          document.removeEventListener('pointerup', up);
          document.removeEventListener('mouseup', up);
          document.removeEventListener('pointercancel', up);
          try { el.releasePointerCapture?.(e.pointerId); } catch { /* already released */ }
          card?.remove();
          paintDrop(null);
          if (!origin.started) return;
          suppressConvClick = true;
          setTimeout(() => { suppressConvClick = false; }, 0);
          const over = hitBar(e.clientX, e.clientY, origin.id);
          if (over?.dataset.id) {
            if (!swapIds(origin.id, over.dataset.id)) open(origin.id);
            return;
          }
          const side = dropSide(e.clientX, e.clientY);
          if (side && side !== 'center') splitWith(origin.id, side);
          else open(origin.id);
        };
        document.addEventListener('pointermove', move);
        document.addEventListener('mousemove', move);
        document.addEventListener('pointerup', up);
        document.addEventListener('mouseup', up);
        document.addEventListener('pointercancel', up);
      });
    };

    const bindConvDrag = (el) => bindPaneDrag(el, () => el.dataset.id);

    const typingIn = () => {
      const host = document.activeElement;
      const inner = host?.shadowRoot?.activeElement ?? host;
      if (!inner || inner === document.body || inner === document.documentElement) return false;
      if (inner === search || inner.closest?.('input.search')) return true;
      if (inner.isContentEditable) return true;
      const tag = inner.tagName;
      return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT';
    };

    const closeRowMenus = () => {
      for (const menu of document.querySelectorAll('.conv .manage .menu')) menu.remove();
      for (const btn of document.querySelectorAll('.conv .manage .more')) btn.setAttribute('aria-expanded', 'false');
    };

    const successorOf = (id) => {
      const view = document.body.getAttribute('data-view') || 'library';
      const order = view === 'board'
        ? boardOrder()
        : [...list.querySelectorAll(':scope > .conv')];
      const alive = (el) => {
        const summary = summaries.get(el.dataset.id);
        return Boolean(summary) && !summary.archived && el.dataset.id !== id;
      };
      const idx = order.findIndex((el) => el.dataset.id === id);
      if (idx >= 0) {
        for (let i = idx + 1; i < order.length; i++) if (alive(order[i])) return order[i].dataset.id;
        for (let i = idx - 1; i >= 0; i--) if (alive(order[i])) return order[i].dataset.id;
      }
      return order.find(alive)?.dataset.id ?? null;
    };

    const archiveConversation = async (id) => {
      const summary = summaries.get(id);
      const filing = !summary?.archived;
      const wasOpen = openId === id;
      const nextId = filing && wasOpen ? successorOf(id) : openId;
      const meta = await agent.archive(id, filing);
      upsert(meta);
      if (wasOpen && meta.archived) await open(nextId);
    };

    const fillRowMenu = async (el) => {
      closeRowMenus();
      const id = el.dataset.id;
      const summary = summaries.get(id);
      const more = el.querySelector('.more');
      const menu = document.createElement('div');
      menu.className = 'menu';
      menu.setAttribute('role', 'menu');
      const add = (label, act, run) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.dataset.act = act;
        btn.setAttribute('role', 'menuitem');
        btn.textContent = label;
        btn.addEventListener('click', async (event) => {
          event.stopPropagation();
          closeRowMenus();
          try { await run(); } catch (err) { btn.textContent = err.message; }
        });
        menu.append(btn);
      };
      add(summary?.archived ? 'Unarchive' : 'Archive', summary?.archived ? 'unarchive' : 'archive', () => archiveConversation(id));
      if (summary?.needsReview) {
        add('Mark reviewed', 'reviewed', () => agent.markReviewed(id));
      }
      el.querySelector('.manage').append(menu);
      more?.setAttribute('aria-expanded', 'true');
      let detail = null;
      try { if (agent) detail = await agent.conversation(id); } catch { /* archive still works */ }
      if (!menu.isConnected) return;
      const turn = undoable(detail?.turns);
      if (turn) add('Undo last turn', 'undo', async () => { await agent.undo(turn.id); if (openId === id) fillChrome(id); });
      for (const provider of labels.values()) {
        if (!provider.installed || !provider.signedIn || provider.id === summary?.provider) continue;
        add('Continue in ' + (provider.label ?? provider.id), 'handoff-' + provider.id, async () => {
          await open(await agent.handoff(id, provider.id));
        });
      }
    };

    const upsert = (summary) => {
      if (!summary?.id) return;
      summaries.set(summary.id, summary);
      let el = nodes.get(summary.id);
      if (!el) {
        el = document.createElement('div');
        el.className = 'conv';
        el.dataset.id = summary.id;
        el.setAttribute('role', 'listitem');
        el.tabIndex = 0;
        el.innerHTML = '<span class="dot" aria-hidden="true"></span><span class="body"><span class="title"></span><span class="target"></span><span class="tags"></span><span class="meta"><span class="badge"></span><span class="activity"></span></span></span><span class="age"></span><div class="manage"><button type="button" class="more" aria-label="Manage conversation" aria-haspopup="menu" aria-expanded="false"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="3.5" cy="8" r="1.3" fill="currentColor"/><circle cx="8" cy="8" r="1.3" fill="currentColor"/><circle cx="12.5" cy="8" r="1.3" fill="currentColor"/></svg></button></div>';
        const openRow = () => {
          if (suppressConvClick) return;
          if ((document.body.getAttribute('data-view') || 'library') === 'board') openBoardPanel();
          open(el.dataset.id);
        };
        el.addEventListener('click', (event) => {
          if (event.target.closest('.manage')) return;
          openRow();
        });
        el.addEventListener('keydown', (event) => {
          if (event.target.closest('.manage')) return;
          if (event.key !== 'Enter' && event.key !== ' ') return;
          event.preventDefault();
          openRow();
        });
        el.querySelector('.more').addEventListener('click', (event) => {
          event.stopPropagation();
          if (el.querySelector('.manage .menu')) closeRowMenus();
          else fillRowMenu(el);
        });
        bindConvDrag(el);
        nodes.set(summary.id, el);
      }
      paintRow(el, summary);
      place(el);
      el.hidden = !matches(summary);
      el.classList.toggle('marble-open', summary.id === openId);
      if (summary.id === openId) fillChrome(summary.id);
      paintFolderRail();
      paintFocus();
    };

    const undoable = (turns) => {
      for (let i = (turns ?? []).length - 1; i >= 0; i--) {
        const turn = turns[i];
        if (turn.status === 'completed' && turn.applied && !turn.undoneAt) return turn;
      }
      return null;
    };

    const showEmpty = (text = 'Pick a conversation, or ask below to start one.') => {
      const hint = pane.querySelector('.pane-hint p');
      if (hint) hint.textContent = text;
    };

    async function open(id) {
      if (id) {
        const existing = slotOf(id);
        if (existing != null) {
          focusSlot(existing, id);
          if (!summaries.has(id) && agent) {
            try { upsert((await agent.conversation(id)).meta); } catch { /* opened from a stale id */ }
          }
          if (summaries.get(id)?.needsReview) agent.markReviewed(id).catch(() => {});
          await fillChrome(id);
          const focused = existing === 'primary' ? convo : dock.extras[existing]?.el;
          focused?.focusInput?.();
          return;
        }
      }
      openId = id;
      remember(OPEN_KEY, id);
      if (id) document.body.setAttribute('data-open', 'true');
      else document.body.removeAttribute('data-open');
      if (!id) {
        convo.removeAttribute('conversation');
        dock.extras = [];
        dock.focus = 'primary';
        rememberDock();
        applyDock();
      } else if (typeof dock.focus === 'number' && dock.extras[dock.focus]) {
        dock.extras[dock.focus].id = id;
        dock.extras[dock.focus].el?.setAttribute('conversation', id);
        rememberDock();
        applyDock();
      } else {
        convo.setAttribute('conversation', id);
        dock.focus = 'primary';
      }
      if (id && !summaries.has(id) && agent) {
        try { upsert((await agent.conversation(id)).meta); } catch { /* opened from a stale id */ }
      }
      if (id && summaries.get(id)?.needsReview) agent.markReviewed(id).catch(() => {});
      paintOpen();
      ensurePrimaryBar();
      if (!id) {
        showEmpty();
        return;
      }
      await fillChrome(id);
      const focused = typeof dock.focus === 'number' ? dock.extras[dock.focus]?.el : convo;
      focused?.focusInput?.();
    }

    const playFlip = (first, ordered) => {
      flipAnims = [];
      ordered.forEach((el, index) => {
        const from = first.get(el);
        if (!from) return;
        const to = el.getBoundingClientRect();
        const dx = from.left - to.left;
        const dy = from.top - to.top;
        const sx = to.width ? from.width / to.width : 1;
        const sy = to.height ? from.height / to.height : 1;
        if (Math.abs(dx) < 0.5 && Math.abs(dy) < 0.5 && Math.abs(sx - 1) < 0.02 && Math.abs(sy - 1) < 0.02) return;
        el.classList.add('marble-flip');
        const anim = el.animate(
          [
            { transform: `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})` },
            { transform: 'none' },
          ],
          {
            duration: FLIP_MS,
            easing: FLIP_EASE,
            delay: Math.min(index, 7) * STAGGER_MS,
            fill: 'both',
          },
        );
        flipAnims.push(anim);
        anim.finished.then(() => {
          el.classList.remove('marble-flip');
          flipAnims = flipAnims.filter((a) => a !== anim);
        }, () => {
          el.classList.remove('marble-flip');
        });
      });
    };

    const setView = (next) => {
      if (!VIEW_ORDER.includes(next)) return;
      remember(VIEW_KEY, next);
      const current = document.body.getAttribute('data-view') || 'library';
      if (current === next) {
        deriveView();
        return;
      }

      const applyLayout = () => {
        document.body.setAttribute('data-view', next);
        deriveView();
        if (next === 'library') closeBoardPanel();
        if (current === 'focus' && next !== 'focus') leaveFocusView();
        placeAll();
        paintFocus();
        if (next === 'focus') startFocusDecay();
        else stopFocusDecay();
      };

      const crossfade = () => {
        cancelFlip();
        const gen = ++fadeGen;
        cancelViewFades();
        document.body.setAttribute('data-crossfade', '1');
        void document.body.offsetWidth;
        const incoming = shellFor(next);
        const outgoing = shellFor(current);
        // The outgoing shell is started before applyLayout so it fades showing
        // the layout it actually had. Starting it afterwards dissolves the new
        // layout into itself, which reads as a flicker rather than a leave.
        const fadeOut = outgoing.animate([{ opacity: 1 }, { opacity: 0 }], {
          duration: reduceMotion.matches ? 150 : Math.round(VIEW_MS * 0.4),
          easing: reduceMotion.matches ? 'linear' : VIEW_EASE,
          fill: 'both',
        });
        applyLayout();
        // Offset, not simultaneous: two shells crossing at 0.5 opacity let the
        // page background show through the middle of every view switch.
        const fadeIn = incoming.animate([{ opacity: 0 }, { opacity: 1 }], {
          duration: reduceMotion.matches ? 150 : Math.round(VIEW_MS * 0.7),
          delay: reduceMotion.matches ? 0 : Math.round(VIEW_MS * 0.3),
          easing: reduceMotion.matches ? 'linear' : VIEW_EASE,
          fill: 'both',
        });
        Promise.all([fadeIn.finished.catch(() => {}), fadeOut.finished.catch(() => {})]).then(() => {
          if (gen !== fadeGen) return;
          document.body.removeAttribute('data-crossfade');
          fadeIn.cancel();
          fadeOut.cancel();
        });
      };

      if (reduceMotion.matches || narrowView.matches || !isListBoard(current) || !isListBoard(next)) {
        crossfade();
        return;
      }

      // Visual rects include an in-flight transform, so this is current
      // progress. Cancel the old FLIP and retarget from that snapshot —
      // reverse-to-completion would rewind and fight the new layout.
      const first = captureRects();
      const staggerFromBoard = current === 'board' ? boardOrder() : null;
      cancelFlip();
      cancelViewFades();
      applyLayout();
      const ordered = next === 'board' ? boardOrder() : (staggerFromBoard ?? [...list.querySelectorAll('.conv')]);
      playFlip(first, ordered);
    };

    const loadArchived = async () => {
      if (!agent) return;
      try {
        for (const summary of await agent.conversations({ archived: true })) upsert(summary);
      } catch { /* listing failed; the live stream still fills what it can */ }
    };

    const load = async () => {
      if (!agent) return;
      try {
        for (const summary of await agent.conversations()) upsert(summary);
        if (filter === 'archived') await loadArchived();
      } catch { /* same as loadArchived */ }
      applyFilters();
    };

    const setFilter = async (next) => {
      filter = next;
      deriveFilters();
      if (next === 'archived') await loadArchived();
      applyFilters();
    };

    const startNew = async () => {
      if (!agent) {
        showEmpty('This host is not running agents. Restart with MARBLE_DRIVE_AGENTS=1.');
        return;
      }
      if (!labels.size) {
        try {
          for (const provider of await agent.providers()) labels.set(provider.id, provider);
        } catch (err) {
          showEmpty(err.message);
          return;
        }
      }
      const providers = [...labels.values()].filter((p) => p.installed && p.signedIn);
      const preferred = (cli !== 'all' ? providers.find((p) => p.id === cli) : null)
        ?? providers.find((p) => p.default) ?? providers[0];
      if (!preferred) {
        showEmpty('No agent is ready on this machine. npm run agents -- providers says why.');
        return;
      }
      try {
        await open(await agent.start({ provider: preferred.id }));
      } catch (err) {
        showEmpty(err.message);
      }
    };

    viewButtons.forEach((btn) => btn.addEventListener('click', () => setView(btn.dataset.view)));
    filterButtons.forEach((btn) => btn.addEventListener('click', () => setFilter(btn.dataset.filter)));
    narrowView.addEventListener('change', () => {
      if ((document.body.getAttribute('data-view') || 'library') === 'focus') paintFocus();
    });
    cliEl?.addEventListener('click', (event) => {
      const btn = event.target.closest?.('[data-cli]');
      if (btn) setCli(btn.dataset.cli);
    });
    search.addEventListener('input', () => {
      query = search.value.trim().toLowerCase();
      applyFilters();
    });
    document.addEventListener('click', (event) => {
      if (!event.target.closest?.('.manage')) closeRowMenus();
    });
    $('.settings').addEventListener('click', () => window.marble?.agent?.openSettings?.());
    $('.new').addEventListener('click', () => startNew());
    $('.pane .back').addEventListener('click', () => open(null));
    convo.addEventListener('pointerdown', () => {
      if (!dock.extras.length) return;
      dock.focus = 'primary';
      const id = convo.getAttribute('conversation');
      if (!id) return;
      openId = id;
      remember(OPEN_KEY, id);
      rememberDock();
      paintOpen();
      fillChrome(id);
    });
    boardPanel.querySelector('.panel-close').addEventListener('click', () => closeBoardPanel());
    addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key === 'z' && !event.shiftKey) {
        if (typingIn()) return;
        if (lastFolderGesture?.inverse) {
          event.preventDefault();
          const inverse = lastFolderGesture.inverse;
          lastFolderGesture = null;
          inverse().catch(() => {});
        }
        return;
      }
      if (handleFocusKeys(event)) return;
      if (event.key !== 'v' && event.key !== 'V') return;
      if (event.metaKey || event.ctrlKey || event.altKey) return;
      if (event.repeat) return;
      if (typingIn()) return;
      event.preventDefault();
      const view = document.body.getAttribute('data-view') || 'library';
      setView(nextView(view));
    });

    const restoreOpen = () => {
      // Re-set rather than open(): register runs once at boot with openId
      // still null, and open(null) would wipe marble-agents:open before load
      // restores it. focusInput on restore is a later polish.
      if (openId) document.body.setAttribute('data-open', 'true');
      else document.body.removeAttribute('data-open');
      paintOpen();
      const view = document.body.getAttribute('data-view') || 'library';
      if (view === 'board' && panelOpen) {
        boardPanel.setAttribute('data-open', 'true');
        document.body.setAttribute('data-panel', 'open');
      } else {
        boardPanel.removeAttribute('data-open');
        document.body.removeAttribute('data-panel');
      }
      restoreDock();
    };

    const restoreDock = () => {
      let fileId = openId;
      if (narrowView.matches || reduceMotion.matches) {
        dock.extras = [];
      } else {
        const raw = recalled(DOCK_KEY);
        if (raw) {
          try {
            const saved = JSON.parse(raw);
            dock.dir = saved.dir === 'col' ? 'col' : 'row';
            dock.primary = saved.primary === 'end' ? 'end' : 'start';
            dock.sizes = Array.isArray(saved.sizes) && saved.sizes.length === 2 ? saved.sizes : [0.58, 0.42];
            dock.extras = (saved.extras ?? []).filter(Boolean).slice(0, 3).map((id) => ({ id }));
            dock.focus = saved.focus === 'primary' || typeof saved.focus === 'number' ? saved.focus : 'primary';
            if (saved.file) fileId = saved.file;
          } catch {
            dock.extras = [];
          }
        }
      }
      if (fileId) convo.setAttribute('conversation', fileId);
      else convo.removeAttribute('conversation');
      applyDock();
    };

    const boot = (marble) => {
      // View, pressed chrome, and the open id are this tab's. Filing them
      // would put List|Board, the filter, and which conversation is open
      // into the file for everyone. conversation lives on an addressed
      // <marble-conversation>, so without this a patch strips it and a
      // source.outer of the pane writes it.
      marble.pageOnly?.('data-view', 'aria-pressed', 'conversation', 'data-open', 'data-crossfade', 'data-panel', 'data-dock', 'data-dock-primary', 'data-stack');
      restoreView();
      deriveFilters();
      marble.register?.(() => {
        // pageOnly stops filing data-view; it does not stop syncAttrs copying
        // the file's data-view="library" onto a live board session.
        restoreView();
        placeAll();
        deriveFilters();
        applyFilters();
        restoreOpen();
      });
      const start = async (api) => {
        agent = api;
        let folderPending = null;
        const trackFolderOp = (op) => {
          const pending = Promise.resolve(op()).finally(() => {
            if (folderPending === pending) folderPending = null;
          });
          folderPending = pending;
          return pending;
        };
        const listFolders = api.folders.bind(api);
        const origCreateFolder = api.createFolder.bind(api);
        api.folders = () => (folderPending ? folderPending.then(() => listFolders()) : listFolders());
        api.createFolder = (body) => trackFolderOp(() => origCreateFolder(body));
        try {
          for (const provider of await api.providers()) labels.set(provider.id, provider);
        } catch { /* badges fall back to the provider id */ }
        fillCli();
        api.on('*', (payload) => {
          if (payload?.folders) {
            folderCatalog = payload.folders;
            paintFolderRail();
            repaintRows();
            paintFocus();
            return;
          }
          if (payload?.id) upsert(payload);
        });
        await load();
        try {
          const listed = await api.folders();
          folderCatalog = listed.folders ?? [];
          paintFolderRail();
          repaintRows();
        } catch { /* folders unavailable; rail stays empty */ }
        restoreDock();
        const saved = recalled(OPEN_KEY);
        if (saved) await open(saved);
        addEventListener('marble:agent-settings-saved', async () => {
          try {
            for (const provider of await api.providers()) labels.set(provider.id, provider);
          } catch { /* badges fall back to the provider id */ }
          fillCli();
        });
      };
      if (marble.agent) start(marble.agent);
      else addEventListener('marble:agent', (event) => start(event.detail), { once: true });
    };

    if (window.marble) boot(window.marble);
    else {
      restoreView();
      deriveFilters();
      addEventListener('marble:ready', (event) => boot(event.detail), { once: true });
    }
  })();
</script>
</body>
</html>
