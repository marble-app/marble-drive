<!doctype html>
<html lang="en" data-marble="1">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="marble:capabilities" content="storage; net=none">
<title>__TITLE__</title>
__ICON__
<style>
  /* The shape is Drive's, because the whole point of the comparison is that
     you already know how to use this. The colour is not: these are the
     tokens out of the Marble design system — "UIST warm" in the light,
     "Dusk" after dark. This is the interface, so it sits on the off-white
     paper; the documents it holds are white. What is also not Drive's is
     that every label on this page is a word in the file — the nav, the
     column headings, the name of the drive itself. Type over one and you
     have changed the app. */
  :root {
    --ink: #111111;
    --muted: #5a5a5a;
    --faint: #8a8a8a;
    --line: #ddd9cf;
    --paper: #fafaf7;
    --paper-2: #f3f1ea;
    --paper-3: #eceae1;
    --card: #ffffff;
    --card-rgb: 255, 255, 255;
    --paper-rgb: 250, 250, 247;
    --accent: #9bb6cf;
    --accent-soft: #f1f5f8;
    --accent-ink: #738698;
    --accent-ink-rgb: 115, 134, 152;
    --shadow: 0 1px 3px rgba(74,66,52,.12), 0 4px 8px rgba(74,66,52,.06);
    --shadow-lift: 0 4px 10px rgba(74,66,52,.10), 0 14px 28px rgba(74,66,52,.12);
    --folder: #5a5a5a;
    --radius: 12px;
    /* Motion. One family of curves rather than one per component: a settle
       (things arriving, staying put — critically damped, no overshoot) and a
       snap (the instant a press registers). Nothing here is a spring in the
       physics sense — there is no gesture on this page that needs one, because
       nothing is thrown or flicked — but the curve is shaped like one settling,
       which is what a spring looks like when nothing is fighting it. */
    --settle: cubic-bezier(.22, 1, .36, 1);
    --snap: cubic-bezier(.4, 0, .2, 1);
    --t-fast: 110ms;
    --t: 200ms;
    --t-slow: 340ms;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --ink: #e8e6e1; --muted: #a3a7ab; --faint: #71767a; --line: #2f3438;
      --paper: #16181a; --paper-2: #1e2124; --paper-3: #262a2e; --card: #1c1f22;
      --card-rgb: 28, 31, 34; --paper-rgb: 22, 24, 26;
      --accent: #7fa8c9; --accent-soft: #1d2932; --accent-ink: #9dc0dc; --accent-ink-rgb: 157, 192, 220;
      --folder: #a3a7ab;
      --shadow: 0 1px 3px rgba(0,0,0,.5), 0 4px 8px rgba(0,0,0,.3);
      --shadow-lift: 0 6px 16px rgba(0,0,0,.45), 0 18px 36px rgba(0,0,0,.35);
    }
  }
  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    margin: 0; background: var(--paper); color: var(--ink);
    font: 14px/1.5 "Google Sans", Roboto, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
    display: flex; flex-direction: column;
  }
  [data-marble-editable] { outline: none; border-radius: 4px; transition: background var(--t-fast) var(--snap); }
  [data-marble-editable]:hover { background: var(--accent-soft); }
  [data-marble-editable]:focus { background: var(--card); box-shadow: 0 0 0 1px var(--accent), 0 0 0 4px var(--accent-soft); }
  button { font: inherit; }
  /* Every press answers on the way down, not the way up — a button that waits
     for release to show anything reads as unresponsive even at 60fps. Scale
     rather than color, because a shrink reads as "this is a physical thing"
     regardless of what is under it. */
  button, .item, .crumb, .nav-item, .pin, .starter {
    transition: transform var(--t-fast) var(--snap), background var(--t) var(--settle),
      box-shadow var(--t) var(--settle), border-color var(--t) var(--settle), opacity var(--t) var(--settle);
  }
  button:active { transform: scale(.96); transition-duration: 60ms; }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: .001ms !important; animation-iteration-count: 1 !important;
      transition-duration: .001ms !important; scroll-behavior: auto !important;
    }
  }

  /* ------------------------------------------------------------------ topbar */
  /* A floating material rather than an opaque strip: the page shows through it
     faintly, which is what tells you it is a layer *above* the content and not
     a wall the content starts below. */
  .topbar {
    display: flex; align-items: center; gap: 1rem; flex: 0 0 auto; position: relative; z-index: 5;
    padding: .55rem 1rem; border-bottom: 1px solid var(--line);
    background: rgba(var(--paper-rgb), .78); backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
  }
  .brand { display: flex; align-items: center; gap: .6rem; min-width: 13rem; }
  .logo {
    width: 1.9rem; height: 1.9rem; display: grid; place-items: center;
    border-radius: 7px; background: var(--accent-ink); color: var(--paper); font-size: .85rem;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.25), 0 1px 2px rgba(0,0,0,.12);
  }
  .brand h1 { font-size: 1.15rem; font-weight: 500; margin: 0; letter-spacing: -.015em; }
  .search { flex: 1 1 auto; max-width: 44rem; }
  .search input {
    width: 100%; padding: .6rem 1rem; border: 1px solid transparent; border-radius: 999px;
    background: var(--paper-3); color: var(--ink); font: inherit; outline: none;
    transition: background var(--t) var(--settle), box-shadow var(--t) var(--settle);
  }
  .search input:focus { background: var(--card); border-color: var(--line); box-shadow: var(--shadow); }
  .status {
    margin-left: auto; display: flex; align-items: center; gap: .5rem;
    font-size: .78rem; color: var(--faint); white-space: nowrap;
  }
  .dot { width: 7px; height: 7px; border-radius: 999px; background: var(--faint); transition: background var(--t) var(--settle), box-shadow var(--t) var(--settle); }
  .status[data-live="1"] .dot { background: var(--accent-ink); box-shadow: 0 0 0 3px rgba(var(--accent-ink-rgb), .18); }

  /* ------------------------------------------------------------------- shell */
  .shell { flex: 1 1 auto; display: flex; min-height: 0; }
  /* One shade back from the page: a sidebar is structure, not content, and
     "material weight encodes hierarchy" is the whole reason it is not simply
     var(--paper) again — the eye should read it as a shelf the main pane sits
     on, not a continuation of the same surface. */
  .side {
    flex: 0 0 15rem; padding: .9rem .75rem 1rem; overflow-y: auto;
    display: flex; flex-direction: column; gap: .35rem; background: var(--paper-2);
  }
  .new {
    display: flex; align-items: center; gap: .55rem; align-self: flex-start;
    padding: .75rem 1.4rem .75rem 1.1rem; margin: 0 0 .9rem .35rem;
    border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--card); color: var(--ink); box-shadow: var(--shadow);
    font-size: .92rem; cursor: pointer;
  }
  .new:hover { background: var(--accent-soft); box-shadow: var(--shadow-lift); transform: translateY(-1px); }
  .new:active { transform: scale(.97) translateY(0); }
  .new .plus { font-size: 1.15rem; line-height: 1; color: var(--accent-ink); }

  .nav { list-style: none; margin: 0; padding: 0; }
  .nav-item {
    display: flex; align-items: center; gap: .75rem;
    padding: .45rem .8rem; border-radius: 999px; cursor: pointer; color: var(--muted);
  }
  .nav-item:hover { background: var(--card); }
  .nav-item:active { transform: scale(.98); }
  /* Which one is current is derived, never stored: it is where you are, not
     something the file knows. The prefix is what tells the carrier the class
     belongs to the page and must survive a reconcile. */
  .nav-item.marble-current { background: var(--accent-soft); color: var(--accent-ink); font-weight: 500; }
  .nav-item .ico { width: 1.1rem; text-align: center; opacity: .9; }
  .side h2 {
    font-size: .7rem; text-transform: uppercase; letter-spacing: .08em;
    color: var(--faint); margin: 1.2rem 0 .35rem .85rem; font-weight: 600;
  }
  .pins { list-style: none; margin: 0; padding: 0; min-height: 1.5rem; }
  .pin {
    display: flex; align-items: center; gap: .6rem; padding: .35rem .8rem;
    border-radius: 999px; color: var(--muted); cursor: pointer; font-size: .88rem;
  }
  .pin:hover { background: var(--card); }
  .pin.marble-missing { opacity: .45; text-decoration: line-through; }
  .quota { margin-top: auto; padding: .8rem .85rem 0; font-size: .75rem; color: var(--faint); }
  .bar { height: 4px; border-radius: 999px; background: var(--line); margin: .4rem 0 .35rem; overflow: hidden; }
  .bar > i { display: block; height: 100%; background: var(--accent-ink); width: 0; }

  /* -------------------------------------------------------------------- main */
  .main {
    flex: 1 1 auto; min-width: 0; margin: 0 .75rem .75rem 0;
    background: var(--card); border-radius: var(--radius);
    display: flex; flex-direction: column; overflow: hidden;
  }
  .crumbs { display: flex; align-items: center; gap: .3rem; padding: 1rem 1.25rem .25rem; flex-wrap: wrap; }
  .crumb {
    appearance: none; border: 0; background: none; cursor: pointer;
    color: var(--muted); font-size: 1.3rem; font-weight: 400; padding: .1rem .3rem; border-radius: 6px;
    letter-spacing: -.01em;
  }
  .crumb:last-child { color: var(--ink); font-weight: 500; }
  .crumb:hover { background: var(--paper-3); }
  .crumbs .sep { color: var(--faint); }

  .toolbar { display: flex; align-items: center; gap: .5rem; padding: .35rem 1.25rem .6rem; }
  .chip {
    appearance: none; display: inline-flex; align-items: center; gap: .4rem;
    padding: .3rem .8rem; border: 1px solid var(--line); border-radius: 999px;
    background: none; color: var(--muted); font-size: .82rem; cursor: pointer;
  }
  .chip:hover { background: var(--paper-3); }
  .toolbar .spacer { margin-left: auto; }
  /* A real segmented control: one pill slides under whichever segment is
     current instead of each button painting its own background. The slide is
     driven from script (it has to measure the button it is aiming at), but the
     easing and the material are the stylesheet's, same as everything else that
     moves on this page. */
  .toggle {
    position: relative; display: inline-flex; border: 1px solid var(--line); border-radius: 999px;
    padding: 2px; background: var(--paper-3);
  }
  .toggle .thumb {
    position: absolute; top: 2px; left: 2px; height: calc(100% - 4px); width: 2rem;
    border-radius: 999px; background: var(--card); box-shadow: var(--shadow);
    transition: transform var(--t-slow) var(--settle), width var(--t-slow) var(--settle);
  }
  .toggle button {
    position: relative; z-index: 1; appearance: none; border: 0; background: none; color: var(--muted);
    padding: .32rem .65rem; cursor: pointer; font-size: .85rem; display: grid; place-items: center;
    transition: color var(--t) var(--settle);
  }
  .toggle button svg { width: 1.05rem; height: 1.05rem; display: block; }
  /* The view is a fact about this Drive, so it lives in one attribute and the
     stylesheet reads it. Nothing derives it, nothing copies it — the thumb's
     position is the one thing here that is neither, because where a pill sits
     under a row of buttons is not something worth a byte in the file. */
  body[data-view="grid"] .toggle [data-set-view="grid"],
  body[data-view="list"] .toggle [data-set-view="list"],
  body[data-view="timeline"] .toggle [data-set-view="timeline"],
  body[data-view="map"] .toggle [data-set-view="map"],
  body[data-view="pulse"] .toggle [data-set-view="pulse"],
  body[data-view="weight"] .toggle [data-set-view="weight"] { color: var(--accent-ink); }

  .listhead {
    display: none; gap: 1rem; padding: .4rem 1.4rem .35rem;
    border-bottom: 1px solid var(--line); color: var(--faint);
    font-size: .75rem; text-transform: uppercase; letter-spacing: .06em;
  }
  /* One track list, shared by the heading and every row, so the columns line
     up without either side knowing about the other. The last track is the row
     menu — a row has five cells in list view and four of them have a heading. */
  body[data-view="list"] .listhead,
  body[data-view="list"] .item { grid-template-columns: 1fr 8rem 9rem 6rem 2.2rem; }
  body[data-view="list"] .listhead { display: grid; }
  .listhead > * { margin: 0; }

  .items { flex: 1 1 auto; overflow-y: auto; padding: .6rem 1rem 2rem; }
  body[data-view="grid"] .items {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); gap: .7rem;
    align-content: start;
  }
  .item { position: relative; cursor: pointer; user-select: none; touch-action: none; }
  /* Every row and card fades and settles into place together rather than
     popping in mid-refresh — a folder that just changed should look like it
     changed, not like it was always like this. `animation-delay` is set per
     item from script, capped low enough that forty rows still finish inside a
     third of a second. */
  .item { animation: arrive var(--t-slow) var(--settle) backwards; }
  @keyframes arrive { from { opacity: 0; transform: translateY(3px) scale(.98); } }
  body[data-view="grid"] .item {
    border: 1px solid var(--line); border-radius: var(--radius); padding: .7rem .8rem;
    background: var(--card);
  }
  body[data-view="grid"] .item:hover {
    background: var(--paper-3); border-color: color-mix(in srgb, var(--accent-ink) 30%, var(--line));
    box-shadow: var(--shadow-lift); transform: translateY(-2px);
  }
  body[data-view="grid"] .item:active { transform: translateY(-2px) scale(.98); }
  body[data-view="grid"] .item .row-meta { display: none; }
  body[data-view="grid"] .item .thumb {
    display: block; height: 7rem; margin: .6rem 0 0; border-radius: 8px;
    background: linear-gradient(160deg, var(--paper) 0%, var(--paper-2) 100%); border: 1px solid var(--line);
    overflow: hidden; position: relative; color: var(--faint); font-size: .72rem;
  }
  /* A thin bar of the accent, proportional to how much of this document is —
     nodes for a doc, nothing for a folder. Free of a second request or a real
     thumbnail: it is drawn from numbers the listing already carries, so a
     heavier document reads as heavier before you have opened it. */
  .item .thumb .weight {
    position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: var(--accent-ink);
    opacity: .55; transform-origin: left; transform: scaleX(var(--w, 0)); z-index: 2;
    transition: transform var(--t-slow) var(--settle);
  }
  /* A document draws itself. The tile mounts a sandboxed, script-free iframe of
     the real file — blown up and scaled back down — so what is in the tile is
     what is in the document, not a guess at it. It is mounted only as the tile
     nears the viewport, and the glyph shows until it loads. */
  .item .thumb .peek { position: absolute; inset: 0 0 3px 0; overflow: hidden; display: grid; place-items: center; background: var(--card); }
  .item .thumb .peek iframe {
    position: absolute; top: 0; left: 0; width: 500%; height: 500%;
    border: 0; transform: scale(.2); transform-origin: top left;
    background: #fff; opacity: 0; transition: opacity var(--t-slow) var(--settle); pointer-events: none;
  }
  .item .thumb .peek.marble-is-loaded iframe { opacity: 1; }
  .item .thumb .peek.marble-is-loaded .big { display: none; }
  /* A folder draws what it holds: one cell per child, coloured by kind, so
     "mostly documents", "a nest of folders" and "empty" are all visible without
     opening it. */
  .item .thumb .mini {
    position: absolute; inset: 0 0 3px 0; padding: .55rem;
    display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: 1fr;
    gap: .32rem; align-content: start;
  }
  .item .thumb .mini .cell { border-radius: 3px; background: var(--paper-3); min-height: .85rem; }
  .item .thumb .mini .cell.is-doc { background: var(--accent); }
  .item .thumb .mini .cell.is-folder { background: var(--folder); opacity: .45; }
  .item .thumb .mini .cell.is-empty { grid-column: 1 / -1; background: none; }
  .item .thumb .big { display: block; color: var(--folder); }
  .item[data-kind="doc"] .thumb .big { color: var(--accent-ink); }
  .item .thumb .big .glyph { width: 2.5rem; height: 2.5rem; }
  .item .thumb .cap {
    position: absolute; left: 0; right: 0; bottom: 3px; padding: .28rem .5rem; z-index: 1;
    background: linear-gradient(transparent, var(--card) 55%);
    max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  body[data-view="list"] .items { padding: 0 0 2rem; }
  body[data-view="list"] .item {
    display: grid; gap: 1rem; align-items: center;
    padding: .5rem 1.4rem; border-bottom: 1px solid var(--line);
  }
  body[data-view="list"] .item:hover { background: var(--paper-3); }
  body[data-view="list"] .item:active { transform: scale(.995); }
  body[data-view="list"] .item .thumb { display: none; }

  .item .name { display: flex; align-items: center; gap: .6rem; min-width: 0; }
  .item .name .ico { flex: 0 0 auto; display: flex; color: var(--folder); }
  .item[data-kind="doc"] .name .ico { color: var(--accent-ink); }
  /* One shape for a thing you go into, another for a thing you open. The two
     glyphs these replaced were both boxes, which is the same as no answer —
     and the kind of a row is the first thing you ask of it, before the name. */
  .glyph { width: 1.15rem; height: 1.15rem; display: block; flex: 0 0 auto; }
  .pin .ico { display: flex; color: var(--folder); }
  .pin[data-kind="doc"] .ico { color: var(--accent-ink); }
  .item .name b { font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .item .row-meta { color: var(--faint); font-size: .82rem; white-space: nowrap; }
  /* What a drop would land in. One rule rather than one per target, because a
     row, a breadcrumb and a nav entry all mean the same thing when something is
     hovering over them — and the crumbs and the nav had no highlight at all. */
  .marble-drop { outline: 2px solid var(--accent-ink); outline-offset: -2px; border-radius: 8px; }
  .item.marble-lifting { opacity: .45; }
  /* Picked is the page's answer to "which one", not the file's. A selection is
     where your attention is and it dies with the tab, so it is a class on a
     transient row and never an op. Prefixed so a reconcile leaves it alone. */
  .item.marble-picked { background: var(--accent-soft); }
  .item.marble-picked .name b { color: var(--accent-ink); }
  .item.marble-picked .more { opacity: 1; }
  body[data-view="grid"] .item.marble-picked { border-color: var(--accent-ink); }
  body[data-view="grid"] .item.marble-picked:hover,
  body[data-view="list"] .item.marble-picked:hover { background: var(--accent-soft); }
  .item .more {
    position: absolute; top: .4rem; right: .4rem; width: 1.7rem; height: 1.7rem;
    border: 0; border-radius: 999px; background: none; color: var(--muted);
    cursor: pointer; opacity: 0;
  }
  body[data-view="list"] .item .more { position: static; opacity: .5; justify-self: end; }
  .item:hover .more { opacity: 1; }
  .item .more:hover { background: var(--line); transform: scale(1.08); }
  .item .more:active { transform: scale(.92); }

  .empty { padding: 4rem 1.5rem; text-align: center; color: var(--faint); }
  .empty strong { display: block; font-size: 1rem; color: var(--muted); margin-bottom: .3rem; font-weight: 500; }

  /* ------------------------------------------------------------- the timeline */
  /* Everything below the crumbs and the toolbar is still `.items`, still full
     of `.item` — the pick, the menu, the keyboard, Enter and Escape all keep
     working unmodified. What changes is what an item *looks like* and what the
     folder hands it: grid and list draw one level of the tree; the timeline
     draws every document under it, because a folder doesn't have a day it
     happened on and a document does. */
  body[data-view="timeline"] .items { padding: .4rem 1.5rem 3rem 3rem; }
  .tgroup {
    position: relative; margin: 1.7rem 0 .5rem; padding-left: .1rem;
    font-size: .72rem; text-transform: uppercase; letter-spacing: .08em;
    color: var(--faint); font-weight: 600;
  }
  .tgroup:first-child { margin-top: .3rem; }
  /* Scoped to the row's own class rather than the view attribute: a timeline
     row is reused verbatim inside the Pulse detail panel below, and it has to
     look like itself there too. */
  .item.trow {
    position: relative; display: flex; align-items: center; gap: .85rem;
    padding: .5rem .6rem .5rem .1rem; border-radius: 10px;
  }
  .item.trow::before {
    /* One continuous spine behind every row and every header, whichever
       document is picked. A single element the height of the list rather than
       a border per row, so it reads as one thread through time and not a
       fence between entries. */
    content: ''; position: absolute; left: -1.62rem; top: -.35rem; bottom: -.35rem; width: 2px;
    background: var(--line);
  }
  .item.trow:hover { background: var(--paper-3); }
  .item.trow .tdot {
    position: absolute; left: -1.87rem; width: .55rem; height: .55rem; border-radius: 999px;
    background: var(--accent-ink); box-shadow: 0 0 0 3px var(--paper-2);
  }
  .item.trow .tdot.marble-fresh {
    animation: pulse-dot 2.2s var(--settle) infinite;
  }
  @keyframes pulse-dot {
    0%, 100% { box-shadow: 0 0 0 3px var(--paper-2), 0 0 0 3px rgba(var(--accent-ink-rgb), 0); }
    50% { box-shadow: 0 0 0 3px var(--paper-2), 0 0 0 7px rgba(var(--accent-ink-rgb), .28); }
  }
  .item.trow .ico { flex: 0 0 auto; display: flex; color: var(--folder); }
  .item.trow[data-kind="doc"] .ico { color: var(--accent-ink); }
  .item.trow .tname { min-width: 0; flex: 1 1 auto; display: flex; flex-direction: column; gap: .05rem; }
  .item.trow .tname b {
    font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .item.trow .tname small { color: var(--faint); font-size: .76rem; }
  .item.trow .tmeta {
    flex: 0 0 auto; color: var(--faint); font-size: .8rem; white-space: nowrap; font-variant-numeric: tabular-nums;
  }
  .item.trow .more { position: static; opacity: .5; }
  .item.trow .thumb { display: none; }

  /* ------------------------------------------------------------------ the map */
  /* The shape of a folder rather than a manifest of it: what is here, how
     folders relate to what holds them, and which of them is heavy — the same
     bytes and node counts `weigh` already reports, spent on geometry instead
     of a sentence. Nothing here is content; close the tab and reopen and it is
     recomputed, same as the grid is. */
  body[data-view="map"] .items { position: relative; overflow: hidden; padding: 0; }
  .orbit-wrap { position: absolute; inset: 0; display: grid; place-items: center; }
  .orbit-center {
    position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center;
    justify-content: center; gap: .15rem; width: 7.5rem; height: 7.5rem; border-radius: 999px;
    text-align: center; padding: .5rem; background: var(--card); border: 1px solid var(--line);
    box-shadow: var(--shadow-lift); color: var(--muted);
  }
  .orbit-center .ico { color: var(--folder); }
  .orbit-center .ico .glyph { width: 1.4rem; height: 1.4rem; }
  .orbit-center b { color: var(--ink); font-weight: 500; font-size: .88rem; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .orbit-center small { color: var(--faint); font-size: .74rem; }
  .ring {
    position: absolute; top: 50%; left: 50%; border: 1px dashed var(--line); border-radius: 999px;
    width: calc(var(--r) * 2); height: calc(var(--r) * 2); margin-left: calc(var(--r) * -1); margin-top: calc(var(--r) * -1);
    opacity: .6; pointer-events: none;
  }
  /* The disk drifts, once around every few minutes — slow enough that it never
     reads as "spinning", only as "not a photograph". `@property` is what lets
     a child cancel a value its rotating ancestor is still animating: --spin is
     declared an angle and marked to inherit, so every node downstream can read
     the live value and subtract it back out to stay upright while its
     *position* keeps revolving for free. Where a browser has never heard of
     @property, --spin simply never becomes 360deg and the disk sits still —
     a map that does not turn is still a map. */
  @property --spin { syntax: '<angle>'; inherits: true; initial-value: 0deg; }
  .orbit { position: absolute; inset: 0; transform: rotate(var(--spin)); animation: drift 240s linear infinite; }
  @keyframes drift { to { --spin: 360deg; } }
  .item.node {
    position: absolute; top: 50%; left: 50%; width: var(--size); height: var(--size);
    margin-left: calc(var(--size) / -2); margin-top: calc(var(--size) / -2);
    transform: rotate(var(--angle)) translate(var(--radius)) rotate(calc(-1 * var(--angle) - var(--spin)));
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .25rem;
    text-align: center; padding: .3rem; border-radius: 999px;
    background: var(--card); border: 1px solid var(--line); box-shadow: var(--shadow);
    opacity: var(--fresh, 1);
  }
  .item.node:hover { box-shadow: var(--shadow-lift); border-color: var(--accent-ink); z-index: 3; opacity: 1; }
  .item.node:active { transform: rotate(var(--angle)) translate(var(--radius)) rotate(calc(-1 * var(--angle) - var(--spin))) scale(.94); }
  .item.node .ico { color: var(--folder); }
  .item.node[data-kind="doc"] .ico { color: var(--accent-ink); }
  .item.node .ico .glyph { width: 1.2rem; height: 1.2rem; }
  .item.node b {
    font-weight: 500; font-size: .74rem; max-width: calc(var(--size) * 1.7); overflow: hidden;
    text-overflow: ellipsis; white-space: nowrap; position: absolute; top: 100%; margin-top: .3rem;
    color: var(--muted); background: color-mix(in srgb, var(--paper) 75%, transparent); padding: 0 .2rem; border-radius: 4px;
  }
  /* Present, not deleted: a node still needs Rename, Move, Pin, Trash — it
     only needs them to stay out of the way of a shape that is mostly circle. */
  .item.node .more {
    position: absolute; top: -.3rem; right: -.3rem; width: 1.5rem; height: 1.5rem;
    background: var(--card); border: 1px solid var(--line); opacity: 0;
  }
  .item.node:hover .more, .item.node:focus-within .more { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .orbit { animation: none; } }

  /* ---------------------------------------------------------------- the pulse */
  /* A calendar of activity, one square per day — the same question the
     timeline answers, asked the other way around. The timeline is for "what
     did I touch"; this is for "when was I actually in here", which a list of
     forty rows cannot show you at a glance and a grid of ninety squares can. */
  body[data-view="pulse"] .items { padding: 1.4rem 1.6rem 2rem; }
  .pulse-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .pulse-head b { font-weight: 500; font-size: .95rem; }
  .pulse-head span { color: var(--faint); font-size: .78rem; }
  .pulse-grid { display: grid; grid-auto-flow: column; grid-template-rows: repeat(7, 1fr); gap: 3px; overflow-x: auto; padding-bottom: .3rem; }
  .pulse-day {
    width: 13px; height: 13px; border-radius: 3px; background: var(--paper-3);
    cursor: pointer; position: relative;
  }
  .pulse-day[data-level="1"] { background: color-mix(in srgb, var(--accent-ink) 28%, var(--paper-3)); }
  .pulse-day[data-level="2"] { background: color-mix(in srgb, var(--accent-ink) 55%, var(--paper-3)); }
  .pulse-day[data-level="3"] { background: color-mix(in srgb, var(--accent-ink) 80%, var(--paper-3)); }
  .pulse-day[data-level="4"] { background: var(--accent-ink); }
  .pulse-day:hover { outline: 2px solid var(--accent-ink); outline-offset: 1px; }
  .pulse-day.marble-picked { outline: 2px solid var(--ink); outline-offset: 1px; }
  .pulse-legend { display: flex; align-items: center; gap: .3rem; margin-top: .6rem; color: var(--faint); font-size: .74rem; }
  .pulse-legend i { width: 11px; height: 11px; border-radius: 3px; background: var(--paper-3); display: inline-block; }
  .pulse-legend i[data-level="1"] { background: color-mix(in srgb, var(--accent-ink) 28%, var(--paper-3)); }
  .pulse-legend i[data-level="2"] { background: color-mix(in srgb, var(--accent-ink) 55%, var(--paper-3)); }
  .pulse-legend i[data-level="3"] { background: color-mix(in srgb, var(--accent-ink) 80%, var(--paper-3)); }
  .pulse-legend i[data-level="4"] { background: var(--accent-ink); }
  /* Left padding wide enough that a reused timeline row's spine and dot —
     both positioned outside its own left edge — land inside the scroll
     container instead of under the row before it. */
  .pulse-detail { margin-top: 1.4rem; border-top: 1px solid var(--line); padding: .8rem 0 0 2rem; }
  .pulse-detail h4 { margin: 0 0 .5rem; font-size: .82rem; font-weight: 500; color: var(--muted); }
  .pulse-detail .empty { padding: 1rem 0; text-align: left; }

  /* --------------------------------------------------------------- the weight */
  /* The map answers "where" by shape; this answers "which ones" by rank —
     the same numbers `weigh` reports, sorted worst-first so the one document
     worth doing something about is always the top row. */
  body[data-view="weight"] .items { padding: .5rem 1.4rem 2rem; }
  body[data-view="weight"] .item {
    position: relative; display: flex; align-items: center; gap: .85rem;
    padding: .5rem 0; border-bottom: 1px solid var(--line);
  }
  body[data-view="weight"] .item:hover { background: var(--paper-3); }
  .wrank { flex: 0 0 auto; width: 1.4rem; text-align: right; color: var(--faint); font-size: .78rem; font-variant-numeric: tabular-nums; }
  .witem-ico { flex: 0 0 auto; display: flex; color: var(--folder); }
  .item[data-kind="doc"] .witem-ico { color: var(--accent-ink); }
  .wname { flex: 0 0 auto; width: 12rem; min-width: 0; }
  .wname b { display: block; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .wname small { display: block; color: var(--faint); font-size: .76rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .wbar { flex: 1 1 auto; height: 8px; border-radius: 999px; background: var(--paper-3); overflow: hidden; min-width: 3rem; }
  .wbar i {
    display: block; height: 100%; border-radius: inherit; background: var(--accent-ink);
    transform-origin: left; transform: scaleX(var(--w, 0)); transition: transform var(--t-slow) var(--settle);
  }
  .wmeta { flex: 0 0 auto; width: 6rem; text-align: right; color: var(--faint); font-size: .82rem; font-variant-numeric: tabular-nums; }
  body[data-view="weight"] .item .more { position: static; opacity: .5; }

  /* ------------------------------------------------------------- the overlays */
  /* The New menu. It used to be a sheet across the foot of the window, which
     put the choice as far from the button that summons it as the screen
     allows. Now it is a popover hung under the New button — the row menu's
     shape, with room for each starter to say what it is. Script places it from
     the button's rect; the look is here. */
  /* Materialize rather than fade or `display` toggle: a popover that only
     flips opacity reads as a layer that was already there, and `display: none`
     gives a transition nothing to animate from. So it stays in the render
     tree, unreachable and invisible when closed (`pointer-events: none`,
     `opacity: 0`), and grows from the corner nearest the button that opened it
     — `transform-origin` is set from script, once, per opening, the same idea
     as anchoring a menu to its trigger. */
  .sheet {
    position: fixed; z-index: 30; pointer-events: none;
    width: 19rem; max-width: calc(100vw - 1rem);
    max-height: calc(100vh - 5rem); overflow-y: auto;
    background: rgba(var(--card-rgb), .88); backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    border: 1px solid var(--line); border-radius: 14px;
    box-shadow: var(--shadow-lift); padding: .4rem;
    transform: scale(.94); opacity: 0;
    transition: transform var(--t) var(--settle), opacity var(--t) var(--settle);
  }
  .sheet[data-open="1"] { pointer-events: auto; transform: none; opacity: 1; }
  .sheet p { margin: .25rem .55rem .4rem; color: var(--faint); font-size: .78rem; line-height: 1.4; }
  .starters { display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: .7rem; }
  .starter {
    text-align: left; padding: .8rem .9rem; border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--card); color: var(--ink); cursor: pointer;
  }
  .starter:hover { background: var(--paper-3); }
  .starter b { display: flex; align-items: center; gap: .5rem; font-weight: 500; margin-bottom: .25rem; }
  .starter i { flex: 0 0 auto; width: .6rem; height: .6rem; border-radius: 3px; background: var(--accent-ink); }
  .starter span { display: block; color: var(--faint); font-size: .8rem; line-height: 1.4; }
  /* In the menu the same starters stack as rows, not a grid of cards: no border
     of their own, the blurb tucked under the title past the swatch. */
  .sheet .starters { display: block; }
  .sheet .starter { border: 0; border-radius: 6px; padding: .5rem .55rem; }
  .sheet .starter b { margin-bottom: .1rem; }
  .sheet .starter b span { color: var(--ink); }
  .sheet .starter .blurb { padding-left: 1.1rem; font-size: .76rem; }

  .menu {
    position: fixed; z-index: 30; pointer-events: none; min-width: 12rem; padding: .35rem;
    background: rgba(var(--card-rgb), .9); backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    border: 1px solid var(--line); border-radius: 10px; box-shadow: var(--shadow-lift);
    transform: scale(.94); opacity: 0;
    transition: transform var(--t) var(--settle), opacity var(--t) var(--settle);
  }
  .menu[data-open="1"] { pointer-events: auto; transform: none; opacity: 1; }
  .menu button {
    display: block; width: 100%; text-align: left; padding: .45rem .7rem;
    border: 0; border-radius: 6px; background: none; color: var(--ink); cursor: pointer; font-size: .88rem;
  }
  .menu button:hover { background: var(--paper-3); }
  .menu button:active { transform: scale(.98); }
  .menu hr { border: 0; border-top: 1px solid var(--line); margin: .3rem 0; }

  .toast {
    position: fixed; left: 1.2rem; bottom: 1.2rem; z-index: 40;
    padding: .65rem 1rem; border-radius: 10px;
    background: rgba(var(--card-rgb), .82); backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    border: 1px solid var(--line); color: var(--ink); font-weight: 500; letter-spacing: .003em;
    font-size: .85rem; box-shadow: var(--shadow-lift); opacity: 0; transform: translateY(.4rem) scale(.98);
    transition: opacity var(--t) var(--settle), transform var(--t) var(--settle); pointer-events: none;
  }
  .toast[data-open="1"] { opacity: 1; transform: none; }

  .ghost {
    position: fixed; z-index: 50; pointer-events: none; padding: .4rem .7rem;
    background: var(--card); border: 1px solid var(--accent-ink); border-radius: 8px;
    box-shadow: var(--shadow-lift); font-size: .85rem; opacity: 0; transform: scale(.9) rotate(-1deg);
    transition: opacity var(--t-fast) var(--settle), transform var(--t-fast) var(--settle);
  }
  .ghost[data-open="1"] { opacity: 1; transform: none; }

  /* A file on its way in from outside. The overlay is the whole window because
     a drop anywhere lands in the folder you are looking at, and it takes no
     pointer events at all — otherwise it would be the thing every dragover
     found, and no row underneath it could ever be a target. */
  .drop {
    position: fixed; inset: .4rem; z-index: 45; pointer-events: none; display: grid; place-items: center;
    border: 2px dashed var(--accent-ink); border-radius: var(--radius);
    background: color-mix(in srgb, var(--accent-soft) 72%, transparent);
    opacity: 0; transform: scale(.99);
    transition: opacity var(--t) var(--settle), transform var(--t) var(--settle);
  }
  .drop[data-open="1"] { opacity: 1; transform: none; }
  .drop b {
    padding: .6rem 1.1rem; border-radius: 999px; font-weight: 500;
    background: var(--card); border: 1px solid var(--accent-ink); color: var(--accent-ink);
    box-shadow: var(--shadow);
  }

  /* The marquee. The rectangle is one div sized from the drag; the lasso is one
     polyline in an SVG that covers the viewport at 1:1 pixels. Both take no
     pointer events, so the rows underneath stay the thing the drag is measured
     against. */
  .band {
    position: fixed; z-index: 35; display: none; pointer-events: none;
    border: 1px solid var(--accent-ink); border-radius: 2px;
    background: color-mix(in srgb, var(--accent-soft) 55%, transparent);
  }
  .band[data-open="1"] { display: block; }
  .lasso { position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 35; display: none; pointer-events: none; }
  .lasso[data-open="1"] { display: block; }
  .lasso polyline {
    fill: color-mix(in srgb, var(--accent-soft) 35%, transparent);
    stroke: var(--accent-ink); stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round;
  }
  /* A drag that starts on empty space must not leave a text selection behind it. */
  body.marble-marqueeing, body.marble-marqueeing * { user-select: none !important; }

  @media (max-width: 52rem) {
    .side { flex-basis: 4.5rem; }
    .side h2, .nav-item span:not(.ico), .pin span:not(.ico), .quota { display: none; }
    .new { padding: .75rem; }
    .new .label { display: none; }
    .brand h1 { display: none; }
    body[data-view="list"] .item,
    body[data-view="list"] .listhead { grid-template-columns: 1fr 7rem 2.2rem; }
    body[data-view="list"] .item > .row-meta.owner,
    body[data-view="list"] .item > .row-meta.size,
    .listhead > .owner, .listhead > .size { display: none; }
  }
</style>
</head>
<body class="drive" data-marble-id="__ID__" data-view="grid">

<header class="topbar" data-marble-id="__ID__">
  <div class="brand" data-marble-id="__ID__">
    <span class="logo" data-marble-id="__ID__" aria-hidden="true">◆</span>
    <h1 data-marble-id="__ID__" data-marble-editable>__TITLE__</h1>
  </div>
  <div class="search" data-marble-transient>
    <input id="q" type="search" placeholder="Search in Drive" autocomplete="off" aria-label="Search in Drive">
  </div>
  <div class="status" id="status" data-marble-transient><span class="dot"></span><span id="status-text">offline</span></div>
</header>

<div class="shell" data-marble-id="__ID__">

  <aside class="side" data-marble-id="__ID__">
    <button class="new" id="new" data-marble-transient><span class="plus">+</span><span class="label">New</span></button>

    <ul class="nav" id="nav" data-marble-id="__ID__" data-marble-sortable="nav">
      <li class="nav-item" data-marble-id="__ID__" data-nav="drive" data-marble-removable>
        <span class="ico" data-marble-id="__ID__">▤</span><span data-marble-id="__ID__" data-marble-editable>My Drive</span>
      </li>
      <li class="nav-item" data-marble-id="__ID__" data-nav="recent" data-marble-removable>
        <span class="ico" data-marble-id="__ID__">◷</span><span data-marble-id="__ID__" data-marble-editable>Recent</span>
      </li>
      <li class="nav-item" data-marble-id="__ID__" data-nav="templates" data-marble-removable>
        <span class="ico" data-marble-id="__ID__">◲</span><span data-marble-id="__ID__" data-marble-editable>Templates</span>
      </li>
      <li class="nav-item" data-marble-id="__ID__" data-nav="trash" data-marble-removable>
        <span class="ico" data-marble-id="__ID__">⌫</span><span data-marble-id="__ID__" data-marble-editable>Trash</span>
      </li>
    </ul>

    <h2 data-marble-id="__ID__" data-marble-editable>Pinned</h2>
    <ul class="pins" id="pins" data-marble-id="__ID__" data-marble-sortable="pins">
      <!-- A pin is a claim this document makes about a folder it cannot see, so
           it is written here in the file and the folder gets the last word on
           whether it still opens. -->
    </ul>

    <div class="quota" data-marble-id="__ID__">
      <div data-marble-id="__ID__" id="weight">—</div>
      <div class="bar" data-marble-id="__ID__"><i id="weight-bar"></i></div>
      <div data-marble-id="__ID__" data-marble-editable>Everything here is a file you can open in a text editor.</div>
    </div>
  </aside>

  <main class="main" data-marble-id="__ID__">
    <div class="crumbs" id="crumbs" data-marble-transient></div>

    <div class="toolbar" data-marble-id="__ID__">
      <button class="chip" id="mk" data-marble-transient>New folder</button>
      <button class="chip" id="up" data-marble-transient>Up</button>
      <span class="spacer"></span>
      <span class="toggle" data-marble-transient>
        <span class="thumb" aria-hidden="true"></span>
        <button data-set-view="grid" title="Grid" aria-label="Grid">
          <svg viewBox="0 0 16 16" aria-hidden="true"><g fill="currentColor">
            <rect x="1.5" y="1.5" width="5.5" height="5.5" rx="1.3"/><rect x="9" y="1.5" width="5.5" height="5.5" rx="1.3"/>
            <rect x="1.5" y="9" width="5.5" height="5.5" rx="1.3"/><rect x="9" y="9" width="5.5" height="5.5" rx="1.3"/>
          </g></svg>
        </button>
        <button data-set-view="list" title="List" aria-label="List">
          <svg viewBox="0 0 16 16" aria-hidden="true"><g fill="currentColor">
            <rect x="1.5" y="2.5" width="13" height="2" rx="1"/><rect x="1.5" y="7" width="13" height="2" rx="1"/><rect x="1.5" y="11.5" width="13" height="2" rx="1"/>
          </g></svg>
        </button>
        <button data-set-view="timeline" title="Timeline" aria-label="Timeline">
          <svg viewBox="0 0 16 16" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
            <path d="M3 1.5v13"/></g><g fill="currentColor">
            <circle cx="3" cy="3.4" r="1.5"/><circle cx="3" cy="8" r="1.5"/><circle cx="3" cy="12.6" r="1.5"/>
            <rect x="6.3" y="2.6" width="8.2" height="1.6" rx=".8" opacity=".85"/>
            <rect x="6.3" y="7.2" width="6" height="1.6" rx=".8" opacity=".85"/>
            <rect x="6.3" y="11.8" width="7.2" height="1.6" rx=".8" opacity=".85"/>
          </g></svg>
        </button>
        <button data-set-view="map" title="Map" aria-label="Map">
          <svg viewBox="0 0 16 16" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.1" opacity=".6">
            <circle cx="8" cy="8" r="6.2"/></g><g fill="currentColor">
            <circle cx="8" cy="8" r="1.9"/><circle cx="13.2" cy="6" r="1.3"/><circle cx="4" cy="2.6" r="1.3"/><circle cx="3.2" cy="12.4" r="1.3"/>
          </g></svg>
        </button>
        <button data-set-view="pulse" title="Pulse" aria-label="Pulse">
          <svg viewBox="0 0 16 16" aria-hidden="true"><g fill="currentColor">
            <rect x="1" y="1" width="3" height="3" rx=".6" opacity=".25"/><rect x="5" y="1" width="3" height="3" rx=".6" opacity=".9"/>
            <rect x="9" y="1" width="3" height="3" rx=".6" opacity=".45"/><rect x="13" y="1" width="2.2" height="3" rx=".6" opacity=".7"/>
            <rect x="1" y="5" width="3" height="3" rx=".6" opacity=".7"/><rect x="5" y="5" width="3" height="3" rx=".6" opacity=".25"/>
            <rect x="9" y="5" width="3" height="3" rx=".6" opacity=".9"/><rect x="13" y="5" width="2.2" height="3" rx=".6" opacity=".45"/>
            <rect x="1" y="9" width="3" height="3" rx=".6" opacity=".45"/><rect x="5" y="9" width="3" height="3" rx=".6" opacity=".7"/>
            <rect x="9" y="9" width="3" height="3" rx=".6" opacity=".25"/><rect x="13" y="9" width="2.2" height="3" rx=".6" opacity=".9"/>
          </g></svg>
        </button>
        <button data-set-view="weight" title="Weight" aria-label="Weight">
          <svg viewBox="0 0 16 16" aria-hidden="true"><g fill="currentColor">
            <rect x="1.3" y="9" width="3" height="6" rx=".8"/><rect x="6.5" y="5" width="3" height="10" rx=".8"/>
            <rect x="11.7" y="1.5" width="3" height="13.5" rx=".8"/>
          </g></svg>
        </button>
      </span>
    </div>

    <div class="listhead" data-marble-id="__ID__">
      <p data-marble-id="__ID__" data-marble-editable>Name</p>
      <p class="owner" data-marble-id="__ID__" data-marble-editable>Nodes</p>
      <p data-marble-id="__ID__" data-marble-editable>Last modified</p>
      <p class="size" data-marble-id="__ID__" data-marble-editable>Size</p>
    </div>

    <div class="items" id="items" data-marble-transient>
      <div class="empty">
        <strong>No host</strong>
        This document is the Drive. Opened on its own it is a page; served by a
        Marble Drive host it is the folder it is sitting in.
      </div>
    </div>
  </main>
</div>

<div class="sheet" id="sheet" data-marble-transient>
  <p>A starter is a document you clone. The copy is yours — including the parts of it you would rather were different.</p>
  <div class="starters" id="starters"></div>
</div>

<div class="menu" id="menu" data-marble-transient></div>
<div class="toast" id="toast" data-marble-transient></div>
<div class="ghost" id="ghost" data-marble-transient></div>
<div class="drop" id="drop" data-marble-transient><b></b></div>

<!-- The marquee. A drag over empty space picks every row it covers; hold Option
     and the same drag becomes a line, and every row the line crosses is picked.
     Both are the page's answer to "which ones", so both are transient and
     neither files an op. -->
<div class="band" id="band" data-marble-transient></div>
<svg class="lasso" id="lasso" data-marble-transient><polyline points=""></polyline></svg>

<script>
  // The Drive's own behaviour.
  //
  // Everything on this page is one of two things, and the split is the whole
  // design. The chrome — the name of the drive, the nav labels, the column
  // headings, the pins — is content: it lives in the file, it is edited with
  // ops, and changing it changes the app for good. The listing is not: it is
  // what the folder currently holds, drawn from `marble.drive.tree()` into a
  // transient container, and never written down. A Drive that stored its own
  // listing would have two answers to "what is in this folder" and would show
  // you the wrong one exactly when it mattered.
  (() => {
    const begin = (marble) => {
      const drive = marble.drive;
      if (!drive) return;

      const $ = (sel) => document.querySelector(sel);
      const items = $('#items');
      const crumbs = $('#crumbs');
      const menu = $('#menu');
      const sheet = $('#sheet');
      const toast = $('#toast');
      const ghost = $('#ghost');
      const dropzone = $('#drop');
      const search = $('#q');
      const status = $('#status');

      // Where you are is not a fact about the file. Two people in one drive are
      // allowed to be in different folders, and writing the current path into
      // the document would move one of them every time the other navigated. It
      // lives in the URL fragment instead, which is what makes a folder
      // linkable without making it shared state.
      let here = decodeURIComponent(location.hash.replace(/^#\/?/, ''));
      let view = 'drive';
      let latest = null;
      let query = '';

      const say = (message) => {
        toast.textContent = message;
        toast.setAttribute('data-open', '1');
        clearTimeout(say.timer);
        say.timer = setTimeout(() => toast.removeAttribute('data-open'), 2600);
      };

      const fail = (err) => say(err?.message ?? String(err));

      const bytes = (n) =>
        n < 1024 ? n + ' B' : n < 1048576 ? (n / 1024).toFixed(0) + ' KB' : (n / 1048576).toFixed(1) + ' MB';

      const ago = (t) => {
        const s = Math.max(0, (Date.now() - t) / 1000);
        if (s < 90) return 'just now';
        if (s < 5400) return Math.round(s / 60) + ' min ago';
        if (s < 172800) return Math.round(s / 3600) + ' hr ago';
        return new Date(t).toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
      };

      const leaf = (path) => path.split('/').pop();

      // A folder is drawn as a folder and a document as a window, because a
      // document here is an app you open. Written down once: the listing draws
      // these and so does a pin, and a pin is markup that goes in the file.
      const ICON = {
        folder:
          '<svg class="glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">' +
          '<path fill="currentColor" d="M1.6 4.1A1.7 1.7 0 0 1 3.3 2.4h2.8c.45 0 .88.18 1.2.5l1 1h3.4a1.7 1.7 0 0 1 1.7 1.7v6.1a1.7 1.7 0 0 1-1.7 1.7H3.3a1.7 1.7 0 0 1-1.7-1.7z"/></svg>',
        doc:
          '<svg class="glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">' +
          '<rect x="2.2" y="2.7" width="11.6" height="10.6" rx="2.1" fill="none" stroke="currentColor" stroke-width="1.3"/>' +
          '<path stroke="currentColor" stroke-width="1.3" d="M2.2 6.2h11.6"/>' +
          '<circle cx="4.6" cy="4.45" r=".78" fill="currentColor"/></svg>',
      };
      const iconFor = (kind) => (kind === 'folder' ? ICON.folder : ICON.doc);

      // ------------------------------------------------------------ the listing

      // Which rows are picked, held as a set of paths rather than elements,
      // because the listing is thrown away and rebuilt on every refresh and a
      // reference would outlive the thing it referred to. One path or many —
      // the area select fills it, a plain click narrows it to one.
      let picked = new Set();

      // Paints a set onto the listing without becoming the selection — the
      // marquee uses this on every move, and commits with pick() on release.
      function paint(set) {
        for (const el of items.querySelectorAll('.item')) {
          el.classList.toggle('marble-picked', set.has(el.dataset.path));
        }
      }

      function pick(paths) {
        picked =
          paths == null ? new Set()
          : typeof paths === 'string' ? new Set([paths])
          : new Set(paths);
        paint(picked);
      }

      // A document's own weight, 0..1, against the heaviest thing in view —
      // drawn as a bar under its thumbnail so "this one is bigger" is visible
      // before you have opened either. Recomputed per draw against whatever
      // is on screen, so it is a comparison within this folder, not an
      // absolute scale that would make a small folder's biggest file look
      // tiny next to the drive's biggest.
      let heaviest = 1;

      function node(entry) {
        const el = document.createElement('div');
        el.className = 'item';
        el.dataset.kind = entry.kind;
        el.dataset.path = entry.path;
        if (picked.has(entry.path)) el.classList.add('marble-picked');
        el.innerHTML =
          '<span class="name"><span class="ico">' +
          iconFor(entry.kind) +
          '</span><b></b></span>' +
          '<span class="row-meta owner"></span>' +
          '<span class="row-meta when"></span>' +
          '<span class="row-meta size"></span>' +
          '<button class="more" aria-label="More">⋮</button>' +
          '<span class="thumb"></span>';

        // The label is the name in the folder, because that is the address —
        // what a link points at and what a move changes. What the document
        // calls itself is its own business and lives in the tooltip, which is
        // where the two are allowed to disagree after a rename.
        el.querySelector('b').textContent = entry.name ?? leaf(entry.path);
        el.title = entry.title && entry.title !== entry.name ? entry.title : '';
        el.querySelector('.owner').textContent = entry.kind === 'doc' ? entry.nodes + ' nodes' : '—';
        el.querySelector('.when').textContent = entry.modified ? ago(entry.modified) : '';
        el.querySelector('.size').textContent = entry.kind === 'doc' ? bytes(entry.bytes) : '';
        fillThumb(el.querySelector('.thumb'), entry);
        el.querySelector('.thumb').insertAdjacentHTML('beforeend', '<span class="weight"></span>');
        el.querySelector('.thumb .weight').style.setProperty(
          '--w', entry.kind === 'doc' ? Math.sqrt((entry.bytes ?? 0) / heaviest).toFixed(3) : 0,
        );
        return el;
      }

      // The tile. A document gets a real, scaled-down view of itself, mounted
      // lazily as it nears the viewport; a folder gets a grid of its children
      // coloured by kind. Both fall back to the glyph — the document until its
      // frame loads, the folder if it holds nothing.
      const peekObserver = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const peek = e.target;
            peekObserver.unobserve(peek);
            const frame = document.createElement('iframe');
            // Empty sandbox: the file renders, its own injected carrier script
            // does not, and the frame gets an origin of its own. A preview is a
            // picture, not a second live copy.
            frame.setAttribute('sandbox', '');
            frame.setAttribute('scrolling', 'no');
            frame.setAttribute('tabindex', '-1');
            frame.setAttribute('aria-hidden', 'true');
            frame.loading = 'lazy';
            frame.addEventListener('load', () => peek.classList.add('marble-is-loaded'));
            frame.src = peek.dataset.src;
            peek.append(frame);
          }
        },
        { rootMargin: '250px' },
      );

      function fillThumb(thumb, entry) {
        if (entry.kind === 'doc') {
          thumb.innerHTML =
            '<span class="peek"><span class="big">' + ICON.doc + '</span></span><span class="cap"></span>';
          thumb.querySelector('.cap').textContent = entry.title || leaf(entry.path);
          const peek = thumb.querySelector('.peek');
          peek.dataset.src = marble.href(entry.path);
          peekObserver.observe(peek);
          return;
        }
        const kids = entry.children ?? [];
        const cells =
          kids
            .slice(0, 9)
            .map((k) => '<i class="cell ' + (k.kind === 'folder' ? 'is-folder' : 'is-doc') + '"></i>')
            .join('') || '<i class="cell is-empty"></i>';
        thumb.innerHTML = '<span class="mini">' + cells + '</span><span class="cap"></span>';
        thumb.querySelector('.cap').textContent = kids.length
          ? kids.length + (kids.length === 1 ? ' item' : ' items')
          : 'empty';
      }

      const flatten = (folder, out = []) => {
        for (const child of folder.children ?? []) {
          out.push(child);
          if (child.kind === 'folder') flatten(child, out);
        }
        return out;
      };

      // A folder's own weight is the sum of what is inside it — `tree()` hands
      // back the whole subtree, so this costs a walk that was already free.
      const weightOf = (entry) =>
        entry.kind === 'doc'
          ? entry.bytes ?? 0
          : flatten(entry).reduce((sum, e) => sum + (e.kind === 'doc' ? e.bytes ?? 0 : 0), 0);

      const mode = () => document.body.getAttribute('data-view') || 'grid';

      function draw() {
        if (!latest) return;
        const m = mode();
        // Timeline and Pulse both ask "when" of documents specifically, so
        // both look through the whole subtree rather than one level — a
        // folder's own modified time is when someone last touched *it*, not a
        // fact about what is inside it. Weight asks "how much", which a
        // folder does have an answer to, so it goes recursive but keeps both
        // kinds. Grid, List and Map all still show one level: what is here.
        const docsBelow = () => flatten(latest).filter((entry) => entry.kind === 'doc');
        const pool = query
          ? flatten(latest).filter((entry) =>
              `${entry.title ?? ''} ${entry.path}`.toLowerCase().includes(query),
            )
          : (m === 'timeline' || m === 'pulse') && view === 'drive'
            ? docsBelow()
            : m === 'weight' && view === 'drive'
              ? flatten(latest)
              : latest.children ?? [];

        items.replaceChildren();
        if (!pool.length) {
          const empty = document.createElement('div');
          empty.className = 'empty';
          empty.innerHTML = query
            ? '<strong>Nothing matches</strong>Try a different word.'
            : '<strong>This folder is empty</strong>Press New to make something, or drop a .mrbl file in from anywhere.';
          items.append(empty);
          return;
        }

        heaviest = Math.max(1, ...pool.map((entry) => (entry.kind === 'doc' ? entry.bytes ?? 0 : 0)));

        if (m === 'timeline') drawTimeline(pool);
        else if (m === 'map') drawMap(pool);
        else if (m === 'pulse') drawPulse(pool);
        else if (m === 'weight') drawWeight(pool);
        else {
          pool.forEach((entry, i) => {
            const el = node(entry);
            el.style.animationDelay = Math.min(i * 16, 260) + 'ms';
            items.append(el);
          });
        }
        // Keep the selection to what is actually on screen — a refresh, a
        // search or a folder change can retire a row that was picked.
        const shown = new Set([...items.querySelectorAll('.item')].map((el) => el.dataset.path));
        for (const path of [...picked]) if (!shown.has(path)) picked.delete(path);
      }

      // ------------------------------------------------------------- timeline

      function bucketLabel(t) {
        const day = (ms) => {
          const d = new Date(ms);
          return new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
        };
        const days = Math.round((day(Date.now()) - day(t)) / 86400000);
        const d = new Date(t);
        if (days <= 0) return 'Today';
        if (days === 1) return 'Yesterday';
        if (days < 7) return d.toLocaleDateString(undefined, { weekday: 'long' });
        if (d.getFullYear() === new Date().getFullYear()) {
          return days < 32
            ? 'Earlier this month'
            : d.toLocaleDateString(undefined, { month: 'long' });
        }
        return d.toLocaleDateString(undefined, { month: 'long', year: 'numeric' });
      }

      function timelineRow(entry, oldest, newest) {
        const el = document.createElement('div');
        el.className = 'item trow';
        el.dataset.kind = entry.kind;
        el.dataset.path = entry.path;
        if (picked.has(entry.path)) el.classList.add('marble-picked');
        el.innerHTML =
          '<span class="tdot"></span><span class="ico"></span>' +
          '<span class="tname"><b></b><small></small></span>' +
          '<span class="tmeta"></span><button class="more" aria-label="More">⋮</button>';
        el.querySelector('.ico').innerHTML = iconFor(entry.kind);
        el.querySelector('b').textContent = entry.name ?? leaf(entry.path);
        el.title = entry.title && entry.title !== entry.name ? entry.title : '';

        const inFolder = entry.folder && entry.folder !== here ? entry.folder.replace(here ? here + '/' : '', '') : '';
        el.querySelector('small').textContent = inFolder ? 'in ' + inFolder : '';

        el.querySelector('.tmeta').textContent = entry.modified
          ? ago(entry.modified) + (entry.kind === 'doc' ? ' · ' + bytes(entry.bytes) : '')
          : '';

        const span = Math.max(1, newest - oldest);
        const fraction = Math.min(1, Math.max(0.3, (entry.modified - oldest) / span));
        const dot = el.querySelector('.tdot');
        dot.style.opacity = fraction.toFixed(2);
        if (Date.now() - (entry.modified ?? 0) < 3600e3) dot.classList.add('marble-fresh');
        return el;
      }

      // Newest first within each day, and each day heading only drawn once —
      // the same grouping a photo library or a chat history uses, because
      // "when did I touch this" is a question about days, not timestamps.
      function drawTimeline(pool) {
        const docs = [...pool].sort((a, b) => (b.modified ?? 0) - (a.modified ?? 0));
        const oldest = Math.min(...docs.map((e) => e.modified ?? Date.now()));
        const newest = Math.max(...docs.map((e) => e.modified ?? Date.now()));
        let lastLabel = null;
        docs.forEach((entry, i) => {
          const label = bucketLabel(entry.modified ?? Date.now());
          if (label !== lastLabel) {
            lastLabel = label;
            const h = document.createElement('h3');
            h.className = 'tgroup';
            h.textContent = label;
            items.append(h);
          }
          const row = timelineRow(entry, oldest, newest);
          row.style.animationDelay = Math.min(i * 14, 260) + 'ms';
          items.append(row);
        });
      }

      // ------------------------------------------------------------------ map

      function mapNode(entry, weight, maxWeight, oldest, newest) {
        const el = document.createElement('div');
        el.className = 'item node';
        el.dataset.kind = entry.kind;
        el.dataset.path = entry.path;
        if (picked.has(entry.path)) el.classList.add('marble-picked');
        el.innerHTML = '<span class="ico"></span><b></b><button class="more" aria-label="More">⋮</button>';
        el.querySelector('.ico').innerHTML = iconFor(entry.kind);
        el.querySelector('b').textContent = entry.name ?? leaf(entry.path);
        el.title = (entry.title && entry.title !== entry.name ? entry.title + ' — ' : '') +
          (entry.kind === 'doc' ? bytes(entry.bytes) : bytes(weight) + ' inside') +
          (entry.modified ? ' · ' + ago(entry.modified) : '');

        const size = 42 + Math.sqrt(weight / Math.max(1, maxWeight)) * 46;
        el.style.setProperty('--size', size.toFixed(0) + 'px');
        const span = Math.max(1, newest - oldest);
        const fresh = Math.min(1, Math.max(0.4, ((entry.modified ?? oldest) - oldest) / span));
        el.style.setProperty('--fresh', fresh.toFixed(2));
        return el;
      }

      // One ring of folders, one of documents, spread evenly by angle and
      // nudged apart so the two rings don't line up radius-for-radius. Sized
      // by weight rather than placed by it — position here answers "what kind
      // is it", not "how big", because angle has no natural order to lend a
      // size to and would just be lying with axes nobody drew.
      function drawMap(children) {
        // `translate()` resolves a percentage against the *moving element's*
        // own box, not the container — a CSS Transforms rule that would have
        // put every node a few px from center regardless of how big the map
        // is. So the radius is measured in pixels, once per draw, against
        // however much room `.items` actually has this time.
        const box = items.getBoundingClientRect();
        const half = Math.max(140, Math.min(box.width, box.height) / 2 - 40);
        const r1 = Math.round(half * 0.52);
        const r2 = Math.round(half * 0.94);

        const wrap = document.createElement('div');
        wrap.className = 'orbit-wrap';
        wrap.innerHTML =
          '<div class="ring" style="--r:' + r1 + 'px"></div><div class="ring" style="--r:' + r2 + 'px"></div>' +
          '<div class="orbit-center"><span class="ico"></span><b></b><small></small></div>' +
          '<div class="orbit"></div>';
        const centerName = here ? leaf(here) : (document.querySelector('.brand h1').textContent.trim() || 'My Drive');
        wrap.querySelector('.orbit-center .ico').innerHTML = iconFor('folder');
        wrap.querySelector('.orbit-center b').textContent = centerName;
        wrap.querySelector('.orbit-center small').textContent =
          children.length + (children.length === 1 ? ' item' : ' items');

        const folders = children.filter((c) => c.kind === 'folder');
        const docs = children.filter((c) => c.kind === 'doc');
        const weights = children.map((c) => weightOf(c));
        const maxWeight = Math.max(1, ...weights);
        const times = children.map((c) => c.modified ?? Date.now());
        const oldest = Math.min(Date.now(), ...times);
        const newest = Math.max(0, ...times);

        const orbit = wrap.querySelector('.orbit');
        const ring = (list, radiusPct, offset) => {
          list.forEach((entry, i) => {
            const angle = (360 / list.length) * i + offset;
            const el = mapNode(entry, weightOf(entry), maxWeight, oldest, newest);
            el.style.setProperty('--angle', angle.toFixed(1) + 'deg');
            el.style.setProperty('--radius', radiusPct);
            orbit.append(el);
          });
        };
        if (folders.length) ring(folders, r1 + 'px', 0);
        if (docs.length) ring(docs, r2 + 'px', 14);

        items.append(wrap);
      }

      // ---------------------------------------------------------------- weight

      // The map answers "where" by shape; this answers "which ones" by rank —
      // the same numbers `weigh` reports, sorted worst-first so the one
      // document actually worth doing something about is always the top row.
      function drawWeight(pool) {
        const ranked = pool
          .map((entry) => ({ entry, w: weightOf(entry) }))
          .sort((a, b) => b.w - a.w)
          .slice(0, 300);
        const max = Math.max(1, ...ranked.map((r) => r.w));

        ranked.forEach(({ entry, w }, i) => {
          const el = document.createElement('div');
          el.className = 'item';
          el.dataset.kind = entry.kind;
          el.dataset.path = entry.path;
          if (picked.has(entry.path)) el.classList.add('marble-picked');
          el.innerHTML =
            '<span class="wrank"></span><span class="witem-ico"></span>' +
            '<span class="wname"><b></b><small></small></span>' +
            '<span class="wbar"><i></i></span><span class="wmeta"></span>' +
            '<button class="more" aria-label="More">⋮</button>';
          el.querySelector('.wrank').textContent = i + 1 + '.';
          el.querySelector('.witem-ico').innerHTML = iconFor(entry.kind);
          el.querySelector('.wname b').textContent = entry.name ?? leaf(entry.path);
          el.title = entry.title && entry.title !== entry.name ? entry.title : '';
          const rel = entry.folder && entry.folder !== here ? entry.folder.replace(here ? here + '/' : '', '') : '';
          el.querySelector('.wname small').textContent =
            entry.kind === 'folder' ? (rel ? 'in ' + rel : 'folder') : rel ? 'in ' + rel : '';
          el.querySelector('.wbar i').style.setProperty('--w', (w / max).toFixed(3));
          el.querySelector('.wmeta').textContent = bytes(w);
          el.style.animationDelay = Math.min(i * 10, 260) + 'ms';
          items.append(el);
        });
      }

      // ----------------------------------------------------------------- pulse

      // A calendar of activity, one square per day — the timeline asked "what
      // did I touch", this asks "when was I actually in here", which a list of
      // rows cannot show at a glance and a grid of squares can.
      function drawPulse(pool) {
        const DAY = 86400000;
        const startOfDay = (t) => {
          const d = new Date(t);
          return new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
        };
        const today = startOfDay(Date.now());

        const byDay = new Map();
        let oldest = today;
        for (const entry of pool) {
          if (!entry.modified) continue;
          const day = startOfDay(entry.modified);
          if (!byDay.has(day)) byDay.set(day, []);
          byDay.get(day).push(entry);
          if (day < oldest) oldest = day;
        }

        // Twenty weeks, GitHub-scale — enough to see a pattern, not so much
        // that a drive's whole history is one illegible strip.
        const spanDays = Math.min(20 * 7, Math.round((today - oldest) / DAY) + 1);
        const firstDay = today - (spanDays - 1) * DAY;
        const gridStart = firstDay - new Date(firstDay).getDay() * DAY;
        const totalDays = Math.round((today - gridStart) / DAY) + 1;
        const totalEdits = [...byDay.values()].reduce((sum, list) => sum + list.length, 0);

        const wrap = document.createElement('div');
        wrap.innerHTML =
          '<div class="pulse-head"><b>Activity</b><span></span></div>' +
          '<div class="pulse-grid"></div>' +
          '<div class="pulse-legend"><span>Less</span>' +
          '<i data-level="0"></i><i data-level="1"></i><i data-level="2"></i><i data-level="3"></i><i data-level="4"></i>' +
          '<span>More</span></div>' +
          '<div class="pulse-detail"></div>';
        wrap.querySelector('.pulse-head span').textContent =
          totalEdits + (totalEdits === 1 ? ' edit' : ' edits') + ' across ' + byDay.size + (byDay.size === 1 ? ' day' : ' days');

        const grid = wrap.querySelector('.pulse-grid');
        for (let i = 0; i < totalDays; i++) {
          const day = gridStart + i * DAY;
          if (day > today) break;
          const entries = byDay.get(day) ?? [];
          const level = !entries.length ? 0 : entries.length === 1 ? 1 : entries.length <= 3 ? 2 : entries.length <= 6 ? 3 : 4;
          const cell = document.createElement('div');
          cell.className = 'pulse-day';
          cell.dataset.day = day;
          cell.setAttribute('data-level', level);
          cell.title =
            new Date(day).toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' }) +
            ' — ' + (entries.length ? entries.length + (entries.length === 1 ? ' edit' : ' edits') : 'nothing');
          grid.append(cell);
        }

        const detail = wrap.querySelector('.pulse-detail');
        grid.addEventListener('click', (event) => {
          const cell = event.target.closest('.pulse-day');
          if (!cell) return;
          for (const el of grid.querySelectorAll('.pulse-day')) el.classList.toggle('marble-picked', el === cell);
          const day = Number(cell.dataset.day);
          const entries = (byDay.get(day) ?? []).slice().sort((a, b) => b.modified - a.modified);
          detail.replaceChildren();
          const h = document.createElement('h4');
          h.textContent = new Date(day).toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric' });
          detail.append(h);
          if (!entries.length) {
            const empty = document.createElement('div');
            empty.className = 'empty';
            empty.innerHTML = 'Nothing touched this day.';
            detail.append(empty);
            return;
          }
          for (const entry of entries) detail.append(timelineRow(entry, day, day + DAY));
        });

        items.append(wrap);
      }

      function drawCrumbs() {
        crumbs.replaceChildren();
        const parts = here ? here.split('/') : [];
        const add = (label, path) => {
          const button = document.createElement('button');
          button.className = 'crumb';
          button.textContent = label;
          button.dataset.path = path;
          button.addEventListener('click', () => go(path));
          crumbs.append(button);
        };
        add(document.querySelector('.brand h1').textContent.trim() || 'My Drive', '');
        let walked = '';
        for (const part of parts) {
          walked = walked ? walked + '/' + part : part;
          const sep = document.createElement('span');
          sep.className = 'sep';
          sep.textContent = '›';
          crumbs.append(sep);
          add(part, walked);
        }
      }

      // A pin is content, so it is read out of the file — but whether it still
      // opens is the folder's answer, and that is derived onto the element
      // rather than written back into it.
      function drawPins() {
        const known = new Set(flatten(root ?? { children: [] }).map((entry) => entry.path));
        for (const pin of document.querySelectorAll('#pins > .pin')) {
          const path = pin.dataset.path;
          pin.classList.toggle('marble-missing', Boolean(path) && known.size > 0 && !known.has(path));
          pin.title = path ? 'Double-click to open ' + path : '';
        }
      }

      function drawNav() {
        for (const item of document.querySelectorAll('#nav > .nav-item')) {
          item.classList.toggle('marble-current', item.dataset.nav === view);
        }
      }

      let root = null;

      async function refresh() {
        try {
          root = await drive.tree('');
          latest = view === 'drive' ? at(root, here) : null;

          if (view === 'recent') latest = { children: flatten(root).filter((e) => e.kind === 'doc').slice(0, 40) };
          if (view === 'trash') latest = { children: (await drive.trash()).map(asTrash) };
          if (view === 'templates') return drawTemplates();

          draw();
          drawCrumbs();
          drawPins();
          weigh();
        } catch (err) {
          fail(err);
        }
      }

      const asTrash = (entry) => ({
        kind: entry.kind,
        path: entry.path,
        title: leaf(entry.path),
        modified: entry.t,
        bytes: 0,
        nodes: 0,
        trashId: entry.id,
      });

      function at(folder, path) {
        if (!path) return folder;
        let node = folder;
        for (const part of path.split('/')) {
          node = (node.children ?? []).find((child) => child.kind === 'folder' && leaf(child.path) === part);
          if (!node) return { children: [] };
        }
        return node;
      }

      async function drawTemplates() {
        const starters = await drive.starters();
        items.replaceChildren();
        const grid = document.createElement('div');
        grid.className = 'starters';
        for (const starter of starters) grid.append(starterButton(starter));
        items.append(grid);
        drawCrumbs();
      }

      function starterButton(starter) {
        const button = document.createElement('button');
        button.className = 'starter';
        button.innerHTML = '<b><i></i><span></span></b><span class="blurb"></span>';
        button.querySelector('i').style.background = starter.accent;
        button.querySelector('b span').textContent = starter.title;
        button.querySelector('.blurb').textContent = starter.blurb;
        button.addEventListener('click', () => make(starter));
        return button;
      }

      async function make(starter) {
        const name = prompt('Name for the new ' + starter.title.toLowerCase(), starter.title.toLowerCase());
        if (!name) return;
        try {
          const made = await drive.create({ path: [here, name].filter(Boolean).join('/'), from: starter.id });
          sheet.removeAttribute('data-open');
          say('Made ' + made.path);
          location.href = made.href;
        } catch (err) {
          fail(err);
        }
      }

      async function weigh() {
        const all = flatten(root ?? { children: [] }).filter((entry) => entry.kind === 'doc');
        const total = all.reduce((sum, entry) => sum + (entry.bytes ?? 0), 0);
        const nodes = all.reduce((sum, entry) => sum + (entry.nodes ?? 0), 0);
        document.querySelector('#weight').textContent =
          all.length + ' documents · ' + bytes(total) + ' · ' + nodes.toLocaleString() + ' addressable nodes';
        // Not a quota — there is no quota. It is the same number the `weigh`
        // command reports, drawn so that a drive getting heavy is visible
        // before it is a problem.
        document.querySelector('#weight-bar').style.width = Math.min(100, (total / 5e7) * 100) + '%';
      }

      // ----------------------------------------------------------- navigation

      // Opening is a folder you go into or a document you leave for — or, held
      // open beside this one, a document you leave a tab running. Named once so
      // the pointer, the keyboard and a modifier key all commit to the same
      // thing rather than three routes that could drift apart.
      function openItem(item, { newTab = false } = {}) {
        if (!item) return;
        if (item.dataset.kind === 'folder') {
          if (newTab) return window.open(location.pathname + '#/' + item.dataset.path, '_blank');
          return go(item.dataset.path);
        }
        if (view === 'trash') return say('Restore it first — it is in the trash.');
        if (newTab) window.open(marble.href(item.dataset.path), '_blank');
        else location.href = marble.href(item.dataset.path);
      }

      function go(path) {
        here = path;
        view = 'drive';
        location.hash = path ? '#/' + path : '';
        drawNav();
        refresh();
      }

      addEventListener('hashchange', () => {
        const wanted = decodeURIComponent(location.hash.replace(/^#\/?/, ''));
        if (wanted !== here) {
          here = wanted;
          refresh();
        }
      });

      // A drag ends in a click, because a pointer that went down and came up
      // over the listing is a click as far as the browser is concerned. Without
      // this, dropping a document into a folder also opened it — the move
      // worked and then the page left before you could see it.
      let dragged = 0;

      // One click says which one, two says go. A row you can name without
      // leaving the folder is what the menu verbs have always wanted — until
      // now the only way to point at a document was to open it. Empty space is
      // an answer too: it means none of them.
      items.addEventListener('click', (event) => {
        if (Date.now() - dragged < 400) return;
        const item = event.target.closest('.item');
        if (!item) return pick(null);
        const more = event.target.closest('.more');
        // Cmd or Shift adds and removes without disturbing the rest — the
        // keyboard half of what the marquee does with a drag.
        if (!more && (event.metaKey || event.ctrlKey || event.shiftKey)) {
          const next = new Set(picked);
          next.delete(item.dataset.path) || next.add(item.dataset.path);
          return pick(next);
        }
        pick(item.dataset.path);
        if (more) openMenu(item, more);
      });

      items.addEventListener('dblclick', (event) => {
        if (Date.now() - dragged < 400) return;
        if (event.target.closest('.more')) return;
        openItem(event.target.closest('.item'), { newTab: event.metaKey || event.ctrlKey });
      });

      // The middle button never fires a click at all — a browser reports it as
      // `auxclick` — so a new tab on the wheel-click a mouse is for has to be
      // heard separately rather than folded into the handler above.
      items.addEventListener('auxclick', (event) => {
        if (event.button !== 1) return;
        const item = event.target.closest('.item');
        if (!item || item.dataset.kind === 'folder') return;
        event.preventDefault();
        openItem(item, { newTab: true });
      });

      document.querySelector('#up').addEventListener('click', () => {
        go(here.includes('/') ? here.slice(0, here.lastIndexOf('/')) : '');
      });

      document.querySelector('#nav').addEventListener('click', (event) => {
        const item = event.target.closest('.nav-item');
        if (!item || !item.dataset.nav) return;
        view = item.dataset.nav;
        if (view === 'drive') return go(here);
        drawNav();
        refresh();
      });

      // A plain click on a pin focuses its label — the pin's name is
      // `data-marble-editable`, and a click that also navigated would either
      // unload the page before a keystroke landed (a document pin) or switch
      // what the main pane is showing out from under you mid-edit (a folder
      // pin). So opening moves to a double click, the same convention the
      // listing already uses, and a plain click is free to just be a click.
      document.querySelector('#pins').addEventListener('click', (event) => {
        const pin = event.target.closest('.pin');
        if (!pin || !pin.dataset.path) return;
        if (!event.metaKey && !event.ctrlKey) return;
        if (pin.dataset.kind === 'folder') return go(pin.dataset.path);
        window.open(marble.href(pin.dataset.path), '_blank');
      });

      document.querySelector('#pins').addEventListener('dblclick', (event) => {
        const pin = event.target.closest('.pin');
        if (!pin || !pin.dataset.path) return;
        if (pin.dataset.kind === 'folder') return go(pin.dataset.path);
        if (event.metaKey || event.ctrlKey) window.open(marble.href(pin.dataset.path), '_blank');
        else location.href = marble.href(pin.dataset.path);
      });

      document.querySelector('#pins').addEventListener('auxclick', (event) => {
        if (event.button !== 1) return;
        const pin = event.target.closest('.pin');
        if (!pin || !pin.dataset.path || pin.dataset.kind === 'folder') return;
        event.preventDefault();
        window.open(marble.href(pin.dataset.path), '_blank');
      });

      search.addEventListener('input', () => {
        query = search.value.trim().toLowerCase();
        draw();
      });

      // ------------------------------------------------------------ the verbs

      document.querySelector('#new').addEventListener('click', async (event) => {
        if (sheet.getAttribute('data-open') === '1') return sheet.removeAttribute('data-open');
        const starters = await drive.starters();
        const grid = document.querySelector('#starters');
        grid.replaceChildren();
        for (const starter of starters) grid.append(starterButton(starter));
        // Hung under the button that opened it, nudged back inside the window at
        // the edges — the same placement the row menu does off its anchor.
        sheet.setAttribute('data-open', '1');
        const box = event.currentTarget.getBoundingClientRect();
        sheet.style.left = Math.max(8, Math.min(box.left, innerWidth - sheet.offsetWidth - 8)) + 'px';
        sheet.style.top = Math.min(box.bottom + 6, innerHeight - sheet.offsetHeight - 8) + 'px';
      });

      document.querySelector('#mk').addEventListener('click', async () => {
        const name = prompt('Name for the new folder');
        if (!name) return;
        try {
          await drive.mkdir([here, name].filter(Boolean).join('/'));
          refresh();
        } catch (err) {
          fail(err);
        }
      });

      function openMenu(item, anchor) {
        const path = item.dataset.path;
        const isFolder = item.dataset.kind === 'folder';
        const trashed = view === 'trash';
        menu.replaceChildren();

        const add = (label, fn) => {
          const button = document.createElement('button');
          button.textContent = label;
          button.addEventListener('click', async () => {
            menu.removeAttribute('data-open');
            try {
              await fn();
            } catch (err) {
              fail(err);
            }
          });
          menu.append(button);
        };

        // A menu on a row that is part of a larger selection speaks for the
        // whole selection — Rename and Move to… stop making sense once there
        // is more than one "it", so the bulk menu only offers what still does.
        const bulk = !trashed && picked.size > 1 && picked.has(path);

        if (trashed) {
          add('Restore', async () => {
            await drive.restore(item.dataset.trashId);
            refresh();
          });
        } else if (bulk) {
          const paths = [...picked];
          const docs = paths.filter((p) => !items.querySelector('.item[data-path="' + CSS.escape(p) + '"]')?.matches('[data-kind="folder"]'));
          if (docs.length) {
            add('Open ' + docs.length + ' in new tabs', () => {
              for (const p of docs) window.open(marble.href(p), '_blank');
            });
          }
          menu.append(document.createElement('hr'));
          add('Move ' + paths.length + ' to trash', trashPicked);
        } else {
          if (!isFolder) {
            add('Open', () => (location.href = marble.href(path)));
            add('Open in new tab', () => window.open(marble.href(path), '_blank'));
          }
          add('Rename…', async () => {
            const name = prompt('New name', leaf(path));
            if (!name || name === leaf(path)) return;
            const parent = path.includes('/') ? path.slice(0, path.lastIndexOf('/')) : '';
            await drive.move(path, [parent, name].filter(Boolean).join('/'));
            refresh();
          });
          add('Move to…', async () => {
            const to = prompt('Folder to move it into (blank for the top)', here);
            if (to === null) return;
            await drive.move(path, [to.trim().replace(/^\/+|\/+$/g, ''), leaf(path)].filter(Boolean).join('/'));
            refresh();
          });
          add(pinned(path) ? 'Unpin' : 'Pin to sidebar', () => togglePin(path, isFolder));
          if (!isFolder) {
            add('Make a copy', async () => {
              await drive.create({ path: path + ' copy', copy: path });
              refresh();
            });
            add('Download (one file)', () => window.open(drive.downloadHref(path), '_blank'));
          }
          menu.append(document.createElement('hr'));
          add('Move to trash', async () => {
            await drive.remove(path);
            refresh();
          });
        }

        const box = anchor.getBoundingClientRect();
        menu.style.left = Math.min(box.left, innerWidth - 220) + 'px';
        menu.style.top = Math.min(box.bottom + 4, innerHeight - 260) + 'px';
        menu.setAttribute('data-open', '1');
      }

      addEventListener('pointerdown', (event) => {
        if (!menu.contains(event.target) && !event.target.closest('.more')) {
          menu.removeAttribute('data-open');
        }
        if (!sheet.contains(event.target) && !event.target.closest('#new')) {
          sheet.removeAttribute('data-open');
        }
      });

      addEventListener('keydown', (event) => {
        // A document in the drive is editable content, and Enter inside it is a
        // paragraph, not a command. Only the page's own chrome gets these keys.
        const typing = event.target?.closest?.(
          'input, textarea, select, [contenteditable="true"], [contenteditable=""], [data-marble-editable]',
        );
        if (typing) return;
        if (event.key === 'Enter') {
          if (picked.size !== 1) return;
          const item = items.querySelector('.item.marble-picked');
          if (!item) return;
          event.preventDefault();
          return openItem(item, { newTab: event.metaKey || event.ctrlKey });
        }
        if ((event.key === 'Backspace' || event.key === 'Delete') && picked.size && view !== 'trash') {
          event.preventDefault();
          return trashPicked();
        }
        if (event.key !== 'Escape') return;
        // Escape undoes the last thing you opened, one layer at a time: the row
        // menu, then the New menu, then the selection itself.
        const layered = menu.getAttribute('data-open') === '1' || sheet.getAttribute('data-open') === '1';
        menu.removeAttribute('data-open');
        sheet.removeAttribute('data-open');
        if (!layered) pick(null);
      });

      // However many are picked, one press throws all of them away — to the
      // trash, not to nowhere, so it costs nothing to be wrong about it.
      async function trashPicked() {
        const paths = [...picked];
        pick(null);
        const results = await Promise.allSettled(paths.map((path) => drive.remove(path)));
        const failed = results.filter((r) => r.status === 'rejected').length;
        refresh();
        if (failed) say(failed + ' of ' + paths.length + ' could not be trashed');
        else say(paths.length === 1 ? 'Moved to trash' : 'Moved ' + paths.length + ' to trash');
      }

      // --------------------------------------------------------------- pinning
      //
      // The one place in this document where the listing and the file meet. A
      // pin is markup, so pinning files an insert and unpinning files a remove,
      // and both are undoable with the same keys as any other edit.

      const pinned = (path) => Boolean(document.querySelector('#pins > .pin[data-path="' + CSS.escape(path) + '"]'));

      function togglePin(path, isFolder) {
        const list = document.querySelector('#pins');
        const already = list.querySelector('.pin[data-path="' + CSS.escape(path) + '"]');

        if (already) {
          const op = { type: 'remove', id: marble.id(already) };
          const inverse = marble.invert(op);
          already.remove();
          if (inverse) marble.record({ redo: [op], undo: [inverse] });
          marble.op(op, { immediate: true });
          return say('Unpinned');
        }

        const id = marble.newId();
        const label = marble.newId();
        const icon = marble.newId();
        const html =
          '<li class="pin" data-marble-id="' + id + '" data-path="' + path + '" data-kind="' +
          (isFolder ? 'folder' : 'doc') + '" data-marble-removable>' +
          '<span class="ico" data-marble-id="' + icon + '">' + iconFor(isFolder ? 'folder' : 'doc') + '</span>' +
          '<span data-marble-id="' + label + '" data-marble-editable>' + leaf(path) + '</span></li>';
        const op = { type: 'insert', html, parentId: marble.id(list), beforeId: null };
        marble.apply(op);
        marble.record({ redo: [op], undo: [{ type: 'remove', id }] });
        marble.op(op, { immediate: true });
        drawPins();
        say('Pinned — the sidebar is part of the file now');
      }

      // ------------------------------------------------------------- the drags
      //
      // Pointer events rather than the drag-and-drop API, for the same reason
      // the sortable affordance is: a finger fires no dragstart, and a Drive you
      // cannot use on a phone is not one you can use.

      let lifting = null;
      let over = null;

      items.addEventListener('pointerdown', (event) => {
        // Timeline and map show you the drive; grid and list are where you
        // rearrange it. A map node's position is a `rotate/translate`, not a
        // place a drop target can be read back from, and a timeline row has
        // no folder under it to drop onto — "Move to…" in the row menu still
        // reaches both.
        if (mode() === 'timeline' || mode() === 'map') return;
        const item = event.target.closest('.item');
        if (!item || event.target.closest('.more') || view === 'trash') return;
        lifting = { item, x: event.clientX, y: event.clientY, moved: false };
      });

      addEventListener('pointermove', (event) => {
        if (!lifting) return;
        const far = Math.hypot(event.clientX - lifting.x, event.clientY - lifting.y) > 6;
        if (!far && !lifting.moved) return;

        if (!lifting.moved) {
          lifting.moved = true;
          lifting.item.classList.add('marble-lifting');
          ghost.textContent = lifting.item.querySelector('b').textContent;
          ghost.setAttribute('data-open', '1');
          lifting.item.setPointerCapture?.(event.pointerId);
        }
        ghost.style.left = event.clientX + 12 + 'px';
        ghost.style.top = event.clientY + 12 + 'px';

        const under = document.elementFromPoint(event.clientX, event.clientY);
        const folder = under?.closest?.('.item[data-kind="folder"], .crumb, .nav-item[data-nav="drive"]');
        if (over !== folder) {
          over?.classList.remove('marble-drop');
          over = folder && folder !== lifting.item ? folder : null;
          over?.classList.add('marble-drop');
        }
      });

      addEventListener('pointerup', async () => {
        if (!lifting) return;
        const { item, moved } = lifting;
        const target = over;
        lifting = null;
        if (moved) dragged = Date.now();
        over?.classList.remove('marble-drop');
        over = null;
        ghost.removeAttribute('data-open');
        item.classList.remove('marble-lifting');
        if (!moved || !target) return;

        const from = item.dataset.path;
        const into = target.classList.contains('item') ? target.dataset.path : (target.dataset.path ?? '');
        try {
          await drive.move(from, [into, leaf(from)].filter(Boolean).join('/'));
          say('Moved into ' + (into || 'My Drive'));
          refresh();
        } catch (err) {
          fail(err);
        }
      });

      // ------------------------------------------------------------ the marquee
      //
      // A drag that starts on empty space picks rows in bulk. Plain, it is a
      // rectangle and every row it covers is picked. With Option held it is a
      // line, and every row the line crosses is picked and stays picked — the
      // "curve select" a rectangle cannot do around a bend. Neither files an
      // op: a selection is where your attention is, and it dies with the tab.
      //
      // Pointer events, like every other drag here, so a finger can do it too.
      // It starts only when the pointer went down on the container and not on
      // a row, which is why it can share `#items` with the lift above.

      const band = $('#band');
      const lasso = $('#lasso');
      const lassoLine = lasso.querySelector('polyline');
      let marquee = null;

      const inRect = (x, y, r) => x >= r.left && x <= r.right && y >= r.top && y <= r.bottom;

      // Do the segments p→q and a→b cross? Enough for "the line went through
      // this row" — collinear grazes are not worth the extra branch.
      function segmentsCross(p, q, a, b) {
        const side = (o, u, v) => (u.x - o.x) * (v.y - o.y) - (u.y - o.y) * (v.x - o.x);
        const d1 = side(a, b, p);
        const d2 = side(a, b, q);
        const d3 = side(p, q, a);
        const d4 = side(p, q, b);
        return (d1 > 0) !== (d2 > 0) && (d3 > 0) !== (d4 > 0);
      }

      // Does the segment p→q touch the rectangle at all — an endpoint inside,
      // or a crossing of any edge.
      function segmentHitsRect(p, q, r) {
        if (inRect(p.x, p.y, r) || inRect(q.x, q.y, r)) return true;
        const c = [
          { x: r.left, y: r.top },
          { x: r.right, y: r.top },
          { x: r.right, y: r.bottom },
          { x: r.left, y: r.bottom },
        ];
        for (let i = 0; i < 4; i++) if (segmentsCross(p, q, c[i], c[(i + 1) % 4])) return true;
        return false;
      }

      const rows = () => [...items.querySelectorAll('.item')];

      // Everything picked before the drag plus everything the drag has caught.
      const paintMarquee = () => paint(new Set([...marquee.base, ...marquee.caught]));

      items.addEventListener('pointerdown', (event) => {
        if (event.button) return;
        if (event.target.closest('.item') || event.target.closest('.more')) return;
        marquee = {
          mode: event.altKey ? 'lasso' : 'rect',
          x0: event.clientX,
          y0: event.clientY,
          points: [{ x: event.clientX, y: event.clientY }],
          // Cmd or Shift keeps what was already picked and adds to it.
          base: new Set(event.metaKey || event.ctrlKey || event.shiftKey ? picked : []),
          caught: new Set(),
          moved: false,
        };
      });

      addEventListener('pointermove', (event) => {
        if (!marquee) return;
        if (!marquee.moved) {
          if (Math.hypot(event.clientX - marquee.x0, event.clientY - marquee.y0) < 4) return;
          marquee.moved = true;
          document.body.classList.add('marble-marqueeing');
        }

        if (marquee.mode === 'rect') {
          const left = Math.min(event.clientX, marquee.x0);
          const top = Math.min(event.clientY, marquee.y0);
          const width = Math.abs(event.clientX - marquee.x0);
          const height = Math.abs(event.clientY - marquee.y0);
          band.style.left = left + 'px';
          band.style.top = top + 'px';
          band.style.width = width + 'px';
          band.style.height = height + 'px';
          band.setAttribute('data-open', '1');
          // The rectangle grows and shrinks, so what it covers is recomputed
          // whole rather than accumulated.
          marquee.caught = new Set();
          const box = { left, top, right: left + width, bottom: top + height };
          for (const el of rows()) {
            const r = el.getBoundingClientRect();
            if (r.left < box.right && r.right > box.left && r.top < box.bottom && r.bottom > box.top) {
              marquee.caught.add(el.dataset.path);
            }
          }
        } else {
          const prev = marquee.points[marquee.points.length - 1];
          const next = { x: event.clientX, y: event.clientY };
          marquee.points.push(next);
          lassoLine.setAttribute('points', marquee.points.map((p) => p.x + ',' + p.y).join(' '));
          lasso.setAttribute('data-open', '1');
          // The line only ever adds: once it has crossed a row, that row is
          // caught for the rest of the gesture.
          for (const el of rows()) {
            if (marquee.caught.has(el.dataset.path)) continue;
            if (segmentHitsRect(prev, next, el.getBoundingClientRect())) marquee.caught.add(el.dataset.path);
          }
        }

        paintMarquee();
      });

      addEventListener('pointerup', () => {
        if (!marquee) return;
        const done = marquee;
        marquee = null;
        band.removeAttribute('data-open');
        band.removeAttribute('style');
        lasso.removeAttribute('data-open');
        lassoLine.setAttribute('points', '');
        document.body.classList.remove('marble-marqueeing');
        if (!done.moved) return;
        // The trailing click on the container would otherwise clear this.
        dragged = Date.now();
        pick(new Set([...done.base, ...done.caught]));
      });

      // -------------------------------------------------------------- the drops
      //
      // A document arriving from outside the drive. This is the one gesture on
      // the page that has to use the HTML5 drag-and-drop API rather than
      // pointer events: a file coming from the desktop is not a pointer the
      // browser will tell us about, it is a `dataTransfer`, and there is no
      // second way to be handed one.
      //
      // Where it lands is the folder under the cursor if there is one, and the
      // folder you are looking at if there is not — the same two answers the
      // internal drag gives, marked the same way, because to a hand they are
      // the same gesture with a different thing in it.

      // A .mrbl is an HTML file, so a document somebody's browser saved under
      // the other extension is not a different document.
      const DOCUMENT = /\.(mrbl|html?)$/i;

      let landing = null;

      const carriesFiles = (event) => [...(event.dataTransfer?.types ?? [])].includes('Files');

      const dropTarget = (node) =>
        view === 'trash'
          ? null
          : (node?.closest?.('.item[data-kind="folder"], .crumb, .nav-item[data-nav="drive"]') ?? null);

      // A crumb and the nav entry both carry the path they stand for, and the
      // root carries none, which is the empty string — My Drive.
      const pathOf = (target) => (target ? (target.dataset.path ?? '') : here);

      function showDrop(target) {
        if (landing !== target) {
          landing?.classList.remove('marble-drop');
          landing = target;
          landing?.classList.add('marble-drop');
        }
        dropzone.querySelector('b').textContent = 'Drop to add to ' + (pathOf(target) || 'My Drive');
        dropzone.setAttribute('data-open', '1');
      }

      function clearDrop() {
        landing?.classList.remove('marble-drop');
        landing = null;
        dropzone.removeAttribute('data-open');
      }

      // Counted rather than latched: a drag across the page enters and leaves
      // every element it passes over, and a single boolean is off again the
      // moment the pointer crosses from the sidebar into a row.
      let incoming = 0;

      // And a watchdog under the count, because a drag cancelled with Escape
      // ends without a `dragleave` and the count never comes back down — which
      // would leave the whole window under an overlay with no way to dismiss
      // it. `dragover` repeats for as long as something is over the page and
      // stops dead when it is not, so its absence is the one reliable ending.
      let waiting = null;
      const stillHere = () => {
        clearTimeout(waiting);
        waiting = setTimeout(() => {
          incoming = 0;
          clearDrop();
        }, 700);
      };

      // On the capture phase, so that a contenteditable label cannot be the
      // one that gets the file. The default action of a drop on this page is
      // always the same and always wrong: navigate away to the file itself.
      const capture = { capture: true };

      addEventListener('dragenter', (event) => {
        if (!carriesFiles(event)) return;
        event.preventDefault();
        incoming += 1;
      }, capture);

      addEventListener('dragleave', (event) => {
        if (!carriesFiles(event)) return;
        incoming = Math.max(0, incoming - 1);
        if (!incoming) clearDrop();
      }, capture);

      addEventListener('dragover', (event) => {
        if (!carriesFiles(event)) return;
        event.preventDefault();
        event.dataTransfer.dropEffect = 'copy';
        incoming = incoming || 1;
        stillHere();
        showDrop(dropTarget(event.target));
      }, capture);

      addEventListener('drop', (event) => {
        if (!carriesFiles(event)) return;
        event.preventDefault();
        const into = pathOf(dropTarget(event.target));
        // Both of these have to be taken now. A DataTransfer is emptied the
        // moment the handler returns, and everything `receive` does after the
        // first await would be reading from something the browser has cleared.
        const entries = [...(event.dataTransfer.items ?? [])]
          .map((item) => item.webkitGetAsEntry?.())
          .filter(Boolean);
        const files = [...(event.dataTransfer.files ?? [])];
        incoming = 0;
        clearTimeout(waiting);
        clearDrop();
        receive(entries, files, into);
      }, capture);

      /** A folder dropped from the desktop is a directory entry, not a file, and
       *  `dataTransfer.files` has nothing in it for one. Walking the entries is
       *  the only way to reach what is inside, and the shape it gives back is
       *  the shape the upload wants: a file, and the folder it belongs in. */
      async function collect(entry, folder, out) {
        if (entry.isFile) {
          out.push({ file: await new Promise((ok, no) => entry.file(ok, no)), folder });
          return;
        }
        if (!entry.isDirectory) return;
        const inside = [folder, entry.name].filter(Boolean).join('/');
        const reader = entry.createReader();
        // `readEntries` answers in batches and says it has finished by
        // answering with none. A folder of 200 documents arrives 100 at a time.
        for (;;) {
          const batch = await new Promise((ok, no) => reader.readEntries(ok, no));
          if (!batch.length) break;
          for (const child of batch) await collect(child, inside, out);
        }
      }

      async function receive(entries, files, into) {
        let dropped = files.map((file) => ({ file, folder: '' }));
        if (entries.length) {
          dropped = [];
          try {
            for (const entry of entries) await collect(entry, '', dropped);
          } catch (err) {
            return fail(err);
          }
        }

        const docs = dropped.filter(({ file }) => DOCUMENT.test(file.name));
        const skipped = dropped.length - docs.length;
        if (!docs.length) {
          return say(skipped ? 'A drive holds documents — nothing else came in' : 'Nothing to add');
        }
        say(docs.length === 1 ? 'Adding ' + docs[0].file.name + '…' : 'Adding ' + docs.length + ' documents…');

        // One at a time, because the host serialises writes per document
        // anyway and because a failure should name the file it was.
        const added = [];
        const refused = [];
        for (const { file, folder } of docs) {
          try {
            added.push(
              await drive.upload({
                folder: [into, folder].filter(Boolean).join('/'),
                name: file.name,
                source: await file.text(),
              }),
            );
          } catch (err) {
            refused.push(file.name + ' — ' + (err?.message ?? err));
          }
        }

        if (added.length) refresh();
        const tally = [];
        if (added.length === 1) tally.push('Added ' + added[0].path);
        else if (added.length) tally.push('Added ' + added.length + ' documents to ' + (into || 'My Drive'));
        if (skipped) tally.push(skipped + (skipped === 1 ? ' other file' : ' other files') + ' left alone');
        if (refused.length) tally.push(refused.length === 1 ? refused[0] : refused.length + ' refused — ' + refused[0]);
        say(tally.join(' · '));
      }

      // ---------------------------------------------------------- the toggles

      const toggle = document.querySelector('.toggle');
      const thumb = toggle.querySelector('.thumb');

      // The pill under the current segment. Measured off the button rather
      // than computed from an index, so it is correct whether four segments
      // are the same width or not, and doesn't have to change if a fifth ever
      // joins them.
      function positionThumb() {
        const current = toggle.querySelector('[data-set-view="' + mode() + '"]');
        if (!current) return;
        thumb.style.width = current.offsetWidth + 'px';
        thumb.style.transform = 'translateX(' + current.offsetLeft + 'px)';
      }

      for (const button of document.querySelectorAll('[data-set-view]')) {
        button.addEventListener('click', () => {
          const next = button.dataset.setView;
          const id = marble.id(document.body);
          if (!id) return;
          // The page moves and the file is told, from the same value — composed
          // here rather than read back off the element. Grid and list share a
          // listing, so switching between them is free; timeline and map are a
          // different shape of the same folder and have to be redrawn.
          const was = document.body.getAttribute('data-view');
          document.body.setAttribute('data-view', next);
          marble.record({
            redo: [{ type: 'setAttr', id, name: 'data-view', value: next }],
            undo: [{ type: 'setAttr', id, name: 'data-view', value: was }],
          });
          marble.op({ type: 'setAttr', id, name: 'data-view', value: next }, { immediate: true });
          positionThumb();
          if (was !== next) draw();
        });
      }

      addEventListener('resize', () => {
        positionThumb();
        if (mode() === 'map') draw();
      });

      // ---------------------------------------------------------- the listening

      drive.on('*', () => {
        if (view === 'templates') return;
        refresh();
      });
      status.setAttribute('data-live', '1');
      document.querySelector('#status-text').textContent = 'live';

      // Re-derive after a reconcile: an edit to this file in another window
      // rewrites the sidebar, and the current-nav class is not in the file.
      marble.register(() => {
        drawNav();
        drawPins();
      });

      drawNav();
      positionThumb();
      refresh();
    };

    if (window.marble?.drive) begin(window.marble);
    else addEventListener('marble:drive', () => begin(window.marble), { once: true });
  })();
</script>

__SCRIPT__
</body>
</html>
