<!doctype html>
<html lang="en" data-marble="1">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="marble:capabilities" content="storage; net=none">
<title>__TITLE__</title>
__ICON__
<style>
  /* The shape is Drive's, because the whole point of the comparison is that
     you already know how to use this. The colour is not: these are the
     tokens out of the Marble design system — "UIST warm" in the light,
     "Dusk" after dark. This is the interface, so it sits on the off-white
     paper; the documents it holds are white. What is also not Drive's is
     that every label on this page is a word in the file — the nav, the
     column headings, the name of the drive itself. Type over one and you
     have changed the app. */
  :root {
    --ink: #111111;
    --muted: #5a5a5a;
    --faint: #8a8a8a;
    --line: #ddd9cf;
    --paper: #fafaf7;
    --paper-2: #f3f1ea;
    --paper-3: #eceae1;
    --card: #ffffff;
    --card-rgb: 255, 255, 255;
    --paper-rgb: 250, 250, 247;
    --accent: #9bb6cf;
    --accent-soft: #f1f5f8;
    --accent-ink: #738698;
    --accent-ink-rgb: 115, 134, 152;
    --shadow: 0 1px 3px rgba(74,66,52,.12), 0 4px 8px rgba(74,66,52,.06);
    --shadow-lift: 0 4px 10px rgba(74,66,52,.10), 0 14px 28px rgba(74,66,52,.12);
    --folder: #5a5a5a;
    --radius: 12px;
    /* Motion. One family of curves rather than one per component: a settle
       (things arriving, staying put — critically damped, no overshoot) and a
       snap (the instant a press registers). Nothing here is a spring in the
       physics sense — there is no gesture on this page that needs one, because
       nothing is thrown or flicked — but the curve is shaped like one settling,
       which is what a spring looks like when nothing is fighting it. */
    --settle: cubic-bezier(.22, 1, .36, 1);
    --snap: cubic-bezier(.4, 0, .2, 1);
    --t-fast: 110ms;
    --t: 200ms;
    --t-slow: 340ms;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --ink: #e8e6e1; --muted: #a3a7ab; --faint: #71767a; --line: #2f3438;
      --paper: #16181a; --paper-2: #1e2124; --paper-3: #262a2e; --card: #1c1f22;
      --card-rgb: 28, 31, 34; --paper-rgb: 22, 24, 26;
      --accent: #7fa8c9; --accent-soft: #1d2932; --accent-ink: #9dc0dc; --accent-ink-rgb: 157, 192, 220;
      --folder: #a3a7ab;
      --shadow: 0 1px 3px rgba(0,0,0,.5), 0 4px 8px rgba(0,0,0,.3);
      --shadow-lift: 0 6px 16px rgba(0,0,0,.45), 0 18px 36px rgba(0,0,0,.35);
    }
  }
  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    margin: 0; background: var(--paper); color: var(--ink);
    font: 14px/1.5 "Google Sans", Roboto, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
    display: flex; flex-direction: column;
  }
  [data-marble-editable] { outline: none; border-radius: 4px; transition: background var(--t-fast) var(--snap); }
  [data-marble-editable]:hover { background: var(--accent-soft); }
  [data-marble-editable]:focus { background: var(--card); box-shadow: 0 0 0 1px var(--accent), 0 0 0 4px var(--accent-soft); }
  button { font: inherit; }
  /* Every press answers on the way down, not the way up — a button that waits
     for release to show anything reads as unresponsive even at 60fps. Scale
     rather than color, because a shrink reads as "this is a physical thing"
     regardless of what is under it. */
  button, .item, .crumb, .nav-item, .pin, .starter {
    transition: transform var(--t-fast) var(--snap), background var(--t) var(--settle),
      box-shadow var(--t) var(--settle), border-color var(--t) var(--settle), opacity var(--t) var(--settle);
  }
  button:active { transform: scale(.96); transition-duration: 60ms; }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: .001ms !important; animation-iteration-count: 1 !important;
      transition-duration: .001ms !important; scroll-behavior: auto !important;
    }
  }

  /* ------------------------------------------------------------------ topbar */
  /* A floating material rather than an opaque strip: the page shows through it
     faintly, which is what tells you it is a layer *above* the content and not
     a wall the content starts below. */
  .topbar {
    display: flex; align-items: center; gap: 1rem; flex: 0 0 auto; position: relative; z-index: 5;
    padding: .55rem 1rem; border-bottom: 1px solid var(--line);
    background: rgba(var(--paper-rgb), .78); backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
  }
  .brand { display: flex; align-items: center; gap: .6rem; min-width: 13rem; }
  .logo {
    width: 1.9rem; height: 1.9rem; display: grid; place-items: center;
    border-radius: 8px; background: var(--accent-ink); color: var(--paper); font-size: .85rem;
  }
  .brand h1 { font-size: 1.15rem; font-weight: 500; margin: 0; letter-spacing: -.015em; }
  .search { flex: 1 1 auto; max-width: 44rem; }
  .search input {
    width: 100%; padding: .6rem 1rem; border: 1px solid transparent; border-radius: 999px;
    background: var(--paper-3); color: var(--ink); font: inherit; outline: none;
    transition: background var(--t) var(--settle), box-shadow var(--t) var(--settle);
  }
  .search input:focus { background: var(--card); border-color: var(--line); box-shadow: var(--shadow); }
  .status {
    margin-left: auto; display: flex; align-items: center; gap: .5rem;
    font-size: .78rem; color: var(--faint); white-space: nowrap;
  }
  .dot { width: 7px; height: 7px; border-radius: 999px; background: var(--faint); transition: background var(--t) var(--settle), box-shadow var(--t) var(--settle); }
  .status[data-live="1"] .dot { background: var(--accent-ink); box-shadow: 0 0 0 3px rgba(var(--accent-ink-rgb), .18); }

  /* ------------------------------------------------------------------- shell */
  .shell { flex: 1 1 auto; display: flex; min-height: 0; }
  /* One shade back from the page: a sidebar is structure, not content, and
     "material weight encodes hierarchy" is the whole reason it is not simply
     var(--paper) again — the eye should read it as a shelf the main pane sits
     on, not a continuation of the same surface. */
  .side {
    flex: 0 0 15rem; padding: .9rem .75rem 1rem; overflow-y: auto;
    display: flex; flex-direction: column; gap: .35rem; background: var(--paper-2);
  }
  .new {
    display: flex; align-items: center; gap: .55rem; align-self: flex-start;
    padding: .75rem 1.4rem .75rem 1.1rem; margin: 0 0 .9rem .35rem;
    border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--card); color: var(--ink); box-shadow: var(--shadow);
    font-size: .92rem; cursor: pointer;
  }
  .new:hover { background: var(--accent-soft); box-shadow: var(--shadow-lift); transform: translateY(-1px); }
  .new:active { transform: scale(.97) translateY(0); }
  .new .plus { font-size: 1.15rem; line-height: 1; color: var(--accent-ink); }

  .nav { list-style: none; margin: 0; padding: 0; }
  .nav-item {
    display: flex; align-items: center; gap: .75rem;
    padding: .45rem .8rem; border-radius: 999px; cursor: pointer; color: var(--muted);
  }
  .nav-item:hover { background: var(--card); }
  .nav-item:active { transform: scale(.98); }
  /* Which one is current is derived, never stored: it is where you are, not
     something the file knows. The prefix is what tells the carrier the class
     belongs to the page and must survive a reconcile. */
  .nav-item.marble-current { background: var(--accent-soft); color: var(--accent-ink); font-weight: 500; }
  .nav-item .ico { width: 1.1rem; text-align: center; opacity: .9; }
  .side h2 {
    font-size: .7rem; text-transform: uppercase; letter-spacing: .08em;
    color: var(--faint); margin: 1.2rem 0 .35rem .85rem; font-weight: 600;
  }
  .pins { list-style: none; margin: 0; padding: 0; min-height: 1.5rem; }
  .pin {
    display: flex; align-items: center; gap: .6rem; padding: .35rem .55rem .35rem .8rem;
    border-radius: 999px; color: var(--muted); font-size: .88rem;
  }
  .pin:hover { background: var(--card); }
  .pin.marble-missing { opacity: .45; text-decoration: line-through; }
  .pin > [data-marble-editable] { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* Opening is a dedicated control so a click on the name can still be a
     rename. The button is derived chrome — same idea as the removable × —
     and is not written into the pin. */
  .pin-open {
    appearance: none; flex: 0 0 auto; width: 1.55rem; height: 1.55rem; padding: 0;
    display: grid; place-items: center; border: 0; border-radius: 8px;
    background: none; color: var(--faint); cursor: pointer;
  }
  .pin:hover .pin-open, .pin:focus-within .pin-open { color: var(--muted); }
  .pin-open:hover, .pin-open:focus-visible { color: var(--accent-ink); background: var(--paper-3); }
  .pin-open:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .pin-open svg { width: .95rem; height: .95rem; display: block; }
  @media (hover: none) { .pin-open { color: var(--muted); } }
  .quota { margin-top: auto; padding: .8rem .85rem 0; font-size: .75rem; color: var(--faint); }
  .bar { height: 4px; border-radius: 999px; background: var(--line); margin: .4rem 0 .35rem; overflow: hidden; }
  .bar > i { display: block; height: 100%; background: var(--accent-ink); width: 0; }

  /* -------------------------------------------------------------------- main */
  .main {
    flex: 1 1 auto; min-width: 0; margin: 0 .75rem .75rem 0;
    background: var(--card); border-radius: var(--radius);
    display: flex; flex-direction: column; overflow: hidden;
  }
  .crumbs { display: flex; align-items: center; gap: .3rem; padding: 1rem 1.25rem .25rem; flex-wrap: wrap; }
  .crumb {
    appearance: none; border: 0; background: none; cursor: pointer;
    color: var(--muted); font-size: 1.3rem; font-weight: 400; padding: .1rem .3rem; border-radius: 8px;
    letter-spacing: -.01em;
  }
  .crumb:last-child { color: var(--ink); font-weight: 500; }
  .crumb:hover { background: var(--paper-3); }
  .crumbs .sep { color: var(--faint); }

  .toolbar { display: flex; align-items: center; gap: .5rem; padding: .35rem 1.25rem .6rem; }
  .chip {
    appearance: none; display: inline-flex; align-items: center; gap: .4rem;
    padding: .3rem .8rem; border: 1px solid var(--line); border-radius: 999px;
    background: none; color: var(--muted); font-size: .82rem; cursor: pointer;
  }
  .chip:hover { background: var(--paper-3); }
  .toolbar .spacer { margin-left: auto; }
  /* A real segmented control: one pill slides under whichever segment is
     current instead of each button painting its own background. The slide is
     driven from script (it has to measure the button it is aiming at), but the
     easing and the material are the stylesheet's, same as everything else that
     moves on this page. */
  .toggle {
    position: relative; display: inline-flex; border: 1px solid var(--line); border-radius: 999px;
    padding: 2px; background: var(--paper-3);
  }
  .toggle .thumb {
    position: absolute; top: 2px; left: 2px; height: calc(100% - 4px); width: 2rem;
    border-radius: 999px; background: var(--card); box-shadow: var(--shadow);
    transition: transform var(--t-slow) var(--settle), width var(--t-slow) var(--settle);
  }
  .toggle button {
    position: relative; z-index: 1; appearance: none; border: 0; background: none; color: var(--muted);
    padding: .32rem .65rem; cursor: pointer; font-size: .85rem; display: grid; place-items: center;
    transition: color var(--t) var(--settle);
  }
  .toggle button svg { width: 1.05rem; height: 1.05rem; display: block; }
  /* The view is a fact about this Drive, so it lives in one attribute and the
     stylesheet reads it. Nothing derives it, nothing copies it — the thumb's
     position is the one thing here that is neither, because where a pill sits
     under a row of buttons is not something worth a byte in the file. */
  body[data-view="grid"] .toggle [data-set-view="grid"],
  body[data-view="list"] .toggle [data-set-view="list"],
  body[data-view="timeline"] .toggle [data-set-view="timeline"],
  body[data-view="map"] .toggle [data-set-view="map"],
  body[data-view="pulse"] .toggle [data-set-view="pulse"],
  body[data-view="weight"] .toggle [data-set-view="weight"] { color: var(--accent-ink); }

  .listhead {
    display: none; gap: 1rem; padding: .4rem 1.4rem .35rem;
    border-bottom: 1px solid var(--line); color: var(--faint);
    font-size: .75rem; text-transform: uppercase; letter-spacing: .06em;
  }
  /* One track list, shared by the heading and every row, so the columns line
     up without either side knowing about the other. The last track is the row
     menu — a row has five cells in list view and four of them have a heading. */
  body[data-view="list"] .listhead,
  body[data-view="list"] .item { grid-template-columns: 1fr 8rem 9rem 6rem 2.2rem; }
  body[data-view="list"] .listhead { display: grid; }
  .listhead > * { margin: 0; }

  .items { flex: 1 1 auto; overflow-y: auto; padding: .6rem 1rem 2rem; }
  body[data-view="grid"] .items {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: .75rem;
    align-content: start;
  }
  .item { position: relative; cursor: pointer; user-select: none; touch-action: none; }
  /* Every row and card fades and settles into place together rather than
     popping in mid-refresh — a folder that just changed should look like it
     changed, not like it was always like this. `animation-delay` is set per
     item from script, capped low enough that forty rows still finish inside a
     third of a second. */
  .item { animation: arrive var(--t-slow) var(--settle) backwards; }
  @keyframes arrive { from { opacity: 0; transform: translateY(3px) scale(.98); } }
  /* Root two — the proportion of a sheet of paper — belongs to the card, not to
     the picture on it. The card is the folder: the thing you see, name, drag
     and open. So the card is the sheet, and the cover takes whatever the name
     row leaves; fixing the card rather than the tile is what makes this one
     rule instead of a number per column count. At four across the cover falls
     out at about sixteen by nine and at six across it barely moves, and the
     folder is the same shape either way. */
  /* Only the plain listing. A folder that draws itself its own way — the days
     gallery, the vision gallery — builds `.item` elements too, and its cards
     are sized by what is in them; handing one a sheet-of-paper ratio made the
     day hero a 1950 x 1380 box with a paragraph at the top of it. */
  body[data-view="grid"] .items:not([data-rep]) .item:not([data-material]) {
    aspect-ratio: 1.41421; display: flex; flex-direction: column;
  }
  body[data-view="grid"] .item {
    border: 1px solid var(--line); border-radius: var(--radius); padding: .65rem .75rem;
    background: var(--card);
  }
  /* Hover darkens the ground and the edge and does nothing else. A card that
     lifts on a shadow is forty cards lifting as the pointer crosses them, and
     the grid never sits still. Press still answers, because that is an act. */
  body[data-view="grid"] .item:hover {
    background: var(--paper-3); border-color: color-mix(in srgb, var(--accent-ink) 34%, var(--line));
  }
  body[data-view="grid"] .item:active { transform: scale(.985); }
  body[data-view="grid"] .item .row-meta { display: none; }
  /* The cover is the rest of the card, so it has no ratio of its own to argue
     about: it is as tall as the card is, less the name. That is what lets it be
     flat — a cover is a band across a folder, and what is drawn on it reads
     wide. The ground under it is one flat tone; a tile is somewhere to put what
     the document is, not a surface to light. */
  body[data-view="grid"] .item .thumb {
    display: block; flex: 1 1 auto; min-height: 0; margin: .55rem 0 0; border-radius: 8px;
    background: var(--paper-2); border: 1px solid var(--line);
    overflow: hidden; position: relative; color: var(--faint); font-size: .72rem;
  }
  /* A thin bar of the accent, proportional to how much of this document is —
     nodes for a doc, nothing for a folder. Free of a second request or a real
     thumbnail: it is drawn from numbers the listing already carries, so a
     heavier document reads as heavier before you have opened it. */
  .item .thumb .weight {
    position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: var(--accent-ink);
    opacity: .55; transform-origin: left; transform: scaleX(var(--w, 0)); z-index: 2;
    transition: transform var(--t-slow) var(--settle);
  }
  /* A document draws itself. The tile mounts a sandboxed, script-free iframe of
     the real file — blown up and scaled back down — so what is in the tile is
     what is in the document, not a guess at it. It is mounted only as the tile
     nears the viewport, and the glyph shows until it loads. */
  .item .thumb .peek { position: absolute; inset: 0 0 3px 0; overflow: hidden; display: grid; place-items: center; background: var(--card); }
  .item .thumb .peek iframe {
    position: absolute; top: 0; left: 0; width: 500%; height: 500%;
    border: 0; transform: scale(.2); transform-origin: top left;
    background: #fff; opacity: 0; transition: opacity var(--t-slow) var(--settle); pointer-events: none;
  }
  .item .thumb .peek.marble-is-loaded iframe { opacity: 1; }
  .item .thumb .peek.marble-is-loaded .big { display: none; }
  /* A folder draws what it holds: mini peeks of documents (same sandboxed
     iframe trick as a doc tile), and a glyph for nested folders — so you see
     the contents, not a kind map of blue and grey blocks. */
  .item .thumb .mini {
    position: absolute; inset: 0 0 3px 0; padding: .4rem;
    display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: 1fr;
    gap: .28rem; align-content: stretch;
  }
  .item .thumb .mini .cell {
    border-radius: 4px; background: var(--paper-3); min-height: 0;
    position: relative; overflow: hidden; display: grid; place-items: center;
  }
  .item .thumb .mini .cell.is-doc { background: var(--card); box-shadow: inset 0 0 0 1px var(--line); }
  /* A folder inside a folder is drawn the way a material is: an outline and its
     glyph. Only a document gets a filled cell, because only a document has
     something to show in it — nine tinted blocks read as nine things to look
     at, and there is nothing in them to look at. */
  .item .thumb .mini .cell.is-folder {
    background: none; color: var(--folder);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--folder) 34%, var(--line));
  }
  /* A material inside a folder, on that folder's tile: present, and flatter
     than the documents beside it. */
  .item .thumb .mini .cell.is-mat {
    background: none; box-shadow: inset 0 0 0 1px var(--line); color: var(--faint);
  }
  .item .thumb .mini .cell.is-mat .mini-ico { opacity: .5; }
  .item .thumb .mini .cell.is-empty { grid-column: 1 / -1; background: none; box-shadow: none; }
  /* How many there are decides how it is cut — one column, two, or three — so
     that the cut lands on the tile's own proportion as often as it can. The
     counts in between would leave a hole at the end of the last row, so the
     last cell takes the hole instead of leaving it. */
  .item .thumb .mini:not(:has(.cell:nth-child(2))) { grid-template-columns: 1fr; }
  .item .thumb .mini:has(.cell:nth-child(2)):not(:has(.cell:nth-child(5))) {
    grid-template-columns: repeat(2, 1fr);
  }
  .item .thumb .mini:has(.cell:nth-child(2)):not(:has(.cell:nth-child(5))) .cell:nth-child(odd):last-child {
    grid-column: span 2;
  }
  .item .thumb .mini:has(.cell:nth-child(5)) .cell:nth-child(3n+1):last-child { grid-column: span 3; }
  .item .thumb .mini:has(.cell:nth-child(5)) .cell:nth-child(3n+2):last-child { grid-column: span 2; }
  .item .thumb .mini .mini-ico { display: flex; color: inherit; opacity: .72; z-index: 0; }
  .item .thumb .mini .mini-ico .glyph { width: 1rem; height: 1rem; }
  .item .thumb .mini .peek { inset: 0; background: var(--card); }
  .item .thumb .mini .peek.marble-is-loaded .mini-ico { display: none; }
  .item .thumb .big { display: block; color: var(--folder); }
  .item[data-kind="doc"] .thumb .big { color: var(--accent-ink); }
  .item .thumb .big .glyph { width: 2.5rem; height: 2.5rem; }
  /* What a tile says about itself, when it is not already saying it: a
     folder's count, a material's kind. Never a document's name — that tile is
     the document. A label in the corner on a chip of the tile's own paper; the
     full-width fade this replaces hid the last row of a folder's contents and
     ended in white across the bottom of every coloured one. */
  .item .thumb .cap {
    position: absolute; left: .35rem; bottom: .35rem; z-index: 1;
    max-width: calc(100% - .7rem); padding: .08rem .36rem; border-radius: 4px;
    background: var(--realm-paper, var(--paper-2));
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  /* Folder tiles wear an identity; nested folders inherit it. The Drive chrome does not. */
  .item[data-realm="research"] {
    --accent: #7aab98; --accent-soft: #ecf3ef; --accent-ink: #2f6f5b;
    --accent-ink-rgb: 47, 111, 91; --folder: #2f6f5b;
    --realm-paper: #f7faf8; --realm-paper-2: #eef5f1; --realm-paper-3: #e4efe9;
  }
  .item[data-realm="fun"] {
    --accent: #e08a6a; --accent-soft: #f8ebe6; --accent-ink: #c45c3e;
    --accent-ink-rgb: 196, 92, 62; --folder: #c45c3e;
    --realm-paper: #fdf7f4; --realm-paper-2: #f8ebe6; --realm-paper-3: #f0d8cf;
  }
  .item[data-realm="days"] {
    --accent: #c4a35a; --accent-soft: #f3eee3; --accent-ink: #4d6a58;
    --accent-ink-rgb: 77, 106, 88; --folder: #6f8f7d;
    --realm-paper: #f7f4ec; --realm-paper-2: #f0ebe0; --realm-paper-3: #e6dfd0;
  }
  .item[data-realm="marble"] {
    --accent: #9bb0c0; --accent-soft: #eef2f5; --accent-ink: #5f7385;
    --accent-ink-rgb: 95, 115, 133; --folder: #7e91a3;
    --realm-paper: #f4f7f9; --realm-paper-2: #e9eef3; --realm-paper-3: #dce4eb;
  }
  .item[data-realm="travel"] {
    --accent: #7aa0b8; --accent-soft: #e8eef3; --accent-ink: #3d6b8a;
    --accent-ink-rgb: 61, 107, 138; --folder: #3d6b8a;
    --realm-paper: #f3f7fa; --realm-paper-2: #e8eef3; --realm-paper-3: #d5e2eb;
  }
  body[data-view="grid"] .item[data-realm] {
    border-color: color-mix(in srgb, var(--accent-ink) 22%, var(--line));
    background: color-mix(in srgb, var(--accent-soft) 45%, var(--card));
  }
  body[data-view="grid"] .item[data-realm] .thumb {
    border-color: color-mix(in srgb, var(--accent-ink) 18%, var(--line));
    background: var(--realm-paper);
  }
  .item[data-realm] .name .ico { color: var(--folder); }
  /* One realm still draws something behind its contents, because what it draws
     is information: the days folder is ruled like a ledger, a line to the day.
     The other four are one flat tone of their own paper. A diagonal, a sunset
     band and a lit sphere were pictures *about* a folder, painted behind the
     things the folder actually holds — and the tile already has a better
     picture in it, which is the contents. Identity survives in ink: the glyph,
     the edge, the ground, and the nested folders on the tile. */
  body[data-view="grid"] .item[data-days] .thumb {
    background:
      repeating-linear-gradient(
        transparent 0 1.35rem,
        color-mix(in srgb, var(--accent-ink) 18%, transparent) 1.35rem calc(1.35rem + 1px)
      ),
      var(--realm-paper, var(--paper-2));
  }

  body[data-view="list"] .items { padding: 0 0 2rem; }
  body[data-view="list"] .item {
    display: grid; gap: 1rem; align-items: center;
    padding: .5rem 1.4rem; border-bottom: 1px solid var(--line);
  }
  body[data-view="list"] .item:hover { background: var(--paper-3); }
  body[data-view="list"] .item:active { transform: scale(.995); }
  body[data-view="list"] .item .thumb { display: none; }

  .item .name { display: flex; align-items: center; gap: .6rem; min-width: 0; }
  .item .name .ico { flex: 0 0 auto; display: flex; color: var(--folder); }
  .item[data-kind="doc"] .name .ico { color: var(--accent-ink); }
  /* One shape for a thing you go into, another for a thing you open. The two
     glyphs these replaced were both boxes, which is the same as no answer —
     and the kind of a row is the first thing you ask of it, before the name. */
  .glyph { width: 1.15rem; height: 1.15rem; display: block; flex: 0 0 auto; }
  .pin .ico { display: flex; color: var(--folder); }
  .pin[data-kind="doc"] .ico { color: var(--accent-ink); }
  .item .name b { font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .item .row-meta { color: var(--faint); font-size: .82rem; white-space: nowrap; }
  /* What a drop would land in. One rule rather than one per target, because a
     row, a breadcrumb and a nav entry all mean the same thing when something is
     hovering over them — and the crumbs and the nav had no highlight at all. */
  .marble-drop { outline: 2px solid var(--accent-ink); outline-offset: -2px; border-radius: 8px; }
  .item.marble-lifting { opacity: .45; }
  /* Picked is the page's answer to "which one", not the file's. A selection is
     where your attention is and it dies with the tab, so it is a class on a
     transient row and never an op. Prefixed so a reconcile leaves it alone. */
  .item.marble-picked { background: var(--accent-soft); }
  .item.marble-picked .name b { color: var(--accent-ink); }
  .item.marble-picked .more { opacity: 1; }
  /* Picked is a ring drawn inside the edge, not a bar down one side. Two rules
     from the design system decide this. A hairline with a tint behind it is
     below the threshold of noticing on a region this size, and what reads at
     any size is a ring (§01). And a rule — a leading edge, a folder's colour —
     is a straight segment that never bends around a corner (§04); a 3px bar
     inset on a 12px card bent around two of them. A ring may follow the
     radius, because a ring is the shape.
     A row is not a region: it keeps the leading rule, flush and square-capped
     on an edge with no radius to bend around. One rule covers the plain, the
     realm and the tinted card, because `--accent-ink` is already the folder's
     own colour in each of those. */
  body[data-view="grid"] .item.marble-picked:not([data-material]) {
    border-color: color-mix(in srgb, var(--accent-ink) 50%, var(--line));
    box-shadow: inset 0 0 0 2px var(--accent-ink);
  }
  body[data-view="list"] .item.marble-picked { box-shadow: inset 3px 0 0 var(--accent-ink); }
  body[data-view="grid"] .item.marble-picked:hover,
  body[data-view="list"] .item.marble-picked:hover { background: var(--accent-soft); }
  .item .more {
    position: absolute; top: .4rem; right: .4rem; width: 1.7rem; height: 1.7rem;
    border: 0; border-radius: 999px; background: none; color: var(--muted);
    cursor: pointer; opacity: 0;
  }
  body[data-view="list"] .item .more { position: static; opacity: .5; justify-self: end; }
  .item:hover .more { opacity: 1; }
  .item .more:hover { background: var(--line); transform: scale(1.08); }
  .item .more:active { transform: scale(.92); }

  .empty { padding: 4rem 1.5rem; text-align: center; color: var(--faint); }
  .empty strong { display: block; font-size: 1rem; color: var(--muted); margin-bottom: .3rem; font-weight: 500; }

  /* --------------------------------------------------------- the materials */
  /* Not everything in a folder is what the folder is *for*. A paper's folder
     holds the paper and it also holds the bibliography, the cover images, and
     the JSON some script reads — and a folder of nothing but those is the same
     thing one level up. They are facts about the work rather than the work, so
     they are drawn the way a footnote is drawn: below the rule, at a size you
     read second, folded away until you ask.
     Deliberately not a smaller tile. A tile at 80% is still a tile competing
     for the same glance; what makes something secondary is being in a
     different register, not a smaller one. So: no card, no preview, no folder
     colour, no weight bar — none of the identity the drive spends on documents. */
  .mats { grid-column: 1 / -1; margin: 1.4rem 0 0; }
  body[data-view="list"] .mats { margin: 1.4rem 1.4rem 0; }
  .mats-head {
    display: flex; align-items: center; gap: .5rem; width: 100%;
    padding: .4rem .1rem; border: 0; border-top: 1px solid var(--line);
    background: none; color: var(--faint); font-size: .78rem; text-align: left;
    cursor: pointer; border-radius: 0;
  }
  .mats-head:hover { color: var(--muted); }
  .mats-head:focus-visible { outline: 2px solid var(--accent-ink); outline-offset: 2px; }
  /* The folder holds nothing else, so there is nothing to fold this away from
     and it is a label rather than a control. */
  .mats-head.is-fixed { cursor: default; }
  .mats-head.is-fixed:hover { color: var(--faint); }
  .mats-head .caret {
    flex: 0 0 auto; width: .6rem; display: block;
    transition: transform var(--t) var(--settle);
  }
  .mats[data-open="1"] .mats-head .caret { transform: rotate(90deg); }
  .mats-head .what { letter-spacing: .04em; text-transform: uppercase; font-weight: 600; }
  .mats-head .how-much { color: var(--faint); font-weight: 400; text-transform: none; letter-spacing: 0; }
  /* Closed is the default and it is not a hidden state — the count in the
     header is the whole answer most of the time, which is what makes folding
     it away honest rather than lossy. */
  .mats-body { display: none; padding: .35rem 0 .2rem; }
  .mats[data-open="1"] .mats-body { display: flex; flex-wrap: wrap; gap: .35rem .45rem; }
  /* A material row is still an `.item` with a path and a kind on it, so the
     pick, the marquee, the row menu, the drag and Enter all reach it without
     knowing this strip exists. What `data-material` overrides is only how it
     looks — and it is written by the same line that decides it, so the CSS
     here and the tint stamp in script are reading one answer, not two. */
  body[data-view="grid"] .item[data-material],
  body[data-view="list"] .item[data-material] {
    display: inline-flex; align-items: center; gap: .4rem;
    padding: .22rem .3rem .22rem .5rem; margin: 0;
    border: 1px solid transparent; border-radius: 999px;
    background: var(--paper-2); color: var(--muted);
    max-width: 20rem; min-width: 0; box-shadow: none; transform: none;
  }
  body[data-view="grid"] .item[data-material]:hover,
  body[data-view="list"] .item[data-material]:hover {
    background: var(--paper-3); border-color: var(--line); color: var(--ink);
    box-shadow: none; transform: none;
  }
  .item[data-material] .thumb, .item[data-material] .row-meta { display: none; }
  .item[data-material] .name { gap: .35rem; }
  .item[data-material] .name b { font-weight: 400; font-size: .78rem; }
  /* No realm, no tint, no accent. A material is grey inside a folder that is
     bright green, because colour here is what says "this is one of the things
     you came for". */
  .item[data-material] .name .ico { color: var(--faint); }
  .item[data-material] .name .ico .glyph { width: .9rem; height: .9rem; }
  .item[data-material].marble-picked {
    background: var(--accent-soft); border-color: var(--accent-ink);
  }
  .item[data-material].marble-picked .name b { color: var(--accent-ink); }
  /* The extension of a file, or the count inside a folder — the one thing
     about a material worth saying beyond its name, because it is what tells
     you whether opening it shows a picture, hands you a download, or goes
     somewhere. */
  .item[data-material] .about {
    flex: 0 0 auto; color: var(--faint); font-size: .66rem;
    font-variant-numeric: tabular-nums; letter-spacing: .04em;
  }
  /* Held at a low opacity rather than revealed on hover: a menu you can only
     find by having a pointer is a menu a touch screen and a keyboard do not
     have, and this is the only way to rename or throw away a material. */
  body[data-view="grid"] .item[data-material] .more,
  body[data-view="list"] .item[data-material] .more {
    position: static; opacity: .22; width: 1.05rem; height: 1.05rem; padding: 0;
    line-height: 1; font-size: .72rem; flex: 0 0 auto; justify-self: auto;
  }
  .item[data-material]:hover .more, .item[data-material] .more:focus-visible { opacity: 1; }

  /* ------------------------------------------------------------- the timeline */
  /* Everything below the crumbs and the toolbar is still `.items`, still full
     of `.item` — the pick, the menu, the keyboard, Enter and Escape all keep
     working unmodified. What changes is what an item *looks like* and what the
     folder hands it: grid and list draw one level of the tree; the timeline
     draws every document under it, because a folder doesn't have a day it
     happened on and a document does. */
  body[data-view="timeline"] .items { padding: .4rem 1.5rem 3rem 3rem; }
  .tgroup {
    position: relative; margin: 1.7rem 0 .5rem; padding-left: .1rem;
    font-size: .72rem; text-transform: uppercase; letter-spacing: .08em;
    color: var(--faint); font-weight: 600;
  }
  .tgroup:first-child { margin-top: .3rem; }
  /* Scoped to the row's own class rather than the view attribute: a timeline
     row is reused verbatim inside the Pulse detail panel below, and it has to
     look like itself there too. */
  .item.trow {
    position: relative; display: flex; align-items: center; gap: .85rem;
    padding: .5rem .6rem .5rem .1rem; border-radius: 12px;
  }
  .item.trow::before {
    /* One continuous spine behind every row and every header, whichever
       document is picked. A single element the height of the list rather than
       a border per row, so it reads as one thread through time and not a
       fence between entries. */
    content: ''; position: absolute; left: -1.62rem; top: -.35rem; bottom: -.35rem; width: 2px;
    background: var(--line);
  }
  .item.trow:hover { background: var(--paper-3); }
  .item.trow .tdot {
    position: absolute; left: -1.87rem; width: .55rem; height: .55rem; border-radius: 999px;
    background: var(--accent-ink); box-shadow: 0 0 0 3px var(--paper-2);
  }
  .item.trow .tdot.marble-fresh {
    animation: pulse-dot 2.2s var(--settle) infinite;
  }
  @keyframes pulse-dot {
    0%, 100% { box-shadow: 0 0 0 3px var(--paper-2), 0 0 0 3px rgba(var(--accent-ink-rgb), 0); }
    50% { box-shadow: 0 0 0 3px var(--paper-2), 0 0 0 7px rgba(var(--accent-ink-rgb), .28); }
  }
  .item.trow .ico { flex: 0 0 auto; display: flex; color: var(--folder); }
  .item.trow[data-kind="doc"] .ico { color: var(--accent-ink); }
  .item.trow .tname { min-width: 0; flex: 1 1 auto; display: flex; flex-direction: column; gap: .05rem; }
  .item.trow .tname b {
    font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .item.trow .tname small { color: var(--faint); font-size: .76rem; }
  .item.trow .tmeta {
    flex: 0 0 auto; color: var(--faint); font-size: .8rem; white-space: nowrap; font-variant-numeric: tabular-nums;
  }
  .item.trow .more { position: static; opacity: .5; }
  .item.trow .thumb { display: none; }

  /* ------------------------------------------------------------------ the map */
  /* The shape of a folder rather than a manifest of it: what is here, how
     folders relate to what holds them, and which of them is heavy — the same
     bytes and node counts `weigh` already reports, spent on geometry instead
     of a sentence. Nothing here is content; close the tab and reopen and it is
     recomputed, same as the grid is. */
  body[data-view="map"] .items { position: relative; overflow: hidden; padding: 0; }
  .orbit-wrap { position: absolute; inset: 0; display: grid; place-items: center; }
  .orbit-center {
    position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center;
    justify-content: center; gap: .15rem; width: 7.5rem; height: 7.5rem; border-radius: 999px;
    text-align: center; padding: .5rem; background: var(--card); border: 1px solid var(--line);
    box-shadow: var(--shadow-lift); color: var(--muted);
  }
  .orbit-center .ico { color: var(--folder); }
  .orbit-center .ico .glyph { width: 1.4rem; height: 1.4rem; }
  .orbit-center b { color: var(--ink); font-weight: 500; font-size: .88rem; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .orbit-center small { color: var(--faint); font-size: .74rem; }
  .ring {
    position: absolute; top: 50%; left: 50%; border: 1px dashed var(--line); border-radius: 999px;
    width: calc(var(--r) * 2); height: calc(var(--r) * 2); margin-left: calc(var(--r) * -1); margin-top: calc(var(--r) * -1);
    opacity: .6; pointer-events: none;
  }
  /* The disk drifts, once around every few minutes — slow enough that it never
     reads as "spinning", only as "not a photograph". `@property` is what lets
     a child cancel a value its rotating ancestor is still animating: --spin is
     declared an angle and marked to inherit, so every node downstream can read
     the live value and subtract it back out to stay upright while its
     *position* keeps revolving for free. Where a browser has never heard of
     @property, --spin simply never becomes 360deg and the disk sits still —
     a map that does not turn is still a map. */
  @property --spin { syntax: '<angle>'; inherits: true; initial-value: 0deg; }
  .orbit { position: absolute; inset: 0; transform: rotate(var(--spin)); animation: drift 240s linear infinite; }
  @keyframes drift { to { --spin: 360deg; } }
  .item.node {
    position: absolute; top: 50%; left: 50%; width: var(--size); height: var(--size);
    margin-left: calc(var(--size) / -2); margin-top: calc(var(--size) / -2);
    transform: rotate(var(--angle)) translate(var(--radius)) rotate(calc(-1 * var(--angle) - var(--spin)));
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .25rem;
    text-align: center; padding: .3rem; border-radius: 999px;
    background: var(--card); border: 1px solid var(--line); box-shadow: var(--shadow);
    opacity: var(--fresh, 1);
  }
  .item.node:hover { box-shadow: var(--shadow-lift); border-color: var(--accent-ink); z-index: 3; opacity: 1; }
  .item.node:active { transform: rotate(var(--angle)) translate(var(--radius)) rotate(calc(-1 * var(--angle) - var(--spin))) scale(.94); }
  .item.node .ico { color: var(--folder); }
  .item.node[data-kind="doc"] .ico { color: var(--accent-ink); }
  .item.node .ico .glyph { width: 1.2rem; height: 1.2rem; }
  .item.node b {
    font-weight: 500; font-size: .74rem; max-width: calc(var(--size) * 1.7); overflow: hidden;
    text-overflow: ellipsis; white-space: nowrap; position: absolute; top: 100%; margin-top: .3rem;
    color: var(--muted); background: color-mix(in srgb, var(--paper) 75%, transparent); padding: 0 .2rem; border-radius: 4px;
  }
  /* Present, not deleted: a node still needs Rename, Move, Pin, Trash — it
     only needs them to stay out of the way of a shape that is mostly circle. */
  .item.node .more {
    position: absolute; top: -.3rem; right: -.3rem; width: 1.5rem; height: 1.5rem;
    background: var(--card); border: 1px solid var(--line); opacity: 0;
  }
  .item.node:hover .more, .item.node:focus-within .more { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .orbit { animation: none; } }

  /* ---------------------------------------------------------------- the pulse */
  /* A calendar of activity, one square per day — the same question the
     timeline answers, asked the other way around. The timeline is for "what
     did I touch"; this is for "when was I actually in here", which a list of
     forty rows cannot show you at a glance and a grid of ninety squares can. */
  body[data-view="pulse"] .items { padding: 1.4rem 1.6rem 2rem; }
  .pulse-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .pulse-head b { font-weight: 500; font-size: .95rem; }
  .pulse-head span { color: var(--faint); font-size: .78rem; }
  .pulse-grid { display: grid; grid-auto-flow: column; grid-template-rows: repeat(7, 1fr); gap: 3px; overflow-x: auto; padding-bottom: .3rem; }
  .pulse-day {
    width: 13px; height: 13px; border-radius: 3px; background: var(--paper-3);
    cursor: pointer; position: relative;
  }
  .pulse-day[data-level="1"] { background: color-mix(in srgb, var(--accent-ink) 28%, var(--paper-3)); }
  .pulse-day[data-level="2"] { background: color-mix(in srgb, var(--accent-ink) 55%, var(--paper-3)); }
  .pulse-day[data-level="3"] { background: color-mix(in srgb, var(--accent-ink) 80%, var(--paper-3)); }
  .pulse-day[data-level="4"] { background: var(--accent-ink); }
  .pulse-day:hover { outline: 2px solid var(--accent-ink); outline-offset: 1px; }
  .pulse-day.marble-picked { outline: 2px solid var(--ink); outline-offset: 1px; }
  .pulse-legend { display: flex; align-items: center; gap: .3rem; margin-top: .6rem; color: var(--faint); font-size: .74rem; }
  .pulse-legend i { width: 11px; height: 11px; border-radius: 3px; background: var(--paper-3); display: inline-block; }
  .pulse-legend i[data-level="1"] { background: color-mix(in srgb, var(--accent-ink) 28%, var(--paper-3)); }
  .pulse-legend i[data-level="2"] { background: color-mix(in srgb, var(--accent-ink) 55%, var(--paper-3)); }
  .pulse-legend i[data-level="3"] { background: color-mix(in srgb, var(--accent-ink) 80%, var(--paper-3)); }
  .pulse-legend i[data-level="4"] { background: var(--accent-ink); }
  /* Left padding wide enough that a reused timeline row's spine and dot —
     both positioned outside its own left edge — land inside the scroll
     container instead of under the row before it. */
  .pulse-detail { margin-top: 1.4rem; border-top: 1px solid var(--line); padding: .8rem 0 0 2rem; }
  .pulse-detail h4 { margin: 0 0 .5rem; font-size: .82rem; font-weight: 500; color: var(--muted); }
  .pulse-detail .empty { padding: 1rem 0; text-align: left; }

  /* --------------------------------------------------------------- the weight */
  /* The map answers "where" by shape; this answers "which ones" by rank —
     the same numbers `weigh` reports, sorted worst-first so the one document
     worth doing something about is always the top row. */
  body[data-view="weight"] .items { padding: .5rem 1.4rem 2rem; }
  body[data-view="weight"] .item {
    position: relative; display: flex; align-items: center; gap: .85rem;
    padding: .5rem 0; border-bottom: 1px solid var(--line);
  }
  body[data-view="weight"] .item:hover { background: var(--paper-3); }
  .wrank { flex: 0 0 auto; width: 1.4rem; text-align: right; color: var(--faint); font-size: .78rem; font-variant-numeric: tabular-nums; }
  .witem-ico { flex: 0 0 auto; display: flex; color: var(--folder); }
  .item[data-kind="doc"] .witem-ico { color: var(--accent-ink); }
  .wname { flex: 0 0 auto; width: 12rem; min-width: 0; }
  .wname b { display: block; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .wname small { display: block; color: var(--faint); font-size: .76rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .wbar { flex: 1 1 auto; height: 8px; border-radius: 999px; background: var(--paper-3); overflow: hidden; min-width: 3rem; }
  .wbar i {
    display: block; height: 100%; border-radius: inherit; background: var(--accent-ink);
    transform-origin: left; transform: scaleX(var(--w, 0)); transition: transform var(--t-slow) var(--settle);
  }
  .wmeta { flex: 0 0 auto; width: 6rem; text-align: right; color: var(--faint); font-size: .82rem; font-variant-numeric: tabular-nums; }
  body[data-view="weight"] .item .more { position: static; opacity: .5; }

  /* ------------------------------------------------------------- the overlays */
  /* The New menu. It used to be a sheet across the foot of the window, which
     put the choice as far from the button that summons it as the screen
     allows. Now it is a popover hung under the New button — the row menu's
     shape, with room for each starter to say what it is. Script places it from
     the button's rect; the look is here. */
  /* Materialize rather than fade or `display` toggle: a popover that only
     flips opacity reads as a layer that was already there, and `display: none`
     gives a transition nothing to animate from. So it stays in the render
     tree, unreachable and invisible when closed (`pointer-events: none`,
     `opacity: 0`), and grows from the corner nearest the button that opened it
     — `transform-origin` is set from script, once, per opening, the same idea
     as anchoring a menu to its trigger. */
  .sheet {
    position: fixed; z-index: 30; pointer-events: none;
    width: 23rem; max-width: calc(100vw - 1rem);
    max-height: calc(100vh - 5rem); overflow-y: auto;
    background: rgba(var(--card-rgb), .88); backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    border: 1px solid var(--line); border-radius: 14px;
    box-shadow: var(--shadow-lift); padding: .4rem;
    transform: scale(.94); opacity: 0;
    transition: transform var(--t) var(--settle), opacity var(--t) var(--settle);
  }
  .sheet[data-open="1"] { pointer-events: auto; transform: none; opacity: 1; }
  .sheet p { margin: .25rem .55rem .5rem; color: var(--faint); font-size: .78rem; line-height: 1.4; }
  /* The way out of a menu and into the room it is a corner of. */
  .sheet-all {
    display: block; width: 100%; margin-top: .4rem; padding: .45rem .5rem;
    border: 0; border-radius: 8px; background: none; color: var(--muted);
    font-size: .82rem; text-align: left; cursor: pointer;
  }
  .sheet-all:hover { background: var(--paper-3); color: var(--ink); }

  /* --------------------------------------------------------- the gallery */
  /* A template is a document, so a card for one is a picture of a document.
     These were eight cards that differed only in the sentence written on them,
     under eight swatches that were all the same grey — which is a set you have
     to read twice to choose from. Now each card mounts the real starter, built
     and stripped of anything that could run, in the same sandboxed frame a
     grid tile uses; the only text left is its name. The prose is one level
     down, in the panel you get when you pick one, which is where somebody who
     wants to read is standing.

     Colour is the second cue and does the work the swatch never did: each
     starter carries an accent out of the Drive's own folder palette, served
     with it, and the card wears it as `--tint`. The third is shape — a
     schematic of the document's structure, which is what shows while the frame
     loads and what stays if it never does. */
  /* Outranks whichever view the listing was last in: those rules are
     `body[data-view="grid"] .items`, and a gallery is not a listing in any of
     the seven senses they mean. */
  body[data-view] .items[data-gallery] {
    display: block; overflow-y: auto; padding: .8rem 1.4rem 2.5rem;
  }
  .tlead { margin: 0 0 1rem; color: var(--faint); font-size: .84rem; max-width: 46ch; }
  .tgrid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1rem; align-content: start;
  }
  /* The same card at the density a popover can afford: two columns, no shadow
     of its own against the blurred panel, and the picture a little shorter. It
     is the same component deliberately — a thing that looks the same has to
     behave the same, and picking here and picking on the page are one gesture. */
  .tgrid[data-compact] { grid-template-columns: 1fr 1fr; gap: .45rem; }
  .tcard {
    --tint: var(--accent-ink); --on-tint: #fff; --edge: var(--tint);
    position: relative; display: block; width: 100%; padding: 0; text-align: left;
    border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden;
    background: var(--card); color: var(--ink); cursor: pointer; box-shadow: var(--shadow);
  }
  .tcard:hover {
    transform: translateY(-2px); box-shadow: var(--shadow-lift);
    border-color: color-mix(in srgb, var(--edge) 45%, var(--line));
  }
  /* Outranks the page-wide `button:active`, which would shrink the whole card
     about its middle and drop it back behind the lift. */
  .tcard:active { transform: translateY(-1px) scale(.985); }
  .tcard:focus-visible { outline: 2px solid var(--edge); outline-offset: 2px; }
  .tgrid[data-compact] .tcard { box-shadow: none; }

  /* The picture. `--z` is the one number: the frame is rendered at full size
     and scaled down by it, so the page it holds is laid out as a page rather
     than as a very narrow column, and the wrapper only has to be the reciprocal
     wide. The panel reuses this at a third rather than a fifth. */
  .tpeek {
    --z: .2;
    position: relative; display: grid; place-items: center; overflow: hidden;
    aspect-ratio: 4 / 3; background: var(--card); color: var(--edge);
  }
  .tpeek iframe {
    position: absolute; top: 0; left: 0; border: 0; background: var(--card);
    width: calc(100% / var(--z)); height: calc(100% / var(--z));
    transform: scale(var(--z)); transform-origin: top left;
    opacity: 0; pointer-events: none;
    transition: opacity var(--t-slow) var(--settle), transform var(--t) var(--settle);
  }
  .tpeek.marble-is-loaded iframe { opacity: 1; }
  .tpeek.marble-is-loaded .tglyph { display: none; }
  /* A hover leans into the page rather than lighting the card up: the room is
     the preview, so the preview is what answers. */
  .tcard:hover .tpeek iframe { transform: scale(calc(var(--z) * 1.03)); }
  .tgrid[data-compact] .tpeek { aspect-ratio: 3 / 2; }
  .tpeek .tglyph { width: 2.4rem; height: 2.4rem; opacity: .4; }
  .tfoot {
    display: flex; align-items: center; gap: .5rem; padding: .55rem .7rem;
    border-top: 2px solid var(--edge); background: var(--card); font-weight: 500;
  }
  .tfoot .tglyph { flex: 0 0 auto; width: 1rem; height: 1rem; color: var(--edge); }
  .tfoot b { font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tgrid[data-compact] .tfoot { padding: .38rem .5rem; font-size: .82rem; }
  .tgrid[data-compact] .tfoot .tglyph { width: .85rem; height: .85rem; }

  /* ----------------------------------------------------------- the brief */
  /* Picking a template does not make a document, it opens this: what to call
     it, and what you want built in it. Leave the second field alone and it is
     the clone it always was — that is the whole of the agency here, and it is
     why there is one button rather than two, with the truth written on it.

     A modal task, so it is dimmed to: the scrim pushes the listing back, and
     the panel grows out of the card that was pressed and shrinks back into it
     (`--from` is set from that card's rect, once, per opening). */
  /* Named for what it belongs to: the Drive already has a `.scrim`, the one
     the phone sidebar slides out over, and two things called the same thing in
     one file is one of them waiting to be broken by the other. */
  .start-scrim {
    position: fixed; inset: 0; z-index: 40; background: rgba(0, 0, 0, .3);
    opacity: 0; pointer-events: none; transition: opacity var(--t) var(--settle);
  }
  .start-scrim[data-open="1"] { opacity: 1; pointer-events: auto; }
  .start {
    --tint: var(--accent-ink); --on-tint: #fff; --edge: var(--tint);
    position: fixed; z-index: 41; left: 50%; top: 50%;
    width: min(46rem, calc(100vw - 2rem)); max-height: calc(100vh - 3rem); overflow-y: auto;
    display: grid; grid-template-columns: 16rem 1fr; gap: 1.3rem;
    padding: 1.1rem; border: 1px solid var(--line); border-radius: 14px;
    background: var(--card); box-shadow: var(--shadow-lift);
    transform-origin: var(--from, 50% 50%);
    transform: translate(-50%, -50%) scale(.92); opacity: 0; pointer-events: none;
    transition: transform var(--t) var(--settle), opacity var(--t) var(--settle);
  }
  .start[data-open="1"] { transform: translate(-50%, -50%) scale(1); opacity: 1; pointer-events: auto; }
  .start-shot { border: 1px solid var(--line); border-radius: 12px; overflow: hidden; align-self: start; }
  /* Taller and closer in than the card's: the same picture, at the size you
     look at rather than the size you scan. A document is a page and the top of
     it is what a preview has — so a template whose document is short shows its
     own white space here, which is what opening it would show too. */
  .start-shot .tpeek { --z: .3; aspect-ratio: 4 / 5; }
  /* The actions run the full width under both columns rather than under the
     fields alone: it is the panel that is being committed, not the form. */
  .start-foot {
    grid-column: 1 / -1; padding-top: .85rem; border-top: 1px solid var(--line);
  }
  .start h2 { margin: 0 0 .3rem; font-size: 1.2rem; font-weight: 500; letter-spacing: -.012em; }
  .start-blurb { margin: 0 0 1.1rem; color: var(--muted); font-size: .86rem; line-height: 1.5; max-width: 40ch; }
  .start-label {
    display: block; margin: 0 0 .32rem; color: var(--faint);
    font-size: .72rem; letter-spacing: .04em; text-transform: uppercase;
  }
  .start-label span { text-transform: none; letter-spacing: 0; opacity: .75; }
  .start input[type="text"], .start textarea {
    display: block; width: 100%; margin: 0 0 1rem; padding: .5rem .6rem; font: inherit;
    color: var(--ink); background: var(--paper); border: 1px solid var(--line);
    border-radius: 8px; outline: none;
    transition: border-color var(--t) var(--settle), box-shadow var(--t) var(--settle);
  }
  .start input[type="text"]:focus, .start textarea:focus {
    border-color: var(--edge); box-shadow: 0 0 0 3px color-mix(in srgb, var(--edge) 22%, transparent);
  }
  .start textarea { min-height: 4.6rem; margin-bottom: .6rem; line-height: 1.5; resize: vertical; }
  /* Three of them, concrete. An empty field teaches nothing about what a
     starter can become; three examples teach most of it, and one tap is the
     cheapest way to find that out. */
  .start-ideas { display: flex; flex-wrap: wrap; gap: .35rem; margin: 0; }
  .start-ideas button {
    padding: .3rem .65rem; border: 1px solid var(--line); border-radius: 999px;
    background: var(--paper-2); color: var(--muted); font-size: .78rem;
    text-align: left; cursor: pointer;
  }
  .start-ideas button:hover {
    background: var(--card); color: var(--ink);
    border-color: color-mix(in srgb, var(--edge) 50%, var(--line));
  }
  .start-foot { display: flex; align-items: center; gap: .5rem; }
  .start-body { min-width: 0; }
  /* Where it lands, said out loud. A create that puts the file somewhere you
     were not looking is the one failure this panel can still have. */
  .start-where {
    flex: 1 1 auto; min-width: 0; color: var(--faint); font-size: .8rem;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .start-foot button {
    padding: .45rem .95rem; border: 1px solid var(--line); border-radius: 8px;
    background: var(--card); color: var(--ink); font-size: .88rem; cursor: pointer;
  }
  .start-foot button:hover { background: var(--paper-3); }
  /* Filled in the template's own colour, with a label colour chosen from that
     colour's luminance rather than fixed — white on Pearl is unreadable and
     black on Slate is worse. */
  #start-go {
    border-color: transparent; background: var(--tint); color: var(--on-tint); font-weight: 500;
  }
  #start-go[disabled] { opacity: .55; cursor: default; }
  #start-go[disabled]:hover { background: var(--tint); }
  /* In the dark the seven accents are still the light scheme's, and a
     mid-dark hex drawn as a hairline on a near-black card is a line you cannot
     see. Only the edges and the marks are lifted: the fill of a button keeps the
     real colour, because that is the one place the label's contrast against it
     was measured. */
  @media (prefers-color-scheme: dark) {
    .tcard, .start { --edge: color-mix(in srgb, var(--tint) 62%, #ffffff); }
  }
  @media (max-width: 44rem) {
    .start { grid-template-columns: 1fr; gap: .8rem; }
    .start-shot .tpeek { aspect-ratio: 16 / 9; --z: .26; }
  }
  /* A panel that scales is a panel that moves; reduced motion gets the arrival
     without the travel, and a card that answers a hover without rising. */
  @media (prefers-reduced-motion: reduce) {
    .start { transform: translate(-50%, -50%); transition: opacity var(--t) linear; }
    .start[data-open="1"] { transform: translate(-50%, -50%); }
    .tcard:hover { transform: none; }
    .tcard:hover .tpeek iframe { transform: scale(var(--z)); }
  }

  .menu {
    position: fixed; z-index: 30; pointer-events: none; min-width: 12rem; padding: .35rem;
    background: rgba(var(--card-rgb), .9); backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow-lift);
    transform: scale(.94); opacity: 0;
    transition: transform var(--t) var(--settle), opacity var(--t) var(--settle);
  }
  .menu[data-open="1"] { pointer-events: auto; transform: none; opacity: 1; }
  .menu button {
    display: flex; align-items: center; gap: 1.2rem; width: 100%; text-align: left; padding: .45rem .7rem;
    border: 0; border-radius: 8px; background: none; color: var(--ink); cursor: pointer; font-size: .88rem;
  }
  /* The key that would have done it without the menu. A shortcut nobody is
     told about is a shortcut nobody has: the menu is where you look when you
     do not know, so it is the only place the key can be learned. */
  .menu button .key { margin-left: auto; color: var(--muted); font-size: .95em; }
  .menu button:hover { background: var(--paper-3); }
  .menu button:active { transform: scale(.98); }
  .menu hr { border: 0; border-top: 1px solid var(--line); margin: .3rem 0; }

  .toast {
    position: fixed; left: 1.2rem; bottom: 1.2rem; z-index: 40;
    padding: .65rem 1rem; border-radius: 12px;
    background: rgba(var(--card-rgb), .82); backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    border: 1px solid var(--line); color: var(--ink); font-weight: 500; letter-spacing: .003em;
    font-size: .85rem; box-shadow: var(--shadow-lift); opacity: 0; transform: translateY(.4rem) scale(.98);
    transition: opacity var(--t) var(--settle), transform var(--t) var(--settle); pointer-events: none;
  }
  .toast[data-open="1"] { opacity: 1; transform: none; }

  /* What is on its way up. The toast says a thing happened and goes; a song
     going up over a slow link is minutes of "is it doing anything", so this
     stays until it is done and shows it moving. Same corner as the toast,
     which it replaces while it is open. */
  .uploads {
    position: fixed; left: 1.2rem; bottom: 1.2rem; z-index: 41; width: min(22rem, calc(100vw - 2.4rem));
    padding: .8rem .9rem .75rem; border-radius: 12px;
    background: rgba(var(--card-rgb), .9); backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    border: 1px solid var(--line); color: var(--ink); font-size: .85rem; box-shadow: var(--shadow-lift);
    opacity: 0; transform: translateY(.4rem) scale(.98); pointer-events: none;
    transition: opacity var(--t) var(--settle), transform var(--t) var(--settle);
  }
  .uploads[data-open="1"] { opacity: 1; transform: none; pointer-events: auto; }
  .uploads[data-open="1"] ~ .toast, .uploads[data-open="1"] + .toast { opacity: 0; }
  .up-head { display: flex; align-items: baseline; gap: .6rem; }
  .up-title { flex: 1 1 auto; min-width: 0; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .up-sum { flex: 0 0 auto; color: var(--muted); font-size: .78rem; font-variant-numeric: tabular-nums; }
  .up-bar { position: relative; height: 4px; margin: .55rem 0 .5rem; border-radius: 2px; overflow: hidden;
    background: color-mix(in srgb, var(--line) 70%, transparent); }
  .up-bar i { position: absolute; inset: 0 auto 0 0; width: 0; background: var(--accent-ink);
    transition: width 180ms linear; }
  .uploads[data-state="done"] .up-bar i { width: 100%; }
  .uploads[data-state="failed"] .up-bar i { background: #b3261e; }
  .up-files { list-style: none; margin: 0; padding: 0; display: grid; gap: .2rem; max-height: 7.5rem; overflow: auto; }
  .up-files li { display: flex; gap: .6rem; align-items: baseline; font-size: .8rem; }
  .up-files .n { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--muted); }
  .up-files li[data-state="going"] .n { color: var(--ink); }
  .up-files .s { flex: 0 0 auto; color: var(--faint); font-variant-numeric: tabular-nums; }
  .up-files li[data-state="done"] .s { color: var(--accent-ink); }
  .up-files li[data-state="failed"] .s { color: #b3261e; }
  .up-foot { display: flex; justify-content: flex-end; margin-top: .45rem; }
  .up-foot button { font: inherit; font-size: .78rem; padding: .2rem .6rem; border-radius: 6px; cursor: pointer;
    background: transparent; color: var(--muted); border: 1px solid var(--line); }
  .up-foot button:hover { color: var(--ink); border-color: var(--muted); }
  @media (prefers-reduced-motion: reduce) { .up-bar i { transition: none; } }

  .ghost {
    position: fixed; z-index: 50; pointer-events: none; padding: .4rem .7rem;
    background: var(--card); border: 1px solid var(--accent-ink); border-radius: 8px;
    box-shadow: var(--shadow-lift); font-size: .85rem; opacity: 0; transform: scale(.9) rotate(-1deg);
    transition: opacity var(--t-fast) var(--settle), transform var(--t-fast) var(--settle);
  }
  .ghost[data-open="1"] { opacity: 1; transform: none; }

  /* A file on its way in from outside. The overlay is the whole window because
     a drop anywhere lands in the folder you are looking at, and it takes no
     pointer events at all — otherwise it would be the thing every dragover
     found, and no row underneath it could ever be a target. */
  .drop {
    position: fixed; inset: .4rem; z-index: 45; pointer-events: none; display: grid; place-items: center;
    border: 2px dashed var(--accent-ink); border-radius: var(--radius);
    background: color-mix(in srgb, var(--accent-soft) 72%, transparent);
    opacity: 0; transform: scale(.99);
    transition: opacity var(--t) var(--settle), transform var(--t) var(--settle);
  }
  .drop[data-open="1"] { opacity: 1; transform: none; }
  .drop b {
    padding: .6rem 1.1rem; border-radius: 999px; font-weight: 500;
    background: var(--card); border: 1px solid var(--accent-ink); color: var(--accent-ink);
    box-shadow: var(--shadow);
  }

  /* The marquee. The rectangle is one div sized from the drag; the lasso is one
     polyline in an SVG that covers the viewport at 1:1 pixels. Both take no
     pointer events, so the rows underneath stay the thing the drag is measured
     against. */
  .band {
    position: fixed; z-index: 35; display: none; pointer-events: none;
    border: 1px solid var(--accent-ink); border-radius: 2px;
    background: color-mix(in srgb, var(--accent-soft) 55%, transparent);
  }
  .band[data-open="1"] { display: block; }
  .lasso { position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 35; display: none; pointer-events: none; }
  .lasso[data-open="1"] { display: block; }
  .lasso polyline {
    fill: color-mix(in srgb, var(--accent-soft) 35%, transparent);
    stroke: var(--accent-ink); stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round;
  }
  /* A drag that starts on empty space must not leave a text selection behind it. */
  body.marble-marqueeing, body.marble-marqueeing * { user-select: none !important; }

  @media (max-width: 52rem) {
    .side { flex-basis: 4.5rem; }
    .side h2, .nav-item span:not(.ico), .pin span:not(.ico), .quota { display: none; }
    .new { padding: .75rem; }
    .new .label { display: none; }
    .brand h1 { display: none; }
    body[data-view="list"] .item,
    body[data-view="list"] .listhead { grid-template-columns: 1fr 7rem 2.2rem; }
    body[data-view="list"] .item > .row-meta.owner,
    body[data-view="list"] .item > .row-meta.size,
    .listhead > .owner, .listhead > .size { display: none; }
  }
  /* A file that is not a document, shown as what it is. A picture is the
     picture (a PDF's first page, a slide, a photo); a song is its waveform,
     with a button to hear it where it lies; text is its first lines. What
     cannot be shown is its glyph and its kind, which is what it was before.
     One element for the grid's tile and the map's cell, sized by whoever
     places it. */
  .fp {
    --fp: var(--tile, var(--accent-ink));
    position: absolute; inset: 0; overflow: hidden;
    display: grid; place-items: center; container-type: size;
    color: var(--fp);
  }
  .item .thumb .fp { inset: 0 0 3px 0; background: var(--card); }
  .fp-badge {
    display: flex; flex-direction: column; align-items: center; gap: .4rem;
    color: color-mix(in srgb, var(--fp) 70%, var(--faint)); pointer-events: none;
    transition: opacity var(--t) var(--settle);
  }
  .fp-badge .glyph { width: 2.1rem; height: 2.1rem; }
  .fp-badge i {
    font-style: normal; font-size: 11px; font-weight: 600; letter-spacing: .06em;
    padding: 1px 6px; border-radius: 3px;
    background: color-mix(in srgb, var(--fp) 12%, transparent);
  }
  @container (max-height: 70px) { .fp-badge i { display: none; } }
  .fp.marble-is-ready > .fp-badge { display: none; }

  .fp-img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: center; pointer-events: none;
    opacity: 0; transition: opacity var(--t-slow) var(--settle), filter var(--t-slow) var(--settle);
  }
  .fp.marble-is-ready > .fp-img { opacity: 1; }
  /* A page is read from the top, the way a document tile shows one. */
  .fp[data-fk="pdf"] > .fp-img, .fp[data-fk="office"] > .fp-img { object-position: top center; }
  /* The thumbnailer draws a page on its own white; a picture of a sheet on
     the card reads as the sheet. */
  .fp[data-fk="pdf"], .fp[data-fk="office"] { background: var(--card); }
  .fp-mark {
    position: absolute; right: 8px; bottom: 8px; width: 28px; height: 28px; border-radius: 7px;
    display: grid; place-items: center; pointer-events: none; z-index: 3;
    color: #fff; background: rgb(0 0 0 / .45); backdrop-filter: blur(6px);
  }
  .fp-mark svg { width: 12px; height: 12px; }

  .fp-text {
    position: absolute; inset: 0; margin: 0; padding: 9px 11px; overflow: hidden;
    font: 11px/1.45 ui-monospace, SFMono-Regular, Menlo, monospace; white-space: pre-wrap; word-break: break-word;
    color: color-mix(in srgb, var(--fp) 45%, var(--ink)); pointer-events: none;
    -webkit-mask-image: linear-gradient(#000 70%, transparent);
            mask-image: linear-gradient(#000 70%, transparent);
    opacity: 0; transition: opacity var(--t-slow) var(--settle);
  }
  .fp.marble-is-ready > .fp-text { opacity: .85; }

  /* A song. The waveform is the file's own shape, drawn once and kept; the
     part already heard is filled in the accent, so where you are in it is
     where the colour stops. Pressing anywhere on it goes there. */
  .fp-tune {
    position: absolute; inset: 0; display: grid;
    grid-template: "art" 0 "wave" 1fr "bar" auto / 1fr;
    padding: 10px 12px;
  }
  .fp.marble-has-art .fp-tune { grid-template-rows: minmax(0, 1fr) minmax(36px, .5fr) auto; row-gap: 10px; }
  @container (aspect-ratio > 1.6) {
    .fp.marble-has-art .fp-tune {
      grid-template: "art wave" 1fr "art bar" auto / auto 1fr; column-gap: 12px; row-gap: 0;
    }
  }
  .fp-art {
    grid-area: art; min-height: 0; max-width: 100%; height: 100%; aspect-ratio: 1; justify-self: start;
    border-radius: 6px; overflow: hidden; background: color-mix(in srgb, var(--fp) 14%, var(--card));
  }
  .fp-art img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fp-wave {
    grid-area: wave; position: relative; min-height: 0; cursor: pointer;
    align-self: center; height: 100%; max-height: 200px;
  }
  .fp-wave svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .fp-wave .fp-bars { fill: color-mix(in srgb, var(--fp) 32%, transparent); }
  .fp-wave .fp-heard { fill: var(--fp); clip-path: inset(0 calc(100% - var(--p, 0) * 100%) 0 0); }
  .fp-wave:hover .fp-bars { fill: color-mix(in srgb, var(--fp) 44%, transparent); }
  .fp[data-fk="audio"]:not(.marble-is-ready) .fp-wave { opacity: 0; }
  .fp[data-fk="audio"].marble-is-ready .fp-wave { animation: fp-rise var(--t-slow) var(--settle); }
  @keyframes fp-rise { from { opacity: 0; transform: scaleY(.2); } }
  .fp-bar {
    grid-area: bar; display: flex; align-items: center; gap: 10px; min-width: 0; padding-top: 8px;
  }
  .fp-play {
    flex: none; width: 34px; height: 34px; border-radius: 9px; border: 0; padding: 0;
    display: grid; place-items: center; cursor: pointer;
    color: var(--card); background: var(--fp);
    transition: transform var(--t-fast) var(--snap), filter var(--t-fast) var(--snap);
  }
  .fp-play:hover { filter: brightness(1.08); }
  .fp-play:active { transform: scale(.94); }
  .fp-play:focus-visible { outline: 2px solid var(--fp); outline-offset: 2px; }
  .fp-play svg { width: 14px; height: 14px; }
  .fp-play .is-pause, .fp.marble-is-playing .fp-play .is-play { display: none; }
  .fp.marble-is-playing .fp-play .is-pause { display: block; }
  .fp-say { min-width: 0; display: flex; flex-direction: column; line-height: 1.25; }
  .fp-say b {
    font-size: 12.5px; font-weight: 500; color: var(--ink);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .fp-say b:empty { display: none; }
  .fp-time { font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
  /* Small: the waveform alone, and the button over it. */
  @container (max-height: 96px) {
    .fp-tune { padding: 6px 8px; grid-template: "wave" 1fr / 1fr; }
    .fp-tune .fp-art, .fp-tune .fp-say { display: none; }
    .fp-tune .fp-bar { grid-area: wave; padding: 0; align-self: center; justify-self: start; z-index: 1; }
    .fp-tune .fp-wave { margin-left: 44px; }
    .fp-play { width: 30px; height: 30px; }
    .fp[data-fk="audio"] > .fp-badge { display: none; }
  }
  @container (max-width: 150px) { .fp-say { display: none; } }

  /* In the map, the pictures are printed in the folder's ink like the
     pages beside them, and show as themselves under the pointer. */
  .tm-file { position: absolute; border-radius: 8px; box-shadow: 0 0 0 1px color-mix(in srgb, var(--tile) 18%, var(--line)); }
  .tm-file.marble-is-pic { isolation: isolate; background: var(--card); }
  .tm-file.marble-is-pic > .fp-img { filter: grayscale(1); }
  .tm-file.marble-is-pic.marble-is-ready::before, .tm-file.marble-is-pic.marble-is-ready::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    transition: opacity var(--t-slow) var(--settle);
  }
  .tm-file.marble-is-pic::before { z-index: 1; background: var(--tile); mix-blend-mode: screen; }
  .tm-file.marble-is-pic::after { z-index: 2; mix-blend-mode: multiply; background: color-mix(in srgb, var(--tile) var(--mix), var(--card)); }
  @media (prefers-color-scheme: dark) {
    .tm-file.marble-is-pic::before { mix-blend-mode: multiply; }
    .tm-file.marble-is-pic::after { mix-blend-mode: screen; }
  }
  .tm:hover > .tm-file.marble-is-pic::before, .tm:hover > .tm-file.marble-is-pic::after { opacity: 0; }
  .tm:hover > .tm-file.marble-is-pic > .fp-img { filter: none; }
  .tm-file[data-fk="audio"], .tm-file[data-fk="text"] { box-shadow: none; }
  .tm-file .fp-tune { padding: 4px 6px; }
  .tm-file .fp-bar { padding-top: 10px; }
  @media (prefers-reduced-motion: reduce) {
    .fp[data-fk="audio"].marble-is-ready .fp-wave { animation: none; }
  }
</style>
</head>
<body class="drive" data-marble-id="__ID__" data-view="grid">

<header class="topbar" data-marble-id="__ID__">
  <div class="brand" data-marble-id="__ID__">
    <span class="logo" data-marble-id="__ID__" aria-hidden="true">◆</span>
    <h1 data-marble-id="__ID__" data-marble-editable>__TITLE__</h1>
  </div>
  <div class="search" data-marble-transient>
    <input id="q" type="search" placeholder="Search in Drive" autocomplete="off" aria-label="Search in Drive">
  </div>
  <div class="status" id="status" data-marble-transient><span class="dot"></span><span id="status-text">offline</span></div>
</header>

<div class="shell" data-marble-id="__ID__">

  <aside class="side" data-marble-id="__ID__">
    <button class="new" id="new" data-marble-transient><span class="plus">+</span><span class="label">New</span></button>

    <ul class="nav" id="nav" data-marble-id="__ID__" data-marble-sortable="nav">
      <li class="nav-item" data-marble-id="__ID__" data-nav="drive" data-marble-removable>
        <span class="ico" data-marble-id="__ID__">▤</span><span data-marble-id="__ID__" data-marble-editable>My Drive</span>
      </li>
      <li class="nav-item" data-marble-id="__ID__" data-nav="recent" data-marble-removable>
        <span class="ico" data-marble-id="__ID__">◷</span><span data-marble-id="__ID__" data-marble-editable>Recent</span>
      </li>
      <li class="nav-item" data-marble-id="__ID__" data-nav="templates" data-marble-removable>
        <span class="ico" data-marble-id="__ID__">◲</span><span data-marble-id="__ID__" data-marble-editable>Templates</span>
      </li>
      <li class="nav-item" data-marble-id="__ID__" data-nav="trash" data-marble-removable>
        <span class="ico" data-marble-id="__ID__">⌫</span><span data-marble-id="__ID__" data-marble-editable>Trash</span>
      </li>
    </ul>

    <h2 data-marble-id="__ID__" data-marble-editable>Pinned</h2>
    <ul class="pins" id="pins" data-marble-id="__ID__" data-marble-sortable="pins">
      <!-- A pin is a claim this document makes about a folder it cannot see, so
           it is written here in the file and the folder gets the last word on
           whether it still opens. -->
    </ul>

    <div class="quota" data-marble-id="__ID__">
      <div data-marble-id="__ID__" id="weight">—</div>
      <div class="bar" data-marble-id="__ID__"><i id="weight-bar"></i></div>
      <div data-marble-id="__ID__" data-marble-editable>Everything here is a file you can open in a text editor.</div>
    </div>
  </aside>

  <main class="main" data-marble-id="__ID__">
    <div class="crumbs" id="crumbs" data-marble-transient></div>

    <div class="toolbar" data-marble-id="__ID__">
      <button class="chip" id="mk" data-marble-transient>New folder</button>
      <button class="chip" id="up" data-marble-transient>Up</button>
      <span class="spacer"></span>
      <span class="toggle" data-marble-transient>
        <span class="thumb" aria-hidden="true"></span>
        <button data-set-view="grid" title="Grid" aria-label="Grid">
          <svg viewBox="0 0 16 16" aria-hidden="true"><g fill="currentColor">
            <rect x="1.5" y="1.5" width="5.5" height="5.5" rx="1.3"/><rect x="9" y="1.5" width="5.5" height="5.5" rx="1.3"/>
            <rect x="1.5" y="9" width="5.5" height="5.5" rx="1.3"/><rect x="9" y="9" width="5.5" height="5.5" rx="1.3"/>
          </g></svg>
        </button>
        <button data-set-view="list" title="List" aria-label="List">
          <svg viewBox="0 0 16 16" aria-hidden="true"><g fill="currentColor">
            <rect x="1.5" y="2.5" width="13" height="2" rx="1"/><rect x="1.5" y="7" width="13" height="2" rx="1"/><rect x="1.5" y="11.5" width="13" height="2" rx="1"/>
          </g></svg>
        </button>
        <button data-set-view="timeline" title="Timeline" aria-label="Timeline">
          <svg viewBox="0 0 16 16" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
            <path d="M3 1.5v13"/></g><g fill="currentColor">
            <circle cx="3" cy="3.4" r="1.5"/><circle cx="3" cy="8" r="1.5"/><circle cx="3" cy="12.6" r="1.5"/>
            <rect x="6.3" y="2.6" width="8.2" height="1.6" rx=".8" opacity=".85"/>
            <rect x="6.3" y="7.2" width="6" height="1.6" rx=".8" opacity=".85"/>
            <rect x="6.3" y="11.8" width="7.2" height="1.6" rx=".8" opacity=".85"/>
          </g></svg>
        </button>
        <button data-set-view="map" title="Map" aria-label="Map">
          <svg viewBox="0 0 16 16" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.1" opacity=".6">
            <circle cx="8" cy="8" r="6.2"/></g><g fill="currentColor">
            <circle cx="8" cy="8" r="1.9"/><circle cx="13.2" cy="6" r="1.3"/><circle cx="4" cy="2.6" r="1.3"/><circle cx="3.2" cy="12.4" r="1.3"/>
          </g></svg>
        </button>
        <button data-set-view="pulse" title="Pulse" aria-label="Pulse">
          <svg viewBox="0 0 16 16" aria-hidden="true"><g fill="currentColor">
            <rect x="1" y="1" width="3" height="3" rx=".6" opacity=".25"/><rect x="5" y="1" width="3" height="3" rx=".6" opacity=".9"/>
            <rect x="9" y="1" width="3" height="3" rx=".6" opacity=".45"/><rect x="13" y="1" width="2.2" height="3" rx=".6" opacity=".7"/>
            <rect x="1" y="5" width="3" height="3" rx=".6" opacity=".7"/><rect x="5" y="5" width="3" height="3" rx=".6" opacity=".25"/>
            <rect x="9" y="5" width="3" height="3" rx=".6" opacity=".9"/><rect x="13" y="5" width="2.2" height="3" rx=".6" opacity=".45"/>
            <rect x="1" y="9" width="3" height="3" rx=".6" opacity=".45"/><rect x="5" y="9" width="3" height="3" rx=".6" opacity=".7"/>
            <rect x="9" y="9" width="3" height="3" rx=".6" opacity=".25"/><rect x="13" y="9" width="2.2" height="3" rx=".6" opacity=".9"/>
          </g></svg>
        </button>
        <button data-set-view="weight" title="Weight" aria-label="Weight">
          <svg viewBox="0 0 16 16" aria-hidden="true"><g fill="currentColor">
            <rect x="1.3" y="9" width="3" height="6" rx=".8"/><rect x="6.5" y="5" width="3" height="10" rx=".8"/>
            <rect x="11.7" y="1.5" width="3" height="13.5" rx=".8"/>
          </g></svg>
        </button>
      </span>
    </div>

    <div class="listhead" data-marble-id="__ID__">
      <p data-marble-id="__ID__" data-marble-editable>Name</p>
      <p class="owner" data-marble-id="__ID__" data-marble-editable>Nodes</p>
      <p data-marble-id="__ID__" data-marble-editable>Last modified</p>
      <p class="size" data-marble-id="__ID__" data-marble-editable>Size</p>
    </div>

    <div class="items" id="items" data-marble-transient>
      <div class="empty">
        <strong>No host</strong>
        This document is the Drive. Opened on its own it is a page; served by a
        Marble Drive host it is the folder it is sitting in.
      </div>
    </div>
  </main>
</div>

<div class="sheet" id="sheet" data-marble-transient>
  <!-- No sentence at the top of it. The menu that used to open with a line of
       prose above eight more now opens with the eight documents themselves; the
       line it opened with says what a starter is, and it is on the Templates
       page, where somebody who wants to read is already standing. -->
  <div class="tgrid" id="starters" data-compact></div>
  <button type="button" class="sheet-all" id="all-templates">All templates</button>
</div>

<!-- Picking a template does not make a document; it opens a brief. What to call
     it, and what you want built in it — leave that second field alone and this
     is the clone it always was. Transient, all of it: a panel about making a
     document is not part of any document, and none of it is ever written down. -->
<div class="start-scrim" id="start-scrim" data-marble-transient></div>
<div class="start" id="start" data-marble-transient role="dialog" aria-modal="true" aria-labelledby="start-title">
  <div class="start-shot"><span class="tpeek" id="start-preview"></span></div>
  <div class="start-body">
    <h2 id="start-title"></h2>
    <p class="start-blurb" id="start-blurb"></p>
    <label class="start-label" for="start-name">Name</label>
    <input id="start-name" type="text" autocomplete="off" spellcheck="false">
    <label class="start-label" for="start-prompt">What do you want to build? <span>optional</span></label>
    <textarea id="start-prompt" rows="3"></textarea>
    <div class="start-ideas" id="start-ideas"></div>
  </div>
  <div class="start-foot">
    <span class="start-where" id="start-where"></span>
    <button type="button" id="start-cancel">Cancel</button>
    <button type="button" id="start-go">Create</button>
  </div>
</div>

<div class="menu" id="menu" data-marble-transient></div>
<div class="toast" id="toast" data-marble-transient></div>
<div class="ghost" id="ghost" data-marble-transient></div>
<div class="drop" id="drop" data-marble-transient><b></b></div>

<!-- The marquee. A drag over empty space picks every row it covers; hold Option
     and the same drag becomes a line, and every row the line crosses is picked.
     Both are the page's answer to "which ones", so both are transient and
     neither files an op. -->
<div class="band" id="band" data-marble-transient></div>
<svg class="lasso" id="lasso" data-marble-transient><polyline points=""></polyline></svg>

<script>
  // The Drive's own behaviour.
  //
  // Everything on this page is one of two things, and the split is the whole
  // design. The chrome — the name of the drive, the nav labels, the column
  // headings, the pins — is content: it lives in the file, it is edited with
  // ops, and changing it changes the app for good. The listing is not: it is
  // what the folder currently holds, drawn from `marble.drive.tree()` into a
  // transient container, and never written down. A Drive that stored its own
  // listing would have two answers to "what is in this folder" and would show
  // you the wrong one exactly when it mattered.
  (() => {
    const begin = (marble) => {
      const drive = marble.drive;
      if (!drive) return;

      const $ = (sel) => document.querySelector(sel);
      const items = $('#items');
      const crumbs = $('#crumbs');
      const menu = $('#menu');
      const sheet = $('#sheet');
      const toast = $('#toast');
      const ghost = $('#ghost');
      const dropzone = $('#drop');
      const search = $('#q');
      const status = $('#status');

      // Where you are is not a fact about the file. Two people in one drive are
      // allowed to be in different folders, and writing the current path into
      // the document would move one of them every time the other navigated. It
      // lives in the URL fragment instead, which is what makes a folder
      // linkable without making it shared state.
      let here = decodeURIComponent(location.hash.replace(/^#\/?/, ''));
      let view = 'drive';
      let latest = null;
      let query = '';

      const say = (message) => {
        toast.textContent = message;
        toast.setAttribute('data-open', '1');
        clearTimeout(say.timer);
        say.timer = setTimeout(() => toast.removeAttribute('data-open'), 2600);
      };

      const fail = (err) => say(err?.message ?? String(err));

      const bytes = (n) =>
        n < 1024 ? n + ' B' : n < 1048576 ? (n / 1024).toFixed(0) + ' KB' : (n / 1048576).toFixed(1) + ' MB';

      const ago = (t) => {
        const s = Math.max(0, (Date.now() - t) / 1000);
        if (s < 90) return 'just now';
        if (s < 5400) return Math.round(s / 60) + ' min ago';
        if (s < 172800) return Math.round(s / 3600) + ' hr ago';
        return new Date(t).toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
      };

      const leaf = (path) => path.split('/').pop();

      // Top-level folders that wear a realm's colour. A new drive has none;
      // the drive names its own in `.marble/drive.json`, read at boot.
      let REALMS = {};
      const realmOf = (path) => (path ? REALMS[path.split('/')[0]] || '' : '');
      const stampRealm = (el, path) => {
        // Identity is for folders you came for. A folder of nothing but
        // materials does not wear the realm's colour: being grey is most of how
        // it stays out of the way. Read off the element rather than worked out
        // again here, so the attribute the CSS matches on and the decision made
        // in script are one answer.
        const wears = el.dataset.kind === 'folder' && el.dataset.material !== '1';
        const realm = wears ? realmOf(path) : '';
        if (realm) el.dataset.realm = realm;
        else delete el.dataset.realm;
      };

      // A folder is drawn as a folder and a document as a window, because a
      // document here is an app you open. Written down once: the listing draws
      // these and so does a pin, and a pin is markup that goes in the file.
      const ICON = {
        folder:
          '<svg class="glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">' +
          '<path fill="currentColor" d="M2.4 3.404h2.796a.9.9 0 0 1 .9.9v.598a.8.8 0 0 0 .8.8h6.454a1.15 1.15 0 0 1 1.15 1.15v4.594a1.15 1.15 0 0 1-1.15 1.15H2.65A1.15 1.15 0 0 1 1.5 11.446V4.304a.9.9 0 0 1 .9-.9z"/></svg>',
        doc:
          '<svg class="glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">' +
          '<rect x="2.2" y="2.7" width="11.6" height="10.6" rx="2.1" fill="none" stroke="currentColor" stroke-width="1.3"/>' +
          '<path stroke="currentColor" stroke-width="1.3" d="M2.2 6.2h11.6"/>' +
          '<circle cx="4.6" cy="4.45" r=".78" fill="currentColor"/></svg>',
        // A third shape, for a file this Drive does not open — a page with a
        // folded corner, which is what every filesystem has drawn a plain file
        // as for forty years. A document is a window because you go into it;
        // this is a sheet because you only look at it.
        file:
          '<svg class="glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">' +
          '<path fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" ' +
          'd="M3.4 2.3h5.1l4.1 4.1v7.3a1 1 0 0 1-1 1H3.4a1 1 0 0 1-1-1V3.3a1 1 0 0 1 1-1z"/>' +
          '<path fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" d="M8.4 2.4v4.2h4.2"/></svg>',
        open:
          '<svg class="glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">' +
          '<path fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" ' +
          'd="M6.1 3.3H3.6A1.1 1.1 0 0 0 2.5 4.4v8a1.1 1.1 0 0 0 1.1 1.1h8a1.1 1.1 0 0 0 1.1-1.1V9.9"/>' +
          '<path fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" ' +
          'd="M9 3.2h3.8V7M12.8 3.2 7.4 8.6"/></svg>',
      };
      // A file says what kind of thing it is before it is opened: a picture,
      // a song, a film, something to read. Same sheet, same weight, one mark.
      const SHEET =
        '<path fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" ' +
        'd="M3.4 2.3h5.1l4.1 4.1v7.3a1 1 0 0 1-1 1H3.4a1 1 0 0 1-1-1V3.3a1 1 0 0 1 1-1z"/>' +
        '<path fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" d="M8.4 2.4v4.2h4.2"/>';
      const FILE_ICON = {
        image:
          '<svg class="glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">' +
          '<rect x="2.2" y="2.7" width="11.6" height="10.6" rx="2.1" fill="none" stroke="currentColor" stroke-width="1.3"/>' +
          '<path fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" d="m2.6 11.6 3.5-3.7 2.6 2.6 1.5-1.4 3.2 2.9"/>' +
          '<circle cx="10.4" cy="5.9" r="1.05" fill="currentColor"/></svg>',
        audio:
          '<svg class="glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">' +
          '<path fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" d="M6.3 11.7V3.8l6.3-1.4v7.8"/>' +
          '<circle cx="4.6" cy="11.7" r="1.7" fill="none" stroke="currentColor" stroke-width="1.3"/>' +
          '<circle cx="10.9" cy="10.2" r="1.7" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>',
        video:
          '<svg class="glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">' +
          '<rect x="2.2" y="3.2" width="11.6" height="9.6" rx="2.1" fill="none" stroke="currentColor" stroke-width="1.3"/>' +
          '<path fill="currentColor" d="M6.7 5.9v4.2l3.4-2.1z"/></svg>',
        text:
          '<svg class="glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">' + SHEET +
          '<path fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" d="M5 9.3h5.4M5 11.7h3.6"/></svg>',
      };
      FILE_ICON.pdf = FILE_ICON.text;
      FILE_ICON.office = FILE_ICON.text;
      const iconFor = (kind, entry) =>
        kind === 'folder' ? ICON.folder
        : kind === 'file' ? (entry && FILE_ICON[fileKind(entry)]) || ICON.file
        : ICON.doc;

      // What a file is, from its name — the only thing about it the listing
      // knows without asking. Unknown is `other`, which is shown as a glyph.
      const FILE_KINDS = {
        image: 'png jpg jpeg gif webp avif bmp ico heic heif tif tiff svg psd eps ai dng cr2 cr3 nef arw raf orf',
        pdf: 'pdf',
        office: 'doc docx rtf pages odt ppt pptx key odp xls xlsx numbers ods epub',
        video: 'mp4 m4v mov webm ogv mkv avi',
        audio: 'mp3 wav m4a aac flac ogg oga opus aif aiff',
        text: 'txt md markdown json jsonl csv tsv bib tex yml yaml toml ini js mjs cjs ts tsx jsx py rb go rs java c h cpp sh css log bak xml',
      };
      const FILE_KIND = new Map(
        Object.entries(FILE_KINDS).flatMap(([kind, list]) => list.split(' ').map((ext) => [ext, kind])),
      );
      const fileKind = (entry) => FILE_KIND.get(String(entry.ext || '').toLowerCase()) ?? 'other';

      // ------------------------------------------------------------ the listing

      // Some of what a folder holds is the work, and some of it is what the
      // work needed. A `.mrbl` is the work — it is a document this Drive
      // opens. A file that is not one is the folder's own paperwork: the
      // bibliography beside the paper, the cover images, the JSON a script
      // reads. So is a folder that holds nothing but paperwork, all the way
      // down. Those are facts *about* the folder rather than the point of it,
      // and they are drawn accordingly — below the rule, folded away, in grey.
      // Still listed, still openable, still renameable: a representation that
      // hides a file is a representation that loses it.
      //
      // Asked of the tree the host handed over, so it is one derivation from
      // one fact with nothing to keep in sync. Only in the drive view: the
      // trash and Recent hand over entries with no `children`, and a folder
      // whose contents are unknown is not a folder known to hold nothing.
      const holdsDocs = (folder) =>
        (folder.children ?? []).some(
          (child) => child.kind === 'doc' || (child.kind === 'folder' && holdsDocs(child)),
        );
      // An empty folder holds no paperwork either: it is a place nobody has
      // put anything in yet — usually the one just made — so it is drawn as a
      // folder, not folded away under the rule.
      const holdsFiles = (folder) =>
        (folder.children ?? []).some(
          (child) => child.kind === 'file' || (child.kind === 'folder' && holdsFiles(child)),
        );
      //
      // Except a file that shows itself — a song, a film, a photo, a paper.
      // The mp3 beside the mashup is what the mashup is made of, and a strip
      // of names under the rule was a song you could not hear. Those get a
      // tile that plays, pictures or pages them; the text and the data still
      // fold away.
      const SHOWS = new Set(['audio', 'video', 'image', 'pdf', 'office']);
      const isMaterial = (entry) =>
        view === 'drive' &&
        ((entry.kind === 'file' && !SHOWS.has(fileKind(entry))) ||
          (entry.kind === 'folder' && holdsFiles(entry) && !holdsDocs(entry)));

      // Which rows are picked, held as a set of paths rather than elements,
      // because the listing is thrown away and rebuilt on every refresh and a
      // reference would outlive the thing it referred to. One path or many —
      // the area select fills it, a plain click narrows it to one.
      let picked = new Set();

      // Paints a set onto the listing without becoming the selection — the
      // marquee uses this on every move, and commits with pick() on release.
      function paint(set) {
        for (const el of items.querySelectorAll('.item')) {
          el.classList.toggle('marble-picked', set.has(el.dataset.path));
        }
      }

      function pick(paths) {
        picked =
          paths == null ? new Set()
          : typeof paths === 'string' ? new Set([paths])
          : new Set(paths);
        paint(picked);
        aimPicked();
      }

      // Folders and ordinary files are not agent targets. The first picked
      // document is the writable one; the rest are also in view. Nothing
      // document-shaped picked is the same as picking nothing: Drive itself.
      function aimPicked() {
        const agent = window.marble?.agent;
        if (!agent?.aim) return;
        const docs = [...picked].filter((p) =>
          items.querySelector('.item[data-path="' + CSS.escape(p) + '"]')?.dataset.kind === 'doc',
        );
        const [first, ...rest] = docs;
        agent.aim(first ?? null, { also: rest });
      }

      // A document's own weight, 0..1, against the heaviest thing in view —
      // drawn as a bar under its thumbnail so "this one is bigger" is visible
      // before you have opened either. Recomputed per draw against whatever
      // is on screen, so it is a comparison within this folder, not an
      // absolute scale that would make a small folder's biggest file look
      // tiny next to the drive's biggest.
      let heaviest = 1;

      function node(entry) {
        const el = document.createElement('div');
        el.className = 'item';
        el.dataset.kind = entry.kind;
        el.dataset.path = entry.path;
        // What the trash calls it, which is the only handle Restore has:
        // the path a trashed row shows is where it came from and does not
        // resolve any more.
        if (entry.trashId) el.dataset.trashId = entry.trashId;
        stampRealm(el, entry.path);
        if (picked.has(entry.path)) el.classList.add('marble-picked');
        el.innerHTML =
          '<span class="name"><span class="ico">' +
          iconFor(entry.kind, entry) +
          '</span><b></b></span>' +
          '<span class="row-meta owner"></span>' +
          '<span class="row-meta when"></span>' +
          '<span class="row-meta size"></span>' +
          '<button class="more" aria-label="More">⋮</button>' +
          '<span class="thumb"></span>';

        // The label is the name in the folder, because that is the address —
        // what a link points at and what a move changes. What the document
        // calls itself is its own business and lives in the tooltip, which is
        // where the two are allowed to disagree after a rename.
        el.querySelector('b').textContent = entry.name ?? leaf(entry.path);
        el.title = entry.title && entry.title !== entry.name ? entry.title : '';
        // A trashed folder is the one folder that says how much is in it in
        // words: the trash has no tile in list view, and "how much comes back"
        // is the only question a row in there is asked.
        el.querySelector('.owner').textContent =
          entry.kind === 'doc' ? entry.nodes + ' nodes'
          : entry.kind === 'file' ? (entry.ext || 'file').toUpperCase()
          : entry.items != null ? entry.items + (entry.items === 1 ? ' item' : ' items')
          : '—';
        el.querySelector('.when').textContent = entry.modified ? ago(entry.modified) : '';
        el.querySelector('.size').textContent =
          entry.kind === 'doc' || entry.kind === 'file' ? bytes(entry.bytes ?? 0) : '';
        fillThumb(el.querySelector('.thumb'), entry);
        el.querySelector('.thumb').insertAdjacentHTML('beforeend', '<span class="weight"></span>');
        el.querySelector('.thumb .weight').style.setProperty(
          '--w', entry.kind === 'doc' ? Math.sqrt((entry.bytes ?? 0) / heaviest).toFixed(3) : 0,
        );
        return el;
      }

      // A material, as a chip. Still an `.item` carrying a path and a kind, so
      // the pick, the marquee, the drag, the row menu and Enter all reach it
      // without knowing this strip exists — what it drops is the tile, the
      // preview, the columns and the colour. Making it a different *element*
      // would have meant teaching six handlers about a seventh kind of row.
      function materialNode(entry) {
        const el = document.createElement('div');
        el.className = 'item';
        el.dataset.kind = entry.kind;
        el.dataset.path = entry.path;
        el.dataset.material = '1';
        stampRealm(el, entry.path);
        if (picked.has(entry.path)) el.classList.add('marble-picked');
        el.innerHTML =
          '<span class="name"><span class="ico">' + iconFor(entry.kind, entry) + '</span><b></b></span>' +
          '<span class="about"></span>' +
          '<button class="more" aria-label="More">\u22ee</button>';
        el.querySelector('b').textContent = entry.name ?? leaf(entry.path);
        // How much is in it, or what it is: the two forms the question "is this
        // worth opening" takes for the two kinds that end up in here. The count
        // is of what is directly inside, which is what a folder tile's caption
        // counts too — one convention for "how many items", so a chip and a
        // tile can be compared.
        const inside = entry.kind === 'folder' ? (entry.children ?? []).length : 0;
        el.querySelector('.about').textContent =
          entry.kind === 'folder' ? String(inside) : (entry.ext || '').toUpperCase();
        el.title =
          entry.kind === 'folder'
            ? inside + (inside === 1 ? ' item' : ' items') + ', none of them a document'
            : [entry.name, bytes(entry.bytes ?? 0), entry.modified ? ago(entry.modified) : '']
                .filter(Boolean)
                .join(' \u00b7 ');
        return el;
      }

      // Whether the materials are unfolded. The page's answer, like the
      // selection: the listing is thrown away and rebuilt on every refresh so
      // it cannot live on an element, and it is nobody else's business, so it
      // is not an op. It survives navigating between folders on purpose —
      // asking to see the materials is a way of working, not a fact about one
      // folder.
      let matsOpen = false;

      // The footnote. One line saying how much is down here, and the chips
      // behind it. `fixed` is the case where the folder holds nothing else:
      // then the materials *are* the folder, so they are shown and there is no
      // toggle, because a control that cannot change anything is worse than no
      // control.
      function materialStrip(mats, { fixed = false } = {}) {
        const folders = mats.filter((entry) => entry.kind === 'folder').length;
        const files = mats.length - folders;
        const open = fixed || matsOpen;

        const wrap = document.createElement('div');
        wrap.className = 'mats';
        wrap.dataset.open = open ? '1' : '0';
        wrap.innerHTML =
          (fixed
            ? '<div class="mats-head is-fixed">'
            : '<button class="mats-head" type="button" aria-expanded="' + (open ? 'true' : 'false') + '">') +
          (fixed ? '' : '<span class="caret" aria-hidden="true">\u203a</span>') +
          '<span class="what">Materials</span><span class="how-much"></span>' +
          (fixed ? '</div>' : '</button>');

        const count = (n, one, many) => n + ' ' + (n === 1 ? one : many);
        wrap.querySelector('.how-much').textContent = [
          folders && count(folders, 'folder', 'folders'),
          files && count(files, 'file', 'files'),
        ]
          .filter(Boolean)
          .join(' \u00b7 ');

        const body = document.createElement('div');
        body.className = 'mats-body';
        for (const entry of mats) body.append(materialNode(entry));
        wrap.append(body);

        const head = wrap.querySelector('.mats-head');
        if (!fixed) {
          head.addEventListener('click', () => {
            matsOpen = !matsOpen;
            wrap.dataset.open = matsOpen ? '1' : '0';
            head.setAttribute('aria-expanded', matsOpen ? 'true' : 'false');
          });
        }
        return wrap;
      }

      // The tile. A document gets a real, scaled-down view of itself, mounted
      // lazily as it nears the viewport; a folder gets the same treatment for
      // each document child (up to nine), with a glyph for nested folders.
      // Both fall back to the glyph — the document until its frame loads, the
      // folder if it holds nothing.
      const peekObserver = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const peek = e.target;
            peekObserver.unobserve(peek);
            const frame = document.createElement('iframe');
            // Empty sandbox: the file renders, its own injected carrier script
            // does not, and the frame gets an origin of its own. A preview is a
            // picture, not a second live copy.
            frame.setAttribute('sandbox', '');
            frame.setAttribute('scrolling', 'no');
            frame.setAttribute('tabindex', '-1');
            frame.setAttribute('aria-hidden', 'true');
            frame.loading = 'lazy';
            frame.addEventListener('load', () => peek.classList.add('marble-is-loaded'));
            frame.src = peek.dataset.src;
            peek.append(frame);
          }
        },
        { rootMargin: '250px' },
      );

      // ------------------------------------------------------ files, previewed
      //
      // A file cannot draw itself the way a page can, but most of them can
      // still be seen. The host's thumbnailer pictures what the browser cannot
      // (a PDF's first page, a deck, a HEIC photo, an SVG drawn to pixels so
      // its script never runs), and this page does the rest from the bytes: a
      // song's waveform and its cover, a text file's first lines. Everything
      // is asked for once the tile nears the screen, and whatever cannot be
      // shown stays the glyph it was drawn as.
      const NATIVE_IMAGE = new Set(['png', 'jpg', 'jpeg', 'gif', 'webp', 'avif', 'bmp', 'ico']);
      const fileStamp = (entry) => entry.path + '|' + (entry.modified || '') + '|' + (entry.bytes || '');
      const PLAY =
        '<svg class="is-play" viewBox="0 0 14 14" aria-hidden="true"><path fill="currentColor" d="M3.5 1.9v10.2a.6.6 0 0 0 .9.5l8.1-5.1a.6.6 0 0 0 0-1L4.4 1.4a.6.6 0 0 0-.9.5z"/></svg>' +
        '<svg class="is-pause" viewBox="0 0 14 14" aria-hidden="true"><rect x="2.6" y="1.8" width="3.1" height="10.4" rx=".7" fill="currentColor"/><rect x="8.3" y="1.8" width="3.1" height="10.4" rx=".7" fill="currentColor"/></svg>';

      const fileObserver = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            fileObserver.unobserve(e.target);
            mountFile(e.target);
          }
        },
        { rootMargin: '250px' },
      );

      // The preview element. `w` is roughly how wide it will be drawn, so the
      // thumbnailer is asked for a picture that size and not the whole photo.
      function filePreview(entry, { w = 320 } = {}) {
        const kind = fileKind(entry);
        const el = document.createElement('span');
        el.className = 'fp';
        el.dataset.fk = kind;
        el.dataset.path = entry.path;
        el.dataset.ext = entry.ext || '';
        el.dataset.w = String(Math.round(w));
        el.dataset.v = String(entry.modified || '');
        el.dataset.bytes = String(entry.bytes || 0);
        el.innerHTML = '<span class="fp-badge">' + iconFor('file', entry) + '<i></i></span>';
        el.querySelector('.fp-badge i').textContent = (entry.ext || 'file').toUpperCase();
        if (kind === 'audio') {
          el.insertAdjacentHTML(
            'beforeend',
            '<span class="fp-tune"><span class="fp-art" hidden></span>' +
              '<span class="fp-wave" aria-hidden="true"></span>' +
              '<span class="fp-bar"><button class="fp-play" type="button">' + PLAY + '</button>' +
              '<span class="fp-say"><b></b><span class="fp-time"></span></span></span></span>',
          );
          el.querySelector('.fp-play').setAttribute('aria-label', 'Play ' + (entry.name ?? leaf(entry.path)));
          el.querySelector('.fp-time').textContent = bytes(entry.bytes ?? 0);
          tuneSync(el);
        }
        fileObserver.observe(el);
        return el;
      }

      function mountFile(el) {
        const kind = el.dataset.fk;
        const path = el.dataset.path;
        if (kind === 'audio') return mountTune(el);
        if (kind === 'text') {
          fetch(drive.fileHref(path), { headers: { Range: 'bytes=0-3071' } })
            .then((r) => (r.ok ? r.arrayBuffer() : Promise.reject(r.status)))
            .then((buf) => {
              let words = new TextDecoder('utf-8').decode(buf.slice(0, 3072));
              // Bytes that are not text are not worth showing as text.
              if (/[\u0000-\u0008\u000e-\u001f]/.test(words.slice(0, 512))) return;
              const cut = words.lastIndexOf('\n');
              if (cut > 200) words = words.slice(0, cut);
              const pre = document.createElement('pre');
              pre.className = 'fp-text';
              pre.textContent = words;
              el.append(pre);
              el.classList.add('marble-is-ready');
            })
            .catch(() => {});
          return;
        }
        if (kind === 'other') return;
        const img = new Image();
        img.className = 'fp-img';
        img.alt = '';
        img.decoding = 'async';
        const w = Math.min(1280, Math.round(Number(el.dataset.w || 320) * (devicePixelRatio || 1)));
        let fellBack = false;
        img.addEventListener('load', () => {
          el.append(img);
          el.classList.add('marble-is-ready');
          if (kind === 'video') el.insertAdjacentHTML('beforeend', '<span class="fp-mark">' + PLAY.split('</svg>')[0] + '</svg></span>');
        });
        let drew = false;
        img.addEventListener('error', () => {
          // No picture on the host yet: the page draws one and hands it over
          // (marble.drive.drawThumb), so the next visit has it.
          if (!drew && drive.drawThumb) {
            drew = true;
            drive.drawThumb({ path, ext: el.dataset.ext }).then((src) => {
              if (src) img.src = src;
              else if (NATIVE_IMAGE.has(el.dataset.ext)) img.src = drive.fileHref(path);
            });
            return;
          }
          // Nothing drawn either: a picture the browser can show is shown
          // from the file itself, and anything else keeps its glyph.
          if (fellBack || !NATIVE_IMAGE.has(el.dataset.ext)) return;
          fellBack = true;
          img.src = drive.fileHref(path);
        });
        img.src = drive.thumbHref
          ? drive.thumbHref(path, { w, v: el.dataset.v })
          : drive.fileHref(path);
      }

      // ------------------------------------------------------------ songs
      //
      // One player for the page, not one per tile: the listing is thrown away
      // and redrawn on every write anywhere in the drive, and a song should not
      // stop because somebody saved a document. A tile that is drawn again
      // finds the player by the path and picks up where it is.
      const tune = { audio: null, path: '', frame: 0 };

      function tuneEls() {
        return document.querySelectorAll('.fp[data-fk="audio"]');
      }
      const clock = (sec) => {
        if (!Number.isFinite(sec)) return '';
        const s = Math.max(0, Math.round(sec));
        return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
      };

      function tuneSync(only) {
        const a = tune.audio;
        for (const el of only ? [only] : tuneEls()) {
          const mine = !!a && el.dataset.path === tune.path;
          const playing = mine && !a.paused && !a.ended;
          el.classList.toggle('marble-is-playing', playing);
          const known = Number(el.dataset.duration) || (mine && Number.isFinite(a.duration) ? a.duration : 0);
          const at = mine ? a.currentTime : 0;
          el.style.setProperty('--p', known ? Math.min(1, at / known).toFixed(4) : 0);
          const btn = el.querySelector('.fp-play');
          const name = btn?.getAttribute('aria-label')?.replace(/^(Play|Pause) /, '') ?? '';
          btn?.setAttribute('aria-label', (playing ? 'Pause ' : 'Play ') + name);
          const time = el.querySelector('.fp-time');
          if (time && known) time.textContent = mine && at > 0.05 ? clock(at) + ' / ' + clock(known) : clock(known);
        }
      }

      function tuneTick() {
        cancelAnimationFrame(tune.frame);
        const step = () => {
          tuneSync();
          if (tune.audio && !tune.audio.paused) tune.frame = requestAnimationFrame(step);
        };
        tune.frame = requestAnimationFrame(step);
      }

      function tunePlay(path, at = null) {
        if (!tune.audio) {
          tune.audio = new Audio();
          tune.audio.preload = 'auto';
          for (const type of ['play', 'pause', 'ended', 'seeked', 'loadedmetadata', 'emptied']) {
            tune.audio.addEventListener(type, () => (type === 'play' ? tuneTick() : tuneSync()));
          }
        }
        const a = tune.audio;
        if (tune.path !== path) {
          a.pause();
          tune.path = path;
          a.src = drive.fileHref(path);
        }
        const seek = () => {
          if (at != null && Number.isFinite(a.duration)) a.currentTime = at * a.duration;
        };
        if (at != null) {
          if (a.readyState >= 1) seek();
          else a.addEventListener('loadedmetadata', seek, { once: true });
        }
        a.play().catch(() => {});
        tuneSync();
      }

      function tuneToggle(path) {
        const a = tune.audio;
        if (a && tune.path === path && !a.paused) a.pause();
        else tunePlay(path, a && tune.path === path && a.ended ? 0 : null);
      }

      // A control inside a tile is not a press on the tile: it must not pick
      // it, open it, start a drag or draw a marquee.
      const hush = (event) => event.stopPropagation();

      function mountTune(el) {
        const path = el.dataset.path;
        const btn = el.querySelector('.fp-play');
        const wave = el.querySelector('.fp-wave');
        for (const type of ['pointerdown', 'mousedown', 'dblclick', 'auxclick']) {
          btn.addEventListener(type, hush);
          wave.addEventListener(type, hush);
        }
        btn.addEventListener('click', (event) => {
          hush(event);
          tuneToggle(path);
        });
        btn.addEventListener('keydown', hush);
        wave.addEventListener('click', (event) => {
          hush(event);
          const box = wave.getBoundingClientRect();
          tunePlay(path, Math.min(1, Math.max(0, (event.clientX - box.left) / box.width)));
        });

        tagsOf(el.dataset.ext, path, el.dataset.v).then((tags) => {
          if (!tags || !el.isConnected) return;
          const said = [tags.title, tags.artist].filter(Boolean).join(' — ');
          el.querySelector('.fp-say b').textContent = said;
          if (tags.cover) {
            const art = el.querySelector('.fp-art');
            art.innerHTML = '<img alt="">';
            art.firstChild.src = tags.cover;
            art.hidden = false;
            el.classList.add('marble-has-art');
          }
        });
        waveOf(path, el.dataset.v, Number(el.dataset.bytes)).then((got) => {
          if (!got || !el.isConnected) return;
          el.dataset.duration = String(got.duration);
          drawWave(wave, got.peaks);
          el.classList.add('marble-is-ready');
          tuneSync(el);
        });
      }

      // The shape of a song: 400 peaks between 0 and 1, and how long it is.
      // Worked out once from the whole file — decoded at a low rate, which is
      // plenty for a picture — then kept on this machine under the file's
      // version, so a redraw or a reload never decodes it twice.
      const waves = new Map();
      let decoding = Promise.resolve();
      function waveOf(path, v, size) {
        const stamp = path + '|' + v + '|' + size;
        if (waves.has(stamp)) return waves.get(stamp);
        const key = 'marble-drive:wave:' + stamp;
        const got = (async () => {
          try {
            const hit = JSON.parse(localStorage.getItem(key) || 'null');
            if (hit?.p) {
              const raw = atob(hit.p);
              return { duration: hit.d, peaks: Array.from(raw, (c) => c.charCodeAt(0) / 255) };
            }
          } catch {}
          if (!size || size > 150 * 1024 * 1024) return null;
          // One at a time: a folder of albums is a queue, not a stampede.
          const run = decoding.then(async () => {
            const buf = await (await fetch(drive.fileHref(path))).arrayBuffer();
            const ctx = new OfflineAudioContext(1, 1, 8000);
            const audio = await ctx.decodeAudioData(buf);
            const N = 400;
            const chans = Array.from({ length: audio.numberOfChannels }, (_, i) => audio.getChannelData(i));
            const len = chans[0].length;
            const peaks = new Array(N).fill(0);
            for (let b = 0; b < N; b += 1) {
              const from = Math.floor((b * len) / N);
              const to = Math.max(from + 1, Math.floor(((b + 1) * len) / N));
              // Loudness over the slice rather than its one loudest sample,
              // so a song reads as its sections and not as a flat wall.
              let sum = 0;
              let n = 0;
              for (const data of chans) {
                for (let i = from; i < to; i += 2) {
                  sum += data[i] * data[i];
                  n += 1;
                }
              }
              peaks[b] = Math.sqrt(sum / Math.max(1, n));
            }
            // Scaled between the quiet and the loud of this song rather than
            // from silence: a mastered pop song is loud from end to end, and
            // drawn from zero it is a wall. Drawn from its own floor, the
            // verses, the drop and the bridge are shapes you can point at.
            const sorted = [...peaks].sort((a, b) => a - b);
            const top = sorted[Math.floor(N * 0.98)] || 1;
            const floor = sorted[Math.floor(N * 0.04)] * 0.55;
            const shaped = peaks.map((p) => Math.min(1, Math.max(0, (p - floor) / Math.max(1e-6, top - floor)) ** 1.25));
            try {
              localStorage.setItem(
                key,
                JSON.stringify({
                  d: audio.duration,
                  p: btoa(String.fromCharCode(...shaped.map((p) => Math.round(p * 255)))),
                }),
              );
            } catch {}
            return { duration: audio.duration, peaks: shaped };
          });
          decoding = run.catch(() => {});
          return run.catch(() => null);
        })();
        waves.set(stamp, got);
        return got;
      }

      // Bars, square, one per few pixels — resampled from the kept peaks to
      // however wide the tile is. Drawn twice: the whole song faint, and the
      // same shape in full colour clipped to how much has been heard.
      function drawWave(wave, peaks) {
        const width = Math.max(40, wave.clientWidth || 200);
        const n = Math.max(12, Math.min(peaks.length, Math.floor(width / 4)));
        let d = '';
        for (let i = 0; i < n; i += 1) {
          const from = Math.floor((i * peaks.length) / n);
          const to = Math.max(from + 1, Math.floor(((i + 1) * peaks.length) / n));
          let p = 0;
          for (let j = from; j < to; j += 1) p = Math.max(p, peaks[j]);
          const h = Math.max(3, p * 94);
          d += 'M' + (i + 0.16).toFixed(2) + ' ' + (50 - h / 2).toFixed(2) + 'h.68v' + h.toFixed(2) + 'h-.68z';
        }
        const svg = (cls) =>
          '<svg class="' + cls + '" viewBox="0 0 ' + n + ' 100" preserveAspectRatio="none"><path d="' + d + '"/></svg>';
        wave.innerHTML = svg('fp-bars') + svg('fp-heard');
      }

      // What an mp3 says about itself — title, artist, the cover — from the
      // ID3 tag at its head, read with a byte range rather than the whole
      // file. Other formats keep their names.
      const tagCache = new Map();
      function tagsOf(ext, path, v) {
        if (ext !== 'mp3') return Promise.resolve(null);
        const stamp = path + '|' + v;
        if (tagCache.has(stamp)) return tagCache.get(stamp);
        const range = (a, b) =>
          fetch(drive.fileHref(path), { headers: { Range: 'bytes=' + a + '-' + b } }).then((r) =>
            r.ok ? r.arrayBuffer() : Promise.reject(r.status),
          );
        const got = (async () => {
          const head = new Uint8Array(await range(0, 9));
          if (head.length < 10 || head[0] !== 0x49 || head[1] !== 0x44 || head[2] !== 0x33) return null;
          const major = head[3];
          const size = ((head[6] & 127) << 21) | ((head[7] & 127) << 14) | ((head[8] & 127) << 7) | (head[9] & 127);
          if (!size || size > 16 * 1024 * 1024) return null;
          const tag = new Uint8Array(await range(10, 9 + size));
          const view = new DataView(tag.buffer);
          const text = (bytes) => {
            const enc = bytes[0];
            const body = bytes.subarray(1);
            const label = enc === 1 ? 'utf-16' : enc === 2 ? 'utf-16be' : enc === 3 ? 'utf-8' : 'latin1';
            return new TextDecoder(label).decode(body).replace(/\u0000+$/g, '').split('\u0000')[0].trim();
          };
          const out = {};
          let i = 0;
          while (i + 10 <= tag.length) {
            const id = String.fromCharCode(tag[i], tag[i + 1], tag[i + 2], tag[i + 3]);
            if (!/^[A-Z0-9]{4}$/.test(id)) break;
            const len =
              major >= 4
                ? ((tag[i + 4] & 127) << 21) | ((tag[i + 5] & 127) << 14) | ((tag[i + 6] & 127) << 7) | (tag[i + 7] & 127)
                : view.getUint32(i + 4);
            const body = tag.subarray(i + 10, i + 10 + len);
            if (id === 'TIT2') out.title = text(body);
            else if (id === 'TPE1') out.artist = text(body);
            else if (id === 'TALB') out.album = text(body);
            else if (id === 'APIC' && !out.cover) {
              // encoding, mime\0, picture type, description\0 (\0\0 in UTF-16), data
              const enc = body[0];
              let at = body.indexOf(0, 1);
              const mime = new TextDecoder('latin1').decode(body.subarray(1, at)) || 'image/jpeg';
              at += 2;
              if (enc === 1 || enc === 2) {
                while (at + 1 < body.length && (body[at] || body[at + 1])) at += 2;
                at += 2;
              } else {
                while (at < body.length && body[at]) at += 1;
                at += 1;
              }
              const data = body.subarray(at);
              if (data.length > 64) out.cover = URL.createObjectURL(new Blob([data], { type: mime.includes('/') ? mime : 'image/' + mime.toLowerCase() }));
            }
            i += 10 + len;
          }
          return out.title || out.artist || out.cover ? out : null;
        })().catch(() => null);
        tagCache.set(stamp, got);
        return got;
      }

      function fillThumb(thumb, entry) {
        // A file shows what it can of itself: the picture, the page, the
        // song. In the trash it has no address any more, so it keeps its
        // glyph and its kind.
        if (entry.kind === 'file' && view !== 'trash') {
          thumb.append(filePreview(entry, { w: 360 }));
          return;
        }
        if (entry.kind === 'file') {
          thumb.innerHTML =
            '<span class="peek"><span class="big">' + ICON.file + '</span></span><span class="cap"></span>';
          thumb.querySelector('.cap').textContent = (entry.ext || 'file').toUpperCase();
          return;
        }
        if (entry.kind === 'doc') {
          // No caption. The tile is the document, and the document says its own
          // name on its own first line — under a heading that says it a second
          // time. Printing it a third, over the page, was the loudest thing on
          // the tile and it cost the bottom fifth of the preview to a fade.
          thumb.innerHTML = '<span class="peek"><span class="big">' + ICON.doc + '</span></span>';
          const peek = thumb.querySelector('.peek');
          peek.dataset.src = marble.href(entry.path);
          peekObserver.observe(peek);
          return;
        }
        const kids = entry.children ?? [];
        // Documents and folders first: a tile has room for nine cells and they
        // should go to what the folder is for. A material gets a plain cell and
        // never a peek — it has no page to show, and pointing a preview frame
        // at a `.bib` drew a broken document at a real address.
        const shown = [...kids]
          .sort((a, b) => (a.kind === 'file' ? 1 : 0) - (b.kind === 'file' ? 1 : 0))
          .slice(0, 9);
        // A folder in the trash hands over no children — nothing inside it has
        // an address any more — but contents unknown is not contents none, and
        // drawing it "empty" said restoring it would give back nothing. The
        // host sends the kinds and the count instead, so the same cells get
        // drawn from those; none of them gets a peek, because there is no page
        // at the other end to show.
        const drawn = entry.children ? shown.map((k) => k.kind) : entry.kinds ?? [];
        const inside = entry.children ? kids.length : entry.items ?? 0;
        const cells =
          drawn
            .map((kind) =>
              kind === 'folder'
                ? '<span class="cell is-folder"><span class="mini-ico">' + ICON.folder + '</span></span>'
                : kind === 'file'
                  ? '<span class="cell is-mat"><span class="mini-ico">' + ICON.file + '</span></span>'
                  : '<span class="cell is-doc"><span class="peek"><span class="mini-ico">' +
                    ICON.doc +
                    '</span></span></span>',
            )
            .join('') || '<span class="cell is-empty"></span>';
        thumb.innerHTML = '<span class="mini">' + cells + '</span><span class="cap"></span>';
        thumb.querySelector('.cap').textContent = inside
          ? inside + (inside === 1 ? ' item' : ' items')
          : 'empty';
        const peeks = thumb.querySelectorAll('.peek');
        let i = 0;
        for (const k of shown) {
          if (k.kind !== 'doc') continue;
          const peek = peeks[i++];
          peek.dataset.src = marble.href(k.path);
          peekObserver.observe(peek);
        }
      }

      const flatten = (folder, out = []) => {
        for (const child of folder.children ?? []) {
          out.push(child);
          if (child.kind === 'folder') flatten(child, out);
        }
        return out;
      };

      // A folder's own weight is the sum of what is inside it — `tree()` hands
      // back the whole subtree, so this costs a walk that was already free.
      const weightOf = (entry) =>
        entry.kind === 'doc'
          ? entry.bytes ?? 0
          : flatten(entry).reduce((sum, e) => sum + (e.kind === 'doc' ? e.bytes ?? 0 : 0), 0);

      const mode = () => document.body.getAttribute('data-view') || 'grid';

      function draw() {
        // Anything drawn into this container that is not the gallery is a
        // listing again, and wants the listing's own padding back.
        items.removeAttribute('data-gallery');
        if (!latest) return;
        const m = mode();
        // Timeline and Pulse both ask "when" of documents specifically, so
        // both look through the whole subtree rather than one level — a
        // folder's own modified time is when someone last touched *it*, not a
        // fact about what is inside it. Weight asks "how much", which a
        // folder does have an answer to, so it goes recursive but keeps both
        // kinds. Grid, List and Map all still show one level: what is here.
        const docsBelow = () => flatten(latest).filter((entry) => entry.kind === 'doc');
        const pool = query
          ? flatten(latest).filter((entry) =>
              `${entry.title ?? ''} ${entry.path}`.toLowerCase().includes(query),
            )
          : (m === 'timeline' || m === 'pulse') && view === 'drive'
            ? docsBelow()
            : m === 'weight' && view === 'drive'
              ? flatten(latest)
              : latest.children ?? [];

        items.replaceChildren();

        // The split, once, before any lens draws: what the folder is for, and
        // what the folder needed. Every lens below draws the first, and the
        // second is appended in one place afterwards — so there is one answer
        // to where a material goes rather than one per view.
        const work = [];
        const mats = [];
        // A folder that holds nothing but files is those files: the songs,
        // the scans, the photos. Folded into a footnote there, they would be a
        // strip of names under an empty page, so they get tiles of their own.
        const onlyFiles =
          view === 'drive' && !query && pool.length > 0 && pool.every((e) => e.kind === 'file' || isMaterial(e));
        for (const entry of pool) (onlyFiles || !isMaterial(entry) ? work : mats).push(entry);
        // A diagram is not a listing. The map places things by kind around a
        // centre and the pulse counts edits per day; neither has a bottom to
        // hang a footnote off, so in those two the materials stay out of it.
        const footnote = mats.length && m !== 'map' && m !== 'pulse';

        if (!work.length && !mats.length) {
          const empty = document.createElement('div');
          empty.className = 'empty';
          empty.innerHTML = query
            ? '<strong>Nothing matches</strong>Try a different word.'
            : '<strong>This folder is empty</strong>Press New to make something, or drop documents and files in from anywhere.';
          items.append(empty);
          return;
        }

        heaviest = Math.max(1, ...work.map((entry) => (entry.kind === 'doc' ? entry.bytes ?? 0 : 0)));

        if (m === 'timeline') drawTimeline(work);
        else if (m === 'map') drawMap(work);
        else if (m === 'pulse') drawPulse(work);
        else if (m === 'weight') drawWeight(work);
        else {
          work.forEach((entry, i) => {
            const el = node(entry);
            el.style.animationDelay = Math.min(i * 16, 260) + 'ms';
            items.append(el);
          });
        }
        if (footnote) items.append(materialStrip(mats, { fixed: !work.length }));
        // Keep the selection to what is actually on screen — a refresh, a
        // search or a folder change can retire a row that was picked.
        const shown = new Set([...items.querySelectorAll('.item')].map((el) => el.dataset.path));
        let lost = false;
        for (const path of [...picked]) {
          if (!shown.has(path)) {
            picked.delete(path);
            lost = true;
          }
        }
        if (lost) aimPicked();
      }

      // ------------------------------------------------------------- timeline

      function bucketLabel(t) {
        const day = (ms) => {
          const d = new Date(ms);
          return new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
        };
        const days = Math.round((day(Date.now()) - day(t)) / 86400000);
        const d = new Date(t);
        if (days <= 0) return 'Today';
        if (days === 1) return 'Yesterday';
        if (days < 7) return d.toLocaleDateString(undefined, { weekday: 'long' });
        if (d.getFullYear() === new Date().getFullYear()) {
          return days < 32
            ? 'Earlier this month'
            : d.toLocaleDateString(undefined, { month: 'long' });
        }
        return d.toLocaleDateString(undefined, { month: 'long', year: 'numeric' });
      }

      function timelineRow(entry, oldest, newest) {
        const el = document.createElement('div');
        el.className = 'item trow';
        el.dataset.kind = entry.kind;
        el.dataset.path = entry.path;
        stampRealm(el, entry.path);
        if (picked.has(entry.path)) el.classList.add('marble-picked');
        el.innerHTML =
          '<span class="tdot"></span><span class="ico"></span>' +
          '<span class="tname"><b></b><small></small></span>' +
          '<span class="tmeta"></span><button class="more" aria-label="More">⋮</button>';
        el.querySelector('.ico').innerHTML = iconFor(entry.kind, entry);
        el.querySelector('b').textContent = entry.name ?? leaf(entry.path);
        el.title = entry.title && entry.title !== entry.name ? entry.title : '';

        const inFolder = entry.folder && entry.folder !== here ? entry.folder.replace(here ? here + '/' : '', '') : '';
        el.querySelector('small').textContent = inFolder ? 'in ' + inFolder : '';

        el.querySelector('.tmeta').textContent = entry.modified
          ? ago(entry.modified) + (entry.kind === 'doc' ? ' · ' + bytes(entry.bytes) : '')
          : '';

        const span = Math.max(1, newest - oldest);
        const fraction = Math.min(1, Math.max(0.3, (entry.modified - oldest) / span));
        const dot = el.querySelector('.tdot');
        dot.style.opacity = fraction.toFixed(2);
        if (Date.now() - (entry.modified ?? 0) < 3600e3) dot.classList.add('marble-fresh');
        return el;
      }

      // Newest first within each day, and each day heading only drawn once —
      // the same grouping a photo library or a chat history uses, because
      // "when did I touch this" is a question about days, not timestamps.
      function drawTimeline(pool) {
        const docs = [...pool].sort((a, b) => (b.modified ?? 0) - (a.modified ?? 0));
        const oldest = Math.min(...docs.map((e) => e.modified ?? Date.now()));
        const newest = Math.max(...docs.map((e) => e.modified ?? Date.now()));
        let lastLabel = null;
        docs.forEach((entry, i) => {
          const label = bucketLabel(entry.modified ?? Date.now());
          if (label !== lastLabel) {
            lastLabel = label;
            const h = document.createElement('h3');
            h.className = 'tgroup';
            h.textContent = label;
            items.append(h);
          }
          const row = timelineRow(entry, oldest, newest);
          row.style.animationDelay = Math.min(i * 14, 260) + 'ms';
          items.append(row);
        });
      }

      // ------------------------------------------------------------------ map

      function mapNode(entry, weight, maxWeight, oldest, newest) {
        const el = document.createElement('div');
        el.className = 'item node';
        el.dataset.kind = entry.kind;
        el.dataset.path = entry.path;
        stampRealm(el, entry.path);
        if (picked.has(entry.path)) el.classList.add('marble-picked');
        el.innerHTML = '<span class="ico"></span><b></b><button class="more" aria-label="More">⋮</button>';
        el.querySelector('.ico').innerHTML = iconFor(entry.kind, entry);
        el.querySelector('b').textContent = entry.name ?? leaf(entry.path);
        el.title = (entry.title && entry.title !== entry.name ? entry.title + ' — ' : '') +
          (entry.kind === 'doc' ? bytes(entry.bytes) : bytes(weight) + ' inside') +
          (entry.modified ? ' · ' + ago(entry.modified) : '');

        const size = 42 + Math.sqrt(weight / Math.max(1, maxWeight)) * 46;
        el.style.setProperty('--size', size.toFixed(0) + 'px');
        const span = Math.max(1, newest - oldest);
        const fresh = Math.min(1, Math.max(0.4, ((entry.modified ?? oldest) - oldest) / span));
        el.style.setProperty('--fresh', fresh.toFixed(2));
        return el;
      }

      // One ring of folders, one of documents, spread evenly by angle and
      // nudged apart so the two rings don't line up radius-for-radius. Sized
      // by weight rather than placed by it — position here answers "what kind
      // is it", not "how big", because angle has no natural order to lend a
      // size to and would just be lying with axes nobody drew.
      function drawMap(children) {
        // `translate()` resolves a percentage against the *moving element's*
        // own box, not the container — a CSS Transforms rule that would have
        // put every node a few px from center regardless of how big the map
        // is. So the radius is measured in pixels, once per draw, against
        // however much room `.items` actually has this time.
        const box = items.getBoundingClientRect();
        const half = Math.max(140, Math.min(box.width, box.height) / 2 - 40);
        const r1 = Math.round(half * 0.52);
        const r2 = Math.round(half * 0.94);

        const wrap = document.createElement('div');
        wrap.className = 'orbit-wrap';
        wrap.innerHTML =
          '<div class="ring" style="--r:' + r1 + 'px"></div><div class="ring" style="--r:' + r2 + 'px"></div>' +
          '<div class="orbit-center"><span class="ico"></span><b></b><small></small></div>' +
          '<div class="orbit"></div>';
        const centerName = here ? leaf(here) : (document.querySelector('.brand h1').textContent.trim() || 'My Drive');
        wrap.querySelector('.orbit-center .ico').innerHTML = iconFor('folder');
        wrap.querySelector('.orbit-center b').textContent = centerName;
        wrap.querySelector('.orbit-center small').textContent =
          children.length + (children.length === 1 ? ' item' : ' items');

        const folders = children.filter((c) => c.kind === 'folder');
        const docs = children.filter((c) => c.kind === 'doc');
        const weights = children.map((c) => weightOf(c));
        const maxWeight = Math.max(1, ...weights);
        const times = children.map((c) => c.modified ?? Date.now());
        const oldest = Math.min(Date.now(), ...times);
        const newest = Math.max(0, ...times);

        const orbit = wrap.querySelector('.orbit');
        const ring = (list, radiusPct, offset) => {
          list.forEach((entry, i) => {
            const angle = (360 / list.length) * i + offset;
            const el = mapNode(entry, weightOf(entry), maxWeight, oldest, newest);
            el.style.setProperty('--angle', angle.toFixed(1) + 'deg');
            el.style.setProperty('--radius', radiusPct);
            orbit.append(el);
          });
        };
        if (folders.length) ring(folders, r1 + 'px', 0);
        if (docs.length) ring(docs, r2 + 'px', 14);

        items.append(wrap);
      }

      // ---------------------------------------------------------------- weight

      // The map answers "where" by shape; this answers "which ones" by rank —
      // the same numbers `weigh` reports, sorted worst-first so the one
      // document actually worth doing something about is always the top row.
      function drawWeight(pool) {
        const ranked = pool
          .map((entry) => ({ entry, w: weightOf(entry) }))
          .sort((a, b) => b.w - a.w)
          .slice(0, 300);
        const max = Math.max(1, ...ranked.map((r) => r.w));

        ranked.forEach(({ entry, w }, i) => {
          const el = document.createElement('div');
          el.className = 'item';
          el.dataset.kind = entry.kind;
          el.dataset.path = entry.path;
          stampRealm(el, entry.path);
          if (picked.has(entry.path)) el.classList.add('marble-picked');
          el.innerHTML =
            '<span class="wrank"></span><span class="witem-ico"></span>' +
            '<span class="wname"><b></b><small></small></span>' +
            '<span class="wbar"><i></i></span><span class="wmeta"></span>' +
            '<button class="more" aria-label="More">⋮</button>';
          el.querySelector('.wrank').textContent = i + 1 + '.';
          el.querySelector('.witem-ico').innerHTML = iconFor(entry.kind, entry);
          el.querySelector('.wname b').textContent = entry.name ?? leaf(entry.path);
          el.title = entry.title && entry.title !== entry.name ? entry.title : '';
          const rel = entry.folder && entry.folder !== here ? entry.folder.replace(here ? here + '/' : '', '') : '';
          el.querySelector('.wname small').textContent =
            entry.kind === 'folder' ? (rel ? 'in ' + rel : 'folder') : rel ? 'in ' + rel : '';
          el.querySelector('.wbar i').style.setProperty('--w', (w / max).toFixed(3));
          el.querySelector('.wmeta').textContent = bytes(w);
          el.style.animationDelay = Math.min(i * 10, 260) + 'ms';
          items.append(el);
        });
      }

      // ----------------------------------------------------------------- pulse

      // A calendar of activity, one square per day — the timeline asked "what
      // did I touch", this asks "when was I actually in here", which a list of
      // rows cannot show at a glance and a grid of squares can.
      function drawPulse(pool) {
        const DAY = 86400000;
        const startOfDay = (t) => {
          const d = new Date(t);
          return new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
        };
        const today = startOfDay(Date.now());

        const byDay = new Map();
        let oldest = today;
        for (const entry of pool) {
          if (!entry.modified) continue;
          const day = startOfDay(entry.modified);
          if (!byDay.has(day)) byDay.set(day, []);
          byDay.get(day).push(entry);
          if (day < oldest) oldest = day;
        }

        // Twenty weeks, GitHub-scale — enough to see a pattern, not so much
        // that a drive's whole history is one illegible strip.
        const spanDays = Math.min(20 * 7, Math.round((today - oldest) / DAY) + 1);
        const firstDay = today - (spanDays - 1) * DAY;
        const gridStart = firstDay - new Date(firstDay).getDay() * DAY;
        const totalDays = Math.round((today - gridStart) / DAY) + 1;
        const totalEdits = [...byDay.values()].reduce((sum, list) => sum + list.length, 0);

        const wrap = document.createElement('div');
        wrap.innerHTML =
          '<div class="pulse-head"><b>Activity</b><span></span></div>' +
          '<div class="pulse-grid"></div>' +
          '<div class="pulse-legend"><span>Less</span>' +
          '<i data-level="0"></i><i data-level="1"></i><i data-level="2"></i><i data-level="3"></i><i data-level="4"></i>' +
          '<span>More</span></div>' +
          '<div class="pulse-detail"></div>';
        wrap.querySelector('.pulse-head span').textContent =
          totalEdits + (totalEdits === 1 ? ' edit' : ' edits') + ' across ' + byDay.size + (byDay.size === 1 ? ' day' : ' days');

        const grid = wrap.querySelector('.pulse-grid');
        for (let i = 0; i < totalDays; i++) {
          const day = gridStart + i * DAY;
          if (day > today) break;
          const entries = byDay.get(day) ?? [];
          const level = !entries.length ? 0 : entries.length === 1 ? 1 : entries.length <= 3 ? 2 : entries.length <= 6 ? 3 : 4;
          const cell = document.createElement('div');
          cell.className = 'pulse-day';
          cell.dataset.day = day;
          cell.setAttribute('data-level', level);
          cell.title =
            new Date(day).toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' }) +
            ' — ' + (entries.length ? entries.length + (entries.length === 1 ? ' edit' : ' edits') : 'nothing');
          grid.append(cell);
        }

        const detail = wrap.querySelector('.pulse-detail');
        grid.addEventListener('click', (event) => {
          const cell = event.target.closest('.pulse-day');
          if (!cell) return;
          for (const el of grid.querySelectorAll('.pulse-day')) el.classList.toggle('marble-picked', el === cell);
          const day = Number(cell.dataset.day);
          const entries = (byDay.get(day) ?? []).slice().sort((a, b) => b.modified - a.modified);
          detail.replaceChildren();
          const h = document.createElement('h4');
          h.textContent = new Date(day).toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric' });
          detail.append(h);
          if (!entries.length) {
            const empty = document.createElement('div');
            empty.className = 'empty';
            empty.innerHTML = 'Nothing touched this day.';
            detail.append(empty);
            return;
          }
          for (const entry of entries) detail.append(timelineRow(entry, day, day + DAY));
        });

        items.append(wrap);
      }

      function drawCrumbs() {
        crumbs.replaceChildren();
        const parts = here ? here.split('/') : [];
        const add = (label, path) => {
          const button = document.createElement('button');
          button.className = 'crumb';
          button.textContent = label;
          button.dataset.path = path;
          button.addEventListener('click', () => go(path));
          crumbs.append(button);
        };
        add(document.querySelector('.brand h1').textContent.trim() || 'My Drive', '');
        let walked = '';
        for (const part of parts) {
          walked = walked ? walked + '/' + part : part;
          const sep = document.createElement('span');
          sep.className = 'sep';
          sep.textContent = '›';
          crumbs.append(sep);
          add(part, walked);
        }
      }

      // A pin is content, so it is read out of the file — but whether it still
      // opens is the folder's answer, and that is derived onto the element
      // rather than written back into it. The open button is the same kind of
      // derived chrome: every pin gets one, and a reconcile puts it back.
      function drawPins() {
        const known = new Set(flatten(root ?? { children: [] }).map((entry) => entry.path));
        for (const pin of document.querySelectorAll('#pins > .pin')) {
          const path = pin.dataset.path;
          pin.classList.toggle('marble-missing', Boolean(path) && known.size > 0 && !known.has(path));
          ensurePinOpen(pin);
        }
      }

      function ensurePinOpen(pin) {
        let button = pin.querySelector(':scope > .pin-open');
        if (!button) {
          button = document.createElement('button');
          button.type = 'button';
          button.className = 'pin-open';
          button.setAttribute('data-marble-transient', '');
          button.innerHTML = ICON.open;
          pin.append(button);
        }
        const folder = pin.dataset.kind === 'folder';
        const label = folder ? 'Open folder' : 'Open in new tab';
        button.setAttribute('aria-label', label);
        button.title = label;
      }

      function drawNav() {
        for (const item of document.querySelectorAll('#nav > .nav-item')) {
          item.classList.toggle('marble-current', item.dataset.nav === view);
        }
      }

      let root = null;

      async function refresh() {
        try {
          root = await drive.tree('');
          latest = view === 'drive' ? at(root, here) : null;

          if (view === 'recent') latest = { children: flatten(root).filter((e) => e.kind === 'doc').slice(0, 40) };
          if (view === 'trash') latest = { children: (await drive.trash()).map(asTrash) };
          if (view === 'templates') return drawTemplates();

          draw();
          drawCrumbs();
          drawPins();
          weigh();
        } catch (err) {
          fail(err);
        }
      }

      // A trashed thing, as a row. The path is where it *came from* — it does
      // not resolve any more, which is why `trashId` travels with it: the id is
      // the only handle Restore has. Everything else the host measured out of
      // `.marble/trash`, so a row in here is as truthful as a row anywhere
      // else: its real size, its real node count, and for a folder, how many
      // things are inside and what kinds they are.
      const asTrash = (entry) => ({
        kind: entry.kind,
        path: entry.path,
        title: entry.title || leaf(entry.path),
        modified: entry.t,
        bytes: entry.bytes ?? 0,
        nodes: entry.nodes ?? 0,
        ext: entry.ext,
        items: entry.items,
        kinds: entry.kinds,
        trashId: entry.id,
      });

      function at(folder, path) {
        if (!path) return folder;
        let node = folder;
        for (const part of path.split('/')) {
          node = (node.children ?? []).find((child) => child.kind === 'folder' && leaf(child.path) === part);
          if (!node) return { children: [] };
        }
        return node;
      }

      // ---------------------------------------------------------- the gallery
      //
      // A template is a document, so a card for one is a picture of a document.
      // Nothing on it has to be read but the name: the sentence each starter
      // used to wear is one level down, in the brief you get when you pick one.

      // The structure of each starter, drawn. It is what shows while the frame
      // loads and what stays if it never does — and in the card's foot it stays
      // whatever happens, so shape and colour say which template this is before
      // the picture has arrived. A starter with no drawing here gets the plain
      // document mark rather than nothing.
      const SCHEMATIC = {
        doc: '<rect x="3" y="1.8" width="10" height="12.4" rx="1.6"/><path d="M5.4 5.3h5.2M5.4 8h5.2M5.4 10.7h3.2"/>',
        note: '<rect x="1.9" y="4.4" width="9.4" height="9.6" rx="1.6"/><path d="M5.2 2.2h7.2a1.6 1.6 0 0 1 1.6 1.6v7.3"/><path d="M4.5 7.6h4.2M4.5 10.3h2.6"/>',
        sheet: '<rect x="2" y="2.6" width="12" height="10.8" rx="1.4"/><path d="M2 6.2h12M2 9.8h12M6.4 2.6v10.8M10.2 2.6v10.8"/>',
        board: '<rect x="1.8" y="2.4" width="3.6" height="11.2" rx="1.2"/><rect x="6.2" y="2.4" width="3.6" height="7.6" rx="1.2"/><rect x="10.6" y="2.4" width="3.6" height="9.4" rx="1.2"/>',
        canvas: '<rect x="1.8" y="2.2" width="5.2" height="4" rx="1.1"/><rect x="9" y="4.6" width="5.2" height="4" rx="1.1"/><rect x="4.4" y="9.2" width="5.2" height="4.4" rx="1.1"/>',
        slides: '<rect x="1.8" y="2.6" width="12.4" height="8.2" rx="1.4"/><path d="M4.8 13.4h6.4"/>',
        paper: '<rect x="2.4" y="1.8" width="11.2" height="12.4" rx="1.4"/><path d="M5 4.4h6"/><rect x="4.6" y="6.6" width="2.8" height="5" rx=".6"/><rect x="8.6" y="6.6" width="2.8" height="5" rx=".6"/>',
        latex: '<rect x="2.4" y="1.8" width="11.2" height="12.4" rx="1.4"/><path d="M4.9 4.4h6.2"/><path d="M10 7H6l2.1 2.1L6 11.2h4"/>',
      };

      const schematic = (id) =>
        '<svg class="tglyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">' +
        '<g fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">' +
        (SCHEMATIC[id] ?? SCHEMATIC.doc) + '</g></svg>';

      // What can be read on a given accent. The seven run from Pearl to
      // Research green, and one fixed label colour is unreadable at one end or
      // the other — so it is measured rather than picked. White and near-black
      // cross over at a relative luminance of .189: above it the dark label is
      // the higher contrast of the two, below it the white one is.
      function onTint(hex) {
        const n = parseInt(String(hex).replace('#', ''), 16);
        if (!Number.isFinite(n)) return '#ffffff';
        const lin = (c) => (c / 255 <= 0.04045 ? c / 255 / 12.92 : ((c / 255 + 0.055) / 1.055) ** 2.4);
        const luma = 0.2126 * lin((n >> 16) & 255) + 0.7152 * lin((n >> 8) & 255) + 0.0722 * lin(n & 255);
        return luma > 0.189 ? '#101010' : '#ffffff';
      }

      function tinted(el, accent) {
        el.style.setProperty('--tint', accent);
        el.style.setProperty('--on-tint', onTint(accent));
      }

      // One card, at whichever density it was asked for. The same element in the
      // page's grid and in the New popover, because picking a template is one
      // gesture and a thing that looks the same has to behave the same.
      function templateCard(starter) {
        const card = document.createElement('button');
        card.type = 'button';
        card.className = 'tcard';
        card.dataset.id = starter.id;
        card.dataset.accent = starter.accent;
        tinted(card, starter.accent);
        card.setAttribute('aria-label', 'Start from the ' + starter.title + ' template');
        // The sentence is not on the card, but it is not hidden either: a hover
        // is where somebody who wants it will look for it.
        card.title = starter.blurb;
        card.innerHTML =
          '<span class="tpeek">' + schematic(starter.id) + '</span>' +
          '<span class="tfoot">' + schematic(starter.id) + '<b></b></span>';
        card.querySelector('.tfoot b').textContent = starter.title;
        const peek = card.querySelector('.tpeek');
        // The same lazy observer the listing's tiles use: one place that knows
        // how a preview is mounted, whatever is being previewed.
        peek.dataset.src = drive.starterPreviewHref(starter.id);
        peekObserver.observe(peek);
        card.addEventListener('click', () => openStart(starter, card));
        return card;
      }

      async function drawTemplates() {
        const starters = await drive.starters();
        const lead = document.createElement('p');
        lead.className = 'tlead';
        lead.textContent =
          'Every template is a document you clone. The copy is yours — including the parts of it you would rather were different.';
        const grid = document.createElement('div');
        grid.className = 'tgrid';
        for (const starter of starters) grid.append(templateCard(starter));
        // The listing's padding is set per view and the gallery is not a
        // listing; `#items` is transient, so this attribute is the page's to
        // set and is never written down.
        items.dataset.gallery = '1';
        items.replaceChildren(lead, grid);
        drawCrumbs();
      }

      // ------------------------------------------------------------ the brief

      const startPanel = $('#start');
      const startScrim = $('#start-scrim');
      // The template the panel is about, and the card it grew out of — which is
      // also where focus goes back to when it closes.
      let starting = null;

      function openStart(starter, from) {
        starting = { starter, from };
        tinted(startPanel, starter.accent);
        $('#start-title').textContent = starter.title;
        $('#start-blurb').textContent = starter.blurb;

        const shot = $('#start-preview');
        shot.className = 'tpeek';
        shot.innerHTML = schematic(starter.id);
        shot.dataset.src = drive.starterPreviewHref(starter.id);
        peekObserver.observe(shot);

        const name = $('#start-name');
        const wish = $('#start-prompt');
        name.value = starter.title;
        wish.value = '';
        wish.placeholder = starter.hint ?? '';
        paintGo();

        const ideas = $('#start-ideas');
        ideas.replaceChildren();
        for (const idea of starter.ideas ?? []) {
          const chip = document.createElement('button');
          chip.type = 'button';
          chip.textContent = idea;
          chip.addEventListener('click', () => {
            wish.value = idea;
            wish.focus();
            paintGo();
          });
          ideas.append(chip);
        }

        $('#start-where').textContent = 'into ' + (here || 'My Drive');

        sheet.removeAttribute('data-open');
        growFrom(startPanel, from);
        startScrim.setAttribute('data-open', '1');
        startPanel.setAttribute('data-open', '1');
        // Selected, not just filled: the name a template suggests is a name you
        // should be able to replace by typing.
        name.focus();
        name.select();
      }

      // Out of the card that was pressed, and back into it. The panel is
      // centred, so the origin is that card's middle expressed in the panel's
      // own box — measured off `offsetWidth`, which is the layout size and not
      // the scaled one the transform is currently showing.
      function growFrom(panel, from) {
        const box = from?.getBoundingClientRect?.();
        if (!box) return panel.style.removeProperty('--from');
        const w = panel.offsetWidth;
        const h = panel.offsetHeight;
        const clamp = (v, hi) => Math.max(0, Math.min(hi, v));
        const x = clamp(box.left + box.width / 2 - (innerWidth / 2 - w / 2), w);
        const y = clamp(box.top + box.height / 2 - (innerHeight / 2 - h / 2), h);
        panel.style.setProperty('--from', x + 'px ' + y + 'px');
      }

      function closeStart() {
        if (startPanel.getAttribute('data-open') !== '1') return false;
        startPanel.removeAttribute('data-open');
        startScrim.removeAttribute('data-open');
        const back = starting?.from;
        starting = null;
        // A panel that closes onto nothing leaves you looking for where you were.
        if (back?.isConnected) back.focus();
        return true;
      }

      // One button, and it says which of the two things it is about to do.
      // Two buttons where one is always dead is a choice you have to read.
      function paintGo() {
        const go = $('#start-go');
        if (go.disabled) return;
        go.textContent = $('#start-prompt').value.trim() ? 'Create & build' : 'Create';
      }

      // Short, because the agent is already told what a Marble document is and
      // what the ids in it are for. What it cannot know is which template this
      // came out of and that every part of it is fair game.
      const briefFor = (starter, words) =>
        'I just made this document from the “' + starter.title + '” template in Marble Drive — ' +
        'a fresh clone, so all of it is mine to change.\n\n' +
        'What I want: ' + words + '\n\n' +
        'Build it in this document. Keep it one file that works on its own, the way the template does.';

      async function commitStart() {
        if (!starting) return;
        const { starter } = starting;
        const go = $('#start-go');
        if (go.disabled) return;
        const name = $('#start-name').value.trim() || starter.title;
        const words = $('#start-prompt').value.trim();
        const said = go.textContent;
        // The answer happens at the control, not in a toast across the room.
        go.disabled = true;
        go.textContent = 'Creating…';

        let made;
        try {
          made = await drive.create({ path: [here, name].filter(Boolean).join('/'), from: starter.id });
        } catch (err) {
          go.disabled = false;
          go.textContent = said;
          return fail(err);
        }

        if (!words) {
          location.href = made.href;
          return;
        }

        // The document exists now whatever happens next, so a failure from here
        // is said out loud and then walked past. Losing the file because no
        // agent could be reached would be much the worse of the two outcomes.
        try {
          const settings = await marble.agent.settings();
          const conversation = await marble.agent.start({ provider: settings.defaultProvider });
          await marble.agent.send(conversation, {
            prompt: briefFor(starter, words),
            target: made.path,
            viewing: made.path,
            selection: [],
          });
          location.href = made.href + '#chat=' + encodeURIComponent(conversation);
        } catch {
          say('Made ' + made.path + ' — but there is no agent here to build it');
          location.href = made.href;
        }
      }

      async function weigh() {
        const all = flatten(root ?? { children: [] }).filter((entry) => entry.kind === 'doc');
        const total = all.reduce((sum, entry) => sum + (entry.bytes ?? 0), 0);
        const nodes = all.reduce((sum, entry) => sum + (entry.nodes ?? 0), 0);
        document.querySelector('#weight').textContent =
          all.length + ' documents · ' + bytes(total) + ' · ' + nodes.toLocaleString() + ' addressable nodes';
        // Not a quota — there is no quota. It is the same number the `weigh`
        // command reports, drawn so that a drive getting heavy is visible
        // before it is a problem.
        document.querySelector('#weight-bar').style.width = Math.min(100, (total / 5e7) * 100) + '%';
      }

      // ----------------------------------------------------------- navigation

      // Opening is a folder you go into or a document you leave for — or, held
      // open beside this one, a document you leave a tab running. Named once so
      // the pointer, the keyboard and a modifier key all commit to the same
      // thing rather than three routes that could drift apart.
      function openItem(item, { newTab = false } = {}) {
        if (!item) return;
        if (item.dataset.kind === 'folder') {
          if (newTab) return window.open(location.pathname + '#/' + item.dataset.path, '_blank');
          return go(item.dataset.path);
        }
        if (view === 'trash') return say('Restore it first — it is in the trash.');
        // A material is not an app, so it always opens beside the Drive rather
        // than in place of it: there would be nothing in there to come back
        // with, and the host — not this document — is the one that decides
        // whether a given file is shown or handed over as a download.
        if (item.dataset.kind === 'file') {
          window.open(drive.fileHref(item.dataset.path), '_blank');
          return;
        }
        if (newTab) window.open(marble.href(item.dataset.path), '_blank');
        else location.href = marble.href(item.dataset.path);
      }

      function go(path) {
        here = path;
        view = 'drive';
        location.hash = path ? '#/' + path : '';
        drawNav();
        refresh();
      }

      addEventListener('hashchange', () => {
        const wanted = decodeURIComponent(location.hash.replace(/^#\/?/, ''));
        if (wanted !== here) {
          here = wanted;
          refresh();
        }
      });

      // A drag ends in a click, because a pointer that went down and came up
      // over the listing is a click as far as the browser is concerned. Without
      // this, dropping a document into a folder also opened it — the move
      // worked and then the page left before you could see it.
      let dragged = 0;

      // One click says which one, two says go. A row you can name without
      // leaving the folder is what the menu verbs have always wanted — until
      // now the only way to point at a document was to open it. Empty space is
      // an answer too: it means none of them.
      items.addEventListener('click', (event) => {
        if (Date.now() - dragged < 400) return;
        const item = event.target.closest('.item');
        if (!item) return pick(null);
        const more = event.target.closest('.more');
        // Cmd or Shift adds and removes without disturbing the rest — the
        // keyboard half of what the marquee does with a drag.
        if (!more && (event.metaKey || event.ctrlKey || event.shiftKey)) {
          const next = new Set(picked);
          next.delete(item.dataset.path) || next.add(item.dataset.path);
          return pick(next);
        }
        // A row menu opened on a row that is already part of a selection
        // speaks for the whole selection — see `openMenu`. Narrowing to the
        // row first made that branch unreachable: "these four" can only be
        // asked from one of the four, and the asking threw the other three
        // away before the menu was built.
        if (!more || !picked.has(item.dataset.path)) pick(item.dataset.path);
        if (more) openMenu(item, more);
      });

      items.addEventListener('dblclick', (event) => {
        if (Date.now() - dragged < 400) return;
        if (event.target.closest('.more')) return;
        openItem(event.target.closest('.item'), { newTab: event.metaKey || event.ctrlKey });
      });

      // The middle button never fires a click at all — a browser reports it as
      // `auxclick` — so a new tab on the wheel-click a mouse is for has to be
      // heard separately rather than folded into the handler above.
      items.addEventListener('auxclick', (event) => {
        if (event.button !== 1) return;
        const item = event.target.closest('.item');
        if (!item || item.dataset.kind === 'folder') return;
        event.preventDefault();
        openItem(item, { newTab: true });
      });

      document.querySelector('#up').addEventListener('click', () => {
        go(here.includes('/') ? here.slice(0, here.lastIndexOf('/')) : '');
      });

      // Which room you are in. Named, because the nav is not the only thing
      // that sends you somewhere — the New menu's way out does too, and two
      // copies of "set it, paint it, draw it" would drift apart.
      function goView(next) {
        view = next;
        if (view === 'drive') return go(here);
        drawNav();
        refresh();
      }

      document.querySelector('#nav').addEventListener('click', (event) => {
        const item = event.target.closest('.nav-item');
        if (!item || !item.dataset.nav) return;
        goView(item.dataset.nav);
      });

      // A plain click on a pin focuses its label — the pin's name is
      // `data-marble-editable`, and a click that also navigated would either
      // unload the page before a keystroke landed (a document pin) or switch
      // what the main pane is showing out from under you mid-edit (a folder
      // pin). Opening is the dedicated button: one click, a new tab for a
      // document, the folder itself for a folder. Cmd/Ctrl-click and
      // double-click still open, for the same convention the listing uses.
      document.querySelector('#pins').addEventListener('click', (event) => {
        const pin = event.target.closest('.pin');
        if (!pin || !pin.dataset.path) return;
        if (event.target.closest('.pin-open')) {
          event.preventDefault();
          if (pin.dataset.kind === 'folder') return go(pin.dataset.path);
          window.open(marble.href(pin.dataset.path), '_blank');
          return;
        }
        if (!event.metaKey && !event.ctrlKey) return;
        if (pin.dataset.kind === 'folder') return go(pin.dataset.path);
        window.open(marble.href(pin.dataset.path), '_blank');
      });

      document.querySelector('#pins').addEventListener('dblclick', (event) => {
        const pin = event.target.closest('.pin');
        if (!pin || !pin.dataset.path) return;
        if (pin.dataset.kind === 'folder') return go(pin.dataset.path);
        if (event.metaKey || event.ctrlKey) window.open(marble.href(pin.dataset.path), '_blank');
        else location.href = marble.href(pin.dataset.path);
      });

      document.querySelector('#pins').addEventListener('auxclick', (event) => {
        if (event.button !== 1) return;
        const pin = event.target.closest('.pin');
        if (!pin || !pin.dataset.path || pin.dataset.kind === 'folder') return;
        event.preventDefault();
        window.open(marble.href(pin.dataset.path), '_blank');
      });

      search.addEventListener('input', () => {
        query = search.value.trim().toLowerCase();
        draw();
      });

      // ------------------------------------------------------------ the verbs

      const newButton = document.querySelector('#new');
      newButton.addEventListener('click', async () => {
        if (sheet.getAttribute('data-open') === '1') return sheet.removeAttribute('data-open');
        const starters = await drive.starters();
        const grid = document.querySelector('#starters');
        grid.replaceChildren();
        for (const starter of starters) grid.append(templateCard(starter));
        // Hung under the button that opened it, nudged back inside the window at
        // the edges — the same placement the row menu does off its anchor. The
        // rect is read from the button held in scope, not from the event: this
        // handler awaits, and after the await the event's currentTarget is gone.
        sheet.setAttribute('data-open', '1');
        const box = newButton.getBoundingClientRect();
        sheet.style.left = Math.max(8, Math.min(box.left, innerWidth - sheet.offsetWidth - 8)) + 'px';
        sheet.style.top = Math.min(box.bottom + 6, innerHeight - sheet.offsetHeight - 8) + 'px';
      });

      document.querySelector('#mk').addEventListener('click', async () => {
        const name = prompt('Name for the new folder');
        if (!name) return;
        try {
          await drive.mkdir([here, name].filter(Boolean).join('/'));
          refresh();
        } catch (err) {
          fail(err);
        }
      });

      function openMenu(item, anchor) {
        const path = item.dataset.path;
        const isFolder = item.dataset.kind === 'folder';
        // A file this Drive does not open. Rename, Move to… and the trash all
        // still mean what they mean — the store moves any of the three kinds —
        // but a copy and a pin are both about documents.
        const isFile = item.dataset.kind === 'file';
        const trashed = view === 'trash';
        menu.replaceChildren();

        const add = (label, fn, key = '') => {
          const button = document.createElement('button');
          button.append(label);
          if (key) {
            const hint = document.createElement('span');
            hint.className = 'key';
            hint.textContent = key;
            button.append(hint);
          }
          button.addEventListener('click', async () => {
            menu.removeAttribute('data-open');
            try {
              await fn();
            } catch (err) {
              fail(err);
            }
          });
          menu.append(button);
        };

        // A menu on a row that is part of a larger selection speaks for the
        // whole selection — Rename and Move to… stop making sense once there
        // is more than one "it", so the bulk menu only offers what still does.
        const bulk = !trashed && picked.size > 1 && picked.has(path);

        if (trashed) {
          add('Restore', async () => {
            await drive.restore(item.dataset.trashId);
            refresh();
          });
        } else if (bulk) {
          const paths = [...picked];
          const docs = paths.filter((p) => items.querySelector('.item[data-path="' + CSS.escape(p) + '"]')?.matches('[data-kind="doc"]'));
          if (docs.length) {
            add('Open ' + docs.length + ' in new tabs', () => {
              for (const p of docs) window.open(marble.href(p), '_blank');
            });
          }
          menu.append(document.createElement('hr'));
          // The hint is derived from the same question the key asks, so the
          // menu cannot end up promising a key that would refuse.
          add('Move ' + paths.length + ' to trash', trashPicked, foldersPicked() ? '' : '⌫');
        } else {
          if (isFile) {
            add('Open beside this', () => window.open(drive.fileHref(path), '_blank'));
          } else if (!isFolder) {
            add('Open', () => (location.href = marble.href(path)), '⏎');
            add('Open in new tab', () => window.open(marble.href(path), '_blank'));
          }
          add('Rename…', async () => {
            const name = prompt('New name', leaf(path));
            if (!name || name === leaf(path)) return;
            const parent = path.includes('/') ? path.slice(0, path.lastIndexOf('/')) : '';
            await drive.move(path, [parent, name].filter(Boolean).join('/'));
            refresh();
          });
          add('Move to…', async () => {
            const to = prompt('Folder to move it into (blank for the top)', here);
            if (to === null) return;
            await drive.move(path, [to.trim().replace(/^\/+|\/+$/g, ''), leaf(path)].filter(Boolean).join('/'));
            refresh();
          });
          // A pin is a shortcut to something you go into or open, and neither
          // is what a material is.
          if (!isFile) add(pinned(path) ? 'Unpin' : 'Pin to sidebar', () => togglePin(path, isFolder));
          if (!isFolder && !isFile) {
            add('Make a copy', async () => {
              await drive.create({ path: path + ' copy', copy: path });
              refresh();
            });
            add('Download (one file)', () => window.open(drive.downloadHref(path), '_blank'));
          }
          menu.append(document.createElement('hr'));
          add('Move to trash', async () => {
            await drive.remove(path);
            refresh();
          }, isFolder ? '' : '⌫');
        }

        const box = anchor.getBoundingClientRect();
        menu.style.left = Math.min(box.left, innerWidth - 220) + 'px';
        menu.style.top = Math.min(box.bottom + 4, innerHeight - 260) + 'px';
        menu.setAttribute('data-open', '1');
      }

      addEventListener('pointerdown', (event) => {
        if (!menu.contains(event.target) && !event.target.closest('.more')) {
          menu.removeAttribute('data-open');
        }
        if (!sheet.contains(event.target) && !event.target.closest('#new')) {
          sheet.removeAttribute('data-open');
        }
      });

      $('#all-templates').addEventListener('click', () => {
        sheet.removeAttribute('data-open');
        goView('templates');
      });

      $('#start-go').addEventListener('click', commitStart);
      $('#start-cancel').addEventListener('click', closeStart);
      startScrim.addEventListener('click', closeStart);
      $('#start-prompt').addEventListener('input', paintGo);
      // Enter accepts the name, because a name is one line. In the wish it is a
      // new line, and the commit is the modifier — the field is the thing you
      // are writing in, and it keeps its own key.
      $('#start-name').addEventListener('keydown', (event) => {
        if (event.key !== 'Enter') return;
        event.preventDefault();
        commitStart();
      });
      $('#start-prompt').addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' || !(event.metaKey || event.ctrlKey)) return;
        event.preventDefault();
        commitStart();
      });

      addEventListener('keydown', (event) => {
        // The brief is the innermost layer and it is made of fields, so its
        // Escape has to be answered before the guard below that lets a field
        // keep its own keys — otherwise the one place you are certainly typing
        // is the one place Escape does not work.
        if (event.key === 'Escape' && closeStart()) {
          event.preventDefault();
          return;
        }
        // A document in the drive is editable content, and Enter inside it is a
        // paragraph, not a command. Only the page's own chrome gets these keys.
        // composedPath, not target: the agent composer lives in shadow DOM, and
        // a retargeted Enter would otherwise open the picked document.
        const typing = event.composedPath().some((node) =>
          node.matches?.(
            'input, textarea, select, [contenteditable="true"], [contenteditable=""], [data-marble-editable]',
          ),
        );
        if (typing) return;
        if (event.target?.closest?.('.fp')) return;
        if (event.key === 'Enter') {
          if (picked.size !== 1) return;
          const item = items.querySelector('.item.marble-picked');
          if (!item) return;
          event.preventDefault();
          return openItem(item, { newTab: event.metaKey || event.ctrlKey });
        }
        if ((event.key === 'Backspace' || event.key === 'Delete') && picked.size && view !== 'trash') {
          event.preventDefault();
          // A folder leaves with everything inside it, and a keystroke is not
          // enough of a decision for that. Nothing in the selection goes, not
          // even the documents in it: a key that deletes some of what is
          // picked is worse than a key that deletes none of it. The ⋮ menu
          // still throws a folder away, deliberately, and says so here.
          if (foldersPicked()) return say('Delete a folder from its ⋮ menu.');
          return trashPicked();
        }
        if (event.key !== 'Escape') return;
        // Escape undoes the last thing you opened, one layer at a time: the row
        // menu, then the New menu, then the selection itself.
        const layered = menu.getAttribute('data-open') === '1' || sheet.getAttribute('data-open') === '1';
        menu.removeAttribute('data-open');
        sheet.removeAttribute('data-open');
        if (!layered) pick(null);
      });

      // Is any of what is picked a folder? Asked of the listing rather than
      // kept alongside the selection, because the listing is the one that
      // knows what a path is — the same reason `picked` holds paths.
      const foldersPicked = () =>
        [...picked].some(
          (path) =>
            items.querySelector('.item[data-path="' + CSS.escape(path) + '"]')?.dataset.kind ===
            'folder',
        );

      // However many are picked, one press throws all of them away — to the
      // trash, not to nowhere, so it costs nothing to be wrong about it.
      async function trashPicked() {
        const paths = [...picked];
        pick(null);
        const results = await Promise.allSettled(paths.map((path) => drive.remove(path)));
        const failed = results.filter((r) => r.status === 'rejected').length;
        refresh();
        if (failed) say(failed + ' of ' + paths.length + ' could not be trashed');
        else say(paths.length === 1 ? 'Moved to trash' : 'Moved ' + paths.length + ' to trash');
      }

      // --------------------------------------------------------------- pinning
      //
      // The one place in this document where the listing and the file meet. A
      // pin is markup, so pinning files an insert and unpinning files a remove,
      // and both are undoable with the same keys as any other edit.

      const pinned = (path) => Boolean(document.querySelector('#pins > .pin[data-path="' + CSS.escape(path) + '"]'));

      function togglePin(path, isFolder) {
        const list = document.querySelector('#pins');
        const already = list.querySelector('.pin[data-path="' + CSS.escape(path) + '"]');

        if (already) {
          const op = { type: 'remove', id: marble.id(already) };
          const inverse = marble.invert(op);
          already.remove();
          if (inverse) marble.record({ redo: [op], undo: [inverse] });
          marble.op(op, { immediate: true });
          return say('Unpinned');
        }

        const id = marble.newId();
        const label = marble.newId();
        const icon = marble.newId();
        const html =
          '<li class="pin" data-marble-id="' + id + '" data-path="' + path + '" data-kind="' +
          (isFolder ? 'folder' : 'doc') + '" data-marble-removable>' +
          '<span class="ico" data-marble-id="' + icon + '">' + iconFor(isFolder ? 'folder' : 'doc') + '</span>' +
          '<span data-marble-id="' + label + '" data-marble-editable>' + leaf(path) + '</span></li>';
        const op = { type: 'insert', html, parentId: marble.id(list), beforeId: null };
        marble.apply(op);
        marble.record({ redo: [op], undo: [{ type: 'remove', id }] });
        marble.op(op, { immediate: true });
        drawPins();
        say('Pinned — the sidebar is part of the file now');
      }

      // ------------------------------------------------------------- the drags
      //
      // Pointer events rather than the drag-and-drop API, for the same reason
      // the sortable affordance is: a finger fires no dragstart, and a Drive you
      // cannot use on a phone is not one you can use.

      let lifting = null;
      let over = null;

      items.addEventListener('pointerdown', (event) => {
        // Timeline and map show you the drive; grid and list are where you
        // rearrange it. A map node's position is a `rotate/translate`, not a
        // place a drop target can be read back from, and a timeline row has
        // no folder under it to drop onto — "Move to…" in the row menu still
        // reaches both.
        if (mode() === 'timeline' || mode() === 'map') return;
        const item = event.target.closest('.item');
        if (!item || event.target.closest('.more') || view === 'trash') return;
        lifting = { item, x: event.clientX, y: event.clientY, moved: false };
      });

      addEventListener('pointermove', (event) => {
        if (!lifting) return;
        const far = Math.hypot(event.clientX - lifting.x, event.clientY - lifting.y) > 6;
        if (!far && !lifting.moved) return;

        if (!lifting.moved) {
          lifting.moved = true;
          lifting.item.classList.add('marble-lifting');
          ghost.textContent = lifting.item.querySelector('b').textContent;
          ghost.setAttribute('data-open', '1');
          lifting.item.setPointerCapture?.(event.pointerId);
        }
        ghost.style.left = event.clientX + 12 + 'px';
        ghost.style.top = event.clientY + 12 + 'px';

        const under = document.elementFromPoint(event.clientX, event.clientY);
        const folder = under?.closest?.('.item[data-kind="folder"], .crumb, .nav-item[data-nav="drive"]');
        if (over !== folder) {
          over?.classList.remove('marble-drop');
          over = folder && folder !== lifting.item ? folder : null;
          over?.classList.add('marble-drop');
        }
      });

      addEventListener('pointerup', async () => {
        if (!lifting) return;
        const { item, moved } = lifting;
        const target = over;
        lifting = null;
        if (moved) dragged = Date.now();
        over?.classList.remove('marble-drop');
        over = null;
        ghost.removeAttribute('data-open');
        item.classList.remove('marble-lifting');
        if (!moved || !target) return;

        const from = item.dataset.path;
        const into = target.classList.contains('item') ? target.dataset.path : (target.dataset.path ?? '');
        try {
          await drive.move(from, [into, leaf(from)].filter(Boolean).join('/'));
          say('Moved into ' + (into || 'My Drive'));
          refresh();
        } catch (err) {
          fail(err);
        }
      });

      // ------------------------------------------------------------ the marquee
      //
      // A drag that starts on empty space picks rows in bulk. Plain, it is a
      // rectangle and every row it covers is picked. With Option held it is a
      // line, and every row the line crosses is picked and stays picked — the
      // "curve select" a rectangle cannot do around a bend. Neither files an
      // op: a selection is where your attention is, and it dies with the tab.
      //
      // Pointer events, like every other drag here, so a finger can do it too.
      // It starts only when the pointer went down on the container and not on
      // a row, which is why it can share `#items` with the lift above.

      const band = $('#band');
      const lasso = $('#lasso');
      const lassoLine = lasso.querySelector('polyline');
      let marquee = null;

      const inRect = (x, y, r) => x >= r.left && x <= r.right && y >= r.top && y <= r.bottom;

      // Do the segments p→q and a→b cross? Enough for "the line went through
      // this row" — collinear grazes are not worth the extra branch.
      function segmentsCross(p, q, a, b) {
        const side = (o, u, v) => (u.x - o.x) * (v.y - o.y) - (u.y - o.y) * (v.x - o.x);
        const d1 = side(a, b, p);
        const d2 = side(a, b, q);
        const d3 = side(p, q, a);
        const d4 = side(p, q, b);
        return (d1 > 0) !== (d2 > 0) && (d3 > 0) !== (d4 > 0);
      }

      // Does the segment p→q touch the rectangle at all — an endpoint inside,
      // or a crossing of any edge.
      function segmentHitsRect(p, q, r) {
        if (inRect(p.x, p.y, r) || inRect(q.x, q.y, r)) return true;
        const c = [
          { x: r.left, y: r.top },
          { x: r.right, y: r.top },
          { x: r.right, y: r.bottom },
          { x: r.left, y: r.bottom },
        ];
        for (let i = 0; i < 4; i++) if (segmentsCross(p, q, c[i], c[(i + 1) % 4])) return true;
        return false;
      }

      const rows = () => [...items.querySelectorAll('.item')];

      // Everything picked before the drag plus everything the drag has caught.
      const paintMarquee = () => paint(new Set([...marquee.base, ...marquee.caught]));

      items.addEventListener('pointerdown', (event) => {
        if (event.button) return;
        // A press on a control is not a press on empty space — the materials
        // header is a button that happens to live inside the listing.
        if (event.target.closest('.item, .more, .mats-head')) return;
        marquee = {
          mode: event.altKey ? 'lasso' : 'rect',
          x0: event.clientX,
          y0: event.clientY,
          points: [{ x: event.clientX, y: event.clientY }],
          // Cmd or Shift keeps what was already picked and adds to it.
          base: new Set(event.metaKey || event.ctrlKey || event.shiftKey ? picked : []),
          caught: new Set(),
          moved: false,
        };
      });

      addEventListener('pointermove', (event) => {
        if (!marquee) return;
        if (!marquee.moved) {
          if (Math.hypot(event.clientX - marquee.x0, event.clientY - marquee.y0) < 4) return;
          marquee.moved = true;
          document.body.classList.add('marble-marqueeing');
        }

        if (marquee.mode === 'rect') {
          const left = Math.min(event.clientX, marquee.x0);
          const top = Math.min(event.clientY, marquee.y0);
          const width = Math.abs(event.clientX - marquee.x0);
          const height = Math.abs(event.clientY - marquee.y0);
          band.style.left = left + 'px';
          band.style.top = top + 'px';
          band.style.width = width + 'px';
          band.style.height = height + 'px';
          band.setAttribute('data-open', '1');
          // The rectangle grows and shrinks, so what it covers is recomputed
          // whole rather than accumulated.
          marquee.caught = new Set();
          const box = { left, top, right: left + width, bottom: top + height };
          for (const el of rows()) {
            const r = el.getBoundingClientRect();
            if (r.left < box.right && r.right > box.left && r.top < box.bottom && r.bottom > box.top) {
              marquee.caught.add(el.dataset.path);
            }
          }
        } else {
          const prev = marquee.points[marquee.points.length - 1];
          const next = { x: event.clientX, y: event.clientY };
          marquee.points.push(next);
          lassoLine.setAttribute('points', marquee.points.map((p) => p.x + ',' + p.y).join(' '));
          lasso.setAttribute('data-open', '1');
          // The line only ever adds: once it has crossed a row, that row is
          // caught for the rest of the gesture.
          for (const el of rows()) {
            if (marquee.caught.has(el.dataset.path)) continue;
            if (segmentHitsRect(prev, next, el.getBoundingClientRect())) marquee.caught.add(el.dataset.path);
          }
        }

        paintMarquee();
      });

      addEventListener('pointerup', () => {
        if (!marquee) return;
        const done = marquee;
        marquee = null;
        band.removeAttribute('data-open');
        band.removeAttribute('style');
        lasso.removeAttribute('data-open');
        lassoLine.setAttribute('points', '');
        document.body.classList.remove('marble-marqueeing');
        if (!done.moved) return;
        // The trailing click on the container would otherwise clear this.
        dragged = Date.now();
        pick(new Set([...done.base, ...done.caught]));
      });

      // -------------------------------------------------------------- the drops
      //
      // A document arriving from outside the drive. This is the one gesture on
      // the page that has to use the HTML5 drag-and-drop API rather than
      // pointer events: a file coming from the desktop is not a pointer the
      // browser will tell us about, it is a `dataTransfer`, and there is no
      // second way to be handed one.
      //
      // Where it lands is the folder under the cursor if there is one, and the
      // folder you are looking at if there is not — the same two answers the
      // internal drag gives, marked the same way, because to a hand they are
      // the same gesture with a different thing in it.

      // A .mrbl is an HTML file, so a document somebody's browser saved under
      // the other extension is not a different document.
      const DOCUMENT = /\.(mrbl|html?)$/i;

      let landing = null;

      const carriesFiles = (event) => [...(event.dataTransfer?.types ?? [])].includes('Files');

      const dropTarget = (node) =>
        view === 'trash'
          ? null
          : (node?.closest?.('.item[data-kind="folder"], .crumb, .nav-item[data-nav="drive"]') ?? null);

      // A crumb and the nav entry both carry the path they stand for, and the
      // root carries none, which is the empty string — My Drive.
      const pathOf = (target) => (target ? (target.dataset.path ?? '') : here);

      function showDrop(target) {
        if (landing !== target) {
          landing?.classList.remove('marble-drop');
          landing = target;
          landing?.classList.add('marble-drop');
        }
        dropzone.querySelector('b').textContent = 'Drop to add to ' + (pathOf(target) || 'My Drive');
        dropzone.setAttribute('data-open', '1');
      }

      function clearDrop() {
        landing?.classList.remove('marble-drop');
        landing = null;
        dropzone.removeAttribute('data-open');
      }

      // Counted rather than latched: a drag across the page enters and leaves
      // every element it passes over, and a single boolean is off again the
      // moment the pointer crosses from the sidebar into a row.
      let incoming = 0;

      // And a watchdog under the count, because a drag cancelled with Escape
      // ends without a `dragleave` and the count never comes back down — which
      // would leave the whole window under an overlay with no way to dismiss
      // it. `dragover` repeats for as long as something is over the page and
      // stops dead when it is not, so its absence is the one reliable ending.
      let waiting = null;
      const stillHere = () => {
        clearTimeout(waiting);
        waiting = setTimeout(() => {
          incoming = 0;
          clearDrop();
        }, 700);
      };

      // On the capture phase, so that a contenteditable label cannot be the
      // one that gets the file. The default action of a drop on this page is
      // always the same and always wrong: navigate away to the file itself.
      const capture = { capture: true };

      addEventListener('dragenter', (event) => {
        if (!carriesFiles(event)) return;
        event.preventDefault();
        incoming += 1;
      }, capture);

      addEventListener('dragleave', (event) => {
        if (!carriesFiles(event)) return;
        incoming = Math.max(0, incoming - 1);
        if (!incoming) clearDrop();
      }, capture);

      addEventListener('dragover', (event) => {
        if (!carriesFiles(event)) return;
        event.preventDefault();
        event.dataTransfer.dropEffect = 'copy';
        incoming = incoming || 1;
        stillHere();
        showDrop(dropTarget(event.target));
      }, capture);

      addEventListener('drop', (event) => {
        if (!carriesFiles(event)) return;
        event.preventDefault();
        const into = pathOf(dropTarget(event.target));
        // Both of these have to be taken now. A DataTransfer is emptied the
        // moment the handler returns, and everything `receive` does after the
        // first await would be reading from something the browser has cleared.
        const entries = [...(event.dataTransfer.items ?? [])]
          .map((item) => item.webkitGetAsEntry?.())
          .filter(Boolean);
        const files = [...(event.dataTransfer.files ?? [])];
        incoming = 0;
        clearTimeout(waiting);
        clearDrop();
        receive(entries, files, into);
      }, capture);

      /** A folder dropped from the desktop is a directory entry, not a file, and
       *  `dataTransfer.files` has nothing in it for one. Walking the entries is
       *  the only way to reach what is inside, and the shape it gives back is
       *  the shape the upload wants: a file, and the folder it belongs in. */
      async function collect(entry, folder, out) {
        if (entry.isFile) {
          out.push({ file: await new Promise((ok, no) => entry.file(ok, no)), folder });
          return;
        }
        if (!entry.isDirectory) return;
        const inside = [folder, entry.name].filter(Boolean).join('/');
        const reader = entry.createReader();
        // `readEntries` answers in batches and says it has finished by
        // answering with none. A folder of 200 documents arrives 100 at a time.
        for (;;) {
          const batch = await new Promise((ok, no) => reader.readEntries(ok, no));
          if (!batch.length) break;
          for (const child of batch) await collect(child, inside, out);
        }
      }

      // The card that stays up while files go up. Made here rather than kept
      // in the markup: it is the page's own state, never the file's, and a tab
      // that is not uploading has no reason to carry it.
      const tray = (() => {
        const el = document.createElement('div');
        el.className = 'uploads';
        el.setAttribute('data-marble-transient', '');
        el.setAttribute('role', 'status');
        el.setAttribute('aria-live', 'polite');
        el.innerHTML =
          '<div class="up-head"><span class="up-title"></span><span class="up-sum"></span></div>' +
          '<div class="up-bar"><i></i></div><ul class="up-files"></ul>' +
          '<div class="up-foot"><button type="button">Cancel</button></div>';
        toast.before(el);
        return el;
      })();
      let uploading = null;
      tray.querySelector('.up-foot button').addEventListener('click', () => {
        if (uploading) return uploading.abort();
        // Files whose connection dropped are still held by the page: Retry
        // sends them again, and the host's session means they carry on.
        const again = tray.retry;
        tray.retry = null;
        if (again?.length) return receive([], [], again.into, again);
        tray.removeAttribute('data-open');
      });
      // Leaving mid-upload throws the rest away, so the browser asks first.
      addEventListener('beforeunload', (event) => {
        if (!uploading) return;
        event.preventDefault();
        event.returnValue = '';
      });

      async function receive(entries, files, into, prepared = null) {
        let dropped = prepared ? [...prepared] : files.map((file) => ({ file, folder: '' }));
        if (entries.length) {
          dropped = [];
          try {
            for (const entry of entries) await collect(entry, '', dropped);
          } catch (err) {
            return fail(err);
          }
        }

        // What a desktop leaves in every folder it has shown you — .DS_Store,
        // ._ resource forks — is not something anybody meant to drop, and a
        // dotted name is how the drive hides its own bookkeeping anyway.
        const meant = dropped.filter(({ file }) => !file.name.startsWith('.'));
        if (!meant.length) return say('Nothing to add');
        if (uploading) return say('Still adding the last drop — wait for it to finish');
        // A drive holds documents and the files beside them: the song the
        // mashup plays, the picture the zine is laid out around. A host that
        // cannot take a file yet still takes the documents.
        const takesFiles = typeof drive.uploadFile === 'function';
        const wanted = takesFiles ? meant : meant.filter(({ file }) => DOCUMENT.test(file.name));
        const unheld = meant.length - wanted.length;
        if (!wanted.length) return say('This drive only takes documents — nothing came in');
        const allDocs = wanted.every(({ file }) => DOCUMENT.test(file.name));
        const noun = (n) => (allDocs ? 'document' : 'file') + (n === 1 ? '' : 's');
        const where = into || 'My Drive';

        // The card, one row per file. Progress is counted in bytes across the
        // whole drop, because one 40 MB song and three 4 KB documents are not
        // four quarters of the work.
        const total = wanted.reduce((sum, { file }) => sum + file.size, 0) || 1;
        const sent = wanted.map(() => 0);
        const list = tray.querySelector('.up-files');
        list.replaceChildren(
          ...wanted.map(({ file }) => {
            const li = document.createElement('li');
            li.dataset.state = 'waiting';
            li.innerHTML = '<span class="n"></span><span class="s">waiting</span>';
            li.querySelector('.n').textContent = file.name;
            return li;
          }),
        );
        const rows = [...list.children];
        const bar = tray.querySelector('.up-bar i');
        const sum = tray.querySelector('.up-sum');
        const title = tray.querySelector('.up-title');
        const button = tray.querySelector('.up-foot button');
        const started = performance.now();
        const paint = () => {
          const done = sent.reduce((a, b) => a + b, 0);
          bar.style.width = ((done / total) * 100).toFixed(1) + '%';
          const secs = (performance.now() - started) / 1000;
          const rate = secs > 1 ? done / secs : 0;
          sum.textContent =
            bytes(done) + ' of ' + bytes(total) + (rate && done < total ? ' · ' + bytes(rate) + '/s' : '');
        };
        const mark = (i, state, text) => {
          rows[i].dataset.state = state;
          rows[i].querySelector('.s').textContent = text;
        };
        title.textContent = 'Adding ' + (wanted.length === 1 ? wanted[0].file.name : wanted.length + ' ' + noun(wanted.length)) + ' to ' + where;
        button.textContent = 'Cancel';
        tray.removeAttribute('data-state');
        bar.style.width = '0%';
        paint();
        tray.setAttribute('data-open', '1');
        clearTimeout(tray.timer);

        // One at a time, because the host serialises writes per document
        // anyway, because one file at full speed beats four sharing a slow
        // link, and because a failure should name the file it was.
        const controller = new AbortController();
        uploading = controller;
        const added = [];
        const refused = [];
        const retry = [];
        let cancelled = false;
        for (const [i, { file, folder }] of wanted.entries()) {
          if (controller.signal.aborted) {
            cancelled = true;
            mark(i, 'failed', 'cancelled');
            continue;
          }
          const to = [into, folder].filter(Boolean).join('/');
          mark(i, 'going', '0%');
          rows[i].scrollIntoView({ block: 'nearest' });
          try {
            added.push(
              DOCUMENT.test(file.name)
                ? await drive.upload({ folder: to, name: file.name, source: await file.text() })
                : await drive.uploadFile({
                    folder: to,
                    name: file.name,
                    file,
                    signal: controller.signal,
                    onProgress: (loaded) => {
                      sent[i] = Math.min(loaded, file.size);
                      mark(i, 'going', Math.floor((sent[i] / (file.size || 1)) * 100) + '%');
                      paint();
                    },
                    // A chunk the network dropped is being retried.
                    onState: (state) => {
                      if (state === 'reconnecting') mark(i, 'going', 'reconnecting…');
                    },
                  }),
            );
            sent[i] = file.size;
            mark(i, 'done', 'added');
          } catch (err) {
            if (err?.name === 'AbortError') {
              cancelled = true;
              mark(i, 'failed', 'cancelled');
            } else {
              refused.push(file.name + ' — ' + (err?.message ?? err));
              mark(i, 'failed', err?.retryable ? 'paused' : err?.message ?? 'refused');
              if (err?.retryable) retry.push({ file, folder });
            }
          }
          paint();
        }
        uploading = null;

        if (added.length) refresh();
        const tally = [];
        if (added.length === 1) tally.push('Added ' + added[0].path);
        else if (added.length) tally.push('Added ' + added.length + ' ' + noun(added.length) + ' to ' + where);
        if (cancelled) tally.push('the rest cancelled');
        if (unheld) tally.push(unheld + (unheld === 1 ? ' other file' : ' other files') + ' left alone');
        if (refused.length) tally.push(refused.length === 1 ? refused[0] : refused.length + ' refused — ' + refused[0]);

        // The card becomes the receipt. A clean drop closes itself; one that
        // lost something stays until it is dismissed, because a failure that
        // disappears on its own is one you find out about later.
        title.textContent = tally[0] ?? 'Nothing added';
        sum.textContent = tally.slice(1).join(' · ') || bytes(total);
        tray.setAttribute('data-state', refused.length || cancelled ? 'failed' : 'done');
        tray.retry = retry.length ? Object.assign(retry, { into }) : null;
        button.textContent = retry.length ? 'Retry' : 'Close';
        say(tally.join(' · '));
        if (!refused.length && !cancelled) tray.timer = setTimeout(() => tray.removeAttribute('data-open'), 2600);
      }

      // ---------------------------------------------------------- the toggles

      const toggle = document.querySelector('.toggle');
      const thumb = toggle.querySelector('.thumb');

      // The pill under the current segment. Measured off the button rather
      // than computed from an index, so it is correct whether four segments
      // are the same width or not, and doesn't have to change if a fifth ever
      // joins them.
      function positionThumb() {
        const current = toggle.querySelector('[data-set-view="' + mode() + '"]');
        if (!current) return;
        thumb.style.width = current.offsetWidth + 'px';
        thumb.style.transform = 'translateX(' + current.offsetLeft + 'px)';
      }

      for (const button of document.querySelectorAll('[data-set-view]')) {
        button.addEventListener('click', () => {
          const next = button.dataset.setView;
          const id = marble.id(document.body);
          if (!id) return;
          // The page moves and the file is told, from the same value — composed
          // here rather than read back off the element. Grid and list share a
          // listing, so switching between them is free; timeline and map are a
          // different shape of the same folder and have to be redrawn.
          const was = document.body.getAttribute('data-view');
          document.body.setAttribute('data-view', next);
          marble.record({
            redo: [{ type: 'setAttr', id, name: 'data-view', value: next }],
            undo: [{ type: 'setAttr', id, name: 'data-view', value: was }],
          });
          marble.op({ type: 'setAttr', id, name: 'data-view', value: next }, { immediate: true });
          positionThumb();
          if (was !== next) draw();
        });
      }

      addEventListener('resize', () => {
        positionThumb();
        if (mode() === 'map') draw();
      });

      // ---------------------------------------------------------- the listening

      // A change to this page's own file is not news about the folder. The
      // page files ops of its own — the view, a tint, a pin — and the drive
      // stream echoes each one back, because it keeps a different client id
      // from the carrier's and so cannot tell the echo from someone else. A
      // refresh on it redraws the listing ~200ms after the gesture already
      // drew it, and the entrance plays twice. What the file says about the
      // page arrives through the reconcile below, not through here.
      const SELF = document.querySelector('script[data-marble-app]')?.dataset.marbleApp;
      drive.on('*', (event) => {
        if (view === 'templates') return;
        if (event.event === 'changed' && SELF && event.path === SELF) return;
        refresh();
      });
      status.setAttribute('data-live', '1');
      document.querySelector('#status-text').textContent = 'live';

      // Re-derive after a reconcile: an edit to this file in another window
      // rewrites the sidebar, and the current-nav class is not in the file.
      marble.register(() => {
        drawNav();
        drawPins();
      });

      drawNav();
      positionThumb();
      refresh();
      // An upload this browser started and did not finish is waiting on the
      // host; the file itself went with the last page, so it has to be
      // dropped again to carry on.
      const pending = drive.pendingUploads?.() ?? [];
      if (pending.length) {
        say('Drop “' + pending[0].name + '” again to finish adding it' + (pending.length > 1 ? ' (and ' + (pending.length - 1) + ' more)' : ''));
      }
      // The drive's own realms arrive after the first draw rather than
      // holding it back; a drive that names some is drawn once more in them.
      drive.settings?.().then(({ realms }) => {
        if (!Object.keys(realms).length) return;
        REALMS = realms;
        refresh();
      });
    };

    if (window.marble?.drive) begin(window.marble);
    else addEventListener('marble:drive', () => begin(window.marble), { once: true });
  })();
</script>

__SCRIPT__
</body>
</html>
