# Copy to .env. Every one of these has a default; the first has a bad one.

# Not the open internet. Unset means an open host, which is right for a laptop
# and wrong for anything with a domain in front of it. Any long random string:
#   openssl rand -base64 32
# On a multi-tenant host (MARBLE_DRIVE_DATA set) this is the session signing
# key rather than a password, and it is required.
MARBLE_DRIVE_SECRET=

# Where the documents and the single .marble/ tree live. Single-tenant only —
# ignored when MARBLE_DRIVE_DATA is set.
MARBLE_DRIVE_ROOT=./drive

# Multi-tenant. Unset is one drive at MARBLE_DRIVE_ROOT with the gate in front.
# Set it and the host grows accounts: identity under <data>/accounts/ and one
# drive per person under <data>/users/<id>/. See docs/ACCOUNTS.md.
MARBLE_DRIVE_DATA=

# Per account, once there is more than one.
MARBLE_DRIVE_QUOTA_DOCS=500
MARBLE_DRIVE_QUOTA_BYTES=536870912

PORT=4400
HOST=0.0.0.0

# Send the cookie only over HTTPS. On by default when NODE_ENV=production.
MARBLE_DRIVE_SECURE_COOKIE=

# Backups off the box. A directory is a bind mount, a share, or a path
# something else syncs onward; a command is the escape hatch for object storage.
#   MARBLE_DRIVE_BACKUP_CMD=aws s3 sync "$MARBLE_DRIVE_ROOT" s3://my-bucket/drive
MARBLE_DRIVE_BACKUP_DIR=
MARBLE_DRIVE_BACKUP_CMD=
MARBLE_DRIVE_BACKUP_MINUTES=60
MARBLE_DRIVE_BACKUP_KEEP=24

# The document `/` lands on. An ordinary document with no standing.
MARBLE_DRIVE_HOME=drive

# The intent layer. Everything else works without it.
# ANTHROPIC_API_KEY=
