# Every PC drive's backup, one drive at a time (backup-guests; docs/HOSTING.md,
# "Backups of PC drives"). Started each hour by marble-guests-backup.timer;
# marble-host may start it too. Installed by install.d/20-backup.sh.
#
# It reads no drive and holds no key: it lists the folders under
# /var/lib/private/marble-guests and starts marble-guest-backup@<name>.service
# for each, waiting for one to end before the next.
[Unit]
Description=Encrypted backups of every PC drive, one at a time
Documentation=https://github.com/marble-app/marble-drive/blob/main/docs/HOSTING.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/marble-guests/backup-guests
UMask=0077
ProtectSystem=strict
ReadWritePaths=-/var/lib/marble-backup
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# systemctl reaches systemd through a socket on disk, which this keeps.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
