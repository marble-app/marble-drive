# Every drive the PC hosts for someone else, together (docs/HOSTING.md,
# "marble-host and the sandbox"). Installed by linux/pc-host/install.sh.
# Each drive has its own limits (marble-guest@.service); these are for all of
# them at once, so a busy evening for the guests cannot take the memory the
# owner's own drive needs. Its name puts it inside marble.slice, which holds
# the guests' CPU weight against user.slice, where the owner's drive runs.
[Unit]
Description=Marble: the drives hosted on this PC, together
Before=slices.target

[Slice]
MemoryHigh=5G
MemoryMax=6G
TasksMax=4096
