<!doctype html>
<html lang="en" data-marble="1">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="marble:capabilities" content="storage; net=none">
<title>__TITLE__</title>
<style>
  /* Somewhere between a word processor and a notebook.

     The page is still here — real margins, a ruler that sets them, paragraph
     styles, an outline — because those are what a document is for. What is gone
     is the ceremony around it: no grey desk, no drop shadow, no sheet floating
     in space. The workspace and the page are the same white, and the page edge
     is one hairline, so you can see where the margin is without being told you
     are filing something.

     The palette is Marble's, with the one change every starter here makes: the
     design system's --paper is off-white and belongs to the Drive, the
     interface. A document is white to the edge. One dusty blue does all the
     accenting, the same blue in every starter, because five colours would be
     five claims and there is only one. */
  :root {
    --ink: #111111;
    --muted: #5a5a5a;
    --faint: #8a8a8a;
    --line: #ddd9cf;
    --paper: #ffffff;
    --card: #ffffff;
    --accent: #9bb6cf;
    --accent-soft: #f1f5f8;
    --accent-ink: #738698;
    --radius: 3px;

    /* Every face the two pickers can choose, written once. A document names no
       webfont: it declares net=none, so these are the faces already on the
       machine, each with somewhere to fall back to. */
    --f-avenir: "Avenir Next", Avenir, "Nunito Sans", system-ui, sans-serif;
    --f-system: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    --f-grotesk: "Helvetica Neue", Helvetica, "Arial Nova", Arial, sans-serif;
    --f-optima: Optima, "Gill Sans", "Gill Sans MT", Candara, sans-serif;
    --f-garamond: "Cormorant Garamond", "EB Garamond", Georgia, serif;
    --f-charter: Charter, "Iowan Old Style", "Palatino Linotype", Georgia, serif;
    --f-mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --ink: #e8e6e1;
      --muted: #a3a7ab;
      --faint: #71767a;
      --line: #2f3438;
      --paper: #1c1f22;
      --card: #1c1f22;
      --accent: #7fa8c9;
      --accent-soft: #1d2932;
      --accent-ink: #9dc0dc;
    }
  }

  /* Which face the interface wears and which the notes wear are two facts, each
     held in one attribute on <body> and read here and nowhere else. Both live
     on <body> rather than one of them on the flow, so that the widget's ticks
     below can be read straight off an ancestor — CSS has no way to reach
     sideways across the page for a value. Spelled out one line per face,
     because it has no way to look a name up in a list either. */
  body[data-ui-font="avenir"]   { --ui: var(--f-avenir); }
  body[data-ui-font="system"]   { --ui: var(--f-system); }
  body[data-ui-font="grotesk"]  { --ui: var(--f-grotesk); }
  body[data-ui-font="optima"]   { --ui: var(--f-optima); }
  body[data-ui-font="garamond"] { --ui: var(--f-garamond); }
  body[data-ui-font="charter"]  { --ui: var(--f-charter); }
  body[data-ui-font="mono"]     { --ui: var(--f-mono); }

  body[data-doc-font="avenir"]   { --doc: var(--f-avenir); }
  body[data-doc-font="system"]   { --doc: var(--f-system); }
  body[data-doc-font="grotesk"]  { --doc: var(--f-grotesk); }
  body[data-doc-font="optima"]   { --doc: var(--f-optima); }
  body[data-doc-font="garamond"] { --doc: var(--f-garamond); }
  body[data-doc-font="charter"]  { --doc: var(--f-charter); }
  body[data-doc-font="mono"]     { --doc: var(--f-mono); }

  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    margin: 0; display: flex; flex-direction: column; overflow: hidden;
    background: var(--paper); color: var(--ink);
    font: 13.5px/1.5 var(--ui, var(--f-avenir));
    -webkit-font-smoothing: antialiased;
  }
  ::selection { background: var(--accent-soft); }
  .sprite { display: none; }
  .ico { width: 18px; height: 18px; fill: currentColor; display: block; }
  .caret { width: 13px; height: 13px; fill: currentColor; opacity: .55; flex: none; }

  /* -------------------------------------------------------------- the header
     Two rows, one hairline, no filled bar. The chrome is in the file — every
     button below has a name of its own — but it should not look like it is
     charging you for the privilege. */

  .bar { flex: none; padding: .8rem 1.1rem .1rem; display: flex; gap: .7rem; }
  .mark { color: var(--accent-ink); flex: none; padding-top: .15rem; }
  .mark .ico { width: 22px; height: 22px; }
  .head { min-width: 0; flex: 1; }
  .docname {
    display: inline-block; padding: .05rem .3rem; margin-left: -.3rem;
    border-radius: var(--radius); font-size: 1.05rem; line-height: 1.3;
    outline: none; max-width: 30rem; overflow: hidden; white-space: nowrap;
    border: 1px solid transparent;
  }
  .docname:hover { background: var(--accent-soft); }
  .docname:focus { background: var(--card); box-shadow: 0 0 0 1px var(--accent), 0 0 0 4px var(--accent-soft); }
  .menus { display: flex; gap: .05rem; margin: .1rem 0 0 -.35rem; }
  .menu {
    appearance: none; border: 0; background: none; color: var(--faint);
    padding: .15rem .35rem; border-radius: var(--radius);
    font: inherit; font-size: .78rem; cursor: pointer;
  }
  .menu:hover { color: var(--ink); background: var(--accent-soft); }
  .menu[data-open] { color: var(--accent-ink); background: var(--accent-soft); }

  .tools {
    flex: none; display: flex; align-items: center; gap: 1px; flex-wrap: wrap;
    padding: .3rem 1.1rem .55rem; border-bottom: 1px solid var(--line);
  }
  .tool {
    appearance: none; border: 0; background: none; color: var(--muted);
    display: flex; align-items: center; justify-content: center; gap: .1rem;
    height: 26px; min-width: 26px; padding: 0 .28rem; border-radius: var(--radius);
    font: inherit; cursor: pointer;
  }
  .tool:hover { background: var(--accent-soft); color: var(--ink); }
  .tool[disabled] { opacity: .3; cursor: default; background: none; }
  .tool.marble-on { background: var(--accent-soft); color: var(--accent-ink); }
  .tool.wide { min-width: 5.6rem; justify-content: space-between; padding: 0 .2rem 0 .45rem; }
  .tool .now { font-size: .8rem; white-space: nowrap; overflow: hidden; color: var(--ink); }
  .step { font: 400 15px/1 inherit; }
  .letter { font: 600 13px/1 var(--f-charter); width: 16px; text-align: center; color: var(--ink); }
  .letter.i { font-style: italic; font-weight: 500; }
  .letter.u { text-decoration: underline; font-weight: 500; }
  .letter.s { text-decoration: line-through; font-weight: 500; }
  .paint { flex-direction: column; gap: 0; padding-top: 2px; }
  .paint .letter { font-size: 12px; line-height: 12px; }
  .swatch { display: block; width: 15px; height: 3px; border-radius: 1px; background: currentColor; }
  .sizer { display: flex; align-items: center; gap: 1px; }
  .pt {
    width: 2.2rem; height: 23px; display: flex; align-items: center; justify-content: center;
    border: 1px solid var(--line); border-radius: var(--radius); font-size: .8rem; color: var(--ink);
  }
  .sep { width: 1px; height: 16px; background: var(--line); margin: 0 .35rem; flex: none; }
  .spring { flex: 1; }

  /* --------------------------------------------- the workspace and the page */

  .work { flex: 1; min-height: 0; display: flex; }

  .outline {
    flex: none; width: 13.5rem; padding: 1.3rem 1rem 2rem; overflow: auto;
    border-right: 1px solid var(--line);
  }
  body[data-outline="off"] .outline { display: none; }
  .outline h2 {
    margin: 0 0 .7rem; font: 600 .64rem/1 var(--f-mono);
    letter-spacing: .1em; text-transform: uppercase; color: var(--faint);
  }
  .outline ol { list-style: none; margin: 0; padding: 0; }
  .outline li {
    padding: .22rem .4rem; border-radius: var(--radius); cursor: pointer; color: var(--muted);
    font-size: .82rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .outline li:hover { background: var(--accent-soft); color: var(--accent-ink); }
  .outline li.d2 { padding-left: 1.1rem; }
  .outline li.d3 { padding-left: 1.9rem; }
  .outline ol:empty::before {
    content: "Headings you write appear here."; display: block;
    color: var(--faint); font-size: .78rem; line-height: 1.5;
  }

  .scroll { flex: 1; overflow: auto; padding-bottom: 6rem; }
  .pagebox { width: 8.5in; max-width: 100%; margin: 0 auto; }

  /* The ruler keeps no fact of its own: both markers and both margin bands are
     drawn from the --ml and --mr the page is padded with, so dragging one and
     hand-editing the inch in the file are the same change seen twice. */
  .ruler { position: sticky; top: 0; z-index: 3; height: 20px; background: var(--paper); }
  body[data-ruler="off"] .ruler { display: none; }
  .ruler .field {
    position: absolute; top: 8px; bottom: 8px; left: var(--ml, 1in); right: var(--mr, 1in);
    background-image: repeating-linear-gradient(to right, var(--line) 0 1px, transparent 1px .125in);
  }
  .ruler .gut { position: absolute; top: 8px; bottom: 8px; background: var(--line); opacity: .55; }
  .ruler .gut.l { left: 0; width: var(--ml, 1in); }
  .ruler .gut.r { right: 0; width: var(--mr, 1in); }
  .ruler .pin {
    position: absolute; top: 3px; width: 11px; height: 9px; cursor: ew-resize;
    background: var(--accent); clip-path: polygon(0 0, 100% 0, 50% 100%);
  }
  .ruler .pin:hover, .ruler .pin.marble-dragging { background: var(--accent-ink); }
  .ruler .pin.l { left: calc(var(--ml, 1in) - 5.5px); }
  .ruler .pin.r { right: calc(var(--mr, 1in) - 5.5px); }

  .page {
    min-height: 10in; margin-bottom: 3rem;
    padding: var(--mt, 1in) var(--mr, 1in) var(--mb, 1in) var(--ml, 1in);
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
  }

  /* --------------------------------------------------------- the text itself

     One flow of sibling blocks, each a paragraph with a name of its own. A
     block's style is its tag, so an <h2> in the file is a heading to a text
     editor, an agent and a screen reader alike. What belongs to the paragraph —
     its style, its alignment, whether it is a list item, how far it is indented
     — is one attribute on the block. What belongs to the characters — weight,
     slant, colour, face, size — is inline markup around them, the way it is in
     the file you would write by hand. Two kinds of property, two places, and
     the toolbar knows which is which by whether you have selected anything. */

  .flow > * {
    margin: 0; outline: none; font-family: var(--doc, var(--f-avenir));
    font-size: calc(var(--pt, 10.5) * 1pt); line-height: 1.55;
    white-space: pre-wrap; overflow-wrap: break-word;
  }
  .flow > h1 { --pt: 23; line-height: 1.2; font-weight: 500; letter-spacing: -.015em; padding-bottom: 4pt; }
  .flow > .subtitle { --pt: 13; color: var(--muted); padding-bottom: 14pt; }
  .flow > h2 { --pt: 17; line-height: 1.25; font-weight: 500; letter-spacing: -.01em; padding: 18pt 0 5pt; }
  .flow > h3 { --pt: 14; line-height: 1.3; font-weight: 600; padding: 15pt 0 4pt; }
  .flow > h4 {
    --pt: 10.5; font-weight: 600; color: var(--muted);
    letter-spacing: .07em; text-transform: uppercase; padding: 14pt 0 3pt;
  }
  /* A notebook breathes between paragraphs; a filing does not. This is the one
     place the blend leans notebook, because running paragraphs together is the
     single thing that makes a page of prose look like a form. */
  .flow > p + p { padding-top: 7pt; }

  .flow > [data-align="center"] { text-align: center; }
  .flow > [data-align="right"] { text-align: right; }
  .flow > [data-align="justify"] { text-align: justify; }
  .flow > [data-indent="1"] { margin-left: .5in; }
  .flow > [data-indent="2"] { margin-left: 1in; }
  .flow > [data-indent="3"] { margin-left: 1.5in; }
  .flow > [data-indent="4"] { margin-left: 2in; }
  .flow > [data-indent="5"] { margin-left: 2.5in; }

  /* A list is a run of blocks that each say they are one. The bullet and the
     number are drawn, never stored: any block that is not a numbered item
     resets the counter, so every run starts at one again by itself and moving a
     paragraph renumbers the document without touching a byte of it. */
  .flow > :not([data-list="number"]) { counter-reset: item; }
  .flow > [data-list] { padding-left: .5in; position: relative; }
  .flow > [data-list] + [data-list] { padding-top: 2pt; }
  .flow > [data-list]::before {
    position: absolute; left: 0; width: .35in; text-align: right;
    color: var(--faint); font-family: var(--doc, var(--f-avenir));
  }
  .flow > [data-list="bullet"]::before { content: "\2022"; }
  .flow > [data-list="number"] { counter-increment: item; }
  .flow > [data-list="number"]::before { content: counter(item) "."; }

  .flow > hr { border: 0; border-top: 1px solid var(--line); margin: 14pt 0; padding: 0; }

  /* The inline vocabulary, and the whole of it. Anything the editor cannot
     write here, it strips on the way into the file. */
  .flow b, .flow strong { font-weight: 650; }
  .flow i, .flow em { font-style: italic; }
  .flow u { text-decoration: underline; text-underline-offset: .13em; }
  .flow s { text-decoration: line-through; }

  /* ---------------------------------------------------- what belongs to the page */

  .popup {
    position: fixed; z-index: 40; display: none; min-width: 11rem; padding: .35rem 0;
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
    box-shadow: 0 6px 22px rgba(17, 17, 17, .13); max-height: 70vh; overflow: auto;
  }
  .popup[data-open] { display: block; }
  .popup button {
    appearance: none; position: relative; border: 0; background: none; color: var(--ink);
    width: 100%; display: flex; align-items: center; gap: 1.2rem; justify-content: space-between;
    padding: .34rem .9rem .34rem 1.7rem; font: inherit; font-size: .82rem; text-align: left; cursor: pointer;
  }
  .popup button:hover { background: var(--accent-soft); }
  .popup button[disabled] { opacity: .35; cursor: default; background: none; }
  .popup button[data-on]::before { content: "\2713"; position: absolute; left: .6rem; color: var(--accent-ink); }
  .popup .hint { color: var(--faint); font-size: .74rem; font-family: var(--f-mono); }
  .popup .swatches { display: grid; grid-template-columns: repeat(5, 1.4rem); gap: .3rem; padding: .45rem .85rem; }
  .popup .swatches i {
    display: block; width: 1.4rem; height: 1.4rem; border-radius: var(--radius);
    border: 1px solid var(--line); cursor: pointer;
  }
  .popup .swatches i[data-on] { box-shadow: 0 0 0 2px var(--accent); }

  /* ------------------------------------------------------------ the font widget
     A floating card rather than a dialog, because choosing a face is something
     you do while looking at the text, not before you start. It is in the file:
     the two lists are markup, its position is an inline style on it, and
     whether it is showing is one attribute on <body>. */

  .fonts {
    position: fixed; z-index: 50; display: none;
    left: var(--fx, auto); top: var(--fy, auto); right: var(--fr, 1.4rem); bottom: var(--fb, 1.4rem);
    width: 25rem; padding: 0 0 .6rem;
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
    box-shadow: 0 10px 34px rgba(17, 17, 17, .16);
  }
  body[data-fonts="on"] .fonts { display: block; }
  .fonts header {
    display: flex; align-items: center; gap: .5rem;
    padding: .5rem .7rem .5rem .85rem; border-bottom: 1px solid var(--line); cursor: grab;
  }
  .fonts header.marble-dragging { cursor: grabbing; }
  .fonts h2 { margin: 0; font: 600 .68rem/1 var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--faint); }
  .fonts .shut {
    appearance: none; margin-left: auto; border: 0; background: none; color: var(--faint);
    width: 20px; height: 20px; border-radius: var(--radius); font: 15px/1 inherit; cursor: pointer;
  }
  .fonts .shut:hover { background: var(--accent-soft); color: var(--ink); }
  .fonts .two { display: grid; grid-template-columns: 1fr 1fr; }
  .fonts .col { padding: .6rem .5rem 0; }
  .fonts .col + .col { border-left: 1px solid var(--line); }
  .fonts .lbl {
    display: block; padding: 0 .35rem .4rem; font: 600 .62rem/1 var(--f-mono);
    letter-spacing: .1em; text-transform: uppercase; color: var(--faint);
  }
  .fonts button {
    appearance: none; position: relative; display: block; width: 100%; border: 0; background: none;
    color: var(--ink); padding: .3rem .5rem .3rem 1.4rem; border-radius: var(--radius);
    font-size: .88rem; text-align: left; cursor: pointer;
  }
  .fonts button:hover { background: var(--accent-soft); }
  .fonts [data-set-ui="avenir"],   .fonts [data-set-doc="avenir"]   { font-family: var(--f-avenir); }
  .fonts [data-set-ui="system"],   .fonts [data-set-doc="system"]   { font-family: var(--f-system); }
  .fonts [data-set-ui="grotesk"],  .fonts [data-set-doc="grotesk"]  { font-family: var(--f-grotesk); }
  .fonts [data-set-ui="optima"],   .fonts [data-set-doc="optima"]   { font-family: var(--f-optima); }
  .fonts [data-set-ui="garamond"], .fonts [data-set-doc="garamond"] { font-family: var(--f-garamond); }
  .fonts [data-set-ui="charter"],  .fonts [data-set-doc="charter"]  { font-family: var(--f-charter); }
  .fonts [data-set-ui="mono"],     .fonts [data-set-doc="mono"]     { font-family: var(--f-mono); font-size: .8rem; }

  /* Which face is chosen is already written on <body>, so the tick is read
     straight off it rather than recomputed into the buttons — there is no
     second copy to go stale, and the card is right with no host at all. CSS
     cannot match a child against an ancestor, so it is spelled out once per
     face: fourteen selectors, and no state. */
  .fonts button::before { content: ""; position: absolute; left: .55rem; color: var(--accent-ink); }
  body[data-ui-font="avenir"]    .fonts [data-set-ui="avenir"]::before,
  body[data-ui-font="system"]    .fonts [data-set-ui="system"]::before,
  body[data-ui-font="grotesk"]   .fonts [data-set-ui="grotesk"]::before,
  body[data-ui-font="optima"]    .fonts [data-set-ui="optima"]::before,
  body[data-ui-font="garamond"]  .fonts [data-set-ui="garamond"]::before,
  body[data-ui-font="charter"]   .fonts [data-set-ui="charter"]::before,
  body[data-ui-font="mono"]      .fonts [data-set-ui="mono"]::before,
  body[data-doc-font="avenir"]   .fonts [data-set-doc="avenir"]::before,
  body[data-doc-font="system"]   .fonts [data-set-doc="system"]::before,
  body[data-doc-font="grotesk"]  .fonts [data-set-doc="grotesk"]::before,
  body[data-doc-font="optima"]   .fonts [data-set-doc="optima"]::before,
  body[data-doc-font="garamond"] .fonts [data-set-doc="garamond"]::before,
  body[data-doc-font="charter"]  .fonts [data-set-doc="charter"]::before,
  body[data-doc-font="mono"]     .fonts [data-set-doc="mono"]::before { content: "\2713"; }

  .count {
    position: fixed; left: 1rem; bottom: 1rem; z-index: 20;
    padding: .25rem .6rem; border-radius: 999px; font-size: .74rem; color: var(--muted);
    background: var(--card); border: 1px solid var(--line);
  }
  .count:empty { display: none; }
  body[data-outline="on"] .count { left: 14.5rem; }

  /* The save indicator the affordances draw belongs beside the name, quietly. */
  body .marble-status {
    top: 1rem; right: 1.2rem; bottom: auto; padding: 0; border: 0; border-radius: 0;
    background: none; color: var(--faint); font: 400 .74rem/1.4 var(--f-mono); letter-spacing: .02em;
  }
  body .marble-status[data-state="saved"] { opacity: 1; }
  body .marble-status[data-state="error"] { background: none; color: #b4544f; }

  @media (max-width: 58rem) {
    .outline { display: none; }
    body[data-outline="on"] .count { left: 1rem; }
    .page { min-height: 0; }
    .fonts { width: auto; left: 1rem; right: 1rem; }
  }
</style>
</head>
<body class="doc" data-marble-id="__ID__" data-outline="on" data-ruler="on" data-fonts="off" data-ui-font="avenir" data-doc-font="avenir">

<svg class="sprite" data-marble-id="__ID__" aria-hidden="true" focusable="false"><defs>
  <g id="i-mark"><path d="M4 3h9l5 5v13H4z" opacity=".9"/><path d="M13 3v5h5z" opacity=".45"/></g>
  <g id="i-undo"><path d="M9 8V5l-6 5 6 5v-3h5a4 4 0 0 1 0 8h-3v2h3a6 6 0 0 0 0-12z"/></g>
  <g id="i-redo"><path d="M15 8V5l6 5-6 5v-3h-5a4 4 0 0 0 0 8h3v2h-3a6 6 0 0 1 0-12z"/></g>
  <g id="i-left"><path d="M3 5h18v2H3zm0 4h12v2H3zm0 4h18v2H3zm0 4h12v2H3z"/></g>
  <g id="i-center"><path d="M3 5h18v2H3zm3 4h12v2H6zm-3 4h18v2H3zm3 4h12v2H6z"/></g>
  <g id="i-right"><path d="M3 5h18v2H3zm6 4h12v2H9zm-6 4h18v2H3zm6 4h12v2H9z"/></g>
  <g id="i-justify"><path d="M3 5h18v2H3zm0 4h18v2H3zm0 4h18v2H3zm0 4h18v2H3z"/></g>
  <g id="i-bullet"><path d="M8 5h13v2H8zm0 6h13v2H8zm0 6h13v2H8z"/><circle cx="4" cy="6" r="1.6"/><circle cx="4" cy="12" r="1.6"/><circle cx="4" cy="18" r="1.6"/></g>
  <g id="i-number"><path d="M8 5h13v2H8zm0 6h13v2H8zm0 6h13v2H8z"/><text x="1" y="8.4" font-family="Menlo, monospace" font-size="6.6">1</text><text x="1" y="14.4" font-family="Menlo, monospace" font-size="6.6">2</text><text x="1" y="20.4" font-family="Menlo, monospace" font-size="6.6">3</text></g>
  <g id="i-outdent"><path d="M3 5h18v2H3zm8 4h10v2H11zm0 4h10v2H11zm-8 4h18v2H3zM8 9.4 4 12l4 2.6z"/></g>
  <g id="i-indent"><path d="M3 5h18v2H3zm8 4h10v2H11zm0 4h10v2H11zm-8 4h18v2H3zM4 9.4 8 12l-4 2.6z"/></g>
  <g id="i-clear"><path d="M4 5h12v2.6h-4.4l-1.2 4.4H7.7L8.9 7.6H4zm4.2 14 1.5-5.2h2.7L10.9 19zm7-5.6 1.3-1.3 1.7 1.7 1.7-1.7 1.3 1.3-1.7 1.7 1.7 1.7-1.3 1.3-1.7-1.7-1.7 1.7-1.3-1.3 1.7-1.7z"/></g>
  <g id="i-caret"><path d="M7 10h10l-5 5z"/></g>
</defs></svg>

<header class="bar" data-marble-id="__ID__">
  <span class="mark" data-marble-id="__ID__" aria-hidden="true">
    <svg class="ico" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-mark"/></svg>
  </span>
  <div class="head" data-marble-id="__ID__">
    <span class="docname" data-marble-id="__ID__" data-marble-editable>__TITLE__</span>
    <nav class="menus" data-marble-id="__ID__">
      <button class="menu" data-marble-id="__ID__" data-menu="file">File</button>
      <button class="menu" data-marble-id="__ID__" data-menu="edit">Edit</button>
      <button class="menu" data-marble-id="__ID__" data-menu="view">View</button>
      <button class="menu" data-marble-id="__ID__" data-menu="insert">Insert</button>
      <button class="menu" data-marble-id="__ID__" data-menu="format">Format</button>
      <button class="menu" data-marble-id="__ID__" data-menu="tools">Tools</button>
    </nav>
  </div>
</header>

<div class="tools" data-marble-id="__ID__">
  <button class="tool" data-marble-id="__ID__" data-cmd="undo" title="Undo (Ctrl+Z)" aria-label="Undo"><svg class="ico" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-undo"/></svg></button>
  <button class="tool" data-marble-id="__ID__" data-cmd="redo" title="Redo (Ctrl+Shift+Z)" aria-label="Redo"><svg class="ico" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-redo"/></svg></button>
  <i class="sep" data-marble-id="__ID__"></i>
  <button class="tool wide" data-marble-id="__ID__" data-pick="style" title="Paragraph style">
    <span class="now" id="now-style" data-marble-transient>Body</span>
    <svg class="caret" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-caret"/></svg>
  </button>
  <button class="tool wide" data-marble-id="__ID__" data-pick="face" title="Font of the selected text">
    <span class="now" id="now-face" data-marble-transient>Avenir Next</span>
    <svg class="caret" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-caret"/></svg>
  </button>
  <span class="sizer" data-marble-id="__ID__">
    <button class="tool step" data-marble-id="__ID__" data-cmd="smaller" title="Smaller" aria-label="Smaller">&#8722;</button>
    <span class="pt" id="now-pt" data-marble-transient>10.5</span>
    <button class="tool step" data-marble-id="__ID__" data-cmd="bigger" title="Bigger" aria-label="Bigger">+</button>
  </span>
  <i class="sep" data-marble-id="__ID__"></i>
  <button class="tool" data-marble-id="__ID__" data-cmd="bold" title="Bold (Ctrl+B)"><span class="letter" data-marble-id="__ID__">B</span></button>
  <button class="tool" data-marble-id="__ID__" data-cmd="italic" title="Italic (Ctrl+I)"><span class="letter i" data-marble-id="__ID__">I</span></button>
  <button class="tool" data-marble-id="__ID__" data-cmd="underline" title="Underline (Ctrl+U)"><span class="letter u" data-marble-id="__ID__">U</span></button>
  <button class="tool" data-marble-id="__ID__" data-cmd="strike" title="Strikethrough"><span class="letter s" data-marble-id="__ID__">S</span></button>
  <button class="tool paint" data-marble-id="__ID__" data-pick="colour" title="Text colour">
    <span class="letter" data-marble-id="__ID__">A</span>
    <i class="swatch" id="now-fg" data-marble-transient></i>
  </button>
  <i class="sep" data-marble-id="__ID__"></i>
  <button class="tool aligner" data-marble-id="__ID__" data-pick="align" title="Align">
    <svg class="ico g-left" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-left"/></svg>
    <svg class="ico g-center" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-center"/></svg>
    <svg class="ico g-right" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-right"/></svg>
    <svg class="ico g-justify" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-justify"/></svg>
  </button>
  <button class="tool" data-marble-id="__ID__" data-cmd="bullet" title="Bulleted list"><svg class="ico" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-bullet"/></svg></button>
  <button class="tool" data-marble-id="__ID__" data-cmd="number" title="Numbered list"><svg class="ico" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-number"/></svg></button>
  <button class="tool" data-marble-id="__ID__" data-cmd="outdent" title="Less indent (Shift+Tab)"><svg class="ico" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-outdent"/></svg></button>
  <button class="tool" data-marble-id="__ID__" data-cmd="indent" title="More indent (Tab)"><svg class="ico" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-indent"/></svg></button>
  <button class="tool" data-marble-id="__ID__" data-cmd="clear" title="Clear formatting (Ctrl+\)"><svg class="ico" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-clear"/></svg></button>
  <i class="spring" data-marble-id="__ID__"></i>
  <button class="tool" data-marble-id="__ID__" data-cmd="fonts" title="Fonts"><span class="letter" data-marble-id="__ID__">Aa</span></button>
</div>

<div class="work" data-marble-id="__ID__">

  <aside class="outline" data-marble-transient>
    <h2>Outline</h2>
    <ol id="outline-list"></ol>
  </aside>

  <div class="scroll" data-marble-id="__ID__">
    <div class="pagebox" id="pagebox" data-marble-id="__ID__" style="--ml: 1in; --mr: 1in">

      <div class="ruler" data-marble-transient>
        <i class="gut l"></i>
        <i class="gut r"></i>
        <div class="field"></div>
        <i class="pin l" data-edge="ml" title="Left margin"></i>
        <i class="pin r" data-edge="mr" title="Right margin"></i>
      </div>

      <article class="page" id="page" data-marble-id="__ID__">
        <div class="flow" id="flow" data-marble-id="__ID__">
<h1 data-marble-id="__ID__" data-marble-rich>__TITLE__</h1>
<p class="subtitle" data-marble-id="__ID__" data-marble-rich>Notes that are also the file they are kept in</p>
<p data-marble-id="__ID__" data-marble-rich>There is no save button, because what you are reading is not a copy of these notes — it <i>is</i> the notes. Type into it and the bytes on disk change with you.</p>
<h2 data-marble-id="__ID__" data-marble-rich>Writing</h2>
<p data-marble-id="__ID__" data-marble-rich>Enter starts a new paragraph, splitting this one where the caret is. Backspace at the beginning joins it to the one above. The arrow keys walk from paragraph to paragraph the way they walk from line to line, and Ctrl+Shift+Up or Down carries a paragraph with them.</p>
<p data-marble-id="__ID__" data-marble-rich>Select a few words and the toolbar acts on <b>exactly those words</b> — weight, slant, colour, face and size are written around the characters, so the file holds <i>this</i> and not a note about it. Select nothing and the same buttons act on the whole paragraph.</p>
<h3 data-marble-id="__ID__" data-marble-rich>Two kinds of property</h3>
<p data-marble-id="__ID__" data-marble-rich data-list="bullet">The paragraph's own — its style, its alignment, whether it is a list item, how far it is indented — is one attribute on the block, so each change is one edit.</p>
<p data-marble-id="__ID__" data-marble-rich data-list="bullet">The characters' own — <b>bold</b>, <i>italic</i>, <u>underline</u>, <s>struck through</s> — is inline markup, the way you would have written it by hand.</p>
<p data-marble-id="__ID__" data-marble-rich data-list="bullet">Undo takes back the last one either way, whoever made it: you, an agent, or another window.</p>
<h3 data-marble-id="__ID__" data-marble-rich>The page, and the faces</h3>
<p data-marble-id="__ID__" data-marble-rich>Drag either marker on the ruler and the margin moves, written into the file as an inch on the page itself. <b>Aa</b> at the right of the toolbar opens a card that sets the face this interface wears and the face these notes wear — two separate choices, both kept in the file, both there when you come back.</p>
<p data-marble-id="__ID__" data-marble-rich>The outline on the left and the word count below it are the only things here that are not in the file, because each is only ever a reading of it.</p>
        </div>
      </article>

    </div>
  </div>
</div>

<aside class="fonts" id="fonts" data-marble-id="__ID__">
  <header data-marble-id="__ID__">
    <h2 data-marble-id="__ID__" data-marble-editable>Fonts</h2>
    <button class="shut" data-marble-id="__ID__" data-cmd="fonts" title="Hide" aria-label="Hide">&times;</button>
  </header>
  <div class="two" data-marble-id="__ID__">
    <div class="col" data-marble-id="__ID__">
      <span class="lbl" data-marble-id="__ID__" data-marble-editable>Interface</span>
      <button data-marble-id="__ID__" data-set-ui="avenir">Avenir Next</button>
      <button data-marble-id="__ID__" data-set-ui="system">System</button>
      <button data-marble-id="__ID__" data-set-ui="grotesk">Helvetica Neue</button>
      <button data-marble-id="__ID__" data-set-ui="optima">Optima</button>
      <button data-marble-id="__ID__" data-set-ui="garamond">Cormorant</button>
      <button data-marble-id="__ID__" data-set-ui="charter">Charter</button>
      <button data-marble-id="__ID__" data-set-ui="mono">JetBrains Mono</button>
    </div>
    <div class="col" data-marble-id="__ID__">
      <span class="lbl" data-marble-id="__ID__" data-marble-editable>Document</span>
      <button data-marble-id="__ID__" data-set-doc="avenir">Avenir Next</button>
      <button data-marble-id="__ID__" data-set-doc="system">System</button>
      <button data-marble-id="__ID__" data-set-doc="grotesk">Helvetica Neue</button>
      <button data-marble-id="__ID__" data-set-doc="optima">Optima</button>
      <button data-marble-id="__ID__" data-set-doc="garamond">Cormorant</button>
      <button data-marble-id="__ID__" data-set-doc="charter">Charter</button>
      <button data-marble-id="__ID__" data-set-doc="mono">JetBrains Mono</button>
    </div>
  </div>
</aside>

<div class="popup" id="popup" data-marble-transient></div>
<div class="count" id="count" data-marble-transient></div>

<script>
  // The editor's own behaviour.
  //
  // Everything below is one of two things. A command changes the notes, and
  // every one of them does the same two things in the same order: it moves the
  // page, and it writes the same change down as an op, so the file and the
  // screen never get to disagree. A derivation reads the notes and draws
  // something transient from them — the outline, the word count, the labels and
  // the lit buttons on the toolbar — and files nothing at all, because none of
  // it is a fact the document keeps.
  //
  // The one affordance this document invents is data-marble-rich. The shared
  // `editable` is a setText affordance: it holds plain text and its whole
  // contents are replaced on every keystroke, which is right for a name in the
  // chrome and fatal to a <b> in the middle of a sentence. A rich block is
  // edited with setInner instead, so the inline markup survives, and it says so
  // in its own attribute rather than pretending to be the other thing.
  (() => {
    const begin = (marble) => {
      const $ = (sel) => document.querySelector(sel);
      const flow = $('#flow');
      const page = $('#page');
      const pagebox = $('#pagebox');
      const popup = $('#popup');
      const counter = $('#count');
      const outline = $('#outline-list');
      const widget = $('#fonts');
      if (!flow) return;

      // All four belong to the page. An open menu is not a fact about the
      // notes, and neither is a greyed-out undo button.
      marble.pageOnly('contenteditable', 'spellcheck', 'data-open', 'disabled');

      // ------------------------------------------------------------ the styles

      const STYLES = [
        { key: 'title', name: 'Title', tag: 'h1', cls: '' },
        { key: 'subtitle', name: 'Subtitle', tag: 'p', cls: 'subtitle' },
        { key: 'h1', name: 'Heading', tag: 'h2', cls: '' },
        { key: 'h2', name: 'Subheading', tag: 'h3', cls: '' },
        { key: 'h3', name: 'Label', tag: 'h4', cls: '' },
        { key: 'body', name: 'Body', tag: 'p', cls: '' },
      ];
      const styleNamed = (key) => STYLES.find((s) => s.key === key) ?? STYLES[5];

      function styleOf(el) {
        switch (el?.tagName) {
          case 'H1': return 'title';
          case 'H2': return 'h1';
          case 'H3': return 'h2';
          case 'H4': return 'h3';
          default: return el?.classList.contains('subtitle') ? 'subtitle' : 'body';
        }
      }

      const FACES = [
        ['avenir', 'Avenir Next'], ['system', 'System'], ['grotesk', 'Helvetica Neue'],
        ['optima', 'Optima'], ['garamond', 'Cormorant'], ['charter', 'Charter'],
        ['mono', 'JetBrains Mono'],
      ];
      const ALIGN = [['left', 'Left'], ['center', 'Centre'], ['right', 'Right'], ['justify', 'Justify']];
      const INKS = ['', '#111111', '#5a5a5a', '#8a8a8a', '#738698',
                    '#9bb6cf', '#b4544f', '#8a6d3b', '#5f7a52', '#7a5f7e'];

      const isText = (el) => Boolean(el) && el.parentElement === flow && el.hasAttribute('data-marble-rich');
      const firstBlock = () => [...flow.children].find(isText) ?? null;

      // The block the toolbar is talking about. It survives a click on the
      // toolbar itself, which is why none of those buttons take focus.
      let here = null;
      const target = () => (isText(here) && here.isConnected ? here : (here = firstBlock()));

      // ------------------------------------------------- the inline vocabulary
      //
      // Everything the editor is allowed to put between the tags of a block. A
      // contenteditable will happily produce far more than this given a paste
      // or a stray shortcut, so what comes out is filtered down to this list on
      // the way into the file rather than trusted on the way out of the browser.

      const KEEP = new Set(['B', 'I', 'U', 'S', 'BR', 'SPAN']);
      const KEEP_STYLE = ['color', 'font-family', 'font-size'];

      function tidy(el) {
        let changed = false;
        for (const node of [...el.querySelectorAll('*')]) {
          if (!node.isConnected) continue;
          const tag = node.tagName;

          // The tags a browser writes for the ones this document uses.
          if (tag === 'STRONG' || tag === 'EM' || tag === 'STRIKE' || tag === 'DEL' || tag === 'FONT') {
            const want = tag === 'STRONG' ? 'b' : tag === 'EM' ? 'i' : tag === 'FONT' ? 'span' : 's';
            const swap = document.createElement(want);
            if (tag === 'FONT' && node.getAttribute('color')) swap.style.color = node.getAttribute('color');
            swap.append(...node.childNodes);
            node.replaceWith(swap);
            changed = true;
            continue;
          }

          if (!KEEP.has(tag)) {
            node.replaceWith(...node.childNodes);
            changed = true;
            continue;
          }

          // Wrapping a selection leaves the husk of whatever it was cut out
          // of. Empty marks are invisible on screen and noise in the diff.
          if (tag !== 'BR' && !node.textContent) {
            node.remove();
            changed = true;
            continue;
          }

          for (const name of [...node.getAttributeNames()]) {
            if (name === 'style' && tag === 'SPAN') continue;
            node.removeAttribute(name);
            changed = true;
          }

          if (tag !== 'SPAN') continue;
          for (const prop of [...node.style]) {
            if (KEEP_STYLE.includes(prop)) continue;
            node.style.removeProperty(prop);
            changed = true;
          }
          // A span carrying nothing is noise in the diff.
          if (!node.getAttribute('style')) {
            node.replaceWith(...node.childNodes);
            changed = true;
          }
        }
        if (changed) el.normalize();
        return changed;
      }

      // ---------------------------------------------------------- the caret
      //
      // Offsets are counted in characters across the block's text nodes, so a
      // caret survives the inline markup moving around underneath it.

      const lineOf = (el) => {
        const cs = getComputedStyle(el);
        return parseFloat(cs.lineHeight) || parseFloat(cs.fontSize) * 1.3 || 16;
      };

      function caretAt(el) {
        const sel = getSelection();
        if (!sel || !sel.rangeCount) return null;
        const range = sel.getRangeAt(0);
        if (!el.contains(range.startContainer)) return null;
        const before = range.cloneRange();
        before.selectNodeContents(el);
        before.setEnd(range.startContainer, range.startOffset);
        return before.toString().length;
      }

      function place(el, at) {
        el.focus();
        const walk = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
        let seen = 0;
        let node = null;
        let into = 0;
        let last = null;
        while ((node = walk.nextNode())) {
          last = node;
          if (seen + node.length >= at) { into = at - seen; break; }
          seen += node.length;
          node = null;
        }
        const range = document.createRange();
        if (node) range.setStart(node, Math.max(0, Math.min(into, node.length)));
        else if (last) range.setStart(last, last.length);
        else range.selectNodeContents(el);
        range.collapse(true);
        const sel = getSelection();
        sel.removeAllRanges();
        sel.addRange(range);
        here = el;
      }

      const loose = () => {
        const sel = getSelection();
        return !sel || !sel.isCollapsed;
      };

      const inBlock = (el) => {
        const sel = getSelection();
        return Boolean(sel && sel.rangeCount && el && el.contains(sel.anchorNode));
      };

      // ------------------------------------------------------ writing it down

      function attr(el, name, value) {
        const id = el && marble.id(el);
        if (!id) return;
        const was = el.getAttribute(name);
        if (was === value) return;
        if (value === null) el.removeAttribute(name);
        else el.setAttribute(name, value);
        const op = { type: 'setAttr', id, name, value };
        marble.record({ redo: [op], undo: [{ type: 'setAttr', id, name, value: was }] });
        marble.op(op, { immediate: true });
      }

      // An empty style attribute is not a fact, it is a leftover — a devtools
      // session, an extension or a screenshot tool touching el.style is enough
      // to leave one behind. The carrier drops an empty class for the same
      // reason; this is that rule for the other attribute where blank means
      // absent, applied on the way into the file rather than out of it.
      const styleOn = (el) => el?.getAttribute('style')?.trim() || null;

      // The style attribute carries more than one custom property, so it is
      // composed rather than appended to, and a property set to null leaves.
      function withVar(style, name, value) {
        const kept = (style ?? '')
          .split(';')
          .map((bit) => bit.trim())
          .filter((bit) => bit && bit.slice(0, bit.indexOf(':')).trim() !== name);
        if (value !== null) kept.push(name + ': ' + value);
        return kept.length ? kept.join('; ') : null;
      }

      // ------------------------------------------------------- typing, filed
      //
      // A keystroke files a setInner immediately, so the file is never behind
      // the screen. Undo is coarser than that on purpose: one step per burst of
      // typing rather than one per character. The carrier only knows how to
      // coalesce setText, so the grouping is kept here — opened on the first
      // keystroke, closed when typing stops, when focus leaves, before any
      // other command, and before Ctrl+Z, so there is never a burst in flight
      // that undo does not know about.

      let pending = null;
      let held = null;
      let idle = null;

      function commit() {
        clearTimeout(idle);
        const open = pending;
        pending = null;
        if (!open) return;
        const { el, prior } = open;
        const id = el.isConnected && marble.id(el);
        if (!id) return;
        const html = marble.source.inner(el);
        if (html === prior) return;
        marble.record({
          redo: [{ type: 'setInner', id, html }],
          undo: [{ type: 'setInner', id, html: prior }],
        });
      }

      function typed(el) {
        const id = marble.id(el);
        if (!id) return;
        if (!pending || pending.el !== el) {
          commit();
          pending = { el, prior: held ?? marble.source.inner(el) };
        }
        const html = marble.source.inner(el);
        held = html;
        marble.op({ type: 'setInner', id, html });
        clearTimeout(idle);
        idle = setTimeout(commit, 700);
      }

      // A change this document makes on purpose, rather than one the browser
      // made because a key was pressed: filed as its own step, against the
      // markup as it was before.
      function fileInner(el, prior) {
        commit();
        const id = marble.id(el);
        const html = marble.source.inner(el);
        held = html;
        if (!id || html === prior) return;
        marble.record({
          redo: [{ type: 'setInner', id, html }],
          undo: [{ type: 'setInner', id, html: prior }],
        });
        marble.op({ type: 'setInner', id, html }, { immediate: true });
      }

      // ---------------------------------------------------- the rich affordance

      const wired = new WeakSet();

      function wireRich(root) {
        const all = [
          ...(root.matches?.('[data-marble-rich]') ? [root] : []),
          ...root.querySelectorAll('[data-marble-rich]'),
        ];
        for (const el of all) {
          if (wired.has(el)) continue;
          wired.add(el);
          el.setAttribute('contenteditable', 'true');
          el.spellcheck = false;

          el.addEventListener('focus', () => {
            held = marble.source.inner(el);
          });
          el.addEventListener('input', () => {
            if (tidy(el)) place(el, caretAt(el) ?? 0);
            typed(el);
            derive();
            sync();
          });
          el.addEventListener('blur', () => {
            commit();
            held = null;
            marble.flush();
          });
          // A contenteditable will take whole documents if you let it. Plain
          // text is what a note wants anyway, and it is the only paste that
          // cannot put something in the file that nothing here can edit.
          el.addEventListener('paste', (event) => {
            event.preventDefault();
            const text = event.clipboardData?.getData('text/plain') ?? '';
            document.execCommand('insertText', false, text);
          });
        }
      }

      // A new block is shaped from an existing one, so the paragraph's own
      // properties carry forward the way they do in any editor.
      function shape(from, key, html) {
        const style = styleNamed(key);
        const el = document.createElement(style.tag);
        if (from) for (const a of marble.clone(from).attributes) el.setAttribute(a.name, a.value);
        el.removeAttribute('class');
        if (!styleOn(el)) el.removeAttribute('style');
        if (style.cls) el.setAttribute('class', style.cls);
        el.setAttribute('data-marble-rich', '');
        el.setAttribute('data-marble-id', marble.newId());
        el.innerHTML = '';
        if (typeof html === 'string') el.innerHTML = html;
        else if (html) el.append(html);
        tidy(el);
        return el;
      }

      const before = (el) => (el?.nextElementSibling ? marble.id(el.nextElementSibling) : null);

      // ------------------------------------------------------- block commands

      function restyle(el, key) {
        if (!isText(el) || styleOf(el) === key) return el;
        commit();
        const parentId = marble.id(flow);
        const oldId = marble.id(el);
        const oldHtml = marble.source.outer(el);
        const at = caretAt(el) ?? 0;

        const made = shape(el, key, marble.source.inner(el));
        const id = marble.id(made);
        const insert = { type: 'insert', html: marble.source.outer(made), parentId, beforeId: oldId };
        const remove = { type: 'remove', id: oldId };
        marble.apply(insert);
        marble.apply(remove);
        marble.record({
          redo: [insert, remove],
          undo: [{ type: 'insert', html: oldHtml, parentId, beforeId: id }, { type: 'remove', id }],
        });
        marble.op(insert);
        marble.op(remove, { immediate: true });

        const node = marble.byId(id);
        if (node) place(node, at);
        return node;
      }

      // Enter. The paragraph is cut at the caret and everything after it —
      // markup included — becomes the next one.
      function split(el) {
        commit();
        const sel = getSelection();
        if (!sel || !sel.rangeCount) return;
        const prior = marble.source.inner(el);

        // Nothing in it and it is a list item: Enter leaves the list rather
        // than making another empty one.
        if (!marble.text(el) && el.hasAttribute('data-list')) return attr(el, 'data-list', null);

        const tail = sel.getRangeAt(0).cloneRange();
        tail.setEnd(el, el.childNodes.length);
        const carried = tail.extractContents();

        const parentId = marble.id(flow);
        const id = marble.id(el);
        const made = shape(el, 'body', carried);
        const newId = marble.id(made);
        tidy(el);
        const cut = { type: 'setInner', id, html: marble.source.inner(el) };
        const insert = { type: 'insert', html: marble.source.outer(made), parentId, beforeId: before(el) };
        marble.apply(insert);
        marble.record({
          redo: [cut, insert],
          undo: [{ type: 'remove', id: newId }, { type: 'setInner', id, html: prior }],
        });
        marble.op(cut);
        marble.op(insert, { immediate: true });

        const node = marble.byId(newId);
        if (node) place(node, 0);
      }

      // Backspace at the start, or Delete at the end: two paragraphs become one.
      function join(head, tail) {
        commit();
        const parentId = marble.id(flow);
        const kept = marble.source.inner(head);
        const at = marble.text(head).length;
        const tailHtml = marble.source.outer(tail);
        const beforeId = before(tail);

        head.append(...tail.childNodes);
        tidy(head);
        const merge = { type: 'setInner', id: marble.id(head), html: marble.source.inner(head) };
        const remove = { type: 'remove', id: marble.id(tail) };
        marble.apply(remove);
        marble.record({
          redo: [merge, remove],
          undo: [
            { type: 'insert', html: tailHtml, parentId, beforeId },
            { type: 'setInner', id: marble.id(head), html: kept },
          ],
        });
        marble.op(merge);
        marble.op(remove, { immediate: true });
        place(head, at);
      }

      function drop(el) {
        commit();
        const op = { type: 'remove', id: marble.id(el) };
        const back = marble.invert(op);
        el.remove();
        if (back) marble.record({ redo: [op], undo: [back] });
        marble.op(op, { immediate: true });
      }

      function follow(el, made) {
        commit();
        const op = {
          type: 'insert',
          html: marble.source.outer(made),
          parentId: marble.id(flow),
          beforeId: before(el),
        };
        marble.apply(op);
        marble.record({ redo: [op], undo: [{ type: 'remove', id: marble.id(made) }] });
        marble.op(op, { immediate: true });
        return marble.byId(marble.id(made));
      }

      function shift(el, dir) {
        commit();
        const kin = dir < 0 ? el.previousElementSibling : el.nextElementSibling;
        if (!kin) return;
        const parentId = marble.id(flow);
        const id = marble.id(el);
        const was = before(el);
        const beforeId = dir < 0 ? marble.id(kin) : before(kin);
        const op = { type: 'move', id, parentId, beforeId };
        marble.apply(op);
        marble.record({ redo: [op], undo: [{ type: 'move', id, parentId, beforeId: was }] });
        marble.op(op, { immediate: true });
        el.focus();
      }

      const alignOf = (el) => el?.getAttribute('data-align') ?? 'left';
      const listOf = (el) => el?.getAttribute('data-list') ?? null;

      const listAs = (kind) => {
        const el = target();
        attr(el, 'data-list', listOf(el) === kind ? null : kind);
      };

      function indent(dir) {
        const el = target();
        const now = Number(el?.getAttribute('data-indent') ?? 0);
        const next = Math.max(0, Math.min(5, now + dir));
        attr(el, 'data-indent', next ? String(next) : null);
      }

      // ------------------------------------------------ character commands
      //
      // These act on what is selected, which is the whole point of them. With
      // nothing selected there is no pending-format machine to consult, so the
      // paragraph is selected instead — the reading of "bold" that needs no
      // hidden state to explain it.

      function onSelection(run) {
        const el = target();
        if (!el) return;
        const sel = getSelection();
        if (!inBlock(el) || sel.isCollapsed) {
          el.focus();
          const all = document.createRange();
          all.selectNodeContents(el);
          sel.removeAllRanges();
          sel.addRange(all);
        }
        const prior = marble.source.inner(el);
        run(el, getSelection());
        tidy(el);
        fileInner(el, prior);
        sync();
      }

      // execCommand is the only thing in any browser that knows how to toggle a
      // tag across a partial selection, splitting and merging the runs on both
      // edges. It is legacy and it has no replacement; what it writes is
      // filtered by tidy() before it reaches the file, which is what makes it
      // safe to lean on.
      const MARK = { bold: 'bold', italic: 'italic', underline: 'underline', strike: 'strikeThrough' };

      const markUp = (name) =>
        onSelection(() => {
          document.execCommand('styleWithCSS', false, false);
          document.execCommand(MARK[name], false, null);
        });

      // Colour, face and size have no toggling command worth the name, so the
      // selection is wrapped by hand and tidy() merges what it can.
      const dressUp = (prop, value) =>
        onSelection((el, sel) => {
          const range = sel.getRangeAt(0);

          // Dressing the very same words twice should not stack wrappers. If
          // the selection is exactly what one span already holds, the
          // declaration joins that span — colour and face on one run of text
          // are one span with two declarations, not one span inside another.
          //
          // Found by comparing the text rather than by climbing from the
          // range's boundaries: a browser is free to express "all of this
          // span" either as the node itself or as the text inside it, and both
          // spellings have to land here.
          const host = [...el.querySelectorAll('span')].find(
            (span) => range.intersectsNode(span) && range.toString() === span.textContent,
          );
          if (host) {
            if (value) host.style.setProperty(prop, value);
            else host.style.removeProperty(prop);
            return;
          }

          // Otherwise take the property off whatever already carries it inside
          // the selection, so the new value is the only one there.
          for (const span of [...el.querySelectorAll('span')]) {
            if (range.intersectsNode(span)) span.style.removeProperty(prop);
          }
          if (!value) return;
          const span = document.createElement('span');
          span.style.setProperty(prop, value);
          span.append(range.extractContents());
          range.insertNode(span);
          sel.removeAllRanges();
          const after = document.createRange();
          after.selectNodeContents(span);
          sel.addRange(after);
        });

      // What the caret is sitting in, which is what the toolbar reports.
      function atCaret() {
        const sel = getSelection();
        const node = sel?.anchorNode;
        const el = node?.nodeType === 3 ? node.parentElement : node;
        return el && flow.contains(el) ? el : target();
      }

      const faceOf = (el) => {
        const now = getComputedStyle(el ?? flow).fontFamily;
        const first = now.split(',')[0].replace(/["']/g, '').trim().toLowerCase();
        return FACES.find(([key]) =>
          getComputedStyle(document.body).getPropertyValue('--f-' + key)
            .split(',')[0].replace(/["']/g, '').trim().toLowerCase() === first)?.[1] ?? first;
      };

      const ptOf = (el) => Math.round(parseFloat(getComputedStyle(el ?? flow).fontSize) * 0.75 * 2) / 2;

      const resize = (dir) => {
        const at = atCaret();
        const now = ptOf(at);
        const next = Math.max(6, Math.min(96, now + dir));
        dressUp('font-size', next + 'pt');
      };

      // Clear formatting is every inline mark in the paragraph and every
      // property the paragraph itself carries, gone in one gesture and so in
      // one step of undo.
      function clear() {
        const el = target();
        const id = el && marble.id(el);
        if (!id) return;
        commit();
        const prior = marble.source.inner(el);
        const redo = [];
        const undo = [];

        el.innerHTML = '';
        el.textContent = new DOMParser().parseFromString(prior, 'text/html').body.textContent;
        const html = marble.source.inner(el);
        if (html !== prior) {
          redo.push({ type: 'setInner', id, html });
          undo.unshift({ type: 'setInner', id, html: prior });
        }
        for (const name of ['data-align', 'data-indent', 'data-list', 'style']) {
          if (!el.hasAttribute(name)) continue;
          undo.unshift({ type: 'setAttr', id, name, value: name === 'style' ? styleOn(el) : el.getAttribute(name) });
          redo.push({ type: 'setAttr', id, name, value: null });
          el.removeAttribute(name);
        }
        if (redo.length) {
          marble.record({ redo, undo });
          for (const op of redo) marble.op(op);
          marble.flush();
        }
        held = marble.source.inner(el);
        restyle(el, 'body');
        sync();
      }

      // ------------------------------------------------------- the page margins

      function margins(left, right) {
        const was = pagebox.getAttribute('style');
        const value = withVar(withVar(was, '--ml', left + 'in'), '--mr', right + 'in');
        const id = marble.id(pagebox);
        pagebox.setAttribute('style', value);
        const op = { type: 'setAttr', id, name: 'style', value };
        marble.record({ redo: [op], undo: [{ type: 'setAttr', id, name: 'style', value: was }] });
        marble.op(op, { immediate: true });
      }

      const inchesOf = (name) => parseFloat(pagebox.style.getPropertyValue(name)) || 1;

      function pageSetup() {
        const said = prompt('Left and right margin, in inches', String(inchesOf('--ml')));
        if (said === null) return;
        const inches = Math.max(0.25, Math.min(3.5, parseFloat(said) || 1));
        margins(inches, inches);
      }

      // One gesture, one op: the file hears about a drag on release, not a
      // hundred times on the way there.
      function draggable(handle, moved, settled) {
        handle.addEventListener('pointerdown', (event) => {
          if (event.button) return;
          event.preventDefault();
          handle.classList.add('marble-dragging');
          let live = false;
          const move = (event) => {
            live = true;
            moved(event);
          };
          const up = () => {
            removeEventListener('pointermove', move);
            handle.classList.remove('marble-dragging');
            if (live) settled();
          };
          addEventListener('pointermove', move);
          addEventListener('pointerup', up, { once: true });
          addEventListener('pointercancel', up, { once: true });
        });
      }

      for (const pin of document.querySelectorAll('.ruler .pin')) {
        const edge = pin.getAttribute('data-edge');
        let was = null;
        let at = null;
        draggable(
          pin,
          (event) => {
            if (was === null) was = pagebox.getAttribute('style');
            const box = page.getBoundingClientRect();
            const dpi = box.width / 8.5;
            const raw = edge === 'ml' ? (event.clientX - box.left) / dpi : (box.right - event.clientX) / dpi;
            // An eighth of an inch is where the ruler's own ticks are. Shift is
            // the way off the ticks, for the margin that has to sit between two.
            const step = event.shiftKey ? Math.round(raw * 100) / 100 : Math.round(raw * 8) / 8;
            at = Math.max(0.25, Math.min(3.5, step));
            pagebox.style.setProperty('--' + edge, at + 'in');
          },
          () => {
            if (at === null) return;
            const value = withVar(was, '--' + edge, at + 'in');
            const id = marble.id(pagebox);
            pagebox.setAttribute('style', value);
            const op = { type: 'setAttr', id, name: 'style', value };
            marble.record({ redo: [op], undo: [{ type: 'setAttr', id, name: 'style', value: was }] });
            marble.op(op, { immediate: true });
            was = null;
            at = null;
          },
        );
      }

      // The widget is furniture you can put where you like, and where you put
      // it is an inline style on it — one attribute, filed once, on release.
      {
        const grip = widget.querySelector('header');
        let was = null;
        let from = null;
        let at = null;
        draggable(
          grip,
          (event) => {
            const box = widget.getBoundingClientRect();
            if (was === null) {
              was = widget.getAttribute('style');
              from = { x: event.clientX - box.left, y: event.clientY - box.top };
            }
            at = {
              x: Math.max(4, Math.min(innerWidth - box.width - 4, event.clientX - from.x)),
              y: Math.max(4, Math.min(innerHeight - box.height - 4, event.clientY - from.y)),
            };
            // Pinning left/top means letting go of right/bottom, or the card
            // would be told to be in two places at once.
            widget.style.setProperty('--fx', at.x + 'px');
            widget.style.setProperty('--fy', at.y + 'px');
            widget.style.setProperty('--fr', 'auto');
            widget.style.setProperty('--fb', 'auto');
          },
          () => {
            if (!at) return;
            let value = withVar(was, '--fx', at.x + 'px');
            value = withVar(value, '--fy', at.y + 'px');
            value = withVar(value, '--fr', 'auto');
            value = withVar(value, '--fb', 'auto');
            const id = marble.id(widget);
            widget.setAttribute('style', value);
            const op = { type: 'setAttr', id, name: 'style', value };
            marble.record({ redo: [op], undo: [{ type: 'setAttr', id, name: 'style', value: was }] });
            marble.op(op, { immediate: true });
            was = null;
            at = null;
          },
        );
      }

      // ---------------------------------------------------- menus and pickers

      let opened = null;

      function shut() {
        popup.removeAttribute('data-open');
        popup.textContent = '';
        opened?.removeAttribute('data-open');
        opened = null;
      }

      function row(label, run, { hint, on, off } = {}) {
        const button = document.createElement('button');
        button.type = 'button';
        button.append(label);
        if (hint) {
          const span = document.createElement('span');
          span.className = 'hint';
          span.textContent = hint;
          button.append(span);
        }
        if (on) button.setAttribute('data-on', '1');
        if (off) button.disabled = true;
        button.addEventListener('click', () => {
          shut();
          run();
          sync();
        });
        popup.append(button);
      }

      function open(anchor, build) {
        const same = opened === anchor;
        shut();
        if (same) return;
        build(row);
        opened = anchor;
        anchor.setAttribute('data-open', '1');
        popup.setAttribute('data-open', '1');
        const box = anchor.getBoundingClientRect();
        popup.style.left = Math.max(4, Math.min(box.left, innerWidth - popup.offsetWidth - 8)) + 'px';
        popup.style.top = Math.min(box.bottom + 4, innerHeight - popup.offsetHeight - 8) + 'px';
      }

      const showing = (name) => document.body.getAttribute(name) !== 'off';
      const flip = (name) => attr(document.body, name, showing(name) ? 'off' : 'on');

      const MENUS = {
        file: (add) => {
          add('Page setup…', pageSetup);
          add('Print', () => print(), { hint: 'Ctrl+P' });
          add('Rename', () => {
            const name = $('.docname');
            name.focus();
            getSelection().selectAllChildren(name);
          });
        },
        edit: (add) => {
          add('Undo', () => (commit(), marble.undo()), { hint: 'Ctrl+Z', off: !marble.canUndo });
          add('Redo', () => marble.redo(), { hint: 'Ctrl+Shift+Z', off: !marble.canRedo });
          add('Delete paragraph', () => {
            const el = target();
            const to = el.previousElementSibling ?? el.nextElementSibling;
            if (!to) return;
            drop(el);
            here = null;
            if (isText(to)) place(to, marble.text(to).length);
          }, { off: [...flow.children].filter(isText).length < 2 });
        },
        view: (add) => {
          add('Outline', () => flip('data-outline'), { on: showing('data-outline') });
          add('Ruler', () => flip('data-ruler'), { on: showing('data-ruler') });
          add('Fonts', () => flip('data-fonts'), { on: showing('data-fonts') });
        },
        insert: (add) => {
          for (const key of ['h1', 'h2', 'h3']) {
            add(styleNamed(key).name, () => {
              const made = follow(target(), shape(target(), key, ''));
              if (made) place(made, 0);
            });
          }
          add('Bulleted list', () => listAs('bullet'), { on: listOf(target()) === 'bullet' });
          add('Numbered list', () => listAs('number'), { on: listOf(target()) === 'number' });
          add('Horizontal line', () => {
            const rule = document.createElement('hr');
            rule.setAttribute('data-marble-id', marble.newId());
            follow(target(), rule);
          });
        },
        format: (add) => {
          add('Bold', () => markUp('bold'), { hint: 'Ctrl+B', on: state('bold') });
          add('Italic', () => markUp('italic'), { hint: 'Ctrl+I', on: state('italic') });
          add('Underline', () => markUp('underline'), { hint: 'Ctrl+U', on: state('underline') });
          add('Strikethrough', () => markUp('strike'), { on: state('strike') });
          for (const [value, name] of ALIGN) {
            add('Align ' + name.toLowerCase(), () => attr(target(), 'data-align', value === 'left' ? null : value),
                { on: alignOf(target()) === value });
          }
          add('Clear formatting', clear, { hint: 'Ctrl+\\' });
        },
        tools: (add) => {
          add('Word count', () => detail(), { hint: 'Ctrl+Shift+C' });
        },
      };

      const PICKS = {
        style: (add) => {
          for (const style of STYLES) {
            add(style.name, () => restyle(target(), style.key), { on: styleOf(target()) === style.key });
          }
        },
        face: (add) => {
          const now = faceOf(atCaret());
          for (const [key, name] of FACES) {
            add(name, () => dressUp('font-family', 'var(--f-' + key + ')'), { on: name === now });
          }
          add('Match the document', () => dressUp('font-family', ''));
        },
        align: (add) => {
          for (const [value, name] of ALIGN) {
            add(name, () => attr(target(), 'data-align', value === 'left' ? null : value),
                { on: alignOf(target()) === value });
          }
        },
        colour: () => {
          const grid = document.createElement('div');
          grid.className = 'swatches';
          const now = getComputedStyle(atCaret() ?? flow).color;
          for (const ink of INKS) {
            const chip = document.createElement('i');
            chip.title = ink || 'Default';
            chip.style.background = ink ||
              'linear-gradient(135deg, transparent 45%, currentColor 45% 55%, transparent 55%)';
            if (ink && paint(ink) === now) chip.setAttribute('data-on', '1');
            chip.addEventListener('click', () => {
              shut();
              dressUp('color', ink);
            });
            grid.append(chip);
          }
          popup.append(grid);
        },
      };

      // getComputedStyle answers in rgb(), so a hex has to be put through the
      // same mill before the two can be compared.
      const paint = (hex) => {
        const probe = document.createElement('span');
        probe.style.color = hex;
        document.body.append(probe);
        const said = getComputedStyle(probe).color;
        probe.remove();
        return said;
      };

      const state = (name) => {
        try {
          return document.queryCommandState(MARK[name]);
        } catch {
          return false;
        }
      };

      const CMD = {
        undo: () => (commit(), marble.undo()),
        redo: () => marble.redo(),
        bold: () => markUp('bold'),
        italic: () => markUp('italic'),
        underline: () => markUp('underline'),
        strike: () => markUp('strike'),
        bullet: () => listAs('bullet'),
        number: () => listAs('number'),
        outdent: () => indent(-1),
        indent: () => indent(1),
        smaller: () => resize(-0.5),
        bigger: () => resize(0.5),
        clear: () => clear(),
        fonts: () => flip('data-fonts'),
      };

      // Delegated rather than wired button by button, so chrome rebuilt by an
      // undo, an agent or another window is live the moment it lands.
      addEventListener('mousedown', (event) => {
        // The selection stays exactly as it was under the button acting on it.
        if (event.target.closest('.tools, .menus, .popup, .fonts')) event.preventDefault();
      }, true);

      addEventListener('pointerdown', (event) => {
        if (!event.target.closest('.popup, .menu, .tool')) shut();
      });

      addEventListener('click', (event) => {
        const menu = event.target.closest('.menu');
        if (menu) return open(menu, MENUS[menu.getAttribute('data-menu')] ?? (() => {}));

        const face = event.target.closest('[data-set-ui], [data-set-doc]');
        if (face) {
          const ui = face.getAttribute('data-set-ui');
          if (ui) attr(document.body, 'data-ui-font', ui);
          else attr(document.body, 'data-doc-font', face.getAttribute('data-set-doc'));
          return sync();
        }

        const tool = event.target.closest('.tool, .shut');
        if (!tool) return;
        const pick = tool.getAttribute('data-pick');
        if (pick) return open(tool, PICKS[pick]);
        CMD[tool.getAttribute('data-cmd')]?.();
        sync();
      });

      // -------------------------------------------------------- typing in it

      flow.addEventListener('keydown', (event) => {
        const el = event.target.closest?.('[data-marble-rich]');
        if (!isText(el)) return;
        here = el;
        const mod = event.metaKey || event.ctrlKey;

        // Undo is this document's to handle in here. The shared `history` part
        // steps aside for any contenteditable that is not a data-marble-editable
        // — it assumes the browser owns undo there — and a rich block is exactly
        // that, so Ctrl+Z would otherwise reach the browser's own stack and
        // desync the page from the file. Close the burst, then reverse it.
        if (mod && !event.altKey && 'zy'.includes(event.key.toLowerCase())) {
          event.preventDefault();
          event.stopPropagation();
          commit();
          held = null;
          const forward = event.key.toLowerCase() === 'y' || event.shiftKey;
          if (forward) marble.redo();
          else marble.undo();
          return;
        }

        if (event.key === 'Enter' && !event.shiftKey && !mod) {
          event.preventDefault();
          return split(el);
        }

        // Read off event.code rather than event.key: Option rewrites the
        // character on a Mac, so Cmd+Option+1 arrives as "¡" and a document
        // that matched on the character would work on one platform only.
        if (mod && event.altKey) {
          const digit = /^Digit([0-3])$/.exec(event.code)?.[1];
          if (!digit) return;
          event.preventDefault();
          restyle(el, digit === '0' ? 'body' : 'h' + digit);
          return sync();
        }

        if (mod && !event.altKey) {
          const key = event.key.toLowerCase();
          if (event.shiftKey && (key === 'arrowup' || key === 'arrowdown')) {
            event.preventDefault();
            return shift(el, key === 'arrowup' ? -1 : 1);
          }
          if (event.shiftKey && key === 'c') {
            event.preventDefault();
            return detail();
          }
          if (event.shiftKey || !'biu\\'.includes(key)) return;
          event.preventDefault();
          if (key === '\\') clear();
          else markUp(key === 'b' ? 'bold' : key === 'i' ? 'italic' : 'underline');
          return sync();
        }

        if (event.key === 'Tab') {
          event.preventDefault();
          indent(event.shiftKey ? -1 : 1);
          return sync();
        }

        // Backspace at the very start peels one thing off at a time — the
        // indent, then the list, and only then the paragraph break itself.
        if (event.key === 'Backspace' && !loose() && caretAt(el) === 0) {
          event.preventDefault();
          if (Number(el.getAttribute('data-indent') ?? 0) > 0) {
            indent(-1);
            return sync();
          }
          if (el.hasAttribute('data-list')) {
            attr(el, 'data-list', null);
            return sync();
          }
          const above = el.previousElementSibling;
          if (!above) return;
          return isText(above) ? join(above, el) : drop(above);
        }

        if (event.key === 'Delete' && !loose() && caretAt(el) === marble.text(el).length) {
          const below = el.nextElementSibling;
          if (!below) return;
          event.preventDefault();
          return isText(below) ? join(el, below) : drop(below);
        }

        if (event.key === 'ArrowUp' || event.key === 'ArrowDown') {
          if (loose()) return;
          const up = event.key === 'ArrowUp';
          if (!onEdge(el, up)) return;
          let to = up ? el.previousElementSibling : el.nextElementSibling;
          while (to && !isText(to)) to = up ? to.previousElementSibling : to.nextElementSibling;
          if (!to) return;
          event.preventDefault();
          land(to, up, caretX());
        }
      }, true);

      // A caret leaving the top or bottom line of a paragraph leaves the
      // paragraph, which is the only thing that makes a stack of separately
      // editable blocks feel like one page of text.
      function onEdge(el, up) {
        const sel = getSelection();
        if (!sel || !sel.rangeCount) return true;
        const range = sel.getRangeAt(0).cloneRange();
        range.collapse(true);
        const box = el.getBoundingClientRect();
        const caret = range.getClientRects()[0] ?? box;
        const cs = getComputedStyle(el);
        const line = lineOf(el);
        return up
          ? caret.top - (box.top + parseFloat(cs.paddingTop)) < line * 0.6
          : box.bottom - parseFloat(cs.paddingBottom) - caret.bottom < line * 0.6;
      }

      function caretX() {
        const sel = getSelection();
        if (!sel || !sel.rangeCount) return page.getBoundingClientRect().left;
        const range = sel.getRangeAt(0).cloneRange();
        range.collapse(true);
        return range.getClientRects()[0]?.left ?? page.getBoundingClientRect().left;
      }

      // Landing in the next paragraph at the column you left, rather than at
      // its end, which is what every editor does and what nobody notices until
      // it stops happening.
      function land(el, up, x) {
        el.focus();
        const box = el.getBoundingClientRect();
        const line = lineOf(el);
        const y = up ? box.bottom - line / 2 : box.top + line / 2;
        let range = null;
        if (document.caretRangeFromPoint) range = document.caretRangeFromPoint(x, y);
        else if (document.caretPositionFromPoint) {
          const spot = document.caretPositionFromPoint(x, y);
          if (spot) {
            range = document.createRange();
            range.setStart(spot.offsetNode, spot.offset);
          }
        }
        if (range && el.contains(range.startContainer)) {
          range.collapse(true);
          const sel = getSelection();
          sel.removeAllRanges();
          sel.addRange(range);
          here = el;
        } else {
          place(el, up ? marble.text(el).length : 0);
        }
      }

      // The margin below the last paragraph is still the page, and clicking a
      // page puts you in its text.
      page.addEventListener('mousedown', (event) => {
        if (event.target !== page && event.target !== flow) return;
        const last = [...flow.children].reverse().find(isText);
        if (!last) return;
        event.preventDefault();
        place(last, marble.text(last).length);
      });

      // ----------------------------------------------------------- what is drawn
      //
      // None of this is in the file and none of it files anything. The outline
      // is the headings, the count is the words, and the toolbar is whatever
      // the caret is sitting in — three readings of the notes, redrawn from
      // them rather than kept beside them, which is why none can be wrong.

      const DEPTH = { h1: 'd1', h2: 'd2', h3: 'd3' };
      let counted = { words: 0, characters: 0 };

      function derive() {
        outline.textContent = '';
        for (const el of flow.children) {
          const depth = DEPTH[styleOf(el)];
          if (!depth || !isText(el)) continue;
          const item = document.createElement('li');
          item.className = depth;
          item.textContent = marble.text(el) || 'Heading';
          item.addEventListener('click', () => {
            el.scrollIntoView({ block: 'center', behavior: 'smooth' });
            place(el, marble.text(el).length);
            sync();
          });
          outline.append(item);
        }

        const text = [...flow.children].filter(isText).map((el) => marble.text(el)).join(' ').trim();
        counted = { words: text ? text.split(/\s+/).length : 0, characters: text.length };
        counter.textContent = counted.words === 1 ? '1 word' : counted.words + ' words';
      }

      let saying = null;
      function detail() {
        counter.textContent =
          counted.words + ' words · ' + counted.characters + ' characters · ' +
          [...flow.children].filter(isText).length + ' paragraphs';
        clearTimeout(saying);
        saying = setTimeout(derive, 6000);
      }

      function sync() {
        const el = target();
        const at = atCaret();
        const lit = (selector, on) => $(selector)?.classList.toggle('marble-on', Boolean(on));
        for (const name of ['bold', 'italic', 'underline', 'strike']) {
          lit('[data-cmd="' + name + '"]', state(name));
        }
        lit('[data-cmd="bullet"]', listOf(el) === 'bullet');
        lit('[data-cmd="number"]', listOf(el) === 'number');
        lit('[data-cmd="fonts"]', showing('data-fonts'));

        $('#now-style').textContent = styleNamed(styleOf(el)).name;
        $('#now-face').textContent = faceOf(at);
        $('#now-pt').textContent = String(ptOf(at));
        $('#now-fg').style.color = getComputedStyle(at ?? flow).color;

        const aligner = $('.aligner');
        for (const [value] of ALIGN) {
          aligner?.classList.toggle('marble-align-' + value, alignOf(el) === value);
        }
        $('[data-cmd="undo"]').disabled = !marble.canUndo;
        $('[data-cmd="redo"]').disabled = !marble.canRedo;
      }

      // Wired and redrawn now, and again over anything that arrives later — a
      // paragraph added here, an edit made in a text editor, another window's
      // undo. A block that came back from the file has to be made editable
      // again, which is what the carrier hands subtrees to a registration for.
      marble.register((root) => {
        wireRich(root);
        derive();
        sync();
      });

      flow.addEventListener('focusin', (event) => {
        const el = event.target.closest?.('[data-marble-rich]');
        if (isText(el)) {
          here = el;
          sync();
        }
      });
      flow.addEventListener('keyup', sync);
      flow.addEventListener('click', sync);
      document.addEventListener('selectionchange', () => {
        if (inBlock(target())) sync();
      });
      addEventListener('beforeunload', commit);
    };

    if (window.marble) begin(window.marble);
    else addEventListener('marble:ready', (event) => begin(event.detail), { once: true });
  })();
</script>

__SCRIPT__
</body>
</html>
