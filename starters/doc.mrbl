  <g id="i-number"><path d="M8 5h13v2H8zm0 6h13v2H8zm0 6h13v2H8z"/><text x="1" y="8.4" font-family="Menlo, monospace" font-size="6.6">1</text><text x="1" y="14.4" font-family="Menlo, monospace" font-size="6.6">2</text><text x="1" y="20.4" font-family="Menlo, monospace" font-size="6.6">3</text></g>
