<header class="bar" data-marble-id="__ID__">
  <span class="mark" data-marble-id="__ID__" aria-hidden="true">
    <svg class="ico" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-mark"/></svg>
  </span>
  <div class="head" data-marble-id="__ID__">
    <span class="docname" data-marble-id="__ID__" data-marble-editable>__TITLE__</span>
    <nav class="menus" data-marble-id="__ID__">
      <button class="menu" data-marble-id="__ID__" data-menu="file">File</button>
      <button class="menu" data-marble-id="__ID__" data-menu="edit">Edit</button>
      <button class="menu" data-marble-id="__ID__" data-menu="view">View</button>
      <button class="menu" data-marble-id="__ID__" data-menu="insert">Insert</button>
      <button class="menu" data-marble-id="__ID__" data-menu="format">Format</button>
      <button class="menu" data-marble-id="__ID__" data-menu="tools">Tools</button>
    </nav>
  </div>
</header>

<div class="tools" data-marble-id="__ID__">
  <button class="tool" data-marble-id="__ID__" data-cmd="undo" title="Undo (Ctrl+Z)" aria-label="Undo"><svg class="ico" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-undo"/></svg></button>
  <button class="tool" data-marble-id="__ID__" data-cmd="redo" title="Redo (Ctrl+Shift+Z)" aria-label="Redo"><svg class="ico" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-redo"/></svg></button>
  <i class="sep" data-marble-id="__ID__"></i>
  <button class="tool wide" data-marble-id="__ID__" data-pick="style" title="Paragraph style">
    <span class="now" id="now-style" data-marble-transient>Body</span>
    <svg class="caret" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-caret"/></svg>
  </button>
  <button class="tool wide" data-marble-id="__ID__" data-pick="face" title="Font of the selected text">
    <span class="now" id="now-face" data-marble-transient>System</span>
    <svg class="caret" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-caret"/></svg>
  </button>
  <span class="sizer" data-marble-id="__ID__">
    <button class="tool step" data-marble-id="__ID__" data-cmd="smaller" title="Smaller" aria-label="Smaller">&#8722;</button>
    <span class="pt" id="now-pt" data-marble-transient>10.5</span>
    <button class="tool step" data-marble-id="__ID__" data-cmd="bigger" title="Bigger" aria-label="Bigger">+</button>
  </span>
  <i class="sep" data-marble-id="__ID__"></i>
  <button class="tool" data-marble-id="__ID__" data-cmd="bold" title="Bold (Ctrl+B)"><span class="letter" data-marble-id="__ID__">B</span></button>
  <button class="tool" data-marble-id="__ID__" data-cmd="italic" title="Italic (Ctrl+I)"><span class="letter i" data-marble-id="__ID__">I</span></button>
  <button class="tool" data-marble-id="__ID__" data-cmd="underline" title="Underline (Ctrl+U)"><span class="letter u" data-marble-id="__ID__">U</span></button>
  <button class="tool" data-marble-id="__ID__" data-cmd="strike" title="Strikethrough"><span class="letter s" data-marble-id="__ID__">S</span></button>
  <button class="tool paint" data-marble-id="__ID__" data-pick="colour" title="Text colour">
    <span class="letter" data-marble-id="__ID__">A</span>
    <i class="swatch" id="now-fg" data-marble-transient></i>
  </button>
  <i class="sep" data-marble-id="__ID__"></i>
  <button class="tool aligner" data-marble-id="__ID__" data-pick="align" title="Align">
    <svg class="ico g-left" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-left"/></svg>
    <svg class="ico g-center" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-center"/></svg>
    <svg class="ico g-right" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-right"/></svg>
    <svg class="ico g-justify" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-justify"/></svg>
  </button>
  <button class="tool" data-marble-id="__ID__" data-cmd="bullet" title="Bulleted list"><svg class="ico" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-bullet"/></svg></button>
  <button class="tool" data-marble-id="__ID__" data-cmd="number" title="Numbered list"><svg class="ico" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-number"/></svg></button>
  <button class="tool" data-marble-id="__ID__" data-cmd="outdent" title="Less indent (Shift+Tab)"><svg class="ico" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-outdent"/></svg></button>
  <button class="tool" data-marble-id="__ID__" data-cmd="indent" title="More indent (Tab)"><svg class="ico" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-indent"/></svg></button>
  <button class="tool" data-marble-id="__ID__" data-cmd="clear" title="Clear formatting (Ctrl+\)"><svg class="ico" data-marble-id="__ID__" viewBox="0 0 24 24"><use href="#i-clear"/></svg></button>
  <i class="spring" data-marble-id="__ID__"></i>
  <button class="tool" data-marble-id="__ID__" data-cmd="fonts" title="Fonts"><span class="letter" data-marble-id="__ID__">Aa</span></button>
</div>

<div class="work" data-marble-id="__ID__">

  <aside class="outline" data-marble-transient>
    <h2>Outline</h2>
    <ol id="outline-list"></ol>
  </aside>

  <div class="scroll" data-marble-id="__ID__">
    <div class="pagebox" id="pagebox" data-marble-id="__ID__" style="--ml: 1in; --mr: 1in">

      <div class="ruler" data-marble-transient>
        <i class="gut l"></i>
        <i class="gut r"></i>
        <div class="field"></div>
        <i class="pin l" data-edge="ml" title="Left margin"></i>
        <i class="pin r" data-edge="mr" title="Right margin"></i>
      </div>

      <article class="page" id="page" data-marble-id="__ID__">
        <div class="flow" id="flow" data-marble-id="__ID__">
<h1 data-marble-id="__ID__" data-marble-rich>__TITLE__</h1>
<p class="subtitle" data-marble-id="__ID__" data-marble-rich>Notes that are also the file they are kept in</p>
<p data-marble-id="__ID__" data-marble-rich>There is no save button, because what you are reading is not a copy of these notes — it <i>is</i> the notes. Type into it and the bytes on disk change with you.</p>
<h2 data-marble-id="__ID__" data-marble-rich>Writing</h2>
<p data-marble-id="__ID__" data-marble-rich>The page is one field rather than a column of boxes, which is what makes it behave like a page. Drag across a heading and the paragraphs under it and the selection follows you; <b>Ctrl+A</b> takes the whole document rather than whichever paragraph you happen to be standing in. Enter starts a new one, splitting this one where the caret is, and Backspace at the beginning joins it to the one above.</p>
<p data-marble-id="__ID__" data-marble-rich>Select a few words and the toolbar acts on <b>exactly those words</b> — weight, slant, colour, face and size are written around the characters, so the file holds <i>this</i> and not a note about it. Select nothing and the same buttons act on the whole paragraph; select several and they act on all of them.</p>
<p data-marble-id="__ID__" data-marble-rich>Rest the pointer beside a paragraph and a bar appears in the margin. Drag it and the paragraph goes where you put it — several of them, if a selection is what you took hold of. Ctrl+Shift+Up or Down does the same without leaving the keyboard.</p>
<h3 data-marble-id="__ID__" data-marble-rich>Two kinds of property</h3>
<p data-marble-id="__ID__" data-marble-rich data-list="bullet">The paragraph's own — its style, its alignment, whether it is a list item, how far it is indented — is one attribute on the block, so each change is one edit.</p>
<p data-marble-id="__ID__" data-marble-rich data-list="bullet">The characters' own — <b>bold</b>, <i>italic</i>, <u>underline</u>, <s>struck through</s> — is inline markup, the way you would have written it by hand.</p>
<p data-marble-id="__ID__" data-marble-rich data-list="bullet">Undo takes back the last one either way, whoever made it: you, an agent, or another window.</p>
<h3 data-marble-id="__ID__" data-marble-rich>The page, and the faces</h3>
<p data-marble-id="__ID__" data-marble-rich>Drag either marker on the ruler and the margin moves, written into the file as an inch on the page itself. <b>Aa</b> at the right of the toolbar opens a card that sets the face this interface wears and the face these notes wear — two separate choices, both kept in the file, both there when you come back.</p>
<p data-marble-id="__ID__" data-marble-rich>The outline on the left and the word count below it are the only things here that are not in the file, because each is only ever a reading of it.</p>
        </div>
      </article>

    </div>
  </div>
</div>

<aside class="fonts" id="fonts" data-marble-id="__ID__">
  <header data-marble-id="__ID__">
    <h2 data-marble-id="__ID__" data-marble-editable>Fonts</h2>
    <button class="shut" data-marble-id="__ID__" data-cmd="fonts" title="Hide" aria-label="Hide">&times;</button>
  </header>
  <div class="two" data-marble-id="__ID__">
    <div class="col" data-marble-id="__ID__">
      <span class="lbl" data-marble-id="__ID__" data-marble-editable>Interface</span>
      <button data-marble-id="__ID__" data-set-ui="system">System</button>
      <button data-marble-id="__ID__" data-set-ui="grotesk">Helvetica Neue</button>
      <button data-marble-id="__ID__" data-set-ui="optima">Optima</button>
      <button data-marble-id="__ID__" data-set-ui="garamond">Cormorant</button>
      <button data-marble-id="__ID__" data-set-ui="charter">Charter</button>
      <button data-marble-id="__ID__" data-set-ui="mono">Mono</button>
    </div>
    <div class="col" data-marble-id="__ID__">
      <span class="lbl" data-marble-id="__ID__" data-marble-editable>Document</span>
      <button data-marble-id="__ID__" data-set-doc="system">System</button>
      <button data-marble-id="__ID__" data-set-doc="grotesk">Helvetica Neue</button>
      <button data-marble-id="__ID__" data-set-doc="optima">Optima</button>
      <button data-marble-id="__ID__" data-set-doc="garamond">Cormorant</button>
      <button data-marble-id="__ID__" data-set-doc="charter">Charter</button>
      <button data-marble-id="__ID__" data-set-doc="mono">Mono</button>
    </div>
  </div>
</aside>

<div class="popup" id="popup" data-marble-transient></div>
<div class="count" id="count" data-marble-transient></div>

<script>
  // The editor's own behaviour.
  //
  // The flow is ONE editing host, not a column of them. That is the whole
  // difference between a page of text and a stack of boxes: Select All takes
  // the document rather than the paragraph, a drag highlights across
  // paragraphs, Backspace at a seam joins two of them, and the caret walks from
  // one to the next because it never left the field it was in.
  //
  // What that costs is that the browser, not this file, decides what the markup
  // looks like after a keystroke — it will split a paragraph, merge two, and
  // paste a stylesheet if you let it. So nothing here trusts the DOM it gets
  // back. Every change, whether the browser made it or a command below did,
  // goes through the same three steps:
  //
  //   1. the page moves
  //   2. normalise() puts the flow back into this document's vocabulary —
  //      blocks it knows, one fresh id each, only the inline marks it can file
  //   3. file() reads the flow against `shadow`, the last thing written down,
  //      and the difference between the two *is* the ops
  //
  // So there is exactly one way a change reaches the file, and no command can
  // move the screen without writing itself down: they are not two halves that
  // have to agree, they are one step.
  //
  // The one affordance this document invents is data-marble-rich. The shared
  // `editable` is a setText affordance: it holds plain text and its whole
  // contents are replaced on every keystroke, which is right for a name in the
  // chrome and fatal to a <b> in the middle of a sentence. A rich block is
  // filed with setInner instead, so the inline markup survives, and it says so
  // in its own attribute rather than pretending to be the other thing.
  //
  // A derivation — the outline, the word count, the lit buttons on the toolbar
  // — reads the flow and files nothing at all, because none of it is a fact the
  // document keeps.
  (() => {
    const begin = (marble) => {
      const $ = (sel) => document.querySelector(sel);
      const flow = $('#flow');
      const page = $('#page');
      const pagebox = $('#pagebox');
      const popup = $('#popup');
      const counter = $('#count');
      const outline = $('#outline-list');
      const widget = $('#fonts');
      if (!flow) return;

      const ID = 'data-marble-id';
      const RICH = 'data-marble-rich';

      // All four belong to the page. An open menu is not a fact about the
      // notes, neither is a greyed-out undo button, and neither is the field
      // being typeable — the file is a document, not a session.
      marble.pageOnly('contenteditable', 'spellcheck', 'data-open', 'disabled');

      flow.setAttribute('contenteditable', 'true');
      flow.setAttribute('spellcheck', 'true');

      // ------------------------------------------------------------ the styles

      const STYLES = [
        { key: 'title', name: 'Title', tag: 'h1', cls: '' },
        { key: 'subtitle', name: 'Subtitle', tag: 'p', cls: 'subtitle' },
        { key: 'h1', name: 'Heading', tag: 'h2', cls: '' },
        { key: 'h2', name: 'Subheading', tag: 'h3', cls: '' },
        { key: 'h3', name: 'Label', tag: 'h4', cls: '' },
        { key: 'body', name: 'Body', tag: 'p', cls: '' },
      ];
      const styleNamed = (key) => STYLES.find((s) => s.key === key) ?? STYLES[5];

      function styleOf(el) {
        switch (el?.tagName) {
          case 'H1': return 'title';
          case 'H2': return 'h1';
          case 'H3': return 'h2';
          case 'H4': return 'h3';
          default: return el?.classList.contains('subtitle') ? 'subtitle' : 'body';
        }
      }

      const FACES = [
        ['system', 'System'], ['grotesk', 'Helvetica Neue'], ['optima', 'Optima'],
        ['garamond', 'Cormorant'], ['charter', 'Charter'], ['mono', 'Mono'],
      ];
      const ALIGN = [['left', 'Left'], ['center', 'Centre'], ['right', 'Right'], ['justify', 'Justify']];
      // The ink a word can be written in: the page's own three greys and its
      // accent, then danger and caution, then two the system does not name and
      // a page of notes still wants.
      const INKS = ['', '#111111', '#5a5a5a', '#8a8a8a', '#738698',
                    '#9bb6cf', '#b4533e', '#a07a2c', '#5f7a52', '#7a5f7e'];

      // --------------------------------------------------------- the blocks

      // The block vocabulary. A paragraph's style is its tag, so this list is
      // also the list of tags the file is allowed to hold at the top of the
      // flow; anything else the browser leaves there is turned into one.
      const BLOCKS = new Set(['P', 'H1', 'H2', 'H3', 'H4', 'HR']);

      const blocks = () => [...flow.children];
      const at = (el) => blocks().indexOf(el);
      const isText = (el) => Boolean(el) && el.parentElement === flow && el.hasAttribute(RICH);

      function blockOf(node) {
        let el = node?.nodeType === Node.TEXT_NODE ? node.parentElement : node;
        if (el === flow) return null;
        while (el && el.parentElement !== flow) el = el.parentElement;
        return isText(el) ? el : null;
      }

      // ------------------------------------------------- the inline vocabulary
      //
      // Everything the editor is allowed to put between the tags of a block. A
      // contenteditable will happily produce far more than this given a paste
      // or a stray shortcut, so what comes out is filtered down to this list on
      // the way into the file rather than trusted on the way out of the browser.

      const KEEP = new Set(['B', 'I', 'U', 'S', 'BR', 'SPAN']);
      const KEEP_STYLE = ['color', 'font-family', 'font-size'];

      function tidy(el) {
        let changed = false;
        for (const node of [...el.querySelectorAll('*')]) {
          if (!node.isConnected) continue;
          const tag = node.tagName;

          // The tags a browser writes for the ones this document uses.
          if (tag === 'STRONG' || tag === 'EM' || tag === 'STRIKE' || tag === 'DEL' || tag === 'FONT') {
            const want = tag === 'STRONG' ? 'b' : tag === 'EM' ? 'i' : tag === 'FONT' ? 'span' : 's';
            const swap = document.createElement(want);
            if (tag === 'FONT' && node.getAttribute('color')) swap.style.color = node.getAttribute('color');
            swap.append(...node.childNodes);
            node.replaceWith(swap);
            changed = true;
            continue;
          }

          if (!KEEP.has(tag)) {
            node.replaceWith(...node.childNodes);
            changed = true;
            continue;
          }

          // Wrapping a selection leaves the husk of whatever it was cut out
          // of. Empty marks are invisible on screen and noise in the diff.
          if (tag !== 'BR' && !node.textContent) {
            node.remove();
            changed = true;
            continue;
          }

          // A mark inside the same mark says nothing twice, and wrapping a run
          // that was already partly marked is the ordinary way to make one.
          if (tag !== 'BR' && tag !== 'SPAN' && node.parentElement?.closest(tag)) {
            node.replaceWith(...node.childNodes);
            changed = true;
            continue;
          }

          for (const name of [...node.getAttributeNames()]) {
            if (name === 'style' && tag === 'SPAN') continue;
            node.removeAttribute(name);
            changed = true;
          }

          if (tag !== 'SPAN') continue;
          for (const prop of [...node.style]) {
            if (KEEP_STYLE.includes(prop)) continue;
            node.style.removeProperty(prop);
            changed = true;
          }
          // A span carrying nothing is noise in the diff.
          if (!node.getAttribute('style')) {
            node.replaceWith(...node.childNodes);
            changed = true;
          }
        }
        if (changed) el.normalize();
        return changed;
      }

      // ---------------------------------------------------------- the caret
      //
      // Offsets are counted in characters from the start of a block, and a
      // block is counted by its place in the flow, so a mark survives both the
      // inline markup moving around underneath it and the block being replaced
      // by one with a different tag.

      const lineOf = (el) => {
        const cs = getComputedStyle(el);
        return parseFloat(cs.lineHeight) || parseFloat(cs.fontSize) * 1.3 || 16;
      };

      function spot(node, offset) {
        if (node === flow) {
          const el = flow.children[Math.min(offset, Math.max(0, flow.children.length - 1))];
          return el ? { at: at(el), offset: 0 } : null;
        }
        const el = blockOf(node);
        if (!el) return null;
        const before = document.createRange();
        before.selectNodeContents(el);
        try {
          before.setEnd(node, offset);
        } catch {
          return null;
        }
        return { at: at(el), offset: before.toString().length };
      }

      function markRange() {
        const sel = getSelection();
        if (!sel || !sel.rangeCount || !flow.contains(sel.anchorNode)) return null;
        const range = sel.getRangeAt(0);
        const a = spot(range.startContainer, range.startOffset);
        const b = sel.isCollapsed ? a : spot(range.endContainer, range.endOffset);
        return a && b ? { a, b } : null;
      }

      function point(el, offset) {
        const walk = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
        let seen = 0;
        let last = null;
        let node = null;
        while ((node = walk.nextNode())) {
          if (seen + node.length >= offset) return { node, offset: Math.max(0, offset - seen) };
          seen += node.length;
          last = node;
        }
        return last ? { node: last, offset: last.length } : { node: el, offset: 0 };
      }

      const blockAt = (index) => flow.children[Math.max(0, Math.min(index, flow.children.length - 1))] ?? null;

      function putRange(mark) {
        if (!mark) return;
        const head = blockAt(mark.a.at);
        const tail = blockAt(mark.b.at);
        if (!head || !tail) return;
        const a = point(head, mark.a.offset);
        const b = point(tail, mark.b.offset);
        const range = document.createRange();
        range.setStart(a.node, a.offset);
        try {
          range.setEnd(b.node, b.offset);
        } catch {
          range.collapse(true);
        }
        const sel = getSelection();
        sel.removeAllRanges();
        sel.addRange(range);
        flow.focus({ preventScroll: true });
      }

      const place = (el, offset) => {
        const index = at(el);
        if (index < 0) return;
        putRange({ a: { at: index, offset }, b: { at: index, offset } });
      };

      const selectAll = () => {
        const all = blocks();
        if (!all.length) return;
        const last = all[all.length - 1];
        putRange({ a: { at: 0, offset: 0 }, b: { at: all.length - 1, offset: marble.text(last).length } });
      };

      // The part of a range that lies inside one block, as a range of its own.
      function bite(el, range) {
        const part = range.cloneRange();
        const whole = document.createRange();
        whole.selectNodeContents(el);
        if (part.compareBoundaryPoints(Range.START_TO_START, whole) < 0) {
          part.setStart(whole.startContainer, whole.startOffset);
        }
        if (part.compareBoundaryPoints(Range.END_TO_END, whole) > 0) {
          part.setEnd(whole.endContainer, whole.endOffset);
        }
        return part;
      }

      function rangeIn(el, from, to) {
        const a = point(el, from);
        const b = point(el, to);
        const range = document.createRange();
        range.setStart(a.node, a.offset);
        try {
          range.setEnd(b.node, b.offset);
        } catch {
          range.setEnd(el, el.childNodes.length);
        }
        return range;
      }

      // The blocks a command is about: everything the selection touches, or the
      // one the caret sits in, or — with the focus somewhere else entirely —
      // the last one it was in.
      let here = null;

      function chosen() {
        const all = blocks().filter(isText);
        const fallback = () => (isText(here) && here.isConnected ? [here] : all.slice(0, 1));
        const sel = getSelection();
        if (!sel || !sel.rangeCount || !flow.contains(sel.anchorNode)) return fallback();
        const range = sel.getRangeAt(0);
        if (sel.isCollapsed) {
          const one = blockOf(range.startContainer);
          return one ? [one] : fallback();
        }
        let hit = all.filter((el) => range.intersectsNode(el));
        // A selection that stops at the very top of a block has not reached
        // into it, whatever intersectsNode says about the boundary.
        const empty = (el) => marble.text(el).length > 0 && bite(el, range).toString().length === 0;
        if (hit.length > 1 && empty(hit[0])) hit = hit.slice(1);
        if (hit.length > 1 && empty(hit[hit.length - 1])) hit = hit.slice(0, -1);
        return hit.length ? hit : fallback();
      }

      // What the caret is sitting in, which is what the toolbar reports.
      function atCaret() {
        const sel = getSelection();
        const node = sel?.anchorNode;
        const el = node?.nodeType === Node.TEXT_NODE ? node.parentElement : node;
        return el && flow.contains(el) && el !== flow ? el : chosen()[0];
      }

      function spread() {
        const el = chosen()[0];
        if (!el) return false;
        const sel = getSelection();
        if (sel && sel.rangeCount && !sel.isCollapsed && flow.contains(sel.anchorNode)) return true;
        const all = document.createRange();
        all.selectNodeContents(el);
        sel.removeAllRanges();
        sel.addRange(all);
        flow.focus({ preventScroll: true });
        return true;
      }

      // --------------------------------------------------------- making blocks

      // A new block is shaped from an existing one, so the paragraph's own
      // properties carry forward the way they do in any editor.
      function shape(from, key, inner) {
        const style = styleNamed(key);
        const el = document.createElement(style.tag);
        if (from) for (const a of marble.clone(from).attributes) el.setAttribute(a.name, a.value);
        el.removeAttribute('class');
        if (!el.getAttribute('style')?.trim()) el.removeAttribute('style');
        if (style.cls) el.setAttribute('class', style.cls);
        el.setAttribute(RICH, '');
        el.setAttribute(ID, marble.newId());
        el.innerHTML = '';
        if (typeof inner === 'string') el.innerHTML = inner;
        else if (inner) el.append(inner);
        tidy(el);
        return el;
      }

      // ------------------------------------------------------------- normalise
      //
      // The browser's idea of what it just did, turned back into this
      // document's. Everything it can leave behind is answered here rather than
      // guarded against upstream, because there is no upstream: a paste, a
      // drag, a native Enter and an autocorrect all arrive as "the DOM is
      // different now".

      function normalise() {
        let changed = false;
        let loose = [];

        const gather = () => {
          if (!loose.length) return;
          const p = document.createElement('p');
          p.setAttribute(RICH, '');
          p.setAttribute(ID, marble.newId());
          loose[0].replaceWith(p);
          p.append(...loose);
          loose = [];
          changed = true;
        };

        for (const node of [...flow.childNodes]) {
          if (node.nodeType === Node.ELEMENT_NODE && BLOCKS.has(node.tagName)) {
            gather();
            continue;
          }
          // A block the vocabulary does not have — a <div> from a paste, a
          // <blockquote> from a drag — keeps its words and loses its tag.
          if (node.nodeType === Node.ELEMENT_NODE && getComputedStyle(node).display !== 'inline') {
            gather();
            const p = document.createElement('p');
            p.setAttribute(RICH, '');
            p.setAttribute(ID, marble.newId());
            p.append(...node.childNodes);
            node.replaceWith(p);
            changed = true;
            continue;
          }
          if (node.nodeType === Node.TEXT_NODE && !node.nodeValue.trim() && !loose.length) {
            node.remove();
            changed = true;
            continue;
          }
          loose.push(node);
        }
        gather();

        const seen = new Set();
        for (const el of blocks()) {
          if (el.tagName !== 'HR' && !el.hasAttribute(RICH)) {
            el.setAttribute(RICH, '');
            changed = true;
          }
          let id = marble.id(el);
          const was = filed.get(id);
          // A split paragraph is the same element twice, tag and id and all,
          // so the second one to appear is the new one and takes a new name.
          if (!id || seen.has(id) || (was && was.tag !== el.tagName)) {
            id = marble.newId();
            el.setAttribute(ID, id);
            changed = true;
          }
          seen.add(id);
          if (el.tagName !== 'HR' && tidy(el)) changed = true;
        }

        if (!blocks().length) {
          const p = document.createElement('p');
          p.setAttribute(RICH, '');
          p.setAttribute(ID, marble.newId());
          flow.append(p);
          changed = true;
        }
        return changed;
      }

      const tidyUp = () => {
        const mark = markRange();
        if (normalise()) putRange(mark);
      };

      // --------------------------------------------------------- writing it down
      //
      // `shadow` is what the file says the flow is, as of the last op filed.
      // Reading the flow against it is the only place an op about the text is
      // ever made, so a command's whole job is to leave the page right.

      let shadow = [];
      let filed = new Map();

      function readFlow() {
        const next = blocks().map((el) => ({
          id: marble.id(el),
          tag: el.tagName,
          outer: marble.source.outer(el),
        }));
        filed = new Map(next.map((b) => [b.id, b]));
        return next;
      }

      const parse = (html) => {
        const slot = document.createElement('template');
        slot.innerHTML = html;
        return slot.content.firstElementChild;
      };

      function changesTo(was, now) {
        const ops = [];
        const a = parse(was.outer);
        const b = parse(now.outer);
        if (!a || !b) return ops;
        const names = new Set([...a.getAttributeNames(), ...b.getAttributeNames()]);
        for (const name of names) {
          if (name === ID) continue;
          const value = b.getAttribute(name);
          if (a.getAttribute(name) === value) continue;
          ops.push({ type: 'setAttr', id: now.id, name, value });
        }
        if (a.innerHTML !== b.innerHTML) ops.push({ type: 'setInner', id: now.id, html: b.innerHTML });
        return ops;
      }

      // The longest run of blocks that are already in the right order relative
      // to one another. Everything outside it is what actually moved, which is
      // the difference between "you dragged one paragraph up" and "every
      // paragraph below it also changed place".
      function settled(places) {
        const ends = [];
        const back = new Array(places.length).fill(-1);
        for (let i = 0; i < places.length; i++) {
          if (places[i] < 0) continue;
          let lo = 0;
          let hi = ends.length;
          while (lo < hi) {
            const mid = (lo + hi) >> 1;
            if (places[ends[mid]] < places[i]) lo = mid + 1;
            else hi = mid;
          }
          back[i] = lo > 0 ? ends[lo - 1] : -1;
          ends[lo] = i;
        }
        const run = [];
        let at = ends.length ? ends[ends.length - 1] : -1;
        while (at >= 0) {
          run.push(at);
          at = back[at];
        }
        return new Set(run);
      }

      // The ops that carry one list of blocks to the other. Walked from the
      // end, so every insert and every move can name the block that is already
      // in its right place behind it.
      function diff(prev, next) {
        const parentId = marble.id(flow);
        const was = new Map(prev.map((b) => [b.id, b]));
        const now = new Set(next.map((b) => b.id));
        const order = prev.filter((b) => now.has(b.id)).map((b) => b.id);
        const places = next.map((b) => order.indexOf(b.id));
        const stays = settled(places);
        const ops = [];

        for (const b of prev) if (!now.has(b.id)) ops.push({ type: 'remove', id: b.id });

        for (let i = next.length - 1; i >= 0; i--) {
          const b = next[i];
          const after = i + 1 < next.length ? next[i + 1].id : null;
          if (places[i] < 0) {
            ops.push({ type: 'insert', html: b.outer, parentId, beforeId: after });
            continue;
          }
          const older = was.get(b.id);
          if (older.outer !== b.outer) ops.push(...changesTo(older, b));
          if (!stays.has(i)) ops.push({ type: 'move', id: b.id, parentId, beforeId: after });
        }
        return ops;
      }

      // Typing files an op immediately, so the file is never behind the screen.
      // Undo is coarser than that on purpose: one step per burst of typing
      // rather than one per character. The burst opens on the first keystroke
      // and closes when typing stops, when focus leaves, before any other
      // command, and before Ctrl+Z — so there is never one in flight that undo
      // does not know about.
      let base = null;
      let idle = null;

      function settle() {
        clearTimeout(idle);
        const from = base;
        base = null;
        if (!from) return;
        const redo = diff(from, shadow);
        const undo = diff(shadow, from);
        if (redo.length && undo.length) marble.record({ redo, undo });
        marble.flush();
      }

      function file(burst) {
        const from = shadow;
        const next = readFlow();
        const ops = diff(from, next);
        if (!ops.length) return;
        shadow = next;
        for (const op of ops) marble.op(op, { immediate: !burst });
        if (burst) {
          base = base ?? from;
          clearTimeout(idle);
          idle = setTimeout(settle, 700);
        } else {
          const undo = diff(next, from);
          if (undo.length) marble.record({ redo: ops, undo });
        }
        derive();
      }

      // A change made on purpose rather than one the browser made because a key
      // was pressed: the burst is closed first, so it is its own step of undo.
      function change(run) {
        settle();
        const mark = run();
        tidyUp();
        file(false);
        if (mark) putRange(mark);
        sync();
      }

      // An attribute on something that is not in the flow — the page, the font
      // card, the body. Those are single facts, not text, and they are filed
      // one at a time.
      function attr(el, name, value) {
        const id = el && marble.id(el);
        if (!id) return;
        const was = el.getAttribute(name);
        if (was === value) return;
        if (value === null) el.removeAttribute(name);
        else el.setAttribute(name, value);
        const op = { type: 'setAttr', id, name, value };
        marble.record({ redo: [op], undo: [{ type: 'setAttr', id, name, value: was }] });
        marble.op(op, { immediate: true });
      }

      // An empty style attribute is not a fact, it is a leftover — a devtools
      // session, an extension or a screenshot tool touching el.style is enough
      // to leave one behind. The carrier drops an empty class for the same
      // reason; this is that rule for the other attribute where blank means
      // absent, applied on the way into the file rather than out of it.
      const styleOn = (el) => el?.getAttribute('style')?.trim() || null;

      // The style attribute carries more than one custom property, so it is
      // composed rather than appended to, and a property set to null leaves.
      function withVar(style, name, value) {
        const kept = (style ?? '')
          .split(';')
          .map((bit) => bit.trim())
          .filter((bit) => bit && bit.slice(0, bit.indexOf(':')).trim() !== name);
        if (value !== null) kept.push(name + ': ' + value);
        return kept.length ? kept.join('; ') : null;
      }

      // ------------------------------------------------------- block commands

      const restyle = (key) =>
        change(() => {
          const mark = markRange();
          for (const el of chosen()) {
            if (styleOf(el) === key) continue;
            el.replaceWith(shape(el, key, marble.source.inner(el)));
          }
          return mark;
        });

      const alignOf = (el) => el?.getAttribute('data-align') ?? 'left';
      const listOf = (el) => el?.getAttribute('data-list') ?? null;

      const setOn = (name, value) =>
        change(() => {
          const mark = markRange();
          for (const el of chosen()) {
            if (value === null) el.removeAttribute(name);
            else el.setAttribute(name, value);
          }
          return mark;
        });

      const listAs = (kind) => setOn('data-list', listOf(chosen()[0]) === kind ? null : kind);
      const alignAs = (value) => setOn('data-align', value === 'left' ? null : value);

      const indent = (dir) =>
        change(() => {
          const mark = markRange();
          for (const el of chosen()) {
            const now = Number(el.getAttribute('data-indent') ?? 0);
            const next = Math.max(0, Math.min(5, now + dir));
            if (next) el.setAttribute('data-indent', String(next));
            else el.removeAttribute('data-indent');
          }
          return mark;
        });

      // Enter. The paragraph is cut at the caret and everything after it —
      // markup included — becomes the next one.
      function split() {
        const sel = getSelection();
        if (!sel || !sel.rangeCount || !flow.contains(sel.anchorNode)) return;
        if (!sel.isCollapsed) document.execCommand('delete');
        const range = getSelection().getRangeAt(0);
        const el = blockOf(range.startContainer);
        if (!el) return;

        // Nothing in it and it is a list item: Enter leaves the list rather
        // than making another empty one.
        if (!marble.text(el) && el.hasAttribute('data-list')) return setOn('data-list', null);

        settle();
        const tail = range.cloneRange();
        tail.setEnd(el, el.childNodes.length);
        const made = shape(el, 'body', tail.extractContents());
        el.after(made);
        tidyUp();
        file(false);
        place(made, 0);
        sync();
      }

      const follow = (made) =>
        change(() => {
          const all = chosen();
          const last = all[all.length - 1];
          if (last) last.after(made);
          else flow.append(made);
          return null;
        });

      const drop = (els) =>
        change(() => {
          for (const el of els) el.remove();
          return null;
        });

      function shift(dir) {
        const all = chosen();
        if (!all.length) return;
        const edge = dir < 0 ? all[0].previousElementSibling : all[all.length - 1].nextElementSibling;
        if (!edge) return;
        change(() => {
          const mark = markRange();
          if (dir < 0) for (const el of all) edge.before(el);
          else for (const el of [...all].reverse()) edge.after(el);
          return mark && {
            a: { at: mark.a.at + dir, offset: mark.a.offset },
            b: { at: mark.b.at + dir, offset: mark.b.offset },
          };
        });
      }

      // ------------------------------------------------ character commands
      //
      // These act on what is selected, which is the whole point of them, and
      // the selection is free to run across paragraphs now. With nothing
      // selected there is no pending-format machine to consult, so the
      // paragraph is selected instead — the reading of "bold" that needs no
      // hidden state to explain it.

      // execCommand is the only thing in any browser that knows how to *take* a
      // tag off a partial selection, splitting and merging the runs on both
      // edges. It is legacy and it has no replacement, so it is kept for that —
      // and for nothing else, least of all for deciding which way a toggle goes.
      const MARK = { bold: 'bold', italic: 'italic', underline: 'underline', strike: 'strikeThrough' };
      const TAG = { bold: 'b', italic: 'i', underline: 'u', strike: 's' };

      // Whether what is selected is already marked, asked of the markup the
      // file holds rather than of the weight on the screen. A heading is heavy
      // because it is a heading; queryCommandState cannot tell that from
      // somebody having pressed Bold, so it answered "already bold" for every
      // heading — and pressing Bold on one took a mark off text that never had
      // it. Nothing here reads the computed style, because the file is the
      // only place the answer lives.
      function marked(name, els) {
        const tag = TAG[name];
        const sel = getSelection();
        if (!sel || !sel.rangeCount || !flow.contains(sel.anchorNode)) return false;
        const range = sel.isCollapsed ? null : sel.getRangeAt(0);
        let any = false;
        for (const el of els ?? chosen()) {
          const walk = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
          let node = null;
          while ((node = walk.nextNode())) {
            if (!node.nodeValue.trim()) continue;
            if (range && !range.intersectsNode(node)) continue;
            any = true;
            if (!node.parentElement?.closest(tag)) return false;
          }
        }
        return any;
      }

      // The runs of text the selection covers, block by block, counted in
      // characters — measured before anything is cut, because cutting the first
      // block invalidates a range held across the rest.
      function runs() {
        const sel = getSelection();
        if (!sel || !sel.rangeCount || !flow.contains(sel.anchorNode)) return [];
        const range = sel.getRangeAt(0);
        return chosen()
          .map((el) => {
            const part = bite(el, range);
            const lead = document.createRange();
            lead.selectNodeContents(el);
            lead.setEnd(part.startContainer, part.startOffset);
            const from = lead.toString().length;
            return { el, from, to: from + part.toString().length };
          })
          .filter((run) => run.to > run.from);
      }

      const markUp = (name) =>
        change(() => {
          if (!spread()) return null;
          const mark = markRange();
          if (marked(name)) {
            document.execCommand('styleWithCSS', false, false);
            document.execCommand(MARK[name], false, null);
          } else {
            // Putting a mark on is the half a document can do for itself, and
            // the half that has to be right: it writes the tag this file uses,
            // around exactly the characters that were selected.
            for (const { el, from, to } of runs()) {
              const range = rangeIn(el, from, to);
              const held = document.createElement(TAG[name]);
              held.append(range.extractContents());
              range.insertNode(held);
            }
          }
          return mark;
        });

      // Colour, face and size have no toggling command worth the name, so the
      // selection is wrapped by hand, one block at a time, and tidy() merges
      // what it can.
      const dressUp = (prop, value) =>
        change(() => {
          if (!spread()) return null;
          const mark = markRange();
          for (const { el, from, to } of runs()) dress(el, rangeIn(el, from, to), prop, value);
          return mark;
        });

      function dress(el, range, prop, value) {
        // Dressing the very same words twice should not stack wrappers. If the
        // range is exactly what one span already holds, the declaration joins
        // that span — colour and face on one run of text are one span with two
        // declarations, not one span inside another.
        //
        // Found by comparing the text rather than by climbing from the range's
        // boundaries: a browser is free to express "all of this span" either as
        // the node itself or as the text inside it, and both spellings have to
        // land here.
        const host = [...el.querySelectorAll('span')].find(
          (span) => range.intersectsNode(span) && range.toString() === span.textContent,
        );
        if (host) {
          if (value) host.style.setProperty(prop, value);
          else host.style.removeProperty(prop);
          return;
        }

        // Otherwise take the property off whatever already carries it inside
        // the range, so the new value is the only one there.
        for (const span of [...el.querySelectorAll('span')]) {
          if (range.intersectsNode(span)) span.style.removeProperty(prop);
        }
        if (!value) return;
        const span = document.createElement('span');
        span.style.setProperty(prop, value);
        span.append(range.extractContents());
        range.insertNode(span);
      }

      const faceOf = (el) => {
        const now = getComputedStyle(el ?? flow).fontFamily;
        const first = now.split(',')[0].replace(/["']/g, '').trim().toLowerCase();
        return FACES.find(([key]) =>
          getComputedStyle(document.body).getPropertyValue('--f-' + key)
            .split(',')[0].replace(/["']/g, '').trim().toLowerCase() === first)?.[1] ?? first;
      };

      const ptOf = (el) => Math.round(parseFloat(getComputedStyle(el ?? flow).fontSize) * 0.75 * 2) / 2;

      const resize = (dir) => {
        const now = ptOf(atCaret());
        dressUp('font-size', Math.max(6, Math.min(96, now + dir)) + 'pt');
      };

      // Clear formatting is every inline mark in the selection and every
      // property the paragraphs themselves carry, gone in one gesture and so in
      // one step of undo.
      const clear = () =>
        change(() => {
          const mark = markRange();
          for (const el of chosen()) {
            const text = marble.text(el);
            for (const name of ['data-align', 'data-indent', 'data-list', 'style']) el.removeAttribute(name);
            el.textContent = text;
            if (styleOf(el) !== 'body') el.replaceWith(shape(el, 'body', document.createTextNode(text)));
          }
          return mark;
        });

      // ----------------------------------------------------------- the clipboard
      //
      // A contenteditable will take whole documents if you let it. Plain text
      // is what a note wants anyway, and it is the only paste that cannot put
      // something in the file that nothing here can edit — but plain text has
      // paragraphs in it, and they arrive as paragraphs.
      function pasteText(text) {
        const lines = text.replace(/\r\n?/g, '\n').split('\n');
        const sel = getSelection();
        if (!sel || !sel.rangeCount || !flow.contains(sel.anchorNode)) return;
        if (!sel.isCollapsed) document.execCommand('delete');
        if (lines.length === 1) {
          document.execCommand('insertText', false, lines[0]);
          return;
        }

        settle();
        const range = getSelection().getRangeAt(0);
        const el = blockOf(range.startContainer);
        if (!el) return;
        const tail = range.cloneRange();
        tail.setEnd(el, el.childNodes.length);
        const rest = shape(el, 'body', tail.extractContents());
        range.insertNode(document.createTextNode(lines[0]));

        let after = el;
        for (const line of lines.slice(1, -1)) {
          const made = shape(el, 'body', document.createTextNode(line));
          after.after(made);
          after = made;
        }
        const ending = lines[lines.length - 1];
        rest.prepend(document.createTextNode(ending));
        after.after(rest);

        tidyUp();
        file(false);
        place(rest, ending.length);
        sync();
      }

      // ------------------------------------------------------- the page margins

      function margins(left, right) {
        const was = pagebox.getAttribute('style');
        const value = withVar(withVar(was, '--ml', left + 'in'), '--mr', right + 'in');
        const id = marble.id(pagebox);
        pagebox.setAttribute('style', value);
        const op = { type: 'setAttr', id, name: 'style', value };
        marble.record({ redo: [op], undo: [{ type: 'setAttr', id, name: 'style', value: was }] });
        marble.op(op, { immediate: true });
      }

      const inchesOf = (name) => parseFloat(pagebox.style.getPropertyValue(name)) || 1;

      function pageSetup() {
        const said = prompt('Left and right margin, in inches', String(inchesOf('--ml')));
        if (said === null) return;
        const inches = Math.max(0.25, Math.min(3.5, parseFloat(said) || 1));
        margins(inches, inches);
      }

      // One gesture, one op: the file hears about a drag on release, not a
      // hundred times on the way there.
      function draggable(handle, moved, settled) {
        handle.addEventListener('pointerdown', (event) => {
          if (event.button) return;
          event.preventDefault();
          handle.classList.add('marble-dragging');
          let live = false;
          const move = (event) => {
            live = true;
            moved(event);
          };
          const up = () => {
            removeEventListener('pointermove', move);
            handle.classList.remove('marble-dragging');
            settled(live);
          };
          addEventListener('pointermove', move);
          addEventListener('pointerup', up, { once: true });
          addEventListener('pointercancel', up, { once: true });
        });
      }

      for (const pin of document.querySelectorAll('.ruler .pin')) {
        const edge = pin.getAttribute('data-edge');
        let was = null;
        let to = null;
        draggable(
          pin,
          (event) => {
            if (was === null) was = pagebox.getAttribute('style');
            const box = page.getBoundingClientRect();
            const dpi = box.width / 8.5;
            const raw = edge === 'ml' ? (event.clientX - box.left) / dpi : (box.right - event.clientX) / dpi;
            // An eighth of an inch is where the ruler's own ticks are. Shift is
            // the way off the ticks, for the margin that has to sit between two.
            const step = event.shiftKey ? Math.round(raw * 100) / 100 : Math.round(raw * 8) / 8;
            to = Math.max(0.25, Math.min(3.5, step));
            pagebox.style.setProperty('--' + edge, to + 'in');
          },
          (live) => {
            if (!live || to === null) return;
            const value = withVar(was, '--' + edge, to + 'in');
            const id = marble.id(pagebox);
            pagebox.setAttribute('style', value);
            const op = { type: 'setAttr', id, name: 'style', value };
            marble.record({ redo: [op], undo: [{ type: 'setAttr', id, name: 'style', value: was }] });
            marble.op(op, { immediate: true });
            was = null;
            to = null;
          },
        );
      }

      // The widget is furniture you can put where you like, and where you put
      // it is an inline style on it — one attribute, filed once, on release.
      {
        const handle = widget.querySelector('header');
        let was = null;
        let from = null;
        let to = null;
        draggable(
          handle,
          (event) => {
            const box = widget.getBoundingClientRect();
            if (was === null) {
              was = widget.getAttribute('style');
              from = { x: event.clientX - box.left, y: event.clientY - box.top };
            }
            to = {
              x: Math.max(4, Math.min(innerWidth - box.width - 4, event.clientX - from.x)),
              y: Math.max(4, Math.min(innerHeight - box.height - 4, event.clientY - from.y)),
            };
            // Pinning left/top means letting go of right/bottom, or the card
            // would be told to be in two places at once.
            widget.style.setProperty('--fx', to.x + 'px');
            widget.style.setProperty('--fy', to.y + 'px');
            widget.style.setProperty('--fr', 'auto');
            widget.style.setProperty('--fb', 'auto');
          },
          (live) => {
            if (!live || !to) return;
            let value = withVar(was, '--fx', to.x + 'px');
            value = withVar(value, '--fy', to.y + 'px');
            value = withVar(value, '--fr', 'auto');
            value = withVar(value, '--fb', 'auto');
            const id = marble.id(widget);
            widget.setAttribute('style', value);
            const op = { type: 'setAttr', id, name: 'style', value };
            marble.record({ redo: [op], undo: [{ type: 'setAttr', id, name: 'style', value: was }] });
            marble.op(op, { immediate: true });
            was = null;
            to = null;
          },
        );
      }

      // ---------------------------------------------------- picking blocks up
      //
      // A paragraph is a thing you can take hold of. The handle and the seam it
      // draws belong to the page — there is one of each, moved to whichever
      // block the pointer is beside — so the file gains nothing from this but
      // the move itself, filed once, on release.

      const grip = document.createElement('button');
      grip.type = 'button';
      grip.className = 'grip';
      grip.setAttribute('data-marble-transient', '');
      grip.setAttribute('aria-label', 'Move this paragraph');
      grip.title = 'Drag to move · click to select';

      const seam = document.createElement('i');
      seam.className = 'seam';
      seam.setAttribute('data-marble-transient', '');
      page.append(grip, seam);

      let beside = null;
      let carried = [];

      function gripTo(el) {
        beside = el;
        if (!el) return grip.removeAttribute('data-on');
        grip.setAttribute('data-on', '1');
        grip.style.top = el.offsetTop + 'px';
        grip.style.left = el.offsetLeft + 'px';
        grip.style.height = el.offsetHeight + 'px';
      }

      const dropBefore = (y) =>
        blocks()
          .filter((el) => !carried.includes(el))
          .find((el) => {
            const box = el.getBoundingClientRect();
            return y < box.top + box.height / 2;
          }) ?? null;

      function drawSeam(before) {
        const box = page.getBoundingClientRect();
        const last = blocks().filter((el) => !carried.includes(el)).pop();
        const edge = before ?? last;
        if (!edge) return seam.removeAttribute('data-on');
        const rect = edge.getBoundingClientRect();
        seam.setAttribute('data-on', '1');
        seam.style.top = (before ? rect.top : rect.bottom) - box.top + 'px';
        seam.style.left = edge.offsetLeft + 'px';
        seam.style.width = edge.offsetWidth + 'px';
      }

      grip.addEventListener('pointerdown', () => {
        const all = chosen();
        carried = beside ? (all.length > 1 && all.includes(beside) ? all : [beside]) : [];
      });

      let landing = null;
      draggable(
        grip,
        (event) => {
          if (!carried.length) return;
          landing = dropBefore(event.clientY);
          drawSeam(landing);
        },
        (live) => {
          seam.removeAttribute('data-on');
          if (!live) {
            if (beside) {
              const range = document.createRange();
              range.selectNodeContents(beside);
              const sel = getSelection();
              sel.removeAllRanges();
              sel.addRange(range);
              flow.focus({ preventScroll: true });
              sync();
            }
            carried = [];
            return;
          }
          const moving = carried;
          const before = landing;
          carried = [];
          landing = null;
          if (!moving.length) return;
          change(() => {
            for (const el of moving) {
              if (before) before.before(el);
              else flow.append(el);
            }
            return null;
          });
          gripTo(moving[0]);
        },
      );

      $('.scroll').addEventListener('pointermove', (event) => {
        if (grip.classList.contains('marble-dragging')) return;
        if (grip.contains(event.target)) return;
        gripTo(blocks().find((el) => {
          const box = el.getBoundingClientRect();
          return event.clientY >= box.top && event.clientY <= box.bottom;
        }) ?? null);
      });
      $('.scroll').addEventListener('pointerleave', () => {
        if (!grip.classList.contains('marble-dragging')) gripTo(null);
      });

      // ---------------------------------------------------- menus and pickers

      let opened = null;

      function shut() {
        popup.removeAttribute('data-open');
        popup.textContent = '';
        opened?.removeAttribute('data-open');
        opened = null;
      }

      function row(label, run, { hint, on, off } = {}) {
        const button = document.createElement('button');
        button.type = 'button';
        button.append(label);
        if (hint) {
          const span = document.createElement('span');
          span.className = 'hint';
          span.textContent = hint;
          button.append(span);
        }
        if (on) button.setAttribute('data-on', '1');
        if (off) button.disabled = true;
        button.addEventListener('click', () => {
          shut();
          run();
          sync();
        });
        popup.append(button);
      }

      function open(anchor, build) {
        const same = opened === anchor;
        shut();
        if (same) return;
        build(row);
        opened = anchor;
        anchor.setAttribute('data-open', '1');
        popup.setAttribute('data-open', '1');
        const box = anchor.getBoundingClientRect();
        popup.style.left = Math.max(4, Math.min(box.left, innerWidth - popup.offsetWidth - 8)) + 'px';
        popup.style.top = Math.min(box.bottom + 4, innerHeight - popup.offsetHeight - 8) + 'px';
      }

      const showing = (name) => document.body.getAttribute(name) !== 'off';
      const flip = (name) => attr(document.body, name, showing(name) ? 'off' : 'on');

      const back = async (forward) => {
        settle();
        await (forward ? marble.redo() : marble.undo());
        shadow = readFlow();
        derive();
        sync();
      };

      const MENUS = {
        file: (add) => {
          add('Page setup…', pageSetup);
          add('Print', () => print(), { hint: 'Ctrl+P' });
          add('Rename', () => {
            const name = $('.docname');
            name.focus();
            getSelection().selectAllChildren(name);
          });
        },
        edit: (add) => {
          add('Undo', () => back(false), { hint: 'Ctrl+Z', off: !marble.canUndo });
          add('Redo', () => back(true), { hint: 'Ctrl+Shift+Z', off: !marble.canRedo });
          add('Select all', selectAll, { hint: 'Ctrl+A' });
          add('Move up', () => shift(-1), { hint: 'Ctrl+Shift+↑' });
          add('Move down', () => shift(1), { hint: 'Ctrl+Shift+↓' });
          add('Delete paragraph', () => {
            const all = chosen();
            const to = all[0].previousElementSibling ?? all[all.length - 1].nextElementSibling;
            if (!to) return;
            drop(all);
            here = null;
            if (isText(to)) place(to, marble.text(to).length);
          }, { off: blocks().filter(isText).length < 2 });
        },
        view: (add) => {
          add('Outline', () => flip('data-outline'), { on: showing('data-outline') });
          add('Ruler', () => flip('data-ruler'), { on: showing('data-ruler') });
          add('Fonts', () => flip('data-fonts'), { on: showing('data-fonts') });
        },
        insert: (add) => {
          for (const key of ['h1', 'h2', 'h3']) {
            add(styleNamed(key).name, () => {
              const made = shape(chosen()[0], key, '');
              follow(made);
              place(made, 0);
            });
          }
          add('Bulleted list', () => listAs('bullet'), { on: listOf(chosen()[0]) === 'bullet' });
          add('Numbered list', () => listAs('number'), { on: listOf(chosen()[0]) === 'number' });
          add('Horizontal line', () => {
            const rule = document.createElement('hr');
            rule.setAttribute(ID, marble.newId());
            follow(rule);
          });
        },
        format: (add) => {
          add('Bold', () => markUp('bold'), { hint: 'Ctrl+B', on: marked('bold') });
          add('Italic', () => markUp('italic'), { hint: 'Ctrl+I', on: marked('italic') });
          add('Underline', () => markUp('underline'), { hint: 'Ctrl+U', on: marked('underline') });
          add('Strikethrough', () => markUp('strike'), { on: marked('strike') });
          for (const [value, name] of ALIGN) {
            add('Align ' + name.toLowerCase(), () => alignAs(value), { on: alignOf(chosen()[0]) === value });
          }
          add('Clear formatting', clear, { hint: 'Ctrl+\\' });
        },
        tools: (add) => {
          add('Word count', () => detail(), { hint: 'Ctrl+Shift+C' });
        },
      };

      const PICKS = {
        style: (add) => {
          for (const style of STYLES) {
            add(style.name, () => restyle(style.key), { on: styleOf(chosen()[0]) === style.key });
          }
        },
        face: (add) => {
          const now = faceOf(atCaret());
          for (const [key, name] of FACES) {
            add(name, () => dressUp('font-family', 'var(--f-' + key + ')'), { on: name === now });
          }
          add('Match the document', () => dressUp('font-family', ''));
        },
        align: (add) => {
          for (const [value, name] of ALIGN) {
            add(name, () => alignAs(value), { on: alignOf(chosen()[0]) === value });
          }
        },
        colour: () => {
          const grid = document.createElement('div');
          grid.className = 'swatches';
          const now = getComputedStyle(atCaret() ?? flow).color;
          for (const ink of INKS) {
            const chip = document.createElement('i');
            chip.title = ink || 'Default';
            chip.style.background = ink ||
              'linear-gradient(135deg, transparent 45%, currentColor 45% 55%, transparent 55%)';
            if (ink && paint(ink) === now) chip.setAttribute('data-on', '1');
            chip.addEventListener('click', () => {
              shut();
              dressUp('color', ink);
            });
            grid.append(chip);
          }
          popup.append(grid);
        },
      };

      // getComputedStyle answers in rgb(), so a hex has to be put through the
      // same mill before the two can be compared.
      const paint = (hex) => {
        const probe = document.createElement('span');
        probe.style.color = hex;
        document.body.append(probe);
        const said = getComputedStyle(probe).color;
        probe.remove();
        return said;
      };

      const CMD = {
        undo: () => back(false),
        redo: () => back(true),
        bold: () => markUp('bold'),
        italic: () => markUp('italic'),
        underline: () => markUp('underline'),
        strike: () => markUp('strike'),
        bullet: () => listAs('bullet'),
        number: () => listAs('number'),
        outdent: () => indent(-1),
        indent: () => indent(1),
        smaller: () => resize(-0.5),
        bigger: () => resize(0.5),
        clear: () => clear(),
        fonts: () => flip('data-fonts'),
      };

      // Delegated rather than wired button by button, so chrome rebuilt by an
      // undo, an agent or another window is live the moment it lands.
      addEventListener('mousedown', (event) => {
        // The selection stays exactly as it was under the button acting on it.
        if (event.target.closest('.tools, .menus, .popup, .fonts, .grip')) event.preventDefault();
      }, true);

      addEventListener('pointerdown', (event) => {
        if (!event.target.closest('.popup, .menu, .tool')) shut();
      });

      addEventListener('click', (event) => {
        const menu = event.target.closest('.menu');
        if (menu) return open(menu, MENUS[menu.getAttribute('data-menu')] ?? (() => {}));

        const face = event.target.closest('[data-set-ui], [data-set-doc]');
        if (face) {
          const ui = face.getAttribute('data-set-ui');
          if (ui) attr(document.body, 'data-ui-font', ui);
          else attr(document.body, 'data-doc-font', face.getAttribute('data-set-doc'));
          return sync();
        }

        const tool = event.target.closest('.tool, .shut');
        if (!tool) return;
        const pick = tool.getAttribute('data-pick');
        if (pick) return open(tool, PICKS[pick]);
        CMD[tool.getAttribute('data-cmd')]?.();
        sync();
      });

      // -------------------------------------------------------- typing in it

      flow.addEventListener('input', () => {
        tidyUp();
        file(true);
        sync();
      });

      flow.addEventListener('blur', () => {
        settle();
        marble.flush();
      });

      flow.addEventListener('paste', (event) => {
        event.preventDefault();
        pasteText(event.clipboardData?.getData('text/plain') ?? '');
      });

      // Select All with the focus anywhere but in a field of its own means the
      // document, which is the whole reason the flow is one host.
      addEventListener('keydown', (event) => {
        const mod = event.metaKey || event.ctrlKey;
        if (!mod || event.altKey || event.shiftKey || event.key.toLowerCase() !== 'a') return;
        const target = event.target;
        if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement) return;
        if (target instanceof HTMLElement && target.isContentEditable && !flow.contains(target)) return;
        event.preventDefault();
        selectAll();
      });

      flow.addEventListener('keydown', (event) => {
        const mod = event.metaKey || event.ctrlKey;

        // Undo is this document's to handle in here. The shared `history` part
        // steps aside for any contenteditable that is not a data-marble-editable
        // — it assumes the browser owns undo there — and the flow is exactly
        // that, so Ctrl+Z would otherwise reach the browser's own stack and
        // desync the page from the file. Close the burst, then reverse it.
        if (mod && !event.altKey && 'zy'.includes(event.key.toLowerCase())) {
          event.preventDefault();
          event.stopPropagation();
          back(event.key.toLowerCase() === 'y' || event.shiftKey);
          return;
        }

        if (event.key === 'Enter' && !event.shiftKey && !mod) {
          event.preventDefault();
          return split();
        }

        // Read off event.code rather than event.key: Option rewrites the
        // character on a Mac, so Cmd+Option+1 arrives as "¡" and a document
        // that matched on the character would work on one platform only.
        if (mod && event.altKey) {
          const digit = /^Digit([0-3])$/.exec(event.code)?.[1];
          if (!digit) return;
          event.preventDefault();
          return restyle(digit === '0' ? 'body' : 'h' + digit);
        }

        if (mod && !event.altKey) {
          const key = event.key.toLowerCase();
          if (event.shiftKey && (key === 'arrowup' || key === 'arrowdown')) {
            event.preventDefault();
            return shift(key === 'arrowup' ? -1 : 1);
          }
          if (event.shiftKey && key === 'c') {
            event.preventDefault();
            return detail();
          }
          if (event.shiftKey || !'biu\\'.includes(key)) return;
          event.preventDefault();
          if (key === '\\') clear();
          else markUp(key === 'b' ? 'bold' : key === 'i' ? 'italic' : 'underline');
          return;
        }

        if (event.key === 'Tab') {
          event.preventDefault();
          return indent(event.shiftKey ? -1 : 1);
        }

        // Backspace at the very start peels one thing off at a time — the
        // indent, then the list, and only then the paragraph break itself,
        // which the browser is welcome to do because joining two paragraphs is
        // now an ordinary edit inside one field.
        const sel = getSelection();
        if (event.key === 'Backspace' && sel?.isCollapsed) {
          const el = blockOf(sel.anchorNode);
          const mark = markRange();
          if (!el || mark?.a.offset !== 0) return;
          if (Number(el.getAttribute('data-indent') ?? 0) > 0) {
            event.preventDefault();
            return indent(-1);
          }
          if (el.hasAttribute('data-list')) {
            event.preventDefault();
            return setOn('data-list', null);
          }
        }
      });

      // The margin around the text is still the page, and clicking a page puts
      // you in its text — on the line you pointed at, not at the end of it.
      page.addEventListener('mousedown', (event) => {
        if (event.target !== page || grip.contains(event.target)) return;
        const all = blocks().filter(isText);
        if (!all.length) return;
        event.preventDefault();
        const y = event.clientY;
        const el = all.find((block) => y <= block.getBoundingClientRect().bottom) ?? all[all.length - 1];
        const box = el.getBoundingClientRect();
        const x = event.clientX < box.left ? box.left + 1 : box.right - 1;
        const spotted = document.caretRangeFromPoint?.(x, Math.min(Math.max(y, box.top + 1), box.bottom - 1));
        if (spotted && flow.contains(spotted.startContainer)) {
          const range = getSelection();
          range.removeAllRanges();
          range.addRange(spotted);
          flow.focus({ preventScroll: true });
        } else {
          place(el, marble.text(el).length);
        }
        sync();
      });

      // ----------------------------------------------------------- what is drawn
      //
      // None of this is in the file and none of it files anything. The outline
      // is the headings, the count is the words, and the toolbar is whatever
      // the caret is sitting in — three readings of the notes, redrawn from
      // them rather than kept beside them, which is why none can be wrong.

      const DEPTH = { h1: 'd1', h2: 'd2', h3: 'd3' };
      let counted = { words: 0, characters: 0 };

      function derive() {
        outline.textContent = '';
        for (const el of blocks()) {
          const depth = DEPTH[styleOf(el)];
          if (!depth || !isText(el)) continue;
          const item = document.createElement('li');
          item.className = depth;
          item.textContent = marble.text(el) || 'Heading';
          item.addEventListener('click', () => {
            el.scrollIntoView({ block: 'center', behavior: 'smooth' });
            place(el, marble.text(el).length);
            sync();
          });
          outline.append(item);
        }

        const text = blocks().filter(isText).map((el) => marble.text(el)).join(' ').trim();
        counted = { words: text ? text.split(/\s+/).length : 0, characters: text.length };
        counter.textContent = counted.words === 1 ? '1 word' : counted.words + ' words';
      }

      let saying = null;
      function detail() {
        counter.textContent =
          counted.words + ' words · ' + counted.characters + ' characters · ' +
          blocks().filter(isText).length + ' paragraphs';
        clearTimeout(saying);
        saying = setTimeout(derive, 6000);
      }

      function sync() {
        const els = chosen();
        const el = els[0];
        if (isText(el)) here = el;
        const caret = atCaret();
        const lit = (selector, on) => $(selector)?.classList.toggle('marble-on', Boolean(on));
        for (const name of ['bold', 'italic', 'underline', 'strike']) {
          lit('[data-cmd="' + name + '"]', marked(name, els));
        }
        lit('[data-cmd="bullet"]', listOf(el) === 'bullet');
        lit('[data-cmd="number"]', listOf(el) === 'number');
        lit('[data-cmd="fonts"]', showing('data-fonts'));

        $('#now-style').textContent = styleNamed(styleOf(el)).name;
        $('#now-face').textContent = faceOf(caret);
        $('#now-pt').textContent = String(ptOf(caret));
        $('#now-fg').style.color = getComputedStyle(caret ?? flow).color;

        const aligner = $('.aligner');
        for (const [value] of ALIGN) {
          aligner?.classList.toggle('marble-align-' + value, alignOf(el) === value);
        }
        $('[data-cmd="undo"]').disabled = !marble.canUndo;
        $('[data-cmd="redo"]').disabled = !marble.canRedo;
      }

      // Drawn now, and again over anything that arrives later — an edit made in
      // a text editor, another window's undo, an agent's op. What comes back
      // from the file is the file's idea of the flow, so the shadow is taken
      // from it again rather than kept from before.
      marble.register(() => {
        flow.setAttribute('contenteditable', 'true');
        flow.setAttribute('spellcheck', 'true');
        shadow = readFlow();
        if (normalise()) file(false);
        derive();
        sync();
      });

      flow.addEventListener('keyup', sync);
      flow.addEventListener('click', sync);
      document.addEventListener('selectionchange', () => {
        if (flow.contains(getSelection()?.anchorNode)) sync();
      });
      addEventListener('beforeunload', settle);
    };

    if (window.marble) begin(window.marble);
    else addEventListener('marble:ready', (event) => begin(event.detail), { once: true });
  })();
</script>

__SCRIPT__
</body>
</html>
