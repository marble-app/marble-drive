  <g id="i-image"><rect x="3.5" y="5" width="17" height="14" rx="2.2"/><circle cx="15.5" cy="9.5" r="1.4"/><path d="m3.8 16.5 4.7-4.7 4.2 4.2 2.3-2.3 5 5"/></g>
  <g id="i-link"><path d="M10 14a4 4 0 0 0 5.7 0l3-3A4 4 0 0 0 13 5.3l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3A4 4 0 0 0 11 18.7l1-1"/></g>
  <g id="i-plus"><path d="M12 5v14M5 12h14"/></g>
  <g id="i-minus"><path d="M5 12h14"/></g>
  <g id="i-fit"><path d="M4 9V5h4M16 5h4v4M20 15v4h-4M8 19H4v-4"/></g>
  <g id="i-spark"><path d="m11 3 1.9 5.1L18 10l-5.1 1.9L11 17l-1.9-5.1L4 10l5.1-1.9z"/><path d="m18 14.5.8 2.2 2.2.8-2.2.8L18 20.5l-.8-2.2-2.2-.8 2.2-.8z"/></g>
  <g id="i-up"><path d="M12 19V5M6 11l6-6 6 6"/></g>
  <g id="i-stop"><rect x="7" y="7" width="10" height="10" rx="2"/></g>
  <g id="i-close"><path d="M6.5 6.5l11 11M17.5 6.5l-11 11"/></g>
  <g id="i-trash"><path d="M4.5 7h15M9.5 7V4.5h5V7M6.5 7l.9 12.5h9.2L17.5 7M10 11v5M14 11v5"/></g>
  <g id="i-dup"><rect x="8.5" y="8.5" width="11" height="11" rx="2"/><path d="M5.5 15.5h-.5a1.5 1.5 0 0 1-1.5-1.5V5A1.5 1.5 0 0 1 5 3.5h9A1.5 1.5 0 0 1 15.5 5v.5"/></g>
  <g id="i-front"><path d="m12 3.5 8.5 4.5-8.5 4.5L3.5 8z"/><path d="m3.5 12.5 8.5 4.5 8.5-4.5M3.5 16.5 12 21l8.5-4.5" opacity=".45"/></g>
  <g id="i-back"><path d="m3.5 8 8.5 4.5L20.5 8" opacity=".45"/><path d="m3.5 12 8.5 4.5 8.5-4.5" opacity=".45"/><path d="m12 12 8.5 4.5L12 21l-8.5-4.5z"/></g>
  <g id="i-undo"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></g>
  <g id="i-redo"><path d="m15 14 5-5-5-5"/><path d="M20 9H9.5a5.5 5.5 0 0 0 0 11H13"/></g>
  <g id="i-history"><path d="M3.8 12a8.2 8.2 0 1 0 2.4-5.8"/><path d="M3.8 4.5v4h4M12 8v4.5l3 2"/></g>
  <g id="i-new"><path d="M12 20h8"/><path d="M16.3 3.7a2.1 2.1 0 0 1 3 3L7.5 18.5 3.5 19.5l1-4z"/></g>
  <g id="i-file"><path d="M7 3.5h6.5l4.5 4.5v12.5H7z"/><path d="M13.5 3.5V8H18"/></g>
  <g id="i-play"><path d="M8 5.5v13l10.5-6.5z"/></g>
  <g id="i-sound"><path d="M4.5 9.5h3l4-3.5v12l-4-3.5h-3z"/><path d="M15 9a4 4 0 0 1 0 6M17.5 6.5a7.5 7.5 0 0 1 0 11"/></g>
  <g id="i-right"><path d="m9.5 6 6 6-6 6"/></g>
  <g id="i-chev"><path d="m7 10 5 5 5-5"/></g>
  <g id="i-check"><path d="m5 12.5 4.5 4.5L19 7.5"/></g>
  <g id="i-copy"><rect x="8.5" y="8.5" width="11" height="11" rx="2"/><path d="M5.5 15.5h-.5a1.5 1.5 0 0 1-1.5-1.5V5A1.5 1.5 0 0 1 5 3.5h9A1.5 1.5 0 0 1 15.5 5v.5"/></g>
  <g id="i-panel"><rect x="3.5" y="4.5" width="17" height="15" rx="2.2"/><path d="M14.5 4.5v15"/></g>
  <g id="i-open"><path d="M13.5 4.5h6v6M19.5 4.5l-8.5 8.5M17.5 14v4.5a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1v-11a1 1 0 0 1 1-1H10"/></g>
  <g id="i-pin"><path d="M12 16.5V21M8.5 3.5h7l-1 5.5 3 3v2h-11v-2l3-3z"/></g>
  <g id="i-doc"><path d="M6.5 3.5h7l4 4v13h-11z"/><path d="M13.5 3.5v4h4M9 12h6M9 15.5h6"/></g>
  <g id="i-drive"><path d="M3.5 7.5a2 2 0 0 1 2-2h3.8l2 2h7.2a2 2 0 0 1 2 2v7.5a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z"/></g>
  <g id="i-pdf"><path d="M7 3.5h6.5l4.5 4.5v12.5H7z"/><path d="M13.5 3.5V8H18M9.5 16.5h5M9.5 13h5"/></g>
  <g id="i-board"><rect x="3.5" y="4.5" width="17" height="15" rx="2.2"/><path d="M7.5 9h4v3.5h-4zM13 12.5h3.5V16H13z"/></g>
</defs></svg>

<!-- The board. Each thing on it is one element in .world; its inline style is
     where it sits. The camera, the selection and every handle are the page's. -->
<main class="stage" data-marble-id="__ID__" data-tool="select" aria-label="Board">
  <div class="world" id="world" data-marble-id="__ID__">
    <section class="item frame" data-kind="frame" data-color="white" data-marble-id="__ID__" style="left:0px;top:0px;width:760px;height:430px"><div class="words" data-marble-id="__ID__" data-placeholder="Section">What are we building?</div></section>
    <article class="item note" data-kind="note" data-color="yellow" data-marble-id="__ID__" style="left:36px;top:70px;width:220px"><div class="words" data-marble-id="__ID__" data-placeholder="Type an idea">Who is it for?</div></article>
    <article class="item note" data-kind="note" data-color="blue" data-marble-id="__ID__" style="left:272px;top:70px;width:220px"><div class="words" data-marble-id="__ID__" data-placeholder="Type an idea">What should it do on the first day?</div></article>
    <article class="item note" data-kind="note" data-color="pink" data-marble-id="__ID__" style="left:508px;top:70px;width:220px"><div class="words" data-marble-id="__ID__" data-placeholder="Type an idea">How should it feel?</div></article>
    <div class="item text" data-kind="text" data-size="s" data-color="ink" data-marble-id="__ID__" style="left:36px;top:262px;width:690px"><div class="words" data-marble-id="__ID__" data-placeholder="Text">Write over these, add your own, sketch the screens, drop in screenshots and links. When the board says what you mean, ask Claude to build it.</div></div>
  </div>

  <div class="empty" data-marble-transient>
    <b>An empty board</b>
    <p>Double-click anywhere for a sticky note. Press P to sketch, D to bring in something from your drive, or drop in documents, PDFs, images and links.</p>
  </div>
  <div class="overlay" data-marble-transient></div>
  <div class="drop-hint" data-marble-transient>Drop to put it on the board</div>
  <div class="toast" role="status" data-marble-transient></div>

  <header class="hud head" data-hud data-marble-id="__ID__">
    <h1 class="name" data-marble-id="__ID__" title="Double-click to rename">__TITLE__</h1>
    <span class="save" data-marble-transient></span>
    <span class="count" data-marble-transient></span>
    <span class="hist" data-marble-transient>
      <button class="tb" type="button" data-cmd="undo" title="Undo (⌘Z)" aria-label="Undo" disabled><svg class="ic" viewBox="0 0 24 24"><use href="#i-undo"/></svg></button>
      <button class="tb" type="button" data-cmd="redo" title="Redo (⇧⌘Z)" aria-label="Redo" disabled><svg class="ic" viewBox="0 0 24 24"><use href="#i-redo"/></svg></button>
    </span>
  </header>

  <div class="hud view" data-hud data-marble-transient>
    <button class="tb" type="button" data-cmd="zoom-out" title="Zoom out (−)" aria-label="Zoom out"><svg class="ic" viewBox="0 0 24 24"><use href="#i-minus"/></svg></button>
    <button class="tb zoom" type="button" data-cmd="zoom-reset" title="Reset zoom (⌘0)" aria-label="Zoom">100%</button>
    <button class="tb" type="button" data-cmd="zoom-in" title="Zoom in (+)" aria-label="Zoom in"><svg class="ic" viewBox="0 0 24 24"><use href="#i-plus"/></svg></button>
    <button class="tb" type="button" data-cmd="fit" title="Fit the board (⇧1)" aria-label="Fit the board"><svg class="ic" viewBox="0 0 24 24"><use href="#i-fit"/></svg></button>
    <button class="ask-btn" type="button" data-cmd="panel" title="Ask Claude (⌘K)"><svg class="ic" viewBox="0 0 24 24"><use href="#i-spark"/></svg><span>Ask Claude</span></button>
  </div>

  <div class="hud options" data-hud data-marble-transient>
    <div class="palette"></div>
    <label class="linkin"><input type="url" placeholder="Paste a link and press Return" aria-label="Link" autocomplete="off" spellcheck="false"></label>
  </div>

  <nav class="hud dock" data-hud data-marble-transient aria-label="Tools">
    <button class="tb" type="button" data-tool="select" title="Select (V)" aria-label="Select" aria-pressed="true"><svg class="ic" viewBox="0 0 24 24"><use href="#i-select"/></svg><kbd>V</kbd></button>
    <button class="tb" type="button" data-tool="hand" title="Pan (H, or hold Space)" aria-label="Pan" aria-pressed="false"><svg class="ic" viewBox="0 0 24 24"><use href="#i-hand"/></svg><kbd>H</kbd></button>
    <span class="sep"></span>
    <button class="tb" type="button" data-tool="note" title="Sticky note (N)" aria-label="Sticky note" aria-pressed="false"><svg class="ic" viewBox="0 0 24 24"><use href="#i-note"/></svg><kbd>N</kbd></button>
    <button class="tb" type="button" data-tool="text" title="Text (T)" aria-label="Text" aria-pressed="false"><svg class="ic" viewBox="0 0 24 24"><use href="#i-text"/></svg><kbd>T</kbd></button>
    <button class="tb" type="button" data-tool="frame" title="Section (S)" aria-label="Section" aria-pressed="false"><svg class="ic" viewBox="0 0 24 24"><use href="#i-frame"/></svg><kbd>S</kbd></button>
    <span class="sep"></span>
    <button class="tb" type="button" data-tool="pen" title="Pen (P)" aria-label="Pen" aria-pressed="false"><svg class="ic" viewBox="0 0 24 24"><use href="#i-pen"/></svg><kbd>P</kbd></button>
    <button class="tb" type="button" data-tool="marker" title="Highlighter (M)" aria-label="Highlighter" aria-pressed="false"><svg class="ic" viewBox="0 0 24 24"><use href="#i-marker"/></svg><kbd>M</kbd></button>
    <button class="tb" type="button" data-tool="eraser" title="Eraser (E)" aria-label="Eraser" aria-pressed="false"><svg class="ic" viewBox="0 0 24 24"><use href="#i-eraser"/></svg><kbd>E</kbd></button>
    <span class="sep"></span>
    <button class="tb" type="button" data-cmd="media" title="Image, video or file (I)" aria-label="Add an image, video or file"><svg class="ic" viewBox="0 0 24 24"><use href="#i-image"/></svg><kbd>I</kbd></button>
    <button class="tb" type="button" data-cmd="drive" title="From your drive (D)" aria-label="Add something from your drive"><svg class="ic" viewBox="0 0 24 24"><use href="#i-drive"/></svg><kbd>D</kbd></button>
    <button class="tb" type="button" data-tool="link" title="Link (L)" aria-label="Link" aria-pressed="false"><svg class="ic" viewBox="0 0 24 24"><use href="#i-link"/></svg><kbd>L</kbd></button>
    <input class="picker" type="file" multiple hidden>
  </nav>

  <div class="hud selbar" data-hud data-marble-transient role="toolbar" aria-label="Selection"></div>
</main>

<!-- The conversation about the board. What it says before anyone has, and the
     ideas under it, are the file's; the thread is the host's. -->
<aside class="panel marble-fresh" data-marble-id="__ID__" aria-label="Claude">
  <header class="panel-bar" data-marble-transient>
    <h2 class="title">Claude</h2>
    <button class="model" type="button" aria-haspopup="menu" popovertarget="bw-models" hidden><span>Claude</span><svg class="ic" viewBox="0 0 24 24"><use href="#i-chev"/></svg></button>
    <button class="tb" type="button" aria-haspopup="menu" popovertarget="bw-threads" title="Earlier conversations about this board" aria-label="Earlier conversations"><svg class="ic" viewBox="0 0 24 24"><use href="#i-history"/></svg></button>
    <button class="tb" type="button" data-cmd="new-thread" title="New conversation" aria-label="New conversation"><svg class="ic" viewBox="0 0 24 24"><use href="#i-new"/></svg></button>
    <button class="tb" type="button" data-cmd="panel" title="Hide (⌘K)" aria-label="Hide the conversation"><svg class="ic" viewBox="0 0 24 24"><use href="#i-panel"/></svg></button>
  </header>
  <div class="menu" id="bw-models" popover role="menu" aria-label="Model" data-marble-transient></div>
  <div class="menu" id="bw-threads" popover role="menu" aria-label="Conversations" data-marble-transient></div>

  <div class="log" data-marble-id="__ID__">
    <section class="hello" data-marble-id="__ID__">
      <h2 data-marble-id="__ID__">Build from the board</h2>
      <p data-marble-id="__ID__">Claude sees everything on the board: the notes, the sketches, the pictures, and where each one sits. Select a few things to ask about just those.</p>
      <ul class="ideas" data-marble-id="__ID__">
        <li data-marble-id="__ID__"><button class="idea" type="button" data-marble-id="__ID__">Build the app this board describes.</button></li>
        <li data-marble-id="__ID__"><button class="idea" type="button" data-marble-id="__ID__">What’s missing or unclear before we build?</button></li>
        <li data-marble-id="__ID__"><button class="idea" type="button" data-marble-id="__ID__">Turn this board into a one-page spec.</button></li>
        <li data-marble-id="__ID__"><button class="idea" type="button" data-marble-id="__ID__">Mock up the main screens from my sketches.</button></li>
      </ul>
    </section>
    <div class="thread" role="log" aria-label="Messages" data-marble-transient></div>
    <div class="compose" data-marble-transient>
      <div class="scope"></div>
      <div class="field">
        <textarea rows="1" placeholder="What should Claude do with the board?" aria-label="Message"></textarea>
        <button class="send" type="button" data-mode="send" aria-label="Send" disabled>
          <svg class="ic i-send" viewBox="0 0 24 24"><use href="#i-up"/></svg>
          <svg class="ic i-stop" viewBox="0 0 24 24"><use href="#i-stop"/></svg>
        </button>
      </div>
      <p class="hint">Return to send · the board goes with every message</p>
    </div>
  </div>
</aside>

<div class="hud drivepick" data-hud data-marble-transient hidden role="dialog" aria-label="From your drive">
  <input type="search" placeholder="Find a document or file in your drive" aria-label="Find in your drive" autocomplete="off" spellcheck="false">
  <p class="k"></p>
  <div class="rows" role="listbox"></div>
</div>

<script>
/* The board. Everything on it is an element in .world, and each gesture both
   moves the page and files the op that says so, with its inverse, so ⌘Z takes
   it back. Nothing about the board is kept in script: every question — what is
   here, where it is, what colour — is asked of the DOM.

   What the file does not hold: the camera (local to this browser), the
   selection, the tool in hand, and the conversation's thread, which is the
   host's and is read back from its event stream. The conversation's id is a
   fact on <body>, because which conversation a board is having is the board's. */
(() => {
  const SVGNS = 'http://www.w3.org/2000/svg';
  const $ = (s, root = document) => root.querySelector(s);
  const $$ = (s, root = document) => [...root.querySelectorAll(s)];
  const h = (tag, cls, text) => {
    const el = document.createElement(tag);
    if (cls) el.className = cls;
    if (text != null) el.textContent = text;
    return el;
  };
  const icon = (name, cls = 'ic') => {
    const svg = document.createElementNS(SVGNS, 'svg');
    svg.setAttribute('viewBox', '0 0 24 24');
    svg.setAttribute('class', cls);
    svg.setAttribute('aria-hidden', 'true');
    const use = document.createElementNS(SVGNS, 'use');
    use.setAttribute('href', `#i-${name}`);
    svg.append(use);
    return svg;
  };
  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const clamp = (v, lo, hi) => Math.min(hi, Math.max(lo, v));
  const r1 = (v) => Math.round(v * 10) / 10;
  const enc = encodeURIComponent;

  const body = document.body;
  const stage = $('.stage');
  const world = $('#world');
  const overlay = $('.overlay');
  const selbar = $('.selbar');
  const options = $('.options');
  const palette = $('.palette', options);
  const linkInput = $('.linkin input', options);
  const picker = $('.picker');
  const nameEl = $('.head .name');
  const countEl = $('.head .count');
  const saveEl = $('.head .save');
  const zoomEl = $('.view .zoom');
  const toastEl = $('.toast');
  const coarse = matchMedia('(pointer: coarse)');

  let M = null;
  const PLAIN = (() => { const d = document.createElement('div'); d.contentEditable = 'plaintext-only'; return d.contentEditable === 'plaintext-only'; })();

  const NOTE_COLORS = ['yellow', 'pink', 'blue', 'green', 'purple', 'orange', 'white'];
  const INK_COLORS = ['ink', 'red', 'blue', 'green', 'purple', 'orange'];
  const WIDTHS = { pen: [2, 4, 8], marker: [14, 24, 40] };
  const SIZES = [['s', 'S'], ['m', 'M'], ['l', 'L'], ['xl', 'XL']];

  // What the hand is holding between gestures: the page's, remembered here.
  const PREFS_KEY = 'marble-board:prefs';
  const prefs = Object.assign({ note: 'yellow', ink: 'ink', pen: 4, marker: 24, text: 'ink' }, (() => {
    try { return JSON.parse(localStorage.getItem(PREFS_KEY) || '{}'); } catch { return {}; }
  })());
  const savePrefs = () => { try { localStorage.setItem(PREFS_KEY, JSON.stringify(prefs)); } catch {} };

  let toastTimer = 0;
  function say(words) {
    toastEl.textContent = words;
    toastEl.classList.add('marble-shown');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toastEl.classList.remove('marble-shown'), 2600);
  }

  // ---------------------------------------------------------------- camera

  const cam = { x: 80, y: 90, z: 1 };
  const camSheet = new CSSStyleSheet();
  document.adoptedStyleSheets = [...document.adoptedStyleSheets, camSheet];
  const CAM_KEY = `marble-board:camera:${location.pathname}`;
  let camTimer = 0;
  function paintCam() {
    camSheet.replaceSync(`:root{--cx:${r1(cam.x)}px;--cy:${r1(cam.y)}px;--z:${cam.z.toFixed(4)}}`);
    zoomEl.textContent = `${Math.round(cam.z * 100)}%`;
    paintChrome();
    clearTimeout(camTimer);
    camTimer = setTimeout(() => { try { localStorage.setItem(CAM_KEY, JSON.stringify(cam)); } catch {} }, 250);
  }
  const ZMIN = 0.08;
  const ZMAX = 5;
  const stageRect = () => stage.getBoundingClientRect();
  const local = (e) => { const r = stageRect(); return { x: e.clientX - r.left, y: e.clientY - r.top }; };
  const toWorld = (p) => ({ x: (p.x - cam.x) / cam.z, y: (p.y - cam.y) / cam.z });
  const toStage = (p) => ({ x: p.x * cam.z + cam.x, y: p.y * cam.z + cam.y });
  function zoomAt(p, z) {
    z = clamp(z, ZMIN, ZMAX);
    const w = toWorld(p);
    cam.z = z;
    cam.x = p.x - w.x * z;
    cam.y = p.y - w.y * z;
    paintCam();
  }
  const centre = () => { const r = stageRect(); return { x: r.width / 2, y: r.height / 2 }; };
  function viewCentreWorld() { return toWorld(centre()); }

  let camAnim = 0;
  function glide(to) {
    cancelAnimationFrame(camAnim);
    const from = { ...cam };
    const t0 = performance.now();
    const D = matchMedia('(prefers-reduced-motion: reduce)').matches ? 1 : 320;
    const step = (t) => {
      const k = Math.min(1, (t - t0) / D);
      const e = 1 - (1 - k) ** 3;
      cam.x = from.x + (to.x - from.x) * e;
      cam.y = from.y + (to.y - from.y) * e;
      cam.z = from.z + (to.z - from.z) * e;
      paintCam();
      if (k < 1) camAnim = requestAnimationFrame(step);
    };
    camAnim = requestAnimationFrame(step);
  }
  function fit(list = items(), { animate = true } = {}) {
    const r = stageRect();
    if (!list.length) {
      const to = { x: r.width / 2, y: r.height / 2, z: 1 };
      return animate ? glide(to) : Object.assign(cam, to) && paintCam();
    }
    const u = union(list.map(box));
    const pad = 80;
    const bottom = coarse.matches ? 90 : 110;
    const z = clamp(Math.min((r.width - pad * 2) / u.w, (r.height - pad - bottom) / u.h), ZMIN, 1.25);
    const to = { z, x: (r.width - u.w * z) / 2 - u.x * z, y: pad * 0.8 + (r.height - pad - bottom - u.h * z) / 2 - u.y * z };
    if (animate) glide(to);
    else { Object.assign(cam, to); paintCam(); }
  }

  // ----------------------------------------------------------- the things

  const items = () => [...world.children].filter((el) => el.classList.contains('item') && !el.hasAttribute('data-marble-transient'));
  const kindOf = (el) => el.dataset.kind;
  const isInk = (el) => kindOf(el) === 'ink';
  const hasWords = (el) => Boolean(el.querySelector(':scope > .words'));
  function box(el) {
    return {
      x: parseFloat(el.style.left) || 0,
      y: parseFloat(el.style.top) || 0,
      w: el.offsetWidth || parseFloat(el.style.width) || 0,
      h: el.offsetHeight || parseFloat(el.style.height) || 0,
    };
  }
  function union(boxes) {
    const x = Math.min(...boxes.map((b) => b.x));
    const y = Math.min(...boxes.map((b) => b.y));
    const x2 = Math.max(...boxes.map((b) => b.x + b.w));
    const y2 = Math.max(...boxes.map((b) => b.y + b.h));
    return { x, y, w: x2 - x, h: y2 - y };
  }
  const overlaps = (a, b) => a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y;
  const inside = (a, b) => a.x >= b.x && a.y >= b.y && a.x + a.w <= b.x + b.w && a.y + a.h <= b.y + b.h;
  const wordsOf = (el) => {
    const w = el.querySelector(':scope > .words');
    return w ? (w.querySelector('br') ? w.innerText : w.textContent).replace(/\n+$/, '') : '';
  };

  // The same composition every writer uses, so the bytes in the page and the
  // bytes in the file are the same bytes: named declarations replaced in
  // place of the old, everything else the element carries kept in its order.
  function styleWith(base, declarations) {
    const dropped = new Set(Object.keys(declarations));
    const rest = (base ?? '').split(';').map((d) => d.trim())
      .filter((d) => d && !dropped.has(d.slice(0, d.indexOf(':')).trim().toLowerCase()));
    const next = Object.entries(declarations).filter(([, v]) => v != null && v !== '').map(([k, v]) => `${k}:${v}`);
    return [...next, ...rest].join(';');
  }

  // ------------------------------------------------------------------ ops

  /** Structural changes: each op applied to the page and filed, its inverse
   *  taken from the page as it stood just before, and the lot one undo step. */
  function commit(ops) {
    if (!M || !ops.length) return false;
    const undo = [];
    for (const op of ops) {
      const back = M.invert(op);
      M.apply(op);
      M.op(op);
      if (back) undo.unshift(back);
    }
    M.record({ redo: ops, undo });
    return true;
  }
  /** A gesture already moved the page; this files where it ended up. */
  function file(redo, undo) {
    if (!M || !redo.length) return;
    for (const op of redo) M.op(op);
    M.record({ redo, undo });
  }
  const byId = (id) => world.querySelector(`[data-marble-id="${CSS.escape(id)}"]`);
  const nid = () => M.newId();
  const insertOp = (html, { back = false } = {}) => {
    let beforeId = null;
    // A section goes behind everything that is not a section, and in front of
    // the sections already there.
    if (back) beforeId = M.id(items().find((el) => kindOf(el) !== 'frame') ?? null) ?? null;
    return { type: 'insert', parentId: M.id(world), beforeId, html };
  };
  const extOf = (p) => (/\.([a-z0-9]+)$/i.exec(String(p ?? ''))?.[1] ?? '').toLowerCase();
  const docHref = (path) => `/a/${enc(path)}`;
  // The drive's files, uploads and listing come through `marble.drive`, the
  // host's extension to the carrier, so the board never names a route.
  const drive = () => {
    const d = window.marble?.drive;
    if (!d) throw new Error('Open this in Marble Drive to add files');
    return d;
  };
  const fileHref = (path) => window.marble?.drive?.fileHref(path) ?? '';
  const pos = (x, y, extra = '') => `left:${Math.round(x)}px;top:${Math.round(y)}px${extra}`;

  const HTML = {
    note: ({ x, y, w = 220, color = prefs.note, text = '' }) =>
      `<article class="item note" data-kind="note" data-color="${color}" data-marble-id="${nid()}" style="${pos(x, y, `;width:${w}px`)}"><div class="words" data-marble-id="${nid()}" data-placeholder="Type an idea">${esc(text)}</div></article>`,
    text: ({ x, y, w = 320, color = prefs.text, size = 'm', text = '' }) =>
      `<div class="item text" data-kind="text" data-size="${size}" data-color="${color}" data-marble-id="${nid()}" style="${pos(x, y, `;width:${w}px`)}"><div class="words" data-marble-id="${nid()}" data-placeholder="Text">${esc(text)}</div></div>`,
    frame: ({ x, y, w = 560, h = 380, color = 'white', text = '' }) =>
      `<section class="item frame" data-kind="frame" data-color="${color}" data-marble-id="${nid()}" style="${pos(x, y, `;width:${Math.round(w)}px;height:${Math.round(h)}px`)}"><div class="words" data-marble-id="${nid()}" data-placeholder="Section">${esc(text)}</div></section>`,
    image: ({ x, y, w, path, name, ratio }) =>
      `<figure class="item media" data-kind="image" data-path="${esc(path)}" data-marble-id="${nid()}" style="${pos(x, y, `;width:${w}px`)}"><img data-marble-id="${nid()}" src="${esc(fileHref(path))}" alt="${esc(name)}" style="aspect-ratio:${ratio}" draggable="false"><figcaption class="words" data-marble-id="${nid()}" data-placeholder="Say what this shows"></figcaption></figure>`,
    video: ({ x, y, w = 360, path, name, ratio = '16 / 9' }) =>
      `<figure class="item media" data-kind="video" data-path="${esc(path)}" data-marble-id="${nid()}" style="${pos(x, y, `;width:${w}px`)}"><video data-marble-id="${nid()}" src="${esc(fileHref(path))}" style="aspect-ratio:${ratio}" controls preload="metadata" playsinline></video><figcaption class="words" data-marble-id="${nid()}" data-placeholder="Say what this shows"></figcaption><span class="name" data-marble-id="${nid()}"><b>${esc(name)}</b></span></figure>`,
    audio: ({ x, y, path, name }) =>
      `<figure class="item media" data-kind="audio" data-path="${esc(path)}" data-marble-id="${nid()}" style="${pos(x, y, ';width:320px')}"><span class="name" data-marble-id="${nid()}"><b>${esc(name)}</b></span><audio data-marble-id="${nid()}" src="${esc(fileHref(path))}" controls preload="metadata"></audio><figcaption class="words" data-marble-id="${nid()}" data-placeholder="Say what this is"></figcaption></figure>`,
    file: ({ x, y, path, name, size }) =>
      `<article class="item card" data-kind="file" data-path="${esc(path)}" data-marble-id="${nid()}" style="${pos(x, y, ';width:280px')}"><span class="kicker" data-marble-id="${nid()}">${esc([extOf(path).toUpperCase() || 'File', size].filter(Boolean).join(' · '))}</span><div class="words" data-marble-id="${nid()}" data-placeholder="What is this?">${esc(name)}</div><a class="open" data-marble-id="${nid()}" href="${esc(fileHref(path))}" target="_blank" rel="noopener">${esc(path)}</a></article>`,
    link: ({ x, y, url, text = '' }) => {
      let host = url;
      try { host = new URL(url).host.replace(/^www\./, ''); } catch {}
      return `<article class="item card" data-kind="link" data-href="${esc(url)}" data-marble-id="${nid()}" style="${pos(x, y, ';width:280px')}"><span class="kicker" data-marble-id="${nid()}">${esc(host)}</span><div class="words" data-marble-id="${nid()}" data-placeholder="Why this link?">${esc(text)}</div><a class="open" data-marble-id="${nid()}" href="${esc(url)}" target="_blank" rel="noopener noreferrer">${esc(url)}</a></article>`;
    },
    doc: ({ x, y, path, title = '', by = '' }) =>
      `<article class="item card" data-kind="doc" data-path="${esc(path)}"${by ? ` data-by="${by}"` : ''} data-marble-id="${nid()}" style="${pos(x, y, ';width:300px')}"><span class="kicker" data-marble-id="${nid()}">${by === 'claude' ? 'Made by Claude' : 'Document'}</span><div class="words" data-marble-id="${nid()}" data-placeholder="What is this?">${esc(title || path.split('/').pop())}</div><a class="open" data-marble-id="${nid()}" href="${esc(docHref(path))}" target="_blank" rel="noopener">${esc(path)}</a></article>`,
    pdf: ({ x, y, path, name, size }) =>
      `<article class="item card" data-kind="pdf" data-path="${esc(path)}" data-marble-id="${nid()}" style="${pos(x, y, ';width:300px')}"><span class="kicker" data-marble-id="${nid()}">${esc(['PDF', size].filter(Boolean).join(' · '))}</span><div class="words" data-marble-id="${nid()}" data-placeholder="What is this?">${esc(name)}</div><a class="open" data-marble-id="${nid()}" href="${esc(fileHref(path))}" target="_blank" rel="noopener">${esc(path)}</a></article>`,
    ink: ({ x, y, w, h, d, width, color, pen }) =>
      `<div class="item ink" data-kind="ink" data-pen="${pen}" data-color="${color}" data-marble-id="${nid()}" style="${pos(x, y, `;width:${Math.ceil(w)}px;height:${Math.ceil(h)}px`)}"><svg data-marble-id="${nid()}" viewBox="0 0 ${Math.ceil(w)} ${Math.ceil(h)}" preserveAspectRatio="none"><path d="${d}" stroke-width="${width}"/></svg></div>`,
  };

  function add(kind, props, { edit: andEdit = false, back = false } = {}) {
    if (!M) { say('Open this in Marble Drive to change the board'); return null; }
    const op = insertOp(HTML[kind](props), { back });
    const id = new DOMParser().parseFromString(op.html, 'text/html').body.firstElementChild.getAttribute('data-marble-id');
    commit([op]);
    const el = byId(id);
    if (el) {
      select([el]);
      if (andEdit) edit(el);
    }
    return el;
  }

  // -------------------------------------------------------------- editing

  let editing = null;
  function edit(item, at = null) {
    const words = item.querySelector(':scope > .words');
    if (!words || !M) return;
    if (editing?.el === words) return;
    stopEditing();
    if (!selected.has(item)) select([item]);
    beginEditing(words, item, at);
  }
  function beginEditing(words, item, at) {
    words.contentEditable = PLAIN ? 'plaintext-only' : 'true';
    words.spellcheck = true;
    editing = { el: words, item, prior: M.text(words) };
    (item ?? words).classList.add('marble-editing');
    words.focus({ preventScroll: true });
    const sel = getSelection();
    let range = null;
    if (at) {
      range = document.caretRangeFromPoint?.(at.clientX, at.clientY) ?? null;
      if (!range && document.caretPositionFromPoint) {
        const p = document.caretPositionFromPoint(at.clientX, at.clientY);
        if (p) { range = document.createRange(); range.setStart(p.offsetNode, p.offset); }
      }
      if (range && !words.contains(range.startContainer)) range = null;
    }
    if (!range) {
      range = document.createRange();
      range.selectNodeContents(words);
      if (words.textContent && !item?.classList.contains('frame')) range.collapse(false);
    }
    sel.removeAllRanges();
    sel.addRange(range);
    paintChrome();
  }
  function stopEditing() {
    if (!editing) return;
    const { el, item, prior } = editing;
    editing = null;
    const text = (el.querySelector('br') ? el.innerText : el.textContent).replace(/\n+$/, '');
    el.removeAttribute('contenteditable');
    el.removeAttribute('spellcheck');
    (item ?? el).classList.remove('marble-editing');
    if (el.textContent !== text || el.querySelector('*')) el.textContent = text;
    const id = M?.id(el);
    if (id && text !== prior) {
      const op = { type: 'setText', id, text };
      M.op(op);
      M.record({ redo: [op], undo: [{ type: 'setText', id, text: prior }] });
    }
    getSelection()?.removeAllRanges();
    // Text with nothing in it is nothing: it goes, rather than leaving an
    // invisible thing to trip over.
    if (item && kindOf(item) === 'text' && !text.trim() && M?.id(item)) {
      selected.delete(item);
      commit([{ type: 'remove', id: M.id(item) }]);
    }
    paintChrome();
  }
  document.addEventListener('input', (e) => {
    if (!editing || e.target !== editing.el || !M) return;
    const id = M.id(editing.el);
    if (!id) return;
    const text = (editing.el.querySelector('br') ? editing.el.innerText : editing.el.textContent).replace(/\n+$/, '');
    M.op({ type: 'setText', id, text });
    paintChrome();
  });
  // Focus leaving the words — into the panel, onto a button — is the end of
  // the edit. Leaving the window is not: the caret is still there on return.
  document.addEventListener('focusout', (e) => {
    if (!editing || e.target !== editing.el) return;
    const was = editing;
    setTimeout(() => {
      if (editing !== was || !document.hasFocus()) return;
      if (!was.el.contains(document.activeElement)) stopEditing();
    }, 0);
  });
  // Rich paste into a note would bring markup the file does not want.
  document.addEventListener('paste', (e) => {
    if (!editing || !editing.el.contains(e.target)) return;
    const text = e.clipboardData?.getData('text/plain');
    if (text == null || PLAIN) return;
    e.preventDefault();
    document.execCommand('insertText', false, text);
  }, true);

  nameEl.addEventListener('dblclick', () => { stopEditing(); if (M) beginEditing(nameEl, null, null); });
  nameEl.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === 'Escape') { e.preventDefault(); stopEditing(); }
  });
  nameEl.addEventListener('blur', () => { if (editing?.el === nameEl) stopEditing(); });

  // ------------------------------------------------------------ selection

  const selected = new Set();
  // Whether the selection is one the person made. What was just put down is
  // selected so it can be moved, not so it becomes the whole of the next ask.
  let picked = false;
  function select(list, { add: plus = false, toggle = false, hand = false } = {}) {
    picked = hand && list.length > 0 ? true : plus || toggle ? picked : false;
    if (!plus && !toggle) {
      for (const el of selected) el.classList.remove('marble-selected');
      selected.clear();
    }
    for (const el of list) {
      if (toggle && selected.has(el)) { selected.delete(el); el.classList.remove('marble-selected'); continue; }
      selected.add(el);
      el.classList.add('marble-selected');
    }
    paintChrome();
    paintScope();
  }
  const clearSelection = () => select([]);

  // --------------------------------------------------------------- chrome

  let chromeFrame = 0;
  function paintChrome() {
    if (chromeFrame) return;
    chromeFrame = requestAnimationFrame(() => { chromeFrame = 0; drawChrome(); });
  }
  const selBoxes = [];
  let handleEl = null;
  function drawChrome() {
    for (const el of [...selected]) if (!el.isConnected) { selected.delete(el); }
    const list = [...selected];
    while (selBoxes.length < list.length) { const d = h('div', 'sel'); overlay.append(d); selBoxes.push(d); }
    const pad = 4;
    selBoxes.forEach((d, i) => {
      const el = list[i];
      if (!el) { d.hidden = true; return; }
      const b = box(el);
      const p = toStage(b);
      d.hidden = false;
      d.style.left = `${p.x - pad}px`;
      d.style.top = `${p.y - pad}px`;
      d.style.width = `${b.w * cam.z + pad * 2}px`;
      d.style.height = `${b.h * cam.z + pad * 2}px`;
    });
    if (!handleEl) {
      handleEl = h('div', 'handle');
      handleEl.addEventListener('pointerdown', startResize);
      overlay.append(handleEl);
    }
    const one = list.length === 1 ? list[0] : null;
    if (one && !body.classList.contains('marble-moving')) {
      const b = box(one);
      const tall = kindOf(one) === 'frame' || isInk(one);
      const p = toStage({ x: b.x + b.w, y: tall ? b.y + b.h : b.y + b.h / 2 });
      handleEl.hidden = false;
      handleEl.dataset.edge = tall ? 'se' : 'e';
      handleEl.style.left = `${p.x + pad}px`;
      handleEl.style.top = `${p.y + (tall ? pad : 0)}px`;
    } else handleEl.hidden = true;
    drawSelbar(list);
    countEl.textContent = (() => { const n = items().length; return n === 1 ? '1 thing' : `${n} things`; })();
  }

  function swatch(color, css, pressed, onPick, label) {
    const b = h('button', 'sw');
    b.type = 'button';
    b.style.setProperty('--sw', css);
    b.setAttribute('aria-pressed', String(pressed));
    b.title = label ?? color;
    b.setAttribute('aria-label', label ?? color);
    b.addEventListener('click', () => onPick(color));
    return b;
  }
  const noteCss = (c) => `var(--n-${c})`;
  const inkCss = (c) => `var(--i-${c})`;

  let selbarKey = '';
  function drawSelbar(list) {
    if (!list.length || editing?.el === nameEl) {
      selbar.classList.remove('marble-shown');
      selbarKey = '';
      return;
    }
    const kinds = new Set(list.map(kindOf));
    const key = `${[...kinds].sort().join(',')}|${list.map((el) => `${el.dataset.color}.${el.dataset.size}`).join(',')}|${list.length}`;
    if (key !== selbarKey) {
      selbarKey = key;
      const parts = [];
      const paper = list.filter((el) => ['note', 'frame'].includes(kindOf(el)));
      const inky = list.filter((el) => ['ink', 'text'].includes(kindOf(el)));
      if (paper.length) {
        const now = paper[0].dataset.color;
        for (const c of NOTE_COLORS) parts.push(swatch(c, noteCss(c), c === now, (v) => recolor(paper, v)));
      } else if (inky.length) {
        const now = inky[0].dataset.color;
        for (const c of INK_COLORS) parts.push(swatch(c, inkCss(c), c === now, (v) => recolor(inky, v)));
      }
      const texts = list.filter((el) => kindOf(el) === 'text');
      if (texts.length) {
        if (parts.length) parts.push(h('span', 'sep'));
        for (const [v, label] of SIZES) {
          const b = h('button', 'tb sz', label);
          b.type = 'button';
          b.title = `Size ${label}`;
          b.setAttribute('aria-pressed', String((texts[0].dataset.size || 'm') === v));
          b.addEventListener('click', () => setAttrAll(texts, 'data-size', v));
          parts.push(b);
        }
      }
      if (parts.length) parts.push(h('span', 'sep'));
      const tb = (name, label, fn, cls = '') => {
        const b = h('button', `tb ${cls}`);
        b.type = 'button';
        b.title = label;
        b.setAttribute('aria-label', label);
        b.append(icon(name));
        b.addEventListener('click', fn);
        return b;
      };
      parts.push(tb('front', 'Bring to front (])', () => restack(true)));
      parts.push(tb('back', 'Send to back ([)', () => restack(false)));
      parts.push(tb('dup', 'Duplicate (⌘D)', () => duplicate()));
      const askB = h('button', 'tb ask-sel');
      askB.type = 'button';
      askB.title = 'Ask Claude about the selection';
      askB.append(icon('spark'), h('span', '', 'Ask'));
      askB.addEventListener('click', () => { picked = true; openPanel(true); });
      parts.push(askB);
      parts.push(tb('trash', 'Delete (⌫)', () => removeSelected(), 'danger'));
      selbar.replaceChildren(...parts);
    }
    const u = union(list.map(box));
    const a = toStage({ x: u.x + u.w / 2, y: u.y });
    const b = toStage({ x: u.x, y: u.y + u.h });
    const r = stageRect();
    const w = selbar.offsetWidth || 300;
    let top = a.y - 56;
    if (top < 64) top = b.y + 14;
    if (top > r.height - 130) top = Math.max(64, a.y + 14);
    selbar.style.left = `${clamp(a.x - w / 2, 8, r.width - w - 8)}px`;
    selbar.style.top = `${clamp(top, 8, r.height - 60)}px`;
    selbar.classList.add('marble-shown');
  }

  function setAttrAll(list, name, value) {
    const ops = list.filter((el) => M?.id(el) && el.getAttribute(name) !== value).map((el) => ({ type: 'setAttr', id: M.id(el), name, value }));
    commit(ops);
    selbarKey = '';
    paintChrome();
  }
  function recolor(list, color) {
    setAttrAll(list, 'data-color', color);
    const k = kindOf(list[0]);
    if (k === 'note') prefs.note = color;
    if (k === 'ink') prefs.ink = color;
    if (k === 'text') prefs.text = color;
    savePrefs();
  }
  function restack(front) {
    if (!M) return;
    const list = items().filter((el) => selected.has(el));
    if (!list.length) return;
    const ops = [];
    if (front) {
      for (const el of list) ops.push({ type: 'move', id: M.id(el), parentId: M.id(world), beforeId: null });
    } else {
      const first = items().find((el) => !selected.has(el) && (kindOf(el) !== 'frame' || list.every((s) => kindOf(s) === 'frame')));
      const beforeId = first ? M.id(first) : null;
      for (const el of list) ops.push({ type: 'move', id: M.id(el), parentId: M.id(world), beforeId });
    }
    commit(ops);
  }
  function removeSelected() {
    if (!M || !selected.size) return;
    stopEditing();
    const ops = [...selected].filter((el) => M.id(el)).map((el) => ({ type: 'remove', id: M.id(el) }));
    selected.clear();
    commit(ops);
    paintChrome();
    paintScope();
  }

  // ------------------------------------------------------ copy and paste

  // A copy is the file's own source for what was selected; a paste is that
  // source with fresh ids, set down a step away so it is seen to arrive.
  let clip = null;
  function cloneHTML(source, dx, dy) {
    const t = document.createElement('template');
    t.innerHTML = source;
    const root = t.content.firstElementChild;
    for (const el of [root, ...root.querySelectorAll('[data-marble-id]')]) el.setAttribute('data-marble-id', nid());
    root.classList.remove('marble-selected', 'marble-editing');
    const b = { x: parseFloat(root.style.left) || 0, y: parseFloat(root.style.top) || 0 };
    root.setAttribute('style', styleWith(root.getAttribute('style'), { left: `${Math.round(b.x + dx)}px`, top: `${Math.round(b.y + dy)}px` }));
    return root.outerHTML;
  }
  function copySelection() {
    const list = items().filter((el) => selected.has(el));
    if (!list.length || !M) return null;
    clip = { sources: list.map((el) => M.source.outer(el)), text: list.map(wordsOf).filter(Boolean).join('\n\n') || `${list.length} things from the board`, n: 0 };
    return clip;
  }
  function pasteClip(dx = 24, dy = 24) {
    if (!clip || !M) return;
    clip.n += 1;
    const ops = clip.sources.map((s) => ({ type: 'insert', parentId: M.id(world), beforeId: null, html: cloneHTML(s, dx * clip.n, dy * clip.n) }));
    const ids = ops.map((op) => new DOMParser().parseFromString(op.html, 'text/html').body.firstElementChild.getAttribute('data-marble-id'));
    commit(ops);
    select(ids.map(byId).filter(Boolean));
  }
  function duplicate() {
    if (!copySelection()) return;
    clip.n = 0;
    pasteClip();
  }

  // ----------------------------------------------------------------- tools

  let tool = 'select';
  function setTool(next) {
    if (next !== 'select' && next !== 'hand') stopEditing();
    tool = next;
    stage.dataset.tool = next === 'link' ? 'select' : next;
    for (const b of $$('.dock [data-tool]')) b.setAttribute('aria-pressed', String(b.dataset.tool === next));
    paintOptions();
    if (next === 'link') requestAnimationFrame(() => linkInput.focus());
    if (['pen', 'marker', 'eraser'].includes(next)) clearSelection();
  }
  function paintOptions() {
    const parts = [];
    if (tool === 'note') {
      for (const c of NOTE_COLORS) parts.push(swatch(c, noteCss(c), prefs.note === c, (v) => { prefs.note = v; savePrefs(); paintOptions(); }));
    } else if (tool === 'text') {
      for (const c of INK_COLORS) parts.push(swatch(c, inkCss(c), prefs.text === c, (v) => { prefs.text = v; savePrefs(); paintOptions(); }));
    } else if (tool === 'pen' || tool === 'marker') {
      for (const c of INK_COLORS) parts.push(swatch(c, inkCss(c), prefs.ink === c, (v) => { prefs.ink = v; savePrefs(); paintOptions(); }));
      parts.push(h('span', 'sep'));
      for (const w of WIDTHS[tool]) {
        const b = h('button', 'wd');
        b.type = 'button';
        b.title = `${w}px`;
        b.setAttribute('aria-pressed', String(prefs[tool] === w));
        const i = h('i');
        i.style.height = `${Math.max(2, Math.min(14, w / (tool === 'marker' ? 3 : 1)))}px`;
        i.style.color = inkCss(prefs.ink);
        i.style.background = inkCss(prefs.ink);
        if (tool === 'marker') i.style.opacity = '.5';
        b.append(i);
        b.addEventListener('click', () => { prefs[tool] = w; savePrefs(); paintOptions(); });
        parts.push(b);
      }
    }
    palette.replaceChildren(...parts);
    options.dataset.for = tool;
    options.classList.toggle('marble-shown', parts.length > 0 || tool === 'link');
  }
  $('.dock').addEventListener('click', (e) => {
    const b = e.target.closest('[data-tool]');
    if (b) setTool(b.dataset.tool);
  });
  linkInput.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { linkInput.value = ''; setTool('select'); return; }
    if (e.key !== 'Enter') return;
    e.preventDefault();
    const url = normaliseUrl(linkInput.value);
    if (!url) { say('That doesn’t look like a link'); return; }
    linkInput.value = '';
    const c = viewCentreWorld();
    setTool('select');
    const ref = driveRefOf(url);
    if (ref) addRef(ref, c);
    else add('link', { x: c.x - 140, y: c.y - 50, url }, { edit: true });
  });
  function normaliseUrl(raw) {
    const s = String(raw ?? '').trim();
    if (!s || /\s/.test(s)) return null;
    try { return new URL(/^[a-z][a-z0-9+.-]*:/i.test(s) ? s : `https://${s}`).href; } catch { return null; }
  }
  const looksLikeUrl = (s) => /^(https?:\/\/|www\.)\S+$/i.test(String(s ?? '').trim());

  // --------------------------------------------------------------- gestures

  const TRAVEL = 4;
  const pointers = new Map();
  let g = null;
  let pinch = null;
  let spaceHeld = false;

  const hudHit = (t) => t.closest?.('[data-hud], .handle');
  const itemAt = (t) => {
    const el = t.closest?.('.item');
    return el && el.parentElement === world && !el.hasAttribute('data-marble-transient') ? el : null;
  };

  // Whether a stroke passes under a point, asked of its own path with the
  // line widened by a tolerance so a thin pen line can still be picked up.
  function inkUnder(pw, tol) {
    const list = items().filter(isInk).reverse();
    for (const el of list) {
      const b = box(el);
      const pad = tol + 20;
      if (pw.x < b.x - pad || pw.x > b.x + b.w + pad || pw.y < b.y - pad || pw.y > b.y + b.h + pad) continue;
      const svg = el.querySelector('svg');
      const path = el.querySelector('path');
      if (!svg || !path) continue;
      const vb = svg.viewBox.baseVal;
      const sx = vb.width / (b.w || 1);
      const sy = vb.height / (b.h || 1);
      const sw = parseFloat(path.getAttribute('stroke-width')) || 3;
      path.style.strokeWidth = String(sw + tol * sx * 2);
      let hit = false;
      try { hit = path.isPointInStroke(new DOMPoint((pw.x - b.x) * sx, (pw.y - b.y) * sy)); } catch {}
      path.style.strokeWidth = '';
      if (hit) return el;
    }
    return null;
  }

  stage.addEventListener('pointerdown', (e) => {
    if (hudHit(e.target)) return;
    if (editing && editing.el.contains(e.target)) return;
    // A press on the board is a press on the board: a field left focused
    // elsewhere would otherwise take the next Delete or ⌘A for itself.
    const focused = document.activeElement;
    if (focused && focused !== document.body && !editing?.el.contains(focused) && !stage.contains(focused)) focused.blur?.();
    else if (focused?.matches?.('.picker, button')) focused.blur();
    const p = local(e);
    pointers.set(e.pointerId, p);
    if (pointers.size === 2) {
      abortGesture();
      const [a, b] = [...pointers.values()];
      pinch = { d: Math.hypot(a.x - b.x, a.y - b.y) || 1, mid: { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 }, cam: { ...cam } };
      return;
    }
    if (pointers.size > 2) return;
    try { stage.setPointerCapture(e.pointerId); } catch {}
    const pw = toWorld(p);
    const start = { p, pw, id: e.pointerId, t: performance.now() };

    const pan = e.button === 1 || spaceHeld || tool === 'hand';
    if (pan) { e.preventDefault(); g = { type: 'pan', ...start, cam: { ...cam } }; body.classList.add('marble-panning'); return; }
    if (e.button !== 0 && e.pointerType === 'mouse') { pointers.delete(e.pointerId); return; }

    if (tool === 'pen' || tool === 'marker') {
      e.preventDefault();
      stopEditing();
      const width = prefs[tool];
      const live = document.createElementNS(SVGNS, 'svg');
      live.setAttribute('class', 'live-ink');
      live.setAttribute('data-marble-transient', '');
      const path = document.createElementNS(SVGNS, 'path');
      path.style.stroke = inkCss(prefs.ink);
      path.style.strokeWidth = String(width);
      if (tool === 'marker') path.style.opacity = '.36';
      live.append(path);
      world.append(live);
      g = { type: 'draw', ...start, pts: [pw], live, path, width, pen: tool, color: prefs.ink };
      drawLive();
      return;
    }
    if (tool === 'eraser') {
      e.preventDefault();
      g = { type: 'erase', ...start, hit: new Set(), dot: h('div', 'eraser-dot') };
      overlay.append(g.dot);
      eraseAt(p);
      return;
    }
    if (tool === 'note' || tool === 'text' || tool === 'frame') {
      e.preventDefault();
      stopEditing();
      g = { type: 'place', kind: tool, ...start, rect: null };
      return;
    }

    // Select.
    let item = itemAt(e.target);
    if (!item && (e.target === stage || e.target === world || e.target.closest?.('.frame'))) item = inkUnder(pw, 6 / cam.z);
    // Controls inside a thing that is already in hand are the thing's own.
    if (item && selected.has(item) && e.target.closest('a, button, video, audio, input')) { pointers.delete(e.pointerId); try { stage.releasePointerCapture(e.pointerId); } catch {} return; }
    if (item) {
      e.preventDefault();
      if (editing && editing.item !== item) stopEditing();
      else if (editing && editing.item === item && !editing.el.contains(e.target)) stopEditing();
      const wasSelected = selected.has(item);
      if (e.shiftKey || e.metaKey || e.ctrlKey) select([item], { toggle: true, hand: true });
      else if (!wasSelected) select([item], { hand: true });
      else picked = true;
      if (!selected.has(item)) { g = null; return; }
      // A section carries what sits inside it.
      const moving = new Set(selected);
      for (const f of [...selected].filter((el) => kindOf(el) === 'frame')) {
        const fb = box(f);
        for (const el of items()) if (el !== f && !moving.has(el) && inside(box(el), fb)) moving.add(el);
      }
      g = {
        type: 'move', ...start, item, wasSelected, moved: false,
        list: [...moving].map((el) => ({ el, prior: el.getAttribute('style'), b: box(el) })),
        clientX: e.clientX, clientY: e.clientY,
      };
      return;
    }
    // Empty board: on a touchscreen one finger pans, as it does in every map.
    stopEditing();
    if (e.pointerType === 'touch') { g = { type: 'pan', ...start, cam: { ...cam }, tap: true }; return; }
    if (!(e.shiftKey || e.metaKey)) clearSelection();
    g = { type: 'marquee', ...start, base: new Set(selected), el: h('div', 'marquee') };
    overlay.append(g.el);
  });

  stage.addEventListener('pointermove', (e) => {
    if (tool === 'eraser' && !g && e.pointerType !== 'touch') showEraser(local(e));
    if (!pointers.has(e.pointerId)) return;
    const p = local(e);
    pointers.set(e.pointerId, p);
    if (pinch && pointers.size >= 2) {
      const [a, b] = [...pointers.values()];
      const d = Math.hypot(a.x - b.x, a.y - b.y) || 1;
      const mid = { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
      const z = clamp(pinch.cam.z * (d / pinch.d), ZMIN, ZMAX);
      const w = { x: (pinch.mid.x - pinch.cam.x) / pinch.cam.z, y: (pinch.mid.y - pinch.cam.y) / pinch.cam.z };
      cam.z = z;
      cam.x = mid.x - w.x * z;
      cam.y = mid.y - w.y * z;
      paintCam();
      return;
    }
    if (!g || g.id !== e.pointerId) return;
    const dx = p.x - g.p.x;
    const dy = p.y - g.p.y;
    const far = Math.hypot(dx, dy) > TRAVEL;
    switch (g.type) {
      case 'pan':
        cam.x = g.cam.x + dx;
        cam.y = g.cam.y + dy;
        if (far) g.tap = false;
        paintCam();
        break;
      case 'move': {
        if (!g.moved && !far) return;
        if (editing) stopEditing();
        g.moved = true;
        body.classList.add('marble-moving');
        const wx = dx / cam.z;
        const wy = dy / cam.z;
        for (const { el, prior, b } of g.list) {
          el.setAttribute('style', styleWith(prior, { left: `${Math.round(b.x + wx)}px`, top: `${Math.round(b.y + wy)}px` }));
        }
        paintChrome();
        break;
      }
      case 'marquee': {
        const x = Math.min(p.x, g.p.x);
        const y = Math.min(p.y, g.p.y);
        Object.assign(g.el.style, { left: `${x}px`, top: `${y}px`, width: `${Math.abs(dx)}px`, height: `${Math.abs(dy)}px` });
        if (!far) return;
        const a = toWorld({ x, y });
        const r = { x: a.x, y: a.y, w: Math.abs(dx) / cam.z, h: Math.abs(dy) / cam.z };
        const hit = items().filter((el) => (kindOf(el) === 'frame' ? inside(box(el), r) : overlaps(box(el), r)));
        select([...new Set([...g.base, ...hit])], { hand: true });
        break;
      }
      case 'draw': {
        const pw = toWorld(p);
        const last = g.pts[g.pts.length - 1];
        if (Math.hypot(pw.x - last.x, pw.y - last.y) < 1.2 / cam.z) return;
        const events = e.getCoalescedEvents?.() ?? [];
        if (events.length > 1) {
          for (const ce of events) {
            const q = toWorld(local(ce));
            const l = g.pts[g.pts.length - 1];
            if (Math.hypot(q.x - l.x, q.y - l.y) >= 1.2 / cam.z) g.pts.push(q);
          }
        } else g.pts.push(pw);
        drawLive();
        break;
      }
      case 'erase':
        eraseAt(p);
        break;
      case 'place':
        if (g.kind !== 'frame' || !far) return;
        if (!g.rect) { g.rect = h('div', 'marquee'); overlay.append(g.rect); }
        Object.assign(g.rect.style, { left: `${Math.min(p.x, g.p.x)}px`, top: `${Math.min(p.y, g.p.y)}px`, width: `${Math.abs(dx)}px`, height: `${Math.abs(dy)}px` });
        g.end = p;
        break;
      case 'resize':
        resizeMove(p);
        break;
      default:
    }
  });

  const endPointer = (e) => {
    pointers.delete(e.pointerId);
    if (pinch) {
      if (pointers.size < 2) pinch = null;
      return;
    }
    if (!g || g.id !== e.pointerId) return;
    const done = g;
    g = null;
    body.classList.remove('marble-panning', 'marble-moving');
    const cancelled = e.type === 'pointercancel';
    switch (done.type) {
      case 'pan':
        if (done.tap && !cancelled) clearSelection();
        break;
      case 'move': {
        if (done.moved) {
          const redo = [];
          const undo = [];
          for (const { el, prior } of done.list) {
            const id = M?.id(el);
            const value = el.getAttribute('style');
            if (!id || value === prior) continue;
            redo.push({ type: 'setAttr', id, name: 'style', value });
            undo.push({ type: 'setAttr', id, name: 'style', value: prior });
          }
          file(redo, undo);
        } else if (!cancelled && done.wasSelected && selected.size === 1 && hasWords(done.item) && !(e.shiftKey || e.metaKey)) {
          // A second press on the one thing in hand is a press into its words.
          edit(done.item, { clientX: done.clientX, clientY: done.clientY });
        }
        paintChrome();
        break;
      }
      case 'marquee':
        done.el.remove();
        break;
      case 'draw':
        done.live.remove();
        if (!cancelled) finishStroke(done);
        break;
      case 'erase':
        done.dot.remove();
        if (done.hit.size && M) commit([...done.hit].filter((el) => M.id(el)).map((el) => ({ type: 'remove', id: M.id(el) })));
        break;
      case 'place': {
        done.rect?.remove();
        if (cancelled) break;
        const pw = done.pw;
        if (done.kind === 'note') add('note', { x: pw.x - 110, y: pw.y - 40 }, { edit: true });
        else if (done.kind === 'text') add('text', { x: pw.x - 4, y: pw.y - 16 }, { edit: true });
        else {
          const a = done.end ? toWorld(done.end) : null;
          const r = a && Math.abs(a.x - pw.x) > 40 && Math.abs(a.y - pw.y) > 30
            ? { x: Math.min(a.x, pw.x), y: Math.min(a.y, pw.y), w: Math.abs(a.x - pw.x), h: Math.abs(a.y - pw.y) }
            : { x: pw.x - 280, y: pw.y - 190, w: 560, h: 380 };
          add('frame', r, { edit: true, back: true });
        }
        setTool('select');
        break;
      }
      case 'resize':
        if (cancelled) done.el.setAttribute('style', done.prior);
        else resizeEnd(done);
        break;
      default:
    }
  };
  stage.addEventListener('pointerup', endPointer);
  stage.addEventListener('pointercancel', endPointer);
  stage.addEventListener('lostpointercapture', (e) => { if (g?.id === e.pointerId) endPointer(e); });
  stage.addEventListener('pointerleave', () => { if (tool === 'eraser' && !g) eraserDot?.remove(); });

  function abortGesture() {
    if (!g) return;
    if (g.type === 'draw') g.live.remove();
    if (g.type === 'marquee') g.el.remove();
    if (g.type === 'erase') { g.dot.remove(); for (const el of g.hit) el.classList.remove('marble-erasing'); }
    if (g.type === 'place') g.rect?.remove();
    if (g.type === 'move' && g.moved) for (const { el, prior } of g.list) el.setAttribute('style', prior);
    if (g.type === 'resize') resizeAbort();
    g = null;
    body.classList.remove('marble-panning', 'marble-moving');
    paintChrome();
  }

  stage.addEventListener('dblclick', (e) => {
    if (hudHit(e.target) || tool !== 'select') return;
    const item = itemAt(e.target);
    if (item) {
      if (hasWords(item)) edit(item, e);
      return;
    }
    if (e.target === stage || e.target === world || e.target.closest?.('.frame')) {
      const pw = toWorld(local(e));
      add('note', { x: pw.x - 110, y: pw.y - 40 }, { edit: true });
    }
  });
  // An anchor on a card is a way out, but only once the card is in hand.
  world.addEventListener('click', (e) => {
    const a = e.target.closest('a');
    if (!a) return;
    const item = itemAt(a);
    if (item && !selected.has(item)) e.preventDefault();
  });

  // ------------------------------------------------------------------ ink

  function smooth(pts) {
    if (pts.length === 1) return `M${r1(pts[0].x)} ${r1(pts[0].y)}l0.01 0`;
    let d = `M${r1(pts[0].x)} ${r1(pts[0].y)}`;
    for (let i = 1; i < pts.length - 1; i += 1) {
      const a = pts[i];
      const b = pts[i + 1];
      d += `Q${r1(a.x)} ${r1(a.y)} ${r1((a.x + b.x) / 2)} ${r1((a.y + b.y) / 2)}`;
    }
    const z = pts[pts.length - 1];
    return `${d}L${r1(z.x)} ${r1(z.y)}`;
  }
  function drawLive() { g.path.setAttribute('d', smooth(g.pts)); }
  function finishStroke(s) {
    if (!M) return;
    const pad = s.width / 2 + 2;
    const xs = s.pts.map((p) => p.x);
    const ys = s.pts.map((p) => p.y);
    const x = Math.floor(Math.min(...xs) - pad);
    const y = Math.floor(Math.min(...ys) - pad);
    const w = Math.max(...xs) + pad - x;
    const hh = Math.max(...ys) + pad - y;
    const d = smooth(s.pts.map((p) => ({ x: p.x - x, y: p.y - y })));
    const op = insertOp(HTML.ink({ x, y, w, h: hh, d, width: s.width, color: s.color, pen: s.pen }));
    commit([op]);
  }
  let eraserDot = null;
  function showEraser(p) {
    if (!eraserDot) eraserDot = h('div', 'eraser-dot');
    if (!eraserDot.isConnected) overlay.append(eraserDot);
    eraserDot.style.left = `${p.x}px`;
    eraserDot.style.top = `${p.y}px`;
  }
  function eraseAt(p) {
    g.dot.style.left = `${p.x}px`;
    g.dot.style.top = `${p.y}px`;
    eraserDot?.remove();
    const el = inkUnder(toWorld(p), 10 / cam.z);
    if (el && !g.hit.has(el)) { g.hit.add(el); el.classList.add('marble-erasing'); }
  }

  // --------------------------------------------------------------- resize

  function startResize(e) {
    const el = [...selected][0];
    if (!el || selected.size !== 1) return;
    e.preventDefault();
    e.stopPropagation();
    stopEditing();
    stage.setPointerCapture(e.pointerId);
    pointers.set(e.pointerId, local(e));
    const b = box(el);
    g = { type: 'resize', id: e.pointerId, p: local(e), el, b, prior: el.getAttribute('style'), kind: kindOf(el) };
  }
  function resizeMove(p) {
    const { el, b, prior, kind } = g;
    const dx = (p.x - g.p.x) / cam.z;
    const dy = (p.y - g.p.y) / cam.z;
    const minW = { note: 120, text: 60, media: 120, frame: 160, ink: 12 }[kind] ?? 140;
    if (kind === 'frame') {
      el.setAttribute('style', styleWith(prior, { width: `${Math.round(Math.max(minW, b.w + dx))}px`, height: `${Math.round(Math.max(120, b.h + dy))}px` }));
    } else if (kind === 'ink') {
      const k = Math.max(minW / b.w, (b.w + dx) / b.w, (b.h + dy) / b.h);
      el.setAttribute('style', styleWith(prior, { width: `${Math.round(b.w * k)}px`, height: `${Math.round(b.h * k)}px` }));
    } else {
      el.setAttribute('style', styleWith(prior, { width: `${Math.round(Math.max(minW, b.w + dx))}px` }));
    }
    paintChrome();
  }
  function resizeEnd(r) {
    const value = r.el.getAttribute('style');
    const id = M?.id(r.el);
    if (id && value !== r.prior) file([{ type: 'setAttr', id, name: 'style', value }], [{ type: 'setAttr', id, name: 'style', value: r.prior }]);
    paintChrome();
  }
  function resizeAbort() { if (g?.el) g.el.setAttribute('style', g.prior); }
  // The resize handle's own gesture lands in endPointer through the stage.

  // ------------------------------------------------------------ the wheel

  stage.addEventListener('wheel', (e) => {
    if (hudHit(e.target)) return;
    e.preventDefault();
    const unit = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? 400 : 1;
    const p = local(e);
    if (e.ctrlKey || e.metaKey) zoomAt(p, cam.z * Math.exp(-e.deltaY * unit * (e.ctrlKey && !e.metaKey && Math.abs(e.deltaY) < 50 ? 0.012 : 0.004)));
    else {
      cam.x -= (e.shiftKey && !e.deltaX ? e.deltaY : e.deltaX) * unit;
      cam.y -= (e.shiftKey && !e.deltaX ? 0 : e.deltaY) * unit;
      paintCam();
    }
  }, { passive: false });
  for (const type of ['gesturestart', 'gesturechange']) stage.addEventListener(type, (e) => e.preventDefault());

  // ---------------------------------------------------------------- media

  // Files put on the board live in the drive, in a folder beside it, so the
  // board is a page of references and Claude can open every one of them.
  const mediaFolder = () => {
    const app = M?.app ?? 'Board';
    const at = app.lastIndexOf('/');
    return at >= 0 ? `${app.slice(0, at)}/${app.slice(at + 1)} media` : `${app} media`;
  };
  async function putFile(file) {
    const name = file.name || `pasted-${new Date().toISOString().replace(/[:.]/g, '-')}.${(file.type.split('/')[1] || 'bin').replace('jpeg', 'jpg').replace(/\+.*/, '')}`;
    const answer = await drive().uploadFile({ folder: mediaFolder(), name, file });
    if (!answer?.path) throw new Error(answer?.error || 'upload failed');
    return { path: answer.path, name };
  }
  const sizeLabel = (n) => (n > 1e6 ? `${(n / 1e6).toFixed(1)} MB` : n > 1e3 ? `${Math.round(n / 1e3)} KB` : `${n} B`);
  async function imageSize(file) {
    try {
      const bmp = await createImageBitmap(file);
      const s = { w: bmp.width, h: bmp.height };
      bmp.close?.();
      return s;
    } catch {
      return new Promise((resolve) => {
        const img = new Image();
        const url = URL.createObjectURL(file);
        img.onload = () => { resolve({ w: img.naturalWidth || 400, h: img.naturalHeight || 300 }); URL.revokeObjectURL(url); };
        img.onerror = () => { resolve({ w: 400, h: 300 }); URL.revokeObjectURL(url); };
        img.src = url;
      });
    }
  }
  // A document dropped in is a document in the drive, not a file that would
  // open as its own source: it goes through the door documents come in by.
  const DOC_FILE = /\.(mrbl|html?)$/i;
  async function putDoc(file) {
    const name = file.name.replace(DOC_FILE, '');
    const answer = await drive().upload({ folder: mediaFolder(), name, source: await file.text() });
    if (!answer?.path) throw new Error(answer?.error || 'upload failed');
    return { path: answer.path, title: name };
  }
  const IMAGE_EXT = new Set(['png', 'jpg', 'jpeg', 'gif', 'webp', 'avif', 'svg', 'bmp', 'ico']);
  const VIDEO_EXT = new Set(['mp4', 'm4v', 'mov', 'webm', 'ogv']);
  const AUDIO_EXT = new Set(['mp3', 'wav', 'm4a', 'aac', 'ogg', 'flac', 'opus']);
  function urlImageSize(src) {
    return new Promise((resolve) => {
      const img = new Image();
      img.onload = () => resolve({ w: img.naturalWidth || 400, h: img.naturalHeight || 300 });
      img.onerror = () => resolve({ w: 400, h: 300 });
      img.src = src;
    });
  }
  const imageWidth = (s) => Math.round(clamp(Math.min(360, s.w, 420 * s.w / (s.h || 1)), 120, 480));

  /** Something already in the drive, put on the board by reference: the card
   *  points at the file, and nothing is copied. */
  async function addRef(entry, at = viewCentreWorld()) {
    const path = entry.path;
    if (entry.kind === 'doc') return add('doc', { x: at.x - 150, y: at.y - 120, path, title: entry.title || path.split('/').pop() });
    const ext = (entry.ext || extOf(path)).toLowerCase();
    const name = path.split('/').pop();
    if (IMAGE_EXT.has(ext)) {
      const s = await urlImageSize(fileHref(path));
      const w = imageWidth(s);
      return add('image', { x: at.x - w / 2, y: at.y - 80, w, path, name, ratio: `${s.w} / ${s.h}` });
    }
    if (VIDEO_EXT.has(ext)) return add('video', { x: at.x - 180, y: at.y - 110, path, name });
    if (AUDIO_EXT.has(ext)) return add('audio', { x: at.x - 160, y: at.y - 40, path, name });
    if (ext === 'pdf') return add('pdf', { x: at.x - 150, y: at.y - 150, path, name, size: entry.bytes ? sizeLabel(entry.bytes) : '' });
    return add('file', { x: at.x - 140, y: at.y - 50, path, name, size: entry.bytes ? sizeLabel(entry.bytes) : '' });
  }
  async function addRefs(entries, at = viewCentreWorld()) {
    const added = [];
    for (const [i, entry] of entries.entries()) {
      const el = await addRef(entry, { x: at.x + i * 32, y: at.y + i * 32 });
      if (el) added.push(el);
    }
    if (added.length) select(added);
  }
  /** A link to this drive is a reference to something in it. */
  function driveRefOf(url) {
    let u;
    try { u = new URL(url, location.href); } catch { return null; }
    if (u.origin !== location.origin) return null;
    if (u.pathname.startsWith('/a/')) {
      const path = u.pathname.slice(3).split('/').map(decodeURIComponent).join('/');
      return path && path !== HERE_DOC() ? { kind: 'doc', path } : null;
    }
    if (u.pathname === '/drive/file' && u.searchParams.get('path')) return { kind: 'file', path: u.searchParams.get('path') };
    return null;
  }
  const HERE_DOC = () => M?.app ?? decodeURIComponent(location.pathname.replace(/^\/a\//, ''));

  async function addFiles(files, at = viewCentreWorld()) {
    if (!M) { say('Open this in Marble Drive to add files'); return; }
    const added = [];
    let i = 0;
    for (const file of files) {
      const spot = { x: at.x + i * 28, y: at.y + i * 28 };
      i += 1;
      const ghost = h('div', 'ghost', `Uploading ${file.name || 'image'}…`);
      ghost.setAttribute('data-marble-transient', '');
      ghost.style.left = `${spot.x - 110}px`;
      ghost.style.top = `${spot.y - 30}px`;
      world.append(ghost);
      try {
        const type = file.type || '';
        let props = null;
        let kind = 'file';
        if (DOC_FILE.test(file.name || '')) {
          const saved = await putDoc(file);
          ghost.remove();
          const el = add('doc', { x: spot.x - 150, y: spot.y - 120, path: saved.path, title: saved.title });
          if (el) added.push(el);
          continue;
        }
        if (type === 'application/pdf' || /\.pdf$/i.test(file.name || '')) kind = 'pdf';
        else if (type.startsWith('image/')) {
          const s = await imageSize(file);
          const w = Math.round(clamp(Math.min(360, s.w, 420 * s.w / (s.h || 1)), 120, 480));
          kind = 'image';
          props = { w, ratio: `${s.w} / ${s.h}` };
        } else if (type.startsWith('video/')) kind = 'video';
        else if (type.startsWith('audio/')) kind = 'audio';
        const saved = await putFile(file);
        ghost.remove();
        const w = props?.w ?? (kind === 'video' ? 360 : 300);
        if (kind === 'pdf') { const el = add('pdf', { x: spot.x - 150, y: spot.y - 150, path: saved.path, name: saved.name, size: sizeLabel(file.size) }); if (el) added.push(el); continue; }
        const el = add(kind, { x: spot.x - w / 2, y: spot.y - 60, ...props, path: saved.path, name: saved.name, size: sizeLabel(file.size) });
        if (el) added.push(el);
      } catch (err) {
        ghost.classList.add('marble-failed');
        ghost.textContent = `Couldn’t add ${file.name || 'that'} — ${err.message}`;
        setTimeout(() => ghost.remove(), 5000);
      }
    }
    if (added.length) select(added);
  }
  $('[data-cmd="media"]').addEventListener('click', () => picker.click());
  picker.addEventListener('change', () => {
    const files = [...picker.files];
    picker.value = '';
    picker.blur();
    if (files.length) addFiles(files);
  });

  let dragDepth = 0;
  stage.addEventListener('dragenter', (e) => {
    if (![...(e.dataTransfer?.types ?? [])].some((t) => t === 'Files' || t === 'text/uri-list' || t === REF_TYPE)) return;
    e.preventDefault();
    dragDepth += 1;
    body.classList.add('marble-dropping');
  });
  stage.addEventListener('dragover', (e) => { if (body.classList.contains('marble-dropping')) e.preventDefault(); });
  stage.addEventListener('dragleave', () => { dragDepth = Math.max(0, dragDepth - 1); if (!dragDepth) body.classList.remove('marble-dropping'); });
  stage.addEventListener('drop', (e) => {
    dragDepth = 0;
    body.classList.remove('marble-dropping');
    const dt = e.dataTransfer;
    if (!dt) return;
    e.preventDefault();
    const at = toWorld(local(e));
    const refs = dt.getData(REF_TYPE);
    if (refs) { try { addRefs(JSON.parse(refs), at); } catch {} return; }
    const files = [...dt.files];
    if (files.length) { addFiles(files, at); return; }
    const url = normaliseUrl((dt.getData('text/uri-list') || dt.getData('text/plain') || '').split('\n')[0]);
    const ref = url && driveRefOf(url);
    if (ref) addRef(ref, at);
    else if (url) add('link', { x: at.x - 140, y: at.y - 50, url });
  });

  // Paste onto the board: a picture becomes a picture, a link a link card,
  // words a note, and what was copied from the board comes back as itself.
  document.addEventListener('paste', (e) => {
    if (editing || isTyping(e.target)) return;
    const dt = e.clipboardData;
    if (!dt) return;
    const files = [...dt.files];
    const at = lastPointer ? toWorld(lastPointer) : viewCentreWorld();
    if (files.length) { e.preventDefault(); addFiles(files, at); return; }
    const text = dt.getData('text/plain');
    if (clip && text === clip.text) { e.preventDefault(); pasteClip(); return; }
    if (!text?.trim()) return;
    e.preventDefault();
    const ref = looksLikeUrl(text) ? driveRefOf(normaliseUrl(text)) : null;
    if (ref) addRef(ref, at);
    else if (looksLikeUrl(text)) add('link', { x: at.x - 140, y: at.y - 50, url: normaliseUrl(text) });
    else add('note', { x: at.x - 110, y: at.y - 40, text: text.trim().slice(0, 4000) });
  });
  document.addEventListener('copy', (e) => {
    if (editing || isTyping(e.target) || !selected.size) return;
    const c = copySelection();
    if (!c) return;
    c.n = 0;
    e.preventDefault();
    e.clipboardData.setData('text/plain', c.text);
  });
  document.addEventListener('cut', (e) => {
    if (editing || isTyping(e.target) || !selected.size) return;
    const c = copySelection();
    if (!c) return;
    c.n = -1;
    e.preventDefault();
    e.clipboardData.setData('text/plain', c.text);
    removeSelected();
  });
  let lastPointer = null;
  stage.addEventListener('pointermove', (e) => { lastPointer = local(e); }, { passive: true });

  // ------------------------------------------------------------- keyboard

  const isTyping = (t) => Boolean(t?.closest?.('input:not([type="file"], [type="button"], [type="checkbox"]), textarea, select, [contenteditable]:not([contenteditable="false"])'));
  const TOOL_KEYS = { v: 'select', h: 'hand', n: 'note', t: 'text', s: 'frame', p: 'pen', m: 'marker', e: 'eraser', l: 'link' };
  addEventListener('keydown', (e) => {
    const mod = e.metaKey || e.ctrlKey;
    const k = e.key.toLowerCase();
    if (mod && k === 'k') { e.preventDefault(); togglePanel(); return; }
    if (editing) {
      if (e.key === 'Escape') { e.preventDefault(); const it = editing.item; stopEditing(); if (it) select([it]); }
      else if (e.key === 'Enter' && (mod || (editing.item && kindOf(editing.item) === 'frame'))) { e.preventDefault(); stopEditing(); }
      return;
    }
    if (isTyping(e.target)) return;
    if (e.key === ' ' && !e.repeat) { spaceHeld = true; body.classList.add('marble-space'); e.preventDefault(); return; }
    // Mod+Z and Mod+Shift+Z / Mod+Y are the composed `history` part's, below.
    if (mod && (k === 'z' || k === 'y')) return;
    if (mod && k === 'a') { e.preventDefault(); select(items(), { hand: true }); return; }
    if (mod && k === 'd') { e.preventDefault(); duplicate(); return; }
    if (mod && k === '0') { e.preventDefault(); zoomAt(centre(), 1); return; }
    if (mod && (k === '=' || k === '+')) { e.preventDefault(); zoomAt(centre(), cam.z * 1.25); return; }
    if (mod && k === '-') { e.preventDefault(); zoomAt(centre(), cam.z / 1.25); return; }
    if (mod) return;
    if (e.shiftKey && (e.key === '!' || e.code === 'Digit1')) { e.preventDefault(); fit(); return; }
    if (e.shiftKey && (e.key === '@' || e.code === 'Digit2') && selected.size) { e.preventDefault(); fit([...selected]); return; }
    if (e.key === 'Escape') { if (tool !== 'select') setTool('select'); else clearSelection(); return; }
    if ((e.key === 'Backspace' || e.key === 'Delete') && selected.size) { e.preventDefault(); removeSelected(); return; }
    if (e.key === 'Enter' && selected.size === 1) { const it = [...selected][0]; if (hasWords(it)) { e.preventDefault(); edit(it); } return; }
    if (e.key === ']' && selected.size) { restack(true); return; }
    if (e.key === '[' && selected.size) { restack(false); return; }
    if ((e.key === '=' || e.key === '+')) { zoomAt(centre(), cam.z * 1.2); return; }
    if (e.key === '-') { zoomAt(centre(), cam.z / 1.2); return; }
    if (k === 'i' && !e.shiftKey) { picker.click(); return; }
    if (k === 'd' && !e.shiftKey) { e.preventDefault(); openPick('board'); return; }
    const by = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] }[e.key];
    if (by && selected.size && M) {
      e.preventDefault();
      const step = e.shiftKey ? 10 : 1;
      const redo = [];
      const undo = [];
      for (const el of selected) {
        const id = M.id(el);
        if (!id) continue;
        const prior = el.getAttribute('style');
        const b = box(el);
        const value = styleWith(prior, { left: `${Math.round(b.x + by[0] * step)}px`, top: `${Math.round(b.y + by[1] * step)}px` });
        el.setAttribute('style', value);
        redo.push({ type: 'setAttr', id, name: 'style', value });
        undo.push({ type: 'setAttr', id, name: 'style', value: prior });
      }
      file(redo, undo);
      paintChrome();
      return;
    }
    if (TOOL_KEYS[k] && !e.shiftKey && !e.altKey) { e.preventDefault(); setTool(TOOL_KEYS[k]); }
  });
  addEventListener('keyup', (e) => { if (e.key === ' ') { spaceHeld = false; body.classList.remove('marble-space'); } });
  addEventListener('blur', () => { spaceHeld = false; body.classList.remove('marble-space'); });

  // ------------------------------------------------------------- the view

  document.addEventListener('click', (e) => {
    const cmd = e.target.closest('[data-cmd]')?.dataset.cmd;
    if (!cmd) return;
    if (cmd === 'zoom-in') zoomAt(centre(), cam.z * 1.25);
    else if (cmd === 'zoom-out') zoomAt(centre(), cam.z / 1.25);
    else if (cmd === 'zoom-reset') zoomAt(centre(), 1);
    else if (cmd === 'fit') fit();
    else if (cmd === 'undo') M?.undo();
    else if (cmd === 'redo') M?.redo();
    else if (cmd === 'panel') togglePanel();
    else if (cmd === 'new-thread') newThread();
    else if (cmd === 'drive') { if (pick.el.hidden || pick.mode !== 'board') openPick('board'); else closePick(); }
  });

  // ---------------------------------------------------------- the drive

  // One list of what is in the drive, for two uses: putting a thing on the
  // board (the dock's button, D, or dragging a row onto the board), and
  // pointing at one in a message (@ in the field).
  const REF_TYPE = 'application/x-marble-ref';
  const pick = { el: $('.drivepick'), mode: 'board', entries: null, at: 0, list: [], index: 0, mentionAt: -1 };
  pick.input = $('input', pick.el);
  pick.rows = $('.rows', pick.el);
  pick.label = $('.k', pick.el);
  async function driveEntries() {
    if (pick.entries && Date.now() - pick.at < 20_000) return pick.entries;
    const tree = await window.marble?.drive?.tree().catch(() => null);
    const out = [];
    const walk = (node) => {
      for (const c of node?.children ?? []) {
        if (c.name?.startsWith('.') || String(c.path).startsWith('.')) continue;
        if (c.kind === 'folder') walk(c);
        else if (c.path !== HERE_DOC()) out.push(c);
      }
    };
    walk(tree);
    out.sort((a, b) => (b.modified ?? 0) - (a.modified ?? 0));
    pick.entries = out;
    pick.at = Date.now();
    return out;
  }
  const entryIcon = (e) => {
    if (e.kind === 'doc') return 'doc';
    const ext = extOf(e.path);
    if (IMAGE_EXT.has(ext)) return 'image';
    if (VIDEO_EXT.has(ext)) return 'play';
    if (AUDIO_EXT.has(ext)) return 'sound';
    if (ext === 'pdf') return 'pdf';
    return 'file';
  };
  const folderOf = (p) => { const at = String(p).lastIndexOf('/'); return at >= 0 ? p.slice(0, at) : 'My Drive'; };
  function positionPick() {
    const el = pick.el;
    if (pick.mode === 'mention') {
      const f = $('.field', panel).getBoundingClientRect();
      el.style.width = `${Math.round(f.width)}px`;
      el.style.left = `${Math.round(f.left)}px`;
      el.style.bottom = `${Math.round(innerHeight - f.top + 8)}px`;
    } else {
      const r = stageRect();
      const w = Math.min(27 * 16, innerWidth - 24);
      el.style.width = '';
      el.style.left = `${Math.round(clamp(r.left + r.width / 2 - w / 2, 12, innerWidth - w - 12))}px`;
      el.style.bottom = `${Math.round(innerHeight - r.bottom + 70)}px`;
    }
  }
  async function openPick(mode, query = '') {
    pick.mode = mode;
    pick.el.classList.toggle('marble-mention', mode === 'mention');
    const was = pick.el.hidden;
    pick.el.hidden = false;
    positionPick();
    if (mode === 'board' && was) {
      pick.input.value = '';
      pick.input.focus({ preventScroll: true });
    }
    pick.label.textContent = mode === 'board' ? 'Click to put it on the board, or drag it where it goes' : 'Point Claude at a document or file';
    if (!pick.entries) pick.rows.replaceChildren(h('p', 'none', 'Looking through the drive…'));
    await driveEntries();
    paintPick(mode === 'board' ? pick.input.value : query);
  }
  function closePick() {
    pick.el.hidden = true;
    pick.mentionAt = -1;
  }
  function paintPick(query) {
    const words = String(query ?? '').toLowerCase().split(/\s+/).filter(Boolean);
    const all = pick.entries ?? [];
    pick.list = all.filter((e) => { const hay = `${e.title ?? ''} ${e.path}`.toLowerCase(); return words.every((w) => hay.includes(w)); }).slice(0, 60);
    pick.index = 0;
    if (!pick.list.length) { pick.rows.replaceChildren(h('p', 'none', all.length ? 'Nothing in the drive matches that.' : 'The drive is empty.')); return; }
    pick.rows.replaceChildren(...pick.list.map((e, i) => {
      const b = h('button', 'drow');
      b.type = 'button';
      b.setAttribute('role', 'option');
      b.setAttribute('aria-selected', String(i === 0));
      const text = h('span');
      text.append(h('b', '', e.kind === 'doc' ? (e.title || e.path.split('/').pop()) : e.path.split('/').pop()), h('small', '', `${folderOf(e.path)}${e.kind === 'doc' ? ' · document' : e.bytes ? ` · ${sizeLabel(e.bytes)}` : ''}`));
      b.append(icon(entryIcon(e)), text);
      b.addEventListener('pointerdown', (ev) => { if (pick.mode === 'mention') ev.preventDefault(); });
      b.addEventListener('click', (ev) => choose(e, ev.shiftKey));
      if (pick.mode === 'board') {
        b.draggable = true;
        b.addEventListener('dragstart', (ev) => {
          ev.dataTransfer.setData(REF_TYPE, JSON.stringify([e]));
          ev.dataTransfer.setData('text/plain', e.path);
          ev.dataTransfer.effectAllowed = 'copy';
          requestAnimationFrame(() => { pick.el.style.opacity = '.35'; });
        });
        b.addEventListener('dragend', () => { pick.el.style.opacity = ''; });
      }
      return b;
    }));
  }
  function movePick(by) {
    const rows = $$('.drow', pick.rows);
    if (!rows.length) return;
    pick.index = (pick.index + by + rows.length) % rows.length;
    rows.forEach((r, i) => r.setAttribute('aria-selected', String(i === pick.index)));
    rows[pick.index].scrollIntoView({ block: 'nearest' });
  }
  function choose(entry, keepOpen = false) {
    if (!entry) return;
    if (pick.mode === 'mention') { insertMention(entry); return; }
    if (!keepOpen) closePick();
    addRef(entry);
  }
  pick.input.addEventListener('input', () => paintPick(pick.input.value));
  pick.input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); movePick(1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); movePick(-1); }
    else if (e.key === 'Enter') { e.preventDefault(); choose(pick.list[pick.index], e.shiftKey); }
    else if (e.key === 'Escape') { e.preventDefault(); closePick(); }
  });
  document.addEventListener('pointerdown', (e) => {
    if (pick.el.hidden || pick.el.contains(e.target) || e.target.closest?.('[data-cmd="drive"]')) return;
    if (pick.mode === 'mention' && e.target === input) return;
    closePick();
  }, true);
  addEventListener('resize', () => { if (!pick.el.hidden) positionPick(); });
  // ---------------------------------------------------------------- peeks

  // A card for a document, a PDF or an office file shows the thing itself.
  // The frame is transient, mounted afresh from data-path whenever a card is
  // on the board without one, so an undo, a paste or another tab gets it too.
  const THUMBABLE = new Set(['doc', 'docx', 'rtf', 'pages', 'odt', 'ppt', 'pptx', 'key', 'odp', 'xls', 'xlsx', 'numbers', 'ods', 'epub', 'psd', 'heic', 'tif', 'tiff']);
  const noThumb = new Set();
  function mountPeeks() {
    for (const card of world.querySelectorAll(':scope > .card[data-path]')) {
      if (card.querySelector(':scope > .peek')) continue;
      const kind = kindOf(card);
      const path = card.dataset.path;
      if (kind === 'file' && (!THUMBABLE.has(extOf(path)) || noThumb.has(path))) continue;
      if (!['doc', 'pdf', 'file'].includes(kind)) continue;
      const peek = h('div', 'peek');
      peek.setAttribute('data-marble-transient', '');
      const glyph = h('div', 'glyph');
      glyph.append(icon(kind === 'doc' ? 'doc' : kind === 'pdf' ? 'pdf' : 'file'));
      peek.append(glyph);
      if (kind === 'file' || (kind === 'pdf' && !noThumb.has(path))) {
        const img = h('img');
        img.alt = '';
        img.loading = 'lazy';
        img.addEventListener('load', () => peek.classList.add('marble-loaded'));
        img.addEventListener('error', () => { noThumb.add(path); peek.remove(); if (kind === 'pdf') mountPeeks(); });
        img.src = window.marble?.drive?.thumbHref(path, { w: 640 }) ?? '';
        peek.append(img);
      } else {
        const frame = document.createElement('iframe');
        // A document drawn with an empty sandbox renders and runs nothing: a
        // picture of the file, not a second live copy of it.
        if (kind === 'doc') frame.setAttribute('sandbox', '');
        frame.setAttribute('tabindex', '-1');
        frame.setAttribute('aria-hidden', 'true');
        frame.setAttribute('scrolling', 'no');
        frame.loading = 'lazy';
        frame.addEventListener('load', () => peek.classList.add('marble-loaded'));
        frame.src = kind === 'doc' ? docHref(path) : `${fileHref(path)}#toolbar=0&navpanes=0&scrollbar=0&view=FitH`;
        peek.append(frame);
      }
      card.querySelector(':scope > .kicker')?.after(peek);
    }
  }
  mountPeeks();

  new ResizeObserver(() => paintChrome()).observe(stage);
  // Anything that changes the board — an undo, another tab, Claude — changes
  // the DOM, and the chrome is drawn from the DOM.
  new MutationObserver(() => { mountPeeks(); paintChrome(); paintScope(); }).observe(world, { childList: true, subtree: true, attributes: true, attributeFilter: ['style', 'data-color', 'data-size'] });

  /** A fact on <body>: the page moves, and the file is told once. */
  const setFact = (name, value) => {
    if (body.getAttribute(name) === value) return;
    body.setAttribute(name, value);
    const id = M?.id(body);
    if (id) M.op({ type: 'setAttr', id, name, value });
  };

  // ================================================================ Claude

  const panel = $('.panel');
  const log = $('.log', panel);
  const thread = $('.thread', panel);
  const input = $('.field textarea', panel);
  const sendBtn = $('.send', panel);
  const scopeEl = $('.scope', panel);
  const titleEl = $('.panel-bar .title', panel);
  const modelBtn = $('.model', panel);
  const modelMenu = $('#bw-models');
  const threadMenu = $('#bw-threads');
  const UI = () => window.marbleAgentUI;

  let agent = null;
  let HERE = null;
  let provider = null;
  let view = { id: null, turns: new Map(), running: null, seen: 0, off: null, meta: null };
  let scopeForce = null; // 'board' when the person asked for the whole board despite a selection

  function togglePanel() { openPanel(body.dataset.panel !== 'open'); }
  function openPanel(open) {
    setFact('data-panel', open ? 'open' : 'closed');
    if (open) {
      scopeForce = null;
      paintScope();
      if (!coarse.matches) requestAnimationFrame(() => input.focus({ preventScroll: true }));
    }
    requestAnimationFrame(() => paintChrome());
  }

  // What goes with the next message: the selection if there is one, else
  // the whole board. Said on a chip above the field so it is never a guess.
  const bySelection = () => Boolean(selected.size && picked && scopeForce !== 'board');
  const scopeItems = () => (bySelection() ? items().filter((el) => selected.has(el)) : items());
  function paintScope() {
    const sel = bySelection();
    const n = sel ? selected.size : items().length;
    const chip = h('span', 'chip');
    chip.dataset.scope = sel ? 'selection' : 'board';
    chip.append(icon(sel ? 'select' : 'board'), h('span', '', sel ? (n === 1 ? '1 selected thing goes with it' : `${n} selected things go with it`) : `The whole board goes with it · ${n}`));
    const parts = [chip];
    if (sel) {
      const b = h('button', '', 'Send the whole board');
      b.type = 'button';
      b.addEventListener('click', () => { scopeForce = 'board'; paintScope(); });
      parts.push(b);
    } else if (selected.size) {
      const b = h('button', '', 'Just the selection');
      b.type = 'button';
      b.addEventListener('click', () => { scopeForce = null; picked = true; paintScope(); });
      parts.push(b);
    }
    scopeEl.replaceChildren(...parts);
    paintSend();
  }

  // ----------------------------------------------------- what Claude sees

  const cs = (el) => getComputedStyle(el);
  function wrapLines(g2, text, maxW) {
    const out = [];
    for (const para of String(text).split('\n')) {
      const words = para.split(/(\s+)/);
      let line = '';
      for (const w of words) {
        const next = line + w;
        if (g2.measureText(next).width > maxW && line.trim()) { out.push(line.trimEnd()); line = w.trimStart(); }
        else line = next;
        while (g2.measureText(line).width > maxW && line.length > 1) {
          let cut = line.length - 1;
          while (cut > 1 && g2.measureText(line.slice(0, cut)).width > maxW) cut -= 1;
          out.push(line.slice(0, cut));
          line = line.slice(cut);
        }
      }
      out.push(line);
    }
    return out;
  }
  function roundRect(g2, x, y, w, hh, r) {
    g2.beginPath();
    if (g2.roundRect) g2.roundRect(x, y, w, hh, r);
    else g2.rect(x, y, w, hh);
  }
  function drawWords(g2, el, x, y, w, maxH) {
    const words = el.querySelector(':scope > .words');
    if (!words) return;
    const text = wordsOf(el);
    if (!text) return;
    const s = cs(words);
    const size = parseFloat(s.fontSize) || 15;
    const lh = parseFloat(s.lineHeight) || size * 1.4;
    g2.font = `${s.fontWeight} ${size}px ${s.fontFamily}`;
    g2.fillStyle = s.color;
    g2.textBaseline = 'top';
    const lines = wrapLines(g2, text, w);
    const most = Math.max(1, Math.floor(maxH / lh));
    lines.slice(0, most).forEach((line, i) => g2.fillText(line, x, y + i * lh + (lh - size) / 2));
  }
  /** The board as a picture, drawn from the same DOM the person sees, so the
   *  sketches — which have no words — reach Claude as what they look like. */
  async function snapshot(list) {
    const boxes = list.map((el) => ({ el, b: box(el) }));
    const u = union(boxes.map((x) => x.b));
    const pad = 32;
    const W = u.w + pad * 2;
    const H = u.h + pad * 2;
    const scale = clamp(1800 / Math.max(W, H), 0.25, 2);
    const c = document.createElement('canvas');
    c.width = Math.max(1, Math.round(W * scale));
    c.height = Math.max(1, Math.round(H * scale));
    const g2 = c.getContext('2d');
    g2.scale(scale, scale);
    g2.translate(pad - u.x, pad - u.y);
    g2.fillStyle = cs(stage).backgroundColor;
    g2.fillRect(u.x - pad, u.y - pad, W, H);
    for (const { el, b } of boxes) {
      const s = cs(el);
      const kind = kindOf(el);
      g2.save();
      if (kind === 'ink') {
        const svg = el.querySelector('svg');
        const path = el.querySelector('path');
        if (svg && path) {
          const vb = svg.viewBox.baseVal;
          g2.translate(b.x, b.y);
          g2.scale(b.w / (vb.width || 1), b.h / (vb.height || 1));
          const ps = cs(path);
          g2.strokeStyle = ps.stroke;
          g2.globalAlpha = parseFloat(ps.opacity) || 1;
          g2.lineWidth = parseFloat(path.getAttribute('stroke-width')) || 3;
          g2.lineCap = 'round';
          g2.lineJoin = 'round';
          g2.stroke(new Path2D(path.getAttribute('d')));
        }
      } else if (kind === 'text') {
        drawWords(g2, el, b.x, b.y, b.w, b.h + 4);
      } else {
        const radius = parseFloat(s.borderTopLeftRadius) || 0;
        roundRect(g2, b.x, b.y, b.w, b.h, radius);
        g2.fillStyle = s.backgroundColor;
        g2.fill();
        if (parseFloat(s.borderTopWidth)) { g2.strokeStyle = s.borderTopColor; g2.lineWidth = parseFloat(s.borderTopWidth); g2.stroke(); }
        const padL = parseFloat(s.paddingLeft) || 0;
        const padT = parseFloat(s.paddingTop) || 0;
        if (kind === 'frame') {
          const words = el.querySelector(':scope > .words');
          if (words) drawWords(g2, el, b.x + words.offsetLeft + 8, b.y + words.offsetTop + 2, b.w - 40, 40);
        } else if (kind === 'note') {
          drawWords(g2, el, b.x + padL, b.y + padT, b.w - padL * 2, b.h - padT * 1.5);
        } else if (kind === 'image' || kind === 'video') {
          const m = el.querySelector('img, video');
          if (m) {
            try {
              if (m.tagName === 'VIDEO' && m.readyState < 2) throw new Error('not ready');
              g2.drawImage(m, b.x + m.offsetLeft, b.y + m.offsetTop, m.offsetWidth, m.offsetHeight);
            } catch {
              g2.fillStyle = cs(m).backgroundColor;
              g2.fillRect(b.x + m.offsetLeft, b.y + m.offsetTop, m.offsetWidth, m.offsetHeight);
            }
          }
          const cap = el.querySelector(':scope > .words');
          if (cap?.textContent) drawWords(g2, el, b.x + cap.offsetLeft + 6, b.y + cap.offsetTop + 6, b.w - 24, cap.offsetHeight + 4);
        } else {
          // A card: what it is, what it looks like, and what it says. A frame
          // cannot be drawn onto a canvas, so a preview is a labelled tile.
          const kicker = el.querySelector('.kicker, .name');
          g2.font = `500 12px ${s.fontFamily}`;
          g2.fillStyle = cs(el.querySelector('.kicker') ?? el).color;
          g2.textBaseline = 'top';
          if (kicker) g2.fillText(kicker.textContent.slice(0, 60), b.x + padL, b.y + padT);
          const peek = el.querySelector(':scope > .peek');
          if (peek) {
            const px = b.x + peek.offsetLeft;
            const py = b.y + peek.offsetTop;
            roundRect(g2, px, py, peek.offsetWidth, peek.offsetHeight, 8);
            g2.fillStyle = cs(peek).backgroundColor;
            g2.fill();
            const img = peek.querySelector('img');
            if (img?.complete && img.naturalWidth) { try { g2.drawImage(img, px, py, peek.offsetWidth, peek.offsetHeight); } catch {} }
            else {
              g2.fillStyle = cs(el.querySelector('.kicker') ?? el).color;
              g2.font = `500 13px ${s.fontFamily}`;
              g2.textAlign = 'center';
              g2.fillText(kindOf(el) === 'doc' ? 'Marble document — see the list' : kindOf(el) === 'pdf' ? 'PDF — see the list' : 'File', px + peek.offsetWidth / 2, py + peek.offsetHeight / 2 - 7);
              g2.textAlign = 'start';
            }
          }
          const wordsEl = el.querySelector(':scope > .words');
          const wy = wordsEl ? wordsEl.offsetTop : padT + 20;
          drawWords(g2, el, b.x + padL, b.y + wy, b.w - padL * 2, Math.max(20, (wordsEl?.offsetHeight ?? 40) + 4));
        }
      }
      g2.restore();
    }
    const blob = await new Promise((resolve) => c.toBlob(resolve, 'image/png'));
    return { blob, origin: { x: u.x, y: u.y }, size: { w: Math.round(u.w), h: Math.round(u.h) } };
  }
  const base64 = (blob) => new Promise((resolve, reject) => {
    const fr = new FileReader();
    fr.onload = () => resolve(String(fr.result).split(',')[1] ?? '');
    fr.onerror = () => reject(fr.error);
    fr.readAsDataURL(blob);
  });

  /** The board in words: what each thing is, what it says, and where it sits,
   *  grouped by the section it is in. The picture carries the sketches. */
  function outline(list, origin) {
    const at = (el) => {
      const b = box(el);
      return `(${Math.round(b.x - origin.x)}, ${Math.round(b.y - origin.y)}) ${Math.round(b.w)}×${Math.round(b.h)}`;
    };
    const q = (s) => JSON.stringify(s);
    const lineOf = (el) => {
      const words = wordsOf(el);
      switch (kindOf(el)) {
        case 'note': return `sticky note (${el.dataset.color}) at ${at(el)}: ${q(words || '(blank)')}`;
        case 'text': return `text (${el.dataset.size || 'm'}${el.dataset.color && el.dataset.color !== 'ink' ? `, ${el.dataset.color}` : ''}) at ${at(el)}: ${q(words)}`;
        case 'image': return `image at ${at(el)}: ${el.dataset.path}${words ? ` — caption ${q(words)}` : ''}`;
        case 'video': return `video at ${at(el)}: ${el.dataset.path}${words ? ` — caption ${q(words)}` : ''}`;
        case 'audio': return `audio at ${at(el)}: ${el.dataset.path}${words ? ` — ${q(words)}` : ''}`;
        case 'file': return `file at ${at(el)}: ${el.dataset.path}${words ? ` — ${q(words)}` : ''}`;
        case 'link': return `link at ${at(el)}: ${el.dataset.href}${words ? ` — ${q(words)}` : ''}`;
        case 'doc': return `${el.dataset.by === 'claude' ? 'a document Claude made earlier' : 'Marble document'} at ${at(el)}: ${q(el.dataset.path)}${words && words !== el.dataset.path.split('/').pop() ? ` — ${q(words)}` : ''}`;
        case 'pdf': return `PDF at ${at(el)}: ${q(el.dataset.path)}${words ? ` — ${q(words)}` : ''}`;
        default: return `${kindOf(el)} at ${at(el)}`;
      }
    };
    const frames = list.filter((el) => kindOf(el) === 'frame');
    const home = new Map();
    for (const el of list) {
      if (kindOf(el) === 'frame') continue;
      const b = box(el);
      const cx = b.x + b.w / 2;
      const cy = b.y + b.h / 2;
      // The smallest section a thing's middle is in is the one it belongs to.
      const f = frames.filter((fr) => { const fb = box(fr); return cx >= fb.x && cx <= fb.x + fb.w && cy >= fb.y && cy <= fb.y + fb.h; })
        .sort((a, b2) => box(a).w * box(a).h - box(b2).w * box(b2).h)[0] ?? null;
      home.set(el, f);
    }
    const reading = (a, b) => { const A = box(a); const B = box(b); return Math.abs(A.y - B.y) > 40 ? A.y - B.y : A.x - B.x; };
    const block = (members, indent) => {
      const out = [];
      const inks = members.filter(isInk);
      for (const el of members.filter((m) => !isInk(m)).sort(reading)) out.push(`${indent}- ${lineOf(el)}`);
      if (inks.length) {
        const u = union(inks.map(box));
        const colours = [...new Set(inks.map((el) => `${el.dataset.color}${el.dataset.pen === 'marker' ? ' highlighter' : ''}`))].join(', ');
        out.push(`${indent}- ${inks.length} hand-drawn stroke${inks.length === 1 ? '' : 's'} (${colours}) across (${Math.round(u.x - origin.x)}, ${Math.round(u.y - origin.y)}) ${Math.round(u.w)}×${Math.round(u.h)} — only in the picture`);
      }
      return out;
    };
    const lines = [];
    for (const f of [...frames].sort(reading)) {
      lines.push(`- section ${q(wordsOf(f) || 'Untitled')} at ${at(f)}${f.dataset.color && f.dataset.color !== 'white' ? ` (${f.dataset.color})` : ''}:`);
      const members = list.filter((el) => home.get(el) === f);
      lines.push(...(members.length ? block(members, '  ') : ['  - (empty)']));
    }
    const loose = list.filter((el) => kindOf(el) !== 'frame' && !home.get(el));
    if (loose.length) {
      if (frames.length) lines.push('- outside any section:');
      lines.push(...block(loose, frames.length ? '  ' : ''));
    }
    return lines.join('\n');
  }

  function pointedAt(words) {
    const refs = [...mentions].filter(([label]) => words.includes(label));
    if (!refs.length) return '';
    return ['', 'What I pointed at with @:', ...refs.map(([label, e]) => (e.kind === 'doc'
      ? `- ${label} → the Marble document ${JSON.stringify(e.path)} (read it with read_document)`
      : `- ${label} → the file ${JSON.stringify(e.path)} in the drive`))].join('\n');
  }
  async function composePrompt(words, list) {
    const name = nameEl.textContent.trim() || 'Board';
    const refs = pointedAt(words);
    const whole = list.length === items().length;
    const parts = [words, ''];
    if (!list.length) {
      parts.push(`<board name=${JSON.stringify(name)} document=${JSON.stringify(HERE)} items="0">The board is empty so far.</board>`);
      if (refs) parts.push(refs);
      return { prompt: parts.join('\n'), picture: null };
    }
    const snap = await snapshot(list);
    let picture = null;
    if (snap.blob) {
      try {
        const saved = await agent.upload({ name: `${name}.png`, type: 'image/png', data: await base64(snap.blob) });
        picture = saved;
      } catch {}
    }
    parts.push(`<board name=${JSON.stringify(name)} document=${JSON.stringify(HERE)} scope="${whole ? 'the whole board' : `${list.length} selected ${list.length === 1 ? 'thing' : 'things'}`}" items="${list.length}">`);
    parts.push('This is my whiteboard: where I think out loud about what to build. The picture is what it looks like; the list says what each thing is and where it sits (x → right, y ↓ down, in board units from the top-left of the picture). Sketches are only in the picture. Documents on the board are Marble documents in the drive (read them with read_document); files are in the drive at the paths given. Open any that matter.');
    parts.push('');
    if (picture) parts.push(`<pasted-image index="1" name="${esc(picture.name || 'board.png')}" bytes="${picture.bytes ?? snap.blob.size}" path="${esc(picture.path)}" url="${esc(picture.url ?? '')}"></pasted-image>`, '');
    parts.push(outline(list, snap.origin));
    parts.push('</board>');
    if (refs) parts.push(refs);
    parts.push('');
    parts.push(`The board is where the ideas live: leave it as it is unless I ask you to change it. When I ask you to build something, make it a new document in the drive${HERE.includes('/') ? ` beside the board (in "${HERE.slice(0, HERE.lastIndexOf('/'))}")` : ''}, and say its name.`);
    return { prompt: parts.join('\n'), picture };
  }

  // ------------------------------------------------------------- the thread

  // A title the host took from the prompt would carry the board with it.
  const titleOf = (c) => (c?.title || '').split('<board')[0].trim() || 'New conversation';
  function paintBar() {
    const c = view.id ? view.meta : null;
    titleEl.textContent = view.id ? titleOf(c) : 'Claude';
    const models = modelsOf();
    modelBtn.hidden = !models.length;
    modelBtn.firstChild.textContent = labelOf(currentModel());
  }
  const modelsOf = () => (provider?.models ?? []).map((m) => (typeof m === 'string' ? { id: m, label: m } : m)).filter((m) => m?.id);
  const currentModel = () => (view.id ? view.meta?.model : null) || body.dataset.model || provider?.defaultModel || modelsOf()[0]?.id || '';
  const labelOf = (id) => modelsOf().find((m) => m.id === id)?.label || (id ? id.charAt(0).toUpperCase() + id.slice(1) : provider?.label ?? 'Claude');

  function anchorMenu(menu, from, e) {
    if (e.newState !== 'open') return;
    const r = from.getBoundingClientRect();
    menu.style.top = `${Math.round(r.bottom + 6)}px`;
    menu.style.right = `${Math.round(document.documentElement.clientWidth - r.right)}px`;
    menu.style.left = 'auto';
  }
  modelMenu.addEventListener('beforetoggle', (e) => {
    anchorMenu(modelMenu, modelBtn, e);
    if (e.newState !== 'open') return;
    const now = currentModel();
    modelMenu.replaceChildren(h('p', 'k', view.id ? 'This conversation' : 'New conversations'), ...modelsOf().map((m) => {
      const b = h('button');
      b.type = 'button';
      b.setAttribute('role', 'menuitemradio');
      b.setAttribute('aria-checked', String(m.id === now));
      b.append(h('span', '', m.label || m.id), icon('check'));
      b.addEventListener('click', () => {
        modelMenu.hidePopover();
        setFact('data-model', m.id);
        if (view.id) { view.meta = { ...(view.meta ?? {}), model: m.id }; agent?.update(view.id, { model: m.id }).catch(() => {}); }
        paintBar();
      });
      return b;
    }));
  });
  const threadBtn = $('[popovertarget="bw-threads"]');
  threadMenu.addEventListener('beforetoggle', async (e) => {
    anchorMenu(threadMenu, threadBtn, e);
    if (e.newState !== 'open') return;
    threadMenu.replaceChildren(h('p', 'k', 'About this board'), h('p', 'none', 'Looking…'));
    let list = [];
    try { list = (await agent?.conversations()) ?? []; } catch {}
    const mine = list.filter((c) => c.target === HERE && !c.archived && !c.removed).sort((a, b) => (b.updatedAt ?? 0) - (a.updatedAt ?? 0));
    const rows = mine.map((c) => {
      const b = h('button');
      b.type = 'button';
      b.setAttribute('role', 'menuitemradio');
      b.setAttribute('aria-checked', String(c.id === view.id));
      b.append(icon('check'), h('span', '', titleOf(c)), h('small', '', ago(c.updatedAt)));
      b.addEventListener('click', () => { threadMenu.hidePopover(); openThread(c.id); });
      return b;
    });
    threadMenu.replaceChildren(h('p', 'k', 'About this board'), ...(rows.length ? rows : [h('p', 'none', 'No conversations yet.')]));
  });
  const ago = (t) => {
    if (!t) return '';
    const d = new Date(t);
    const today = new Date(); today.setHours(0, 0, 0, 0);
    return t >= today.getTime() ? d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }) : d.toLocaleDateString([], { month: 'short', day: 'numeric' });
  };

  function newThread() {
    setFact('data-conversation', '');
    openThread(null);
    if (!coarse.matches) input.focus({ preventScroll: true });
  }
  function openThread(id) {
    if (view.id === id && id) return;
    view.off?.();
    view = { id, turns: new Map(), running: null, seen: 0, off: null, meta: null };
    thread.replaceChildren();
    setFact('data-conversation', id ?? '');
    paintFresh();
    paintBar();
    paintSend();
    if (!id || !agent) return;
    listen(view);
    agent.conversation(id).then(({ meta }) => {
      if (view.id !== id) return;
      view.meta = { ...(view.meta ?? {}), ...meta };
      paintBar();
    }).catch(() => {
      if (view.id === id && !view.turns.size) { setFact('data-conversation', ''); openThread(null); }
    });
  }
  function listen(v) {
    v.off = agent.on(v.id, (event) => { if (view === v) receive(event); });
  }
  const paintFresh = () => panel.classList.toggle('marble-fresh', !thread.querySelector('.turn'));
  log.addEventListener('scroll', () => panel.classList.toggle('marble-scrolled', log.scrollTop > 4), { passive: true });
  const nearBottom = () => log.scrollHeight - log.scrollTop - log.clientHeight < 80;
  const toBottom = () => log.scrollTo({ top: log.scrollHeight });

  function turnOf(turn) {
    let t = view.turns.get(turn);
    if (t) return t;
    const el = h('div', 'turn');
    el.dataset.turn = turn;
    thread.append(el);
    t = { el, me: null, reply: null, live: null, work: null, texts: [], steps: new Map(), asks: new Map(), made: new Set() };
    view.turns.set(turn, t);
    return t;
  }
  /** What was said, without the board that rode along with it: the words,
   *  and a small picture of what was sent. */
  function bubble(text, from = null) {
    const me = h('div', 'me');
    if (from) me.append(h('span', 'from', `From ${from}`));
    const raw = String(text ?? '');
    const at = raw.indexOf('\n\n<board ');
    const words = (at >= 0 ? raw.slice(0, at) : raw).trim();
    me.append(words);
    if (at >= 0) {
      const url = /<pasted-image[^>]*\burl="([^"]*)"/.exec(raw)?.[1];
      const n = /<board [^>]*\bitems="(\d+)"/.exec(raw)?.[1];
      const scope = /<board [^>]*\bscope="([^"]*)"/.exec(raw)?.[1];
      const sent = h('span', 'sent');
      if (url) { const img = h('img'); img.src = url.replace(/&amp;/g, '&'); img.alt = ''; sent.append(img); }
      sent.append(scope ? `With ${scope}${n ? ` · ${n}` : ''}` : 'With the board');
      me.append(sent);
    }
    return me;
  }
  function pendingTurn(words) {
    const el = h('div', 'turn marble-pending');
    const me = h('div', 'me', words);
    const sent = h('span', 'sent', 'Gathering the board…');
    me.append(sent);
    el.append(me);
    thread.append(el);
    return el;
  }
  const replyOf = (t) => {
    if (!t.reply) { t.reply = h('div', 'reply'); t.el.append(t.reply); }
    return t.reply;
  };
  const thinking = (t, on) => {
    const dots = t.reply?.querySelector(':scope > .dots');
    if (on && !dots) { const d = h('div', 'dots'); d.setAttribute('aria-label', 'Thinking'); d.append(h('i'), h('i'), h('i')); replyOf(t).append(d); }
    else if (!on) dots?.remove();
  };

  const VISUAL_OPEN = /(^|\n)[ \t]*```[ \t]*marble-visual\b/i;
  let visualModule = null;
  const loadVisual = () => {
    visualModule ??= import('/runtime/chat-visual.js').then((mod) => {
      if (mod.VISUAL_CSS && !document.querySelector('style[data-chat-visual]')) {
        const style = h('style');
        style.dataset.chatVisual = '';
        style.setAttribute('data-marble-transient', '');
        style.textContent = mod.VISUAL_CSS;
        document.head.append(style);
      }
      return mod;
    }).catch(() => null);
    return visualModule;
  };
  const room = { input: { get value() { return input.value; }, set value(v) { input.value = v; } }, updateSendable: () => paintSend(), submit: () => submit() };
  const visual = (info, source) => {
    const card = h('figure', 'visual');
    card.append(h('div', 'visual-pending'));
    loadVisual().then((mod) => {
      if (mod?.mountVisual) return mod.mountVisual(card, { info, body: source, view: room });
      const pre = h('pre');
      pre.append(h('code', '', source));
      card.replaceChildren(pre);
      return null;
    });
    return card;
  };
  function render(node, text, { final = false } = {}) {
    const ui = UI();
    if (!ui?.renderText) { node.textContent = text; node.style.whiteSpace = 'pre-wrap'; return; }
    if (!final) {
      const m = VISUAL_OPEN.exec(text);
      node.replaceChildren(ui.renderText(m ? text.slice(0, m.index) : text));
      if (m) node.append(h('div', 'visual-pending'));
      return;
    }
    node.replaceChildren(ui.renderText(text, { visual }));
  }
  let painting = 0;
  const paintLive = () => {
    if (painting) return;
    painting = requestAnimationFrame(() => {
      painting = 0;
      const stuck = nearBottom();
      for (const t of view.turns.values()) if (t.live) render(t.live.node, t.live.raw);
      if (stuck) toBottom();
    });
  };
  function delta(t, text) {
    thinking(t, false);
    closeWork(t);
    if (!t.live) { const node = h('div', 'md marble-live'); replyOf(t).append(node); t.live = { node, raw: '' }; }
    t.live.raw += text;
    paintLive();
  }
  function fullText(t, full) {
    thinking(t, false);
    closeWork(t);
    let node = t.live?.node;
    if (!node) { node = h('div', 'md'); replyOf(t).append(node); }
    node.classList.remove('marble-live');
    render(node, full, { final: true });
    t.live = null;
    t.texts.push(full);
  }
  const endLive = (t) => {
    if (!t.live) return;
    t.live.node.classList.remove('marble-live');
    render(t.live.node, t.live.raw, { final: true });
    t.live = null;
  };

  const tail = (p) => String(p ?? '').split('/').filter(Boolean).pop() ?? '';
  const hostOf = (u) => { try { return new URL(u).host; } catch { return String(u ?? ''); } };
  function stepOf(name, inp = {}) {
    const n = String(name ?? '');
    if (/^browser_/.test(n) || /__browser_/.test(n)) return ['Used the browser', inp.url ? hostOf(inp.url) : ''];
    switch (n.replace(/^mcp__[^_]+__/, '')) {
      case 'Bash': case 'Shell': case 'shell': return ['Ran a command', inp.description || inp.command || ''];
      case 'Read': case 'read_file': return ['Read', tail(inp.file_path ?? inp.path)];
      case 'Grep': case 'Glob': return ['Searched files', inp.pattern ?? ''];
      case 'Edit': case 'MultiEdit': case 'Write': case 'NotebookEdit': return ['Edited', tail(inp.file_path ?? inp.notebook_path)];
      case 'WebSearch': case 'web_search': return ['Searched the web', inp.query ?? ''];
      case 'WebFetch': return ['Read a page', hostOf(inp.url)];
      case 'read_document': return ['Read', inp.path ?? ''];
      case 'apply_ops': return ['Changed', inp.path ?? ''];
      case 'create_document': return ['Made', inp.path ?? ''];
      case 'list_documents': return ['Looked through the drive', ''];
      case 'check_document': return ['Checked', inp.path ?? ''];
      case 'read_guide': return ['Read the guide', inp.section ?? ''];
      case 'Task': case 'Agent': return ['Asked a helper', inp.description ?? ''];
      case 'TodoWrite': return ['Made a plan', ''];
      case 'Skill': return ['Used a skill', inp.skill ?? ''];
      default: return [n.replace(/^mcp__[^_]+__/, '').replace(/_/g, ' '), ''];
    }
  }
  function workOf(t) {
    if (t.work) return t.work;
    const boxEl = h('details', 'work');
    boxEl.dataset.state = 'running';
    const sum = h('summary');
    sum.append(icon('right'), h('span', 'work-label', 'Working'));
    boxEl.append(sum, h('ol', 'steps'));
    replyOf(t).append(boxEl);
    t.work = boxEl;
    return boxEl;
  }
  const workLabel = (boxEl) => {
    const steps = boxEl.querySelectorAll('.steps li');
    const n = steps.length;
    if (boxEl.dataset.state === 'running') return `${steps[n - 1]?.querySelector('b')?.textContent ?? 'Working'}…`;
    return n === 1 ? steps[0].querySelector('b').textContent : `${n} steps`;
  };
  function closeWork(t) {
    if (!t.work) return;
    t.work.dataset.state = 'done';
    t.work.querySelector('.work-label').textContent = workLabel(t.work);
    t.work = null;
  }
  function toolCall(t, event) {
    thinking(t, false);
    endLive(t);
    const boxEl = workOf(t);
    const [label, detail] = stepOf(event.name, event.input ?? {});
    const li = h('li');
    li.dataset.state = 'pending';
    li.append(h('b', '', label));
    if (detail) li.append(h('span', '', detail));
    boxEl.querySelector('.steps').append(li);
    t.steps.set(event.callId, li);
    boxEl.querySelector('.work-label').textContent = workLabel(boxEl);
  }
  function noteLine(t, words, bad = false) {
    const p = h('p', bad ? 'err' : 'note-line', words);
    if (t) replyOf(t).append(p);
    else thread.append(p);
    return p;
  }
  /** A document Claude made or changed: a way to open it, and a way to put
   *  it on the board, where the next message will carry it along. */
  function made(t, path) {
    if (!path || t.made.has(path)) return;
    t.made.add(path);
    const row = h('div', 'made');
    row.append(icon(path === HERE ? 'board' : 'doc'));
    const a = h('a', '', path === HERE ? 'Changed this board' : path);
    a.href = `/a/${path.split('/').map(enc).join('/')}`;
    if (path !== HERE) { a.target = '_blank'; a.rel = 'noopener'; }
    row.append(a);
    if (path !== HERE) {
      const pin = h('button', '', 'Put on the board');
      pin.type = 'button';
      pin.addEventListener('click', () => {
        const c = viewCentreWorld();
        if (add('doc', { x: c.x - 150, y: c.y - 120, path, by: 'claude' })) { pin.disabled = true; pin.textContent = 'On the board'; }
      });
      row.append(pin);
    }
    replyOf(t).append(row);
  }
  function ask(t, event) {
    thinking(t, false);
    endLive(t);
    const build = UI()?.buildAskCard;
    if (!build) return;
    let card = null;
    const answer = async (response) => {
      for (const b of card.querySelectorAll('button')) b.disabled = true;
      try { await agent.answer(event.turn, event.requestId, response); } catch (err) {
        for (const b of card.querySelectorAll('button')) b.disabled = false;
        noteLine(t, err.message, true);
      }
    };
    card = build(event, answer);
    t.asks.set(event.requestId, card);
    replyOf(t).append(card);
  }
  function finish(t, event) {
    thinking(t, false);
    endLive(t);
    closeWork(t);
    t.el.classList.remove('marble-queued');
    for (const card of t.asks.values()) card.remove();
    if (event.type === 'turn.failed') noteLine(t, event.error || 'Something went wrong.', true);
    if (event.type === 'turn.cancelled') noteLine(t, 'Stopped.');
    if (event.type === 'turn.interrupted') noteLine(t, 'Interrupted.');
    if (t.texts.length && !t.reply.querySelector(':scope > .acts')) {
      const acts = h('div', 'acts');
      const copy = h('button', 'tb');
      copy.type = 'button';
      copy.title = 'Copy';
      copy.setAttribute('aria-label', 'Copy reply');
      copy.append(icon('copy'));
      copy.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(t.texts.join('\n\n')); copy.replaceChildren(icon('check')); setTimeout(() => copy.replaceChildren(icon('copy')), 1400); } catch {}
      });
      const note = h('button', 'tb');
      note.type = 'button';
      note.title = 'Put this reply on the board as a note';
      note.setAttribute('aria-label', 'Put this reply on the board');
      note.append(icon('pin'));
      note.addEventListener('click', () => {
        const c = viewCentreWorld();
        const text = t.texts.join('\n\n').replace(/```[\s\S]*?```/g, '').replace(/[*_#>`]/g, '').trim().slice(0, 1200);
        add('note', { x: c.x - 150, y: c.y - 80, w: 300, color: 'white', text });
      });
      acts.append(copy, note);
      t.reply.append(acts);
    }
    if (view.running === event.turn) view.running = null;
    paintSend();
    if (view.id && view.meta?.needsReview) agent?.markReviewed(view.id).catch(() => {});
  }
  function receive(event) {
    if (event.seq) {
      if (event.seq <= view.seen) return;
      view.seen = event.seq;
    }
    const stuck = nearBottom();
    const turn = event.turn;
    switch (event.type) {
      case 'user': {
        let t = view.turns.get(turn);
        if (!t) {
          const pending = thread.querySelector('.turn.marble-pending');
          if (pending) {
            pending.classList.remove('marble-pending');
            pending.dataset.turn = turn;
            t = { el: pending, me: null, reply: null, live: null, work: null, texts: [], steps: new Map(), asks: new Map(), made: new Set() };
            view.turns.set(turn, t);
            pending.replaceChildren();
          } else t = turnOf(turn);
        }
        if (!t.me) {
          t.me = bubble(event.text, event.from ? event.from.title || 'another chat' : null);
          t.el.prepend(t.me);
        }
        paintFresh();
        break;
      }
      case 'message': {
        const t = turnOf(turn ?? `m${event.seq}`);
        t.me = bubble(event.text, event.fromTitle || 'another chat');
        t.el.prepend(t.me);
        paintFresh();
        break;
      }
      case 'turn.queued': turnOf(turn).el.classList.add('marble-queued'); break;
      case 'turn.removed': view.turns.get(turn)?.el.remove(); view.turns.delete(turn); paintFresh(); break;
      case 'turn.started': {
        const t = turnOf(turn);
        t.el.classList.remove('marble-queued');
        view.running = turn;
        thinking(t, true);
        paintSend();
        break;
      }
      case 'text.delta': delta(turnOf(turn), event.text ?? ''); break;
      case 'text': fullText(turnOf(turn), event.text ?? ''); break;
      case 'tool.call': toolCall(turnOf(turn), event); break;
      case 'tool.result': {
        const li = view.turns.get(turn)?.steps.get(event.callId);
        if (li) li.dataset.state = event.ok === false ? 'failed' : 'done';
        break;
      }
      case 'ops.applied':
      case 'document.changed':
        made(turnOf(turn), event.path ?? '');
        break;
      case 'ask': ask(turnOf(turn), event); break;
      case 'ask.answered':
      case 'ask.void': {
        const t = view.turns.get(turn);
        t?.asks.get(event.requestId)?.remove();
        t?.asks.delete(event.requestId);
        break;
      }
      case 'turn.completed':
      case 'turn.failed':
      case 'turn.cancelled':
      case 'turn.interrupted':
        finish(turnOf(turn), event);
        break;
      case 'handoff': noteLine(null, event.from ? 'Continued from an earlier conversation.' : 'Continued in a new conversation.'); break;
      case 'usage.continued': noteLine(null, `Usage ran out; carrying on with ${event.label}.`); break;
      default:
    }
    if (stuck) toBottom();
  }

  // ---------------------------------------------------------------- sending

  const DEFAULT_ASK = 'Build the app this board describes.';
  function paintSend() {
    const stop = Boolean(view.running) && !input.value.trim();
    sendBtn.dataset.mode = stop ? 'stop' : 'send';
    sendBtn.disabled = stop ? false : !agent || sending || (!input.value.trim() && !items().length);
    sendBtn.setAttribute('aria-label', stop ? 'Stop' : 'Send');
    input.placeholder = agent ? (view.id ? 'Ask a follow-up — the board goes too' : 'What should Claude do with the board?') : 'Open this in Marble Drive to talk to Claude';
  }
  let sending = false;
  async function submit() {
    if (!agent || sending) return;
    stopEditing();
    const words = input.value.trim() || DEFAULT_ASK;
    const list = scopeItems();
    sending = true;
    input.value = '';
    paintSend();
    const pending = pendingTurn(words);
    paintFresh();
    toBottom();
    try {
      const { prompt } = await composePrompt(words, list);
      mentions.clear();
      const sent = pending.querySelector('.sent');
      if (sent) sent.textContent = list.length === items().length ? `With the whole board · ${list.length}` : `With ${list.length} selected ${list.length === 1 ? 'thing' : 'things'}`;
      let id = view.id;
      if (!id) {
        id = await agent.start({ provider: provider?.id, model: body.dataset.model || null });
        view.id = id;
        view.meta = { id, model: body.dataset.model || null, title: '' };
        setFact('data-conversation', id);
        listen(view);
        paintBar();
      }
      await agent.send(id, { prompt, target: HERE, viewing: HERE, selection: [], also: [] });
      scopeForce = null;
    } catch (err) {
      pending.classList.remove('marble-pending');
      pending.append(h('p', 'err', `Not sent — ${err.message}`));
      if (!input.value) input.value = words === DEFAULT_ASK ? '' : words;
    } finally {
      sending = false;
      paintSend();
    }
  }
  function stopTurn() { if (view.running) agent?.cancel(view.running).catch(() => {}); }
  sendBtn.addEventListener('click', () => (sendBtn.dataset.mode === 'stop' ? stopTurn() : submit()));
  // @ in the field points at something in the drive. The name is what reads
  // in the message; the path goes to Claude beside it.
  const mentions = new Map();
  function mentionQuery() {
    const upto = input.value.slice(0, input.selectionStart ?? input.value.length);
    const m = /(?:^|\s)@([^\s@]{0,40})$/.exec(upto);
    return m ? { at: upto.length - m[1].length - 1, q: m[1] } : null;
  }
  function insertMention(entry) {
    const m = mentionQuery();
    const at = m?.at ?? pick.mentionAt;
    closePick();
    if (at < 0) return;
    const name = entry.kind === 'doc' ? (entry.title || entry.path.split('/').pop()) : entry.path.split('/').pop();
    const label = `@${name}`;
    const end = input.selectionStart ?? input.value.length;
    input.value = `${input.value.slice(0, at)}${label} ${input.value.slice(end)}`;
    const caret = at + label.length + 1;
    input.setSelectionRange(caret, caret);
    mentions.set(label, entry);
    input.focus();
    paintSend();
  }
  input.addEventListener('input', () => {
    paintSend();
    const m = mentionQuery();
    if (m) { pick.mentionAt = m.at; openPick('mention', m.q); }
    else if (!pick.el.hidden && pick.mode === 'mention') closePick();
  });
  input.addEventListener('keydown', (e) => {
    if (!pick.el.hidden && pick.mode === 'mention') {
      const stop = () => { e.preventDefault(); e.stopImmediatePropagation(); };
      if (e.key === 'ArrowDown') { stop(); movePick(1); return; }
      if (e.key === 'ArrowUp') { stop(); movePick(-1); return; }
      if ((e.key === 'Enter' || e.key === 'Tab') && pick.list.length) { stop(); choose(pick.list[pick.index]); return; }
      if (e.key === 'Escape') { stop(); closePick(); return; }
    }
  }, true);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing && !coarse.matches) { e.preventDefault(); submit(); }
    else if (e.key === 'Escape' && view.running && !input.value) { e.preventDefault(); stopTurn(); }
    else if (e.key === 'Escape') input.blur();
  });
  $('.ideas', panel).addEventListener('click', (e) => {
    const idea = e.target.closest('.idea');
    if (!idea) return;
    input.value = idea.textContent.trim();
    paintSend();
    input.focus();
    input.setSelectionRange(input.value.length, input.value.length);
  });

  // ------------------------------------------------------------------ boot

  function bootAgent(a) {
    if (agent) return;
    agent = a;
    HERE = M?.app ?? window.marble?.app ?? decodeURIComponent(location.pathname.replace(/^\/a\//, ''));
    body.classList.remove('marble-offline');
    const ready = agent.providers().then((list) => {
      provider = list.find((p) => p.default) ?? list[0] ?? null;
      paintBar();
    }).catch(() => {});
    agent.on('*', (summary) => {
      if (summary?.kind || !summary?.id || summary.id !== view.id) return;
      view.meta = { ...(view.meta ?? {}), ...summary };
      paintBar();
    });
    // Arrived from the Drive's New menu with the words already written
    // (#ask=…): they open a fresh thread on this board and go as its first
    // ask, with the board alongside as always. The address is spent first so
    // a reload does not send them twice.
    const asked = /^#ask=/.test(location.hash)
      ? decodeURIComponent(location.hash.slice(5)).trim()
      : '';
    if (/^#ask=/.test(location.hash)) history.replaceState(null, '', location.pathname + location.search);
    const id = body.dataset.conversation;
    if (asked) {
      openThread(null);
      ready.then(() => { input.value = asked; paintSend(); submit(); });
    } else if (id && /^[0-9a-f]{12}$/.test(id)) openThread(id);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') agent.suspend?.();
      else agent.resume?.();
    });
    paintSend();
    paintBar();
  }

  function begin(marble) {
    M = marble;
    marble.pageOnly('contenteditable', 'spellcheck', 'data-tool');
    const sync = ({ canUndo, canRedo }) => {
      $('[data-cmd="undo"]').disabled = !canUndo;
      $('[data-cmd="redo"]').disabled = !canRedo;
    };
    document.addEventListener('marble:history', (e) => sync(e.detail));
    document.addEventListener('marble:status', (e) => { saveEl.dataset.state = e.detail?.state ?? ''; });
    sync(marble);
    if (window.marble?.agent) bootAgent(window.marble.agent);
    paintChrome();
  }

  // On a phone the conversation is a sheet over the board, so the board is
  // what opens first; the sheet is one tap away.
  if (document.documentElement.clientWidth <= 46 * 16) body.dataset.panel = 'closed';

  let saved = null;
  try { saved = JSON.parse(localStorage.getItem(CAM_KEY) || 'null'); } catch {}
  if (saved && Number.isFinite(saved.x) && Number.isFinite(saved.z)) { Object.assign(cam, saved); paintCam(); }
  else requestAnimationFrame(() => fit(items(), { animate: false }));
  setTool('select');
  paintScope();
  paintFresh();
  paintSend();

  addEventListener('marble:agent', (e) => bootAgent(e.detail), { once: true });
  if (window.marble) begin(window.marble);
  else addEventListener('marble:ready', (e) => begin(e.detail), { once: true });
  setTimeout(() => {
    if (agent) return;
    body.classList.add('marble-offline');
    paintSend();
  }, 3000);
})();
</script>

__SCRIPT__
</body>
</html>
