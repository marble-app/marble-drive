  <g id="i-marker"><path d="m9.2 17.8-3.9-3.9L14.6 4.6a1.9 1.9 0 0 1 2.7 0l1.2 1.2a1.9 1.9 0 0 1 0 2.7z"/><path d="M5.3 13.9 3.5 18.5l2 1 3.7-1.7"/><path d="M4 21h8"/></g>
  <g id="i-eraser"><path d="M9 19.5h10.5"/><path d="m4.9 14.6 8.9-8.9a2 2 0 0 1 2.8 0l2.3 2.3a2 2 0 0 1 0 2.8L10.3 19.5H8.4l-3.5-3.5a1 1 0 0 1 0-1.4z"/><path d="m9 10.5 4.5 4.5"/></g>
