    } else if (tool === 'text') {
      parts.push(grp(...INK_COLORS.map((c) => swatch(c, inkCss(c), prefs.text === c, (v) => { prefs.text = v; savePrefs(); paintOptions(); }))));
    } else if (tool === 'pen' || tool === 'marker') {
