<!doctype html>
<html lang="en" data-marble="1">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="__TITLE__">
<meta name="marble:capabilities" content="storage; net=none">
<!-- The board is the prompt, and the conversation about it is drawn beside
     it, so the host's own drawer and its launcher stay off this page. -->
<meta name="marble-agent" content="custom">
<title>__TITLE__</title>
__ICON__
<style>
  /* ------------------------------------------------------------------ tokens

     The drive's own, from the Design System document: three greys of ink,
     paper for chrome, one dusty blue. Each is one light-dark() pair, so the
     board follows the machine into the dark without a switch. The note and
     ink palettes are this app's: six papers a sticky note comes on, and six
     inks a pen draws with. */
  :root {
    color-scheme: light dark;
    --ink: light-dark(#111111, #e8e6e1);
    --muted: light-dark(#5a5a5a, #a3a7ab);
    --faint: light-dark(#8a8a8a, #71767a);
    --placeholder: light-dark(#8f8a7e, #80868b);
    --line: light-dark(#e6e2d8, #2c3136);
    --paper: light-dark(#fafaf7, #16181a);
    --paper-2: light-dark(#f3f1ea, #1e2124);
    --card: light-dark(#ffffff, #1f2326);
    --room: light-dark(#ffffff, #1a1d20);
    --field: light-dark(#ffffff, #23272b);
    --bubble: light-dark(#e8eef4, #26323c);
    --accent: light-dark(#9bb6cf, #7fa8c9);
    --accent-soft: light-dark(#f1f5f8, #1d2932);
    --accent-ink: light-dark(#738698, #9dc0dc);
    --select: light-dark(#5b8fc4, #7fb0de);
    --danger: light-dark(#b4533e, #e08a74);
    --board: light-dark(#f6f5f0, #141618);
    --dot: light-dark(#d9d5ca, #2b3035);
    --glass: light-dark(rgba(255,255,255,.86), rgba(34,38,42,.86));

    --n-yellow: light-dark(#fff0a6, #5b4f22);
    --n-pink: light-dark(#ffd7df, #5b3040);
    --n-blue: light-dark(#d3e5f8, #26415b);
    --n-green: light-dark(#d5efcd, #2c4b31);
    --n-purple: light-dark(#e5dbf9, #40355c);
    --n-orange: light-dark(#ffdcc0, #5c3b24);
    --n-white: light-dark(#ffffff, #2b2f33);

    --i-ink: var(--ink);
    --i-red: light-dark(#d4493a, #ef7a6b);
    --i-blue: light-dark(#2f6fd1, #6fa3f0);
    --i-green: light-dark(#2f8f4e, #6cc58a);
    --i-purple: light-dark(#7a4fc9, #a98bea);
    --i-orange: light-dark(#e07b1a, #f0a458);

    --shadow: 0 1px 2px light-dark(rgba(74,66,52,.06), rgba(0,0,0,.3)), 0 2px 5px light-dark(rgba(74,66,52,.04), rgba(0,0,0,.2));
    --shadow-rest: 0 1px 2px light-dark(rgba(74,66,52,.06), rgba(0,0,0,.40)), 0 6px 16px light-dark(rgba(74,66,52,.08), rgba(0,0,0,.28));
    --shadow-lift: 0 4px 10px light-dark(rgba(74,66,52,.10), rgba(0,0,0,.36)), 0 14px 30px light-dark(rgba(74,66,52,.12), rgba(0,0,0,.30));
    --r: 12px; --r-sm: 8px; --r-text: 4px; --r-bubble: 18px; --r-field: 20px; --pill: 999px;
    --ease-out: cubic-bezier(.22, 1, .36, 1);
    --ease: cubic-bezier(.22, .61, .36, 1);
    --t-fast: 110ms; --t: 200ms; --t-slow: 340ms;
    --ui: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    --hand: "Bradley Hand", "Segoe Print", "Comic Sans MS", var(--ui);
    --mono: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, monospace;
    --panel: 25rem;

    /* Where the camera is. The page writes these three through a constructed
       stylesheet, so the view is the page's and never a line in the file. */
    --cx: 0px; --cy: 0px; --z: 1;
  }

  html { container: app / inline-size; height: 100%; }
  * { box-sizing: border-box; }
  body.app {
    margin: 0; height: 100dvh; overflow: hidden;
    display: grid; grid-template-columns: minmax(0, 1fr) auto;
    /* One row, the whole height. Anything the host slips into <body> lands in
       a zero-height row below it instead of taking a share of the window. */
    grid-template-rows: minmax(0, 1fr); grid-auto-rows: 0;
    background: var(--paper); color: var(--ink);
    font: 14px/1.5 var(--ui); -webkit-font-smoothing: antialiased;
  }
  button, input, textarea { font: inherit; color: inherit; }
  :focus-visible { outline: 2px solid var(--accent-ink); outline-offset: 2px; }
  .sprite { position: absolute; width: 0; height: 0; overflow: hidden; }
  .ic { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; flex: none; }

  /* ------------------------------------------------------------------ stage

     A window onto a board with no edges. The dots belong to the board, so
     they travel and scale with it; everything floating over it is chrome. */
  .stage {
    grid-row: 1; position: relative; overflow: hidden; min-width: 0;
    touch-action: none; user-select: none; -webkit-user-select: none;
    background-color: var(--board);
    background-image: radial-gradient(circle, var(--dot) calc(1.1px * max(var(--z), .7)), transparent calc(1.3px * max(var(--z), .7)));
    background-size: calc(24px * var(--z)) calc(24px * var(--z));
    background-position: var(--cx) var(--cy);
  }
  .world {
    position: absolute; left: 0; top: 0; width: 0; height: 0;
    transform-origin: 0 0; transform: translate(var(--cx), var(--cy)) scale(var(--z));
  }
  .stage[data-tool="hand"], body.marble-space .stage { cursor: grab; }
  body.marble-panning .stage { cursor: grabbing; }
  .stage[data-tool="pen"], .stage[data-tool="marker"] { cursor: crosshair; }
  .stage[data-tool="eraser"] { cursor: cell; }
  .stage[data-tool="note"], .stage[data-tool="text"], .stage[data-tool="frame"] { cursor: copy; }

  /* ------------------------------------------------------------------ items

     Everything on the board is one element in the file whose inline style is
     where it sits and how wide it is. Which is on top is document order. */
  .item { position: absolute; }
  .words { white-space: pre-wrap; overflow-wrap: anywhere; outline: none; }
  .words:empty::before { content: attr(data-placeholder); color: var(--placeholder); pointer-events: none; }
  .item.marble-editing .words { cursor: text; user-select: text; -webkit-user-select: text; }
  .stage[data-tool="select"] .item:not(.frame, .ink):hover,
  .stage[data-tool="select"] .frame > .words:hover { outline: calc(1.5px / var(--z)) solid color-mix(in srgb, var(--select) 55%, transparent); outline-offset: calc(2px / var(--z)); }
  .item.marble-selected { outline: none !important; }

  .note {
    width: 220px; min-height: 150px; padding: 14px 16px 16px;
    background: var(--c, var(--n-yellow)); color: light-dark(#2a2618, #f1ede2);
    border-radius: 3px 3px 14px 3px;
    box-shadow: 0 1px 1px light-dark(rgba(60,50,20,.08), rgba(0,0,0,.3)), 0 6px 14px -6px light-dark(rgba(60,50,20,.22), rgba(0,0,0,.5));
    font: 16px/1.42 var(--ui);
  }
  .note > .words { min-height: 120px; }
  .note > .words:empty::before { color: color-mix(in srgb, currentColor 40%, transparent); }
  .note[data-color="yellow"] { --c: var(--n-yellow); }
  .note[data-color="pink"] { --c: var(--n-pink); }
  .note[data-color="blue"] { --c: var(--n-blue); }
  .note[data-color="green"] { --c: var(--n-green); }
  .note[data-color="purple"] { --c: var(--n-purple); }
  .note[data-color="orange"] { --c: var(--n-orange); }
  .note[data-color="white"] { --c: var(--n-white); }

  .text { width: 320px; color: var(--c, var(--ink)); font: 600 24px/1.25 var(--ui); letter-spacing: -.01em; }
  .text[data-size="s"] { font-size: 16px; font-weight: 500; line-height: 1.45; letter-spacing: 0; }
  .text[data-size="l"] { font-size: 38px; letter-spacing: -.02em; }
  .text[data-size="xl"] { font-size: 60px; font-weight: 700; letter-spacing: -.03em; line-height: 1.08; }
  .text[data-font="hand"] { font-family: var(--hand); font-weight: 500; }

  .ink, .text { --c: var(--i-ink); }
  .ink[data-color="red"], .text[data-color="red"] { --c: var(--i-red); }
  .ink[data-color="blue"], .text[data-color="blue"] { --c: var(--i-blue); }
  .ink[data-color="green"], .text[data-color="green"] { --c: var(--i-green); }
  .ink[data-color="purple"], .text[data-color="purple"] { --c: var(--i-purple); }
  .ink[data-color="orange"], .text[data-color="orange"] { --c: var(--i-orange); }

  /* A stroke is hit on its line, not its box, so a sketch over a note never
     steals the note from the hand. */
  .ink { pointer-events: none; }
  .ink > svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .ink path { fill: none; stroke: var(--c); stroke-linecap: round; stroke-linejoin: round; pointer-events: visibleStroke; }
  .ink[data-pen="marker"] path { opacity: .36; }
  .ink.marble-erasing { opacity: .2; }

  /* A section is a labelled region. Its label is its handle; the rest of it
     lets a press through to the board, where a drag draws a selection. */
  .frame {
    pointer-events: none;
    background: color-mix(in srgb, var(--c, var(--n-white)) 42%, transparent);
    border: 1.5px solid color-mix(in srgb, var(--c, var(--n-white)) 70%, var(--line));
    border-radius: 18px;
  }
  .frame[data-color="white"] { --c: var(--n-white); background: color-mix(in srgb, var(--card) 70%, transparent); border-color: var(--line); }
  .frame[data-color="yellow"] { --c: var(--n-yellow); }
  .frame[data-color="pink"] { --c: var(--n-pink); }
  .frame[data-color="blue"] { --c: var(--n-blue); }
  .frame[data-color="green"] { --c: var(--n-green); }
  .frame[data-color="purple"] { --c: var(--n-purple); }
  .frame[data-color="orange"] { --c: var(--n-orange); }
  .frame > .words {
    pointer-events: auto; position: absolute; left: 14px; top: 10px; max-width: calc(100% - 28px);
    padding: 2px 8px; border-radius: 6px; font: 600 15px/1.4 var(--ui); color: var(--muted);
  }
  .frame > .words:hover { background: color-mix(in srgb, var(--card) 60%, transparent); }

  .media {
    width: 320px; margin: 0; padding: 6px; border-radius: 12px;
    background: var(--card); border: 1px solid var(--line); box-shadow: var(--shadow);
  }
  .media > img, .media > video { display: block; width: 100%; height: auto; border-radius: 7px; background: var(--paper-2); -webkit-user-drag: none; }
  .media > img { pointer-events: none; }
  .media > audio { display: block; width: 100%; }
  .media > .name { display: flex; align-items: center; gap: .5rem; padding: 6px 6px 8px; font-size: 13px; color: var(--muted); min-width: 0; }
  .media > .name b { font-weight: 500; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .media > .words { padding: 7px 6px 3px; font-size: 13.5px; line-height: 1.45; color: var(--muted); }
  .media > .words:empty { display: none; }
  .media.marble-editing > .words:empty { display: block; }

  .card {
    width: 280px; padding: 14px 16px; border-radius: 12px;
    background: var(--card); border: 1px solid var(--line); box-shadow: var(--shadow);
    display: grid; gap: 6px;
  }
  .card > .kicker { display: flex; align-items: center; gap: .45rem; font-size: 12px; color: var(--faint); min-width: 0; }
  .card > .kicker .ic { width: 16px; height: 16px; }
  .card > .kicker span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .card > .words { font-size: 15px; line-height: 1.4; font-weight: 500; }
  .card > .open { font-size: 12.5px; color: var(--accent-ink); text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .card > .open:hover { text-decoration: underline; text-underline-offset: .18em; }
  .card[data-by="claude"] { border-color: color-mix(in srgb, var(--accent) 55%, var(--line)); background: color-mix(in srgb, var(--accent-soft) 70%, var(--card)); }
  .card[data-kind="doc"], .card[data-kind="pdf"] { width: 300px; }

  /* A document or a PDF on the board shows itself: the real file, drawn in a
     frame that runs nothing and takes no press, so what is on the card is
     what is in the file. The frame is the page's and never reaches the file. */
  .card > .peek {
    position: relative; height: 170px; margin: 2px -6px; overflow: hidden; pointer-events: none;
    border-radius: 8px; border: 1px solid var(--line); background: var(--paper-2);
  }
  .card[data-kind="pdf"] > .peek { height: 230px; }
  .card > .peek iframe, .card > .peek img {
    position: absolute; left: 0; top: 0; border: 0; background: #fff; opacity: 0;
    transition: opacity var(--t-slow) var(--ease);
  }
  .card[data-kind="doc"] > .peek iframe { width: 400%; height: 400%; transform: scale(.25); transform-origin: 0 0; }
  .card[data-kind="pdf"] > .peek iframe { width: 100%; height: calc(100% + 48px); }
  .card > .peek img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .card > .peek.marble-loaded iframe, .card > .peek.marble-loaded img { opacity: 1; }
  .card > .peek .glyph { position: absolute; inset: 0; display: grid; place-items: center; color: var(--faint); }
  .card > .peek .glyph .ic { width: 34px; height: 34px; stroke-width: 1.3; }
  .card > .peek.marble-loaded .glyph { display: none; }

  .ghost {
    position: absolute; width: 220px; padding: 14px 16px; border-radius: 12px;
    border: 1.5px dashed var(--accent); background: color-mix(in srgb, var(--card) 80%, transparent);
    color: var(--muted); font-size: 13px; animation: breathe 1.3s var(--ease) infinite;
  }
  .ghost.marble-failed { border-color: var(--danger); color: var(--danger); animation: none; }
  .live-ink { position: absolute; left: 0; top: 0; width: 1px; height: 1px; overflow: visible; pointer-events: none; }
  .live-ink path { fill: none; stroke-linecap: round; stroke-linejoin: round; }

  /* Nothing on the board teaches nothing, so an empty one says how to start. */
  .empty {
    display: none; position: absolute; inset: 0; place-content: center; justify-items: center; gap: .6rem;
    text-align: center; pointer-events: none; color: var(--faint);
  }
  .stage:not(:has(.world > .item)) .empty { display: grid; }
  .empty b { font-size: 17px; font-weight: 600; color: var(--muted); }
  .empty p { margin: 0; max-width: 24rem; font-size: 14px; }

  /* ---------------------------------------------------------------- overlay

     Selection is drawn in screen space over the board, so a handle is the
     same size at every zoom and nothing about it reaches the file. */
  .overlay { position: absolute; inset: 0; pointer-events: none; z-index: 5; }
  .sel { position: absolute; border: 1.5px solid var(--select); border-radius: 4px; }
  .sel.group { border-style: dashed; border-width: 1px; opacity: .7; }
  .handle {
    position: absolute; width: 14px; height: 14px; margin: -7px 0 0 -7px; pointer-events: auto;
    background: var(--card); border: 1.5px solid var(--select); border-radius: 4px; cursor: nwse-resize; touch-action: none;
  }
  .handle[data-edge="e"] { cursor: ew-resize; border-radius: 7px; height: 22px; margin-top: -11px; width: 10px; margin-left: -5px; }
  .marquee { position: absolute; border: 1px solid var(--select); background: color-mix(in srgb, var(--select) 10%, transparent); border-radius: 3px; }
  .eraser-dot { position: absolute; width: 22px; height: 22px; margin: -11px 0 0 -11px; border-radius: 50%; border: 1.5px solid var(--muted); background: color-mix(in srgb, var(--card) 50%, transparent); }

  /* -------------------------------------------------------------------- hud */
  .hud {
    position: absolute; z-index: 10; display: flex; align-items: center; gap: 2px;
    background: var(--glass); -webkit-backdrop-filter: blur(18px) saturate(1.5); backdrop-filter: blur(18px) saturate(1.5);
    border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow-rest);
    user-select: none; -webkit-user-select: none;
  }
  .tb {
    appearance: none; display: grid; place-items: center; width: 38px; height: 38px; padding: 0;
    border: 0; border-radius: 10px; background: none; color: var(--muted); cursor: pointer; position: relative;
    transition: background-color var(--t-fast) var(--ease), color var(--t-fast) var(--ease), transform var(--t-fast) var(--ease);
  }
  .tb:hover { background: var(--paper-2); color: var(--ink); }
  .tb:active { transform: scale(.94); }
  .tb[aria-pressed="true"] { background: var(--ink); color: var(--room); }
  .tb:disabled { opacity: .35; cursor: default; background: none; }
  .tb kbd {
    position: absolute; right: 3px; bottom: 2px; font: 600 8.5px/1 var(--ui); color: var(--faint); opacity: .75;
  }
  .tb[aria-pressed="true"] kbd { color: var(--room); opacity: .6; }
  .sep { width: 1px; height: 22px; margin: 0 4px; background: var(--line); flex: none; }

  .head { left: 14px; top: 14px; padding: 4px 4px 4px 14px; gap: 4px; max-width: calc(100% - 28px); }
  .head .name {
    margin: 0 6px 0 0; font-size: 15px; font-weight: 600; letter-spacing: -.01em; white-space: nowrap;
    overflow: hidden; text-overflow: ellipsis; max-width: 16rem; padding: 2px 4px; border-radius: 6px; cursor: text;
  }
  .head .name.marble-editing { background: var(--field); box-shadow: 0 0 0 1px var(--accent); user-select: text; -webkit-user-select: text; }
  .head .count { font-size: 12.5px; color: var(--faint); margin-right: 4px; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .head .save { width: 7px; height: 7px; border-radius: 50%; background: transparent; margin-right: 4px; flex: none; transition: background-color var(--t) var(--ease); }
  .head .save[data-state="saving"] { background: var(--accent); }
  .head .save[data-state="error"] { background: var(--danger); }
  .head .tb { width: 34px; height: 34px; }
  /* Undo and redo are the page's, so they sit in one transient wrapper that
     takes no part in the layout. */
  .head .hist { display: contents; }

  .view { right: 14px; top: 14px; padding: 4px; }
  .view .tb { width: 34px; height: 34px; }
  .view .zoom { min-width: 3.4rem; width: auto; padding: 0 .4rem; font-size: 12.5px; font-variant-numeric: tabular-nums; color: var(--muted); }
  .ask-btn {
    display: inline-flex; align-items: center; gap: .4rem; height: 34px; padding: 0 .85rem 0 .7rem; margin-left: 4px;
    border: 0; border-radius: 10px; background: var(--ink); color: var(--room); font-weight: 500; font-size: 13.5px; cursor: pointer;
    transition: background-color var(--t-fast) var(--ease), transform var(--t-fast) var(--ease);
  }
  .ask-btn:hover { background: color-mix(in srgb, var(--ink) 84%, var(--room)); }
  .ask-btn:active { transform: scale(.96); }
  .ask-btn .ic { width: 17px; height: 17px; }
  body[data-panel="open"] .ask-btn { display: none; }

  .dock { left: 50%; bottom: max(14px, env(safe-area-inset-bottom)); translate: -50% 0; padding: 5px; }
  .options {
    left: 50%; bottom: calc(max(14px, env(safe-area-inset-bottom)) + 58px); translate: -50% 0; padding: 5px 7px; gap: 4px;
    opacity: 0; pointer-events: none; transform: translateY(6px);
    transition: opacity var(--t) var(--ease), transform var(--t) var(--ease-out);
  }
  .options.marble-shown { opacity: 1; pointer-events: auto; transform: none; }
  .sw {
    width: 26px; height: 26px; padding: 0; border-radius: 50%; cursor: pointer;
    border: 2px solid var(--glass); background: var(--sw); box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 14%, transparent);
    transition: transform var(--t-fast) var(--ease), box-shadow var(--t-fast) var(--ease);
  }
  .sw:hover { transform: scale(1.1); }
  .sw[aria-pressed="true"] { box-shadow: 0 0 0 2px var(--ink); }
  .wd { width: 30px; height: 30px; display: grid; place-items: center; padding: 0; border: 0; border-radius: 8px; background: none; cursor: pointer; color: var(--ink); }
  .wd i { display: block; width: 16px; border-radius: 99px; background: currentColor; }
  .wd[aria-pressed="true"] { background: var(--paper-2); box-shadow: inset 0 0 0 1px var(--line); }
  .wd:hover { background: var(--paper-2); }
  .linkin { display: none; align-items: center; gap: 6px; }
  .options[data-for="link"] .linkin { display: flex; }
  .options[data-for="link"] .palette { display: none; }
  .linkin input {
    width: min(22rem, 64vw); height: 32px; padding: 0 .7rem; border: 1px solid var(--line); border-radius: 8px;
    background: var(--field); outline: none;
  }
  .linkin input:focus { border-color: var(--accent); }
  .palette { display: flex; align-items: center; gap: 5px; }

  /* What is in the drive, to put on the board or to point at in a message. */
  .drivepick {
    position: fixed; z-index: 40; width: min(27rem, calc(100vw - 24px)); max-height: min(28rem, 62vh);
    flex-direction: column; align-items: stretch; gap: 4px; padding: 6px;
  }
  .drivepick[hidden] { display: none; }
  .drivepick input {
    flex: none; height: 36px; padding: 0 .75rem; border: 1px solid var(--line); border-radius: 9px;
    background: var(--field); outline: none;
  }
  .drivepick input:focus { border-color: var(--accent); }
  .drivepick.marble-mention input { display: none; }
  .drivepick .k { margin: 4px 8px 0; font-size: 11.5px; color: var(--faint); }
  .drivepick .rows { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; display: grid; align-content: start; gap: 1px; }
  .drow {
    display: flex; align-items: center; gap: .6rem; width: 100%; min-width: 0; padding: .42rem .55rem;
    border: 0; border-radius: 8px; background: none; text-align: left; cursor: pointer;
  }
  .drow:hover, .drow[aria-selected="true"] { background: var(--paper-2); }
  .drow .ic { width: 18px; height: 18px; color: var(--muted); }
  .drow span { flex: 1; min-width: 0; }
  .drow b, .drow small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .drow b { font-weight: 500; font-size: 13.5px; }
  .drow small { font-size: 11.5px; color: var(--faint); }
  .drivepick .none { padding: .6rem .6rem; font-size: 13px; color: var(--faint); }

  .selbar { padding: 4px; gap: 2px; opacity: 0; pointer-events: none; transition: opacity var(--t-fast) var(--ease); }
  .selbar.marble-shown { opacity: 1; pointer-events: auto; }
  body.marble-moving .selbar, body.marble-moving .options { opacity: 0 !important; pointer-events: none !important; }
  .selbar .tb { width: 32px; height: 32px; }
  .selbar .tb .ic { width: 18px; height: 18px; }
  .selbar .sw { width: 22px; height: 22px; }
  .selbar .sz { width: auto; min-width: 30px; padding: 0 6px; font-size: 12px; font-weight: 600; }
  .selbar .ask-sel { width: auto; padding: 0 10px 0 8px; gap: 5px; display: inline-flex; color: var(--ink); font-size: 12.5px; font-weight: 500; }
  .selbar .danger:hover { color: var(--danger); }

  .toast {
    position: absolute; left: 50%; top: 16px; translate: -50% 0; z-index: 20; padding: .5rem .9rem;
    border-radius: var(--pill); background: var(--ink); color: var(--room); font-size: 13px;
    opacity: 0; pointer-events: none; transition: opacity var(--t) var(--ease), transform var(--t) var(--ease-out); transform: translateY(-6px);
  }
  .toast.marble-shown { opacity: 1; transform: none; }
  .drop-hint {
    position: absolute; inset: 10px; z-index: 15; border: 2px dashed var(--accent); border-radius: 18px;
    background: color-mix(in srgb, var(--accent-soft) 50%, transparent); display: none; place-content: center;
    font-size: 16px; font-weight: 500; color: var(--accent-ink); pointer-events: none;
  }
  body.marble-dropping .drop-hint { display: grid; }

  /* ------------------------------------------------------------------ panel

     The conversation about the board. Its words and ideas are the file's;
     the thread is the host's, read back from the event stream. */
  .panel {
    grid-row: 1; width: var(--panel); min-width: 0; height: 100dvh; display: flex; flex-direction: column;
    background: var(--room); border-left: 1px solid var(--line); position: relative; z-index: 12;
  }
  body[data-panel="closed"] .panel { display: none; }
  .panel-bar { flex: none; display: flex; align-items: center; gap: 2px; height: 3.25rem; padding: 0 .5rem 0 1rem; border-bottom: 1px solid transparent; }
  .panel.marble-scrolled .panel-bar { border-bottom-color: var(--line); }
  .panel-bar .title { flex: 1; min-width: 0; margin: 0; font-size: 14px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .panel-bar .tb { width: 34px; height: 34px; }
  .model {
    display: inline-flex; align-items: center; gap: .15rem; height: 30px; padding: 0 .45rem 0 .65rem; margin-right: 2px;
    border: 0; border-radius: var(--pill); background: none; color: var(--muted); font-size: 12.5px; cursor: pointer; white-space: nowrap;
  }
  .model:hover { background: var(--paper-2); color: var(--ink); }
  .model .ic { width: 15px; height: 15px; }
  .menu {
    margin: 0; inset: auto; position: fixed; min-width: 13rem; max-width: 20rem; max-height: 60vh; overflow: auto; padding: .3rem;
    border: 1px solid var(--line); border-radius: var(--r); background: var(--glass);
    -webkit-backdrop-filter: blur(18px) saturate(1.5); backdrop-filter: blur(18px) saturate(1.5); box-shadow: var(--shadow-lift); color: var(--ink);
  }
  .menu .k { margin: .3rem .6rem .25rem; font-size: 11.5px; color: var(--faint); }
  .menu button {
    display: flex; align-items: center; gap: .6rem; width: 100%; padding: .45rem .6rem; border: 0; border-radius: var(--r-sm);
    background: none; text-align: left; cursor: pointer; font-size: 13.5px;
  }
  .menu button span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .menu button small { color: var(--faint); font-size: 12px; flex: none; }
  .menu button:hover, .menu button:focus-visible { background: var(--paper-2); outline: none; }
  .menu button .ic { width: 16px; height: 16px; opacity: 0; }
  .menu button[aria-checked="true"] .ic { opacity: 1; }
  .menu .none { padding: .5rem .6rem; color: var(--faint); font-size: 13px; }

  .log { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 0 1.1rem; display: flex; flex-direction: column; }
  .hello { padding: 1.4rem 0 1rem; display: grid; gap: .55rem; }
  .panel:not(.marble-fresh) .hello { display: none; }
  .hello h2 { margin: 0; font-size: 19px; font-weight: 600; letter-spacing: -.015em; }
  .hello p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.55; }
  .ideas { list-style: none; margin: .5rem 0 0; padding: 0; display: grid; gap: .35rem; }
  .idea {
    width: 100%; text-align: left; padding: .6rem .8rem; border: 1px solid var(--line); border-radius: var(--r);
    background: var(--card); cursor: pointer; font-size: 13.5px; color: var(--ink);
    transition: border-color var(--t-fast) var(--ease), background-color var(--t-fast) var(--ease);
  }
  .idea:hover { border-color: var(--accent); background: var(--accent-soft); }

  .thread { flex: 1 0 auto; padding: .75rem 0 1.25rem; }
  .turn { display: flex; flex-direction: column; }
  .turn + .turn { margin-top: 1.35rem; }
  .me {
    align-self: flex-end; max-width: 92%; padding: .55rem .85rem; border-radius: var(--r-bubble);
    background: var(--bubble); font-size: 14.5px; line-height: 1.5; white-space: pre-wrap; overflow-wrap: anywhere; margin-bottom: .7rem;
  }
  .me .from { display: block; margin-bottom: .1rem; font-size: 12px; color: var(--muted); }
  .me .sent { display: flex; align-items: center; gap: .55rem; margin-top: .45rem; font-size: 12px; color: var(--muted); white-space: normal; }
  .me .sent img { width: 72px; height: 48px; object-fit: cover; border-radius: 6px; background: var(--card); border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent); }
  .turn.marble-pending .me, .turn.marble-queued .me { opacity: .6; }
  .reply { font-size: 14.5px; line-height: 1.6; overflow-wrap: anywhere; }
  .reply > * + * { margin-top: .7rem; }
  .md p { margin: 0 0 .7em; }
  .md > :last-child { margin-bottom: 0; }
  .md .md-h { margin: 1.05em 0 .35em; font-size: 1.02em; font-weight: 600; line-height: 1.35; }
  .md > .md-h:first-child { margin-top: 0; }
  .md ul, .md ol { margin: .25em 0 .7em; padding-left: 1.3em; }
  .md li + li { margin-top: .2em; }
  .md a { color: var(--accent-ink); text-underline-offset: .18em; }
  .md strong, .md b { font-weight: 600; }
  .md code { font: .88em/1.4 var(--mono); background: var(--paper-2); padding: 1px 5px; border-radius: var(--r-text); }
  .md pre { margin: .25em 0 .8em; padding: .7rem .85rem; background: var(--paper-2); border-radius: var(--r); overflow-x: auto; }
  .md pre code { background: none; padding: 0; font-size: 12.5px; }
  .md blockquote { margin: .25em 0 .7em; padding: 0 0 0 .9rem; color: var(--muted); box-shadow: inset 3px 0 0 var(--line); }
  .md table { border-collapse: collapse; margin: .25em 0 .8em; font-size: 13px; display: block; overflow-x: auto; }
  .md th, .md td { padding: .35rem .6rem; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  .md.marble-live > :last-child::after { content: ''; display: inline-block; width: .55em; height: .55em; margin-left: .2em; border-radius: 50%; background: var(--accent); vertical-align: .05em; animation: breathe 1s var(--ease) infinite; }
  .dots { display: flex; gap: 5px; height: 1.6em; align-items: center; }
  .dots i { width: 7px; height: 7px; border-radius: 50%; background: var(--faint); animation: breathe 1.2s var(--ease) infinite; }
  .dots i:nth-child(2) { animation-delay: .15s; }
  .dots i:nth-child(3) { animation-delay: .3s; }
  @keyframes breathe { 0%, 100% { opacity: .3; } 50% { opacity: 1; } }
  .work { font-size: 13px; color: var(--muted); }
  .work summary { display: inline-flex; align-items: center; gap: .4rem; padding: .2rem .55rem .2rem .45rem; margin-left: -.45rem; border-radius: var(--pill); cursor: pointer; list-style: none; }
  .work summary::-webkit-details-marker { display: none; }
  .work summary:hover { background: var(--paper-2); color: var(--ink); }
  .work summary .ic { width: 14px; height: 14px; transition: transform var(--t) var(--ease-out); }
  .work[open] summary .ic { transform: rotate(90deg); }
  .work[data-state="running"] .work-label {
    background: linear-gradient(90deg, var(--muted) 0%, var(--muted) 40%, var(--ink) 50%, var(--muted) 60%, var(--muted) 100%) 0 0 / 250% 100%;
    -webkit-background-clip: text; background-clip: text; color: transparent; animation: sheen 1.8s linear infinite;
  }
  @keyframes sheen { from { background-position: 100% 0; } to { background-position: 0 0; } }
  .steps { margin: .35rem 0 .1rem; padding: 0 0 0 .95rem; list-style: none; box-shadow: inset 1px 0 0 var(--line); }
  .steps li { display: flex; gap: .45rem; padding: .12rem 0 .12rem .55rem; min-width: 0; }
  .steps b { flex: none; font-weight: 500; color: var(--ink); }
  .steps span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--faint); font-family: var(--mono); font-size: 12px; padding-top: 1px; }
  .steps li[data-state="failed"] b { color: var(--danger); }
  .note-line { font-size: 13px; color: var(--muted); }
  .err { font-size: 13.5px; color: var(--danger); }
  .made {
    display: flex; align-items: center; gap: .5rem; padding: .55rem .6rem .55rem .8rem; border: 1px solid var(--line);
    border-radius: var(--r); background: var(--card); font-size: 13px;
  }
  .made .ic { width: 16px; height: 16px; color: var(--accent-ink); }
  .made a { flex: 1; min-width: 0; color: var(--ink); font-weight: 500; text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .made a:hover { text-decoration: underline; text-underline-offset: .18em; }
  .made button { flex: none; height: 28px; padding: 0 .65rem; border: 1px solid var(--line); border-radius: var(--pill); background: none; cursor: pointer; font-size: 12.5px; color: var(--muted); }
  .made button:hover { color: var(--ink); border-color: var(--accent); }
  .made button:disabled { opacity: .5; cursor: default; }
  .acts { display: flex; gap: .1rem; margin-top: .3rem !important; margin-left: -.4rem; opacity: 0; transition: opacity var(--t) var(--ease); }
  .turn:hover .acts, .turn:last-child .acts { opacity: 1; }
  @media (hover: none) { .acts { opacity: 1; } }
  .acts .tb { width: 30px; height: 30px; }
  .acts .tb .ic { width: 16px; height: 16px; }
  .ask { margin: .25rem 0; padding: .8rem 1rem; border: 1px solid var(--line); border-radius: var(--r); background: var(--card); display: grid; gap: .65rem; box-shadow: var(--shadow); font-size: 13.5px; }
  .ask .ask-title { font-weight: 600; }
  .ask pre { margin: 0; font: 12px/1.5 var(--mono); white-space: pre-wrap; word-break: break-word; background: var(--paper-2); padding: .5rem .65rem; border-radius: var(--r-sm); }
  .ask .ask-options { display: grid; gap: 2px; }
  .ask .ask-options button { display: grid; grid-template-columns: 20px 1fr; column-gap: .5rem; align-items: baseline; text-align: left; padding: .45rem .6rem; border: 1px solid transparent; border-radius: var(--r-sm); background: none; cursor: pointer; }
  .ask .ask-options button:hover { background: var(--paper-2); }
  .ask .ask-options button[aria-checked="true"] { border-color: var(--accent-ink); background: var(--accent-soft); }
  .ask .ask-options small { grid-column: 2; color: var(--muted); font-size: 12px; }
  .ask .ask-actions { display: flex; gap: .4rem; align-items: center; flex-wrap: wrap; }
  .ask .ask-actions button { padding: .4rem .85rem; border-radius: var(--pill); border: 1px solid var(--line); background: none; cursor: pointer; }
  .ask .ask-actions button.allow, .ask .ask-actions button.answer { background: var(--ink); color: var(--room); border-color: var(--ink); }
  .ask .ask-other-text, .ask .deny-note { font: inherit; font-size: 13px; padding: .4rem .6rem; border: 1px solid var(--line); border-radius: var(--r-sm); background: none; }
  .ask .ask-other-text[hidden] { display: none; }
  figure.visual { margin: .25rem 0; }
  .visual-pending { height: 110px; border-radius: var(--r); background: var(--paper-2); animation: breathe 1.4s var(--ease) infinite; }

  .compose { position: sticky; bottom: 0; flex: none; padding: .4rem 0 max(1rem, env(safe-area-inset-bottom)); background: linear-gradient(to bottom, transparent, var(--room) .6rem); }
  .scope { display: flex; align-items: center; gap: .4rem; margin: 0 0 .45rem .2rem; font-size: 12px; color: var(--muted); min-height: 24px; }
  .scope .chip { display: inline-flex; align-items: center; gap: .35rem; height: 24px; padding: 0 .55rem 0 .45rem; border-radius: var(--pill); background: var(--paper-2); color: var(--ink); }
  .scope .chip .ic { width: 14px; height: 14px; color: var(--muted); }
  .scope .chip[data-scope="selection"] { background: color-mix(in srgb, var(--select) 16%, var(--card)); }
  .scope button { height: 24px; padding: 0 .5rem; border: 0; border-radius: var(--pill); background: none; color: var(--muted); cursor: pointer; font-size: 12px; }
  .scope button:hover { background: var(--paper-2); color: var(--ink); }
  .field {
    position: relative; display: flex; align-items: flex-end; gap: .5rem; padding: .4rem .4rem .4rem 1rem; min-height: 50px;
    background: var(--field); border: 1px solid var(--line); border-radius: var(--r-field); box-shadow: var(--shadow-rest);
    transition: border-color var(--t) var(--ease);
  }
  .field:focus-within { border-color: color-mix(in srgb, var(--accent) 60%, var(--line)); }
  .field textarea {
    flex: 1; min-width: 0; min-height: 36px; max-height: 32vh; margin: 0; padding: .45rem 0; resize: none;
    border: 0; outline: none; background: none; font: 14.5px/1.45 var(--ui); caret-color: var(--accent-ink); field-sizing: content;
  }
  .field textarea::placeholder { color: var(--placeholder); }
  .send {
    flex: none; display: grid; place-items: center; width: 36px; height: 36px; padding: 0; border: 0; border-radius: 50%; cursor: pointer;
    background: var(--ink); color: var(--room); transition: background-color var(--t) var(--ease), opacity var(--t) var(--ease);
  }
  .send:hover { background: color-mix(in srgb, var(--ink) 82%, var(--room)); }
  .send .ic { width: 18px; height: 18px; stroke-width: 2; }
  .send .i-stop { display: none; }
  .send[data-mode="stop"] .i-send { display: none; }
  .send[data-mode="stop"] .i-stop { display: block; fill: currentColor; stroke: none; }
  .send:disabled { opacity: .3; cursor: default; }
  .hint { margin: .45rem 0 0; text-align: center; font-size: 11.5px; color: var(--faint); }
  body.marble-offline .field { opacity: .6; }

  /* ----------------------------------------------------------------- narrow

     On a phone the conversation is a sheet over the lower part of the board,
     and the tools sit above whatever is open. */
  @container app (max-width: 46rem) {
    body.app { grid-template-columns: minmax(0, 1fr); }
    .panel {
      position: fixed; left: 0; right: 0; bottom: 0; width: auto; height: min(64dvh, 40rem);
      border-left: 0; border-top: 1px solid var(--line); border-radius: 18px 18px 0 0; box-shadow: var(--shadow-lift);
    }
    .head .name { max-width: 9rem; }
    .ask-btn { width: 34px; padding: 0; justify-content: center; }
    .ask-btn span { display: none; }
    .head .count, .view .zoom, .view [data-cmd="fit"], .tb kbd { display: none; }
    .dock { max-width: calc(100% - 16px); overflow-x: auto; scrollbar-width: none; }
    .tb { width: 40px; height: 40px; }
    body[data-panel="open"] .dock, body[data-panel="open"] .options, body[data-panel="open"] .selbar { visibility: hidden; }
  }
  @media (pointer: coarse) {
    .handle { width: 22px; height: 22px; margin: -11px 0 0 -11px; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { transition-duration: 1ms !important; animation-duration: 1ms !important; animation-iteration-count: 1 !important; }
  }
  @media (prefers-reduced-transparency: reduce) {
    .hud, .menu { background: var(--card); -webkit-backdrop-filter: none; backdrop-filter: none; }
  }
</style>
</head>
<body class="app" data-marble-id="__ID__" data-panel="open" data-model="" data-conversation="">

