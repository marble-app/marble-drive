      parts.push(h('span', 'sep'));
      const widths = [];
      for (const w of WIDTHS[tool]) {
        const b = h('button', 'wd');
        b.type = 'button';
        b.title = `${w}px`;
        b.setAttribute('aria-pressed', String(prefs[tool] === w));
        const i = h('i');
        i.style.height = `${Math.max(2, Math.min(14, w / (tool === 'marker' ? 3 : 1)))}px`;
        i.style.color = inkCss(prefs.ink);
        i.style.background = inkCss(prefs.ink);
