<!doctype html>
<html lang="en" data-marble="1">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="marble:capabilities" content="storage; net=none">
<title>__TITLE__</title>
__ICON__
<style>
  /* A LaTeX project, as one file.

     The layout is the one every TeX editor has settled on — files at the left,
     source in the middle, the paper at the right — because it is the one that
     lets you watch a change land. What is different here is where the pieces
     live: the source is markup in this file, the engine is one of the scripts in it,
     and the PDF is the only thing that is neither, because a PDF is a
     rendering of a source and this document keeps sources.

     The palette is Marble's. One dusty blue does the accenting; the desk behind
     the PDF is the only grey, because that is the one place where a page has to
     look like a page sitting on something. */
  :root {
    --ink: #111111;
    --muted: #5a5a5a;
    --faint: #8a8a8a;
    --line: #ddd9cf;
    --paper: #ffffff;
    --chrome: #fbfaf7;
    --card: #ffffff;
    --accent: #9bb6cf;
    --accent-soft: #f1f5f8;
    --accent-ink: #738698;
    --desk: #6f7378;
    --ok: #4b7f52;
    --warn: #9a7a3a;
    --bad: #b4544f;
    --radius: 4px;
    --rail: 13rem;
    --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
    --ui: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    --code: 12.5px;
    --leading: 1.55;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --ink: #e8e6e1; --muted: #a3a7ab; --faint: #7d8288; --line: #2f3438;
      --paper: #1c1f22; --chrome: #191c1f; --card: #1c1f22;
      --accent: #7fa8c9; --accent-soft: #1d2932; --accent-ink: #9dc0dc;
      --desk: #303438; --ok: #7fb489; --warn: #cfae7f; --bad: #e08c88;
    }
  }
  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    margin: 0; background: var(--paper); color: var(--ink);
    font: 13px/1.5 var(--ui); -webkit-font-smoothing: antialiased;
    overflow: hidden;
  }

  /* ----------------------------------------------------------------- shell */

  .app {
    height: 100vh; display: grid;
    grid-template-rows: 2.9rem minmax(0, 1fr) auto;
  }
  .main {
    display: grid; min-height: 0;
    grid-template-columns: var(--rail) var(--split, 46%) minmax(0, 1fr);
  }
  .app[data-layout="editor"] .main { grid-template-columns: var(--rail) minmax(0, 1fr) 0; }
  .app[data-layout="pdf"]    .main { grid-template-columns: var(--rail) 0 minmax(0, 1fr); }
  .app[data-layout="editor"] .pdfpane,
  .app[data-layout="pdf"] .editorpane { display: none; }
  .app[data-rail="closed"] { --rail: 0px; }
  .app[data-rail="closed"] .rail { display: none; }

  /* --------------------------------------------------------------- the bar */

  .bar {
    display: flex; align-items: center; gap: .35rem; padding: 0 .55rem;
    border-bottom: 1px solid var(--line); background: var(--chrome);
  }
  .brand { display: flex; align-items: center; gap: .45rem; min-width: 0; }
  .brand .dot {
    width: .7rem; height: .7rem; border-radius: 50%; flex: none;
    background: radial-gradient(circle at 32% 30%, #ffffff 0 8%, var(--accent) 42%, var(--accent-ink) 100%);
  }
  .title {
    font-weight: 600; font-size: .85rem; letter-spacing: -.005em;
    padding: .15rem .3rem; border-radius: var(--radius); outline: none;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 22rem;
  }
  .kind { color: var(--faint); font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; }
  .acts { display: flex; align-items: center; gap: .35rem; margin-left: auto; }

  .btn {
    appearance: none; display: inline-flex; align-items: center; gap: .35rem;
    padding: .3rem .6rem; border: 1px solid var(--line); border-radius: 999px;
    background: var(--card); color: var(--muted);
    font: 500 .76rem/1.35 var(--ui); cursor: pointer; white-space: nowrap;
  }
  .btn:hover { color: var(--accent-ink); border-color: var(--accent); }
  .btn[aria-pressed="true"] { background: var(--accent-soft); color: var(--accent-ink); border-color: var(--accent); }
  .btn.go { background: var(--accent-ink); border-color: var(--accent-ink); color: #fff; }
  .btn.go:hover { filter: brightness(1.08); color: #fff; }
  .btn.go[data-busy="1"] { opacity: .55; }
  .btn .ico { font-size: .8em; opacity: .9; }
  .seg { display: inline-flex; border: 1px solid var(--line); border-radius: 999px; overflow: hidden; background: var(--card); }
  .seg .btn { border: 0; border-radius: 0; padding: .3rem .5rem; }
  .seg .btn + .btn { border-left: 1px solid var(--line); }

  /* -------------------------------------------------------------- the rail */

  .rail {
    border-right: 1px solid var(--line); background: var(--chrome);
    overflow: auto; display: flex; flex-direction: column; min-width: 0;
  }
  .rail h2 {
    margin: 0; padding: .7rem .75rem .35rem; font-size: .68rem; letter-spacing: .09em;
    text-transform: uppercase; color: var(--faint); font-weight: 600;
  }
  .filelist { list-style: none; margin: 0; padding: 0 .35rem .35rem; }
  .frow {
    display: flex; align-items: center; gap: .4rem; padding: .28rem .4rem;
    border-radius: var(--radius); cursor: default; color: var(--muted);
    font-size: .78rem; white-space: nowrap;
  }
  .frow:hover { background: var(--accent-soft); }
  .frow.marble-open { background: var(--accent-soft); color: var(--accent-ink); font-weight: 600; }
  .frow .glyph { width: 1rem; text-align: center; opacity: .65; font-size: .78em; }
  .frow .fn { flex: 1 1 auto; overflow: hidden; text-overflow: ellipsis; }
  .frow .kill { opacity: 0; border: 0; background: none; color: inherit; cursor: pointer; font: inherit; padding: 0 .2rem; }
  .frow:hover .kill { opacity: .5; }
  .frow .kill:hover { opacity: 1; color: var(--bad); }
  .railfoot { margin-top: auto; padding: .5rem .6rem; border-top: 1px solid var(--line); display: grid; gap: .35rem; }
  .railnote { font-size: .68rem; line-height: 1.5; color: var(--faint); padding: 0 .75rem .6rem; }

  /* ------------------------------------------------------------ the editor */

  .editorpane { display: flex; flex-direction: column; min-width: 0; position: relative; }
  .sheets { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }
  .file { display: none; flex: 1 1 auto; min-height: 0; flex-direction: column; }
  .file.marble-open { display: flex; }
  .fhead {
    display: flex; align-items: baseline; gap: .5rem; padding: .35rem .6rem .35rem 3.6rem;
    border-bottom: 1px solid var(--line); background: var(--chrome);
  }
  .fname {
    margin: 0; font: 600 .76rem/1.4 var(--mono); color: var(--muted);
    padding: .1rem .25rem; border-radius: 3px; outline: none;
  }
  .fmeta { font: .68rem/1.4 var(--mono); color: var(--faint); }

  .codewrap { position: relative; flex: 1 1 auto; min-height: 0; overflow: auto; background: var(--paper); }
  .codebox { position: relative; min-height: 100%; }
  .src, .hl {
    margin: 0; padding: .55rem .9rem 40vh 3.6rem;
    font: var(--code)/var(--leading) var(--mono);
    white-space: pre-wrap; overflow-wrap: break-word; tab-size: 2;
  }
  .hl { position: absolute; inset: 0; pointer-events: none; user-select: none; color: var(--ink); }
  .src { position: relative; color: transparent; caret-color: var(--accent-ink); outline: none; background: none; }
  .src::selection { background: rgba(155, 182, 207, .38); }
  .hl .ln { display: block; position: relative; min-height: calc(var(--code) * var(--leading)); }
  .hl .ln > .n {
    position: absolute; left: -2.9rem; width: 2.3rem; text-align: right;
    color: var(--faint); opacity: .55; font-style: normal; user-select: none;
  }
  .hl .ln.marble-hot { background: var(--accent-soft); box-shadow: -3.6rem 0 0 var(--accent-soft), .9rem 0 0 var(--accent-soft); }
  .hl .cs   { color: #2f6f9f; }
  .hl .arg  { color: #6f4b8f; }
  .hl .mth  { color: #8a5a2b; }
  .hl .com  { color: var(--faint); font-style: italic; }
  .hl .brc  { color: var(--accent-ink); }
  .hl .num  { color: #7a6a3a; }
  @media (prefers-color-scheme: dark) {
    .hl .cs { color: #86b8dd; } .hl .arg { color: #c2a4de; } .hl .mth { color: #dcae7d; }
    .hl .num { color: #cbbd8a; } .src::selection { background: rgba(127, 168, 201, .3); }
  }

  /* The divider between the source and the paper. Dragging it is an edit like
     any other: it moves the panes and it writes one custom property. */
  .grabber { position: absolute; top: 0; right: -3px; bottom: 0; width: 6px; cursor: col-resize; z-index: 4; }
  .grabber:hover, .grabber[data-dragging="1"] { background: var(--accent); }
  .app[data-layout="editor"] .grabber, .app[data-layout="pdf"] .grabber { display: none; }

  .shot { padding: 1rem; overflow: auto; background: var(--paper); flex: 1 1 auto; min-height: 0; }
  .shot img { max-width: 100%; height: auto; border: 1px solid var(--line); border-radius: var(--radius); }

  /* --------------------------------------------------------------- the pdf */

  .pdfpane { display: flex; flex-direction: column; min-width: 0; border-left: 1px solid var(--line); background: var(--desk); }
  .pdfbar {
    display: flex; align-items: center; gap: .35rem; padding: .25rem .45rem;
    background: var(--chrome); border-bottom: 1px solid var(--line);
  }
  .pdfbar .btn { padding: .22rem .45rem; font-size: .72rem; }
  .pdfnote { font: .7rem/1.4 var(--mono); color: var(--faint); padding-left: .2rem; }
  .viewer { flex: 1 1 auto; min-height: 0; position: relative; }
  .viewer iframe { width: 100%; height: 100%; border: 0; display: block; background: var(--desk); }
  .curtain {
    position: absolute; inset: 0; display: grid; place-content: center; gap: .4rem; text-align: center;
    color: #e2e4e7; font-size: .78rem; background: var(--desk); padding: 2rem;
  }
  .curtain[hidden] { display: none; }
  .curtain .big { font-size: 1.5rem; opacity: .55; }

  /* --------------------------------------------------------------- the log */

  .logpane { border-top: 1px solid var(--line); background: var(--chrome); display: flex; flex-direction: column; }
  .loghead {
    display: flex; align-items: center; gap: .5rem; padding: .3rem .6rem;
    font: .72rem/1.5 var(--ui); color: var(--muted); cursor: pointer; user-select: none;
  }
  .loghead .pill {
    font: 600 .66rem/1 var(--mono); letter-spacing: .04em; padding: .24rem .42rem;
    border-radius: 999px; border: 1px solid var(--line); color: var(--muted);
  }
  .loghead .pill[data-state="ok"]   { color: var(--ok);   border-color: var(--accent); }
  .loghead .pill[data-state="warn"] { color: var(--warn); border-color: var(--warn); }
  .loghead .pill[data-state="bad"]  { color: var(--bad);  border-color: var(--bad); }
  .logbody { display: none; max-height: 12rem; overflow: auto; padding: 0 0 .4rem; }
  .app[data-log="open"] .logbody { display: block; }
  .app[data-log="open"] .loghead .chev { transform: rotate(180deg); }
  .loghead .chev { transition: transform .15s ease; opacity: .5; display: inline-block; margin-left: auto; }
  .logline {
    display: grid; grid-template-columns: 5.5rem 1fr; gap: .5rem; align-items: baseline;
    padding: .16rem .6rem; font: .72rem/1.5 var(--mono); color: var(--muted);
  }
  .logline:hover { background: var(--accent-soft); }
  .logline .at { color: var(--accent-ink); text-align: right; cursor: pointer; }
  .logline[data-level="error"] .what { color: var(--bad); }
  .logline[data-level="warning"] .what { color: var(--warn); }

  [data-marble-editable]:hover { background: var(--accent-soft); }
  [data-marble-editable]:focus { background: var(--card); box-shadow: 0 0 0 1px var(--accent), 0 0 0 4px var(--accent-soft); }

  @media (max-width: 900px) {
    .app { --rail: 0px; }
    .rail { display: none; }
    .main { grid-template-columns: 0 var(--split, 50%) minmax(0, 1fr); }
  }
</style>
</head>
<body>
<!-- The shell holds every decision this app makes about itself — which file is
     open, how the panes are split, whether it typesets as you type. Each of
     them is one attribute, so each is one setAttr, and an editor changes them
     the same way a click does. -->
<div class="app" id="app" data-marble-id="__ID__"
     data-active="main" data-layout="split" data-auto="on" data-zoom="page-width"
     data-rail="open" data-log="closed">

  <header class="bar" data-marble-id="__ID__">
    <span class="dot"></span>
    <h1 class="title" data-marble-id="__ID__" data-marble-editable>__TITLE__</h1>
    <span class="kind" data-marble-id="__ID__" data-marble-editable>LaTeX</span>

    <!-- Chrome, and it says so. The labels above are content — type over them
         and the file has changed — but a button that recompiles is the page's,
         so it is kept out of addressing rather than left half in it. -->
    <div class="acts" data-marble-transient>
      <button class="btn" id="toggle-rail" title="Files (⌘B)"><span class="ico">▤</span></button>
      <div class="seg">
        <button class="btn" data-set-layout="editor" title="Source only">◧</button>
        <button class="btn" data-set-layout="split" title="Side by side">◫</button>
        <button class="btn" data-set-layout="pdf" title="PDF only">◨</button>
      </div>
      <button class="btn" id="toggle-auto" title="Typeset as you type">auto</button>
      <button class="btn go" id="compile" title="Recompile (⌘⏎)"><span class="ico">▶</span> Recompile</button>
      <button class="btn" id="get-pdf" title="Download the PDF">⤓ PDF</button>
      <button class="btn" id="get-tex" title="Download the open file">⤓ .tex</button>
    </div>
  </header>

  <div class="main">

    <aside class="rail" id="rail">
      <h2 data-marble-id="__ID__" data-marble-editable>Project</h2>
      <ul class="filelist" id="railfiles" data-marble-transient></ul>
      <p class="railnote" data-marble-id="__ID__" data-marble-editable>Every file here is an element in this document, and the engine that typesets them is a script in it.</p>
      <div class="railfoot" data-marble-transient>
        <button class="btn" id="new-tex">+ TeX file</button>
        <button class="btn" id="new-bib">+ BibTeX file</button>
      </div>
    </aside>

    <section class="editorpane">
      <div class="sheets" id="files" data-marble-id="__ID__">

        <!-- A file is a section: its name is a heading you can type over, its
             source is a <pre> you can type into, and both are in the bytes on
             disk. The gutter, the colouring and the line the compiler is
             complaining about are drawn over it and belong to the page. -->
        <section class="file" data-marble-id="__ID__" data-key="main" data-kind="tex">
          <header class="fhead" data-marble-id="__ID__">
            <h3 class="fname" data-marble-id="__ID__" data-marble-editable>main.tex</h3>
            <span class="fmeta" data-marble-transient></span>
          </header>
          <div class="codewrap" data-marble-id="__ID__">
            <div class="codebox" data-marble-id="__ID__">
              <pre class="hl" data-marble-transient aria-hidden="true"></pre>
              <pre class="src" data-marble-id="__ID__" data-marble-code>\documentclass[11pt]{article}

\usepackage{amsmath}
\usepackage{graphicx}

\title{__TITLE__}
\author{A Marble document}
\date{\today}

\newcommand{\R}{\mathbb{R}}

\begin{document}
\maketitle

\begin{abstract}
This project is one file. The source in the left pane, the editor you are
reading it in, and the engine that turned it into the PDF on the right are all
elements of the same document --- there is no server in the loop, and nothing
here was uploaded anywhere.
\end{abstract}

\tableofcontents

\section{Writing}

Type in the pane on the left and press \textbf{Recompile}, or leave
\emph{auto} on and it will typeset a moment after you stop. Words wrap and
paragraphs justify the way \LaTeX{} does them; a blank line starts a new one.

You get the usual marks: \textbf{bold}, \emph{emphasis}, \texttt{monospace},
quotes that curl like ``this'', dashes that are dashes---like that one---and
footnotes\footnote{Which collect at the foot of the page they were called
from, numbered in order.} where you want them.

\subsection{Lists}

\begin{itemize}
  \item Bullets, nested as deep as you like.
  \begin{itemize}
    \item The marker changes with the depth.
  \end{itemize}
  \item And they break across pages.
\end{itemize}

\begin{enumerate}
  \item Numbers, if the order matters.
  \item Cross-references know their numbers too --- see
        Section~\ref{sec:maths}.
\end{enumerate}

\section{Mathematics}
\label{sec:maths}

Inline maths sits in the line: $e^{i\pi} + 1 = 0$, and $f : \R^n \to \R$ is
set in the maths italic you would expect.

Displayed maths gets its own space and, in an \texttt{equation}, its own
number:

\begin{equation}\label{eq:gauss}
  \int_{-\infty}^{\infty} e^{-x^2}\,dx = \sqrt{\pi}
\end{equation}

Equation~\ref{eq:gauss} is the one everybody knows. Alignment works the way
\texttt{amsmath} does it, on the ampersands:

\begin{align}
  (a+b)^2 &amp;= a^2 + 2ab + b^2 \\
          &amp;= \sum_{k=0}^{2} \binom{2}{k} a^{2-k} b^{k}
\end{align}

\[
  \frac{\partial u}{\partial t} = \alpha \nabla^2 u,
  \qquad
  A = \begin{pmatrix} 1 &amp; 2 \\ 3 &amp; 4 \end{pmatrix}
\]

\section{Tables and figures}

\begin{table}[h]
\centering
\begin{tabular}{lrr}
\hline
What it holds &amp; Lines &amp; Share \\
\hline
Your sources &amp; 96 &amp; 4\% \\
The engine &amp; 2310 &amp; 94\% \\
The chrome &amp; 44 &amp; 2\% \\
\hline
\end{tabular}
\caption{Where a document like this spends its bytes.}
\label{tab:bytes}
\end{table}

Table~\ref{tab:bytes} is a \texttt{tabular} inside a \texttt{table}, captioned
and numbered. Drop an image onto the file list and
\verb|\includegraphics| will place it.

\section{Citing}

The bibliography comes from \texttt{references.bib}, and only the entries you
cite are printed \cite{knuth1984, lamport1994}. Links work too:
\url{https://www.latex-project.org}.

\bibliographystyle{plain}
\bibliography{references}

\end{document}
</pre>
            </div>
          </div>
        </section>

        <section class="file" data-marble-id="__ID__" data-key="refs" data-kind="bib">
          <header class="fhead" data-marble-id="__ID__">
            <h3 class="fname" data-marble-id="__ID__" data-marble-editable>references.bib</h3>
            <span class="fmeta" data-marble-transient></span>
          </header>
          <div class="codewrap" data-marble-id="__ID__">
            <div class="codebox" data-marble-id="__ID__">
              <pre class="hl" data-marble-transient aria-hidden="true"></pre>
              <pre class="src" data-marble-id="__ID__" data-marble-code>@book{knuth1984,
  author    = {Donald E. Knuth},
  title     = {The {\TeX}book},
  publisher = {Addison-Wesley},
  year      = {1984},
  address   = {Reading, Massachusetts}
}

@book{lamport1994,
  author    = {Leslie Lamport},
  title     = {{\LaTeX}: A Document Preparation System},
  publisher = {Addison-Wesley},
  year      = {1994},
  edition   = {2nd}
}
</pre>
            </div>
          </div>
        </section>
      </div>
      <div class="grabber" id="grabber" data-marble-transient></div>
    </section>

    <!-- The PDF is the one thing here that is not kept: it is what the sources
         mean, recomputed whenever they change, so it lives in the page and
         never in the file. -->
    <section class="pdfpane" data-marble-transient>
      <div class="pdfbar">
        <button class="btn" data-set-zoom="out" title="Zoom out">−</button>
        <button class="btn" data-set-zoom="in" title="Zoom in">+</button>
        <button class="btn" data-set-zoom="page-width" title="Fit the width">fit</button>
        <span class="pdfnote" id="pdfnote">not typeset yet</span>
      </div>
      <div class="viewer">
        <iframe id="pdfframe" title="PDF preview"></iframe>
        <div class="curtain" id="curtain">
          <div class="big">▶</div>
          <div>Press Recompile, or ⌘⏎, to typeset the project.</div>
        </div>
      </div>
    </section>

  </div>

  <div class="logpane" data-marble-transient>
    <div class="loghead" id="loghead">
      <span class="pill" id="logpill" data-state="idle">idle</span>
      <span id="logsummary">The engine runs in this page. Nothing is uploaded anywhere.</span>
      <span class="chev">⌄</span>
    </div>
    <div class="logbody" id="logbody"></div>
  </div>

</div>

<!-- ===================================================================== -->
<!-- The engine. Five scripts: what the letters measure, how a PDF is       -->
<!-- written, how TeX is read, how mathematics is set, and how the two      -->
<!-- become pages. Then one more that wires the room around them.          -->
<!-- ===================================================================== -->

<script data-marble-id="__ID__">
// ---------------------------------------------------------------- metrics
//
// Every PDF reader can draw the fourteen fonts Adobe made standard without
// being sent one, which is why this document can typeset without a network:
// the paper is set in Times, Helvetica, Courier and Symbol, and none of them
// travel with the file.
//
// What has to travel is how wide each letter is. These are the advance widths
// from the fonts' own metrics, in thousandths of the point size — the same
// numbers the reader will use when it draws them, so a line that fits here
// fits there.

window.TeX = window.TeX || {};

(() => {
  const T = window.TeX;

  // ASCII 32..126, ten to a row.
  const WIDTHS = {
    'Times-Roman': [
      250, 333, 408, 500, 500, 833, 778, 333, 333, 333,
      500, 564, 250, 333, 250, 278, 500, 500, 500, 500,
      500, 500, 500, 500, 500, 500, 278, 278, 564, 564,
      564, 444, 921, 722, 667, 667, 722, 611, 556, 722,
      722, 333, 389, 722, 611, 889, 722, 722, 556, 722,
      667, 556, 611, 722, 722, 944, 722, 722, 611, 333,
      278, 333, 469, 500, 333, 444, 500, 444, 500, 444,
      333, 500, 500, 278, 278, 500, 278, 778, 500, 500,
      500, 500, 333, 389, 278, 500, 500, 722, 500, 500,
      444, 480, 200, 480, 541,
    ],
    'Times-Bold': [
      250, 333, 555, 500, 500, 1000, 833, 333, 333, 333,
      500, 570, 250, 333, 250, 278, 500, 500, 500, 500,
      500, 500, 500, 500, 500, 500, 333, 333, 570, 570,
      570, 500, 930, 722, 667, 722, 722, 667, 611, 778,
      778, 389, 500, 778, 667, 944, 722, 778, 611, 778,
      722, 556, 667, 722, 722, 1000, 722, 722, 667, 333,
      278, 333, 581, 500, 333, 500, 556, 444, 556, 444,
      333, 500, 556, 278, 333, 556, 278, 833, 556, 500,
      556, 556, 444, 389, 333, 556, 500, 722, 500, 500,
      444, 394, 220, 394, 520,
    ],
    'Times-Italic': [
      250, 333, 420, 500, 500, 833, 778, 333, 333, 333,
      500, 675, 250, 333, 250, 278, 500, 500, 500, 500,
      500, 500, 500, 500, 500, 500, 333, 333, 675, 675,
      675, 500, 920, 611, 611, 667, 722, 611, 611, 722,
      722, 333, 444, 667, 556, 833, 667, 722, 611, 722,
      611, 500, 556, 722, 611, 833, 611, 556, 556, 389,
      278, 389, 422, 500, 333, 500, 500, 444, 500, 444,
      278, 500, 500, 278, 278, 444, 278, 722, 500, 500,
      500, 500, 389, 389, 278, 500, 444, 667, 444, 444,
      389, 400, 275, 400, 541,
    ],
    'Times-BoldItalic': [
      250, 389, 555, 500, 500, 833, 778, 333, 333, 333,
      500, 570, 250, 333, 250, 278, 500, 500, 500, 500,
      500, 500, 500, 500, 500, 500, 333, 333, 570, 570,
      570, 500, 832, 667, 667, 667, 722, 667, 667, 722,
      778, 389, 500, 667, 611, 889, 722, 722, 611, 722,
      667, 556, 611, 722, 667, 889, 667, 611, 611, 333,
      278, 333, 570, 500, 333, 500, 500, 444, 500, 444,
      333, 500, 556, 278, 278, 500, 278, 778, 556, 500,
      500, 500, 389, 389, 278, 556, 444, 667, 500, 444,
      389, 348, 220, 348, 570,
    ],
    'Helvetica': [
      278, 278, 355, 556, 556, 889, 667, 191, 333, 333,
      389, 584, 278, 333, 278, 278, 556, 556, 556, 556,
      556, 556, 556, 556, 556, 556, 278, 278, 584, 584,
      584, 556, 1015, 667, 667, 722, 722, 667, 611, 778,
      722, 278, 500, 667, 556, 833, 722, 778, 667, 778,
      722, 667, 611, 722, 667, 944, 667, 667, 611, 278,
      278, 278, 469, 556, 333, 556, 556, 500, 556, 556,
      278, 556, 556, 222, 222, 500, 222, 833, 556, 556,
      556, 556, 333, 500, 278, 556, 500, 722, 500, 500,
      500, 334, 260, 334, 584,
    ],
    'Helvetica-Bold': [
      278, 333, 474, 556, 556, 889, 722, 238, 333, 333,
      389, 584, 278, 333, 278, 278, 556, 556, 556, 556,
      556, 556, 556, 556, 556, 556, 333, 333, 584, 584,
      584, 611, 975, 722, 722, 722, 722, 667, 611, 778,
      722, 278, 556, 722, 611, 833, 722, 778, 667, 778,
      722, 667, 611, 722, 667, 944, 667, 667, 611, 333,
      278, 333, 584, 556, 333, 556, 611, 556, 611, 556,
      333, 611, 611, 278, 278, 556, 278, 889, 611, 611,
      611, 611, 389, 556, 333, 611, 556, 778, 556, 556,
      500, 389, 280, 389, 584,
    ],
  };

  // The characters past ASCII that a document actually produces — curly
  // quotes, the two dashes, a bullet, a degree sign — with the code the
  // reader knows them by in WinAnsiEncoding.
  const WINANSI = {
    '‘': 0x91, '’': 0x92, '“': 0x93, '”': 0x94,
    '–': 0x96, '—': 0x97, '•': 0x95, '…': 0x85,
    '†': 0x86, '‡': 0x87, '‰': 0x89, 'Œ': 0x8c,
    'œ': 0x9c, 'Ž': 0x8e, 'ž': 0x9e, 'Š': 0x8a,
    'š': 0x9a, 'Ÿ': 0x9f, '‹': 0x8b, '›': 0x9b,
    '‚': 0x82, '„': 0x84, 'ƒ': 0x83, 'ˆ': 0x88,
    '˜': 0x98, '™': 0x99,
  };

  const EXTRA = {
    'Times-Roman':      { 0x91: 333, 0x92: 333, 0x93: 444, 0x94: 444, 0x95: 350, 0x96: 500, 0x97: 1000, 0x85: 1000 },
    'Times-Bold':       { 0x91: 333, 0x92: 333, 0x93: 500, 0x94: 500, 0x95: 350, 0x96: 500, 0x97: 1000, 0x85: 1000 },
    'Times-Italic':     { 0x91: 333, 0x92: 333, 0x93: 556, 0x94: 556, 0x95: 350, 0x96: 500, 0x97: 889,  0x85: 889 },
    'Times-BoldItalic': { 0x91: 333, 0x92: 333, 0x93: 500, 0x94: 500, 0x95: 350, 0x96: 500, 0x97: 1000, 0x85: 1000 },
    'Helvetica':        { 0x91: 222, 0x92: 222, 0x93: 333, 0x94: 333, 0x95: 350, 0x96: 556, 0x97: 1000, 0x85: 1000 },
    'Helvetica-Bold':   { 0x91: 278, 0x92: 278, 0x93: 500, 0x94: 500, 0x95: 350, 0x96: 556, 0x97: 1000, 0x85: 1000 },
  };

  // A font key is family plus what has been done to it: rm, rmb, rmi, rmbi and
  // the same for sf and tt. `sy` is Symbol, which is where every Greek letter
  // and every operator in the maths comes from.
  const FONTS = {
    rm:   { pdf: 'Times-Roman',           w: 'Times-Roman' },
    rmb:  { pdf: 'Times-Bold',            w: 'Times-Bold' },
    rmi:  { pdf: 'Times-Italic',          w: 'Times-Italic' },
    rmbi: { pdf: 'Times-BoldItalic',      w: 'Times-BoldItalic' },
    sf:   { pdf: 'Helvetica',             w: 'Helvetica' },
    sfb:  { pdf: 'Helvetica-Bold',        w: 'Helvetica-Bold' },
    sfi:  { pdf: 'Helvetica-Oblique',     w: 'Helvetica' },
    sfbi: { pdf: 'Helvetica-BoldOblique', w: 'Helvetica-Bold' },
    tt:   { pdf: 'Courier',               w: null },
    ttb:  { pdf: 'Courier-Bold',          w: null },
    tti:  { pdf: 'Courier-Oblique',       w: null },
    ttbi: { pdf: 'Courier-BoldOblique',   w: null },
    sy:   { pdf: 'Symbol',                w: null, symbol: true },
  };

  // Symbol's own encoding: the code the reader wants, and how wide it is.
  // Written against the Unicode character so the layout can carry readable
  // text and only the writer has to know about byte 0xE5.
  const SYM = {
    'Α': [0x41, 722], 'Β': [0x42, 667], 'Γ': [0x47, 603], 'Δ': [0x44, 612],
    'Ε': [0x45, 611], 'Ζ': [0x5a, 611], 'Η': [0x48, 722], 'Θ': [0x51, 741],
    'Ι': [0x49, 333], 'Κ': [0x4b, 722], 'Λ': [0x4c, 690], 'Μ': [0x4d, 889],
    'Ν': [0x4e, 722], 'Ξ': [0x58, 645], 'Ο': [0x4f, 722], 'Π': [0x50, 768],
    'Ρ': [0x52, 556], 'Σ': [0x53, 592], 'Τ': [0x54, 611], 'Υ': [0x55, 690],
    'Φ': [0x46, 763], 'Χ': [0x43, 722], 'Ψ': [0x59, 795], 'Ω': [0x57, 768],
    'α': [0x61, 631], 'β': [0x62, 549], 'γ': [0x67, 411], 'δ': [0x64, 494],
    'ε': [0x65, 439], 'ζ': [0x7a, 494], 'η': [0x68, 603], 'θ': [0x71, 521],
    'ι': [0x69, 329], 'κ': [0x6b, 549], 'λ': [0x6c, 549], 'μ': [0x6d, 576],
    'ν': [0x6e, 521], 'ξ': [0x78, 493], 'ο': [0x6f, 549], 'π': [0x70, 549],
    'ρ': [0x72, 549], 'ς': [0x56, 439], 'σ': [0x73, 603], 'τ': [0x74, 439],
    'υ': [0x75, 576], 'φ': [0x66, 521], 'χ': [0x63, 549], 'ψ': [0x79, 686],
    'ω': [0x77, 686], 'ϑ': [0x4a, 631], 'ϕ': [0x6a, 603], 'ϖ': [0x76, 713],
    'ϱ': [0x72, 549], 'ℓ': [0x6c, 549],

    '∑': [0xe5, 713], '∏': [0xd5, 823], '∫': [0xf2, 274], '√': [0xd6, 549],
    '∞': [0xa5, 713], '∂': [0xb6, 494], '∇': [0xd1, 713], '∈': [0xce, 713],
    '∉': [0xcf, 713], '∋': [0x27, 439], '±': [0xb1, 549], '×': [0xb4, 549],
    '÷': [0xb8, 549], '≤': [0xa3, 549], '≥': [0xb3, 549], '≠': [0xb9, 549],
    '≈': [0xbb, 549], '≡': [0xba, 549], '∼': [0x7e, 549], '≅': [0x40, 549],
    '∝': [0xb5, 713], '→': [0xae, 987], '←': [0xac, 987], '↔': [0xab, 1042],
    '↑': [0xad, 603], '↓': [0xaf, 603], '⇒': [0xde, 987], '⇐': [0xdc, 987],
    '⇔': [0xdb, 1042], '∀': [0x22, 713], '∃': [0x24, 549], '¬': [0xd8, 713],
    '∧': [0xd9, 603], '∨': [0xda, 603], '∩': [0xc7, 768], '∪': [0xc8, 768],
    '⊂': [0xcc, 713], '⊆': [0xcd, 713], '⊃': [0xc9, 713], '⊇': [0xca, 713],
    '∅': [0xc6, 823], '⊕': [0xc5, 768], '⊗': [0xc4, 768], '⋅': [0xd7, 250],
    '∘': [0xb0, 400], '′': [0xa2, 247], '″': [0xb2, 411], '∠': [0xd0, 768],
    '∴': [0x5c, 863], 'ℵ': [0xc0, 823], 'ℜ': [0xc1, 795], 'ℑ': [0xc2, 686],
    '℘': [0xc3, 987], '·': [0xd7, 250], '⟨': [0xe1, 329], '⟩': [0xf1, 329],
    '−': [0x2d, 549], '∗': [0x2a, 500], '⁄': [0xa4, 167], '∣': [0x7c, 200],
    '∮': [0xf2, 274], '∓': [0xb1, 549], '…': [0xbc, 1000], '⊥': [0x5e, 658],
    '⌈': [0x5b, 333], '⌉': [0x5d, 333], '⌊': [0x5b, 333], '⌋': [0x5d, 333],
  };

  // Where the ink sits inside the em, as a fraction of the point size. Enough
  // for line heights, for the axis the maths hangs off, and for how high a
  // superscript climbs.
  const SHAPE = {
    rm: { asc: 0.683, desc: 0.217, x: 0.448, cap: 0.662 },
    sf: { asc: 0.718, desc: 0.207, x: 0.523, cap: 0.718 },
    tt: { asc: 0.629, desc: 0.157, x: 0.426, cap: 0.562 },
    sy: { asc: 0.700, desc: 0.220, x: 0.450, cap: 0.680 },
  };

  const familyOf = (key) => (key === 'sy' ? 'sy' : key.slice(0, 2));

  function rawWidth(ch, key) {
    const font = FONTS[key] || FONTS.rm;
    if (font.symbol) return (SYM[ch] || [0, 549])[1];
    if (!font.w) return 600; // Courier, every glyph the same width
    const code = ch.charCodeAt(0);
    const table = WIDTHS[font.w];
    if (code >= 32 && code <= 126) return table[code - 32];
    const win = T.metrics.encode(ch);
    if (win === null) return table[0];
    const extra = EXTRA[font.w];
    if (extra && extra[win] !== undefined) return extra[win];
    if (win >= 0xa0) return table['A'.charCodeAt(0) - 32]; // a Latin-1 letter, near enough
    return table[0];
  }

  const cache = new Map();

  T.metrics = {
    FONTS,
    SYM,

    /** The code a reader wants for this character, or null if it has none. */
    encode(ch) {
      const code = ch.charCodeAt(0);
      if (code >= 32 && code <= 126) return code;
      if (code >= 0xa0 && code <= 0xff) return code;
      if (WINANSI[ch] !== undefined) return WINANSI[ch];
      return null;
    },

    /** Symbol's byte for a character, or null if Symbol has no such glyph. */
    symbolCode(ch) {
      return SYM[ch] ? SYM[ch][0] : null;
    },

    /** Width of one character at one point size. */
    charWidth(ch, key, size) {
      const at = key + ch;
      let w = cache.get(at);
      if (w === undefined) {
        w = rawWidth(ch, key) / 1000;
        cache.set(at, w);
      }
      return w * size;
    },

    /** Width of a run of text. No kerning: every word is placed by hand, so
     *  the only thing a missing kern costs is a fraction of a point inside it. */
    width(text, key, size) {
      let sum = 0;
      for (const ch of text) sum += this.charWidth(ch, key, size);
      return sum;
    },

    ascent: (key, size) => SHAPE[familyOf(key)].asc * size,
    descent: (key, size) => SHAPE[familyOf(key)].desc * size,
    xHeight: (key, size) => SHAPE[familyOf(key)].x * size,
    capHeight: (key, size) => SHAPE[familyOf(key)].cap * size,

    /** The maths axis — the height the middle of a fraction bar, a minus sign
     *  and a big delimiter all line up on. */
    axis: (size) => 0.25 * size,

    /** Bold, italic and family are three switches on one key. */
    key(family, bold, italic) {
      if (family === 'sy') return 'sy';
      return family + (bold ? 'b' : '') + (italic ? 'i' : '');
    },
  };
})();
</script>

<script data-marble-id="__ID__">
// -------------------------------------------------------------------- pdf
//
// A PDF is a list of numbered objects, a table saying what byte each one
// starts at, and a pointer to that table. Nothing here is clever: pages hold a
// content stream, the stream holds one instruction per thing drawn, and the
// cross-reference table is counted in bytes as the file is assembled, which is
// why everything is appended through one function.

(() => {
  const T = window.TeX;
  const enc = () => T.metrics;

  // Two decimals is finer than any reader will draw and keeps the stream small.
  const n = (v) => {
    const r = Math.round(v * 100) / 100;
    return Object.is(r, -0) ? '0' : String(r);
  };

  const bytes = (text) => {
    const out = new Uint8Array(text.length);
    for (let i = 0; i < text.length; i += 1) out[i] = text.charCodeAt(i) & 0xff;
    return out;
  };

  /** A string as a PDF reader reads it: parentheses and backslashes escaped,
   *  anything outside printable ASCII written as an octal code. */
  function literal(codes) {
    let out = '';
    for (const code of codes) {
      if (code === 40 || code === 41 || code === 92) out += '\\' + String.fromCharCode(code);
      else if (code < 32 || code > 126) out += '\\' + code.toString(8).padStart(3, '0');
      else out += String.fromCharCode(code);
    }
    return out;
  }

  /** Text in one font, as the codes that font understands. */
  function codesFor(text, font) {
    const m = enc();
    const out = [];
    for (const ch of text) {
      const code = font === 'sy' ? m.symbolCode(ch) : m.encode(ch);
      out.push(code === null || code === undefined ? 63 : code);
    }
    return out;
  }

  function create({ title = '', author = '', subject = '' } = {}) {
    const pages = [];
    const images = new Map();
    const fontsUsed = new Set();
    let outline = [];
    // Read at the end rather than at the start: a document does not know its
    // own title until it has read its preamble.
    const meta = { title, author, subject };

    const doc = {
      meta,
      /** A page is a size and a list of things drawn on it, in the order they
       *  were drawn. Coordinates are PDF's: origin bottom left, y upwards. */
      page(width, height) {
        const page = { width, height, items: [] };
        pages.push(page);
        return page;
      },

      /** An image, ready to be placed. JPEG bytes go in as they are, because
       *  every reader can decode them; anything else arrives as raw samples. */
      image(name, spec) {
        images.set(name, spec);
        return name;
      },

      outlineFrom(entries) {
        outline = entries;
      },

      pageCount: () => pages.length,

      bytes() {
        return assemble({ pages, images, fontsUsed, outline, ...meta });
      },
    };

    return doc;
  }

  function contentFor(page, fontsUsed, imageNames) {
    const out = [];
    let inText = false;
    let font = null;
    let size = null;
    let fill = null;

    const endText = () => {
      if (inText) out.push('ET');
      inText = false;
      font = null;
    };
    const colour = (c) => {
      const want = c || '0 0 0';
      if (want === fill) return;
      out.push(want + ' rg');
      fill = want;
    };

    for (const item of page.items) {
      if (item.k === 't') {
        if (!item.t) continue;
        fontsUsed.add(item.f);
        if (!inText) { out.push('BT'); inText = true; }
        colour(item.c);
        if (item.f !== font || item.s !== size) {
          out.push(`/${item.f} ${n(item.s)} Tf`);
          font = item.f; size = item.s;
        }
        out.push(`1 0 0 1 ${n(item.x)} ${n(item.y)} Tm`);
        out.push(`(${literal(codesFor(item.t, item.f))}) Tj`);
      } else if (item.k === 'r') {
        endText();
        colour(item.c);
        out.push(`${n(item.x)} ${n(item.y)} ${n(item.w)} ${n(item.h)} re f`);
      } else if (item.k === 'i') {
        endText();
        imageNames.add(item.img);
        out.push('q');
        out.push(`${n(item.w)} 0 0 ${n(item.h)} ${n(item.x)} ${n(item.y)} cm`);
        out.push(`/${item.img} Do`);
        out.push('Q');
      }
    }
    endText();
    return out.join('\n') + '\n';
  }

  function assemble({ pages, images, fontsUsed, outline, title, author, subject }) {
    const objects = [];
    // Object 0 is the free head of the chain and is never written.
    const reserve = () => { objects.push(null); return objects.length; };
    const put = (id, head, stream) => { objects[id - 1] = { head, stream }; return id; };

    const catalogId = reserve();
    const pagesId = reserve();
    const infoId = reserve();

    // Every page id is known before any page is written, so a link can point
    // at a page that has not been assembled yet.
    const pageIds = pages.map(() => reserve());
    const contentIds = pages.map(() => reserve());

    const imageNames = new Set();
    const streams = pages.map((page) => contentFor(page, fontsUsed, imageNames));

    // Fonts
    const fontIds = new Map();
    for (const key of fontsUsed) {
      const spec = enc().FONTS[key];
      if (!spec) continue;
      const id = reserve();
      fontIds.set(key, id);
      const encoding = spec.symbol ? '' : ' /Encoding /WinAnsiEncoding';
      put(id, `<< /Type /Font /Subtype /Type1 /BaseFont /${spec.pdf}${encoding} >>`);
    }

    // Images
    const imageIds = new Map();
    for (const [name, spec] of images) {
      if (!imageNames.has(name)) continue;
      const id = reserve();
      imageIds.set(name, id);
      const filter = spec.kind === 'jpeg' ? ' /Filter /DCTDecode' : '';
      const space = spec.grey ? '/DeviceGray' : '/DeviceRGB';
      put(
        id,
        `<< /Type /XObject /Subtype /Image /Width ${spec.width} /Height ${spec.height}` +
          ` /ColorSpace ${space} /BitsPerComponent 8${filter} /Length ${spec.data.length} >>`,
        spec.data,
      );
    }

    const resources = () => {
      const fonts = [...fontIds].map(([key, id]) => `/${key} ${id} 0 R`).join(' ');
      const xo = [...imageIds].map(([name, id]) => `/${name} ${id} 0 R`).join(' ');
      return `<< /Font << ${fonts} >>` + (xo ? ` /XObject << ${xo} >>` : '') + ' /ProcSet [/PDF /Text /ImageC] >>';
    };

    // Outline: one entry per heading, nested by the level it was given.
    let outlineId = 0;
    if (outline.length) {
      outlineId = reserve();
      const ids = outline.map(() => reserve());
      const stack = [];
      const kids = outline.map(() => []);
      const top = [];
      outline.forEach((entry, i) => {
        while (stack.length && outline[stack[stack.length - 1]].level >= entry.level) stack.pop();
        if (stack.length) kids[stack[stack.length - 1]].push(i);
        else top.push(i);
        stack.push(i);
      });
      const write = (i) => {
        const entry = outline[i];
        const mine = kids[i];
        const parent = (() => {
          for (let j = 0; j < outline.length; j += 1) if (kids[j].includes(i)) return ids[j];
          return outlineId;
        })();
        const siblings = top.includes(i) ? top : kids[outline.findIndex((_, j) => kids[j].includes(i))];
        const at = siblings.indexOf(i);
        const near =
          (at > 0 ? ` /Prev ${ids[siblings[at - 1]]} 0 R` : '') +
          (at < siblings.length - 1 ? ` /Next ${ids[siblings[at + 1]]} 0 R` : '');
        const children = mine.length
          ? ` /First ${ids[mine[0]]} 0 R /Last ${ids[mine[mine.length - 1]]} 0 R /Count -${mine.length}`
          : '';
        put(
          ids[i],
          `<< /Title (${literal(codesFor(entry.title, 'rm'))}) /Parent ${parent} 0 R${near}${children}` +
            ` /Dest [${pageIds[entry.page]} 0 R /XYZ ${n(entry.x)} ${n(entry.y)} null] >>`,
        );
        for (const child of mine) write(child);
      };
      for (const i of top) write(i);
      put(
        outlineId,
        `<< /Type /Outlines /First ${ids[top[0]]} 0 R /Last ${ids[top[top.length - 1]]} 0 R /Count ${top.length} >>`,
      );
    }

    pages.forEach((page, i) => {
      const annots = (page.items || [])
        .filter((item) => item.k === 'l')
        .map((item) => {
          const target = item.url
            ? `/A << /S /URI /URI (${literal(codesFor(item.url, 'rm'))}) >>`
            : `/Dest [${pageIds[item.page] || pageIds[0]} 0 R /XYZ ${n(item.tx || 0)} ${n(item.ty || 0)} null]`;
          return (
            `<< /Type /Annot /Subtype /Link /Border [0 0 0]` +
            ` /Rect [${n(item.x)} ${n(item.y)} ${n(item.x + item.w)} ${n(item.y + item.h)}] ${target} >>`
          );
        });
      put(
        pageIds[i],
        `<< /Type /Page /Parent ${pagesId} 0 R /MediaBox [0 0 ${n(page.width)} ${n(page.height)}]` +
          ` /Resources ${resources()} /Contents ${contentIds[i]} 0 R` +
          (annots.length ? ` /Annots [${annots.join(' ')}]` : '') +
          ' >>',
      );
      put(contentIds[i], `<< /Length ${streams[i].length} >>`, streams[i]);
    });

    put(pagesId, `<< /Type /Pages /Count ${pages.length} /Kids [${pageIds.map((id) => `${id} 0 R`).join(' ')}] >>`);
    put(
      catalogId,
      `<< /Type /Catalog /Pages ${pagesId} 0 R` + (outlineId ? ` /Outlines ${outlineId} 0 R` : '') + ' >>',
    );

    const when = new Date();
    const stamp =
      'D:' +
      String(when.getFullYear()) +
      String(when.getMonth() + 1).padStart(2, '0') +
      String(when.getDate()).padStart(2, '0') +
      String(when.getHours()).padStart(2, '0') +
      String(when.getMinutes()).padStart(2, '0') +
      String(when.getSeconds()).padStart(2, '0');
    put(
      infoId,
      `<< /Title (${literal(codesFor(title, 'rm'))}) /Author (${literal(codesFor(author, 'rm'))})` +
        (subject ? ` /Subject (${literal(codesFor(subject, 'rm'))})` : '') +
        ` /Producer (Marble LaTeX) /Creator (Marble LaTeX) /CreationDate (${stamp}) >>`,
    );

    // ---- bytes, and the table of where each object starts

    const chunks = [];
    let at = 0;
    const push = (chunk) => {
      const part = typeof chunk === 'string' ? bytes(chunk) : chunk;
      chunks.push(part);
      at += part.length;
    };

    push('%PDF-1.4\n%\xE2\xE3\xCF\xD3\n');
    const offsets = new Array(objects.length + 1).fill(0);
    objects.forEach((object, i) => {
      const id = i + 1;
      offsets[id] = at;
      push(`${id} 0 obj\n${object.head}\n`);
      if (object.stream !== undefined && object.stream !== null) {
        push('stream\n');
        push(object.stream);
        push('\nendstream\n');
      }
      push('endobj\n');
    });

    const xref = at;
    let table = `xref\n0 ${objects.length + 1}\n0000000000 65535 f \n`;
    for (let id = 1; id <= objects.length; id += 1) {
      table += `${String(offsets[id]).padStart(10, '0')} 00000 n \n`;
    }
    push(table);
    push(
      `trailer\n<< /Size ${objects.length + 1} /Root ${catalogId} 0 R /Info ${infoId} 0 R >>\n` +
        `startxref\n${xref}\n%%EOF\n`,
    );

    const out = new Uint8Array(at);
    let cursor = 0;
    for (const chunk of chunks) { out.set(chunk, cursor); cursor += chunk.length; }
    return out;
  }

  T.pdf = { create };
})();
</script>

<script data-marble-id="__ID__">
// ------------------------------------------------------------------ reading
//
// TeX is read in two moves. First the characters become tokens — a control
// sequence, a brace, a paragraph break — and every token remembers the line it
// came from, because that is what the log needs to point at. Then the tokens
// are read back through a stack of streams, which is what makes a macro
// expansion nothing more than pushing its body on top.

(() => {
  const T = window.TeX;

  const LETTER = /[A-Za-z]/;
  // Environments whose bodies are text, not TeX, and so are taken whole.
  const RAW = ['verbatim', 'lstlisting', 'Verbatim'];

  function tokenize(source, file = 'main.tex', startLine = 1) {
    const out = [];
    let i = 0;
    let line = startLine;
    const at = () => source[i];
    const push = (t, v) => out.push({ t, v, line, file });

    while (i < source.length) {
      const ch = source[i];

      if (ch === '%') {
        while (i < source.length && source[i] !== '\n') i += 1;
        // A comment eats its newline and the whitespace opening the next line.
        if (source[i] === '\n') { i += 1; line += 1; }
        while (source[i] === ' ' || source[i] === '\t') i += 1;
        continue;
      }

      if (ch === '\\') {
        let j = i + 1;
        if (LETTER.test(source[j] || '')) {
          while (LETTER.test(source[j] || '')) j += 1;
          const name = source.slice(i + 1, j);

          if (name === 'verb') {
            const delim = source[j];
            let k = j + 1;
            while (k < source.length && source[k] !== delim) k += 1;
            push('verb', source.slice(j + 1, k));
            i = k + 1;
            continue;
          }

          if (name === 'begin' && source[j] === '{') {
            const close = source.indexOf('}', j);
            const env = close === -1 ? '' : source.slice(j + 1, close);
            if (RAW.includes(env)) {
              const ender = `\\end{${env}}`;
              const stop = source.indexOf(ender, close);
              const body = source.slice(close + 1, stop === -1 ? source.length : stop);
              push('raw', { env, body: body.replace(/^\n/, '').replace(/\n[ \t]*$/, '') });
              line += (source.slice(i, stop === -1 ? source.length : stop + ender.length).match(/\n/g) || []).length;
              i = stop === -1 ? source.length : stop + ender.length;
              continue;
            }
          }

          push('cs', name);
          i = j;
          // A control word swallows the spaces after it, and a newline counts
          // as one of them unless it ends the paragraph.
          let blank = 0;
          while (i < source.length && /[ \t\n]/.test(source[i])) {
            if (source[i] === '\n') { blank += 1; line += 1; }
            i += 1;
          }
          if (blank >= 2) push('par');
          continue;
        }
        // A control symbol: \\, \%, \$, \{ and the rest are one character.
        push('cs', source[j] === undefined ? '\\' : source[j]);
        i = j + 1;
        continue;
      }

      if (ch === '\n') {
        let j = i;
        let breaks = 0;
        while (j < source.length && /[ \t\n]/.test(source[j])) {
          if (source[j] === '\n') breaks += 1;
          j += 1;
        }
        line += (source.slice(i, j).match(/\n/g) || []).length;
        push(breaks >= 2 ? 'par' : 'space');
        i = j;
        continue;
      }

      if (ch === ' ' || ch === '\t') {
        while (i < source.length && (source[i] === ' ' || source[i] === '\t')) i += 1;
        push('space');
        continue;
      }

      if (ch === '$') {
        if (source[i + 1] === '$') { push('$$'); i += 2; }
        else { push('$'); i += 1; }
        continue;
      }

      if (ch === '{' || ch === '}' || ch === '&' || ch === '^' || ch === '_' || ch === '~') {
        push(ch);
        i += 1;
        continue;
      }

      if (ch === '#' && /[1-9]/.test(source[i + 1] || '')) {
        push('#', Number(source[i + 1]));
        i += 2;
        continue;
      }

      push('char', ch);
      i += 1;
    }

    push('eof');
    return out;
  }

  /** A stack of token streams. Reading a macro is pushing its body on top. */
  class Reader {
    constructor(tokens, macros = new Map()) {
      this.levels = [{ toks: tokens, i: 0 }];
      this.macros = macros;
      this.line = 1;
      this.file = 'main.tex';
      this.depth = 0;
    }

    raw() {
      while (this.levels.length) {
        const top = this.levels[this.levels.length - 1];
        if (top.i < top.toks.length) {
          const tok = top.toks[top.i];
          top.i += 1;
          if (tok.t === 'eof' && this.levels.length > 1) { this.levels.pop(); continue; }
          if (tok.line) { this.line = tok.line; this.file = tok.file || this.file; }
          return tok;
        }
        this.levels.pop();
      }
      return { t: 'eof', line: this.line, file: this.file };
    }

    peekRaw() {
      for (let d = this.levels.length - 1; d >= 0; d -= 1) {
        const level = this.levels[d];
        if (level.i < level.toks.length) {
          const tok = level.toks[level.i];
          if (tok.t === 'eof' && d > 0) continue;
          return tok;
        }
      }
      return { t: 'eof' };
    }

    push(toks) {
      if (toks && toks.length) this.levels.push({ toks, i: 0 });
    }

    back(tok) {
      this.levels.push({ toks: [tok], i: 0 });
    }

    /** The next token with user macros already expanded. */
    next() {
      for (let guard = 0; guard < 10000; guard += 1) {
        const tok = this.raw();
        if (tok.t !== 'cs') return tok;
        const macro = this.macros.get(tok.v);
        if (!macro) return tok;
        this.push(this.expand(macro, tok));
      }
      return { t: 'eof', line: this.line, file: this.file };
    }

    peek() {
      const tok = this.next();
      this.back(tok);
      return tok;
    }

    expand(macro, site) {
      const args = [];
      if (macro.optional !== null && macro.optional !== undefined) {
        args.push(this.optional() ?? macro.optional);
      }
      while (args.length < macro.arity) args.push(this.group());
      const body = [];
      for (const tok of macro.body) {
        if (tok.t === '#') {
          const arg = args[tok.v - 1] || [];
          for (const inner of arg) body.push({ ...inner, line: inner.line || site.line });
        } else {
          body.push({ ...tok, line: tok.line || site.line });
        }
      }
      return body;
    }

    /** The next argument: a balanced group, or one token if there is no brace.
     *  Returned raw, because a macro body is stored, not run. */
    group() {
      let tok = this.raw();
      while (tok.t === 'space' || tok.t === 'par') tok = this.raw();
      if (tok.t !== '{') return tok.t === 'eof' ? [] : [tok];
      const out = [];
      let depth = 1;
      for (;;) {
        const inner = this.raw();
        if (inner.t === 'eof') break;
        if (inner.t === '{') depth += 1;
        if (inner.t === '}') { depth -= 1; if (!depth) break; }
        out.push(inner);
      }
      return out;
    }

    /** An optional [argument], or null if the next thing is not one. */
    optional() {
      const saved = this.levels.map((level) => ({ toks: level.toks, i: level.i }));
      let tok = this.raw();
      while (tok.t === 'space') tok = this.raw();
      if (!(tok.t === 'char' && tok.v === '[')) {
        this.levels = saved;
        return null;
      }
      const out = [];
      let depth = 0;
      for (;;) {
        const inner = this.raw();
        if (inner.t === 'eof') break;
        if (inner.t === '{') depth += 1;
        if (inner.t === '}') depth -= 1;
        if (!depth && inner.t === 'char' && inner.v === ']') break;
        out.push(inner);
      }
      return out;
    }

    /** Tokens up to \end{name}, kept whole. */
    until(name) {
      const out = [];
      let depth = 0;
      for (;;) {
        const tok = this.raw();
        if (tok.t === 'eof') break;
        if (tok.t === 'cs' && (tok.v === 'begin' || tok.v === 'end')) {
          const which = this.group();
          const label = T.lex.plain(which);
          if (tok.v === 'begin') {
            if (label === name) depth += 1;
            out.push(tok, { t: '{' }, ...which, { t: '}' });
            continue;
          }
          if (label === name && depth === 0) break;
          if (label === name) depth -= 1;
          out.push(tok, { t: '{' }, ...which, { t: '}' });
          continue;
        }
        out.push(tok);
      }
      return out;
    }
  }

  /** What a group says, read as plain characters. For names: a label, a file,
   *  a citation key — the places where TeX is being used as a string. */
  function plain(tokens) {
    let out = '';
    for (const tok of tokens || []) {
      if (tok.t === 'char') out += tok.v;
      else if (tok.t === 'space') out += ' ';
      else if (tok.t === 'cs') out += '\\' + tok.v;
      else if (tok.t === 'verb') out += tok.v;
      else if (tok.t === '#') out += '#' + tok.v;
      else if (tok.t === '&') out += '&';
      else if (tok.t === '~') out += '~';
      else if (tok.t === '_') out += '_';
      else if (tok.t === '^') out += '^';
    }
    return out;
  }

  T.lex = { tokenize, Reader, plain, RAW };
})();
</script>

<script data-marble-id="__ID__">
// -------------------------------------------------------------------- maths
//
// Mathematics is not text with symbols in it. Every piece is an atom with a
// class — an ordinary letter, an operator, a binary sign, a relation — and
// almost all of the look of a formula comes from the spaces the classes put
// between each other, and from the four sizes a script can be set at.
//
// What comes out is a box: a width, a height above the baseline, a depth below
// it, and the things drawn inside it. A box is placed on a page by adding one
// point to every item in it, which is why a fraction inside a fraction needs no
// special case.

(() => {
  const T = window.TeX;
  const M = () => T.metrics;

  // ---------------------------------------------------------------- symbols

  const GREEK = {
    alpha: 'α', beta: 'β', gamma: 'γ', delta: 'δ', epsilon: 'ε', varepsilon: 'ε',
    zeta: 'ζ', eta: 'η', theta: 'θ', vartheta: 'ϑ', iota: 'ι', kappa: 'κ',
    lambda: 'λ', mu: 'μ', nu: 'ν', xi: 'ξ', pi: 'π', varpi: 'ϖ', rho: 'ρ',
    varrho: 'ϱ', sigma: 'σ', varsigma: 'ς', tau: 'τ', upsilon: 'υ', phi: 'φ',
    varphi: 'ϕ', chi: 'χ', psi: 'ψ', omega: 'ω',
    Gamma: 'Γ', Delta: 'Δ', Theta: 'Θ', Lambda: 'Λ', Xi: 'Ξ', Pi: 'Π',
    Sigma: 'Σ', Upsilon: 'Υ', Phi: 'Φ', Psi: 'Ψ', Omega: 'Ω',
  };

  // Class, and the character Symbol draws it with.
  const SYMBOLS = {
    infty: ['ord', '∞'], partial: ['ord', '∂'], nabla: ['ord', '∇'],
    emptyset: ['ord', '∅'], varnothing: ['ord', '∅'], aleph: ['ord', 'ℵ'],
    Re: ['ord', 'ℜ'], Im: ['ord', 'ℑ'], wp: ['ord', '℘'], ell: ['ord', 'ℓ'],
    forall: ['ord', '∀'], exists: ['ord', '∃'], neg: ['ord', '¬'], lnot: ['ord', '¬'],
    prime: ['ord', '′'], angle: ['ord', '∠'], surd: ['ord', '√'],

    pm: ['bin', '±'], mp: ['bin', '∓'], times: ['bin', '×'], div: ['bin', '÷'],
    cdot: ['bin', '⋅'], ast: ['bin', '∗'], star: ['bin', '∗'], circ: ['bin', '∘'],
    bullet: ['bin', '•', 'rm'], cap: ['bin', '∩'], cup: ['bin', '∪'],
    wedge: ['bin', '∧'], land: ['bin', '∧'], vee: ['bin', '∨'], lor: ['bin', '∨'],
    oplus: ['bin', '⊕'], otimes: ['bin', '⊗'], setminus: ['bin', '\\', 'rm'],

    leq: ['rel', '≤'], le: ['rel', '≤'], geq: ['rel', '≥'], ge: ['rel', '≥'],
    neq: ['rel', '≠'], ne: ['rel', '≠'], approx: ['rel', '≈'], equiv: ['rel', '≡'],
    sim: ['rel', '∼'], simeq: ['rel', '≅'], cong: ['rel', '≅'], propto: ['rel', '∝'],
    in: ['rel', '∈'], notin: ['rel', '∉'], ni: ['rel', '∋'],
    subset: ['rel', '⊂'], subseteq: ['rel', '⊆'], supset: ['rel', '⊃'], supseteq: ['rel', '⊇'],
    to: ['rel', '→'], rightarrow: ['rel', '→'], leftarrow: ['rel', '←'], gets: ['rel', '←'],
    leftrightarrow: ['rel', '↔'], Rightarrow: ['rel', '⇒'], Leftarrow: ['rel', '⇐'],
    Leftrightarrow: ['rel', '⇔'], mapsto: ['rel', '→'], uparrow: ['rel', '↑'], downarrow: ['rel', '↓'],
    gg: ['rel', '>>', 'rm'], ll: ['rel', '<<', 'rm'], perp: ['rel', '⊥'],
    parallel: ['rel', '||', 'rm'], therefore: ['rel', '∴'],

    sum: ['op', '∑'], prod: ['op', '∏'], coprod: ['op', '∏'], int: ['op', '∫'],
    oint: ['op', '∮'], bigcup: ['op', '∪'], bigcap: ['op', '∩'], bigoplus: ['op', '⊕'],
    bigotimes: ['op', '⊗'], bigwedge: ['op', '∧'], bigvee: ['op', '∨'],

    ldots: ['inner', '…'], cdots: ['inner', '…'], dots: ['inner', '…'],
    langle: ['open', '⟨'], rangle: ['close', '⟩'],
  };

  // Set upright, not italic: these are words, not products of variables.
  const NAMED = [
    'sin', 'cos', 'tan', 'cot', 'sec', 'csc', 'arcsin', 'arccos', 'arctan',
    'sinh', 'cosh', 'tanh', 'log', 'ln', 'exp', 'lim', 'limsup', 'liminf',
    'max', 'min', 'sup', 'inf', 'det', 'dim', 'ker', 'deg', 'arg', 'gcd', 'Pr', 'mod',
  ];
  // The ones whose scripts sit under and over them in display.
  const LIMITS = ['sum', 'prod', 'coprod', 'bigcup', 'bigcap', 'bigoplus', 'bigotimes', 'bigwedge', 'bigvee', 'lim', 'limsup', 'liminf', 'max', 'min', 'sup', 'inf', 'det', 'gcd'];

  const OPEN = { '(': '(', '[': '[', '\\{': '{', '|': '|', '.': '', 'langle': '⟨', 'lfloor': '⌊', 'lceil': '⌈' };
  const CLOSE = { ')': ')', ']': ']', '\\}': '}', '|': '|', '.': '', 'rangle': '⟩', 'rfloor': '⌋', 'rceil': '⌉' };

  const MATH_FONTS = {
    mathrm: 'rm', mathbf: 'rmb', mathit: 'rmi', mathsf: 'sf', mathtt: 'tt',
    mathcal: 'rmi', mathbb: 'rmb', mathfrak: 'rmi', boldsymbol: 'rmbi',
  };

  // ------------------------------------------------------------------ boxes

  const empty = () => ({ w: 0, h: 0, d: 0, items: [] });

  const TALL = /[A-Z0-9bdfhklt(){}[\]/|\\∑∏∫∮√⌈⌉⌊⌋]/;
  const DEEP = /[gjpqy(){}[\]|/\\∑∏∫∮]/;

  function glyph(text, font, size) {
    const m = M();
    let h = 0;
    let d = 0;
    for (const ch of text) {
      h = Math.max(h, TALL.test(ch) ? m.capHeight(font, size) * 1.05 : m.xHeight(font, size));
      d = Math.max(d, DEEP.test(ch) ? size * 0.21 : 0);
    }
    if (!text.length) return empty();
    return {
      w: m.width(text, font, size),
      h, d,
      items: [{ k: 't', x: 0, y: 0, f: font, s: size, t: text }],
    };
  }

  function shift(box, dx, dy) {
    return {
      w: box.w,
      h: box.h + dy,
      d: box.d - dy,
      items: box.items.map((item) => ({ ...item, x: item.x + dx, y: item.y + dy })),
    };
  }

  function merge(boxes) {
    const out = empty();
    for (const box of boxes) {
      out.items.push(...box.items);
      out.h = Math.max(out.h, box.h);
      out.d = Math.max(out.d, box.d);
      out.w = Math.max(out.w, box.w);
    }
    return out;
  }

  function row(parts) {
    const out = empty();
    let x = 0;
    for (const part of parts) {
      if (typeof part === 'number') { x += part; continue; }
      for (const item of part.items) out.items.push({ ...item, x: item.x + x });
      out.h = Math.max(out.h, part.h);
      out.d = Math.max(out.d, part.d);
      x += part.w;
    }
    out.w = x;
    return out;
  }

  const rule = (w, h) => ({ w, h, d: 0, items: [{ k: 'r', x: 0, y: 0, w, h }] });

  // ----------------------------------------------------------------- styles

  const DISPLAY = 0, TEXT = 1, SCRIPT = 2, SCRIPTSCRIPT = 3;
  const FACTOR = [1, 1, 0.7, 0.5];
  const sizeAt = (base, style) => base * FACTOR[style];
  const supStyle = (style) => (style >= SCRIPT ? SCRIPTSCRIPT : SCRIPT);
  const fracStyle = (style) => (style === DISPLAY ? TEXT : style >= SCRIPT ? SCRIPTSCRIPT : SCRIPT);

  // Space between two classes, in eighteenths of an em. A starred value is
  // dropped in the script styles, which is why a subscript does not breathe.
  const SPACE = {
    ord:   { ord: 0, op: 3, bin: -4, rel: -5, open: 0, close: 0, punct: 0, inner: -3 },
    op:    { ord: 3, op: 3, bin: 0,  rel: -5, open: 0, close: 0, punct: 0, inner: -3 },
    bin:   { ord: -4, op: -4, bin: 0, rel: 0, open: -4, close: 0, punct: 0, inner: -4 },
    rel:   { ord: -5, op: -5, bin: 0, rel: 0, open: -5, close: 0, punct: 0, inner: -5 },
    open:  { ord: 0, op: 0, bin: 0, rel: 0, open: 0, close: 0, punct: 0, inner: 0 },
    close: { ord: 0, op: 3, bin: -4, rel: -5, open: 0, close: 0, punct: 0, inner: -3 },
    punct: { ord: -3, op: -3, bin: 0, rel: -3, open: -3, close: -3, punct: -3, inner: -3 },
    inner: { ord: -3, op: -3, bin: -4, rel: -5, open: -3, close: 0, punct: -3, inner: -3 },
  };

  function gap(left, right, size, style) {
    const table = SPACE[left] || SPACE.ord;
    const mu = table[right] === undefined ? 0 : table[right];
    if (mu === 0) return 0;
    if (mu < 0 && style >= SCRIPT) return 0;
    return (Math.abs(mu) / 18) * size;
  }

  // ----------------------------------------------------------------- parsing

  /** Tokens in, a list of atoms out. Groups, scripts, fractions and every
   *  other construct become one atom carrying boxes it will build later. */
  function parse(reader, opts) {
    const atoms = [];
    const stop = opts.stop || null;
    let font = opts.font || null;

    const put = (cls, node) => {
      atoms.push({ cls, node, sup: null, sub: null });
      return atoms[atoms.length - 1];
    };
    const last = () => atoms[atoms.length - 1];

    for (;;) {
      const tok = reader.next();
      if (tok.t === 'eof') break;
      if (tok.t === '}' ) { reader.back(tok); break; }
      // A stop token belongs to whoever asked for the stop, so it goes back.
      if (stop && stop(tok, reader)) { reader.back(tok); break; }

      if (tok.t === 'space' || tok.t === 'par') continue;

      if (tok.t === '{') {
        const inner = parse(reader, { ...opts, stop: null });
        const close = reader.next();
        if (close.t !== '}') reader.back(close);
        put('ord', { k: 'list', atoms: inner });
        continue;
      }

      if (tok.t === '^' || tok.t === '_') {
        const which = tok.t === '^' ? 'sup' : 'sub';
        const target = last() && !atoms[atoms.length - 1][which] ? last() : put('ord', { k: 'text', text: '', font: 'rm' });
        target[which] = { k: 'list', atoms: parseArgument(reader, opts) };
        continue;
      }

      if (tok.t === '&' || (tok.t === 'cs' && tok.v === '\\')) { reader.back(tok); break; }

      if (tok.t === 'char') {
        const ch = tok.v;
        if (ch === "'") {
          const target = last() || put('ord', { k: 'text', text: '', font: 'rm' });
          target.sup = { k: 'list', atoms: [{ cls: 'ord', node: { k: 'text', text: '′', font: 'sy' }, sup: null, sub: null }] };
          continue;
        }
        if (/[0-9.]/.test(ch)) { put('ord', { k: 'text', text: ch, font: font || 'rm' }); continue; }
        if (/[A-Za-z]/.test(ch)) { put('ord', { k: 'text', text: ch, font: font || 'rmi' }); continue; }
        if ('+-*'.includes(ch)) { put('bin', { k: 'text', text: ch === '-' ? '−' : ch === '*' ? '∗' : ch, font: ch === '+' ? 'rm' : 'sy' }); continue; }
        if ('=<>'.includes(ch)) { put('rel', { k: 'text', text: ch, font: 'rm' }); continue; }
        if ('([|'.includes(ch)) { put('open', { k: 'text', text: ch, font: 'rm' }); continue; }
        if (')]'.includes(ch)) { put('close', { k: 'text', text: ch, font: 'rm' }); continue; }
        if (',;:'.includes(ch)) { put('punct', { k: 'text', text: ch, font: 'rm' }); continue; }
        if (ch === '/') { put('ord', { k: 'text', text: '/', font: 'rm' }); continue; }
        if (ch === '!' || ch === '?') { put('close', { k: 'text', text: ch, font: 'rm' }); continue; }
        put('ord', { k: 'text', text: ch, font: font || 'rm' });
        continue;
      }

      if (tok.t !== 'cs') continue;
      const name = tok.v;

      if (GREEK[name]) { put('ord', { k: 'text', text: GREEK[name], font: 'sy' }); continue; }
      if (SYMBOLS[name]) {
        const [cls, ch, face] = SYMBOLS[name];
        const atom = put(cls, { k: 'text', text: ch, font: face || 'sy', big: cls === 'op' });
        atom.limits = LIMITS.includes(name);
        continue;
      }
      if (NAMED.includes(name)) {
        const atom = put('op', { k: 'text', text: name, font: 'rm' });
        atom.limits = LIMITS.includes(name);
        continue;
      }
      if (MATH_FONTS[name]) {
        const body = reader.group();
        const sub = new T.lex.Reader(body.concat([{ t: 'eof' }]), reader.macros);
        put('ord', { k: 'list', atoms: parse(sub, { ...opts, font: MATH_FONTS[name] }) });
        continue;
      }

      switch (name) {
        case 'frac': case 'dfrac': case 'tfrac': case 'binom': case 'choose': {
          const num = parseArgument(reader, opts);
          const den = parseArgument(reader, opts);
          put(name === 'binom' ? 'inner' : 'ord', {
            k: 'frac', num, den,
            bar: name !== 'binom',
            around: name === 'binom' ? ['(', ')'] : null,
            forceDisplay: name === 'dfrac',
            forceText: name === 'tfrac',
          });
          continue;
        }
        case 'sqrt': {
          const index = reader.optional();
          const body = parseArgument(reader, opts);
          put('ord', { k: 'sqrt', body, index });
          continue;
        }
        case 'text': case 'textrm': case 'mbox': case 'textnormal': {
          put('ord', { k: 'text', text: T.lex.plain(reader.group()), font: 'rm', upright: true });
          continue;
        }
        case 'textbf': {
          put('ord', { k: 'text', text: T.lex.plain(reader.group()), font: 'rmb', upright: true });
          continue;
        }
        case 'textit': case 'emph': {
          put('ord', { k: 'text', text: T.lex.plain(reader.group()), font: 'rmi', upright: true });
          continue;
        }
        case 'operatorname': {
          const atom = put('op', { k: 'text', text: T.lex.plain(reader.group()), font: 'rm' });
          atom.limits = false;
          continue;
        }
        case 'left': {
          const open = delimiterName(reader);
          const inner = parse(reader, { ...opts, stop: (t) => t.t === 'cs' && t.v === 'right' });
          reader.next(); // the \right the stop left behind
          const close = delimiterName(reader);
          put('inner', { k: 'fenced', open, close, body: inner });
          continue;
        }
        case 'right': { reader.back(tok); return atoms; }
        case 'begin': {
          const env = T.lex.plain(reader.group());
          put(env === 'cases' || env === 'aligned' || env === 'array' ? 'inner' : 'ord', {
            k: 'matrix', env, rows: parseRows(reader, env, opts),
          });
          continue;
        }
        case 'end': { reader.group(); continue; }
        case 'hat': case 'widehat': case 'bar': case 'overline': case 'vec': case 'tilde':
        case 'widetilde': case 'dot': case 'ddot': case 'check': case 'acute': case 'grave': {
          put('ord', { k: 'accent', which: name, body: parseArgument(reader, opts) });
          continue;
        }
        case 'underline': {
          put('ord', { k: 'under', body: parseArgument(reader, opts) });
          continue;
        }
        case 'quad': put('ord', { k: 'space', em: 1 }); continue;
        case 'qquad': put('ord', { k: 'space', em: 2 }); continue;
        case ',': put('ord', { k: 'space', em: 3 / 18 }); continue;
        case ':': case '>': put('ord', { k: 'space', em: 4 / 18 }); continue;
        case ';': put('ord', { k: 'space', em: 5 / 18 }); continue;
        case '!': put('ord', { k: 'space', em: -3 / 18 }); continue;
        case ' ': put('ord', { k: 'space', em: 0.25 }); continue;
        case 'displaystyle': opts.style = DISPLAY; continue;
        case 'textstyle': opts.style = TEXT; continue;
        case 'nolimits': if (last()) last().limits = false; continue;
        case 'limits': if (last()) last().limits = true; continue;
        case 'mathstrut': case 'strut': put('ord', { k: 'strut' }); continue;
        case 'label': case 'nonumber': case 'notag': reader.group(); continue;
        case '{': put('open', { k: 'text', text: '{', font: 'rm' }); continue;
        case '}': put('close', { k: 'text', text: '}', font: 'rm' }); continue;
        case '|': put('ord', { k: 'text', text: '∥', font: 'sy' }); continue;
        case '%': case '$': case '#': case '&': case '_':
          put('ord', { k: 'text', text: name, font: 'rm' }); continue;
        default:
          // Unknown, and worth saying so rather than dropping it silently.
          if (opts.unknown) opts.unknown(name, tok.line, tok.file);
          continue;
      }
    }
    return atoms;
  }

  function parseArgument(reader, opts) {
    const tok = reader.next();
    if (tok.t === '{') {
      const inner = parse(reader, { ...opts, stop: null });
      const close = reader.next();
      if (close.t !== '}') reader.back(close);
      return inner;
    }
    reader.back(tok);
    const one = reader.next();
    if (one.t === 'eof') return [];
    const sub = new T.lex.Reader([one, { t: 'eof' }], reader.macros);
    return parse(sub, { ...opts, stop: null });
  }

  function delimiterName(reader) {
    const tok = reader.next();
    if (tok.t === 'char') return tok.v;
    if (tok.t === 'cs') return tok.v === '\\{' ? '\\{' : tok.v;
    return '.';
  }

  function parseRows(reader, env, opts) {
    if (env === 'array' || env === 'tabular') reader.group();
    const rows = [];
    let cells = [];
    for (;;) {
      const atoms = parse(reader, {
        ...opts,
        stop: (tok) => (tok.t === 'cs' && (tok.v === '\\' || tok.v === 'end')) || tok.t === '&',
      });
      cells.push(atoms);
      const tok = reader.next();
      if (tok.t === 'eof') break;
      if (tok.t === '&') continue;
      if (tok.t === 'cs' && tok.v === '\\') { rows.push(cells); cells = []; continue; }
      if (tok.t === 'cs' && tok.v === 'end') { reader.group(); break; }
      break;
    }
    if (cells.length && (cells.length > 1 || cells[0].length)) rows.push(cells);
    return rows;
  }

  // ------------------------------------------------------------------ layout

  function build(atoms, base, style, opts = {}) {
    const size = sizeAt(base, style);
    const parts = [];
    let previous = null;

    atoms.forEach((atom, index) => {
      let cls = atom.cls;
      // A binary sign with nothing to bind on the left is not binary.
      if (cls === 'bin' && (previous === null || ['bin', 'op', 'rel', 'open', 'punct'].includes(previous))) cls = 'ord';
      const next = atoms[index + 1];
      if (cls === 'bin' && !next) cls = 'ord';

      if (previous !== null) {
        const space = gap(previous, cls, size, style);
        if (space) parts.push(space);
      }
      parts.push(atomBox(atom, base, style, cls, opts));
      previous = cls;
    });

    return row(parts);
  }

  function atomBox(atom, base, style, cls, opts) {
    const size = sizeAt(base, style);
    let core = nodeBox(atom.node, base, style, opts);

    const isBigOp = atom.node.k === 'text' && (atom.node.big || cls === 'op');
    const limitsHere = atom.limits && style === DISPLAY;

    if (limitsHere && (atom.sup || atom.sub)) {
      const above = atom.sup ? build(atom.sup.atoms, base, supStyle(style), opts) : null;
      const below = atom.sub ? build(atom.sub.atoms, base, supStyle(style), opts) : null;
      const w = Math.max(core.w, above ? above.w : 0, below ? below.w : 0);
      const centre = (box) => (w - box.w) / 2;
      const out = empty();
      out.w = w;
      const clearance = size * 0.18;
      const middle = shift(core, centre(core), 0);
      out.items.push(...middle.items);
      out.h = core.h; out.d = core.d;
      if (above) {
        const lift = core.h + clearance + above.d;
        const placed = shift(above, centre(above), lift);
        out.items.push(...placed.items);
        out.h = Math.max(out.h, lift + above.h);
      }
      if (below) {
        const drop = -(core.d + clearance + below.h);
        const placed = shift(below, centre(below), drop);
        out.items.push(...placed.items);
        out.d = Math.max(out.d, -drop + below.d);
      }
      return out;
    }

    if (!atom.sup && !atom.sub) return core;

    const m = M();
    const scriptSize = sizeAt(base, supStyle(style));
    const sup = atom.sup ? build(atom.sup.atoms, base, supStyle(style), opts) : null;
    const sub = atom.sub ? build(atom.sub.atoms, base, supStyle(style), opts) : null;
    const out = empty();
    out.items.push(...core.items);
    out.h = core.h;
    out.d = core.d;
    const x = core.w + (isBigOp ? size * 0.04 : 0);
    let width = core.w;

    if (sup) {
      const lift = Math.max(core.h - scriptSize * 0.25, m.xHeight('rm', size) * 0.9, sup.d + scriptSize * 0.2);
      const placed = shift(sup, x, lift);
      out.items.push(...placed.items);
      out.h = Math.max(out.h, lift + sup.h);
      width = Math.max(width, x + sup.w);
    }
    if (sub) {
      const drop = -Math.max(core.d + scriptSize * 0.15, size * 0.22, sub.h - scriptSize * 0.6);
      const placed = shift(sub, x, drop);
      out.items.push(...placed.items);
      out.d = Math.max(out.d, -drop + sub.d);
      width = Math.max(width, x + sub.w);
    }
    out.w = width + size * 0.04;
    return out;
  }

  function nodeBox(node, base, style, opts) {
    const size = sizeAt(base, style);
    const m = M();

    switch (node.k) {
      case 'text': {
        if (node.big && style === DISPLAY) {
          const big = glyph(node.text, node.font, size * 1.45);
          return shift(big, 0, -(big.h - big.d) / 2 + m.axis(size));
        }
        return glyph(node.text, node.font, size);
      }
      case 'list':
        return build(node.atoms, base, style, opts);
      case 'space':
        return { w: node.em * size, h: 0, d: 0, items: [] };
      case 'strut':
        return { w: 0, h: size * 0.7, d: size * 0.2, items: [] };
      case 'frac': {
        const inner = node.forceDisplay ? TEXT : node.forceText ? SCRIPT : fracStyle(style);
        const num = build(node.num, base, node.forceDisplay ? TEXT : inner, opts);
        const den = build(node.den, base, node.forceDisplay ? TEXT : inner, opts);
        const thick = size * 0.045;
        const axis = m.axis(size);
        const w = Math.max(num.w, den.w) + size * 0.24;
        // Both are baselines, measured from the fraction's own: the numerator
        // sits a clear gap above the rule and the denominator the same below,
        // so `drop` is negative and stays that way.
        const lift = axis + thick / 2 + size * 0.14 + num.d;
        const drop = axis - thick / 2 - size * 0.18 - den.h;
        const out = empty();
        out.w = w;
        const top = shift(num, (w - num.w) / 2, lift);
        const bottom = shift(den, (w - den.w) / 2, drop);
        out.items.push(...top.items, ...bottom.items);
        out.h = lift + num.h;
        out.d = -drop + den.d;
        if (node.bar) {
          const bar = shift(rule(w - size * 0.06, thick), size * 0.03, axis - thick / 2);
          out.items.push(...bar.items);
        }
        if (node.around) {
          const left = stretchDelimiter(node.around[0], out.h, out.d, base, size, m);
          const right = stretchDelimiter(node.around[1], out.h, out.d, base, size, m);
          return row([left, out, right]);
        }
        return out;
      }
      case 'sqrt': {
        const body = build(node.body, base, style, opts);
        const thick = size * 0.045;
        const clearance = size * 0.14;
        // Base-14 has no built-up radical, so Symbol's is set at whatever size
        // reaches over what is under it. Its ink runs from about -0.05 to 0.80
        // of the size it is set at, which is what the placement below is for.
        const TOP = 0.8;
        const BOTTOM = -0.05;
        const barTop = body.h + clearance;
        const scale = Math.max(size, (barTop + body.d) / (TOP - BOTTOM));
        const sign = glyph('√', 'sy', scale);
        const placed = shift(sign, 0, barTop - TOP * scale);
        const out = empty();
        out.items.push(...placed.items);
        const inner = shift(body, sign.w + size * 0.06, 0);
        out.items.push(...inner.items);
        const bar = shift(rule(body.w + size * 0.14, thick), sign.w, barTop);
        out.items.push(...bar.items);
        out.w = sign.w + body.w + size * 0.14;
        out.h = barTop + thick;
        out.d = Math.max(body.d, TOP * scale - barTop + BOTTOM * scale);
        if (node.index && node.index.length) {
          const sub = new T.lex.Reader(node.index.concat([{ t: 'eof' }]), opts.macros || new Map());
          const idx = build(parse(sub, { style, unknown: opts.unknown }), base, SCRIPTSCRIPT, opts);
          const push = idx.w * 0.8;
          const set = shift(idx, 0, out.h * 0.42);
          const wrapped = empty();
          wrapped.items.push(...set.items, ...out.items.map((item) => ({ ...item, x: item.x + push })));
          wrapped.w = out.w + push;
          wrapped.h = Math.max(out.h, set.h);
          wrapped.d = out.d;
          return wrapped;
        }
        return out;
      }
      case 'fenced': {
        const body = build(node.body, base, style, opts);
        const axis = m.axis(size);
        const reach = Math.max(body.h - axis, body.d + axis) * 2 + size * 0.1;
        const left = stretchDelimiter(OPEN[node.open] ?? node.open, reach / 2 + axis, reach / 2 - axis, base, size, m);
        const right = stretchDelimiter(CLOSE[node.close] ?? node.close, reach / 2 + axis, reach / 2 - axis, base, size, m);
        return row([left, body, right]);
      }
      case 'accent': {
        const body = build(node.body, base, style, opts);
        const marks = {
          hat: '^', widehat: '^', bar: '−', overline: '−', vec: '→', tilde: '~',
          widetilde: '~', dot: '·', ddot: '··', check: 'v', acute: '´', grave: '`',
        };
        const flat = ['bar', 'overline'].includes(node.which);
        // The arrow is a full-width glyph and the others are not, so it is set
        // smaller rather than left to reach past the letter it is over.
        const markSize = size * (flat ? 1 : node.which === 'vec' ? 0.55 : 0.9);
        const mark = flat
          ? rule(Math.max(body.w, size * 0.4), size * 0.04)
          : glyph(marks[node.which] || '^', node.which === 'vec' ? 'sy' : 'rm', markSize);
        const lift = body.h + size * (flat ? 0.14 : 0.02);
        const placed = shift(mark, (body.w - mark.w) / 2, lift);
        const out = empty();
        out.items.push(...body.items, ...placed.items);
        out.w = body.w;
        out.h = lift + mark.h;
        out.d = body.d;
        return out;
      }
      case 'under': {
        const body = build(node.body, base, style, opts);
        const bar = shift(rule(body.w, size * 0.04), 0, -(body.d + size * 0.16));
        const out = empty();
        out.items.push(...body.items, ...bar.items);
        out.w = body.w;
        out.h = body.h;
        out.d = body.d + size * 0.22;
        return out;
      }
      case 'matrix':
        return matrixBox(node, base, style, opts);
      default:
        return empty();
    }
  }

  const FENCES = {
    pmatrix: ['(', ')'], bmatrix: ['[', ']'], Bmatrix: ['{', '}'],
    vmatrix: ['|', '|'], Vmatrix: ['∥', '∥'], cases: ['{', ''],
  };

  function matrixBox(node, base, style, opts) {
    const size = sizeAt(base, style);
    const m = M();
    const inner = node.env === 'cases' || node.env === 'aligned' ? style : style === DISPLAY ? TEXT : style;
    const cells = node.rows.map((cells0) => cells0.map((atoms) => build(atoms, base, inner, opts)));
    const columns = Math.max(0, ...cells.map((r) => r.length));
    const widths = [];
    for (let c = 0; c < columns; c += 1) {
      widths.push(Math.max(0, ...cells.map((r) => (r[c] ? r[c].w : 0))));
    }
    const colGap = size * (node.env === 'cases' ? 0.9 : 0.55);
    const rowGap = size * 0.35;
    const out = empty();
    let y = 0;
    const heights = cells.map((r) => Math.max(size * 0.6, ...r.map((b) => b.h)));
    const depths = cells.map((r) => Math.max(size * 0.2, ...r.map((b) => b.d)));
    let total = 0;
    cells.forEach((_, i) => { total += heights[i] + depths[i] + (i ? rowGap : 0); });
    y = total / 2 + m.axis(size);

    cells.forEach((r, i) => {
      y -= heights[i];
      let x = 0;
      r.forEach((box, c) => {
        const left = node.env === 'cases' || node.env === 'aligned' ? 0 : (widths[c] - box.w) / 2;
        const placed = shift(box, x + left, y);
        out.items.push(...placed.items);
        x += widths[c] + colGap;
      });
      y -= depths[i] + rowGap;
    });

    out.w = widths.reduce((a, b) => a + b, 0) + colGap * Math.max(0, columns - 1);
    out.h = total / 2 + m.axis(size);
    out.d = total / 2 - m.axis(size);

    const fence = FENCES[node.env];
    if (!fence) return out;
    const left = stretchDelimiter(fence[0], out.h, out.d, base, size, m);
    const right = stretchDelimiter(fence[1], out.h, out.d, base, size, m);
    return row([left, size * 0.12, out, size * 0.12, right]);
  }

  /** A delimiter tall enough for what it is around. Base-14 has no built-up
   *  brackets, so the glyph is set at the size that makes it reach — which is
   *  what a reader without a maths font would do anyway. */
  function stretchDelimiter(ch, above, below, base, size, m) {
    if (!ch) return empty();
    const font = '⟨⟩∥⌈⌉⌊⌋'.includes(ch) ? 'sy' : 'rm';
    const want = Math.max(above, below) * 2;
    const natural = size * 0.72;
    const scale = Math.max(size, Math.min(size * 4, (want / natural) * size));
    const box = glyph(ch, font, scale);
    const axis = m.axis(size);
    const middle = (box.h - box.d) / 2;
    return shift(box, 0, axis - middle);
  }

  /** The whole of it: tokens in, one box out. */
  function typeset(tokens, macros, { display = false, base = 10, unknown = null } = {}) {
    const reader = new T.lex.Reader(tokens.concat([{ t: 'eof' }]), macros);
    const opts = { style: display ? DISPLAY : TEXT, unknown, macros };
    const atoms = parse(reader, opts);
    return build(atoms, base, opts.style, { unknown, macros });
  }

  T.math = { typeset, parse, build, glyph, row, shift, merge, rule, empty, DISPLAY, TEXT };
})();
</script>

<script data-marble-id="__ID__">
// --------------------------------------------------------------- typesetting
//
// The part that turns tokens into pages. Everything on a page arrives as a
// row: a height above the baseline, a depth below it, and items already
// positioned relative to that baseline. A line of text is a row, a displayed
// equation is a row, a table is a row. Pagination therefore has one rule —
// place the row if it fits, start a page if it does not — and footnotes are
// the only thing that complicates it, because they take their space from the
// bottom of a page that is still being filled.

(() => {
  const T = window.TeX;
  const M = () => T.metrics;

  const PAPER = {
    letterpaper: [612, 792],
    a4paper: [595.28, 841.89],
    a5paper: [419.53, 595.28],
    legalpaper: [612, 1008],
    executivepaper: [540, 720],
  };

  const SIZES = {
    tiny: 0.5, scriptsize: 0.7, footnotesize: 0.8, small: 0.9, normalsize: 1,
    large: 1.2, Large: 1.44, LARGE: 1.728, huge: 2.074, Huge: 2.488,
  };

  // What a text-mode control sequence stands for, when it stands for one
  // character. The accents are separate because they take an argument.
  const GLYPHS = {
    '%': '%', '$': '$', '&': '&', '#': '#', '_': '_', '{': '{', '}': '}',
    textbackslash: '\\', textasciitilde: '~', textasciicircum: '^',
    ldots: '…', dots: '…', textellipsis: '…',
    textendash: '–', textemdash: '—', textbullet: '•',
    S: '§', P: '¶', copyright: '©', pounds: '£', dag: '†', ddag: '‡',
    textdegree: '°', textquotedblleft: '“', textquotedblright: '”',
    textquoteleft: '‘', textquoteright: '’', textregistered: '®',
    texttrademark: '™', ae: 'æ', AE: 'Æ', oe: 'œ', OE: 'Œ', ss: 'ß',
    o: 'ø', O: 'Ø', aa: 'å', AA: 'Å', l: 'l', L: 'L', i: 'ı', j: 'j',
    textbar: '|', textless: '<', textgreater: '>', textbraceleft: '{',
    textbraceright: '}', slash: '/', textperiodcentered: '·',
  };

  const ACCENTS = {
    "'": { a: 'á', e: 'é', i: 'í', o: 'ó', u: 'ú', y: 'ý', c: 'ć', n: 'ń', s: 'ś', A: 'Á', E: 'É', I: 'Í', O: 'Ó', U: 'Ú' },
    '`': { a: 'à', e: 'è', i: 'ì', o: 'ò', u: 'ù', A: 'À', E: 'È', I: 'Ì', O: 'Ò', U: 'Ù' },
    '"': { a: 'ä', e: 'ë', i: 'ï', o: 'ö', u: 'ü', y: 'ÿ', A: 'Ä', E: 'Ë', I: 'Ï', O: 'Ö', U: 'Ü' },
    '^': { a: 'â', e: 'ê', i: 'î', o: 'ô', u: 'û', A: 'Â', E: 'Ê', I: 'Î', O: 'Ô', U: 'Û' },
    '~': { a: 'ã', n: 'ñ', o: 'õ', A: 'Ã', N: 'Ñ', O: 'Õ' },
    c: { c: 'ç', C: 'Ç' },
    v: { s: 'š', z: 'ž', c: 'č', S: 'Š', Z: 'Ž' },
    '=': {}, '.': {}, u: {}, H: {},
  };

  const ITEM_MARKS = ['•', '–', '·', '*'];
  const ROMAN = [[1000,'m'],[900,'cm'],[500,'d'],[400,'cd'],[100,'c'],[90,'xc'],[50,'l'],[40,'xl'],[10,'x'],[9,'ix'],[5,'v'],[4,'iv'],[1,'i']];

  const roman = (value) => {
    let out = '';
    let left = value;
    for (const [v, s] of ROMAN) while (left >= v) { out += s; left -= v; }
    return out;
  };
  const alpha = (value) => String.fromCharCode(96 + ((value - 1) % 26) + 1);

  /** A length, in points. Understands the units a document actually uses, and
   *  the two that are really fractions of the measure. */
  function length(text, job, fallback = 0) {
    if (!text) return fallback;
    const clean = String(text).trim();
    const relative = /^([-\d.]*)\s*\\(textwidth|linewidth|columnwidth|hsize)/.exec(clean);
    if (relative) return (relative[1] === '' ? 1 : Number(relative[1])) * job.measure;
    const match = /^([-\d.]+)\s*(pt|bp|in|cm|mm|em|ex|pc|sp)?/.exec(clean);
    if (!match) return fallback;
    const value = Number(match[1]);
    const unit = match[2] || 'pt';
    const size = job.font.size;
    const per = {
      pt: 1, bp: 1, in: 72, cm: 28.3465, mm: 2.83465, pc: 12, sp: 1 / 65536,
      em: size, ex: M().xHeight('rm', size),
    };
    return value * (per[unit] === undefined ? 1 : per[unit]);
  }

  // ------------------------------------------------------------------- a job

  function createJob(options) {
    const job = {
      paper: options.paper || 'letterpaper',
      base: options.base || 10,
      margin: options.margin || 72,
      title: '', author: '', date: null,
      log: options.log,
      refs: options.refs || {},
      images: options.images || {},
      files: options.files || [],
      macros: new Map(),
      labels: {},
      toc: [],
      outline: [],
      cites: [],
      counters: { section: 0, subsection: 0, subsubsection: 0, figure: 0, table: 0, equation: 0, footnote: 0, page: 1 },
      font: { family: 'rm', bold: false, italic: false, size: options.base || 10, sc: false },
      align: 'justify',
      leftSkip: 0,
      rightSkip: 0,
      parindent: true,
      inTitlePage: false,
      nodes: [],
      word: null,
      list: [],
      notes: [],
      pendingNotes: [],
      started: false,
    };

    const [width, height] = PAPER[job.paper] || PAPER.letterpaper;
    job.W = width;
    job.H = height;
    job.measure = width - job.margin * 2;
    job.doc = T.pdf.create({ title: '', author: '' });
    job.page = null;
    job.pageIndex = -1;
    job.y = 0;
    job.prevDepth = 0;
    job.firstOnPage = true;
    job.noteHeight = 0;
    job.pageNotes = [];
    return job;
  }

  const leading = (job) => job.font.size * 1.2;
  const fontKey = (job) => M().key(job.font.family, job.font.bold, job.font.italic);

  function say(job, level, message, line, file) {
    job.log.push({ level, message, line: line || null, file: file || null });
  }

  // ------------------------------------------------------------- pages, rows

  function startPage(job) {
    finishPage(job);
    job.page = job.doc.page(job.W, job.H);
    job.pageIndex += 1;
    job.y = job.H - job.margin;
    job.firstOnPage = true;
    job.prevDepth = 0;
    job.noteHeight = 0;
    job.pageNotes = [];
    return job.page;
  }

  function finishPage(job) {
    if (!job.page) return;
    // The folio, centred under the text block, the way an article sets it.
    const number = String(job.counters.page);
    const size = job.base * 0.9;
    const width = M().width(number, 'rm', size);
    job.page.items.push({
      k: 't', x: (job.W - width) / 2, y: job.margin * 0.55, f: 'rm', s: size, t: number,
    });
    job.counters.page += 1;

    if (job.pageNotes.length) {
      // The notes fill the strip the page reserved for them, from the top
      // down. The rule goes at the top of that strip and not a point higher,
      // or it lands on the last line the page was still allowed to set.
      const top = job.margin + job.noteHeight;
      let y = top - job.base * 1.1;
      job.page.items.push({ k: 'r', x: job.margin, y: top - job.base * 0.5, w: job.measure * 0.4, h: 0.4 });
      for (const note of job.pageNotes) {
        for (const row of note) {
          y -= row.above;
          for (const item of row.items) {
            job.page.items.push({ ...item, x: item.x + job.margin + (row.x || 0), y: item.y + y });
          }
          y -= row.below;
        }
      }
    }
  }

  const noteHeightOf = (rows) => rows.reduce((sum, row) => sum + row.above + row.below, 0);

  function fits(job, need) {
    return job.y - need >= job.margin + job.noteHeight;
  }

  /** Put one row on the page, starting a new one if it will not go. Rows made
   *  for a footnote or a table cell are captured instead: the same paragraph
   *  machinery, without the page it usually ends on. */
  function emitRow(job, row) {
    if (job.capture) { job.capture.push(row); return undefined; }
    if (!job.page) startPage(job);
    const extra = row.notes ? noteHeightOf(row.notes.flat()) + job.base * 1.2 * (job.pageNotes.length ? 0 : 1) : 0;
    const drop = job.firstOnPage
      ? row.above
      : Math.max(leading(job), job.prevDepth + row.above + job.base * 0.1) + (row.lead || 0);

    if (!fits(job, drop + row.below + extra)) {
      startPage(job);
      return emitRow(job, row);
    }

    job.y -= drop;
    for (const item of row.items) {
      job.page.items.push({ ...item, x: item.x + job.margin + (row.x || 0), y: item.y + job.y });
    }
    job.prevDepth = row.below;
    job.firstOnPage = false;

    if (row.notes) {
      for (const note of row.notes) {
        job.pageNotes.push(note);
        job.noteHeight += noteHeightOf(note) + (job.pageNotes.length === 1 ? job.base * 1.2 : 0);
      }
    }
    if (row.mark) row.mark(job.pageIndex, job.y);
    return undefined;
  }

  /** Space asked for by name rather than by what is in it. The depth of the
   *  last row is settled here rather than being carried into the next one,
   *  because after an explicit skip there is no "next row" to settle it. */
  function vspace(job, height) {
    if (job.capture) return;
    if (!job.page) startPage(job);
    if (job.firstOnPage) return;
    job.y -= job.prevDepth + height;
    job.prevDepth = 0;
  }

  // ------------------------------------------------------- words and glue

  function spaceWidth(job) {
    return M().charWidth(' ', fontKey(job), job.font.size);
  }

  function ensureWord(job) {
    if (!job.word) job.word = { k: 'word', runs: [], w: 0, h: 0, d: 0 };
    return job.word;
  }

  function addRun(job, text, key, size, options = {}) {
    if (!text) return;
    const word = ensureWord(job);
    const last = word.runs[word.runs.length - 1];
    const rise = options.rise || 0;
    if (last && last.f === key && last.s === size && (last.rise || 0) === rise && !options.link && !last.link) {
      last.t += text;
    } else {
      word.runs.push({ f: key, s: size, t: text, rise, link: options.link || null });
    }
    const m = M();
    word.w += m.width(text, key, size);
    word.h = Math.max(word.h, m.ascent(key, size) * 0.95 + rise);
    word.d = Math.max(word.d, m.descent(key, size) - rise);
  }

  function addText(job, text) {
    if (job.font.sc) {
      // Small capitals, as close as base-14 gets: capitals at full size,
      // lower case as capitals at four fifths.
      for (const ch of text) {
        const upper = ch.toUpperCase();
        const small = upper !== ch && /[a-z]/.test(ch);
        addRun(job, upper, fontKey(job), job.font.size * (small ? 0.8 : 1));
      }
      return;
    }
    addRun(job, text, fontKey(job), job.font.size);
  }

  function addBox(job, box, options = {}) {
    endWord(job);
    job.nodes.push({ k: 'box', w: box.w, h: box.h, d: box.d, items: box.items, ...options });
  }

  function endWord(job) {
    if (job.word && job.word.runs.length) job.nodes.push(job.word);
    job.word = null;
  }

  function addGlue(job, options = {}) {
    endWord(job);
    const last = job.nodes[job.nodes.length - 1];
    if (!last || last.k === 'glue') return;
    const w = options.w === undefined ? spaceWidth(job) : options.w;
    job.nodes.push({
      k: 'glue', w,
      stretch: options.stretch === undefined ? w * 0.6 : options.stretch,
      shrink: options.shrink === undefined ? w * 0.32 : options.shrink,
      nobreak: options.nobreak || false,
      fill: options.fill || false,
    });
  }

  // ------------------------------------------------------------ line breaking

  /** First fit, which is what a person reading the result would call "the way
   *  lines break". Knuth's optimum is better and needs the whole paragraph;
   *  this needs one line at a time and is wrong about a handful of them. */
  function breakLines(nodes, measure, job) {
    const lines = [];
    let line = [];
    let width = 0;
    let lastGlue = -1;

    const flush = (upto, next) => {
      let take = line.slice(0, upto);
      while (take.length && take[take.length - 1].k === 'glue') take.pop();
      lines.push(take);
      line = line.slice(next);
      width = line.reduce((sum, node) => sum + node.w, 0);
      lastGlue = -1;
      for (let i = line.length - 1; i >= 0; i -= 1) if (line[i].k === 'glue' && !line[i].nobreak) { lastGlue = i; break; }
    };

    for (const node of nodes) {
      if (node.k === 'break') {
        line.push(node);
        flush(line.length, line.length);
        lines[lines.length - 1].forced = true;
        continue;
      }
      if (node.k === 'glue' && !line.length) continue;
      line.push(node);
      width += node.w;
      if (node.k === 'glue' && !node.nobreak) lastGlue = line.length - 1;

      if (width > measure + 0.01) {
        if (lastGlue > 0) {
          flush(lastGlue, lastGlue + 1);
        } else if (line.length > 1) {
          // No break point: the word is longer than the measure and has to
          // stick out. TeX calls this overfull and so does the log.
          const overflow = width - node.w - measure;
          if (overflow > 0.1 && job) {
            say(job, 'warning', `Overfull line by ${Math.round(overflow)}pt`, job.line, job.file);
          }
          flush(line.length - 1, line.length - 1);
        }
      }
    }
    while (line.length && line[line.length - 1].k === 'glue') line.pop();
    if (line.length) lines.push(line);
    return lines;
  }

  /** A broken line becomes a row: items placed at their final x, and the
   *  spaces stretched if the line is being justified. */
  function lineRow(job, line, measure, { justify, align, indent = 0 }) {
    const natural = line.reduce((sum, node) => sum + node.w, 0);
    const glues = line.filter((node) => node.k === 'glue' && !node.fill);
    const fills = line.filter((node) => node.k === 'glue' && node.fill);
    const slack = measure - indent - natural;

    let stretchPer = 0;
    let fillPer = 0;
    if (fills.length) {
      fillPer = slack / fills.length;
    } else if (justify && slack > 0 && glues.length) {
      const total = glues.reduce((sum, glue) => sum + glue.stretch, 0);
      stretchPer = total > 0 ? slack / total : 0;
    } else if (justify && slack < 0 && glues.length) {
      const total = glues.reduce((sum, glue) => sum + glue.shrink, 0);
      stretchPer = total > 0 ? Math.max(-1, slack / total) : 0;
    }

    let x = indent;
    if (!justify && !fills.length) {
      if (align === 'center') x += slack / 2;
      else if (align === 'right') x += slack;
    }

    const items = [];
    let above = 0;
    let below = 0;
    const notes = [];

    for (const node of line) {
      if (node.k === 'glue') {
        x += node.w + (node.fill ? fillPer : (stretchPer ? (slack > 0 ? node.stretch : node.shrink) * stretchPer : 0));
        continue;
      }
      if (node.k === 'break') continue;
      if (node.k === 'word') {
        let at = x;
        for (const run of node.runs) {
          items.push({ k: 't', x: at, y: run.rise || 0, f: run.f, s: run.s, t: run.t });
          const w = M().width(run.t, run.f, run.s);
          if (run.link) {
            items.push({ k: 'l', x: at, y: -run.s * 0.22, w, h: run.s * 1.02, url: run.link.url, page: run.link.page, tx: run.link.tx, ty: run.link.ty });
          }
          at += w;
        }
        above = Math.max(above, node.h);
        below = Math.max(below, node.d);
        if (node.notes) notes.push(...node.notes);
        x += node.w;
        continue;
      }
      if (node.k === 'box') {
        for (const item of node.items) items.push({ ...item, x: item.x + x, y: item.y });
        above = Math.max(above, node.h);
        below = Math.max(below, node.d);
        if (node.notes) notes.push(...node.notes);
        x += node.w;
      }
    }

    return {
      items,
      above: above || job.font.size * 0.75,
      below,
      x: job.leftSkip,
      notes: notes.length ? notes : null,
    };
  }

  /** End the paragraph being built and put its lines on the page. */
  function endParagraph(job, options = {}) {
    endWord(job);
    const nodes = job.nodes;
    job.nodes = [];
    if (!nodes.length) return;

    const measure = job.measure - job.leftSkip - job.rightSkip;
    const indent = options.indent === undefined
      ? (job.parindent && job.align === 'justify' ? job.font.size * 1.5 : 0)
      : options.indent;
    const hanging = options.hanging || 0;

    const lines = breakLines(nodes, measure - indent, job);
    lines.forEach((line, i) => {
      const first = i === 0;
      const last = i === lines.length - 1 || line.forced;
      const row = lineRow(job, line, measure, {
        justify: job.align === 'justify' && !last,
        align: job.align === 'justify' ? 'left' : job.align,
        indent: first ? indent : hanging,
      });
      row.x = job.leftSkip;
      if (options.keep && i === lines.length - 1) row.keep = true;
      if (options.mark && first) row.mark = options.mark;
      emitRow(job, row);
    });
    job.parindent = true;
  }

  // ------------------------------------------------------------- the reading

  const SECTIONS = {
    part:          { level: -1, scale: 2.074, bold: true, above: 2.4, below: 1.2, number: false },
    section:       { level: 1, scale: 1.44, bold: true, above: 1.7, below: 0.7, number: true },
    subsection:    { level: 2, scale: 1.2, bold: true, above: 1.4, below: 0.6, number: true },
    subsubsection: { level: 3, scale: 1.0, bold: true, above: 1.2, below: 0.5, number: true },
    paragraph:     { level: 4, scale: 1.0, bold: true, above: 0.9, below: 0, number: false, runIn: true },
    subparagraph:  { level: 5, scale: 1.0, bold: true, above: 0.8, below: 0, number: false, runIn: true },
  };

  function save(job) {
    return {
      font: { ...job.font }, align: job.align, leftSkip: job.leftSkip,
      rightSkip: job.rightSkip, parindent: job.parindent,
    };
  }
  function restore(job, saved) {
    job.font = { ...saved.font };
    job.align = saved.align;
    job.leftSkip = saved.leftSkip;
    job.rightSkip = saved.rightSkip;
    job.parindent = saved.parindent;
  }

  function subReader(job, tokens) {
    return new T.lex.Reader(tokens.concat([{ t: 'eof' }]), job.macros);
  }

  /** Run a group of tokens with the state put back afterwards. */
  function inGroup(job, tokens, fn) {
    const saved = save(job);
    const reader = subReader(job, tokens);
    if (fn) fn(reader);
    else process(job, reader);
    restore(job, saved);
  }

  /** The nodes a run of tokens makes, without putting them anywhere. */
  function collect(job, tokens) {
    const savedNodes = job.nodes;
    const savedWord = job.word;
    job.nodes = [];
    job.word = null;
    inGroup(job, tokens);
    endWord(job);
    const nodes = job.nodes;
    job.nodes = savedNodes;
    job.word = savedWord;
    return nodes;
  }

  /** Rows, captured rather than placed. Footnotes and table cells both need
   *  the paragraph machinery without the page it usually ends on. */
  function capture(job, fn) {
    const saved = job.capture;
    const rows = [];
    job.capture = rows;
    fn();
    job.capture = saved;
    return rows;
  }

  /** Pack nodes into one line, no breaking: a table cell, a caption fragment. */
  function pack(job, nodes) {
    const width = nodes.reduce((sum, node) => sum + node.w, 0);
    const row = lineRow(job, nodes, width, { justify: false, align: 'left', indent: 0 });
    return { w: width, h: row.above, d: row.below, items: row.items, notes: row.notes };
  }

  function stack(rows, gap = 0) {
    const items = [];
    let y = 0;
    let first = true;
    let height = 0;
    let width = 0;
    for (const row of rows) {
      y -= first ? row.above : row.above + gap;
      if (first) height = row.above;
      for (const item of row.items) items.push({ ...item, x: item.x + (row.x || 0), y: item.y + y });
      width = Math.max(width, row.items.reduce((max, item) => Math.max(max, item.x + (item.w || 0)), 0));
      y -= row.below;
      first = false;
    }
    return { w: width, h: height, d: -y, items };
  }

  function mathBox(job, tokens, display) {
    return T.math.typeset(tokens, job.macros, {
      display,
      base: job.font.size,
      unknown: (name, line, file) => say(job, 'warning', `Unknown command \\${name} in maths`, line, file),
    });
  }

  function collectUntil(reader, matches) {
    const out = [];
    let depth = 0;
    for (;;) {
      const tok = reader.raw();
      if (tok.t === 'eof') break;
      if (tok.t === '{') depth += 1;
      if (tok.t === '}') depth -= 1;
      if (!depth && matches(tok)) break;
      out.push(tok);
    }
    return out;
  }

  function number(job, kind) {
    if (kind === 'section') return String(job.counters.section);
    if (kind === 'subsection') return `${job.counters.section}.${job.counters.subsection}`;
    return `${job.counters.section}.${job.counters.subsection}.${job.counters.subsubsection}`;
  }

  // ------------------------------------------------------------------ pieces

  function heading(job, kind, starred, tokens) {
    const spec = SECTIONS[kind];
    endParagraph(job);
    let label = '';
    if (spec.number && !starred) {
      if (kind === 'section') { job.counters.section += 1; job.counters.subsection = 0; job.counters.subsubsection = 0; }
      if (kind === 'subsection') { job.counters.subsection += 1; job.counters.subsubsection = 0; }
      if (kind === 'subsubsection') job.counters.subsubsection += 1;
      label = number(job, kind);
      job.lastNumber = label;
    }
    const title = T.lex.plain(tokens).trim();
    const entry = { level: spec.level, title, label, page: job.counters.page };
    if (spec.number && !starred) job.toc.push(entry);

    vspace(job, spec.above * job.base);
    const saved = save(job);
    job.font.size = job.base * spec.scale;
    job.font.bold = spec.bold;
    job.font.italic = false;
    job.align = 'left';
    job.parindent = false;

    const mark = (pageIndex, y) => {
      entry.page = job.counters.page;
      entry.at = { page: pageIndex, y: y + job.font.size };
      if (!starred) job.outline.push({ title, level: Math.max(1, spec.level), page: pageIndex, x: job.margin, y: y + job.font.size * 1.4 });
    };

    if (label) { addText(job, label); addGlue(job, { w: job.font.size * 0.5, stretch: 0, shrink: 0, nobreak: true }); }
    inGroup(job, tokens);
    if (spec.runIn) {
      addGlue(job, { w: job.font.size * 0.6, stretch: 0, shrink: 0 });
      const nodes = job.nodes;
      job.nodes = [];
      restore(job, saved);
      // A run-in heading keeps the paragraph that follows it, so it does not
      // end here: the next words simply carry on after it.
      job.nodes = nodes;
      job.parindent = false;
      return;
    }
    endParagraph(job, { indent: 0, keep: true, mark });
    restore(job, saved);
    job.parindent = false;
    vspace(job, spec.below * job.base);
  }

  function displayRow(job, box, { tag = null, gapAbove = 0.9, gapBelow = 0.9, centred = true } = {}) {
    endParagraph(job);
    vspace(job, job.base * gapAbove);
    const x = centred ? Math.max(0, (job.measure - box.w) / 2) : 0;
    const items = box.items.map((item) => ({ ...item, x: item.x + x }));
    if (tag) {
      const size = job.base;
      const width = M().width(tag, 'rm', size);
      items.push({ k: 't', x: job.measure - width, y: 0, f: 'rm', s: size, t: tag });
    }
    emitRow(job, { items, above: box.h, below: box.d, x: job.leftSkip, lead: 0 });
    vspace(job, job.base * gapBelow);
    job.parindent = false;
  }

  function caption(job, kind, tokens) {
    // Whatever the float holds has been built by now — the table, the
    // picture — and the caption is a paragraph under it, not beside it.
    endParagraph(job);
    vspace(job, job.base * 0.5);
    const saved = save(job);
    job.font.size = job.base * 0.92;
    job.align = 'justify';
    job.counters[kind] += 1;
    const label = `${kind === 'figure' ? 'Figure' : 'Table'} ${job.counters[kind]}`;
    job.lastNumber = String(job.counters[kind]);
    const saveBold = job.font.bold;
    job.font.bold = true;
    addText(job, `${label}:`);
    job.font.bold = saveBold;
    addGlue(job);
    inGroup(job, tokens);
    endParagraph(job, { indent: 0 });
    restore(job, saved);
  }

  // ------------------------------------------------------------------ tables

  function columnSpec(text) {
    const columns = [];
    const rules = [];
    let i = 0;
    let pending = 0;
    while (i < text.length) {
      const ch = text[i];
      if (ch === '|') { pending += 1; i += 1; continue; }
      if ('lcr'.includes(ch)) { rules.push(pending); pending = 0; columns.push({ align: ch }); i += 1; continue; }
      if (ch === 'p' || ch === 'm' || ch === 'b') {
        const close = text.indexOf('}', i);
        rules.push(pending); pending = 0;
        columns.push({ align: 'p', width: text.slice(text.indexOf('{', i) + 1, close) });
        i = close + 1;
        continue;
      }
      if (ch === '@' || ch === '>' || ch === '<') {
        const close = text.indexOf('}', i);
        i = close === -1 ? text.length : close + 1;
        continue;
      }
      i += 1;
    }
    rules.push(pending);
    return { columns, rules };
  }

  function tabular(job, spec, body) {
    const { columns, rules } = columnSpec(spec);
    const pad = 6;
    const rows = [];
    let cells = [];
    let current = [];
    const hlines = [];

    const reader = subReader(job, body);
    for (;;) {
      const tok = reader.next();
      if (tok.t === 'eof') break;
      if (tok.t === '&') { cells.push(current); current = []; continue; }
      if (tok.t === 'cs' && (tok.v === '\\' || tok.v === 'tabularnewline')) {
        reader.optional();
        cells.push(current);
        rows.push(cells);
        cells = [];
        current = [];
        continue;
      }
      if (tok.t === 'cs' && (tok.v === 'hline' || tok.v === 'toprule' || tok.v === 'midrule' || tok.v === 'bottomrule')) {
        hlines.push(rows.length + (cells.length || current.length ? 1 : 0));
        continue;
      }
      if (tok.t === 'cs' && tok.v === 'cline') { reader.group(); continue; }
      current.push(tok);
    }
    if (current.length || cells.length) { cells.push(current); rows.push(cells); }

    // Every cell laid out once, so the columns can be measured.
    const laid = rows.map((row) =>
      row.map((tokens, c) => {
        const column = columns[c] || { align: 'l' };
        const saved = save(job);
        let box;
        if (column.align === 'p') {
          const width = length(column.width, job, job.measure / Math.max(1, columns.length));
          const rowsOut = capture(job, () => {
            const nodes = collect(job, tokens);
            const lines = breakLines(nodes, width, job);
            lines.forEach((line, i) => {
              emitRow(job, lineRow(job, line, width, { justify: i < lines.length - 1, align: 'left', indent: 0 }));
            });
          });
          box = stack(rowsOut, job.font.size * 0.25);
          box.w = width;
        } else {
          box = pack(job, collect(job, tokens));
        }
        restore(job, saved);
        return box;
      }));

    const count = Math.max(columns.length, ...laid.map((row) => row.length));
    const widths = [];
    for (let c = 0; c < count; c += 1) {
      widths.push(Math.max(0, ...laid.map((row) => (row[c] ? row[c].w : 0))));
    }
    const ruleWidth = 0.4;
    const xs = [];
    let x = 0;
    for (let c = 0; c < count; c += 1) {
      x += (rules[c] || 0) * (ruleWidth + 1.5);
      xs.push(x);
      x += widths[c] + pad * 2;
    }
    x += (rules[count] || 0) * (ruleWidth + 1.5);
    const total = x;

    const items = [];
    let y = 0;
    const heights = laid.map((row) => Math.max(job.font.size * 0.75, ...row.map((box) => box.h)));
    const depths = laid.map((row) => Math.max(job.font.size * 0.25, ...row.map((box) => box.d)));
    const tops = [];
    laid.forEach((row, r) => {
      tops.push(y);
      y -= heights[r] + job.font.size * 0.3;
      row.forEach((box, c) => {
        const column = columns[c] || { align: 'l' };
        const room = widths[c];
        const left = column.align === 'r' ? room - box.w : column.align === 'c' ? (room - box.w) / 2 : 0;
        for (const item of box.items) {
          items.push({ ...item, x: item.x + xs[c] + pad + left, y: item.y + y });
        }
      });
      y -= depths[r] + job.font.size * 0.25;
    });
    tops.push(y);

    for (const at of hlines) {
      const where = at >= tops.length ? y : tops[at];
      items.push({ k: 'r', x: 0, y: where - ruleWidth, w: total, h: ruleWidth });
    }
    for (let c = 0; c <= count; c += 1) {
      const many = rules[c] || 0;
      for (let i = 0; i < many; i += 1) {
        const at = c === count ? total - (i + 1) * (ruleWidth + 1.5) : xs[c] - (i + 1) * (ruleWidth + 1.5);
        items.push({ k: 'r', x: at, y, w: ruleWidth, h: -y });
      }
    }

    return { w: total, h: 0, d: -y, items: items.map((item) => ({ ...item, y: item.y })) };
  }

  // ------------------------------------------------------------ environments

  function environment(job, name, reader) {
    const body = () => reader.until(name);

    switch (name) {
      case 'document':
        job.started = true;
        process(job, reader, (tok) => tok.t === 'cs' && tok.v === 'end');
        return;

      case 'abstract': {
        const saved = save(job);
        endParagraph(job);
        vspace(job, job.base * 1.2);
        job.font.size = job.base * 0.92;
        job.font.bold = true;
        job.align = 'center';
        addText(job, 'Abstract');
        endParagraph(job, { indent: 0 });
        restore(job, saved);
        vspace(job, job.base * 0.4);
        job.leftSkip += job.measure * 0.08;
        job.rightSkip += job.measure * 0.08;
        job.font.size = job.base * 0.92;
        inGroup(job, body(), (sub) => { process(job, sub); endParagraph(job); });
        restore(job, saved);
        vspace(job, job.base * 1.2);
        job.parindent = false;
        return;
      }

      case 'center': case 'flushleft': case 'flushright': {
        const saved = save(job);
        endParagraph(job);
        job.align = name === 'center' ? 'center' : name === 'flushright' ? 'right' : 'left';
        job.parindent = false;
        inGroup(job, body(), (sub) => { process(job, sub); endParagraph(job, { indent: 0 }); });
        restore(job, saved);
        job.parindent = false;
        return;
      }

      case 'quote': case 'quotation': case 'verse': {
        const saved = save(job);
        endParagraph(job);
        vspace(job, job.base * 0.5);
        job.leftSkip += job.font.size * 2;
        job.rightSkip += job.font.size * 2;
        job.parindent = false;
        inGroup(job, body(), (sub) => { process(job, sub); endParagraph(job, { indent: 0 }); });
        restore(job, saved);
        vspace(job, job.base * 0.5);
        job.parindent = false;
        return;
      }

      case 'itemize': case 'enumerate': case 'description': {
        const saved = save(job);
        endParagraph(job);
        vspace(job, job.base * 0.45);
        job.list.push({ kind: name, count: 0, depth: job.list.length });
        job.leftSkip += job.font.size * 2;
        job.parindent = false;
        inGroup(job, body(), (sub) => { process(job, sub); endParagraph(job, { indent: 0, hanging: 0 }); });
        job.list.pop();
        restore(job, saved);
        vspace(job, job.base * 0.45);
        job.parindent = false;
        return;
      }

      case 'figure': case 'figure*': case 'table': case 'table*': {
        const saved = save(job);
        reader.optional();
        endParagraph(job);
        vspace(job, job.base * 0.9);
        job.floatKind = name.startsWith('figure') ? 'figure' : 'table';
        job.parindent = false;
        inGroup(job, body(), (sub) => { process(job, sub); endParagraph(job, { indent: 0 }); });
        job.floatKind = null;
        restore(job, saved);
        vspace(job, job.base * 0.9);
        job.parindent = false;
        return;
      }

      case 'tabular': case 'tabular*': case 'array': {
        const spec = T.lex.plain(reader.group());
        const box = tabular(job, spec, reader.until(name));
        addBox(job, box);
        return;
      }

      case 'equation': case 'equation*': case 'displaymath': case 'gather': case 'gather*': {
        const tokens = reader.until(name);
        const starred = name.endsWith('*') || name === 'displaymath';
        const parts = name.startsWith('gather') ? splitRows(tokens) : [tokens];
        parts.forEach((part) => {
          const tagged = !starred && !hasNoTag(part);
          if (tagged) job.counters.equation += 1;
          const tag = tagged ? `(${job.counters.equation})` : null;
          if (tagged) job.lastNumber = String(job.counters.equation);
          takeLabels(job, part);
          displayRow(job, mathBox(job, part, true), { tag });
        });
        return;
      }

      case 'align': case 'align*': case 'aligned': case 'eqnarray': case 'eqnarray*': case 'alignat': case 'alignat*': {
        const starred = name.endsWith('*');
        if (name === 'alignat' || name === 'alignat*') reader.group();
        const rows = splitRows(reader.until(name));
        const left = [];
        const right = [];
        rows.forEach((row) => {
          const at = splitCells(row);
          left.push(mathBox(job, at[0] || [], true));
          right.push(mathBox(job, [].concat(...at.slice(1).map((cell, i) => (i ? [{ t: 'space' }, ...cell] : cell))), true));
        });
        // The relation the rows align on keeps its thick space, which it would
        // otherwise lose by being the first thing in its own column.
        const thick = (job.base * 5) / 18;
        const axis = Math.max(0, ...left.map((box) => box.w)) + thick;
        const widest = axis + Math.max(0, ...right.map((box) => box.w));
        const startX = Math.max(0, (job.measure - widest) / 2);
        endParagraph(job);
        vspace(job, job.base * 0.9);
        rows.forEach((row, i) => {
          const tagged = !starred && !hasNoTag(row);
          if (tagged) job.counters.equation += 1;
          if (tagged) job.lastNumber = String(job.counters.equation);
          takeLabels(job, row);
          const items = [];
          for (const item of left[i].items) items.push({ ...item, x: item.x + startX + (axis - thick - left[i].w) });
          for (const item of right[i].items) items.push({ ...item, x: item.x + startX + axis });
          if (tagged) {
            const tag = `(${job.counters.equation})`;
            items.push({ k: 't', x: job.measure - M().width(tag, 'rm', job.base), y: 0, f: 'rm', s: job.base, t: tag });
          }
          emitRow(job, {
            items,
            above: Math.max(left[i].h, right[i].h),
            below: Math.max(left[i].d, right[i].d),
            x: job.leftSkip,
            lead: i ? job.base * 0.35 : 0,
          });
        });
        vspace(job, job.base * 0.9);
        job.parindent = false;
        return;
      }

      case 'thebibliography': {
        reader.group();
        const saved = save(job);
        endParagraph(job);
        heading(job, 'section', true, T.lex.tokenize('References'));
        job.font.size = job.base * 0.95;
        job.inBibliography = true;
        inGroup(job, reader.until(name), (sub) => { process(job, sub); endParagraph(job, { indent: 0, hanging: job.font.size * 1.6 }); });
        job.inBibliography = false;
        restore(job, saved);
        return;
      }

      case 'minipage': case 'small': case 'footnotesize': case 'large': {
        reader.optional();
        if (name === 'minipage') reader.group();
        const saved = save(job);
        if (SIZES[name]) job.font.size = job.base * SIZES[name];
        inGroup(job, body(), (sub) => { process(job, sub); endParagraph(job); });
        restore(job, saved);
        return;
      }

      default: {
        const macro = job.macros.get(`env@${name}`);
        if (macro) {
          const saved = save(job);
          inGroup(job, macro.begin.concat(reader.until(name), macro.end), (sub) => { process(job, sub); endParagraph(job); });
          restore(job, saved);
          return;
        }
        say(job, 'warning', `Unknown environment "${name}" — its contents were set as ordinary text`, job.line, job.file);
        inGroup(job, body(), (sub) => { process(job, sub); endParagraph(job); });
      }
    }
  }

  const splitRows = (tokens) => {
    const rows = [[]];
    let depth = 0;
    for (const tok of tokens) {
      if (tok.t === '{') depth += 1;
      if (tok.t === '}') depth -= 1;
      if (!depth && tok.t === 'cs' && tok.v === '\\') { rows.push([]); continue; }
      rows[rows.length - 1].push(tok);
    }
    return rows.filter((row) => row.some((tok) => tok.t !== 'space' && tok.t !== 'par'));
  };

  const splitCells = (tokens) => {
    const cells = [[]];
    let depth = 0;
    for (const tok of tokens) {
      if (tok.t === '{') depth += 1;
      if (tok.t === '}') depth -= 1;
      if (!depth && tok.t === '&') { cells.push([]); continue; }
      cells[cells.length - 1].push(tok);
    }
    return cells;
  };

  const hasNoTag = (tokens) => tokens.some((tok) => tok.t === 'cs' && (tok.v === 'nonumber' || tok.v === 'notag'));

  /** A \label inside a display belongs to the number that display just got. */
  function takeLabels(job, tokens) {
    tokens.forEach((tok, i) => {
      if (tok.t !== 'cs' || tok.v !== 'label') return;
      const rest = tokens.slice(i + 1);
      const reader = subReader(job, rest);
      const key = T.lex.plain(reader.group());
      if (key) job.labels[key] = { number: job.lastNumber || '', page: job.counters.page };
    });
  }

  // --------------------------------------------------------------- the loop

  function process(job, reader, stop) {
    for (;;) {
      const tok = reader.next();
      if (tok.t === 'eof') break;
      if (stop && stop(tok)) { reader.back(tok); break; }
      job.line = tok.line || job.line;
      job.file = tok.file || job.file;
      step(job, reader, tok);
    }
  }

  function step(job, reader, tok) {
    switch (tok.t) {
      case 'space': addGlue(job); return;
      case 'par': endParagraph(job); return;
      case '~': addGlue(job, { nobreak: true, stretch: 0 }); return;
      case '&': addText(job, '&'); return;
      case 'verb': {
        const saved = job.font.family;
        job.font.family = 'tt';
        addText(job, tok.v);
        job.font.family = saved;
        return;
      }
      case 'raw': {
        verbatim(job, tok.v.body);
        return;
      }
      case '{': {
        const saved = save(job);
        job.groups = job.groups || [];
        job.groups.push(saved);
        return;
      }
      case '}': {
        if (job.groups && job.groups.length) restore(job, job.groups.pop());
        return;
      }
      case '$': {
        const tokens = collectUntil(reader, (t) => t.t === '$');
        addBox(job, mathBox(job, tokens, false));
        return;
      }
      case '$$': {
        const tokens = collectUntil(reader, (t) => t.t === '$$');
        displayRow(job, mathBox(job, tokens, true), {});
        return;
      }
      case '^': case '_': {
        const which = tok.t;
        const arg = reader.group();
        const saved = job.font.size;
        job.font.size *= 0.7;
        const rise = which === '^' ? saved * 0.42 : -saved * 0.18;
        const runs = collect(job, arg);
        job.font.size = saved;
        for (const node of runs) {
          if (node.k !== 'word') continue;
          for (const run of node.runs) addRun(job, run.t, run.f, run.s, { rise });
        }
        return;
      }
      case 'char': {
        character(job, reader, tok.v);
        return;
      }
      case 'cs':
        command(job, reader, tok);
        return;
      default:
    }
  }

  function character(job, reader, ch) {
    if (ch === '-') {
      let count = 1;
      for (;;) {
        const next = reader.peek();
        if (next.t === 'char' && next.v === '-' && count < 3) { reader.next(); count += 1; continue; }
        break;
      }
      addText(job, count === 1 ? '-' : count === 2 ? '–' : '—');
      return;
    }
    if (ch === '`' || ch === "'") {
      const next = reader.peek();
      const double = next.t === 'char' && next.v === ch;
      if (double) reader.next();
      addText(job, ch === '`' ? (double ? '“' : '‘') : (double ? '”' : '’'));
      return;
    }
    if (ch === '<' || ch === '>') { addText(job, ch); return; }
    addText(job, ch);
  }

  function verbatim(job, text) {
    const saved = save(job);
    endParagraph(job);
    vspace(job, job.base * 0.5);
    job.font.family = 'tt';
    job.font.size = job.base * 0.85;
    job.align = 'left';
    for (const line of String(text).split('\n')) {
      const nodes = [];
      job.nodes = nodes;
      job.word = null;
      addText(job, line.replace(/\t/g, '  ') || ' ');
      endWord(job);
      job.nodes = [];
      const row = lineRow(job, nodes, job.measure, { justify: false, align: 'left', indent: 0 });
      row.x = job.leftSkip;
      emitRow(job, row);
    }
    restore(job, saved);
    vspace(job, job.base * 0.5);
    job.parindent = false;
  }

  function itemMark(job) {
    const list = job.list[job.list.length - 1];
    if (!list) return '';
    list.count += 1;
    if (list.kind === 'itemize') return ITEM_MARKS[Math.min(ITEM_MARKS.length - 1, list.depth)];
    if (list.kind === 'description') return '';
    const depth = list.depth;
    if (depth === 0) return `${list.count}.`;
    if (depth === 1) return `(${alpha(list.count)})`;
    if (depth === 2) return `${roman(list.count)}.`;
    return `${alpha(list.count).toUpperCase()}.`;
  }

  function footnote(job, tokens) {
    job.counters.footnote += 1;
    const mark = String(job.counters.footnote);
    // The mark rides on the word it follows, so it cannot be left at the end
    // of a line on its own — and so the note travels to whatever page that
    // word lands on.
    addRun(job, mark, fontKey(job), job.font.size * 0.72, { rise: job.font.size * 0.38 });
    const word = ensureWord(job);

    const savedNodes = job.nodes;
    const savedWord = job.word;
    const saved = save(job);
    job.nodes = [];
    job.word = null;
    job.font.size = job.base * 0.8;
    job.align = 'justify';
    const rows = capture(job, () => {
      addRun(job, mark, 'rm', job.base * 0.6, { rise: job.base * 0.3 });
      addGlue(job, { w: job.base * 0.2, stretch: 0 });
      inGroup(job, tokens);
      endParagraph(job, { indent: 0 });
    });
    restore(job, saved);
    job.nodes = savedNodes;
    job.word = savedWord;
    word.notes = (word.notes || []).concat([rows]);
  }

  function graphic(job, options, name) {
    const image = job.images[name] || job.images[`${name}.png`] || job.images[`${name}.jpg`] || job.images[`${name}.jpeg`];
    if (!image) {
      say(job, 'warning', `No image called "${name}" in this project`, job.line, job.file);
      const w = Math.min(job.measure * 0.5, 180);
      const h = w * 0.62;
      addBox(job, {
        w, h, d: 0,
        items: [
          { k: 'r', x: 0, y: 0, w, h: 0.5 }, { k: 'r', x: 0, y: h, w, h: 0.5 },
          { k: 'r', x: 0, y: 0, w: 0.5, h }, { k: 'r', x: w, y: 0, w: 0.5, h },
          { k: 't', x: 8, y: h / 2, f: 'rm', s: job.base * 0.8, t: `[${name}]` },
        ],
      });
      return;
    }
    const opts = {};
    for (const pair of T.lex.plain(options || []).split(',')) {
      const [key, value] = pair.split('=');
      if (key && value !== undefined) opts[key.trim()] = value.trim();
    }
    let w = image.width;
    let h = image.height;
    if (opts.width) { const want = length(opts.width, job, w); h = h * (want / w); w = want; }
    if (opts.height) { const want = length(opts.height, job, h); w = w * (want / h); h = want; }
    if (opts.scale) { w *= Number(opts.scale); h *= Number(opts.scale); }
    if (w > job.measure) { h *= job.measure / w; w = job.measure; }
    job.doc.image(image.id, image);
    addBox(job, { w, h, d: 0, items: [{ k: 'i', x: 0, y: 0, w, h, img: image.id }] });
  }

  function reference(job, key, kind) {
    const found = job.refs[key];
    if (!found) {
      say(job, 'warning', `Reference "${key}" was never defined`, job.line, job.file);
      addText(job, '??');
      return;
    }
    addText(job, kind === 'page' ? String(found.page) : String(found.number || '??'));
  }

  function cite(job, keys) {
    const numbers = keys.split(',').map((key) => {
      const trimmed = key.trim();
      const found = job.bib[trimmed];
      if (!found) {
        say(job, 'warning', `Citation "${trimmed}" was never defined`, job.line, job.file);
        return '?';
      }
      return String(found.number);
    });
    addText(job, `[${numbers.join(', ')}]`);
  }

  function link(job, url, tokens) {
    const saved = save(job);
    if (!tokens) {
      // A bare \url is set in the typewriter face, as hyperref does it.
      job.font.family = 'tt';
      job.font.size *= 0.95;
      addRun(job, url, fontKey(job), job.font.size, { link: { url } });
      restore(job, saved);
      return;
    }
    for (const node of collect(job, tokens)) {
      if (node.k !== 'word') { job.nodes.push(node); continue; }
      for (const run of node.runs) addRun(job, run.t, run.f, run.s, { rise: run.rise, link: { url } });
      endWord(job);
    }
    restore(job, saved);
  }

  // ------------------------------------------------------------- the front

  function maketitle(job) {
    endParagraph(job);
    const saved = save(job);
    vspace(job, job.base * 2.6);
    job.align = 'center';
    job.parindent = false;
    job.font.size = job.base * 1.728;
    inGroup(job, job.titleTokens || []);
    endParagraph(job, { indent: 0 });
    vspace(job, job.base * 1.4);
    job.font.size = job.base * 1.15;
    inGroup(job, job.authorTokens || []);
    endParagraph(job, { indent: 0 });
    vspace(job, job.base * 0.7);
    job.font.size = job.base;
    inGroup(job, job.dateTokens === undefined ? T.lex.tokenize(today()) : job.dateTokens);
    endParagraph(job, { indent: 0 });
    restore(job, saved);
    vspace(job, job.base * 2.2);
    job.parindent = false;
  }

  const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July',
    'August', 'September', 'October', 'November', 'December'];
  function today() {
    const now = new Date();
    return `${MONTHS[now.getMonth()]} ${now.getDate()}, ${now.getFullYear()}`;
  }

  function contents(job) {
    if (!job.previousToc.length) {
      say(job, 'info', 'The table of contents will fill in on the next run', job.line, job.file);
    }
    heading(job, 'section', true, T.lex.tokenize('Contents'));
    const saved = save(job);
    job.parindent = false;
    for (const entry of job.previousToc) {
      const depth = Math.max(0, entry.level - 1);
      job.leftSkip = saved.leftSkip + depth * job.base * 1.4;
      job.font.bold = entry.level === 1;
      job.font.size = job.base * (entry.level === 1 ? 1 : 0.95);
      const target = entry.at ? { page: entry.at.page, tx: job.margin, ty: entry.at.y } : null;
      if (entry.label) { addRun(job, entry.label, fontKey(job), job.font.size, { link: target }); addGlue(job, { w: job.font.size * 0.6, stretch: 0 }); }
      addRun(job, entry.title, fontKey(job), job.font.size, { link: target });
      addGlue(job, { fill: true, w: job.font.size, stretch: 0, shrink: 0 });
      addRun(job, String(entry.page), fontKey(job), job.font.size, { link: target });
      endParagraph(job, { indent: 0 });
      job.font.bold = false;
    }
    restore(job, saved);
    vspace(job, job.base);
    job.parindent = false;
  }

  const BIB_ORDER = ['author', 'title', 'journal', 'booktitle', 'publisher', 'school',
    'institution', 'address', 'volume', 'number', 'pages', 'edition', 'note', 'year'];
  // Which fields the plain style runs on from the one before with a comma
  // rather than closing the sentence.
  const COMMA_BEFORE = ['address', 'volume', 'number', 'pages', 'year', 'edition'];

  function bibliography(job) {
    const entries = Object.values(job.bib).filter((entry) => entry.fields).sort((a, b) => a.number - b.number);
    if (!entries.length) {
      say(job, 'warning', 'Nothing is cited, so the bibliography is empty', job.line, job.file);
      return;
    }
    heading(job, 'section', true, T.lex.tokenize('References'));
    const saved = save(job);
    job.font.size = job.base * 0.95;
    job.parindent = false;

    for (const entry of entries) {
      const hang = job.font.size * 2;
      const label = `[${entry.number}]`;
      const wide = M().width(label, 'rm', job.font.size);
      addBox(job, {
        w: wide, h: job.font.size * 0.7, d: 0,
        items: [{ k: 't', x: 0, y: 0, f: 'rm', s: job.font.size, t: label }],
      });
      addGlue(job, { w: Math.max(job.font.size * 0.4, hang - wide), stretch: 0, shrink: 0, nobreak: true });

      const fields = entry.fields;
      let first = true;
      for (const key of BIB_ORDER) {
        const value = fields[key];
        if (!value) continue;
        if (!first) { addText(job, COMMA_BEFORE.includes(key) ? ',' : '.'); addGlue(job); }
        first = false;
        const italic = key === 'journal' || key === 'booktitle';
        const was = job.font.italic;
        job.font.italic = italic;
        inGroup(job, T.lex.tokenize(key === 'author' ? people(value) : value));
        job.font.italic = was;
      }
      addText(job, '.');
      endParagraph(job, { indent: 0, hanging: hang });
      vspace(job, job.base * 0.25);
    }
    restore(job, saved);
    job.parindent = false;
  }

  /** "Lamport, Leslie and Knuth, Donald E." the way a bibliography prints it. */
  function people(value) {
    return value
      .split(/\s+and\s+/)
      .map((one) => {
        const parts = one.split(',').map((part) => part.trim());
        return parts.length > 1 ? `${parts.slice(1).join(' ')} ${parts[0]}` : one.trim();
      })
      .reduce((out, one, i, all) => {
        if (i === 0) return one;
        return i === all.length - 1 ? `${out} and ${one}` : `${out}, ${one}`;
      }, '');
  }

  // ---------------------------------------------------------------- commands

  function command(job, reader, tok) {
    const name = tok.v;

    if (ACCENTS[name]) {
      const arg = T.lex.plain(reader.group()).trim();
      const letter = arg[0] || '';
      addText(job, (ACCENTS[name][letter] || letter) + arg.slice(1));
      return;
    }
    if (GLYPHS[name] !== undefined) { addText(job, GLYPHS[name]); return; }
    if (SIZES[name] !== undefined) { job.font.size = job.base * SIZES[name]; return; }

    switch (name) {
      // ---- the preamble
      case 'documentclass': {
        const options = T.lex.plain(reader.optional() || []);
        job.docClass = T.lex.plain(reader.group());
        for (const option of options.split(',').map((o) => o.trim())) {
          const size = /^(\d+)pt$/.exec(option);
          if (size) { job.base = Number(size[1]); job.font.size = job.base; }
          if (PAPER[option]) {
            job.paper = option;
            [job.W, job.H] = PAPER[option];
            job.measure = job.W - job.margin * 2;
          }
          if (option === 'twocolumn') say(job, 'info', 'twocolumn is not set here — the page stays one column', tok.line, tok.file);
        }
        return;
      }
      case 'usepackage': case 'RequirePackage': {
        const options = T.lex.plain(reader.optional() || []);
        const packages = T.lex.plain(reader.group());
        if (packages.includes('geometry')) applyGeometry(job, options);
        return;
      }
      case 'geometry': applyGeometry(job, T.lex.plain(reader.group())); return;
      case 'title': job.titleTokens = reader.group(); return;
      case 'author': job.authorTokens = reader.group(); return;
      case 'date': job.dateTokens = reader.group(); return;
      case 'thanks': reader.group(); return;

      case 'newcommand': case 'renewcommand': case 'providecommand': {
        const target = reader.group();
        const key = target.length === 1 && target[0].t === 'cs' ? target[0].v : T.lex.plain(target).replace(/^\\/, '');
        const arity = Number(T.lex.plain(reader.optional() || []) || 0);
        const fallback = reader.optional();
        job.macros.set(key, { arity, optional: fallback ? fallback : null, body: reader.group() });
        return;
      }
      case 'def': {
        const target = reader.raw();
        let arity = 0;
        for (;;) {
          const next = reader.peekRaw();
          if (next.t === '#') { reader.raw(); arity = Math.max(arity, next.v); continue; }
          break;
        }
        if (target.t === 'cs') job.macros.set(target.v, { arity, optional: null, body: reader.group() });
        return;
      }
      case 'newenvironment': case 'renewenvironment': {
        const key = T.lex.plain(reader.group());
        const arity = Number(T.lex.plain(reader.optional() || []) || 0);
        void arity;
        job.macros.set(`env@${key}`, { begin: reader.group(), end: reader.group() });
        return;
      }

      case 'begin': environment(job, T.lex.plain(reader.group()), reader); return;
      case 'end': reader.group(); return;

      // The other two ways to open maths: \[ … \] displayed, \( … \) inline.
      case '[': displayRow(job, mathBox(job, collectUntil(reader, (t) => t.t === 'cs' && t.v === ']'), true), {}); return;
      case '(': addBox(job, mathBox(job, collectUntil(reader, (t) => t.t === 'cs' && t.v === ')'), false)); return;
      case ']': case ')': return;

      // ---- structure
      case 'part': case 'section': case 'subsection': case 'subsubsection':
      case 'paragraph': case 'subparagraph': {
        let starred = false;
        const next = reader.peek();
        if (next.t === 'char' && next.v === '*') { reader.next(); starred = true; }
        reader.optional();
        heading(job, name, starred, reader.group());
        return;
      }
      case 'maketitle': maketitle(job); return;
      case 'tableofcontents': contents(job); return;
      case 'appendix': job.counters.section = 0; return;

      case 'item': {
        endParagraph(job, { indent: 0, hanging: 0 });
        const custom = reader.optional();
        const list = job.list[job.list.length - 1];
        job.parindent = false;
        if (custom || (list && list.kind === 'description')) {
          const was = job.font.bold;
          job.font.bold = true;
          inGroup(job, custom || []);
          job.font.bold = was;
          addGlue(job, { w: job.font.size * 0.5, stretch: 0 });
          if (list) list.count += 1;
          return;
        }
        const mark = itemMark(job);
        addBox(job, {
          w: 0, h: job.font.size * 0.7, d: 0,
          items: [{ k: 't', x: -job.font.size * 1.7, y: 0, f: fontKey(job), s: job.font.size, t: mark }],
        });
        return;
      }

      // ---- crossings
      case 'label': {
        const key = T.lex.plain(reader.group());
        if (key) job.labels[key] = { number: job.lastNumber || '', page: job.counters.page };
        return;
      }
      case 'ref': case 'autoref': reference(job, T.lex.plain(reader.group()), 'ref'); return;
      case 'eqref': {
        const key = T.lex.plain(reader.group());
        addText(job, '(');
        reference(job, key, 'ref');
        addText(job, ')');
        return;
      }
      case 'pageref': reference(job, T.lex.plain(reader.group()), 'page'); return;
      case 'cite': case 'citep': case 'citet': reader.optional(); cite(job, T.lex.plain(reader.group())); return;
      case 'bibitem': {
        const hang = job.font.size * 2;
        endParagraph(job, { indent: 0, hanging: hang });
        reader.optional();
        const key = T.lex.plain(reader.group());
        const found = job.bib[key];
        const label = `[${found ? found.number : '?'}]`;
        const wide = M().width(label, 'rm', job.font.size);
        job.parindent = false;
        addBox(job, {
          w: wide, h: job.font.size * 0.7, d: 0,
          items: [{ k: 't', x: 0, y: 0, f: 'rm', s: job.font.size, t: label }],
        });
        addGlue(job, { w: Math.max(job.font.size * 0.4, hang - wide), stretch: 0, shrink: 0, nobreak: true });
        return;
      }
      case 'bibliography': reader.group(); bibliography(job); return;
      case 'bibliographystyle': reader.group(); return;
      case 'nocite': reader.group(); return;
      case 'footnote': footnote(job, reader.group()); return;
      case 'footnotemark': job.counters.footnote += 1; addRun(job, String(job.counters.footnote), fontKey(job), job.font.size * 0.72, { rise: job.font.size * 0.38 }); return;

      case 'includegraphics': {
        const options = reader.optional();
        graphic(job, options, T.lex.plain(reader.group()).trim());
        return;
      }
      case 'caption': {
        reader.optional();
        caption(job, job.floatKind || 'figure', reader.group());
        return;
      }
      case 'url': link(job, T.lex.plain(reader.group()), null); return;
      case 'href': { const url = T.lex.plain(reader.group()); link(job, url, reader.group()); return; }

      case 'input': case 'include': {
        const wanted = T.lex.plain(reader.group()).trim();
        const file = job.files.find((one) => one.name === wanted || one.name === `${wanted}.tex`);
        if (!file) { say(job, 'error', `\\input: there is no file called "${wanted}"`, tok.line, tok.file); return; }
        if (job.reading.includes(file.name)) { say(job, 'error', `\\input: "${wanted}" includes itself`, tok.line, tok.file); return; }
        job.reading.push(file.name);
        reader.push(T.lex.tokenize(file.text, file.name).concat([{ t: 'popfile' }]));
        return;
      }

      // ---- spacing and breaks
      case '\\': case 'newline': case 'linebreak': {
        reader.optional();
        endWord(job);
        job.nodes.push({ k: 'break', w: 0 });
        return;
      }
      case 'newpage': case 'clearpage': case 'pagebreak': case 'cleardoublepage':
        endParagraph(job);
        if (job.page && !job.firstOnPage) startPage(job);
        return;
      case 'noindent': job.parindent = false; return;
      case 'indent': job.parindent = true; return;
      case 'centering': endParagraph(job); job.align = 'center'; job.parindent = false; return;
      case 'raggedright': endParagraph(job); job.align = 'left'; job.parindent = false; return;
      case 'raggedleft': endParagraph(job); job.align = 'right'; job.parindent = false; return;
      case 'vspace': case 'vskip': case 'vspace*': {
        const amount = length(T.lex.plain(reader.group()), job, 0);
        endParagraph(job);
        vspace(job, amount);
        return;
      }
      case 'smallskip': endParagraph(job); vspace(job, job.base * 0.3); return;
      case 'medskip': endParagraph(job); vspace(job, job.base * 0.6); return;
      case 'bigskip': endParagraph(job); vspace(job, job.base * 1.2); return;
      case 'hspace': case 'hskip': case 'hspace*':
        addGlue(job, { w: length(T.lex.plain(reader.group()), job, 0), stretch: 0, shrink: 0, nobreak: true });
        return;
      case 'quad': addGlue(job, { w: job.font.size, stretch: 0, shrink: 0, nobreak: true }); return;
      case 'qquad': addGlue(job, { w: job.font.size * 2, stretch: 0, shrink: 0, nobreak: true }); return;
      case ',': addGlue(job, { w: job.font.size / 6, stretch: 0, shrink: 0, nobreak: true }); return;
      case ' ': case ';': case ':': addGlue(job, { nobreak: true }); return;
      case '!': return;
      case 'hfill': addGlue(job, { fill: true, w: 0, stretch: 0, shrink: 0 }); return;
      case 'dotfill': case 'hrulefill': addGlue(job, { fill: true, w: 0, stretch: 0, shrink: 0 }); return;
      case 'hrule': {
        endParagraph(job);
        emitRow(job, { items: [{ k: 'r', x: 0, y: 0, w: job.measure, h: 0.4 }], above: 0.4, below: job.base * 0.3, x: job.leftSkip });
        return;
      }
      case 'rule': {
        reader.optional();
        const w = length(T.lex.plain(reader.group()), job, job.measure);
        const h = length(T.lex.plain(reader.group()), job, 1);
        addBox(job, { w, h, d: 0, items: [{ k: 'r', x: 0, y: 0, w, h }] });
        return;
      }

      // ---- fonts
      case 'textbf': case 'textit': case 'textrm': case 'textsf': case 'texttt':
      case 'textsc': case 'textmd': case 'textnormal': case 'textup': case 'textsl':
      case 'emph': case 'underline': {
        const saved = save(job);
        if (name === 'textbf') job.font.bold = true;
        if (name === 'textit' || name === 'textsl' || name === 'emph') job.font.italic = !job.font.italic;
        if (name === 'textrm' || name === 'textnormal') { job.font.family = 'rm'; job.font.bold = false; job.font.italic = false; }
        if (name === 'textsf') job.font.family = 'sf';
        if (name === 'texttt') job.font.family = 'tt';
        if (name === 'textsc') job.font.sc = true;
        if (name === 'textup') job.font.italic = false;
        if (name === 'textmd') job.font.bold = false;
        const tokens = reader.group();
        if (name === 'underline') {
          const nodes = collect(job, tokens);
          const box = pack(job, nodes);
          box.items.push({ k: 'r', x: 0, y: -job.font.size * 0.16, w: box.w, h: 0.4 });
          addBox(job, box);
        } else {
          inGroup(job, tokens);
        }
        restore(job, saved);
        return;
      }
      case 'textsuperscript': case 'textsubscript': {
        const rise = name === 'textsuperscript' ? job.font.size * 0.4 : -job.font.size * 0.18;
        const text = T.lex.plain(reader.group());
        addRun(job, text, fontKey(job), job.font.size * 0.72, { rise });
        return;
      }
      case 'MakeUppercase': case 'uppercase': addText(job, T.lex.plain(reader.group()).toUpperCase()); return;
      case 'MakeLowercase': case 'lowercase': addText(job, T.lex.plain(reader.group()).toLowerCase()); return;
      case 'bfseries': job.font.bold = true; return;
      case 'mdseries': job.font.bold = false; return;
      case 'itshape': case 'slshape': case 'em': job.font.italic = true; return;
      case 'upshape': job.font.italic = false; return;
      case 'scshape': job.font.sc = true; return;
      case 'ttfamily': job.font.family = 'tt'; return;
      case 'rmfamily': job.font.family = 'rm'; return;
      case 'sffamily': job.font.family = 'sf'; return;
      case 'normalfont': job.font = { ...job.font, family: 'rm', bold: false, italic: false, sc: false }; return;

      // ---- names and marks
      case 'today': addText(job, today()); return;
      case 'TeX': case 'LaTeX': case 'LaTeXe': {
        // The logos, drawn the way they are drawn: a raised small A, a dropped
        // E, and the letters around them at the size they were already.
        const size = job.font.size;
        const key = fontKey(job);
        if (name !== 'TeX') {
          addRun(job, 'L', key, size);
          addRun(job, 'A', key, size * 0.7, { rise: size * 0.22 });
        }
        addRun(job, 'T', key, size);
        addRun(job, 'E', key, size, { rise: -size * 0.22 });
        addRun(job, 'X', key, size);
        return;
      }

      // ---- accepted and ignored
      case 'setlength': case 'addtolength': case 'setcounter': case 'addtocounter':
      case 'pagestyle': case 'thispagestyle': case 'graphicspath': case 'hypersetup':
      case 'definecolor': case 'captionsetup': case 'renewcommandx':
        reader.group(); reader.optional(); reader.group(); return;
      case 'linespread': case 'pagenumbering': case 'markboth': case 'markright':
      case 'listoffigures': case 'listoftables': case 'usetikzlibrary':
        reader.group(); return;
      case 'sloppy': case 'fussy': case 'allowdisplaybreaks': case 'flushbottom':
      case 'raggedbottom': case 'onecolumn': case 'noindentafter': case 'protect':
      case 'nonumber': case 'notag': case 'leavevmode': case 'null': case 'relax':
      case '@': case 'ignorespaces': case 'newpagestyle':
        return;
      case 'multicolumn': { reader.group(); reader.group(); inGroup(job, reader.group()); return; }
      case 'mbox': case 'text': case 'hbox': inGroup(job, reader.group()); return;
      case 'ensuremath': addBox(job, mathBox(job, reader.group(), false)); return;
      case 'frac': case 'sum': case 'int': case 'alpha': case 'beta': case 'infty': {
        // Maths outside maths mode: TeX refuses. This sets it and says so.
        say(job, 'warning', `\\${name} needs maths mode — it was set as if in $…$`, tok.line, tok.file);
        const parts = [tok];
        if (name === 'frac') {
          parts.push({ t: '{' }, ...reader.group(), { t: '}' }, { t: '{' }, ...reader.group(), { t: '}' });
        }
        addBox(job, mathBox(job, parts, false));
        return;
      }

      default:
        say(job, 'error', `Undefined control sequence \\${name}`, tok.line, tok.file);
    }
  }

  function applyGeometry(job, options) {
    for (const pair of String(options).split(',')) {
      const [key, value] = pair.split('=').map((part) => (part || '').trim());
      if (key === 'margin' && value) {
        job.margin = length(value, job, job.margin);
        job.measure = job.W - job.margin * 2;
      }
      if (PAPER[key]) {
        job.paper = key;
        [job.W, job.H] = PAPER[key];
        job.measure = job.W - job.margin * 2;
      }
    }
  }

  // -------------------------------------------------------------------- run

  /** One pass over the project. What comes back is a PDF and everything the
   *  next pass would need to know: where the labels landed, what the contents
   *  should say, how many pages there were. */
  function run(project, options = {}) {
    const log = [];
    const job = createJob({
      base: 10,
      log,
      images: options.images || {},
      files: project.files,
      refs: options.refs || {},
    });
    job.bib = options.bib || {};
    job.previousToc = options.toc || [];
    job.reading = [];
    job.line = 1;
    job.file = project.main;
    job.groups = [];

    const main = project.files.find((one) => one.name === project.main) || project.files[0];
    if (!main) throw new Error('there is no file to typeset');

    const reader = new T.lex.Reader(T.lex.tokenize(main.text, main.name), job.macros);
    process(job, reader);
    endParagraph(job);
    finishPage(job);

    job.doc.meta.title = T.lex.plain(job.titleTokens || []) || project.main;
    job.doc.meta.author = T.lex.plain(job.authorTokens || []);
    job.doc.outlineFrom(job.outline);

    if (!job.started) {
      say(job, 'error', 'There is no \\begin{document} — nothing was set', 1, project.main);
    }

    return {
      doc: job.doc,
      log,
      labels: job.labels,
      toc: job.toc,
      pages: job.doc.pageCount(),
    };
  }

  T.type = { run, PAPER, length };
})();
</script>

<script data-marble-id="__ID__">
// ---------------------------------------------------------------- compiling
//
// Twice, like the real thing, and for the same reason: a cross-reference
// cannot know what page it is pointing at until the pages exist. The first
// pass is thrown away except for what it learned — where the labels landed,
// what the contents should say — and the second is the PDF you get.

(() => {
  const T = window.TeX;

  /** A .bib file, as entries. Values may be braced, quoted or bare. */
  function parseBib(text) {
    const entries = {};
    let i = 0;
    while (i < text.length) {
      const at = text.indexOf('@', i);
      if (at === -1) break;
      const open = text.indexOf('{', at);
      if (open === -1) break;
      const type = text.slice(at + 1, open).trim().toLowerCase();
      if (type === 'comment' || type === 'preamble') { i = open + 1; continue; }

      let depth = 1;
      let j = open + 1;
      while (j < text.length && depth) {
        if (text[j] === '{') depth += 1;
        if (text[j] === '}') depth -= 1;
        j += 1;
      }
      const body = text.slice(open + 1, j - 1);
      const comma = body.indexOf(',');
      const key = (comma === -1 ? body : body.slice(0, comma)).trim();
      const fields = {};

      let k = comma + 1;
      while (comma !== -1 && k < body.length) {
        const equals = body.indexOf('=', k);
        if (equals === -1) break;
        const name = body.slice(k, equals).trim().toLowerCase().replace(/^,/, '').trim();
        let v = equals + 1;
        while (v < body.length && /\s/.test(body[v])) v += 1;
        let value = '';
        if (body[v] === '{') {
          let level = 1;
          const from = v + 1;
          v += 1;
          while (v < body.length && level) {
            if (body[v] === '{') level += 1;
            if (body[v] === '}') level -= 1;
            v += 1;
          }
          value = body.slice(from, v - 1);
        } else if (body[v] === '"') {
          const from = v + 1;
          v += 1;
          while (v < body.length && body[v] !== '"') v += 1;
          value = body.slice(from, v);
          v += 1;
        } else {
          const from = v;
          while (v < body.length && body[v] !== ',') v += 1;
          value = body.slice(from, v).trim();
        }
        if (name) fields[name] = value.replace(/\s+/g, ' ').trim();
        const next = body.indexOf(',', v);
        if (next === -1) break;
        k = next + 1;
      }
      if (key) entries[key] = { key, type, fields };
      i = j;
    }
    return entries;
  }

  const surname = (author) => {
    const first = String(author || '').split(/\s+and\s+/)[0] || '';
    if (first.includes(',')) return first.split(',')[0].trim().toLowerCase();
    const words = first.trim().split(/\s+/);
    return (words[words.length - 1] || '').toLowerCase();
  };

  /** Which entries are cited, and what number each of them gets. Numbering is
   *  settled before anything is set, so a \cite that comes before the
   *  bibliography still knows its number on the first pass. */
  function numbering(project) {
    const sources = project.files.filter((file) => file.kind !== 'bib' && file.kind !== 'img');
    const text = sources.map((file) => file.text).join('\n');

    const cited = [];
    for (const match of text.matchAll(/\\(?:no)?cite[tp]?\s*(?:\[[^\]]*\])?\{([^}]*)\}/g)) {
      for (const key of match[1].split(',')) {
        const clean = key.trim();
        if (clean && !cited.includes(clean)) cited.push(clean);
      }
    }

    const bib = {};
    const manual = [...text.matchAll(/\\bibitem\s*(?:\[[^\]]*\])?\{([^}]*)\}/g)].map((m) => m[1].trim());
    if (manual.length) {
      manual.forEach((key, i) => { bib[key] = { number: i + 1 }; });
      return bib;
    }

    const known = {};
    for (const file of project.files) {
      if (file.kind === 'bib' || /\.bib$/.test(file.name)) Object.assign(known, parseBib(file.text));
    }

    // The plain style: alphabetical by the first author's surname.
    const wanted = cited.filter((key) => known[key]);
    wanted.sort((a, b) => {
      const left = surname(known[a].fields.author || known[a].fields.editor);
      const right = surname(known[b].fields.author || known[b].fields.editor);
      if (left !== right) return left < right ? -1 : 1;
      return (known[a].fields.year || '') < (known[b].fields.year || '') ? -1 : 1;
    });
    wanted.forEach((key, i) => { bib[key] = { number: i + 1, fields: known[key].fields, type: known[key].type }; });
    for (const key of cited) if (!bib[key]) bib[key] = { number: '?' };
    return bib;
  }

  function compile(project, { images = {} } = {}) {
    const started = Date.now();
    const bib = numbering(project);

    const first = T.type.run(project, { bib, images });
    const second = T.type.run(project, {
      bib, images, refs: first.labels, toc: first.toc,
    });

    return {
      bytes: second.doc.bytes(),
      pages: second.pages,
      log: second.log,
      labels: second.labels,
      ms: Date.now() - started,
    };
  }

  T.compile = compile;
  T.parseBib = parseBib;
})();
</script>

<script data-marble-id="__ID__">
// ------------------------------------------------------------------ the room
//
// Everything below is about the page rather than the paper: which file is
// open, what the source looks like in colour, where the PDF goes. Two rules
// hold it together.
//
// One fact, one place. The source is the <pre>; the colouring, the line
// numbers, the file list and the PDF are all derived from it and marked as the
// page's, so nothing here can disagree with the file.
//
// And every switch is an attribute. Which file is open, how the panes are
// split, whether it typesets as you type — each is one attribute on the shell,
// so each is one setAttr, and closing the tab does not forget any of them.

(() => {
  const app = document.querySelector('#app');
  const filesEl = document.querySelector('#files');
  const railList = document.querySelector('#railfiles');
  const frame = document.querySelector('#pdfframe');
  const curtain = document.querySelector('#curtain');
  const pill = document.querySelector('#logpill');
  const summary = document.querySelector('#logsummary');
  const logbody = document.querySelector('#logbody');
  const pdfnote = document.querySelector('#pdfnote');
  const compileBtn = document.querySelector('#compile');

  const $$ = (selector, root = document) => [...root.querySelectorAll(selector)];
  const esc = (text) => String(text).replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));

  const sections = () => $$('#files > .file');
  const kindOf = (section) => section.getAttribute('data-kind') || 'tex';
  const nameOf = (section) => (section.querySelector('.fname')?.textContent || '').trim();
  const preOf = (section) => section.querySelector('.src');
  const textOf = (section) => (preOf(section) ? preOf(section).textContent : '');
  const keyOf = (section) => section.getAttribute('data-key');

  let carrier = null;
  let pdfUrl = null;
  let lastPdf = null;
  let autoTimer = null;
  let wired = new WeakSet();

  // --------------------------------------------------------------- the file

  /** The project as the engine wants it: names, kinds and text. The main file
   *  is the one that says \documentclass, because that is what makes it main. */
  function project() {
    const files = sections().map((section) => ({
      name: nameOf(section),
      kind: kindOf(section),
      text: textOf(section),
    }));
    const tex = files.filter((file) => file.kind === 'tex');
    const main =
      tex.find((file) => /\\documentclass/.test(file.text)) ||
      tex.find((file) => /^main\.tex$/i.test(file.name)) ||
      tex[0] || files[0];
    return { files, main: main ? main.name : '' };
  }

  function activeSection() {
    const key = app.getAttribute('data-active');
    return sections().find((section) => keyOf(section) === key) || sections()[0] || null;
  }

  function setState(name, value) {
    app.setAttribute(name, value);
    derive();
    const id = carrier && carrier.id(app);
    if (!id) return;
    carrier.op({ type: 'setAttr', id, name, value }, { immediate: true });
  }

  // ------------------------------------------------------------- colouring

  const TOKENS = /(%.*$)|(@[A-Za-z]+)|(\\[A-Za-z@]+\*?|\\.)|([{}])|(\$[^$]*\$?)|(\b\d+(?:\.\d+)?\b)/g;

  function colour(line) {
    let out = '';
    let at = 0;
    TOKENS.lastIndex = 0;
    for (;;) {
      const match = TOKENS.exec(line);
      if (!match) break;
      out += esc(line.slice(at, match.index));
      const kind = match[1] ? 'com' : match[2] ? 'cs' : match[3] ? 'cs' : match[4] ? 'brc' : match[5] ? 'mth' : 'num';
      out += `<span class="${kind}">${esc(match[0])}</span>`;
      at = match.index + match[0].length;
    }
    return out + esc(line.slice(at));
  }

  /** The colouring and the gutter, drawn behind the text they are of. The
   *  editable <pre> holds nothing but characters, which is what keeps the
   *  file plain and the diff readable. */
  function paint(pre) {
    const box = pre.parentElement;
    const layer = box && box.querySelector('.hl');
    if (!layer) return;
    const lines = pre.textContent.split('\n');
    layer.innerHTML = lines
      .map((line, i) => `<span class="ln"><i class="n">${i + 1}</i>${colour(line)}</span>`)
      .join('');
    const meta = pre.closest('.file')?.querySelector('.fmeta');
    if (meta) meta.textContent = `${lines.length} line${lines.length === 1 ? '' : 's'}`;
  }

  // ------------------------------------------------------ the editable code

  function caretAt(el) {
    const selection = window.getSelection();
    if (!selection || !selection.rangeCount) return null;
    const range = selection.getRangeAt(0);
    if (!el.contains(range.endContainer)) return null;
    const measure = range.cloneRange();
    measure.selectNodeContents(el);
    measure.setEnd(range.endContainer, range.endOffset);
    return measure.toString().length;
  }

  function putCaret(el, offset) {
    const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
    let seen = 0;
    let node = walker.nextNode();
    while (node) {
      if (seen + node.length >= offset) {
        const range = document.createRange();
        range.setStart(node, Math.max(0, offset - seen));
        range.collapse(true);
        const selection = window.getSelection();
        selection.removeAllRanges();
        selection.addRange(range);
        return;
      }
      seen += node.length;
      node = walker.nextNode();
    }
  }

  /** A paste, or a browser that answers Enter with markup, can leave elements
   *  in a <pre> that is supposed to hold text. Flatten them, and put the caret
   *  back where the typing left it. */
  function flatten(pre) {
    if (!pre.firstElementChild) return;
    const offset = caretAt(pre);
    let text = '';
    for (const node of pre.childNodes) {
      if (node.nodeType === 3) text += node.nodeValue;
      else if (node.nodeName === 'BR') text += '\n';
      else text += (text.endsWith('\n') || !text ? '' : '\n') + node.textContent;
    }
    pre.textContent = text;
    if (offset !== null) putCaret(pre, offset);
  }

  function wireCode(pre) {
    if (wired.has(pre)) return;
    wired.add(pre);
    pre.setAttribute('contenteditable', 'plaintext-only');
    if (pre.contentEditable !== 'plaintext-only') pre.setAttribute('contenteditable', 'true');
    pre.spellcheck = false;

    let before = null;
    pre.addEventListener('focus', () => { before = pre.textContent; });
    pre.addEventListener('blur', () => { before = null; if (carrier) carrier.flush(); });

    pre.addEventListener('input', () => {
      flatten(pre);
      paint(pre);
      const id = carrier && carrier.id(pre);
      if (id) {
        const text = pre.textContent;
        const op = { type: 'setText', id, text };
        if (before !== null && before !== text) {
          carrier.record({ redo: [op], undo: [{ type: 'setText', id, text: before }] }, { coalesce: true });
        }
        carrier.op(op);
      }
      queueCompile();
    });

    pre.addEventListener('keydown', (event) => {
      if (event.key === 'Tab') {
        event.preventDefault();
        document.execCommand('insertText', false, '  ');
        return;
      }
      if (event.key === 'Enter') {
        // Keep the indentation of the line being left, the way an editor does.
        const offset = caretAt(pre);
        if (offset === null) return;
        const upto = pre.textContent.slice(0, offset);
        const indent = (/(^|\n)([ \t]*)[^\n]*$/.exec(upto) || [])[2] || '';
        if (!indent) return;
        event.preventDefault();
        document.execCommand('insertText', false, `\n${indent}`);
      }
    });
  }

  function wire(root) {
    const scope = root && root.querySelectorAll ? root : document;
    const list = [
      ...(scope.matches && scope.matches('[data-marble-code]') ? [scope] : []),
      ...$$('[data-marble-code]', scope),
    ];
    for (const pre of list) { wireCode(pre); paint(pre); }
    if (list.length) derive();
  }

  // --------------------------------------------------------------- the rail

  let railSignature = '';

  function derive() {
    const active = (activeSection() && keyOf(activeSection())) || '';
    for (const section of sections()) {
      section.classList.toggle('marble-open', keyOf(section) === active);
    }
    const signature = sections().map((s) => `${keyOf(s)}:${kindOf(s)}:${nameOf(s)}`).join('|') + `#${active}`;
    if (signature === railSignature) return;
    railSignature = signature;
    railList.innerHTML = sections()
      .map((section) => {
        const kind = kindOf(section);
        const glyph = kind === 'bib' ? '❞' : kind === 'img' ? '▣' : '≡';
        const open = keyOf(section) === active ? ' marble-open' : '';
        return (
          `<li class="frow${open}" data-key="${keyOf(section)}">` +
          `<span class="glyph">${glyph}</span><span class="fn">${esc(nameOf(section))}</span>` +
          `<button class="kill" title="Delete this file">×</button></li>`
        );
      })
      .join('');
    for (const button of $$('.btn[data-set-layout]')) {
      button.setAttribute('aria-pressed', String(button.getAttribute('data-set-layout') === app.getAttribute('data-layout')));
    }
    const auto = document.querySelector('#toggle-auto');
    if (auto) auto.setAttribute('aria-pressed', String(app.getAttribute('data-auto') === 'on'));
  }

  // ------------------------------------------------------------- the images

  function bytesFromDataUrl(url) {
    const raw = atob(url.slice(url.indexOf(',') + 1));
    const out = new Uint8Array(raw.length);
    for (let i = 0; i < raw.length; i += 1) out[i] = raw.charCodeAt(i);
    return out;
  }

  function raster(image) {
    const cap = 1400;
    const scale = Math.min(1, cap / Math.max(image.naturalWidth, image.naturalHeight));
    const width = Math.max(1, Math.round(image.naturalWidth * scale));
    const height = Math.max(1, Math.round(image.naturalHeight * scale));
    const canvas = document.createElement('canvas');
    canvas.width = width;
    canvas.height = height;
    const context = canvas.getContext('2d');
    context.fillStyle = '#ffffff';
    context.fillRect(0, 0, width, height);
    context.drawImage(image, 0, 0, width, height);
    const pixels = context.getImageData(0, 0, width, height).data;
    const data = new Uint8Array(width * height * 3);
    for (let i = 0, o = 0; i < pixels.length; i += 4) {
      data[o] = pixels[i]; data[o + 1] = pixels[i + 1]; data[o + 2] = pixels[i + 2];
      o += 3;
    }
    return { width, height, data, kind: 'rgb' };
  }

  async function images() {
    const out = {};
    let n = 0;
    for (const section of sections()) {
      if (kindOf(section) !== 'img') continue;
      const element = section.querySelector('img');
      if (!element || !element.getAttribute('src')) continue;
      if (!element.complete) {
        await new Promise((done) => { element.onload = done; element.onerror = done; });
      }
      n += 1;
      const name = nameOf(section);
      const src = element.getAttribute('src');
      const jpeg = /^data:image\/jpe?g/i.test(src);
      const spec = jpeg
        ? { kind: 'jpeg', width: element.naturalWidth, height: element.naturalHeight, data: bytesFromDataUrl(src) }
        : raster(element);
      spec.id = `Im${n}`;
      out[name] = spec;
      out[name.replace(/\.[^.]+$/, '')] = spec;
    }
    return out;
  }

  // ------------------------------------------------------------ typesetting

  function report(result, error) {
    const lines = [];
    if (error) lines.push({ level: 'error', message: error.message || String(error) });
    for (const entry of result ? result.log : []) lines.push(entry);

    // The same complaint forty times is one complaint with a count on it.
    const seen = new Map();
    for (const line of lines) {
      const key = `${line.level}|${line.message}|${line.file}|${line.line}`;
      if (seen.has(key)) seen.get(key).times += 1;
      else seen.set(key, { ...line, times: 1 });
    }
    const shown = [...seen.values()];

    logbody.innerHTML = shown.length
      ? shown
          .map((line) => {
            const at = line.line ? `${line.file || ''} ${line.line}` : '';
            return (
              `<div class="logline" data-level="${line.level}" data-file="${esc(line.file || '')}" data-line="${line.line || ''}">` +
              `<span class="at">${esc(at)}</span>` +
              `<span class="what">${esc(line.message)}${line.times > 1 ? ` <b>×${line.times}</b>` : ''}</span></div>`
            );
          })
          .join('')
      : '<div class="logline" data-level="info"><span class="at"></span><span class="what">No errors, no warnings.</span></div>';

    const errors = shown.filter((line) => line.level === 'error').length;
    const warnings = shown.filter((line) => line.level === 'warning').length;
    pill.setAttribute('data-state', errors ? 'bad' : warnings ? 'warn' : 'ok');
    pill.textContent = errors ? `${errors} error${errors === 1 ? '' : 's'}` : warnings ? `${warnings} warning${warnings === 1 ? '' : 's'}` : 'ok';
    summary.textContent = result
      ? `${result.pages} page${result.pages === 1 ? '' : 's'} typeset in ${result.ms} ms`
      : 'The run stopped before any page was finished.';
    if (errors && app.getAttribute('data-log') === 'closed') setState('data-log', 'open');
  }

  function show() {
    if (!pdfUrl) return;
    const zoom = app.getAttribute('data-zoom') || 'page-width';
    frame.setAttribute('src', `${pdfUrl}#zoom=${zoom}&navpanes=0&view=FitH`);
    curtain.setAttribute('hidden', '');
  }

  async function recompile() {
    if (!window.TeX || !window.TeX.compile) return;
    compileBtn.setAttribute('data-busy', '1');
    pill.setAttribute('data-state', 'idle');
    pill.textContent = 'running';
    await new Promise((done) => setTimeout(done, 0));
    try {
      const result = window.TeX.compile(project(), { images: await images() });
      const blob = new Blob([result.bytes], { type: 'application/pdf' });
      if (pdfUrl) URL.revokeObjectURL(pdfUrl);
      pdfUrl = URL.createObjectURL(blob);
      lastPdf = blob;
      show();
      pdfnote.textContent = `${result.pages} page${result.pages === 1 ? '' : 's'} · ${Math.round(result.bytes.length / 1024)} kB`;
      report(result, null);
    } catch (err) {
      report(null, err);
      pdfnote.textContent = 'the run stopped';
      if (window.console) window.console.error(err);
    } finally {
      compileBtn.removeAttribute('data-busy');
    }
  }

  function queueCompile() {
    if (app.getAttribute('data-auto') !== 'on') return;
    clearTimeout(autoTimer);
    autoTimer = setTimeout(recompile, 900);
  }

  function download(blob, filename) {
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement('a');
    anchor.href = url;
    anchor.download = filename;
    document.body.append(anchor);
    anchor.click();
    anchor.remove();
    setTimeout(() => URL.revokeObjectURL(url), 4000);
  }

  const projectName = () => (document.querySelector('.title')?.textContent || 'project').trim().replace(/[^\w. -]+/g, '') || 'project';

  // ------------------------------------------------------------- the making

  const freshId = () => (carrier ? carrier.newId() : Math.random().toString(16).slice(2, 10));

  function sectionMarkup({ name, kind, text, src }) {
    const key = `k${Math.random().toString(36).slice(2, 8)}`;
    const body = kind === 'img'
      ? `<div class="shot" data-marble-id="${freshId()}"><img data-marble-id="${freshId()}" alt="${esc(name)}" src="${src}"></div>`
      : `<div class="codewrap" data-marble-id="${freshId()}"><div class="codebox" data-marble-id="${freshId()}">` +
        `<pre class="hl" data-marble-transient aria-hidden="true"></pre>` +
        `<pre class="src" data-marble-id="${freshId()}" data-marble-code>${esc(text || '')}</pre></div></div>`;
    return (
      `<section class="file" data-marble-id="${freshId()}" data-key="${key}" data-kind="${kind}">` +
      `<header class="fhead" data-marble-id="${freshId()}">` +
      `<h3 class="fname" data-marble-id="${freshId()}" data-marble-editable>${esc(name)}</h3>` +
      `<span class="fmeta" data-marble-transient></span></header>${body}</section>`
    );
  }

  function addFile(spec) {
    const html = sectionMarkup(spec);
    const parentId = carrier && carrier.id(filesEl);
    const op = { type: 'insert', parentId, beforeId: null, html };
    if (carrier && parentId) {
      // One op, used twice: it moves the page and it is what gets written down.
      carrier.apply(op);
      carrier.op(op);
    } else {
      filesEl.insertAdjacentHTML('beforeend', html);
      wire(filesEl.lastElementChild);
    }
    const added = filesEl.lastElementChild;
    setState('data-active', keyOf(added));
    derive();
    return added;
  }

  function removeFile(section) {
    if (sections().length < 2) return;
    const wasOpen = section.classList.contains('marble-open');
    const id = carrier && carrier.id(section);
    const op = { type: 'remove', id };
    if (carrier && id) { carrier.apply(op); carrier.op(op); }
    else section.remove();
    if (wasOpen && sections()[0]) setState('data-active', keyOf(sections()[0]));
    derive();
  }

  // -------------------------------------------------------------- the wires

  document.addEventListener('click', (event) => {
    const target = event.target;

    const row = target.closest && target.closest('.frow');
    if (row) {
      if (target.closest('.kill')) {
        const section = sections().find((one) => keyOf(one) === row.getAttribute('data-key'));
        if (section) removeFile(section);
        return;
      }
      setState('data-active', row.getAttribute('data-key'));
      return;
    }

    const layout = target.closest && target.closest('[data-set-layout]');
    if (layout) { setState('data-layout', layout.getAttribute('data-set-layout')); return; }

    const zoom = target.closest && target.closest('[data-set-zoom]');
    if (zoom) {
      const how = zoom.getAttribute('data-set-zoom');
      const now = app.getAttribute('data-zoom');
      const percent = Number(now) || 100;
      const next = how === 'page-width' ? 'page-width' : String(Math.max(25, Math.min(400, percent + (how === 'in' ? 25 : -25))));
      setState('data-zoom', next);
      show();
      return;
    }

    const line = target.closest && target.closest('.logline');
    if (line && line.getAttribute('data-line')) { jump(line.getAttribute('data-file'), Number(line.getAttribute('data-line'))); return; }

    if (target.closest && target.closest('#loghead')) {
      setState('data-log', app.getAttribute('data-log') === 'open' ? 'closed' : 'open');
      return;
    }
    if (target.closest && target.closest('#toggle-rail')) {
      setState('data-rail', app.getAttribute('data-rail') === 'open' ? 'closed' : 'open');
      return;
    }
    if (target.closest && target.closest('#toggle-auto')) {
      setState('data-auto', app.getAttribute('data-auto') === 'on' ? 'off' : 'on');
      return;
    }
    if (target.closest && target.closest('#compile')) { recompile(); return; }
    if (target.closest && target.closest('#get-pdf')) {
      if (lastPdf) download(lastPdf, `${projectName()}.pdf`);
      else recompile().then(() => lastPdf && download(lastPdf, `${projectName()}.pdf`));
      return;
    }
    if (target.closest && target.closest('#get-tex')) {
      const section = activeSection();
      if (section) download(new Blob([textOf(section)], { type: 'text/plain' }), nameOf(section) || 'main.tex');
      return;
    }
    if (target.closest && target.closest('#new-tex')) { addFile({ name: 'section.tex', kind: 'tex', text: '% A new file. \\input{section} pulls it into the main one.\n' }); return; }
    if (target.closest && target.closest('#new-bib')) { addFile({ name: 'more.bib', kind: 'bib', text: '@article{key2026,\n  author = {},\n  title  = {},\n  year   = {}\n}\n' }); return; }
  });

  function jump(file, line) {
    const section = sections().find((one) => nameOf(one) === file) || activeSection();
    if (!section) return;
    if (!section.classList.contains('marble-open')) setState('data-active', keyOf(section));
    const layer = section.querySelector('.hl');
    const wrap = section.querySelector('.codewrap');
    if (!layer || !wrap) return;
    for (const marked of $$('.ln.marble-hot', layer)) marked.classList.remove('marble-hot');
    const row = layer.children[line - 1];
    if (!row) return;
    row.classList.add('marble-hot');
    wrap.scrollTop = Math.max(0, row.offsetTop - wrap.clientHeight / 3);
  }

  document.addEventListener('keydown', (event) => {
    const meta = event.metaKey || event.ctrlKey;
    if (!meta) return;
    if (event.key === 'Enter' || event.key.toLowerCase() === 's') {
      event.preventDefault();
      recompile();
      return;
    }
    if (event.key.toLowerCase() === 'b') {
      event.preventDefault();
      setState('data-rail', app.getAttribute('data-rail') === 'open' ? 'closed' : 'open');
    }
  });

  // The divider is a gesture that changes the file, like every other one here:
  // it moves while you drag and files one setAttr when you let go.
  const grabber = document.querySelector('#grabber');
  if (grabber) {
    grabber.addEventListener('pointerdown', (event) => {
      event.preventDefault();
      grabber.setPointerCapture(event.pointerId);
      grabber.setAttribute('data-dragging', '1');
      const main = document.querySelector('.main');
      const move = (moved) => {
        const box = main.getBoundingClientRect();
        const rail = document.querySelector('.rail').getBoundingClientRect().width;
        const percent = ((moved.clientX - box.left - rail) / (box.width - rail)) * 100;
        app.setAttribute('style', `--split:${Math.max(18, Math.min(82, percent)).toFixed(1)}%`);
      };
      const done = () => {
        grabber.removeAttribute('data-dragging');
        grabber.removeEventListener('pointermove', move);
        grabber.removeEventListener('pointerup', done);
        const id = carrier && carrier.id(app);
        if (id) carrier.op({ type: 'setAttr', id, name: 'style', value: app.getAttribute('style') }, { immediate: true });
      };
      grabber.addEventListener('pointermove', move);
      grabber.addEventListener('pointerup', done);
    });
  }

  // An image dropped on the window becomes a file in the project, which is
  // what \includegraphics then finds.
  app.addEventListener('dragover', (event) => {
    if ([...(event.dataTransfer?.types || [])].includes('Files')) event.preventDefault();
  });
  app.addEventListener('drop', async (event) => {
    const dropped = [...(event.dataTransfer?.files || [])].filter((file) => /^image\//.test(file.type));
    if (!dropped.length) return;
    event.preventDefault();
    for (const file of dropped) {
      const src = await new Promise((done) => {
        const reader = new FileReader();
        reader.onload = () => done(reader.result);
        reader.readAsDataURL(file);
      });
      addFile({ name: file.name, kind: 'img', src });
    }
  });

  // The rail is derived, so it is rebuilt whenever what it is derived from
  // moves — a rename, a new file, an edit made in another tab.
  let pending = null;
  new MutationObserver(() => {
    if (pending) return;
    pending = requestAnimationFrame(() => { pending = null; derive(); });
  }).observe(filesEl, { childList: true, subtree: true, characterData: true });

  new MutationObserver(derive).observe(app, {
    attributes: true,
    attributeFilter: ['data-active', 'data-layout', 'data-auto', 'data-log', 'data-rail'],
  });

  const begin = (marble) => {
    carrier = marble;
    // The editor writes these onto the <pre> to make it typeable; they are the
    // page's business and must never reach the file.
    marble.pageOnly('contenteditable', 'spellcheck', 'aria-pressed', 'data-busy', 'hidden');
    marble.register(wire);
  };

  if (window.marble) begin(window.marble);
  else window.addEventListener('marble:ready', (event) => begin(event.detail), { once: true });

  wire(document.body);
  derive();
  setTimeout(recompile, 120);
})();
</script>

__SCRIPT__
</body>
</html>
