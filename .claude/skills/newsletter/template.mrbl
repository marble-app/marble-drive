<!doctype html>
<html lang="en" data-marble="1">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="marble:capabilities" content="storage; net=none">
<meta name="newsletter:date" content="__DATE__">
<meta name="newsletter:palette" content="__PALETTE_NAME__">
<title>Bryan's Bulletin</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23c98a3c'/%3E%3Cg fill='%23fff' fill-opacity='.92'%3E%3Ccircle cx='9' cy='10' r='2.4'/%3E%3Ccircle cx='16' cy='10' r='2.4'/%3E%3Ccircle cx='23' cy='10' r='2.4'/%3E%3Crect x='6.6' y='16' width='18.8' height='2.6' rx='1.3'/%3E%3Crect x='6.6' y='21' width='13' height='2.6' rx='1.3'/%3E%3C/g%3E%3C/svg%3E">
<style id="nl-base">
  :root {
    --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif;
    --font-serif: "Iowan Old Style", "Palatino Linotype", Palatino, "Book Antiqua", Georgia, "Times New Roman", serif;
    /* Fallback palette — replaced per-issue by the nl-palette stylesheet below. */
    --bg: #f7f4ec; --panel: #fdfbf4; --ink: #2b2926; --muted: #7c756c;
    --faint: #b3ab9f; --line: #e9e2d4; --accent: #6f8f7d; --accent-soft: #eef2ee;
    --accent-ink: #4d6a58; --warm: #c98a3c;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0; padding: 2.4rem 1.4rem 6rem; background: var(--bg); color: var(--ink);
    font: 16px/1.62 var(--font-sans); -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  .wrap { max-width: 60rem; margin: 0 auto; }
  a { color: var(--accent-ink); text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: 2px; }
  h2, h3 { font-family: var(--font-serif); font-weight: 600; }

  /* ---------- masthead ---------- */
  .masthead { position: relative; margin-bottom: 2.4rem; }
  .swatches {
    position: absolute; top: .1rem; left: 0; display: flex; align-items: flex-start; gap: .5rem;
  }
  .swatches .chips { display: grid; grid-template-columns: 12px 12px; grid-auto-rows: 12px; gap: 2px; }
  .swatches .chips i { display: block; width: 12px; height: 12px; border-radius: 2px; }
  .swatches .pname {
    font: 500 10px/1.5 var(--font-sans); letter-spacing: .04em; text-transform: uppercase;
    color: var(--faint); max-width: 8rem;
  }
  .masthead .date {
    margin: 0 0 .1rem; padding-left: 3.9rem;
    font: 600 .78rem/1.5 var(--font-sans); letter-spacing: .12em; text-transform: uppercase;
    color: var(--muted);
  }
  .masthead .greeting {
    font-family: var(--font-serif); font-size: 2.05rem; line-height: 1.15; letter-spacing: -.01em;
    margin: .15rem 0 .5rem; color: var(--ink); font-weight: 600;
  }
  .masthead .summary { margin: 0; max-width: 44rem; color: var(--ink); font-size: 1.02rem; }
  .masthead .summary + .summary { margin-top: .5rem; }
  .glance {
    margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 1.4rem;
    font-size: .9rem; color: var(--muted);
  }
  .glance b { color: var(--ink); font-weight: 700; font-variant-numeric: tabular-nums; }

  /* ---------- dashboard grid ---------- */
  .dash { display: grid; grid-template-columns: repeat(12, 1fr); gap: 2.2rem 2rem; }
  .panel { grid-column: span 12; min-width: 0; }
  .col-4 { grid-column: span 4; } .col-5 { grid-column: span 5; }
  .col-6 { grid-column: span 6; } .col-7 { grid-column: span 7; }
  .col-8 { grid-column: span 8; }
  @media (max-width: 46rem) { .panel { grid-column: span 12 !important; } }

  .panel > h2 {
    font-size: 1.12rem; margin: 0 0 .1rem; letter-spacing: -.005em; color: var(--ink);
    display: flex; align-items: baseline; gap: .5rem;
  }
  .panel > h2 .count {
    font: 500 .74rem/1 var(--font-sans); color: var(--muted); font-variant-numeric: tabular-nums;
  }
  .panel > .sub { margin: .1rem 0 .9rem; font-size: .82rem; color: var(--muted); }
  .panel > .pbody { margin-top: .7rem; }

  /* soft tinted card — used sparingly, never a border */
  .soft { background: var(--accent-soft); border-radius: 14px; padding: 1rem 1.1rem; }
  .tint { background: var(--panel); border-radius: 14px; padding: 1rem 1.1rem; }

  /* ---------- list rows: hairlines, not boxes ---------- */
  ol.list, ul.list { list-style: none; margin: 0; padding: 0; }
  li.row {
    display: grid; grid-template-columns: auto 1fr auto; gap: .7rem; align-items: start;
    padding: .7rem .25rem; border-top: 1px solid var(--line);
  }
  li.row:first-child { border-top: 0; }
  li.row:hover { background: color-mix(in srgb, var(--accent-soft) 55%, transparent); border-radius: 8px; }
  li.row .body { min-width: 0; }
  li.row .title { font-size: .97rem; line-height: 1.4; }
  li.row .meta { font-size: .8rem; color: var(--muted); margin-top: .1rem; }
  li.row .why { font-size: .87rem; color: var(--accent-ink); margin-top: .25rem; }
  li.row .note { font-size: .86rem; color: var(--muted); margin-top: .35rem; min-height: 1em; }
  li.row .note:empty::before { content: "note\2026"; color: var(--faint); }

  .tag {
    display: inline-block; font: 600 .62rem/1.5 var(--font-sans); letter-spacing: .06em;
    text-transform: uppercase; color: var(--accent-ink);
    background: var(--accent-soft); padding: .1rem .45rem; border-radius: 999px; white-space: nowrap;
  }
  .when-pill {
    font: 700 .82rem/1 var(--font-sans); color: var(--accent-ink); font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .when-pill small { font-weight: 500; color: var(--muted); }
  [data-soon] .when-pill { color: var(--warm); }

  /* round soft checkbox */
  .chk {
    appearance: none; width: 1.15rem; height: 1.15rem; margin-top: .15rem; padding: 0;
    border: 1.5px solid var(--faint); border-radius: 50%; background: none; cursor: pointer;
    color: var(--bg); font-size: .78rem; line-height: 1; flex: none; transition: background .12s;
  }
  [data-done] .chk { background: var(--accent); border-color: var(--accent); }
  [data-done] .chk::after { content: "\2713"; }
  [data-done] .title { text-decoration: line-through; color: var(--muted); }
  [data-done] { opacity: .55; }
  [data-snooze] .title::after { content: "  \00b7 tomorrow"; color: var(--faint); font-size: .8rem; }
  [data-pin] { background: color-mix(in srgb, var(--accent-soft) 70%, transparent); border-radius: 8px; }

  .acts { display: flex; gap: .05rem; align-items: start; }
  .act {
    appearance: none; border: 0; background: none; cursor: pointer; color: var(--faint);
    font-size: .9rem; line-height: 1; padding: .18rem .28rem; border-radius: 6px;
  }
  .act:hover { color: var(--ink); background: color-mix(in srgb, var(--faint) 22%, transparent); }
  [data-vote="up"] .act-up { color: var(--accent); }
  [data-vote="down"] .act-down { color: var(--warm); }
  [data-saved] .act-save { color: var(--warm); }
  [data-pin] .act-pin { color: var(--accent); }

  /* ---------- expandable ---------- */
  .exp-toggle {
    appearance: none; border: 0; background: none; cursor: pointer; color: var(--accent-ink);
    font: 600 .78rem/1 var(--font-sans); padding: .35rem 0 0; display: inline-flex; align-items: center; gap: .3rem;
  }
  .exp-toggle::before { content: "+"; font-size: .95rem; }
  [data-open] > .body .exp-toggle::before, [data-open] .exp-toggle::before { content: "\2013"; }
  .expandable:not([data-open]) .exp-body { display: none; }
  .exp-body {
    margin-top: .55rem; font-size: .9rem; color: var(--ink); line-height: 1.6;
  }
  .exp-body .abstract { color: var(--muted); }
  .exp-body .authors { color: var(--muted); font-size: .82rem; margin-top: .4rem; }
  .exp-body figure { margin: .6rem 0 0; }
  .exp-body img { display: block; max-width: 100%; border-radius: 10px; }
  .exp-body figcaption { font-size: .74rem; color: var(--faint); margin-top: .3rem; }

  /* ---------- view toggle (list / calendar) ---------- */
  .switch { display: inline-flex; gap: .2rem; margin: 0 0 .2rem auto; }
  .switch button {
    appearance: none; border: 0; background: none; cursor: pointer;
    font: 600 .76rem/1 var(--font-sans); color: var(--muted); padding: .3rem .55rem; border-radius: 999px;
  }
  .viewbox[data-view="list"] .switch [data-setview="list"],
  .viewbox[data-view="cal"]  .switch [data-setview="cal"] { background: var(--accent-soft); color: var(--accent-ink); }
  .viewbox[data-view="list"] .v-cal { display: none; }
  .viewbox[data-view="cal"] .v-list { display: none; }

  /* ---------- calendar ---------- */
  .cal { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; }
  @media (max-width: 40rem) { .cal { grid-template-columns: 1fr; } }
  .cal-m h4 { font: 600 .8rem/1 var(--font-sans); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 0 0 .5rem; }
  .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; }
  .cal-grid .dow { font: 600 .6rem/1 var(--font-sans); color: var(--faint); text-align: center; padding-bottom: 2px; }
  .cal-grid .cell {
    aspect-ratio: 1; border-radius: 7px; padding: .2rem; font: 500 .72rem/1 var(--font-sans);
    color: var(--muted); font-variant-numeric: tabular-nums; position: relative;
  }
  .cal-grid .cell.pad { visibility: hidden; }
  .cal-grid .cell.today { outline: 1.5px solid var(--accent); }
  .cal-grid .cell.ev { background: var(--accent-soft); color: var(--accent-ink); font-weight: 700; }
  .cal-grid .cell.ev.soon { background: color-mix(in srgb, var(--warm) 20%, transparent); color: var(--warm); }
  .cal-grid .cell .lbl {
    position: absolute; left: 0; right: 0; bottom: .12rem; font-size: .5rem; line-height: 1.05;
    text-align: center; overflow: hidden; max-height: 1.9em; padding: 0 1px; font-weight: 600;
  }

  /* ---------- weather ---------- */
  .wx { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  @media (max-width: 34rem) { .wx { grid-template-columns: 1fr; } }
  .wx-card { background: var(--accent-soft); border-radius: 14px; padding: .9rem 1rem; }
  .wx-card .city { font: 600 .74rem/1 var(--font-sans); letter-spacing: .1em; text-transform: uppercase; color: var(--accent-ink); }
  .wx-card .nowrow { display: flex; align-items: baseline; gap: .5rem; margin: .35rem 0 .15rem; }
  .wx-card .temp { font: 300 2.5rem/1 var(--font-serif); color: var(--ink); font-variant-numeric: tabular-nums; }
  .wx-card .glyph { font-size: 1.6rem; }
  .wx-card .cond { font-size: .9rem; color: var(--ink); }
  .wx-card .hilo { font-size: .8rem; color: var(--muted); }
  .wx-card .rest { font-size: .84rem; color: var(--muted); margin: .45rem 0 .2rem; }
  .wx-hours { display: flex; gap: .55rem; overflow-x: auto; padding-top: .5rem; }
  .wx-hours .h { text-align: center; flex: none; font-variant-numeric: tabular-nums; }
  .wx-hours .h .hh { font-size: .68rem; color: var(--faint); }
  .wx-hours .h .hg { font-size: 1rem; }
  .wx-hours .h .ht { font-size: .78rem; color: var(--ink); }

  /* ---------- US Open bracket ---------- */
  .draw { display: grid; gap: 1rem; }
  .draw .half { }
  .draw .half > h4 { font: 600 .74rem/1 var(--font-sans); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin: 0 0 .5rem; }
  .rounds { display: flex; gap: .8rem; overflow-x: auto; }
  .rd { flex: 1 1 0; min-width: 8.5rem; }
  .rd .rdname { font: 600 .62rem/1 var(--font-sans); letter-spacing: .08em; text-transform: uppercase; color: var(--faint); margin-bottom: .35rem; }
  .match { padding: .35rem .1rem; border-top: 1px solid var(--line); }
  .match:first-of-type { border-top: 0; }
  .seedrow { display: flex; align-items: center; gap: .4rem; font-size: .82rem; }
  .seedrow .ph { width: 1.35rem; height: 1.35rem; border-radius: 50%; object-fit: cover; flex: none; background: var(--accent-soft); }
  .seedrow .nm { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .seedrow .sc { color: var(--muted); font-variant-numeric: tabular-nums; font-size: .76rem; }
  .seedrow.win .nm { font-weight: 700; color: var(--ink); }
  .seedrow.win .nm::after { content: " \2713"; color: var(--accent); }
  .champ { margin-top: .6rem; font-size: .86rem; color: var(--accent-ink); }
  .champ b { color: var(--ink); }

  /* ---------- arxiv ---------- */
  .axmeta { font-size: .84rem; color: var(--muted); margin-bottom: .3rem; }
  li.row .pubdate { font: 600 .7rem/1 var(--font-sans); color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
  li.row .fresh .pubdate { color: var(--accent); }

  [data-marble-editable] { outline: none; border-radius: 4px; }
  [data-marble-editable]:hover { background: color-mix(in srgb, var(--accent-soft) 60%, transparent); }
  [data-marble-editable]:focus { background: var(--panel); box-shadow: 0 0 0 2px var(--accent-soft); }

  .add {
    appearance: none; margin-top: .5rem; padding: .3rem .1rem; border: 0; background: none;
    color: var(--muted); font: 600 .78rem/1 var(--font-sans); cursor: pointer;
  }
  .add:hover { color: var(--accent-ink); }
  .add::before { content: "+ "; }

  pre { white-space: pre-wrap; word-break: break-word; font: 12px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; }
</style>
__PALETTE__
</head>
<body>
<main class="wrap" data-marble-id="nl-root">

  <header class="masthead" data-marble-id="nl-head">
    <div class="swatches" data-marble-id="nl-swatches"></div>
    <p class="date" data-marble-id="nl-date"></p>
    <p class="greeting" data-marble-id="nl-greeting" data-marble-editable>Good morning, Bryan.</p>
    <div data-marble-id="nl-summary"></div>
    <div class="glance" data-marble-id="nl-glance"></div>
  </header>

  <div class="dash" data-marble-id="nl-dash">

    <section class="panel" data-marble-id="nl-p-focus">
      <h2 data-marble-id="nl-focus-h">Today's focus <span class="count" data-marble-id="nl-focus-count"></span></h2>
      <p class="sub" data-marble-id="nl-focus-sub">The few things that actually matter today.</p>
      <div class="soft pbody" data-marble-id="nl-focus-wrap">
        <ol class="list" data-marble-id="nl-focus" data-marble-sortable="focus"></ol>
      </div>
    </section>

    <section class="panel col-7" data-marble-id="nl-p-todos">
      <h2 data-marble-id="nl-todos-h">To do <span class="count" data-marble-id="nl-todos-count"></span></h2>
      <div class="pbody">
        <ol class="list" data-marble-id="nl-todos" data-marble-sortable="todos"></ol>
        <button class="add" data-marble-transient data-marble-add="#tpl-todo" data-marble-into="prev">todo</button>
      </div>
    </section>

    <section class="panel col-5" data-marble-id="nl-p-weather">
      <h2 data-marble-id="nl-weather-h">Weather</h2>
      <p class="sub" data-marble-id="nl-weather-sub">Now, and the rest of the day.</p>
      <div class="pbody" data-marble-id="nl-weather"></div>
    </section>

    <section class="panel col-7 viewbox" data-marble-id="nl-p-dates" data-view="list">
      <h2 data-marble-id="nl-dates-h">Key dates <span class="count" data-marble-id="nl-dates-count"></span></h2>
      <div class="switch" data-marble-transient>
        <button data-setview="list">List</button>
        <button data-setview="cal">Calendar</button>
      </div>
      <div class="pbody v-list" data-marble-id="nl-dates"></div>
      <div class="pbody v-cal" data-marble-id="nl-cal"></div>
    </section>

    <section class="panel col-5" data-marble-id="nl-p-usopen">
      <h2 data-marble-id="nl-usopen-h">US Open</h2>
      <p class="sub" data-marble-id="nl-usopen-sub"></p>
      <div class="pbody" data-marble-id="nl-usopen"></div>
    </section>

    <section class="panel" data-marble-id="nl-p-feed">
      <h2 data-marble-id="nl-feed-h">The feed <span class="count" data-marble-id="nl-feed-count"></span></h2>
      <p class="sub" data-marble-id="nl-feed-sub">Tuned to the research vision. Open an item for the full story.</p>

      <div class="pbody" data-marble-id="nl-feed-genui-wrap">
        <h3 data-marble-id="nl-feed-genui-h" style="font-size:.9rem;color:var(--muted);margin:.2rem 0 .3rem">GenUI &middot; malleable software &middot; building with AI</h3>
        <ol class="list" data-marble-id="nl-feed-genui" data-marble-sortable="feed"></ol>
        <button class="add" data-marble-transient data-marble-add="#tpl-feed" data-marble-into="prev">link</button>
      </div>
      <div class="pbody" data-marble-id="nl-feed-industry-wrap">
        <h3 data-marble-id="nl-feed-industry-h" style="font-size:.9rem;color:var(--muted);margin:.2rem 0 .3rem">Industry &amp; startups</h3>
        <ol class="list" data-marble-id="nl-feed-industry" data-marble-sortable="feed"></ol>
      </div>
      <div class="pbody" data-marble-id="nl-feed-hci-wrap">
        <h3 data-marble-id="nl-feed-hci-h" style="font-size:.9rem;color:var(--muted);margin:.2rem 0 .3rem">HCI pulse</h3>
        <ol class="list" data-marble-id="nl-feed-hci" data-marble-sortable="feed"></ol>
      </div>
    </section>

    <section class="panel" data-marble-id="nl-p-arxiv">
      <h2 data-marble-id="nl-arxiv-h">Today on arXiv &mdash; cs.HC <span class="count" data-marble-id="nl-arxiv-count"></span></h2>
      <p class="axmeta" data-marble-id="nl-arxiv-meta"></p>
      <div class="pbody">
        <ol class="list" data-marble-id="nl-arxiv" data-marble-sortable="arxiv"></ol>
      </div>
    </section>

    <section class="panel" data-marble-id="nl-p-repr">
      <h2 data-marble-id="nl-repr-h">The road ahead <span class="count" data-marble-id="nl-repr-name"></span></h2>
      <div class="pbody" data-marble-id="nl-repr"></div>
    </section>

  </div>
</main>

<template id="tpl-todo" data-marble-transient>
  <li class="row todo" data-marble-removable>
    <button class="chk" data-marble-transient data-act="done" aria-label="Toggle done"></button>
    <div class="body">
      <div class="title" data-marble-editable>New todo</div>
      <div class="note" data-marble-editable></div>
    </div>
    <div class="acts" data-marble-transient>
      <button class="act act-pin" data-act="pin" title="Pin">&#9679;</button>
      <button class="act act-snooze" data-act="snooze" title="Snooze to tomorrow">&#8250;</button>
    </div>
  </li>
</template>

<template id="tpl-feed" data-marble-transient>
  <li class="row item expandable" data-marble-removable>
    <span class="tag" data-marble-editable>tag</span>
    <div class="body">
      <div class="title">New item</div>
      <div class="meta" data-marble-editable></div>
      <div class="why" data-marble-editable></div>
      <button class="exp-toggle" data-marble-transient data-exp>more</button>
      <div class="exp-body"><div class="abstract" data-marble-editable></div></div>
      <div class="note" data-marble-editable></div>
    </div>
    <div class="acts" data-marble-transient>
      <button class="act act-up" data-act="up" title="More like this">&#9650;</button>
      <button class="act act-down" data-act="down" title="Less like this">&#9660;</button>
      <button class="act act-save" data-act="save" title="Save to reading list">&#9733;</button>
    </div>
  </li>
</template>

<script>
/* Bryan's Bulletin — its own behaviour. Toggles that the next morning's build
   reads back off the file, plus expand/collapse and the list/calendar switch.
   Each follows persist-both-halves: move the page, then file one setAttr on the
   element's data-marble-id. Guarded on window.marble so the file still opens
   as a plain page. No state object; the attributes are the whole truth. */
(() => {
  const ROW = '.row';

  function toggle(el, name, value) {
    const on = value === undefined ? el.hasAttribute(name) : el.getAttribute(name) === value;
    if (on) el.removeAttribute(name);
    else el.setAttribute(name, value === undefined ? '' : value);
    const applied = el.hasAttribute(name) ? el.getAttribute(name) : null;
    const id = window.marble && window.marble.id(el);
    if (id) window.marble.op({ type: 'setAttr', id, name, value: applied });
  }
  function set(el, name, value) {
    if (el.getAttribute(name) === value) return;
    el.setAttribute(name, value);
    const id = window.marble && window.marble.id(el);
    if (id) window.marble.op({ type: 'setAttr', id, name, value });
  }

  document.addEventListener('click', (event) => {
    const act = event.target.closest('[data-act]');
    if (act) {
      const row = act.closest(ROW);
      if (!row) return;
      switch (act.dataset.act) {
        case 'done':   return toggle(row, 'data-done');
        case 'snooze': return toggle(row, 'data-snooze');
        case 'pin':    return toggle(row, 'data-pin');
        case 'up':     return toggle(row, 'data-vote', 'up');
        case 'down':   return toggle(row, 'data-vote', 'down');
        case 'save':   return toggle(row, 'data-saved');
      }
      return;
    }
    const exp = event.target.closest('[data-exp]');
    if (exp) {
      const box = exp.closest('.expandable');
      if (box) toggle(box, 'data-open');
      return;
    }
    const sv = event.target.closest('[data-setview]');
    if (sv) {
      const box = sv.closest('.viewbox');
      if (box) set(box, 'data-view', sv.dataset.setview);
    }
  });
})();
</script>

<script>
(() => {
  const begin = (marble) => {
    const TRANSIENT = 'data-marble-transient';
    const ID = 'data-marble-id';

    const isTransient = (el) => el.hasAttribute(TRANSIENT);
    const persistentChildren = (el) => [...el.children].filter((c) => !isTransient(c));

    function nextPersistentSibling(el) {
      let sibling = el.nextElementSibling;
      while (sibling && isTransient(sibling)) sibling = sibling.nextElementSibling;
      return sibling;
    }

    const roles = new WeakMap();
    function claim(el, role) {
      const held = roles.get(el) ?? new Set();
      if (held.has(role)) return false;
      held.add(role);
      roles.set(el, held);
      return true;
    }

    const within = (root, selector) => [
      ...(root.matches?.(selector) ? [root] : []),
      ...root.querySelectorAll(selector),
    ];

    const css = [];
    const wirers = [];
    const addressable = [];

    function assignIdsIn(root) {
      for (const el of [root, ...root.querySelectorAll('*')]) {
        if (isTransient(el) || marble.id(el)) continue;
        if (el === root || el.matches(ADDRESSABLE)) el.setAttribute(ID, marble.newId());
      }
    }

    css.push(`
      .marble-item { position: relative; }
      .marble-item.marble-dragging { opacity: .4; }
      .marble-grip {
        position: absolute; left: -1.4rem; top: .35rem;
        display: flex; flex-direction: column; gap: 2px;
        opacity: 0; transition: opacity .12s ease;
      }
      .marble-item:hover > .marble-grip, .marble-grip:focus-within { opacity: 1; }
      .marble-btn {
        width: 1.1rem; height: 1.1rem; padding: 0; border: 0; border-radius: 3px;
        background: none; color: currentColor; opacity: .35;
        font: 500 11px/1.1rem ui-monospace, SFMono-Regular, Menlo, monospace;
        text-align: center; cursor: pointer;
      }
      .marble-btn:hover { opacity: 1; background: rgba(127, 127, 127, .14); }
    `);

    function grip(item) {
      let grip = item.querySelector(':scope > .marble-grip');
      if (!grip) {
        grip = document.createElement('div');
        grip.className = 'marble-grip';
        grip.setAttribute(TRANSIENT, '');
        grip.setAttribute('contenteditable', 'false');
        item.prepend(grip);
        item.classList.add('marble-item');
      }
      return grip;
    }

    marble.pageOnly('contenteditable', 'spellcheck');
    addressable.push('[data-marble-editable]');
    wirers.push(wireEditable);

    function wireEditable(root) {
      for (const el of within(root, '[data-marble-editable]')) {
        if (!claim(el, 'editable')) continue;
        el.setAttribute('contenteditable', 'plaintext-only');
        if (el.contentEditable !== 'plaintext-only') el.setAttribute('contenteditable', 'true');
        el.spellcheck = false;

        let prior = null;
        el.addEventListener('focus', () => { prior = marble.text(el); });
        el.addEventListener('input', () => {
          const id = marble.id(el);
          const text = marble.text(el);
          const op = { type: 'setText', id, text };
          if (prior !== null && text !== prior) {
            marble.record({ redo: [op], undo: [{ type: 'setText', id, text: prior }] }, { coalesce: true });
          }
          marble.op(op);
        });
        el.addEventListener('blur', () => { prior = null; marble.flush(); });
        el.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' || (event.key === 'Enter' && !event.shiftKey)) {
            event.preventDefault();
            el.blur();
          }
        });
      }
    }

    css.push(`.marble-remove:hover { color: #b4544f; }`);
    addressable.push('[data-marble-removable]');
    wirers.push(wireRemovable);

    function wireRemovable(root) {
      for (const el of within(root, '[data-marble-removable]')) {
        if (!claim(el, 'removable')) continue;
        const button = document.createElement('button');
        button.className = 'marble-btn marble-remove';
        button.setAttribute(TRANSIENT, '');
        button.setAttribute('aria-label', 'Delete');
        button.title = 'Delete';
        button.textContent = '×';
        button.addEventListener('click', () => {
          const id = marble.id(el);
          const inverse = marble.invert({ type: 'remove', id });
          el.remove();
          const op = { type: 'remove', id };
          if (inverse) marble.record({ redo: [op], undo: [inverse] });
          marble.op(op, { immediate: true });
        });
        grip(el).append(button);
      }
    }

    css.push(`
      .marble-handle { cursor: grab; touch-action: none; }
      .marble-handle:active { cursor: grabbing; }
      .marble-handle:focus-visible { opacity: 1; outline: 2px solid currentColor; outline-offset: 1px; }
      body.marble-dragging-now, body.marble-dragging-now * { user-select: none !important; }
    `);
    addressable.push('[data-marble-sortable]', '[data-marble-sortable] > *');
    wirers.push(wireSortable);

    let dragging = null;
    let origin = null;
    const group = (el) => el?.closest('[data-marble-sortable]')?.getAttribute('data-marble-sortable') ?? null;

    const targetIn = (container, y) =>
      persistentChildren(container)
        .filter((child) => child !== dragging)
        .find((child) => {
          const rect = child.getBoundingClientRect();
          return y < rect.top + rect.height / 2;
        }) ?? null;

    function containerAt(x, y) {
      const wanted = group(origin.parent);
      let node = document.elementFromPoint(x, y);
      while (node) {
        const container = node.closest?.('[data-marble-sortable]');
        if (!container) return null;
        if (container.getAttribute('data-marble-sortable') === wanted) return container;
        node = container.parentElement;
      }
      return null;
    }

    function wireSortableItem(item) {
      if (!claim(item, 'sortable-item')) return;
      const handle = document.createElement('button');
      handle.className = 'marble-btn marble-handle';
      handle.setAttribute(TRANSIENT, '');
      handle.setAttribute('aria-label', 'Reorder — drag, or focus and press the arrow keys');
      handle.title = 'Drag to reorder';
      handle.textContent = '⠿';
      let lift = null;

      const onMove = (event) => {
        if (!lift) return;
        event.preventDefault();
        const container = containerAt(event.clientX, event.clientY);
        if (!container) return;
        const target = targetIn(container, event.clientY);
        const settled = item.parentElement === container && target === nextPersistentSibling(item);
        if (!settled) container.insertBefore(item, target);
      };
      const onUp = () => {
        if (!lift) return;
        lift = null;
        removeEventListener('pointermove', onMove);
        removeEventListener('pointerup', onUp);
        removeEventListener('pointercancel', onUp);
        item.classList.remove('marble-dragging');
        document.body.classList.remove('marble-dragging-now');
        commitMove();
        dragging = null; origin = null;
      };
      handle.addEventListener('pointerdown', (event) => {
        if (event.button !== undefined && event.button !== 0) return;
        event.preventDefault();
        lift = true;
        dragging = item;
        origin = { parent: item.parentElement, before: nextPersistentSibling(item) };
        item.classList.add('marble-dragging');
        document.body.classList.add('marble-dragging-now');
        addEventListener('pointermove', onMove, { passive: false });
        addEventListener('pointerup', onUp);
        addEventListener('pointercancel', onUp);
      });
      handle.addEventListener('keydown', (event) => {
        const up = event.key === 'ArrowUp';
        const down = event.key === 'ArrowDown';
        if (!up && !down) return;
        const parent = item.parentElement;
        const siblings = persistentChildren(parent);
        const at = siblings.indexOf(item);
        const to = up ? at - 1 : at + 1;
        if (to < 0 || to >= siblings.length) return;
        event.preventDefault();
        origin = { parent, before: nextPersistentSibling(item) };
        dragging = item;
        parent.insertBefore(item, up ? siblings[to] : siblings[to].nextElementSibling);
        commitMove();
        dragging = null; origin = null;
        handle.focus();
      });
      grip(item).prepend(handle);
    }

    function wireSortable(root) {
      for (const container of within(root, '[data-marble-sortable]')) {
        for (const item of persistentChildren(container)) wireSortableItem(item);
        claim(container, 'sortable');
      }
    }

    function commitMove() {
      const parent = dragging.parentElement;
      const before = nextPersistentSibling(dragging);
      if (parent === origin.parent && before === origin.before) return;
      const op = { type: 'move', id: marble.id(dragging), parentId: marble.id(parent), beforeId: marble.id(before) };
      const inverse = { type: 'move', id: marble.id(dragging), parentId: marble.id(origin.parent), beforeId: marble.id(origin.before) };
      marble.record({ redo: [op], undo: [inverse] });
      marble.op(op, { immediate: true });
    }

    wirers.push(wireAdders);
    function wireAdders(root) {
      for (const button of within(root, '[data-marble-add]')) {
        if (!claim(button, 'adder')) continue;
        button.addEventListener('click', () => {
          const template = document.querySelector(button.dataset.marbleAdd);
          const into = button.dataset.marbleInto;
          const container =
            into === 'prev' ? button.previousElementSibling : document.querySelector(into);
          const seed = template?.content?.firstElementChild;
          if (!seed || !container) {
            console.error('[marble] add: missing template or container', button.dataset);
            return;
          }
          const node = seed.cloneNode(true);
          assignIdsIn(node);
          const html = marble.source.outer(node);
          container.append(node);
          marble.adopt(node);
          const op = { type: 'insert', html, parentId: marble.id(container), beforeId: null };
          const inverse = marble.invert(op);
          if (inverse) marble.record({ redo: [op], undo: [inverse] });
          marble.op(op, { immediate: true });
          node.querySelector('[data-marble-editable]')?.focus();
        });
      }
    }

    css.push(`
      .marble-status {
        position: fixed; right: 1rem; bottom: 1rem; z-index: 9999;
        padding: .3rem .6rem; border-radius: 999px;
        font: 500 11px ui-monospace, SFMono-Regular, Menlo, monospace;
        letter-spacing: .04em; pointer-events: none;
        opacity: 0; transition: opacity .25s ease;
        background: rgba(20, 22, 26, .92); color: #b7c0cc; border: 1px solid rgba(255,255,255,.12);
      }
      .marble-status[data-state="saving"] { opacity: 1; }
      .marble-status[data-state="saved"]  { opacity: .55; }
      .marble-status[data-state="error"]  { opacity: 1; background: #46201f; color: #ff9b9b; }
    `);
    const status = document.createElement('div');
    status.className = 'marble-status';
    status.setAttribute(TRANSIENT, '');
    document.body.append(status);
    let statusTimer = null;
    document.addEventListener('marble:status', ({ detail }) => {
      status.dataset.state = detail.state;
      status.textContent =
        detail.state === 'saving' ? 'saving…' : detail.state === 'saved' ? 'saved' : `error — ${detail.message}`;
      clearTimeout(statusTimer);
      if (detail.state === 'saved') statusTimer = setTimeout(() => (status.dataset.state = 'idle'), 1200);
    });

    const style = document.createElement('style');
    style.setAttribute(TRANSIENT, '');
    style.textContent = css.join('\n');
    document.head.append(style);

    const ADDRESSABLE = addressable.join(', ');
    marble.address(document.querySelectorAll(ADDRESSABLE));
    marble.register((root) => { for (const wirer of wirers) wirer(root); });
  };

  if (window.marble) begin(window.marble);
  else addEventListener('marble:ready', (event) => begin(event.detail), { once: true });
})();
</script>
</body>
</html>
