<!doctype html>
<html lang="en" data-marble="1">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="marble:capabilities" content="storage; net=none">
<meta name="day:date" content="__DATE__">
<meta name="day:title" content="__TITLE__">
<meta name="day:palette" content="__PALETTE_NAME__">
<meta name="day:app" content="Bryan's Days">
<meta name="theme-color" content="__THEME_LIGHT__" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="__THEME_DARK__" media="(prefers-color-scheme: dark)">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Bryan's Days">
<title>__TITLE__</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23222'/%3E%3Crect x='7' y='7' width='8' height='8' rx='2' fill='%23fff'/%3E%3Crect x='17' y='7' width='8' height='8' rx='2' fill='%23fff' opacity='.55'/%3E%3Crect x='7' y='17' width='8' height='8' rx='2' fill='%23fff' opacity='.55'/%3E%3Crect x='17' y='17' width='8' height='8' rx='2' fill='%23fff'/%3E%3C/svg%3E">
<link rel="apple-touch-icon" href="__APPLE_TOUCH_ICON__">
__FONT__
<style id="nl-base">
__DESIGN__
</style>
__PALETTE__
</head>
<body>
<main class="page" data-marble-id="nl-root"__READ__>

  <svg class="icon-sprite" width="0" height="0" data-marble-transient aria-hidden="true"><defs>
    <symbol id="ic-gmail" viewBox="0 0 24 24"><path fill="#EA4335" d="M2 6.5 12 13l10-6.5V18a2 2 0 0 1-2 2h-2V9.8l-6 3.9-6-3.9V20H4a2 2 0 0 1-2-2z"/><path fill="#C5221F" d="M2 6.5V6a2 2 0 0 1 3.1-1.7L12 9l6.9-4.7A2 2 0 0 1 22 6v.5L12 13z"/></symbol>
    <symbol id="ic-gcal" viewBox="0 0 24 24"><rect x="3" y="4.5" width="18" height="16" rx="2.5" fill="#fff" stroke="#4285F4" stroke-width="1.6"/><rect x="3" y="4.5" width="18" height="4.5" rx="2.5" fill="#4285F4"/><text x="12" y="17.5" font-family="ui-sans-serif,sans-serif" font-size="8" font-weight="700" fill="#4285F4" text-anchor="middle">31</text></symbol>
    <symbol id="ic-notion" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="3" fill="#fff" stroke="#111" stroke-width="1.4"/><path d="M8 8v8m0-8 8 8m0-8v8" stroke="#111" stroke-width="1.7" fill="none" stroke-linecap="round"/></symbol>
    <symbol id="ic-slack" viewBox="0 0 24 24"><g><rect x="10.3" y="3" width="3.4" height="9.5" rx="1.7" fill="#36C5F0"/><rect x="3" y="10.3" width="9.5" height="3.4" rx="1.7" fill="#2EB67D"/><rect x="11.5" y="11.5" width="9.5" height="3.4" rx="1.7" fill="#ECB22E" transform="rotate(90 11.5 11.5)"/><rect x="10.3" y="11.5" width="3.4" height="9.5" rx="1.7" fill="#E01E5A"/></g></symbol>
    <symbol id="ic-github" viewBox="0 0 24 24"><path fill="#181717" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.36 1.09 2.94.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z"/></symbol>
    <symbol id="ic-arxiv" viewBox="0 0 24 24"><text x="12" y="17" font-family="ui-serif,Georgia,serif" font-size="13" font-weight="700" fill="#B31B1B" text-anchor="middle">arX</text></symbol>
    <symbol id="ic-meteo" viewBox="0 0 24 24"><circle cx="9" cy="9" r="3.4" fill="#F6C445"/><path d="M6 16.5h11a3.2 3.2 0 0 0 0-6.4 4.6 4.6 0 0 0-8.9-1.2A3.4 3.4 0 0 0 6 16.5Z" fill="#8FB8DE"/></symbol>
    <symbol id="ic-web" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18" fill="none" stroke="currentColor" stroke-width="1.4"/></symbol>
    <symbol id="ic-marble" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="9.5" cy="9.5" r="2.4" fill="currentColor"/></symbol>
  </defs></svg>

__BODY__

</main>

<template id="tpl-todo" data-marble-transient>
  <li class="row todo" data-marble-removable>
    <button class="chk" data-marble-transient data-act="done" aria-label="Toggle done"></button>
    <div class="body">
      <div class="title" data-marble-editable data-ph="New to-do"></div>
      <div class="note" data-marble-editable></div>
    </div>
    <div class="acts" data-marble-transient>
      <button class="act act-pin" data-act="pin" title="Pin">&#9679;</button>
      <button class="act act-snooze" data-act="snooze" title="Snooze to tomorrow">&#8250;</button>
    </div>
  </li>
</template>

<template id="tpl-focus" data-marble-transient>
  <li class="row focus" data-marble-removable>
    <button class="chk" data-marble-transient data-act="done" aria-label="Toggle done"></button>
    <div class="body">
      <div class="title" data-marble-editable data-ph="New priority"></div>
      <div class="why" data-marble-editable></div>
      <div class="note" data-marble-editable></div>
    </div>
    <div class="acts" data-marble-transient>
      <button class="act act-pin" data-act="pin" title="Pin">&#9679;</button>
      <button class="act act-snooze" data-act="snooze" title="Snooze to tomorrow">&#8250;</button>
    </div>
  </li>
</template>

<template id="tpl-news" data-marble-transient>
  <div class="ncard no-img expandable" data-marble-removable>
    <div class="nbody">
      <h4 class="ntitle" data-marble-editable data-ph="New link"></h4>
      <div class="nmeta" data-marble-editable></div>
      <div class="nwhy" data-marble-editable></div>
      <button class="exp-toggle" data-marble-transient data-exp>more</button>
      <div class="exp"><div class="exp-inner"><div class="abstract" data-marble-editable></div></div></div>
      <div class="note" data-marble-editable></div>
    </div>
    <div class="acts" data-marble-transient>
      <button class="act act-up" data-act="up" title="More like this">&#9650;</button>
      <button class="act act-down" data-act="down" title="Less like this">&#9660;</button>
      <button class="act act-save" data-act="save" title="Save to reading list">&#9733;</button>
    </div>
  </div>
</template>

<script>
/* Bryan's Days — its own behaviour. persist-both-halves: move the page,
   then file one setAttr against the element's data-marble-id. Guarded on
   window.marble so the file still opens as a plain page. */
(() => {
  const ROW = '.row, .ncard, .pcard, .mo';
  function toggle(el, name, value) {
    const on = value === undefined ? el.hasAttribute(name) : el.getAttribute(name) === value;
    if (on) el.removeAttribute(name); else el.setAttribute(name, value === undefined ? '' : value);
    const applied = el.hasAttribute(name) ? el.getAttribute(name) : null;
    const id = window.marble && window.marble.id(el);
    if (id) window.marble.op({ type: 'setAttr', id, name, value: applied });
  }
  function set(el, name, value) {
    if (el.getAttribute(name) === value) return;
    el.setAttribute(name, value);
    const id = window.marble && window.marble.id(el);
    if (id) window.marble.op({ type: 'setAttr', id, name, value });
  }
  document.addEventListener('click', (event) => {
    const act = event.target.closest('[data-act]');
    if (act) {
      const row = act.closest(ROW);
      if (!row) return;
      switch (act.dataset.act) {
        case 'done': return toggle(row, 'data-done');
        case 'snooze': return toggle(row, 'data-snooze');
        case 'pin': return toggle(row, 'data-pin');
        case 'up': return toggle(row, 'data-vote', 'up');
        case 'down': return toggle(row, 'data-vote', 'down');
        case 'save': return toggle(row, 'data-saved');
      }
      return;
    }
    /* An author name is a control. Clicking one marks that person as someone
       Bryan knows, and marks EVERY instance of them on the page in the same
       breath, so the answer to "do I know these people?" is consistent whether
       they appear once or on four papers. harvest carries it to the next day. */
    const au = event.target.closest('[data-au]');
    if (au) {
      const on = au.hasAttribute('data-known');
      for (const el of document.querySelectorAll(`[data-au="${CSS.escape(au.dataset.au)}"]`)) {
        if (el.hasAttribute('data-known') === on) toggle(el, 'data-known');
      }
      return;
    }
    /* A component's own expand chevron: the fuller reading of the same data,
       opened in place. Filed as an attribute so the page reopens as left. */
    const ce = event.target.closest('[data-comp-exp]');
    if (ce) { const sec = ce.closest('.comp'); if (sec) toggle(sec, 'data-expanded'); return; }
    const exp = event.target.closest('[data-exp]');
    if (exp) { const box = exp.closest('.expandable'); if (box) toggle(box, 'data-open'); return; }
    const sv = event.target.closest('[data-setview]');
    if (sv) { const box = sv.closest('.viewbox'); if (box) set(box, 'data-view', sv.dataset.setview); }
  });

  /* Every control above changes a fact that lives in one attribute, and the
     stylesheet reads that attribute to colour it. A screen reader reads none of
     it: a starred row and an unstarred one are the same button with the same
     name. So derive the announced state from the same attribute the CSS uses —
     never a second copy anyone has to remember to update, just a reading of the
     fact, re-taken whenever the fact changes.

     This is also what makes undo honest. Mod+Z rewrites the attribute; the
     observer below re-derives from it, so the button can never end up saying
     "saved" about a row that no longer is. */
  const ARIA = [
    ['[data-act="done"]',   (b) => b.closest('[data-done]')   !== null],
    ['[data-act="pin"]',    (b) => b.closest('[data-pin]')    !== null],
    ['[data-act="save"]',   (b) => b.closest('[data-saved]')  !== null],
    ['[data-act="snooze"]', (b) => b.closest('[data-snooze]') !== null],
    ['[data-act="up"]',     (b) => b.closest('[data-vote="up"]')   !== null],
    ['[data-act="down"]',   (b) => b.closest('[data-vote="down"]') !== null],
    ['[data-au]',           (b) => b.hasAttribute('data-known')],
  ];

  function deriveAria(root = document) {
    const scope = root.querySelectorAll ? root : document;
    for (const [selector, on] of ARIA) {
      for (const el of scope.querySelectorAll(selector)) el.setAttribute('aria-pressed', String(on(el)));
    }
    /* A view switcher: exactly one of the segment buttons is current. */
    for (const box of scope.querySelectorAll('.viewbox')) {
      const view = box.getAttribute('data-view');
      for (const b of box.querySelectorAll('.seg [data-setview]')) {
        b.setAttribute('aria-pressed', String(b.dataset.setview === view));
      }
    }
    /* A chevron says whether the second reading is open, and what it opens. */
    for (const sec of scope.querySelectorAll('.comp')) {
      const chevron = sec.querySelector('[data-comp-exp]');
      if (!chevron) continue;
      chevron.setAttribute('aria-expanded', String(sec.hasAttribute('data-expanded')));
      const more = sec.querySelector('.comp-more[data-marble-id]');
      if (more) chevron.setAttribute('aria-controls', more.getAttribute('data-marble-id'));
    }
    for (const box of scope.querySelectorAll('.expandable')) {
      const b = box.querySelector('[data-exp]');
      if (b) b.setAttribute('aria-expanded', String(box.hasAttribute('data-open')));
    }
  }

  /* These are readings of the file, never entries in it — so the carrier has to
     be told before anything derives, and the carrier is injected after this
     script has parsed. Declaring it only on `window.marble` here would be a
     silent no-op under a host, and every derived aria attribute would be filed
     into the document: the same fact in two places, which is the bug this whole
     derivation exists to avoid. */
  const pageOnly = (m) => m?.pageOnly('aria-pressed', 'aria-expanded', 'aria-controls');
  pageOnly(window.marble);
  addEventListener('marble:ready', (e) => { pageOnly(e.detail); deriveAria(); }, { once: true });
  deriveAria();
  /* Re-derive when a fact changes — a click here, a hand edit, an undo, or the
     file being rewritten by tomorrow's run while the page is open. */
  new MutationObserver(() => deriveAria()).observe(document.body, {
    subtree: true, childList: true, attributes: true,
    attributeFilter: ['data-done', 'data-pin', 'data-saved', 'data-snooze',
                      'data-vote', 'data-known', 'data-view', 'data-expanded', 'data-open'],
  });

  /* Reveal-on-scroll for browsers without animation-timeline. Adds a class the
     stylesheet already knows; no layout is read or written per frame. */
  if (!CSS.supports('animation-timeline: view()') && 'IntersectionObserver' in window
      && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('marble-seen'); io.unobserve(e.target); }
    }, { rootMargin: '0px 0px -12% 0px' });
    const arm = (root) => { for (const el of root.querySelectorAll('.reveal, .rail > .comp')) { el.classList.add('marble-armed'); io.observe(el); } };
    const style = document.createElement('style');
    style.setAttribute('data-marble-transient', '');
    style.textContent = '.marble-armed{opacity:0;transform:translateY(18px);transition:opacity .5s cubic-bezier(.2,.8,.2,1),transform .5s cubic-bezier(.2,.8,.2,1)}'
      + '.rail>.comp.marble-armed{transform:translateX(-14px)}'
      + '.marble-armed.marble-seen{opacity:1;transform:none}';
    document.head.append(style);
    addEventListener('DOMContentLoaded', () => arm(document));
    arm(document);
  }
})();

(() => {
  /* ---------------------------------------------------------------- story ---
     A day has two readings. The page is the one you scroll. This is the other:
     on a phone the day becomes screens — tap right to go on, tap left to go
     back, swipe up to reach the thing itself, and an end card when you are
     done.

     Two halves, and the split is the whole design. The BUILD decides the
     editorial half and writes it into the file as `data-story*`: what becomes a
     unit, what has to be read on its own, what order the day reads in. This
     decides the geometry, because only a phone knows how tall a screen is — it
     measures real clones at the real width and packs them.

     A glance screen is a PICTURE of the document, never the document: every
     clone loses its id, its contenteditable and its controls, so nothing the
     story shows can be edited by accident and nothing it does can be filed.
     The live element is one swipe away, which is where every control already
     lives. The only thing the story ever writes is which reading he chose. */

  const PHONE = matchMedia('(max-width: 62rem)');
  const REDUCED = matchMedia('(prefers-reduced-motion: reduce)');
  const root = document.querySelector('main.page');
  if (!root) return;

  const SHEET = `
    .story { position: fixed; inset: 0; z-index: 90; display: flex; flex-direction: column;
      background: var(--bg); color: var(--ink); touch-action: none; overscroll-behavior: contain;
      padding: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px)
               env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px); }
    .story[hidden] { display: none; }
    .story-bar { flex: none; display: flex; gap: 3px; padding: .6rem var(--s4) .4rem; }
    .story-seg { flex: 1 1 0; min-width: 0; height: 2.5px; border-radius: 999px;
      background: color-mix(in srgb, var(--faint) 32%, transparent); }
    .story-seg[data-on] { background: var(--accent); }
    .story-kick { flex: none; display: flex; align-items: center; gap: .5rem;
      padding: 0 var(--s4) .4rem; min-width: 0; }
    .story-label { min-width: 0; display: flex; align-items: center; gap: .45rem;
      font: 600 .72rem/1 var(--font-sans); letter-spacing: .12em; text-transform: uppercase;
      color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .story-label::before { content: ""; flex: none; width: .5rem; height: .5rem;
      border-radius: 50%; background: var(--segcat, var(--accent)); }
    .story-of { margin-left: auto; flex: none; font: 600 .72rem/1 var(--font-mono); color: var(--faint); }
    .story-x { appearance: none; border: 0; background: none; cursor: pointer; flex: none;
      color: var(--muted); font: 500 1rem/1 var(--font-sans); border-radius: 8px;
      min-width: 2.75rem; min-height: 2.75rem; }
    .story-track { position: relative; flex: 1 1 auto; min-height: 0; overflow: hidden; }
    .story-screen { position: absolute; inset: 0; display: flex; flex-direction: column;
      justify-content: center; padding: 0 var(--s4); will-change: transform; }
    .story-stack { display: flex; flex-direction: column; gap: var(--s4); min-width: 0; }
    .story-stack > .story-unit + .story-unit { border-top: 1px solid var(--line); border-radius: 0; }
    .story-screen[data-clamped] .story-stack { max-height: 100%; overflow: hidden;
      mask-image: linear-gradient(to bottom, #000 76%, transparent 100%);
      -webkit-mask-image: linear-gradient(to bottom, #000 76%, transparent 100%); }
    .story-unit { min-width: 0; }
    .story-unit.comp { padding: 0; background: none; border: 0; }
    .story-unit.comp.card, .story-unit.comp.tint { padding: var(--s4); }
    .story-unit li.row { grid-template-columns: minmax(0, 1fr); padding: 0; margin-inline: 0;
      border-top: 0; border-radius: 0; background: none; }
    .story-unit li.row .title, .story-unit .ntitle, .story-unit .ptitle { font-size: 1.2rem; line-height: 1.3; }
    /* A paper's picture is the first page of the PDF. In the grid it is a 3:4
       portrait and it reads; on a phone screen it is half the glass and a grey
       smudge of body text — the thing rule 11 forbids — and it pushes the line
       that says why the paper matters under the fade. So on a story screen it
       becomes a band of the top of the page: the title block, which is the one
       part legible at this size, and the words keep the room. */
    .story-unit .pthumb { aspect-ratio: 16 / 9; }
    .story-unit .pthumb img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
    .story-unit li.row .note, .story-unit li.row .why { font-size: .95rem; }
    .story-unit .csrc { font-size: .72rem; }
    .story-zone { position: absolute; top: 0; bottom: 0; z-index: 2; appearance: none;
      border: 0; padding: 0; background: none; cursor: pointer; }
    .story-zone[data-dir="prev"] { left: 0; width: 35%; }
    .story-zone[data-dir="next"] { right: 0; width: 65%; }
    .story-zone[data-press] { background: color-mix(in srgb, var(--ink) 4%, transparent); }
    .story-foot { flex: none; display: flex; justify-content: center; padding: .3rem 0 .8rem; }
    .story-open { appearance: none; border: 0; background: none; cursor: pointer; color: var(--muted);
      display: flex; flex-direction: column; align-items: center; gap: .1rem; border-radius: 10px;
      font: 500 .74rem/1.2 var(--font-sans); min-height: 2.75rem; padding: .2rem 1rem; }
    .story-open[hidden] { display: none; }
    .story-chev { font: 500 1rem/1 var(--font-mono); }
    .story-gauge > .story-unit + .story-unit { border-top: 0; }
    .story-gauge { position: absolute; left: 0; top: 0; width: 100%; box-sizing: border-box;
      padding: 0 var(--s4); visibility: hidden; pointer-events: none;
      display: flex; flex-direction: column; gap: var(--s4); }
    .story-cover .greet { font-size: 2.1rem; }
    .story-count { margin: .7rem 0 0; font: 500 .74rem/1 var(--font-mono); color: var(--faint); }
    .story-end h2 { margin: 0 0 .5rem; font: 500 1.9rem/1.15 var(--font-serif); letter-spacing: -.02em; }
    .story-end p { margin: 0; font-size: .92rem; line-height: 1.5; color: var(--muted); }
    .story-acts { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: var(--s4); }
    .story-btn { appearance: none; cursor: pointer; border: 1px solid var(--line);
      background: var(--panel); color: var(--ink); border-radius: 999px;
      font: 600 .82rem/1 var(--font-sans); padding: .75rem 1.1rem; min-height: 2.75rem; }
    .story-read { display: flex; justify-content: flex-end; margin-bottom: var(--s4); }
    .story-read .seg button[aria-pressed="true"] { background: var(--accent); color: var(--bg); }
    .story-return { position: fixed; left: 0; right: 0; top: 0; z-index: 80;
      padding-top: env(safe-area-inset-top, 0px); touch-action: none;
      background: color-mix(in srgb, var(--bg) 72%, transparent);
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      border-bottom: 1px solid var(--line); }
    .story-return[hidden] { display: none; }
    .story-back { appearance: none; border: 0; background: none; cursor: pointer; width: 100%;
      color: var(--ink); font: 600 .8rem/1 var(--font-sans); text-align: left;
      padding: .95rem var(--s4); min-height: 2.75rem; }
    .story-zone:focus-visible, .story-open:focus-visible, .story-x:focus-visible,
    .story-btn:focus-visible, .story-back:focus-visible, .story-read button:focus-visible {
      outline: 2px solid var(--accent); outline-offset: -2px; border-radius: 8px; }
    @media (prefers-reduced-transparency: reduce) {
      .story-return { background: var(--bg); backdrop-filter: none; -webkit-backdrop-filter: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      .story-screen { transition: opacity .2s ease; }
    }
  `;

  const S = { on: false, hold: false, cur: 0, dx: 0, dy: 0, screens: [], units: [] };
  const mounted = new Map();
  let sheet = null, overlay = null, track = null, gauge = null, bar = null, segs = [];
  let label = null, of = null, openBtn = null, word = null, ret = null, retBtn = null;
  let toggle = null, cancelX = null, cancelY = null, suppressClick = false, heldEl = null;

  function ensureSheet() {
    if (sheet) return;
    sheet = document.createElement('style');
    sheet.setAttribute('data-marble-transient', '');
    sheet.textContent = SHEET;
    document.head.append(sheet);
  }
  const el = (tag, cls, text) => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text != null) n.textContent = text;
    n.setAttribute('data-marble-transient', '');
    return n;
  };
  const clamp = (n, a, b) => Math.max(a, Math.min(b, n));

  /* -- what the day is made of -------------------------------------------- */

  function collect() {
    const secs = [...document.querySelectorAll('.comp[data-story-seq]')]
      .sort((a, b) => Number(a.dataset.storySeq) - Number(b.dataset.storySeq));
    const out = [];
    for (const sec of secs) {
      const mode = sec.dataset.story;
      if (mode === 'skip') continue;
      const cat = (sec.style.getPropertyValue('--cat') || '').trim() || 'var(--accent)';
      const head = sec.querySelector('.chead h2');
      const name = (sec.dataset.storyLabel || (head ? head.textContent : '') || '').trim();
      if (mode === 'items') {
        const view = sec.dataset.storyView;
        const scope = view ? sec.querySelector('.v-' + view) : sec;
        if (!scope) continue;
        const pack = Math.max(1, Number(sec.dataset.storyPack) || 1);
        const subs = [...scope.querySelectorAll('.nsub')];
        for (const node of scope.querySelectorAll('li.row, .pcard, .ncard')) {
          const sub = node.closest('.nsub');
          const h3 = sub ? sub.querySelector('h3') : null;
          out.push({
            el: node, sec, cat, pack,
            group: sec.dataset.comp + (sub ? ':' + subs.indexOf(sub) : ''),
            label: ((sub && h3 ? h3.textContent : name) || '').trim(),
            own: node.hasAttribute('data-story-own'),
          });
        }
      } else {
        out.push({
          el: sec, sec, cat, pack: 1, whole: true, own: true,
          group: 'c' + sec.dataset.storySeq, label: name,
        });
      }
    }
    return out;
  }

  /* A screen is read, not operated. Everything that exists to be pressed comes
     out, and with it every handle the carrier could take hold of. */
  const STRIP = '.acts, .chk, .add, .exp-toggle, .exp, .seg, .comp-exp, .comp-more,'
    + ' .marble-grip, .chead .right, [data-marble-transient]';
  function shot(u) {
    const node = u.el.cloneNode(true);
    node.classList.add('story-unit');
    node.classList.remove('reveal', 'marble-armed', 'marble-seen', 'marble-item');
    if (u.whole) {
      /* One component, one reading: the phone gets the view that reads top to
         bottom, whichever one the desktop tab happens to be left on. */
      if (u.sec.dataset.storyView) node.setAttribute('data-view', u.sec.dataset.storyView);
      const chead = node.querySelector('.chead');
      if (chead) chead.remove();   /* the kicker above the track is the header now */
    }
    for (const k of node.querySelectorAll(STRIP)) k.remove();
    for (const n of [node, ...node.querySelectorAll('*')]) {
      n.removeAttribute('data-marble-id');
      n.removeAttribute('contenteditable');
      n.removeAttribute('spellcheck');
      n.removeAttribute('tabindex');
      n.removeAttribute('id');
      n.removeAttribute('aria-pressed');
      /* A link in a glance would navigate on the tap that meant "next". */
      if (n.tagName === 'A') { n.removeAttribute('href'); n.removeAttribute('target'); }
    }
    for (const n of node.querySelectorAll('.note, .why')) if (!n.textContent.trim()) n.remove();
    return node;
  }

  /* -- packing ------------------------------------------------------------- */

  /* The measuring column and a real screen must space units identically, or the
     packer fills a screen the screen cannot hold. So read the gap rather than
     guess it: one number, taken from the stylesheet that draws it. */
  const gapOf = () => parseFloat(getComputedStyle(gauge).rowGap) || 20;
  function repack(keep) {
    if (!S.on) return;
    S.units = collect();
    const H = track.clientHeight;
    const GAP = gapOf() + 1;   /* + the hairline between two units */
    gauge.textContent = '';
    const nodes = S.units.map((u) => { const n = shot(u); gauge.append(n); return n; });
    const hs = nodes.map((n) => n.getBoundingClientRect().height);
    for (const n of nodes) n.remove();

    const screens = [{ kind: 'cover', group: 'cover', label: '', cat: 'var(--accent)', units: [] }];
    let open = null, used = 0;
    S.units.forEach((u, i) => {
      const h = hs[i];
      /* One group per screen, never past the ceiling, never past the glass. */
      const fits = open && !open.kind && open.group === u.group && !u.own && !open.own
        && open.units.length < u.pack && used + GAP + h <= H - 8;
      if (!fits) {
        open = { group: u.group, label: u.label, cat: u.cat, units: [], own: u.own };
        screens.push(open);
        used = 0;
      }
      open.units.push(Object.assign({}, u, { node: nodes[i] }));
      used += (open.units.length > 1 ? GAP : 0) + h;
      /* Taller than the glass even alone: clamp it and say where the rest is.
         A unit is never split — that is what makes it a unit. */
      if (h > H) open.clamped = true;
    });
    screens.push({ kind: 'end', group: 'end', label: '', cat: 'var(--accent)', units: [] });
    S.screens = screens;

    let cur = clamp(S.cur, 0, screens.length - 1);
    if (keep) {
      const found = screens.findIndex((s) => s.units.some((u) => u.el === keep));
      if (found >= 0) cur = found;
    }
    S.cur = cur;
    S.dx = 0; S.dy = 0;
    drawBar();
    for (const [, n] of mounted) n.remove();
    mounted.clear();
    mountWindow();
    chrome();
  }

  function mount(i) {
    if (i < 0 || i >= S.screens.length || mounted.has(i)) return;
    const s = S.screens[i];
    const scr = el('div', 'story-screen');
    if (s.clamped) scr.setAttribute('data-clamped', '');
    const stack = el('div', 'story-stack');
    if (s.kind === 'cover') stack.append(coverNode());
    else if (s.kind === 'end') stack.append(endNode());
    else for (const u of s.units) stack.append(u.node);
    scr.append(stack);
    track.append(scr);
    mounted.set(i, scr);
    /* The packer predicted; this is what the glass actually holds. A font that
       settles or an image that decodes after the measuring pass can push a
       packed screen past the edge, and a screen that overflows without a fade
       is one whose last line is simply gone. */
    if (stack.getBoundingClientRect().height > track.clientHeight + 1) {
      scr.setAttribute('data-clamped', '');
    }
  }
  /* Three screens live at a time — the one you are reading and the two you
     could be reading next — so a forty-screen day costs three screens of DOM. */
  function mountWindow() {
    for (const [i, n] of [...mounted]) if (Math.abs(i - S.cur) > 1) { n.remove(); mounted.delete(i); }
    mount(S.cur - 1); mount(S.cur); mount(S.cur + 1);
    /* Two of the three are only mounted so a drag has something to drag to.
       Which one is actually being read is a fact, so it is written down. */
    for (const [i, n] of mounted) {
      if (i === S.cur) n.setAttribute('data-cur', ''); else n.removeAttribute('data-cur');
    }
    place();
  }
  function place() {
    const W = track.clientWidth, H = track.clientHeight;
    for (const [i, n] of mounted) {
      const x = (i - S.cur) * W + S.dx;
      const y = i === S.cur ? S.dy : 0;
      n.style.transform = 'translate3d(' + x + 'px,' + y + 'px,0)';
      n.style.opacity = (i === S.cur && S.dy < 0) ? String(Math.max(0, 1 + S.dy / (H * 0.9))) : '1';
    }
  }
  function drawBar() {
    bar.textContent = '';
    segs = [];
    for (let i = 0; i < S.screens.length; i += 1) {
      const seg = el('span', 'story-seg');
      bar.append(seg);
      segs.push(seg);
    }
  }
  function chrome() {
    const s = S.screens[S.cur] || { label: '', cat: 'var(--accent)' };
    segs.forEach((seg, i) => {
      if (i <= S.cur) seg.setAttribute('data-on', ''); else seg.removeAttribute('data-on');
    });
    label.textContent = s.kind === 'cover' ? 'Today' : s.kind === 'end' ? 'The end' : s.label;
    label.style.setProperty('--segcat', s.cat);
    of.textContent = (S.cur + 1) + ' / ' + S.screens.length;
    openBtn.hidden = !!s.kind;
    const scr = mounted.get(S.cur);
    word.textContent = (scr && scr.hasAttribute('data-clamped')) ? 'swipe up for all of it' : 'Open';
  }

  function coverNode() {
    const m = document.querySelector('.masthead');
    const node = m ? shot({ el: m }) : el('div', 'story-unit');
    node.classList.add('story-cover');
    const n = el('p', 'story-count', S.screens.length + ' screens');
    node.append(n);
    return node;
  }
  function endNode() {
    const node = el('div', 'story-unit story-end');
    node.append(el('h2', '', "That's your day."));
    const colophon = document.querySelector('.colophon');
    node.append(el('p', '', colophon ? colophon.textContent.replace(/\s+/g, ' ').trim() : ''));
    const acts = el('div', 'story-acts');
    const page = el('button', 'story-btn', 'Read as a page');
    page.addEventListener('click', () => leave());
    const again = el('button', 'story-btn', 'Start over');
    again.addEventListener('click', () => go(0, 0));
    acts.append(page, again);
    node.append(acts);
    return node;
  }

  /* -- motion -------------------------------------------------------------- */

  /* A spring in the two parameters a designer reasons with: response is how
     fast it reaches the target, damping is how much it overshoots (1 = not at
     all). It starts from where the thing actually is and from the velocity it
     actually has, which is what makes it interruptible — grab a moving screen
     and it re-targets instead of jumping. */
  function spring(from, to, v0, damping, response, onFrame, onDone) {
    const w = (2 * Math.PI) / response;
    let x = from - to, v = v0, last = performance.now(), raf = 0;
    raf = requestAnimationFrame(function step(now) {
      const dt = Math.min((now - last) / 1000, 1 / 30);
      last = now;
      v += (-w * w * x - 2 * damping * w * v) * dt;
      x += v * dt;
      if (Math.abs(x) < 0.4 && Math.abs(v) < 24) { onFrame(to); if (onDone) onDone(); return; }
      onFrame(to + x);
      raf = requestAnimationFrame(step);
    });
    return () => cancelAnimationFrame(raf);
  }
  /* Where a flick is going, not where the finger left off — the same
     exponential decay a scroll view uses. */
  const project = (v) => (v / 1000) * 0.998 / 0.002;
  /* An edge resists progressively instead of stopping dead. */
  const rubber = (over, dim) => (over * dim * 0.55) / (dim + 0.55 * Math.abs(over));

  function go(target, v0) {
    const t = clamp(target, 0, S.screens.length - 1);
    if (cancelX) { cancelX(); cancelX = null; }
    S.dx += (t - S.cur) * track.clientWidth;
    S.cur = t;
    mountWindow();
    chrome();
    if (REDUCED.matches) {
      S.dx = 0;
      place();
      const n = mounted.get(S.cur);
      if (n) { n.style.opacity = '0'; requestAnimationFrame(() => { n.style.opacity = '1'; }); }
      return;
    }
    if (Math.abs(S.dx) < 0.5) { S.dx = 0; place(); return; }
    overlay.dataset.moving = '1';
    cancelX = spring(S.dx, 0, v0 || 0, Math.abs(v0 || 0) > 900 ? 0.8 : 1.0, 0.35,
      (val) => { S.dx = val; place(); },
      () => { cancelX = null; delete overlay.dataset.moving; });
  }
  function springY(to, v0) {
    if (cancelY) { cancelY(); cancelY = null; }
    if (REDUCED.matches) { S.dy = to; place(); return; }
    overlay.dataset.moving = '1';
    cancelY = spring(S.dy, to, v0 || 0, 0.8, 0.3,
      (val) => { S.dy = val; place(); },
      () => { cancelY = null; delete overlay.dataset.moving; });
  }

  /* -- hold: the picture gives way to the thing ---------------------------- */

  function hold(v0) {
    const s = S.screens[S.cur];
    if (!s || s.kind || !s.units.length) { springY(0, v0); return; }
    const u = s.units[0];
    heldEl = u.el;
    S.hold = true;
    ret.hidden = false;
    retBtn.textContent = '↓ ' + (s.label || 'the day') + ' · back to the story';
    const barH = ret.getBoundingClientRect().height;
    const land = () => {
      overlay.hidden = true;
      S.dy = 0;
      place();
      const y = u.sec.getBoundingClientRect().top + scrollY - barH - 8;
      /* `instant`, not `auto`: the document sets `scroll-behavior: smooth`, and
         `auto` inherits it — the page would go on sliding after the screen had
         already risen, which is a second animation nobody asked for. The swipe
         was the transition. */
      scrollTo({ top: Math.max(0, y), behavior: 'instant' });
      root.inert = false;
      retBtn.focus({ preventScroll: true });
    };
    if (REDUCED.matches) { land(); return; }
    if (cancelY) { cancelY(); cancelY = null; }
    overlay.dataset.moving = '1';
    cancelY = spring(S.dy, -track.clientHeight, v0 || 0, 0.8, 0.3,
      (val) => { S.dy = val; place(); },
      () => { cancelY = null; delete overlay.dataset.moving; land(); });
  }
  function unhold() {
    if (!S.hold) return;
    S.hold = false;
    ret.hidden = true;
    overlay.hidden = false;
    root.inert = true;
    /* He may have ticked something while he was down there. The glance is
       rebuilt from the document, so it can never disagree with it. */
    repack(heldEl);
    if (REDUCED.matches) return;
    S.dy = -track.clientHeight;
    place();
    springY(0, 0);
  }

  /* -- gestures ------------------------------------------------------------ */

  let g = null;
  function onDown(e) {
    if (!S.on || S.hold) return;
    if (cancelX) { cancelX(); cancelX = null; }
    if (cancelY) { cancelY(); cancelY = null; }
    delete overlay.dataset.moving;
    g = { id: e.pointerId, x0: e.clientX, y0: e.clientY, px: e.clientX, py: e.clientY,
          t: e.timeStamp, vx: 0, vy: 0, axis: null };
    suppressClick = false;
    /* Feedback on the press, not on the round trip. */
    const zone = e.target.closest ? e.target.closest('.story-zone') : null;
    if (zone) zone.setAttribute('data-press', '');
  }
  function onMove(e) {
    if (!g || e.pointerId !== g.id) return;
    const dt = e.timeStamp - g.t;
    if (dt > 0) {
      g.vx = ((e.clientX - g.px) / dt) * 1000;
      g.vy = ((e.clientY - g.py) / dt) * 1000;
    }
    g.px = e.clientX; g.py = e.clientY; g.t = e.timeStamp;
    const ddx = e.clientX - g.x0, ddy = e.clientY - g.y0;
    if (!g.axis) {
      /* Both gestures are watched from the first move; the loser is cancelled
         once the intent is clear, and 10px is where it becomes clear. */
      if (Math.hypot(ddx, ddy) < 10) return;
      g.axis = Math.abs(ddx) > Math.abs(ddy) ? 'x' : 'y';
      suppressClick = true;
      /* Capture only now that this is a drag. Capturing on the press would
         retarget the click to the track, and the tap zones — the whole of the
         keyboard-and-screen-reader path, and the ordinary way to turn a page —
         would stop firing. */
      try { track.setPointerCapture(g.id); } catch {}
      for (const z of track.querySelectorAll('[data-press]')) z.removeAttribute('data-press');
    }
    const W = track.clientWidth, H = track.clientHeight;
    if (g.axis === 'x') {
      const edge = (S.cur === 0 && ddx > 0) || (S.cur === S.screens.length - 1 && ddx < 0);
      S.dx = edge ? rubber(ddx, W) : ddx;
    } else {
      S.dy = ddy < 0 ? ddy : rubber(ddy, H);
    }
    place();
  }
  function onUp(e) {
    if (!g || e.pointerId !== g.id) return;
    for (const z of track.querySelectorAll('[data-press]')) z.removeAttribute('data-press');
    const axis = g.axis, vx = g.vx, vy = g.vy;
    const W = track.clientWidth, H = track.clientHeight;
    g = null;
    if (!axis) return;             /* a tap: the zone's own click decides */
    if (axis === 'x') {
      const landing = S.dx + project(vx);
      go(S.cur - Math.round(clamp(landing / W, -1, 1)), vx);
    } else {
      const landing = S.dy + project(vy);
      if (landing < -H * 0.3) hold(vy); else springY(0, vy);
    }
    requestAnimationFrame(() => { suppressClick = false; });
  }

  /* -- the overlay --------------------------------------------------------- */

  function build() {
    ensureSheet();
    overlay = el('div', 'story');
    overlay.hidden = true;
    overlay.setAttribute('role', 'region');
    overlay.setAttribute('aria-label', 'Today, screen by screen');
    bar = el('div', 'story-bar');
    const kick = el('div', 'story-kick');
    kick.setAttribute('aria-live', 'polite');
    label = el('span', 'story-label');
    of = el('span', 'story-of');
    const x = el('button', 'story-x', '✕');
    x.setAttribute('aria-label', 'Read as a page');
    x.addEventListener('click', () => leave());
    kick.append(label, of, x);

    track = el('div', 'story-track');
    gauge = el('div', 'story-gauge');
    track.append(gauge);
    for (const [dir, name] of [['prev', 'Previous screen'], ['next', 'Next screen']]) {
      const z = el('button', 'story-zone');
      z.dataset.dir = dir;
      z.setAttribute('aria-label', name);
      z.addEventListener('click', () => {
        if (suppressClick) return;
        go(S.cur + (dir === 'next' ? 1 : -1), 0);
      });
      track.append(z);
    }
    track.addEventListener('pointerdown', onDown);
    track.addEventListener('pointermove', onMove);
    track.addEventListener('pointerup', onUp);
    track.addEventListener('pointercancel', onUp);

    const foot = el('div', 'story-foot');
    openBtn = el('button', 'story-open');
    openBtn.append(el('span', 'story-chev', '⌃'));
    word = el('span', 'story-word', 'Open');
    openBtn.append(word);
    openBtn.addEventListener('click', () => hold(0));
    foot.append(openBtn);

    overlay.append(bar, kick, track, foot);
    document.body.append(overlay);

    ret = el('div', 'story-return');
    ret.hidden = true;
    retBtn = el('button', 'story-back', '');
    retBtn.addEventListener('click', () => unhold());
    ret.append(retBtn);
    /* The way back is also a gesture: pull the bar down and the story returns
       along the path it left by. */
    let rd = null;
    ret.addEventListener('pointerdown', (e) => { rd = e.clientY; });
    ret.addEventListener('pointermove', (e) => {
      if (rd != null && e.clientY - rd > 30) { rd = null; unhold(); }
    });
    ret.addEventListener('pointerup', () => { rd = null; });
    document.body.append(ret);
  }

  /* -- entering and leaving ------------------------------------------------ */

  function enter(at) {
    if (S.on) return;
    if (!overlay) build();
    S.on = true;
    S.cur = 0; S.dx = 0; S.dy = 0;
    overlay.hidden = false;
    root.inert = true;
    repack(null);
    if (at) {
      const i = S.screens.findIndex((s) => s.units.some((u) => u.sec === at));
      if (i > 0) { S.cur = i; mountWindow(); chrome(); }
    }
    watch();
    syncToggle();
  }
  function leave() {
    if (!S.on) return;
    S.on = false;
    S.hold = false;
    if (cancelX) { cancelX(); cancelX = null; }
    if (cancelY) { cancelY(); cancelY = null; }
    overlay.hidden = true;
    ret.hidden = true;
    root.inert = false;
    for (const [, n] of mounted) n.remove();
    mounted.clear();
    unwatch();
    file('page');
    syncToggle();
  }

  /* The screens are measured, so anything that changes a measurement — the
     document being edited, the phone turning, a font arriving — repacks. The
     observer is on the shell, never on the body, so the overlay's own comings
     and goings cannot feed it. */
  let mo = null, tid = 0;
  const keepEl = () => {
    const s = S.screens[S.cur];
    return s && s.units[0] ? s.units[0].el : null;
  };
  const bump = () => {
    clearTimeout(tid);
    tid = setTimeout(() => { if (S.on && !S.hold) repack(keepEl()); }, 250);
  };
  function watch() {
    const shell = document.querySelector('.shell') || root;
    mo = new MutationObserver(bump);
    mo.observe(shell, {
      subtree: true, childList: true, characterData: true, attributes: true,
      attributeFilter: ['data-done', 'data-snooze', 'data-pin', 'data-vote',
                        'data-saved', 'data-open', 'data-view', 'data-expanded'],
    });
    addEventListener('resize', bump);
    addEventListener('orientationchange', bump);
    addEventListener('load', bump);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(bump);
  }
  function unwatch() {
    if (mo) { mo.disconnect(); mo = null; }
    removeEventListener('resize', bump);
    removeEventListener('orientationchange', bump);
    removeEventListener('load', bump);
    clearTimeout(tid);
  }

  /* -- the toggle, and the fact it files ----------------------------------- */

  /* Which reading he chose is a fact about the day, so it goes in the file and
     reopens the way he left it. Never localStorage: there is no third case. */
  function file(v) {
    if (root.getAttribute('data-read') === v) return;
    root.setAttribute('data-read', v);
    const id = window.marble && window.marble.id(root);
    if (id) window.marble.op({ type: 'setAttr', id, name: 'data-read', value: v });
  }
  /* Where the story should pick him up. At the top of the page that is the
     cover — he has not read anything yet. Scrolled down, it is whatever he was
     looking at, so the switch does not lose his place. */
  const current = () => {
    const m = document.querySelector('.masthead');
    if (m && m.getBoundingClientRect().bottom > 0) return null;
    for (const sec of document.querySelectorAll('.comp[data-story-seq]')) {
      if (sec.getBoundingClientRect().bottom > 0) return sec;
    }
    return null;
  };
  function syncToggle() {
    if (!PHONE.matches) {
      if (toggle) { toggle.remove(); toggle = null; }
      return;
    }
    if (!toggle) {
      ensureSheet();
      toggle = el('div', 'story-read');
      const seg = el('span', 'seg');
      seg.setAttribute('role', 'group');
      seg.setAttribute('aria-label', 'How to read today');
      for (const [v, t] of [['page', 'Page'], ['story', 'Story']]) {
        const b = el('button', '', t);
        b.dataset.setread = v;
        b.addEventListener('click', () => {
          if (v === 'story') { file('story'); enter(current()); } else leave();
        });
        seg.append(b);
      }
      toggle.append(seg);
      root.prepend(toggle);
    }
    for (const b of toggle.querySelectorAll('[data-setread]')) {
      b.setAttribute('aria-pressed', String((b.dataset.setread === 'story') === S.on));
    }
  }

  addEventListener('keydown', (e) => {
    if (!S.on) return;
    if (S.hold) { if (e.key === 'Escape') { e.preventDefault(); unhold(); } return; }
    if (e.key === 'ArrowRight') { e.preventDefault(); go(S.cur + 1, 0); }
    else if (e.key === 'ArrowLeft') { e.preventDefault(); go(S.cur - 1, 0); }
    else if (e.key === 'ArrowUp' || e.key === 'Enter') { e.preventDefault(); hold(0); }
    else if (e.key === 'Escape') { e.preventDefault(); leave(); }
  });

  syncToggle();
  PHONE.addEventListener('change', () => { if (!PHONE.matches && S.on) leave(); syncToggle(); });

  /* The hash reaches the story at any width, for a screenshot pass and for a
     test. It is never filed — only the toggle files. */
  const wanted = () => location.hash === '#story'
    || (PHONE.matches && root.getAttribute('data-read') === 'story');
  const start = () => { if (wanted()) enter(null); };
  if (document.readyState === 'loading') addEventListener('DOMContentLoaded', start);
  else start();
  addEventListener('hashchange', () => { if (wanted()) enter(null); else if (location.hash !== '#story' && S.on) leave(); });
})();
</script>

<script>
(() => {
  const begin = (marble) => {
    const TRANSIENT = 'data-marble-transient';
    const ID = 'data-marble-id';
    const isTransient = (el) => el.hasAttribute(TRANSIENT);
    const persistentChildren = (el) => [...el.children].filter((c) => !isTransient(c));
    function nextPersistentSibling(el) { let s = el.nextElementSibling; while (s && isTransient(s)) s = s.nextElementSibling; return s; }
    const roles = new WeakMap();
    function claim(el, role) { const held = roles.get(el) ?? new Set(); if (held.has(role)) return false; held.add(role); roles.set(el, held); return true; }
    const within = (root, sel) => [...(root.matches?.(sel) ? [root] : []), ...root.querySelectorAll(sel)];
    const css = []; const wirers = []; const addressable = [];
    let live = false;
    function assignIdsIn(root) { for (const el of [root, ...root.querySelectorAll('*')]) { if (isTransient(el) || marble.id(el)) continue; if (el === root || el.matches(ADDRESSABLE)) el.setAttribute(ID, marble.newId()); } }
    css.push(`
      .marble-item { position: relative; }
      .marble-item.marble-dragging { z-index: 40; filter: drop-shadow(0 10px 22px rgba(0,0,0,.16)); }
      .marble-grip { position: absolute; left: -1.45rem; top: .25rem; display: flex; flex-direction: column; align-items: center; gap: 1px; opacity: 0; transition: opacity .14s ease; }
      .marble-item:hover > .marble-grip, .marble-item:focus-within > .marble-grip, .marble-item.marble-item-new > .marble-grip, .marble-grip:focus-within { opacity: 1; }
      @media (hover: none) { .marble-grip { left: -1.9rem; opacity: .55; } }
      @media (prefers-reduced-motion: reduce) { .marble-grip { transition: none; } }
      .marble-btn { width: 1.25rem; height: 1.25rem; padding: 0; border: 0; border-radius: 4px; background: none; color: currentColor; opacity: .4; font: 500 12px/1.25rem ui-monospace, Menlo, monospace; text-align: center; cursor: pointer; }
      .marble-btn:hover { opacity: 1; background: rgba(127,127,127,.14); }
      .marble-btn:focus-visible { opacity: 1; outline: 2px solid currentColor; outline-offset: 1px; }
      .marble-btn:active { transform: scale(.92); }
      @media (hover: none) { .marble-btn { width: 1.7rem; height: 1.7rem; font-size: 14px; line-height: 1.7rem; } }
      @media (prefers-reduced-motion: reduce) { .marble-btn:active { transform: none; } }
    `);
    function grip(item) {
      let g = item.querySelector(':scope > .marble-grip');
      if (!g) { g = document.createElement('div'); g.className = 'marble-grip'; g.setAttribute(TRANSIENT, ''); g.setAttribute('contenteditable', 'false'); item.prepend(g); item.classList.add('marble-item'); }
      return g;
    }
    marble.pageOnly('contenteditable', 'spellcheck');
    addressable.push('[data-marble-editable]');
    wirers.push(wireEditable);
    function wireEditable(root) {
      for (const el of within(root, '[data-marble-editable]')) {
        if (!claim(el, 'editable')) continue;
        el.setAttribute('contenteditable', 'plaintext-only');
        if (el.contentEditable !== 'plaintext-only') el.setAttribute('contenteditable', 'true');
        el.spellcheck = false;
        let prior = null;
        el.addEventListener('focus', () => { prior = marble.text(el); });
        el.addEventListener('input', () => {
          const id = marble.id(el); const text = marble.text(el);
          const op = { type: 'setText', id, text };
          if (prior !== null && text !== prior) marble.record({ redo: [op], undo: [{ type: 'setText', id, text: prior }] }, { coalesce: true });
          marble.op(op);
        });
        el.addEventListener('blur', () => { prior = null; marble.flush(); });
        el.addEventListener('keydown', (e) => { if (e.key === 'Escape' || (e.key === 'Enter' && !e.shiftKey)) { e.preventDefault(); el.blur(); } });
      }
    }
    css.push(`.marble-remove:hover { color: #b4544f; }`);
    addressable.push('[data-marble-removable]');
    wirers.push(wireRemovable);
    function wireRemovable(root) {
      for (const el of within(root, '[data-marble-removable]')) {
        if (!claim(el, 'removable')) continue;
        const b = document.createElement('button');
        b.className = 'marble-btn marble-remove'; b.setAttribute(TRANSIENT, ''); b.setAttribute('aria-label', 'Delete'); b.title = 'Delete'; b.textContent = '×';
        b.addEventListener('click', () => {
          const id = marble.id(el); const inverse = marble.invert({ type: 'remove', id });
          el.remove();
          const op = { type: 'remove', id };
          if (inverse) marble.record({ redo: [op], undo: [inverse] });
          marble.op(op, { immediate: true });
        });
        grip(el).append(b);
      }
    }
    /* Reordering, done physically. The row you grab stays under the finger and
       its neighbours slide out of the way; nothing snaps. Three rules: track
       1:1 from the grab point, FLIP the neighbours (move the DOM, then play
       them from where they were to where they are), and start every animation
       from the position the eye last saw rather than the layout box — that is
       what lets a drag reverse halfway without a jump. */
    const DRAG_EASE = 'cubic-bezier(.2, .8, .2, 1)';
    const SLIDE_MS = 220, SETTLE_MS = 260, LIFT_PX = 4, EDGE_PX = 72;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const sliding = new WeakMap();
    css.push(`
      .marble-handle { cursor: grab; touch-action: none; }
      .marble-handle:active { cursor: grabbing; }
      .marble-handle:focus-visible { opacity: 1; outline: 2px solid currentColor; outline-offset: 1px; }
      .marble-dragging { position: relative; z-index: 40; will-change: transform; pointer-events: none; }
      .marble-dragging .acts, .marble-dragging .marble-btn { opacity: 0; }
      body.marble-dragging-now, body.marble-dragging-now * { user-select: none !important; }
      body.marble-dragging-now { cursor: grabbing; }
    `);
    addressable.push('[data-marble-sortable]', '[data-marble-sortable] > *');
    wirers.push(wireSortable);
    let drag = null, edgeRaf = 0;
    const group = (el) => el?.closest('[data-marble-sortable]')?.getAttribute('data-marble-sortable') ?? null;
    const rectsOf = (els) => new Map([...els].map((el) => [el, el.getBoundingClientRect()]));

    /* `first` is read live, so an element already mid-slide is measured where it
       looks — cancel only after that reading. */
    function flip(first) {
      if (reduced.matches) return;
      for (const [el, from] of first) {
        sliding.get(el)?.cancel();
        const to = el.getBoundingClientRect();
        const dx = from.left - to.left, dy = from.top - to.top;
        if (Math.abs(dx) < 0.5 && Math.abs(dy) < 0.5) continue;
        const anim = el.animate([{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'translate(0, 0)' }],
          { duration: SLIDE_MS, easing: DRAG_EASE });
        sliding.set(el, anim);
        anim.finished.then(() => { if (sliding.get(el) === anim) sliding.delete(el); }, () => {});
      }
    }
    /* The row's own slot moves as the list reorders around it, so the offset is
       recomputed from where it actually sits — never accumulated. */
    function follow() {
      const box = drag.item.getBoundingClientRect();
      drag.tx = drag.px - drag.grabX - (box.left - drag.tx);
      drag.ty = drag.py - drag.grabY - (box.top - drag.ty);
      drag.item.style.transform = `translate(${drag.tx}px, ${drag.ty}px)`;
    }
    function containerAt(x, y) {
      let node = document.elementFromPoint(x, y);
      while (node) {
        const c = node.closest?.('[data-marble-sortable]');
        if (!c) return null;
        if (c.getAttribute('data-marble-sortable') === drag.group) return c;
        node = c.parentElement;
      }
      return null;
    }
    function reorder() {
      const c = containerAt(drag.px, drag.py) || drag.item.parentElement;
      if (group(c) !== drag.group) return;
      const before = persistentChildren(c).filter((k) => k !== drag.item)
        .find((k) => { const r = k.getBoundingClientRect(); return drag.py < r.top + r.height / 2; }) ?? null;
      if (drag.item.parentElement === c && before === nextPersistentSibling(drag.item)) return;
      const affected = new Set([...persistentChildren(drag.item.parentElement), ...persistentChildren(c)]);
      affected.delete(drag.item);
      const first = rectsOf(affected);
      c.insertBefore(drag.item, before);
      flip(first);
      follow();
    }
    /* Dragging to the edge scrolls the page, so a long list can be crossed
       without letting go. */
    function edgeScroll() {
      edgeRaf = 0;
      if (!drag?.lifted) return;
      const over = drag.py - EDGE_PX, under = innerHeight - drag.py - EDGE_PX;
      const dy = over < 0 ? Math.max(-22, (over / EDGE_PX) * 22)
        : under < 0 ? Math.min(22, (-under / EDGE_PX) * 22) : 0;
      if (dy) { scrollBy(0, dy); follow(); reorder(); }
      edgeRaf = requestAnimationFrame(edgeScroll);
    }
    function settle(d) {
      const land = () => {
        d.item.style.transform = '';
        d.item.classList.remove('marble-dragging');
        sliding.delete(d.item);
        commitMove(d);
      };
      if (reduced.matches || (!d.tx && !d.ty)) return land();
      const thrown = Math.abs(d.vy) > 900;   /* a throw earns overshoot; a placement does not */
      const anim = d.item.animate([{ transform: `translate(${d.tx}px, ${d.ty}px)` }, { transform: 'translate(0, 0)' }],
        { duration: thrown ? 320 : SETTLE_MS, easing: thrown ? 'cubic-bezier(.2, .9, .25, 1.06)' : DRAG_EASE });
      sliding.set(d.item, anim);
      anim.finished.then(land, land);
    }
    function wireSortableItem(item) {
      if (!claim(item, 'sortable-item')) return;
      const h = document.createElement('button');
      h.className = 'marble-btn marble-handle'; h.setAttribute(TRANSIENT, ''); h.setAttribute('aria-label', 'Reorder');
      h.title = 'Drag to reorder, or focus and press the arrow keys'; h.textContent = '⠿';
      const onMove = (e) => {
        if (!drag || e.pointerId !== drag.pointerId) return;
        e.preventDefault();
        drag.px = e.clientX; drag.py = e.clientY;
        if (!drag.lifted) {
          if (Math.hypot(drag.px - drag.startX, drag.py - drag.startY) < LIFT_PX) return;
          drag.lifted = true;
          item.classList.add('marble-dragging');
          document.body.classList.add('marble-dragging-now');
          if (!edgeRaf) edgeRaf = requestAnimationFrame(edgeScroll);
        }
        const dt = e.timeStamp - drag.lastT;
        if (dt > 0) drag.vy = ((e.clientY - drag.lastY) / dt) * 1000;
        drag.lastT = e.timeStamp; drag.lastY = e.clientY;
        follow(); reorder();
      };
      const onUp = (e) => {
        if (!drag || (e && e.pointerId !== drag.pointerId)) return;
        const d = drag; drag = null;
        if (edgeRaf) { cancelAnimationFrame(edgeRaf); edgeRaf = 0; }
        removeEventListener('pointermove', onMove); removeEventListener('pointerup', onUp); removeEventListener('pointercancel', onUp);
        document.body.classList.remove('marble-dragging-now');
        if (d.lifted) settle(d);
      };
      h.addEventListener('pointerdown', (e) => {
        if ((e.button !== undefined && e.button !== 0) || drag) return;
        e.preventDefault();
        sliding.get(item)?.cancel();      /* grabbing a settling row takes it from where it is now */
        item.style.transform = '';
        const box = item.getBoundingClientRect();
        drag = { item, pointerId: e.pointerId, group: group(item.parentElement),
          originParent: item.parentElement, originBefore: nextPersistentSibling(item),
          grabX: e.clientX - box.left, grabY: e.clientY - box.top,
          startX: e.clientX, startY: e.clientY, px: e.clientX, py: e.clientY,
          tx: 0, ty: 0, vy: 0, lifted: false, lastT: e.timeStamp, lastY: e.clientY };
        addEventListener('pointermove', onMove, { passive: false });
        addEventListener('pointerup', onUp); addEventListener('pointercancel', onUp);
      });
      h.addEventListener('keydown', (e) => {
        const up = e.key === 'ArrowUp', dn = e.key === 'ArrowDown';
        if (!up && !dn) return;
        const p = item.parentElement, sib = persistentChildren(p), at = sib.indexOf(item);
        const swap = sib[up ? at - 1 : at + 1];
        if (!swap) return;
        e.preventDefault();
        const d = { item, originParent: p, originBefore: nextPersistentSibling(item) };
        const first = rectsOf(sib);
        p.insertBefore(item, up ? swap : nextPersistentSibling(swap));
        flip(first);
        commitMove(d); h.focus();
      });
      grip(item).prepend(h);
      if (live) { item.classList.add('marble-item-new'); setTimeout(() => item.classList.remove('marble-item-new'), 1600); }
    }
    function wireSortable(root) {
      for (const c of within(root, '[data-marble-sortable]')) {
        for (const item of persistentChildren(c)) wireSortableItem(item);
        claim(c, 'sortable');
      }
      /* Newly inserted items are adopted as themselves. The sortable attribute
         lives on the parent list, so the walk above never sees them — which is
         why a new row could be deleted (that attribute is on the row) but not
         reordered until the next full-document wire on refresh. */
      if (root.nodeType === 1) {
        const c = root.parentElement?.closest('[data-marble-sortable]');
        if (c && persistentChildren(c).includes(root)) wireSortableItem(root);
      }
    }
    /* Moving the element is the change; this only reports where it came to rest. */
    function commitMove(d) {
      const p = d.item.parentElement, before = nextPersistentSibling(d.item);
      if (p === d.originParent && before === d.originBefore) return;
      const op = { type: 'move', id: marble.id(d.item), parentId: marble.id(p), beforeId: marble.id(before) };
      const inv = { type: 'move', id: marble.id(d.item), parentId: marble.id(d.originParent), beforeId: marble.id(d.originBefore) };
      marble.record({ redo: [op], undo: [inv] });
      marble.op(op, { immediate: true });
    }
    wirers.push(wireAdders);
    function wireAdders(root) {
      for (const button of within(root, '[data-marble-add]')) {
        if (!claim(button, 'adder')) continue;
        button.addEventListener('click', () => {
          const tpl = document.querySelector(button.dataset.marbleAdd);
          const into = button.dataset.marbleInto;
          const c = into === 'prev' ? button.previousElementSibling : document.querySelector(into);
          const seed = tpl?.content?.firstElementChild;
          if (!seed || !c) { console.error('[marble] add: missing template or container', button.dataset); return; }
          const node = seed.cloneNode(true);
          assignIdsIn(node);
          const html = marble.source.outer(node);
          c.append(node); marble.adopt(node);
          const op = { type: 'insert', html, parentId: marble.id(c), beforeId: null };
          const inv = marble.invert(op);
          if (inv) marble.record({ redo: [op], undo: [inv] });
          marble.op(op, { immediate: true });
          node.querySelector('[data-marble-editable]')?.focus();
        });
      }
    }
    css.push(`
      .marble-status { position: fixed; right: 1rem; bottom: 1rem; z-index: 9999; padding: .3rem .6rem; border-radius: 999px; font: 500 11px ui-monospace, Menlo, monospace; letter-spacing: .04em; pointer-events: none; opacity: 0; transition: opacity .25s ease; background: rgba(20,22,26,.92); color: #b7c0cc; border: 1px solid rgba(255,255,255,.12); }
      .marble-status[data-state="saving"] { opacity: 1; }
      .marble-status[data-state="saved"] { opacity: .55; }
      .marble-status[data-state="error"] { opacity: 1; background: #46201f; color: #ff9b9b; }
    `);
    const status = document.createElement('div');
    status.className = 'marble-status'; status.setAttribute(TRANSIENT, '');
    document.body.append(status);
    let statusTimer = null;
    document.addEventListener('marble:status', ({ detail }) => {
      status.dataset.state = detail.state;
      status.textContent = detail.state === 'saving' ? 'saving…' : detail.state === 'saved' ? 'saved' : `error — ${detail.message}`;
      clearTimeout(statusTimer);
      if (detail.state === 'saved') statusTimer = setTimeout(() => (status.dataset.state = 'idle'), 1200);
    });
    const style = document.createElement('style');
    style.setAttribute(TRANSIENT, ''); style.textContent = css.join('\n');
    document.head.append(style);
    const ADDRESSABLE = addressable.join(', ');
    marble.address(document.querySelectorAll(ADDRESSABLE));
    marble.register((root) => { for (const w of wirers) w(root); live = true; });
  };
  if (window.marble) begin(window.marble);
  else {
    /* No host is a user-visible state, not just a guard. Without one every control
       here still moves the page and then forgets, which is worse than a broken
       button — the person believes they have done work. So say it once, in the
       file's own voice. The delay is because a host may attach after this script
       parses; marble:ready cancels the claim before anyone can read it. */
    const declareReadonly = setTimeout(
      () => document.body.setAttribute('data-marble-readonly', ''), 1500);
    addEventListener('marble:ready', (e) => {
      clearTimeout(declareReadonly);
      document.body.removeAttribute('data-marble-readonly');
      begin(e.detail);
    }, { once: true });
  }
})();
</script>
</body>
</html>
