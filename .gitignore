# The default drive root. A drive belongs to whoever is running the host, not
# to this repository — and `.marble/` under it is their history.
drive/
backups/
.DS_Store
*.log

# Agent worktrees. Each one is a checkout of this repository, so committing the
# path stores a gitlink to a branch that lives only on one laptop, and a
# clone gets an empty directory it cannot fill.
.claude/worktrees/
