node_modules/
.env
.env.local
# API keys the Agents settings panel writes. Never under the drive — backups
# copy the drive, and `.marble/` is conversation data. The glob covers the
# atomic-write temp files (`.agent-keys.local.<pid>.<hex>.tmp`) too.
.agent-keys.local*
# The default drive root. A drive belongs to whoever is running the host, not
# to this repository — and `.marble/` under it is their history.
drive/
backups/
.DS_Store
*.log

# Agent worktrees. Each one is a checkout of this repository, so committing the
# path stores a gitlink to a branch that lives only on one laptop, and a
# clone gets an empty directory it cannot fill.
.claude/worktrees/

# Local design-hook detector config (per machine)
.impeccable/

# Scratchpad working directories. The small top-level scripts stay tracked —
# phone-tour.mjs and friends are how we look at the UI — but each per-session
# subdirectory is screenshots and generated HTML, megabytes of it, and it is
# never read back after the session that produced it.
scratchpad/*/

# Superpowers session state: brainstorm servers, their ports, tokens and pids.
# Local to one machine and one run; a clone has no use for it.
.superpowers/

# Process files, wherever they land.
*.pid
